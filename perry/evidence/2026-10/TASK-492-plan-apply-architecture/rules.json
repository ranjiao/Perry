{"version": 1, "documents": [{"path": "ARCHITECTURE.md", "sha256": "576f4a2dce7842e530101f4739db5cebf295ce1e5f40abfedcb7e9be26cea637"}, {"path": "kernel/ARCHITECTURE.md", "sha256": "a77ec2f410a878f4e5b30f15b46901b9ec107f6f782882f85c51319181d2974e"}, {"path": "perry/design/DESIGN-023-a-kernel-and-a-skill.md", "sha256": "8a1d7bff24854e0b0b3b65300c54d4655892d8cfac42b43a1472100b047f3196"}], "rules": [{"id": "kernel-no-process", "kind": "forbid-call", "scope": ["kernel/perry_kernel/*"], "origin": "stdlib", "forbidden_calls": ["subprocess.*", "os.system", "os.exec*", "os.spawn*"], "source": {"path": "kernel/ARCHITECTURE.md", "line": 96, "end_line": 97, "quote": "- **Running a command.** The kernel makes no `subprocess`, `os.system`, `os.exec*` or\n  `os.spawn*` call. It finds the git common dir by reading `.git` and `commondir` (\u00a7 5.7)."}}]}