hat subcommand alone\"\n        },\n        {\n          \"name\": \"--help\",\n          \"summary\": \"print usage and exit, from any position\"\n        },\n        {\n          \"name\": \"--json\",\n          \"summary\": \"the full payload (the default)\"\n        },\n        {\n          \"name\": \"--lane\",\n          \"arg\": \"lane\",\n          \"summary\": \"--section next only: goals, work or decide rules\"\n        },\n        {\n          \"name\": \"--root\",\n          \"arg\": \"path\",\n          \"summary\": \"the project to act on; else $PERRY_PROJECT, else the walk up from cwd\"\n        },\n        {\n          \"name\": \"--section\",\n          \"arg\": \"name\",\n          \"summary\": \"one top-level key of the full payload, in full\"\n        }\n      ],\n      \"subcommands\": []\n    },\n    {\n      \"tool\": \"perry-task\",\n      \"kind\": \"write\",\n      \"summary\": \"the one deterministic way board state changes\",\n      \"root_resolution\": \"standard\",\n      \"exit_codes\": {\n        \"0\": \"written, or read\",\n        \"1\": \"refused, and why is printed\",\n        \"2\": \"bad invocation\"\n      },\n      \"flags\": [\n        {\n          \"name\": \"--actor\",\n          \"arg\": \"value\"\n        },\n        {\n          \"name\": \"--all\"\n        },\n        {\n          \"name\": \"--also\",\n          \"arg\": \"value\"\n        },\n        {\n          \"name\": \"--answer\",\n          \"arg\": \"value\"\n        },\n        {\n          \"name\": \"--arrived\",\n          \"arg\": \"value\"\n        },\n        {\n          \"name\": \"--blocks\",\n          \"arg\": \"value\"\n        },\n        {\n          \"name\": \"--checked\",\n          \"arg\": \"value\",\n          \"repeatable\": true\n        },\n        {\n          \"name\": \"--clear\"\n        },\n        {\n          \"name\": \"--commitment\",\n          \"arg\": \"value\"\n        },\n        {\n          \"name\": \"--deliverable\",\