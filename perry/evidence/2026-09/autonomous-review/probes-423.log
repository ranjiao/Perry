ved\",\n            \"--describe\",\n            \"--dry-run\",\n            \"--help\",\n            \"--json\",\n            \"--reason\",\n            \"--root\",\n            \"--stage\",\n            \"--track\"\n          ],\n          \"writes\": [\n            \"tasks.jsonl\",\n            \"journal/\",\n            \".perry/events.jsonl\"\n          ]\n        },\n        {\n          \"name\": \"ask\",\n          \"summary\": \"add a question for the user to the User Input Queue\",\n          \"flags\": [\n            \"--actor\",\n            \"--arrived\",\n            \"--blocks\",\n            \"--describe\",\n            \"--dry-run\",\n            \"--help\",\n            \"--json\",\n            \"--needed\",\n            \"--root\"\n          ],\n          \"writes\": [\n            \"asks.jsonl\",\n            \"journal/\",\n            \".perry/events.jsonl\"\n          ]\n        },\n        {\n          \"name\": \"answer\",\n          \"summary\": \"record the user's answer to one USER- row\",\n          \"flags\": [\n            \"--actor\",\n            \"--answer\",\n            \"--describe\",\n            \"--dry-run\",\n            \"--help\",\n            \"--json\",\n            \"--root\"\n          ],\n          \"writes\": [\n            \"asks.jsonl\",\n            \"journal/\",\n            \".perry/events.jsonl\"\n          ]\n        },\n        {\n          \"name\": \"next\",\n          \"summary\": \"rewrite the Next action cell, nothing else\",\n          \"flags\": [\n            \"--actor\",\n            \"--describe\",\n            \"--dry-run\",\n            \"--help\",\n            \"--json\",\n            \"--next\",\n            \"--root\"\n          ],\n          \"writes\": [\n            \"tasks.jsonl\",\n            \"journal/\",\n            \".perry/events.jsonl\"\n          ]\n        },\n        {\n          \"name\": \"cadence-add\",\n          \"summary\": \"declare a recurring task\",\n          \"flags\": 