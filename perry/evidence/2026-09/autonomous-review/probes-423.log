{"tool": "perry", "args": ["list", "--json"], "exit": 0, "stdout": "{\n  \"tools\": [\n    {\n      \"tool\": \"perry-config\",\n      \"kind\": \"write\",\n      \"summary\": \"the project's settings and its track register, in `.perry/config.jsonl`\",\n      \"root_resolution\": \"standard\",\n      \"exit_codes\": {\n        \"0\": \"read, or written\",\n        \"1\": \"refused\",\n        \"2\": \"bad invocation\"\n      },\n      \"flags\": [\n        {\n          \"name\": \"--cycle\",\n          \"arg\": \"value\",\n          \"summary\": \"the track's cycle\"\n        },\n        {\n          \"name\": \"--default-rung\",\n          \"arg\": \"value\",\n          \"summary\": \"the track's default rung\"\n        },\n        {\n          \"name\": \"--describe\",\n          \"summary\": \"print this tool's declared surface as JSON and exit; name a subcommand for that subcommand alone\"\n        },\n        {\n          \"name\": \"--dry-run\",\n          \"summary\": \"print what would land and touch nothing\"\n        },\n        {\n          \"name\": \"--help\",\n          \"summary\": \"print usage and exit, from any position\"\n        },\n        {\n          \"name\": \"--json\",\n          \"summary\": \"a machine-readable payload\"\n        },\n        {\n          \"name\": \"--mode\",\n          \"arg\": \"value\",\n          \"summary\": \"the track's mode\"\n        },\n        {\n          \"name\": \"--root\",\n          \"arg\": \"path\",\n          \"summary\": \"the project to act on; else $PERRY_PROJECT, else the walk up from cwd\"\n        },\n        {\n          \"name\": \"--sla\",\n          \"arg\": \"value\",\n          \"summary\": \"the track's sla\"\n        },\n        {\n          \"name\": \"--spine\",\n          \"arg\": \"value\",\n          \"summary\": \"the track's spine\"\n        },\n        {\n          \"name\": \"--stages\",\n          \"arg\": \"value\",\n          \"summary\": \"the track's stages\"\n        },\n        {\n          \"name\": \"--wip\",\n          \"arg\": \"value\",\n          \"summary\": \"the track's wip\"\n        }\n      ],\n      \"subcommands\": [\n        {\n          \"name\": \"show\",\n          \"summary\": \"print the settings and the tracks\",\n          \"flags\": [\n            \"--describe\",\n            \"--help\",\n            \"--json\",\n            \"--root\"\n          ],\n          \"writes\": []\n        },\n        {\n          \"name\": \"set\",\n          \"summary\": \"set one setting: `set <label> <value>`\",\n          \"flags\": [\n            \"--describe\",\n            \"--dry-run\",\n            \"--help\",\n            \"--json\",\n            \"--root\"\n          ],\n          \"writes\": [\n            \".perry/config.jsonl\"\n          ]\n        },\n        {\n          \"name\": \"unset\",\n          \"summary\": \"remove one setting by label\",\n          \"flags\": [\n            \"--describe\",\n            \"--dry-run\",\n            \"--help\",\n            \"--json\",\n            \"--root\"\n          ],\n          \"writes\": [\n            \".perry/config.jsonl\"\n          ]\n        },\n        {\n          \"name\": \"track\",\n          \"summary\": \"declare or edit a track: `track <name> [--mode queue] [--wip 6] \u2026`\",\n          \"flags\": [\n            \"--cycle\",\n            \"--default-rung\",\n            \"--describe\",\n            \"--dry-run\",\n            \"--help\",\n            \"--json\",\n            \"--mode\",\n            \"--root\",\n            \"--sla\",\n            \"--spine\",\n            \"--stages\",\n            \"--wip\"\n          ],\n          \"writes\": [\n            \".perry/config.jsonl\"\n          ]\n        },\n        {\n          \"name\": \"untrack\",\n          \"summary\": \"remove one declared track\",\n          \"flags\": [\n            \"--describe\",\n            \"--dry-run\",\n            \"--help\",\n            \"--json\",\n            \"--root\"\n          ],\n          \"writes\": [\n            \".perry/config.jsonl\"\n          ]\n        }\n      ]\n    },\n    {\n      \"tool\": \"perry-diagnose\",\n      \"kind\": \"read\",\n      \"summary\": \"judge the folder it is pointed at: is it set up in a way that holds up under agent work\",\n      \"root_resolution\": \"cwd\",\n      \"exit_codes\": {\n        \"0\": \"diagnosed \u2014 findings are the answer, not an error\",\n        \"2\": \"bad invocation\"\n      },\n      \"flags\": [\n        {\n          \"name\": \"--describe\",\n          \"summary\": \"print this tool's declared surface as JSON and exit; name a subcommand for that subcommand alone\"\n        },\n        {\n          \"name\": \"--help\",\n          \"summary\": \"print usage and exit, from any position\"\n        },\n        {\n          \"name\": \"--json\",\n          \"summary\": \"the payload (the default)\"\n        },\n        {\n          \"name\": \"--max-files\",\n          \"arg\": \"n\",\n          \"summary\": \"stop scanning after this many files (default 20000)\"\n        },\n        {\n          \"name\": \"--root\",\n          \"arg\": \"path\",\n          \"summary\": \"the project to act on; else $PERRY_PROJECT, else the walk up from cwd\"\n        },\n        {\n          \"name\": \"--text\",\n          \"summary\": \"the same findings as prose\"\n        }\n      ],\n      \"subcommands\": []\n    },\n    {\n      \"tool\": \"perry-okr\",\n      \"kind\": \"write\",\n      \"summary\": \"`OKR.md` as a store, and the projection of it\",\n      \"root_resolution\": \"standard\",\n      \"exit_codes\": {\n        \"0\": \"read, or written\",\n        \"1\": \"refused, or the file and the store differ\",\n        \"2\": \"bad invocation, or nothing usable to compare\",\n        \"3\": \"the bytes match and the store did not produce them\"\n      },\n      \"flags\": [\n        {\n          \"name\": \"--describe\",\n          \"summary\": \"print this tool's declared surface as JSON and exit; name a subcommand for that subcommand alone\"\n        },\n        {\n          \"name\": \"--dry-run\",\n          \"summary\": \"print what would land and touch nothing\"\n        },\n        {\n          \"name\": \"--from-file\",\n          \"summary\": \"confirm the backwards direction: the file replaces the store\"\n        },\n        {\n          \"name\": \"--help\",\n          \"summary\": \"print usage and exit, from any position\"\n        },\n        {\n          \"name\": \"--json\",\n          \"summary\": \"a machine-readable payload\"\n        },\n        {\n          \"name\": \"--root\",\n          \"arg\": \"path\",\n          \"summary\": \"the project to act on; else $PERRY_PROJECT, else the walk up from cwd\"\n        },\n        {\n          \"name\": \"--write\",\n          \"summary\": \"put the render on disk instead of on stdout\"\n        }\n      ],\n      \"subcommands\": [\n        {\n          \"name\": \"build\",\n          \"summary\": \"derive the store from OKR.md and print it\",\n          \"flags\": [\n            \"--describe\",\n            \"--help\",\n            \"--root\"\n          ],\n          \"writes\": []\n        },\n        {\n          \"name\": \"verify\",\n          \"summary\": \"field-compare the store on disk with the file\",\n          \"flags\": [\n            \"--describe\",\n            \"--help\",\n            \"--root\"\n          ],\n          \"writes\": []\n        },\n        {\n          \"name\": \"write\",\n          \"summary\": \"the one-way import: OKR.md -> okr.jsonl\",\n          \"flags\": [\n            \"--describe\",\n            \"--dry-run\",\n            \"--from-file\",\n            \"--help\",\n            \"--json\",\n            \"--root\"\n          ],\n          \"writes\": [\n            \"okr.jsonl\"\n          ]\n        },\n        {\n          \"name\": \"render\",\n          \"summary\": \"okr.jsonl -> OKR.md; refuses when a record has