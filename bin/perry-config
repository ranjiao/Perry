#!/usr/bin/env python3
"""
.perry/config.jsonl — the project's settings and tracks, read and written.

    perry-config show   [--root <p>] [--json]      what the store declares
    perry-config set    [--root <p>] <Label> <value>   upsert one setting
    perry-config unset  [--root <p>] <Label>       remove one setting

The usage block is generated from this tool's `SURFACE`
declaration — run `perry-config --help`, or `perry-config <subcommand>
--help` for one of them, or `perry-config --describe --json` for the
whole surface as data.

**The argument for every refusal below is in
`bin/README.md § The argument, per tool`**, moved there whole on
2026-09-09 (DESIGN-016 Decision 2). Nothing was cut; `--help`
stopped being the place to read it.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "viewer"))
sys.path.insert(0, str(HERE))
import lib  # noqa: E402
import parsers as P  # noqa: E402
import perry_md_store as store  # noqa: E402

COMMANDS = ("show", "set", "unset", "track", "untrack")

#: `--sla 3d` → the `sla` field. One flag per optional track field, minted from
#: the schema rather than listed, so a field added there is settable here
#: without a second edit — the same rule `store_record_fields` exists for.
TRACK_FLAGS = {f"--{f.replace('_', '-')}": f
               for f in store.TRACK_FIELDS if f != "track"}


class Refused(Exception):
    """A refusal is a first-class outcome. Nothing was written."""


def read_records(path: Path) -> list[dict]:
    """The store as it is on disk, validated. Refuses rather than guessing.

    **A writer does not repair a store it could not read.** Rewriting one that
    holds a record this tool cannot parse would drop that record silently,
    which is the whole failure mode ADR-019 exists to make impossible — a value
    replaced by a blank on the next write. `bin/perry-lint` names the bad
    record; this refuses until somebody has looked at it.
    """
    if P.exists_or_unreadable(path) is not True:
        # `None` is an unsearchable `.perry/`. A writer that cannot read the
        # store must not rewrite it — the same rule the docstring states for a
        # record it cannot parse — and returning [] here would let it. The
        # caller's own guard turns an empty result into a refusal.
        return []
    try:
        on_disk = store.load_store(path)
    except (OSError, ValueError) as exc:
        raise Refused(f"{path} exists and is not readable as JSONL "
                      f"({type(exc).__name__}: {exc}). Nothing was written; "
                      f"move it aside and re-run, or repair it by hand.")
    good, bad = store.validate_records(on_disk)
    if bad:
        raise Refused(
            f"{path} holds {len(bad)} record(s) that do not validate: "
            + "; ".join(f"{b.get('key') or 'line ' + str(b['line'])} — "
                        f"{b['message']}" for b in bad[:5])
            + ". Nothing was written — a rewrite would drop them.")
    return good


def renumber(records: list[dict]) -> list[dict]:
    """`order` is the record's position, so it is assigned and not carried.

    Settings first and tracks after, each in the order they were declared. The
    field exists so two writes of the same state produce the same bytes; a
    store whose lines reshuffle turns every write into a whole-file diff, which
    is the argument `perry_store.record` makes for the same field one register
    over.
    """
    out = []
    for kind in ("setting", "track"):
        n = 0
        for rec in records:
            if rec.get("kind") != kind:
                continue
            rec = dict(rec)
            rec["order"] = n
            n += 1
            out.append(rec)
    return out


def write(path: Path, records: list[dict], what: str, *,
          dry_run: bool = False, as_json: bool = False) -> int:
    """The one write, with `--dry-run` and `--json` honoured on every writer.

    `bin/README.md:74` promises both "on the writers", and this tool had
    neither: `--dry-run` was refused outright and `--json` was accepted by
    `set`, `unset`, `track` and `untrack` and read by none of them — the
    accepted-and-honoured-are-two-facts defect of DESIGN-016 § 1.4, on a
    writer. Honest because everything above has already happened: the records
    are built and validated, and the only thing skipped is the rename.
    """
    records = renumber(records)
    good, bad = store.validate_records(records)
    if bad:
        raise Refused(f"the store this would write is one this tool could not "
                      f"read back: {bad[0]['message']}. Nothing was written.")
    held = len(read_records(path)) if path.exists() else 0
    if not dry_run:
        path.parent.mkdir(parents=True, exist_ok=True)
        lib.write_atomic(path, store.store_text(records))
    if as_json:
        print(json.dumps({"store": str(path), "what": what,
                          "wrote": not dry_run, "dry_run": dry_run,
                          "records": len(records), "records_on_disk": held},
                         ensure_ascii=False, indent=2))
    elif dry_run:
        print(f"perry-config: would {what} — {path} would hold "
              f"{len(records)} record(s), {held} now. Nothing was written.")
    else:
        print(f"perry-config: {what} — {path} now holds {len(records)} "
              f"record(s)")
    return 0


def cmd_show(records: list[dict], as_json: bool) -> int:
    settings = {r["key"]: r.get("value", "") for r in records
                if r.get("kind") == "setting"}
    labels = {r["key"]: r.get("label", "") for r in records
              if r.get("kind") == "setting"}
    tracks = [r for r in records if r.get("kind") == "track"]
    if as_json:
        print(json.dumps({"settings": settings, "tracks": tracks},
                         ensure_ascii=False, indent=2))
        return 0
    if not records:
        print("perry-config: this project declares nothing — no "
              ".perry/config.jsonl, or an empty one.")
        return 0
    for key, value in settings.items():
        print(f"  {labels.get(key) or key}: {value or '—'}")
    for rec in tracks:
        fields = ", ".join(f"{f}={rec.get(f) or '—'}"
                           for f in store.TRACK_FIELDS if f != "track")
        print(f"  track {rec.get('track')}: {fields}")
    return 0


def cmd_set(records: list[dict], label: str, value: str) -> list[dict]:
    key = store.setting_key(label)
    if not key:
        raise Refused(f"{label!r} mints no setting key — a label is the words "
                      f"before the colon, and this one is punctuation only. "
                      f"Nothing was written.")
    out, seen = [], False
    for rec in records:
        if rec.get("kind") == "setting" and rec.get("key") == key:
            # **The label is overwritten too, and that is deliberate.** A user
            # who re-declares `PMO repo path` having previously written `PMO
            # Repo Path` means the new words; both mint the same key, and
            # keeping the old label would show them back words they replaced.
            out.append(store.record("setting", {
                "key": key, "label": label.strip(),
                "value": store.stored_value(value)}, 0))
            seen = True
            continue
        out.append(rec)
    if not seen:
        out.append(store.record("setting", {
            "key": key, "label": label.strip(),
            "value": store.stored_value(value)}, 0))
    return out


def cmd_track(records: list[dict], name: str, values: dict) -> list[dict]:
    """Upsert one track. **Unnamed flags keep their stored value.**

    `perry-config track main --sla 3d` sets the SLA and leaves the mode,
    stages and WIP alone. The alternative — every absent flag blanking its
    field — makes a one-field edit a whole-record rewrite, which is exactly the
    "a real value replaced by a blank" failure `perry_md_store §
    _assert_every_declared_column_is_stored` exists to prevent one layer down.
    """
    name = name.strip()
    if not name:
        raise Refused("a track needs a name. Nothing was written.")
    out, seen = [], False
    for rec in records:
        if rec.get("kind") == "track" and (rec.get("track") or "").strip() == name:
            merged = {f: rec.get(f, "") for f in store.TRACK_FIELDS}
            merged.update({k: store.stored_value(v) for k, v in values.items()})
            merged["track"] = name
            out.append(store.record("track", merged, 0))
            seen = True
            continue
        out.append(rec)
    if not seen:
        merged = {f: "" for f in store.TRACK_FIELDS}
        merged.update({k: store.stored_value(v) for k, v in values.items()})
        merged["track"] = name
        # DESIGN-003: a track with no declared mode is a `project` track. Said
        # here at creation rather than defaulted at every read, so the record
        # states what the project decided.
        merged["mode"] = merged.get("mode") or "project"
        out.append(store.record("track", merged, 0))
    return out


#: What this tool accepts, declared once (DESIGN-016 C1). Its subcommands take
#: free-form POSITIONAL values — a label, a value, a track name — so the
#: declaration carries the flags and the positionals stay where they are.
SURFACE = {
    "name": "perry-config",
    "kind": "write",
    "summary": "the project's settings and its track register, in "
               "`.perry/config.jsonl`",
    "root_resolution": "standard",
    "exit_codes": {"0": "read, or written", "1": "refused",
                   "2": "bad invocation"},
    "flags": [
        {"name": "--json", "summary": "a machine-readable payload"},
        {"name": "--dry-run", "summary":
         "print what would land and touch nothing"},
    ] + [
        # **The track register's fields ARE flags** — `track main --mode queue`
        # — and they are declared from the same list the writer reads, so the
        # parser and `cmd_track` cannot disagree about what a track has. A
        # hand-typed copy here refused `--mode` for one commit on 2026-09-09
        # and broke the only way to declare a track's mode.
        {"name": flag, "arg": "value",
         "summary": f"the track's {field.replace('_', ' ')}"}
        for flag, field in sorted(TRACK_FLAGS.items())
    ],
    "universal_flags": ["--json"],
    "subcommands": [
        {"name": "show", "summary": "print the settings and the tracks",
         "flags": []},
        {"name": "set", "summary": "set one setting: `set <label> <value>`",
         "flags": ["--dry-run"], "writes": [".perry/config.jsonl"]},
        {"name": "unset", "summary": "remove one setting by label",
         "flags": ["--dry-run"], "writes": [".perry/config.jsonl"]},
        {"name": "track", "summary":
         "declare or edit a track: `track <name> [--mode queue] [--wip 6] …`",
         "flags": ["--dry-run", *sorted(TRACK_FLAGS)],
         "writes": [".perry/config.jsonl"]},
        {"name": "untrack", "summary": "remove one declared track",
         "flags": ["--dry-run"], "writes": [".perry/config.jsonl"]},
    ],
}


def main(argv: list[str]) -> int:
    # **Read against the declaration** (DESIGN-016 A2 and C1): `-h` from any
    # position, an undeclared token refused, a declared flag on a subcommand
    # that does not take it refused, and `--` for a value that genuinely
    # starts with a dash. The hand-rolled version of this refused every track
    # field — `track main --mode queue`, the only way to declare a track's
    # mode — for one commit, because the stray-flag check had no allowlist.
    read = lib.parse_surface(SURFACE, argv)
    if read["help"]:
        print(lib.usage_lines(SURFACE, read["sub"]))
        if not read["sub"]:
            print()
            print(__doc__.strip())
        return 0
    if not argv:
        # One no-argument behaviour (DESIGN-016 C3).
        print(lib.usage_lines(SURFACE), file=sys.stderr)
        return 2
    if read["describe"]:
        print(json.dumps(lib.describe_surface(SURFACE, read["sub"]),
                         ensure_ascii=False, indent=2))
        return 0
    if read["error"]:
        print(f"perry-config: {read['error']}", file=sys.stderr)
        return 2
    cmd = read["sub"]
    if cmd not in COMMANDS:
        print(f"perry-config: expected {' / '.join(COMMANDS)}, got {cmd!r}",
              file=sys.stderr)
        return 2
    rest = list(read["extra"])
    as_json = "--json" in read["seen"]
    dry_run = "--dry-run" in read["seen"]
    track_values = {TRACK_FLAGS[f]: v for f, v in read["values"].items()
                    if f in TRACK_FLAGS}
    # **`--root` wins, then `$PERRY_PROJECT`, then the walk.** The comment that
    # stood here said the opposite and cited `bin/perry-state § resolve_root`
    # as the precedent — which takes the explicit path FIRST, so the citation
    # was to a function doing the other thing (DESIGN-016 § 1.1, A1). One
    # resolver now, in `lib`, and `viewer/parsers § _resolve_project_root` is
    # still the walk it calls.
    root = lib.resolve_project_root(read["values"].get("--root"))
    path = root / ".perry" / "config.jsonl"
    state_root = P.resolve_state_root(root)

    # One lock spans the read, the change and the replacement, for the reason
    # `bin/perry_md_store § main` takes it around the same span: taking it only
    # at the rename lets a concurrent writer make every decision above that
    # point against stale bytes.
    with lib.project_lock(state_root, refused=Refused):
        records = read_records(path)
        if cmd == "show":
            return cmd_show(records, as_json)
        if cmd == "set":
            if len(rest) < 2:
                raise Refused(
                    f"`set` takes a label and a value: `perry-config set "
                    f"'Document language' English{lib.root_flag(root)}`")
            return write(path, cmd_set(records, rest[0], " ".join(rest[1:])),
                         f"set {rest[0]!r}", dry_run=dry_run,
                         as_json=as_json)
        # Each branch below names its own verb in the line it prints, and the
        # name comes from `cmd` rather than from a literal: a V4 review routed
        # `unset` into the `show` branch and got exit 0 with nothing removed,
        # and the guard added for the fall-through could not see it because the
        # capture happened above the guard.
        # Each branch below names its own verb in the line it prints, and the
        # name comes from `cmd` rather than from a literal: a V4 review routed
        # `unset` into the `show` branch and got exit 0 with nothing removed,
        # and the guard added for the fall-through could not see it because the
        # capture happened above the guard.
        # Each branch below names its own verb in the line it prints. A V4
        # review routed `unset` into the `show` branch and got exit 0 with
        # nothing removed; the guard added for the fall-through could not see
        # it, because the capture happened above the guard. What catches it is
        # `tests/test_bin_surface § OWN_OUTPUT`, which asks every declared
        # subcommand of every declared tool for a string only its own handler
        # produces.
        if cmd == "unset":
            if len(rest) != 1:
                raise Refused("`unset` takes one label.")
            key = store.setting_key(rest[0])
            kept = [r for r in records
                    if not (r.get("kind") == "setting" and r.get("key") == key)]
            if len(kept) == len(records):
                raise Refused(f"{rest[0]!r} is not declared "
                              f"(key {key!r}); nothing was written.")
            return write(path, kept, f"unset {rest[0]!r}", dry_run=dry_run,
                         as_json=as_json)
        if cmd == "untrack":
            if len(rest) != 1:
                raise Refused("`untrack` takes one track name.")
            kept = [r for r in records
                    if not (r.get("kind") == "track"
                            and (r.get("track") or "").strip() == rest[0].strip())]
            if len(kept) == len(records):
                raise Refused(f"track {rest[0]!r} is not declared; nothing was "
                              f"written.")
            return write(path, kept, f"untrack {rest[0]!r}", dry_run=dry_run,
                         as_json=as_json)

        # **The fall-through is a refusal, not `track`.** There was no `else`
        # here: every subcommand the four branches above did not match landed
        # in this one, so disabling the `untrack` branch made `untrack alpha`
        # print `track 'alpha' — … now holds 1 record(s)`, exit 0, and remove
        # nothing. A V4 review found it by mutation on 2026-09-09. A tool that
        # reports a write it did not perform is DESIGN-016 § 1.5's own subject.
        if cmd != "track":
            raise Refused(
                f"{cmd!r} reached the track writer, which means this tool "
                f"declares a subcommand it does not dispatch. Nothing was "
                f"written.")
        if not rest:
            raise Refused("`track` takes a track name.")
        return write(path, cmd_track(records, rest[0], track_values),
                     f"track {rest[0]!r}", dry_run=dry_run, as_json=as_json)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as exc:
        print(f"perry-config: refused — {exc}", file=sys.stderr)
        sys.exit(1)
    except store.Refused as exc:
        print(f"perry-config: refused — {exc}", file=sys.stderr)
        sys.exit(1)
