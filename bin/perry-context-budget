#!/usr/bin/env python3
"""
perry-context-budget — how much context this session is paying for, per turn.

Session cost is accumulated context re-read per turn. The default gate uses
host transcript accounting: cache-read + cache-creation + input tokens on the
last measured turn. Only Claude Code has a known transcript location; other
hosts report unknown and abstain. The transcript path and age are reported.
Read-only: session modes read transcripts; bills read declared skill files.

Usage:
  perry-context-budget [--ceiling N] [--session <path>] [--json]
  perry-context-budget --composition [--session <path>] [--json]

  --ceiling      the budget. Accepts 200000 or 200k. Most specific wins:
                 this flag, then env `PERRY_CONTEXT_CEILING`, then the
                 project's `session_context_ceiling` setting in
                 `.perry/config.jsonl`, then `schema § thresholds`. Every
                 report names which of the four answered.
  --session      measure this transcript instead of the newest one for the
                 project. The escape hatch for "the newest file is not me".
  --composition  scan the WHOLE transcript and report what the context is made
                 of, by block type and by the biggest repeated shell commands.
                 This is the diagnosis; the default mode is the gate.
  --json         machine-readable.
  --bill NAME    static declared byte bill: snapshot, add-task, close-task,
                 dispatch, plan-phase, or all. No session/project reads.
  --bill-skill-root PATH  bill-only fixture root; default is this installation.
                 Bill mode excludes conditional/transitive context; --root,
                 --session, --composition and --ceiling are incompatible.
                 Exit 0 within cap (inclusive), 1 over cap, 2 error/unknown.

Exit status:
  0  under the ceiling, or could not measure (verdict `unknown`)
  1  at or over the ceiling — autopilot stops, hands off, and starts fresh
"""

from __future__ import annotations

import argparse
import collections
import json
import os
import re
import sys
import time
from pathlib import Path

# Schema fallback for installations missing the schema.
DEFAULT_CEILING = 200_000

# Read the tail first; fall back to a full scan if it has no usage.
TAIL_BYTES = 4 << 20


def parse_size(text: str) -> int:
    """`200k` and `200000` are the same number. `--ceiling 200` is not 200k."""
    t = str(text).strip().lower().replace("_", "").replace(",", "")
    mult = 1
    if t.endswith("k"):
        mult, t = 1_000, t[:-1]
    elif t.endswith("m"):
        mult, t = 1_000_000, t[:-1]
    return int(float(t) * mult)


# Store setting key follows the label-to-key convention.
CEILING_SETTING_KEY = "session_context_ceiling"


def declared_ceiling(project_root: Path) -> tuple[str | None, str]:
    """The project's own ceiling and WHICH register answered, or (None, _)."""
    store = project_root / ".perry" / "config.jsonl"
    try:
        present = store.exists()
    except OSError:
        # An inaccessible project uses defaults.
        present = False
    if present:
        for raw in store.read_text(errors="replace").split("\n"):
            raw = raw.strip()
            if not raw:
                continue
            try:
                rec = json.loads(raw)
            except (ValueError, TypeError):
                continue
            if (rec.get("kind") == "setting"
                    and rec.get("key") == CEILING_SETTING_KEY):
                value = str(rec.get("value") or "").strip()
                return (value or None), ".perry/config.jsonl"
    return None, ""


def resolve_ceiling(perry_home: Path, project_root: Path,
                    flag: str | None) -> tuple[int, str]:
    """The ceiling and WHERE it came from, most specific first."""
    if flag:
        try:
            return parse_size(flag), "--ceiling"
        except ValueError:
            pass
    env = (os.environ.get("PERRY_CONTEXT_CEILING") or "").strip()
    if env:
        try:
            return parse_size(env), "PERRY_CONTEXT_CEILING"
        except ValueError:
            pass
    declared, register = declared_ceiling(project_root)
    if declared:
        try:
            return parse_size(declared), register
        except ValueError:
            pass
    path = perry_home / "schema" / "state-schema.json"
    try:
        data = json.loads(path.read_text())
        value = data["thresholds"]["session_context_ceiling"]["value"]
        return int(value), "schema/state-schema.json § thresholds"
    except (OSError, ValueError, KeyError, TypeError):
        return DEFAULT_CEILING, "built-in default (schema unreadable)"


def transcript_dir(project_root: Path) -> Path:
    """Where claude-code keeps this project's transcripts."""
    slug = str(project_root.resolve()).replace(os.sep, "-")
    return Path.home() / ".claude" / "projects" / slug


def newest_transcript(project_root: Path) -> Path | None:
    """The most recently written transcript, which is the live session."""
    d = transcript_dir(project_root)
    if not d.is_dir():
        return None
    files = [p for p in d.glob("*.jsonl") if p.is_file()]
    return max(files, key=lambda p: p.stat().st_mtime) if files else None


def _usage_of(record: dict) -> dict | None:
    usage = (record.get("message") or {}).get("usage")
    return usage if isinstance(usage, dict) and usage else None


def context_of(usage: dict) -> int:
    """What the model was charged to read on this turn."""
    return (usage.get("cache_read_input_tokens", 0)
            + usage.get("cache_creation_input_tokens", 0)
            + usage.get("input_tokens", 0))


def last_usage(path: Path) -> tuple[dict | None, bool]:
    """The most recent turn's usage, read from the END of the file."""
    with path.open("rb") as fh:
        if path.stat().st_size > TAIL_BYTES:
            fh.seek(-TAIL_BYTES, os.SEEK_END)
            fh.readline()          # discard the partial line the seek landed in
            whole = False
        else:
            whole = True
        blob = fh.read()

    while True:
        for raw in reversed(blob.split(b"\n")):
            if b'"usage"' not in raw:
                continue
            try:
                usage = _usage_of(json.loads(raw))
            except (ValueError, TypeError):
                continue
            if usage:
                return usage, whole
        if whole:
            return None, whole
        # The tail carried no usage record. Fall back rather than report zero.
        blob, whole = path.read_bytes(), True


def composition(path: Path) -> dict:
    """What the context is MADE of, over the whole transcript."""
    blocks = collections.Counter()
    counts = collections.Counter()
    shell = collections.Counter()
    shell_n = collections.Counter()

    for raw in path.read_bytes().split(b"\n"):
        if not raw.strip():
            continue
        try:
            record = json.loads(raw)
        except (ValueError, TypeError):
            continue
        message = record.get("message") or {}
        role = message.get("role")
        content = message.get("content")
        if isinstance(content, str):
            blocks[f"{role}:text"] += len(content)
            counts[f"{role}:text"] += 1
            continue
        if not isinstance(content, list):
            continue
        for block in content:
            if not isinstance(block, dict):
                continue
            kind = block.get("type")
            if kind == "thinking":
                key, size = "assistant:thinking", len(block.get("thinking") or "")
            elif kind == "text":
                key, size = f"{role}:text", len(block.get("text") or "")
            elif kind == "tool_use":
                key = "assistant:tool_use INPUT"
                size = len(json.dumps(block.get("input") or {}))
                name = block.get("name")
                if name == "Bash":
                    cmd = (block.get("input") or {}).get("command") or ""
                    head = " ".join(cmd.split()[:2]) or "?"
                    shell[head] += len(cmd)
                    shell_n[head] += 1
            elif kind == "tool_result":
                key = "user:tool_result"
                body = block.get("content")
                size = len(body) if isinstance(body, str) else len(json.dumps(body))
            else:
                continue
            blocks[key] += size
            counts[key] += 1

    def ranked(totals, frequencies, name, count, limit=None):
        return [{name: k, count: frequencies[k], "bytes": v,
                 "approx_tokens": v // 4,
                 "approx_tokens_each": v // 4 // max(1, frequencies[k])}
                for k, v in totals.most_common(limit)]

    return {"blocks": ranked(blocks, counts, "kind", "count"),
            "top_shell": ranked(shell, shell_n, "command", "calls", 12),
            "total_bytes": sum(blocks.values()),
            "total_approx_tokens": sum(blocks.values()) // 4}


# Caps are rounded up from the post-split declared byte totals (2026-09-17).
BILL_BUDGETS = {"snapshot": 80_000, "add-task": 100_000, "close-task": 95_000,
                "dispatch": 115_000, "plan-phase": 80_000}
BILL_SCOPE = ("Static declared L0 + L1 + L2 UTF-8 file bytes, not runtime "
              "transcript usage or tokens. Excludes non-L2 references, rows "
              "without an explicit matching command, transitive reads and "
              "conditional/project-specific context (modes, packs, hooks, state).")


def command_token(token: str, lane: str) -> str:
    """Recognize only index command tokens and the shipped CLI prefixes."""
    words = token.split()
    if words and words[0].startswith("/") and words[0][1:] in ("pmo", "okr", "perry"):
        words = words[1:]
        if words[:1] == [lane]:
            words = words[1:]
    return words[0] if words else ""


def declared_bill(root: Path, command: str) -> dict:
    root = root.resolve()
    lane = "" if command == "snapshot" else "goals" if command == "plan-phase" else "work"
    files, declarations, excluded = {}, [], []

    def source(path, reference=False):
        path = path.resolve()
        relative = path.relative_to(root)  # Reject traversal and symlink escapes before reading.
        if not path.is_file():
            raise ValueError(f"missing file: {path}")
        blob = b"" if reference and not re.fullmatch(r"(?:[^/]+/)?reference/[^/]+\.md", relative.as_posix()) else path.read_bytes()
        blob.decode("utf-8")
        return relative.as_posix(), blob

    for path in [root / "SKILL.md"] + ([root / lane / "SKILL.md"] if lane else []):
        relative, blob = source(path)
        files[relative] = len(blob)
    index = root / lane / "SKILL.md"
    primary = 0
    columns = None
    for number, line in enumerate(index.read_text(encoding="utf-8").splitlines(), 1):
        if not line.startswith("|"):
            columns = None
            continue
        cells = [cell.strip() for cell in re.split(r"(?<!\\)\|", line)[1:-1]]
        if "Subcommand" in cells and "Reference" in cells:
            columns = (cells.index("Subcommand"), cells.index("Reference"), True)
            continue
        if cells == ["Reference file", "Loaded when running"]:
            columns = (1, 0, False)
            continue
        if columns is None:
            continue
        match_col, ref_col, is_primary = columns
        if len(cells) <= max(match_col, ref_col):
            raise ValueError(f"malformed index: {index}:{number}")
        tokens = re.findall(r"`([^`]+)`", cells[match_col])
        if command not in [command_token(token, lane) for token in tokens]:
            continue
        primary += is_primary
        refs = re.findall(r"`([^`]+)`", cells[ref_col].split(" (", 1)[0])
        if not refs:
            raise ValueError(f"missing reference declaration: {index}:{number}")
        declarations.append({"index": index.relative_to(root).as_posix(),
                             "line": number, "references": refs})
        for ref in refs:
            target = root / ref[len("$PERRY_HOME/"):] if ref.startswith("$PERRY_HOME/") else index.parent / ref
            relative, blob = source(target, reference=True)
            if re.fullmatch(r"(?:[^/]+/)?reference/[^/]+\.md", relative):
                files[relative] = len(blob)
            else:
                excluded.append({"path": relative, "reason": "non-L2"})
    if primary != 1:
        raise ValueError(f"{command}: expected one Subcommand/Reference row, found {primary}")
    total, budget = sum(files.values()), BILL_BUDGETS[command]
    return {"command": command, "files": [{"path": p, "bytes": n} for p, n in files.items()],
            "total_bytes": total, "budget_bytes": budget,
            "status": "over" if total > budget else "within",
            "declarations": declarations, "excluded": excluded}


def print_bills(args, root: Path) -> int:
    report = {"mode": "bill", "skill_root": str(root.resolve()), "scope": BILL_SCOPE, "bills": []}
    for command in BILL_BUDGETS if args.bill == "all" else [args.bill]:
        try:
            bill = declared_bill(root, command)
        except (OSError, ValueError, RuntimeError) as error:
            bill = {"command": command, "status": "unknown", "error": str(error)}
        report["bills"].append(bill)
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(BILL_SCOPE)
        print(f"skill root: {report['skill_root']}")
        for bill in report["bills"]:
            print(f"\n{bill['command']}: {bill['status']}")
            if "error" in bill:
                print(bill["error"])
                continue
            for item in bill["files"]:
                print(f"  {item['bytes']:>8} bytes  {item['path']}")
            print(f"  total {bill['total_bytes']} bytes / budget {bill['budget_bytes']} bytes")
            for item in bill["excluded"]:
                print(f"  excluded {item['path']}: {item['reason']}")
    statuses = {bill["status"] for bill in report["bills"]}
    return 2 if "unknown" in statuses else int("over" in statuses)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--ceiling")
    ap.add_argument("--session")
    ap.add_argument("--root")
    ap.add_argument("--composition", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    ap.add_argument("--bill", choices=[*BILL_BUDGETS, "all"])
    ap.add_argument("--bill-skill-root")
    args = ap.parse_args(argv)

    if args.help:
        print(__doc__.strip())
        return 0

    if args.bill:
        if args.session is not None or args.composition or args.ceiling is not None or args.root is not None:
            ap.error("--bill cannot combine with --session, --composition, --ceiling or --root")
        if args.bill_skill_root == "":
            ap.error("--bill-skill-root must not be empty")
        return print_bills(args, Path(args.bill_skill_root or Path(__file__).resolve().parent.parent))
    if args.bill_skill_root is not None:
        ap.error("--bill-skill-root requires --bill")

    # Empty explicit roots must not fall through to cwd.
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    import lib
    bad = lib.empty_root_error("--root", args.root)
    if bad is not None:
        print(f"perry-context-budget: {bad}", file=sys.stderr)
        return 2

    perry_home = Path(os.environ.get("PERRY_HOME", Path(__file__).resolve().parent.parent))
    project_root = Path(args.root or os.environ.get("PERRY_PROJECT") or Path.cwd())

    ceiling, ceiling_from = resolve_ceiling(perry_home, project_root,
                                            args.ceiling)

    def unknown(path, why):
        report = {"verdict": "unknown", "context": None, "ceiling": ceiling,
                  "ceiling_from": ceiling_from, "transcript": str(path) if path else None, "why": why}
        print(json.dumps(report, indent=2) if args.json else
              f"context  : unknown\nverdict  : UNKNOWN — not gating\nwhy      : {why}")
        return 0

    path = Path(args.session) if args.session else newest_transcript(project_root)
    if path is None or not path.exists():
        return unknown(None, "no transcript for this project — either the host is not "
                       "claude-code, or this project has no session history. "
                       "Not gating: a gate that passes silently is worse than "
                       "none, so this one says it abstained.")

    age_min = (time.time() - path.stat().st_mtime) / 60

    if args.composition:
        data = composition(path)
        data["transcript"] = str(path)
        if args.json:
            print(json.dumps(data, indent=2))
            return 0
        print(f"transcript : {path}")
        print(f"written    : {age_min:.0f} min ago")
        print(f"accumulated: ~{data['total_approx_tokens']:,} tokens "
              f"(at ~4 bytes/token, a rule of thumb)\n")
        print(f"{'block type':28} {'count':>7} {'~tokens':>12} {'share':>7} {'~each':>8}")
        total = max(1, data["total_bytes"])
        for b in data["blocks"]:
            print(f"{b['kind']:28} {b['count']:>7} {b['approx_tokens']:>12,} "
                  f"{100 * b['bytes'] / total:>6.1f}% {b['approx_tokens_each']:>8,}")
        if data["top_shell"]:
            print(f"\nbiggest shell commands by bytes TYPED into context:")
            for s in data["top_shell"]:
                print(f"  {s['command'][:34]:34} {s['calls']:>5} calls "
                      f"~{s['approx_tokens']:>9,} tok  ~{s['approx_tokens_each']:>6,}/call")
        return 0

    usage, whole = last_usage(path)
    if usage is None:
        return unknown(path, f"{path} carries no usage record yet")

    context = context_of(usage)
    over = context >= ceiling
    report = {
        "verdict": "OVER" if over else "OK",
        "context": context, "ceiling": ceiling, "ceiling_from": ceiling_from,
        "pct": round(100 * context / max(1, ceiling), 1),
        "transcript": str(path), "transcript_age_min": round(age_min, 1),
        "scanned_whole_file": whole,
    }
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        bar = "OVER — hand off and start a fresh session" if over else "OK"
        print(f"transcript : {path}")
        print(f"written    : {age_min:.0f} min ago")
        print(f"context    : {context:,} tokens")
        print(f"ceiling    : {ceiling:,} ({ceiling_from})")
        print(f"verdict    : {report['pct']}% of budget — {bar}")
    return 1 if over else 0


if __name__ == "__main__":
    sys.exit(main())
