# Which events describe a TASK. `## Intake`, `## User Input Queue` and
# `## Top risks` rows go through the same three-way commit and land in the same
# event log, but they are not tasks and must never appear in `list`'s `tasks[]`.
# ── schema ────────────────────────────────────────────────────────────────


def load_schema() -> dict:
    return lib.load_schema(Refused)


def board_table_spec(schema: dict) -> dict:
    board = next(f for f in schema["files"] if f["id"] == "board")
    return next(t for t in board["tables"] if "P[012]" in t["under"])


def columns_for(values: dict) -> list[str]:
    """Every column this row actually sets, beyond the six every board has.

    Derived from the row rather than from a per-mode table. The table version
    listed `Track`/`Stage`/`Stage since`/`Arrived`/`Parent` and omitted
    `Commitment` — so `--commitment` was accepted, stored into `values`, and
    then dropped by `append_row`, which maps values onto headers and had no
    header to map it to. Exit 0, success message, no cell. That silently
    emptied the scan `modes/queue.md` builds on ("given a commitment due this
    week, which board rows carry its id") and reproduced, for the one column
    the earlier review did not enumerate, the same defect that lost `Arrived`
    at routing a round before.

    A list of columns and a list of values written down separately will drift;
    one derived from the other cannot.
    """
    return [display for key, display in
            ((norm(k), canonical_column(k)) for k in values)
            if key not in REQUIRED_KEYS]


ABSENT = {"", "—", "-", "–", "n/a", "na", "tbd", "无", "none"}


def evidence_paths(cell: str, state_root: Path, project_root: Path) -> tuple[list[str], list[str]]:
    """Split an `Evidence` cell into paths, resolved against a real root.

    The column is free text that people put several things in. One real row:

        `schema/state-schema.json`, `state/adoption_dossier_TEMPLATE.md`, …

    — a comma-separated list, each span backticked, and relative to the
    *project* root while the contract declared `state_root`. Both conventions
    are live in that same column on that same board, and nothing in the string
    distinguishes them.

    Perry knows both roots, so Perry resolves. Returning the raw string and a
    rule would push the guess onto every consumer, and a guess in a consumer is
    how the last divergence started. Each returned path is relative to
    `project_root` and **exists**; spans that resolve nowhere come back
    separately so they can be reported rather than rendered as dead links.
    """
    raw = (cell or "").strip()
    if raw.lower() in ABSENT:
        return [], []
    spans = re.findall(r"`([^`]+)`", raw)
    if not spans:
        spans = [s.strip() for s in re.split(r"[,，;；]", raw) if s.strip()]
    found, unresolved = [], []
    for s in spans:
        # `path § Section` and `path (12 tests)` are both in circulation; the
        # path is the head of the span.
        cand = re.split(r"\s+§|\s+\(", s.strip())[0].strip().rstrip(",.")
        if not cand or cand.lower() in ABSENT:
            continue
        for root in (state_root, project_root):
            p = (root / cand)
            if p.exists():
                try:
                    found.append(str(p.resolve().relative_to(project_root.resolve())))
                except ValueError:
                    found.append(str(p.resolve()))
                break
        else:
            unresolved.append(cand)
    return found, unresolved


#: The separators an `Evidence` cell uses between the things it lists. The same
#: set `evidence_paths` splits an unbackticked cell on, named once so the two
#: readers of this column cannot drift apart on what "next item" means.
EVIDENCE_SEPARATORS = ",，;；"


def evidence_relations(cell: str, state_root: Path, project_root: Path) -> list[dict]:
    """The same cell as `evidence_paths`, TYPED and WHOLE, one entry per thing.

    **The shape this row was titled with does not fit, and that is the finding.**
    The title proposed `{path, kind, round}`. Measured against the 139 live
    evidence cells on this repository:

    - **`round` has no bearer.** It appears in exactly the filenames of some
      review artifacts (`TASK-089-v4-review-r4.md`, `-r3`, `-r8`) — 8 of 139
      cells — and nowhere as a component the cell states. Producing it means
      parsing a number out of an opaque filename, which is the one thing
      `schema/task-list-contract.md` tells a consumer never to do to an `id`.
      A key that is `""` on 131 of 139 rows and a guess on the other 8 is
      worse than no key. **Not emitted.**
    - **`path` is not enough for a span.** A span is a path *plus* something in
      circulation: `§ Section` (`SKILL.md § Mandatory first move`), a symbol
      (`bin/perry-state.load_packs`), a test node (`…py::TestFullTaskSet`), a
      step (`step 2`, `gate 3`), a count (`(21 tests, 3 mutations verified)`),
      a signature (`(signed Ran Jiao 2026-08-16)`). None of that is a path and
      none of it is disposable, so every entry carries the span **verbatim** in
      `text` beside the path Perry could resolve out of its head.
    - **`schema § thresholds` needs no fourth case.** `schema/` is a real
      directory, so its head resolves and the entry is `kind: "dir"` — with
      `§ thresholds`, which is not a path and never was, intact in `text`.
    - **"justifies the close" vs "was changed" is NOT a `kind`.** The spec asked
      whether they are the same kind. They are different *roles* and the string
      does not carry the difference: `perry/evidence/…-result.md` justifies,
      `bin/perry-task` was changed, and `reference/adoption.md` is either one
      depending on the row. Deriving it from the path prefix would be inventing
      provenance the cell never stated — the thing `risks[].id` was corrected
      for at 1.6. `kind` here says **what the string is**, not what it is for.

    So the shape is `{text, path, kind}` and `kind` is a closed set of four:

        `file`        the head resolved to an existing file
        `dir`         the head resolved to an existing directory
        `unresolved`  the head is shaped like a path and resolves under neither
                      root — the same spans `conformance.evidence_not_found`
                      reports, said here in cell order beside their neighbours
        `note`        text the cell carries outside any backticked span, which
                      Perry never treated as a path at all: "(21 tests, 3
                      mutations verified)", "no fixture edited", "lint clean"

    **Nothing is invented and nothing is dropped.** `text` is always a verbatim
    slice of the cell; the only characters of the cell that reach no entry are
    the separators above, backticks and surrounding whitespace. That is the
    `By when` → `Due` + `By when note` rule applied to a column that carries
    four things instead of two: what cannot be typed survives said so.

    **`evidence_paths` is untouched and this agrees with it by construction.**
    The head rule, the root order and the `ABSENT` skip are the same lines, so
    `[e["path"] for e in evidence_relations(...) if e["path"]]` equals
    `evidence_paths(...)[0]` element for element — pinned on all 139 live cells
    by `tests/test_evidence_relation.py`.
    """
    raw = (cell or "").strip()
    if raw.lower() in ABSENT:
        return []
    out: list[dict] = []

    def span(text: str) -> None:
        # The same head rule as `evidence_paths`, deliberately: `path §
        # Section` and `path (12 tests)` both put the path at the head, and two
        # copies of that rule is how a reader and a writer of one column drift.
        cand = re.split(r"\s+§|\s+\(", text.strip())[0].strip().rstrip(",.")
        if not cand or cand.lower() in ABSENT:
            out.append({"text": text.strip(), "path": "", "kind": "note"})
            return
        for root in (state_root, project_root):
            p = (root / cand)
            if p.exists():
                try:
                    rel = str(p.resolve().relative_to(project_root.resolve()))
                except ValueError:
                    rel = str(p.resolve())
                out.append({"text": text.strip(), "path": rel,
                            "kind": "dir" if p.is_dir() else "file"})
                return
        out.append({"text": text.strip(), "path": "", "kind": "unresolved"})

    if "`" in raw:
        # A backticked cell means the author marked the spans, and
        # `evidence_paths` reads only those. Everything BETWEEN them is the
        # prose it discards — counts, mutation tallies, byte-identical claims —
        # and discarding it here too would drop content this row exists to
        # keep. It becomes a `note`, in place, in cell order.
        parts = re.split(r"`([^`]+)`", raw)
        for i, part in enumerate(parts):
            if i % 2:
                span(part)
                continue
            text = part.strip().strip(EVIDENCE_SEPARATORS).strip()
            if text and text.lower() not in ABSENT:
                out.append({"text": text, "path": "", "kind": "note"})
    else:
        for piece in re.split(r"[" + EVIDENCE_SEPARATORS + r"]", raw):
            if piece.strip():
                span(piece)
    return out


#: What an id cell may look like, as ONE regex read by everything that has to
#: decide "is this a handle or is this prose". `cmd_list` had it inline for
#: `rows_with_unrecognized_id` and the dependency writer needed the same
#: question answered the same way — two copies of this rule is how a board grew
#: a row the writer accepted and the reader filed as unreadable.
#:
#: Deliberately not `TASK-\d+`: `schema/task-list-contract.md` says an id is an
#: opaque stable string and that a real board carries several project-declared
#: prefixes, some with no number at all.
HANDLE_RE = re.compile(r"[A-Za-z][\w./-]*-?\d*")

#: What a dependency may be named when this project has never issued it — a
#: prefix (`PREFIX_RE`'s shape) and a number. Strictly narrower than
#: `HANDLE_RE`, and the difference is the point: see `check_depends`.
DEP_ID_RE = re.compile(r"[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z][A-Za-z0-9]*)*-\d+")


def strip_handle(cell: str) -> str:
    """An id cell with its decoration removed.

    `~~DATA-007~~` and `**TASK-1**` are both real and both from a real board:
    strikethrough means retired, bold means emphasis, and the id underneath is
    the handle either way.
    """
    return (cell or "").replace("~", "").replace("*", "").replace("`", "").strip()


#: What separates two ids in a `Depends on` cell. Comma, semicolon, their
#: full-width forms, the CJK enumeration comma and whitespace — a cell is a
#: list, and a project writes a list in its own punctuation.
_DEPENDS_SPLIT = re.compile(r"[,，;；、\s]+")


def parse_depends(cell: str) -> list[str]:
    """A `Depends on` cell → the ids in it, in cell order, deduplicated.

    ONE split rule, read by the writer that validates the flag and by the
    reader that publishes `depends_on`. A writer and a reader disagreeing about
    one cell is the defect this repository has now found four times
    (`schema/README.md § Columns resolve by name`), and a dependency graph is
    the worst place for a fifth: a mis-split cell does not look wrong, it looks
    like a row that is ready to start.

    `—`, `n/a` and the rest of `ABSENT` mean *no dependency*, not a dependency
    named "—". They are what `add` writes when nobody passed `--depends`.
    """
    raw = (cell or "").strip()
    if raw.lower() in ABSENT:
        return []
    out: list[str] = []
    for tok in _DEPENDS_SPLIT.split(raw):
        tok = strip_handle(tok).strip(",.;:")
        if not tok or tok.lower() in ABSENT or tok in out:
            continue
        out.append(tok)
    return out


def store_depends(records: list[dict]) -> dict[str, list[str]]:
    """Every current dependency edge, from the canonical task records."""
    return {r["id"]: list(r.get("depends_on") or []) for r in records}


def find_cycle(edges: dict[str, list[str]], start: str) -> list[str]:
    """The path back to `start`, or `[]`. Depth-first, deterministic.

    Only ids that are themselves in `edges` are walked: an edge onto a closed
    task, or onto a `DESIGN-`/`ADR-`/`USER-` id, is a leaf here rather than an
    unknown, because a row that is not on the board declares no dependencies of
    its own and so can close no loop. An ask is a node in the dependency graph
    (TASK-162) and still a leaf in this one: a question put to a human waits on
    the human and on nothing this tool can name.
    """
    stack = [(start, [start])]
    seen = {start}
    while stack:
        node, path = stack.pop()
        for nxt in edges.get(node, []):
            if nxt == start:
                return path + [start]
            if nxt not in seen and nxt in edges:
                seen.add(nxt)
                stack.append((nxt, path + [nxt]))
    return []


def check_depends(tid: str, value: str, ctx) -> list[str]:
    """Validate `--depends`/`--on` and return the ids to write.

    Three refusals, and the reasoning for each is the reason this is a write
    check rather than a read report.

    **Shape.** A dependency has to be a handle, because the whole point is that
    something can resolve it. Prose in this cell would rebuild, one column to
    the right, exactly the unreadable `- **Dependencies**: <free text>` line
    this replaces.

    **Self.** A row that waits on itself is never startable and no event can
    ever change that.

    **Cycles**, among the edges the board already declares. Refused here and
    only here: `list` REPORTS a cycle it finds and never refuses, because a
    board is hand-editable by design (DESIGN-004 decision 5) and a reader that
    refuses a state a human can legitimately create is a reader that stops
    working. The write path is the one place the loop can be prevented instead
    of described.

    **Not refused: an id this project has never heard of.** A dependency MUST be
    able to name a closed task — `done` removes the row, and refusing the ids
    that are no longer on the board would mean every satisfied dependency had to
    be deleted from the record to be written in the first place. It also has to
    be able to name a `DESIGN-` or `ADR-` id, which no board table carries.
    `conformance.depends_on_unknown` names them at read time so a typo is
    visible without making a legitimate edge unwritable.

    **`--on USER-nnn` is not refused either, and it is no longer reported.**
    TASK-162: an ask this project has issued is a node, the reader resolves it
    against `## User Input Queue`, and an *answered* one satisfies the edge the
    way a closed task does. That is the one register besides `tasks.jsonl`
    whose rows reach a terminal state Perry can read, so it is the one the
    graph can join; see the TASK-162 block above `ask_register`. A `USER-` id
    the queue does not carry is still unknown and still reported.
    """
    ids = parse_depends(value)
    if not ids:
        raise Refused(
            "--on names no dependency: pass one or more ids, or use --clear "
            "to say this row waits on nothing")
    known = {r["id"] for r in ctx["task_records"]}
    for d in ids:
        # `HANDLE_RE` is deliberately NOT the test here. It answers the
        # reader's question — "is this cell a handle or is it prose?" — and it
        # says yes to any bare word, because `id` is documented as an opaque
        # string and a real board carries ids with no number at all. Used as a
        # write check it would accept `--on "waiting for the design review"`
        # as five dependencies named `waiting`, `for`, `the`, `design` and
        # `review`: the same over-eager first-token guess that put `id: "H"`
        # into a payload, moved one column to the right.
        #
        # So: an id this project has already issued, or something shaped
        # unmistakably like one — a prefix and a number. That admits
        # `DESIGN-006` and `ADR-005`, which no board table carries and which
        # are legitimate things to wait on, and refuses a sentence.
        if d not in known and not DEP_ID_RE.fullmatch(d):
            raise Refused(
                f"{d!r} is not an id. A dependency has to be something that "
                f"can be resolved — put the explanation in --reason or "
                f"`perry-task next`, and name the handle here")
        if d == tid:
            raise Refused(f"{tid} cannot depend on itself")
    edges = store_depends(ctx["task_records"])
    edges[tid] = ids
    cycle = find_cycle(edges, tid)
    if cycle:
        raise Refused(
            "that edge closes a dependency cycle: " + " → ".join(cycle) +
            ". Every row in a cycle waits forever and none of them is "
            "startable; break it by dropping one edge")
    return ids


def canonical_column(key: str) -> str:
    """`"stage since"` → `"Stage since"` — the schema's own spelling."""
    if _ALIASES is None:
        _build_column_maps()
    return (_DISPLAY.get(norm(key)) or {}).get("en", key.title())


# ── board ─────────────────────────────────────────────────────────────────


PRIORITY_RE = {p: re.compile(rf"^##\s+{p}\b") for p in ("P0", "P1", "P2")}


# Why a task subcommand will not touch a row in each non-task section, and what
# to run instead. Keyed by the canonical `Board.NON_TASK_SECTIONS` name.
#
# `Board.find()` answered all five of these with "is not a row on the board",
# which is false about a row the same tool wrote one command earlier and which
# `perry-state --json` lists. A refusal that misdescribes the state sends the
# reader looking for a missing row instead of for the rule; a refusal that names
# the rule ends the question. The rule is per-section because the reasons are
# different — a recurrence has no end, an intake row is not yet work, a question
# is answered rather than finished — and one shared sentence would have to be
# vague enough to be true of all three, which is how the false one got written.
NON_TASK_REFUSAL = {
    "Cadence": (
        "{id} is a row in `## Cadence`, which is a recurrence register, not a "
        "task section. A recurrence has no end, so it is never `done`, "
        "`dropped` or moved through a status: closing it would delete the only "
        "record that the ritual is supposed to keep happening.\n"
        "  · record a run:  perry-task cadence-done {id} --evidence <path>\n"
        "  · retire it:     delete the row from `## Cadence` "
        "(`modes/queue.md § What recurs`)"),
    "Intake": (
        "{id} is a row in `## Intake`, which holds requests that are not yet "
        "work — they carry no `Status` to change and no owner to hold them.\n"
        "  · make it work:  perry-task route <row number> --track <track>\n"
        "  · discharge it:  perry-task resolve-intake <row number> --outcome "
        "dropped|deferred --reason <why>"),
    "User Input Queue": (
        "{id} is a row in `## User Input Queue`, which holds questions waiting "
        "on the user. A question is answered, not finished.\n"
        "  · answer it:     perry-task answer {id} --answer <text>"),
    "Top risks": (
        "{id} is a row in `## Top risks`. A risk is not a task: it is closed by "
        "being retired or accepted, not by being done.\n"
        "  · retire it:     perry-task risk-clear {id} --reason <why>"),
}


class Board:
    """`BOARD.md` as lines, edited in place and rendered back byte-for-byte.

    Text-level rather than model-level on purpose: TASK-029's verification is
    that a tool-written board is byte-identical to the hand-written one it
    replaces. Round-tripping through a parsed model would normalize whitespace,
    alignment and column order — and every downstream reader keys on those.
    """

    def __init__(self, path: Path):
        self.path = path
        if not path.exists():
            raise Refused(f"no BOARD.md at {path}")
        self.lines = path.read_text().split("\n")

    # -- locating

    def section(self, priority: str) -> tuple[int, int]:
        """(first line index, end index) of the given priority section."""
        start = None
        for i, line in enumerate(self.lines):
            if PRIORITY_RE[priority].match(line):
                start = i
                continue
            if start is not None and line.startswith("## "):
                return start, i
        if start is None:
            raise Refused(f"BOARD.md has no `## {priority}` section")
        return start, len(self.lines)

    def table(self, priority: str) -> tuple[int, int, list[str]]:
        """(header index, separator index, header cells) for a section's table."""
        lo, hi = self.section(priority)
        for i in range(lo, hi):
            if re.match(r"^\|\s*:?-{2,}", self.lines[i]) and i > lo:
                header = split_row(self.lines[i - 1])
                return i - 1, i, header
        raise Refused(f"`## {priority}` has no table")

    def last_row(self, priority: str) -> int:
        """Index of the last data row, or the separator when there are none."""
        lo, hi = self.section(priority)
        tables = perry_store.markdown_tables(self.lines, lo, hi, norm)
        if not tables:
            raise Refused(f"`## {priority}` has no table")
        table = tables[0]
        return table["rows"][-1]["line"] if table["rows"] else table["separator"]

    # -- reading

    def rows(self) -> list[tuple[str, str, dict]]:
        """(priority, raw line, cells-by-header) for every data row."""
        out = []
        for table in self.task_tables():
            if not table["readable"] or not table["priority"]:
                continue
            for item in table["row_items"]:
                out.append((table["priority"], self.lines[item["line"]],
                            item["values"]))
        return out

    # Sections that hold something other than task rows. Matched against the
    # canonical name and its `i18n.headings` aliases, so a localized board is
    # skipped for the same reasons an English one is.
    NON_TASK_SECTIONS = ("Intake", "Cadence", "User Input Queue", "Top risks")

    def _section_tables(self):
        """(heading, priority|None, separator index, header cells, end index).

        The ONE walk over the board's task-bearing sections. `task_tables()`
        (read) and `find()` (write) both go through it, because they drifted
        the moment they did not: the reader was taught to see every section and
        the finder was left on P0/P1/P2, so 20 rows in a project's own
        `## Done this period` archive were listed by `list` and refused by
        `done` with "is not an open row on the board" — a message that was
        false, about rows the same tool had just printed.
        """
        skip = {s.lower() for name in self.NON_TASK_SECTIONS
                for s in heading_spellings(name)}
        heads = [(i, l) for i, l in enumerate(self.lines) if l.startswith("## ")]
        for n, (start, line) in enumerate(heads):
            end = heads[n + 1][0] if n + 1 < len(heads) else len(self.lines)
            title = line[3:].strip()
            if any(title.lower().startswith(s) for s in skip):
                continue
            pri = next((p for p in ("P0", "P1", "P2")
                        if PRIORITY_RE[p].match(line)), None)
            for table_index, table in enumerate(
                    perry_store.markdown_tables(self.lines, start + 1, end, norm)):
                yield title, pri, table_index, table

    def _task_sections(self):
        """Compatibility view of ``_section_tables`` for heading callers."""
        for title, pri, _n, table in self._section_tables():
            yield (title, pri, table["separator"], table["header"], table["end"])

    def task_tables(self) -> list[dict]:
        """Every section of this board that holds task-shaped rows.

        `rows()` looks only at `## P0` / `## P1` / `## P2`, which is right for
        the WRITE path — a new row needs a priority and those are the only
        sections that mean one. It is wrong for the read path, and silently so.

        A real Perry project checked while writing this organizes its board by
        workstream: `## Open — 投资线`, `## Open — 工程线 · phase #004`,
        `## ✅ v2.0 build — DEPLOYED`, `## Backbone`, and one `## P2`. Reading
        only P0/P1/P2 found the single section whose name happened to match,
        reported three tasks for a project with dozens, and — because it never
        checked what it was reading — picked up rows from a `## ID prefixes`
        reference table as though they were work. A front-end handed that
        payload shows the user confident nonsense.

        So: every `## ` section whose table resolves at least `ID` and `Title`
        is a task table. `P0`/`P1`/`P2` carry their priority; anything else
        carries its heading as `group` and no priority, because inventing one
        would be claiming the project said something it did not.
        """
        out = []
        for title, pri, table_index, table in self._section_tables():
            header, keys = table["header"], table["keys"]
            if "id" not in keys or "title" not in keys:
                # A table under a `## ` heading that is not a task table — a
                # reference table, a glossary, a legend. Reported, not read.
                out.append({"heading": title, "priority": None, "header": header,
                            "rows": [], "row_items": [], "readable": False,
                            "table_index": table_index})
                continue
            rows = [item["values"] for item in table["rows"]]
            out.append({"heading": title, "priority": pri, "header": header,
                        "rows": rows, "row_items": table["rows"],
                        "readable": True, "table_index": table_index})
        return out

    def refuse_duplicate_task_ids(self) -> None:
        """Refuse ambiguous task identity before any command can mutate state."""
        found: dict[str, list[int]] = {}
        for table in self.task_tables():
            if not table["readable"]:
                continue
            for item in table["row_items"]:
                tid = strip_handle(item["values"].get("id", ""))
                if tid and HANDLE_RE.fullmatch(tid):
                    found.setdefault(tid, []).append(item["line"] + 1)
        dupes = {tid: lines for tid, lines in found.items() if len(lines) > 1}
        if dupes:
            detail = "; ".join(f"{tid} on lines {', '.join(map(str, lines))}"
                               for tid, lines in sorted(dupes.items()))
            raise Refused(f"BOARD.md has duplicate task ids: {detail}. Nothing "
                          f"was written; each task id must identify one row.")

    def find(self, task_id: str) -> tuple[str, int, list[str], list[str]]:
        """(priority-or-heading, line index, header, cells) for one row.

        Searches EVERY task-bearing section, not only `P0`/`P1`/`P2`. Needing a
        priority is a rule about `add` — a new row has to be filed somewhere —
        and it was wrongly applied to the whole write path. Locating a row that
        already exists is a different question, and answering it "not on the
        board" about a row `list` had just printed made every archived row
        permanently unclosable.
        """
        for table in self.task_tables():
            if not table["readable"]:
                continue
            for item in table["row_items"]:
                cells = item["cells"]
                if strip_handle(item["values"].get("id", "")) == task_id:
                    return (table["priority"] or table["heading"], item["line"],
                            table["header"], cells)
        section = self._non_task_row(task_id)
        if section:
            raise Refused(NON_TASK_REFUSAL[section].format(id=task_id))
        raise Refused(f"{task_id} is not a row on the board")

    def _non_task_row(self, task_id: str) -> str | None:
        """The canonical `NON_TASK_SECTIONS` name holding this id, or `None`.

        `find()` used to answer "is not a row on the board" for these, which is
        the defect `_task_sections` documents four docstrings up — *"a message
        that was false, about rows the same tool had just printed"* — and it was
        reintroduced the moment `Cadence` joined the skip list. `perry-task
        cadence-add` writes `CAD-001`, `perry-state --json` lists it, and
        `done` / `status` / `next` / `drop` / `retitle` all said it did not
        exist. Naming the section is half the fix; `NON_TASK_REFUSAL` carries
        the other half, which is the rule and the way forward.
        """
        aliases = {s.lower(): name for name in self.NON_TASK_SECTIONS
                   for s in heading_spellings(name)}
        heads = [(i, l) for i, l in enumerate(self.lines) if l.startswith("## ")]
        for n, (start, line) in enumerate(heads):
            end = heads[n + 1][0] if n + 1 < len(heads) else len(self.lines)
            title = line[3:].strip().lower()
            canonical = next((c for s, c in aliases.items()
                              if title.startswith(s)), None)
            if not canonical:
                continue
            for i in range(start + 1, end):
                s = self.lines[i].strip()
                if not s.startswith("|"):
                    continue
                cells = split_row(self.lines[i])
                if cells and cells[0].replace("*", "").replace("~", "").strip() == task_id:
                    return canonical
        return None

    # -- writing

    def ensure_columns(self, priority: str, needed: list[str]) -> list[str]:
        """Add any missing column to the header, separator and every row.

        The clause only `Verification` had before DESIGN-004: you cannot set a
        cell in a column with no header, and `BOARD_TEMPLATE.md` ships six.
        """
        lo, hi = self.section(priority)
        first = None
        for table in perry_store.markdown_tables(self.lines, lo, hi, norm):
            header = table["header"]
            if not {"id", "title"} <= set(table["keys"]):
                continue
            missing = [c for c in needed
                       if not any(norm(h) == norm(c) for h in header)]
            if not missing:
                first = first or header
                continue
            shown = [display_name(c, header_language(header)) for c in missing]
            widened = header + shown
            self.lines[table["header_line"]] = render_row(widened)
            self.lines[table["separator"]] = \
                "|" + "|".join(["---"] * len(widened)) + "|"
            for item in table["rows"]:
                self.lines[item["line"]] = render_row(
                    item["cells"] + [""] * len(shown))
            first = first or widened
        if first is None:
            raise Refused(f"`## {priority}` has no task table")
        return first

    def ensure_section(self, heading: str, columns: list[str],
                       before_p0: bool = True) -> None:
        """Create `## <heading>` with its table if the board lacks it.

        `## Intake` is the organ queue mode is built on and the first thing
        `triage` walks. Nothing created it before DESIGN-004, so step 0 gated
        itself on "only applies when the section exists" and no-opped forever
        for every queue track ever made.

        `## Intake` is inserted before `## P0` so it reads above the work it
        becomes, which is the order `modes/queue.md` describes it in. Every
        other section is appended, because that is where `BOARD_TEMPLATE.md`
        puts them — `## User Input Queue` created above the board pushed the
        work below a list of open questions, which is not what a standup reads
        first.

        Heading and columns are both written in the board's own language.
        `ensure_columns` localized new headers and explained why in the same
        round this method was added, and this one hardcoded English — so a
        localized board got `## Intake | Arrived | Request | Outcome |` bolted
        onto a `编号 | 标题 | …` table. One of two siblings fixed is the shape
        every review round here has found.
        """
        # **The call site that created the duplicate.** `ensure_section` is what
        # `risk-add` runs before writing, and it used a regex that could not see
        # `## **Top risks**`, so it built a second section beside the one that
        # was already there.
        if any(heading_matches(l, heading) for l in self.lines):
            return
        try:
            lang = header_language(self.table("P0")[2])
        except Refused:
            lang = "en"
        shown = next((s for s in heading_spellings(heading)[1:]
                      if lang != "en"), heading)
        columns = [display_name(c, lang) for c in columns]
        anchor = (next((i for i, l in enumerate(self.lines)
                        if PRIORITY_RE["P0"].match(l)), len(self.lines))
                  if before_p0 else len(self.lines))
        block = [f"## {shown}", "", render_row(columns),
                 "|" + "|".join(["---"] * len(columns)) + "|", ""]
        self.lines[anchor:anchor] = block

    def named_section(self, heading: str) -> tuple[int, int]:
        """(heading line index, end index) for a named `## ` section.

        The span, not the table — `section_table` answers "where are this
        section's columns" and raises when there are none, which is the right
        answer for a reader and useless to the one caller that has to look at a
        section precisely BECAUSE it is not a table yet.
        """
        start = next((i for i, l in enumerate(self.lines)
                      if heading_matches(l, heading)), None)
        if start is None:
            raise Refused(f"BOARD.md has no `## {heading}` section")
        end = next((i for i in range(start + 1, len(self.lines))
                    if self.lines[i].startswith("## ")), len(self.lines))
        return start, end

    def has_section(self, heading: str) -> bool:
        return any(heading_matches(l, heading) for l in self.lines)

    def section_table(self, heading: str) -> tuple[int, list[str]]:
        """(separator index, header cells) for a named non-priority section."""
        start = next((i for i, l in enumerate(self.lines)
                      if heading_matches(l, heading)), None)
        if start is None:
            raise Refused(f"BOARD.md has no `## {heading}` section")
        for i in range(start, len(self.lines)):
            if self.lines[i].startswith("## ") and i > start:
                break
            if re.match(r"^\|\s*:?-{2,}", self.lines[i]) and i > start:
                return i, split_row(self.lines[i - 1])
        raise Refused(f"`## {heading}` has no table")

    def section_rows(self, heading: str) -> list[tuple[int, list[str]]]:
        """Every row of a named section, across `###` sub-groups.

        The reader tolerates a `###` label inside `## Cadence` or `## Intake`
        and resumes on the same header (`viewer/parsers.py § _parse_cadence`,
        `_parse_task_table`); this stopped at the first one. The two then
        disagreed about what the section contained, and the writers answered the
        disagreement with another false message: `cadence-done` refused a
        sub-grouped row as "not a row in `## Cadence`" while `cadence-add`
        succeeded and widened the header past rows it never padded, leaving a
        ragged table that lints clean. A `>` note is skipped for the same
        reason. Anything else still ends the section — prose after a table is
        the boundary, and reading past it is how a writer starts editing text
        that is not a row.
        """
        start, end = self.named_section(heading)
        return [(item["line"], item["cells"])
                for table in perry_store.markdown_tables(
                    self.lines, start + 1, end, norm)
                for item in table["rows"]]

    def ensure_section_columns(self, heading: str, needed: list[str]) -> list[str]:
        """`ensure_columns`, for a named non-priority section.

        Its sibling existed for the priority tables from the day mode columns
        landed; this one did not, so a board that already had
        `## User Input Queue` without `Asked` had nowhere to put the date and
        the tool would have dropped it silently — the same defect that lost
        `--commitment` on the task tables.
        """
        start, end = self.named_section(heading)
        first = None
        for table in perry_store.markdown_tables(self.lines, start + 1, end, norm):
            header = table["header"]
            missing = [c for c in needed
                       if not any(norm(h) == norm(c) for h in header)]
            if not missing:
                first = first or header
                continue
            shown = [display_name(c, header_language(header)) for c in missing]
            widened = header + shown
            self.lines[table["header_line"]] = render_row(widened)
            self.lines[table["separator"]] = \
                "|" + "|".join(["---"] * len(widened)) + "|"
            for item in table["rows"]:
                self.lines[item["line"]] = render_row(
                    item["cells"] + [""] * len(shown))
            first = first or widened
        if first is None:
            raise Refused(f"`## {heading}` has no table")
        return first

    def find_section_row(self, heading: str, row_id: str):
        """(line index, header, cells) for one row of a named section.

        The id column is resolved by NAME through the glossary, like every
        other column this file touches (`schema/README.md § Columns resolve by
        name`). It used to read `cells[0]`, which made the writer disagree with
        the reader on a board that lists its columns in another order:

            board: | Status | Opened | Risk | ID |
            reader (parse_top_risks):    id='RX-001'
            writer (risk-clear RX-001):  "RX-001 is not a row in `## Top risks`"

        `perry-state` reporting a risk that `risk-clear` insists does not exist
        is the same defect class as a column resolved by position anywhere
        else — the row is there, and the tool cannot see it.

        **There is no positional fallback.** Position used to stand in for a
        section whose header named no id column at all — "those tables predate
        the glossary and their first cell is the handle by convention" — and
        that is a per-shape tolerance branch of exactly the kind ADR-004 §
        *Where tolerance lives now* retires: it accepts a shape the declared
        schema does not describe and reads it anyway, silently.

        It is unreachable for a declared file. All three sections this serves
        declare an id column that `perry-lint` reports as a `table-columns`
        **error** when it is missing — `## Top risks` and `## Cadence` name
        `ID`, `## User Input Queue` names `USER-id` — so a board without one
        cannot be declared conformant and, under the `enforce` gate, cannot be
        written to at all. `norm()` resolves the localized spellings through
        the glossary, so `编号` lands on the same key; the fallback was not
        carrying the i18n case either.

        What it was carrying is a *guess*: on a header this tool cannot read,
        column 0 might be the handle or might be `Status`, and clearing the
        wrong row is a silent write into somebody's file. The refusal below
        names the column and the road instead, which is the shape ADR-004 § 4
        asks every gate refusal to have.
        """
        _, header = self.section_table(heading)
        keys = [norm(h) for h in header]
        at = next((i for i, k in enumerate(keys) if k in id_column_keys()), -1)
        if at < 0:
            raise Refused(
                f"`## {heading}` has no id column: its header is {header} and "
                f"no cell of it resolves to `ID` or `USER-id` (or a spelling "
                f"`schema/state-schema.json § i18n.columns` declares). Perry "
                f"resolves every column by name, so there is no row this can "
                f"be about, and guessing the first cell would clear whichever "
                f"row happened to sit under it. Nothing was written. Add the "
                f"column, or run `perry-migrate` and then "
                f"`perry-conform declare` for this file")
        for i, cells in self.section_rows(heading):
            cell = cells[at] if at < len(cells) else ""
            if cell.replace("*", "").replace("~", "").strip() == row_id:
                return i, header, cells
        raise Refused(f"{row_id} is not a row in `## {heading}`")

    def append_section_row(self, heading: str, values: dict) -> str:
        sep, header = self.section_table(heading)
        rows = self.section_rows(heading)
        at = (rows[-1][0] if rows else sep) + 1
        line = render_row([values.get(norm(h), "") for h in header])
        self.lines.insert(at, line)
        return line

    def append_row(self, priority: str, values: dict, group: str = "") -> str:
        """Append to a priority table, or to a named section when `group` is
        given.

        The write side required `## P0` / `## P1` / `## P2` long after the read
        side learned to see every section. On the only year-old real project
        available — a board filed under `## Open — 投资线` and
        `## Open — 工程线 · phase #004` — `add` refused with "BOARD.md has no
        `## P1` section", so arrivals could be recorded and never routed.

        Creating the missing priority section would have been the wrong fix:
        "no automatic rewrite of a project's existing structure" is an
        Anti-Goal, and a project that files work by workstream is not
        malformed. So the project says where the row goes instead.
        """
        if group:
            sep, header = self.section_table(group)
            check_header(header)
            rows = self.section_rows(group)
            at = (rows[-1][0] if rows else sep) + 1
        else:
            _, _, header = self.table(priority)
            check_header(header)
            at = self.last_row(priority) + 1
        cells = [values.get(norm(h), "") for h in header]
        line = render_row(cells)
        self.lines.insert(at, line)
        return line

    def task_section_headings(self) -> list[str]:
        """Headings a row could be filed under, for a refusal that helps."""
        return [title for title, _, _, header, _ in self._task_sections()
                if {"id", "title"} <= {norm(h) for h in header}]

    def replace_row(self, index: int, header: list[str], values: dict) -> str:
        check_header(header)
        cells = [values.get(norm(h), "") for h in header]
        self.lines[index] = render_row(cells)
        return self.lines[index]

    def remove_row(self, index: int) -> str:
        return self.lines.pop(index)

    def text(self) -> str:
        return "\n".join(self.lines)


_ALIASES: dict[str, str] | None = None
_DISPLAY: dict[str, dict[str, str]] | None = None


def _build_column_maps() -> None:
    """Read `schema § i18n.columns` once — every spelling of every header.

    `perry-task` was the single component in this stack that never consulted
    this table. `perry-state` and `perry-lint` both resolve headers
    through it; the writer keyed rows on hardcoded English. Because TASK-033
    routed *every* board write through this tool, that made it the one
    component able to corrupt a board written in the document language Perry
    advertises — and it did, silently, at exit 0: `add` wrote a row of empty
    cells on a `编号 | 标题 | …` board while the journal line and the event
    both asserted the task existed. The tool built to eliminate board-vs-history
    divergence produced it on its first write.

    Perry's own board is English, so no amount of dogfooding could surface
    this. Three review rounds read the migration and missed it for the same
    reason.
    """
    global _ALIASES, _DISPLAY
    aliases: dict[str, str] = {}
    display: dict[str, dict[str, str]] = {}
    try:
        columns = load_schema()["i18n"]["columns"]
    except Exception:
        columns = {}
    for canon, langs in columns.items():
        key = squash(canon)
        # First spelling wins: the table maps two English columns onto one
        # Chinese word in at least one case (`Deadline` / `By when` → 截止),
        # and an arbitrary-but-stable choice beats one that depends on dict
        # ordering. Neither is a board column, so no board write is affected.
        aliases.setdefault(key, key)
        display.setdefault(key, {"en": canon})
        for lang, names in (langs or {}).items():
            for name in names:
                aliases.setdefault(squash(name), key)
                display[key].setdefault(lang, name)
    _ALIASES, _DISPLAY = aliases, display


def days_between(value: str) -> int | None:
    m = re.search(r"\d{4}-\d{2}-\d{2}", value or "")
    if not m:
        return None
    try:
        return (date.today() - datetime.strptime(m.group(0), "%Y-%m-%d").date()).days
    except ValueError:
        return None


def norm(s: str) -> str:
    """A header cell → the canonical key rows are stored under.

    Applied to header cells and to canonical English column names, which is
    every use: a localized header and its English name resolve to one key, so
    `values["status"]` lands in `状态` without any call site knowing that.
    """
    if _ALIASES is None:
        _build_column_maps()
    k = squash(s)
    return _ALIASES.get(k, k)


# The columns that hold a row's handle, in every section that has one. A set
# rather than a single name because `## User Input Queue` calls it `USER-id`
# and the rest call it `ID`; both resolve through the glossary, so `编号` and
# `用户输入编号` land here too. Computed on demand, never at import: `norm()`
# caches the glossary the first time it is called, and calling it while the
# module is still loading would cache an empty one.
def id_column_keys() -> set[str]:
    return {norm("ID"), norm("USER-id")}


def header_language(header: list[str]) -> str:
    """Which language this table's headers are already written in.

    Read off the board rather than out of `.perry/config.md`: a new column has
    to match the row it is joining, and the header is the only thing that
    states that without a second file being right.
    """
    if _ALIASES is None:
        _build_column_maps()
    for cell in header:
        key = norm(cell)
        for lang, name in (_DISPLAY.get(key) or {}).items():
            if lang != "en" and squash(name) == squash(cell):
                return lang
    return "en"


def display_name(canonical: str, lang: str) -> str:
    """The spelling a column gets when this board is missing it."""
    if _ALIASES is None:
        _build_column_maps()
    return (_DISPLAY.get(norm(canonical)) or {}).get(lang, canonical)


_HEADINGS: dict[str, dict[str, str]] | None = None


def heading_spellings(name: str) -> list[str]:
    """Every spelling of a `## <heading>`, canonical English first.

    `ensure_section` and `section_table` matched the English name exactly, so on
    a board that already carried `## 收件` the tool did not see it, appended a
    second `## Intake`, and then read and wrote only the new English one —
    leaving the queue the user was actually filling unreachable by every
    subcommand. `perry-lint` reports the duplicate clean, because the schema
    declares `^Intake\\b|^收件` for the table and says nothing about there being
    one of them.
    """
    global _HEADINGS
    if _HEADINGS is None:
        try:
            _HEADINGS = load_schema()["i18n"].get("headings", {})
        except Exception:
            _HEADINGS = {}
    out = [name]
    for names in (_HEADINGS.get(name) or {}).values():
        out += list(names)
    return out


#: An id-shaped token: a capitalised word, a hyphen, digits. `LOAD-02` is
#: `perry-diagnose`'s finding for one of these that resolves to nothing.
_IDISH = re.compile(r"\b([A-Z][A-Z0-9]{1,9})-(\d{1,4})\b")


def idish_tokens_that_resolve_nowhere(text: str, ctx) -> list[str]:
    """Tokens in a cell that LOOK like ids and name nothing. Advisory.

    **Written after causing this defect three times in one session.** Prose
    like `THE ROUND-2 DEFECT` and `ALL FIVE ROUND-3 FINDINGS` reads as English
    to the author and as an identifier to every id reader in this repository —
    `perry-diagnose` reports it as `LOAD-02` dangling, and the repo's own gate
    goes red on a board the tool itself wrote.

    Fixing the prose each time did not stop the third one. This is the fix,
    at the write site, where the person who knows what they meant is still in
    the room — the same argument `reference/promotion.md` makes for capturing
    a knowledge card at close time rather than later.

    Advisory, never a refusal: `USER-014` and `ADR-006` are legitimate
    references to ids this board does not carry, and refusing them would make
    the tool unable to cite a decision.
    """
    known = set(task_id_prefixes(ctx["task_records"]))
    known.update({"ADR", "DESIGN", "USER", "SRC", "KR", "TASK"})
    out = []
    for prefix, num in _IDISH.findall(text or ""):
        if prefix not in known:
            out.append(f"{prefix}-{num}")
    return out


def declared_roles(ctx) -> list[str]:
    """Role names this project has declared, from `.perry/roles/*.md`.

    `owner: user` — a role card is a declaration the project makes about
    itself, not lane state, which is why it lives beside `hook.md` rather than
    under the state root.
    """
    rdir = ctx["project_root"] / ".perry" / "roles"
    return sorted(p.stem for p in rdir.glob("*.md")) if rdir.exists() else []


def check_role(value: str | None, ctx) -> str:
    """`Role` is required once the project declares any role card, and does not
    exist otherwise. DESIGN-006 decision #4.

    **The asymmetry is Goal 7**, and it is the whole reason this is not simply
    a required column: a project that never hears of roles must behave exactly
    as it does today — no new column, no new flag to learn, no refusal
    mentioning a concept it has not adopted. The same no-op property
    `modes/project.md` holds for work modes.

    So the refusal is conditioned on the project, never on the value: with no
    cards, `--role` is accepted and filed like any other cell and nothing is
    demanded; with cards, a roleless row is refused and the refusal lists the
    roles that exist, because a user who must name one needs to know the set.
    """
    roles = declared_roles(ctx)
    v = (value or "").strip()
    if not roles:
        return v
    if not v:
        raise Refused(
            f"--role is required: this project declares "
            f"{len(roles)} role(s) — {', '.join(roles)}. A row with no role "
            f"names nobody accountable for reaching its rung, and "
            f"`Accepted by` on the card is what the close gate reads")
    if v not in roles:
        raise Refused(
            f"role {v!r} has no card. Declared: {', '.join(roles)}. Add "
            f"`.perry/roles/{v}.md` — `packs/software-ops/roles/` ships three "
            f"to copy — or name one of those")
    return v


def check_rung(rung: str, schema: dict) -> str:
    """One validator, because `done` had one and `add` had none.

    `add --rung V4` was accepted and silently dropped — the flag parsed, the
    cell was never written, and the row carried no rung. `--rung NONSENSE` was
    accepted the same way. A flag that does nothing is worse than a missing
    one: the caller believes the value landed.

    `V0` is refused by name wherever a rung is written. It is the label for
    what is being rejected, never a rung a row may carry.
    """
    if not rung:
        return ""
    rungs = schema["enums"]["verification_rung"]
    if rung not in rungs:
        # V0 is left out of the list on purpose: it is in the enum because a
        # linter must be able to name it, and offering it here would advertise
        # a value the next line refuses.
        raise Refused(f"rung {rung!r} is not one of "
                      f"{'/'.join(r for r in rungs if r != 'V0')}")
    if rung == "V0":
        raise Refused(
            "V0 is 'asserted' — it is the name for what is being refused, "
            "never a rung a row may carry")
    return rung


def check_priority(priority: str) -> str:
    """One validator, because there were two and only one of them ran.

    `cmd_add` refused an unknown priority; `cmd_route` passed `args.priority`
    straight into `PRIORITY_RE[...]`, so `route --priority "P2 (低优先 carry)"`
    — a real project's full heading, which is exactly what someone reading
    that board would type — raised `KeyError` instead of refusing. A traceback
    where a refusal belongs, for the third time in this file.

    The value is a key, so validating it in one place and indexing with it in
    another is the shape that guarantees a mismatch eventually.
    """
    if priority and priority not in ("P0", "P1", "P2"):
        raise Refused(f"priority {priority!r} is not one of P0/P1/P2. A board "
                      f"section whose heading carries more than that — "
                      f"`## P2 (低优先 carry)` — is still `--priority P2`; "
                      f"pass the whole heading to `--group` instead")
    return priority


def heading_matches(line: str, name: str) -> bool:
    """Does this line open the `## ` section called `name`?

    **The one predicate**, shared with `viewer/parsers.py § heading_is` via
    `squash`. There were three answers to this question and they disagreed in
    one call: on `## **Top risks**` the reader found no section, this locator
    found none either — so `risk-add` appended a **second** `## Top risks` at
    exit 0 — and the id minter, reading rows by a third rule, saw the existing
    risks and minted the next id. Every risk already recorded became invisible
    to every tool, and `perry-lint` said nothing.

    `squash` strips `*`, backticks and whitespace runs and leaves internal
    spaces alone, so prefix matching still lets `## P2 (低优先 carry)` and
    `## Top risks (one-line; full list in …)` resolve — which is what the
    `(?!\w)` in the regex this replaced was protecting. That guard is kept as
    the boundary check below: a heading may be followed by a non-word
    character, never by more of a word, or `## P2` would match `## P20`.
    """
    if not line.startswith("## "):
        return False
    head = squash(line[3:])
    for spelling in heading_spellings(name):
        want = squash(spelling)
        if head.startswith(want) and not head[len(want):len(want) + 1].isalnum():
            return True
    return False


# There was a `heading_re` here, "kept for callers that need a pattern object".
# It had none — in `bin/`, `tests/` or `viewer/` — and it is deleted rather than
# shared, because the `heading_re` in `bin/perry-lint` is NOT a second copy of
# it. That one matches heading TEXT (`^High-stakes operations`), because
# `section_body` hands it a heading with the `##` already stripped; this one
# matched the raw line (`^##\s+\**\s*…(?!\w)`). Two functions, one name, one of
# them dead. Live callers use `heading_matches`.

REQUIRED_KEYS = ("id", "title", "owner", "status", "next action", "evidence")


def check_header(header: list[str]) -> None:
    """Refuse to write against a header whose columns we cannot place.

    Without this the failure is a row of blank cells and exit 0 — the tool
    reporting success while writing nothing the row means. A refusal names the
    header it could not read; a blank row names nothing.
    """
    keys = {norm(h) for h in header}
    missing = [k for k in REQUIRED_KEYS if k not in keys]
    if missing:
        raise Refused(
            f"BOARD.md's columns cannot be resolved: no header matches "
            f"{missing}. Found {header}. Column headers may be written in the "
            f"document language, but only spellings listed in "
            f"`schema/state-schema.json § i18n.columns` are recognized — "
            f"nothing was written")


def widening_columns(header: list[str], values: dict) -> list[str]:
    """Every column this row needs that the section may be widened to carry.

    A project's own section can be NARROWER than the six required columns — one
    real board files work under `| ID | Title | Owner | Status |` — and writing
    only what fits drops `Next action` and `Evidence` silently. So the required
    six are added, not just the mode extras.

    **A header whose IDENTITY columns cannot be resolved is refused instead.**
    That is not a narrow table, it is an unknown one: appending `ID` and `Title`
    beside `甲` and `乙` produces a row whose first two cells are blank and an
    exit code of 0, which is `check_header`'s own reason for existing wearing a
    disguise. Narrow means "this project wrote fewer columns"; unreadable means
    "we do not know what these columns are", and only the first can be fixed by
    adding more.
    """
    if not {"id", "title"} <= {norm(h) for h in header}:
        check_header(header)
    return [canonical_column(k) for k in REQUIRED_KEYS] + columns_for(values)


# ── ids ───────────────────────────────────────────────────────────────────


ID_RE = re.compile(r"\bTASK-(\d+)\b")

#: The default family, and the one every project that has never said otherwise
#: gets. Not special beyond being the default.
DEFAULT_PREFIX = "TASK"

#: A prefix is one or more `-`-joined segments, each starting with a LETTER.
#: `AIM`, `ARCH-V2` and `RW` pass; `TASK-001` does not, because `001` starts
#: with a digit — which is exactly the rule that keeps a whole id from being
#: mistaken for a prefix.
PREFIX_RE = re.compile(r"^[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z][A-Za-z0-9]*)*$")

#: Prefixes this file mints for OTHER registers. A task minted as `RX-005`
#: would collide with the risk register's own numbering, and both writers would
#: then be right about their own file and wrong about the project.
RESERVED_PREFIXES = {"USER", "RX", "CAD", "CADENCE"}

#: An id cell → `(prefix, number-or-None)`. The contract says an id is opaque
#: and that some carry no number at all, so the number half is optional.
_ID_SHAPE = re.compile(r"^(?P<prefix>.+?)-(?P<tail>[^-]*)$")


def task_id_prefixes(records: list[dict]) -> dict[str, int]:
    """`{prefix: numbered ids}` from the canonical task store."""
    counts: dict[str, int] = {}
    for record in records:
        raw = str(record.get("id") or "").strip()
        m = _ID_SHAPE.match(raw)
        if not m or not PREFIX_RE.match(m.group("prefix")):
            continue
        p = m.group("prefix")
        counts[p] = counts.get(p, 0) + (1 if m.group("tail").isdigit() else 0)
    return counts


def resolve_prefix(records: list[dict], requested: str | None) -> str:
    """Which family a NEW id is minted into (TASK-060).

    On a board whose 17 rows are `AIM-001`…`AIM-017`, `add` minted `TASK-001`.
    Legitimate — the contract says ids are opaque and a board may carry several
    project-declared prefixes — but a user creating a task from a front-end
    watched their board sprout a second id family, and there was no flag with
    which to ask for the first. aiMark passes no id and *cannot*: nothing in
    the surface would let it.

    **The rule, and why it is not "adopt the most common prefix".**

    1. `--prefix` wins. It is the answer for every case, and it is the only
       answer for a board that carries several families or wants a new one.
    2. Otherwise, adopt the board's prefix **only when the board has exactly
       one**. Then there is nothing to guess: it is the only family the board
       has ever used.
    3. Otherwise `TASK`, unchanged.

    Rule 2 stops at one on purpose. `~/proj/gimegime-pmo` carries **36**
    families across its task tables, a dozen of them declared in its own
    `## ID prefixes (canonical)` section, and they are not stylistic:
    `IPS-*` / `ALLOC-*` / `DUE-*` mean 投资线 and `TECH-*` /
    `DATA-*` mean 工程线, filed in physically separate sections for a reason
    the board states. A plurality winner there mints an id that ASSERTS the row
    belongs to a workstream nobody chose — and an id is permanent and never
    reissued, so that assertion cannot be taken back. A foreign-looking
    `TASK-001` on such a board is visibly Perry's and obviously not a claim
    about the work; a wrong-family `IPS-014` is a claim, and a false one.
    Guessing is only safe where there is exactly one thing to guess.
    """
    if requested:
        p = requested.strip().rstrip("-")
        if not PREFIX_RE.match(p):
            raise Refused(
                f"--prefix {requested!r} is not an id prefix. Segments are "
                f"joined by `-` and each starts with a letter (`AIM`, "
                f"`ARCH-V2`); the number is appended by Perry, so pass "
                f"`AIM`, not `AIM-018`")
        if p.upper() in RESERVED_PREFIXES:
            raise Refused(
                f"--prefix {p!r} is the family `perry-task` mints for another "
                f"register on this same board ({sorted(RESERVED_PREFIXES)}). "
                f"A task numbered in it would collide with rows the tool "
                f"writes itself")
        return p
    families = task_id_prefixes(records)
    if len(families) == 1:
        only, numbered = next(iter(families.items()))
        # A family with no numbered id has nothing to count from, so minting
        # into it would start at 001 beside ids that are not numbers — Perry
        # would be inventing a numbering the project did not choose.
        if numbered and only.upper() not in RESERVED_PREFIXES:
            return only
    return DEFAULT_PREFIX


def mint_id(records: list[dict], prefix: str | None = None) -> str:
    """Next id from the canonical task store, within one prefix."""
    pat = re.compile(rf"\b{re.escape(prefix or DEFAULT_PREFIX)}-(\d+)\b")
    seen = {int(m) for r in records for m in pat.findall(str(r.get("id") or ""))}
    return f"{prefix or DEFAULT_PREFIX}-{max(seen, default=0) + 1:03d}"


def minting_records(ctx) -> list[dict]:
    """The store, plus the ids `purge` took out of it. **What a new id may not be.**

    **TASK-167, and the reason `purge` is not just a `del`.** Since ADR-007
    `mint_id` counts the canonical store and nothing else — the module
    docstring above still says *"max(board ∪ journal ∪ events)"* and has been
    wrong about that since the store became canonical. That is correct while
    nothing can leave the store, and `purge` is the first thing that can: with
    the record gone, the next `add` mints the number again.

    **A reissued id is not a cosmetic collision.** `.perry/events.jsonl` is
    append-only and still carries the purged row's `add`, `drop` and `purge`,
    so a new row wearing that number inherits the dead row's `timeline[]` — and
    inherits its `purge`, which `_cmd_list_from_board` honours by deleting the
    row. A rebuild would erase the live task. Measured before this existed: the
    first `add` after purging `TASK-001` was handed `TASK-001`.

    So a purged number is retired, not freed. The record is reconstructible
    from the log; the id is not reusable, which is the property that makes
    removal safe to do to a store other registers resolve ids against.

    Both minting call sites read this — `add` and `route`, which is the second
    of them and the one that gets missed.
    """
    return list(ctx["task_records"]) + [
        {"id": e.get("id") or ""} for e in ctx["events"]
        if e.get("event") == "purge" and e.get("id")]


# ── events ────────────────────────────────────────────────────────────────


def events_path(project_root: Path) -> Path:
    return project_root / ".perry" / "events.jsonl"


def read_events(project_root: Path) -> list[dict]:
    p = events_path(project_root)
    if not p.exists():
        return []
    out = []
    for line in p.read_text(errors="replace").split("\n"):
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue  # a corrupt line is not a reason to refuse a write
    return out


# ── the store, and what a write puts in it ────────────────────────────────


class _Ops:
    """The two rules `bin/perry_store.py` resolves a board through.

    It needs `norm` and `strip_handle` and must not import this file back, so
    it takes them as one object rather than two callables — the same route
    `bin/perry-migrate` takes to the one header rule as `L.norm`, and pinned by
    `tests/test_one_header_rule.py` for the same reason: a renderer that
    resolved `| 状态 |` by its own rule would be the fifth live copy.

    A class rather than `sys.modules[__name__]`, which is how this was first
    written and which is `None` here half the time: `bin/perry-tasks` loads
    this file with `module_from_spec` + `exec_module`, and that pair does NOT
    register the module in `sys.modules`. Every call through that loader raised
    `KeyError`.
    """

    norm = staticmethod(norm)
    strip_handle = staticmethod(strip_handle)


def _ops():
    return _Ops


def load_task_records(state_root: Path) -> list[dict]:
    """Load the canonical task store or raise one structured refusal."""
    path = perry_store.store_path(state_root)
    if not path.exists():
        return []
    try:
        records = perry_store.load_store(state_root)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        raise Refused(
            f"{path} cannot be read as JSONL ({type(exc).__name__}: {exc}). "
            "The task store is canonical; repair or restore it before retrying."
        ) from None
    valid, findings = perry_store.validate_records(records)
    if findings:
        first = findings[0]
        raise Refused(
            f"{path} is malformed at line {first.get('line', '?')} "
            f"({first.get('message', 'invalid task record')}). The board is a "
            "projection and will not be used as recovery."
        )
    return valid


def hydrate_task_projection(board: Board, records: list[dict]) -> dict:
    """Replace task cell values in memory from the store; keep layout verbatim."""
    text, report = perry_store.render(board, records, _ops())
    board.lines = text.split("\n")
    board.hydration_report = report
    return report


def task_record(ctx, task_id: str) -> dict:
    """Resolve a task identity from the store, never from the projection."""
    record = ctx["tasks_by_id"].get(task_id)
    if record is None:
        board = ctx.get("board")
        section = board._non_task_row(task_id) if board is not None else None
        if section:
            raise Refused(NON_TASK_REFUSAL[section].format(id=task_id))
        raise Refused(
            f"{task_id} is not a task in {perry_store.store_path(ctx['state_root'])} "
            "and is not a row on the board")
    return record


_STORE_TO_BOARD = {
    "id": "id", "title": "title", "owner": "owner", "status": "status",
    "track": "track", "stage": "stage", "stage_since": "stage since",
    "arrived": "arrived", "parent": "parent", "commitment": "commitment",
    "next_action": "next action", "evidence": "evidence",
    "verification": "verification", "role": "role", "depends_on": "depends on",
}


def task_projection_row(ctx, task_id: str):
    """Locate projection layout, then fill every Task cell from the store."""
    record = task_record(ctx, task_id)
    section, index, header, cells = ctx["board"].find(task_id)
    values = dict(zip([norm(h) for h in header], cells))
    for field, column in _STORE_TO_BOARD.items():
        value = record.get(field)
        if field == "depends_on":
            value = ", ".join(value or []) or "—"
        values[column] = "" if value is None else str(value)
    return section, index, header, values


def store_records(project_root: Path, state_root: Path, board: Board,
                  events: list[dict], preserve_terminal: bool = False
                  ) -> tuple[list[dict], dict]:
    """(the store's records, `list`'s conformance) for the board AS IT STANDS.

    **The one derivation there is.** `bin/perry-tasks § build` calls this too,
    and the reason is the reason this file exists: `viewer/parsers.py` and this
    module were two parsers of one board and disagreed silently, and a writer
    that computed a record its own way would be that bug with the arrow
    reversed — the store written by `add` would differ from the store
    `perry-tasks verify` derives, and `diff` would go red on a project rather
    than in a test.

    The board handed in is the one in memory, mutated by the subcommand that is
    mid-write; `events` is the log plus the event this write is about to
    append. Both matter and for different rows: `done` REMOVES the row, so a
    closed task's record comes off the event stream and the record would carry
    yesterday's status if the new event were not in the list yet.

    `sections: False` turns off `## Top risks`, `## User Input Queue` and drift
    reconciliation. They are not stored fields, they cost a second parse of the
    board — **off disk, which mid-write is the version being replaced** — and
    the payload they would land in is discarded two lines below.
    """
    board.refuse_duplicate_task_ids()
    ctx = {"schema": load_schema(), "project_root": project_root,
           "state_root": state_root, "config": {"tracks": []},
           "board": board, "events": events, "sections": False}
    payload = _cmd_list_from_board(
        parse(["list", "--all", "--root", str(project_root)]), ctx)
    order = perry_store.board_order(board, _ops())
    records = [perry_store.record(t, order.get(t["id"]))
               for t in payload["tasks"]]
    # `summary` deliberately has no Board column. Preserve it only from the
    # canonical store; deriving it from title, actions, evidence or journal
    # prose would violate ADR-009. This also makes migration and store rebuilds
    # carry the non-projected value without teaching each caller a second rule.
    try:
        current = perry_store.load_store(state_root)
        current, current_findings = perry_store.validate_records(current)
    except (OSError, ValueError):
        current, current_findings = [], [{"message": "unreadable store"}]
    if not current_findings:
        summaries = {r["id"]: r.get("summary") or "" for r in current}
        for rec in records:
            rec["summary"] = summaries.get(rec["id"], "")
    if preserve_terminal:
        # The event log is derived and disposable. If it is deleted, completed
        # rows are no longer derivable from the open-only board, but they remain
        # canonical store records and must not disappear on the next write.
        # A same-id record is always replaced by the freshly derived state.
        known = {r["id"] for r in records}
        valid, findings = current, current_findings
        if not findings:
            current_by_id = {r["id"]: r for r in valid}
            for rec in records:
                old = current_by_id.get(rec["id"])
                if old and rec.get("created") is None:
                    rec["created"] = old.get("created")
            records.extend(r for r in valid
                           if r["id"] not in known
                           and r.get("status") in ("done", "dropped"))
    return records, payload["conformance"]


def refuse_store_drift(project_root: Path, state_root: Path, board: Board,
                       events: list[dict]) -> None:
    """Until TASK-090, never overwrite an independent valid store edit.

    The command still derives its proposed record from the board in this slice.
    Comparing that baseline before the subcommand runs prevents an unrelated
    write from silently resolving drift in the obsolete board-to-store
    direction.
    """
    path = perry_store.store_path(state_root)
    if not path.exists():
        return
    try:
        records = perry_store.load_store(state_root)
    except (OSError, ValueError) as exc:
        raise Refused(f"{path} cannot be read as JSONL ({type(exc).__name__}: "
                      f"{exc}). Refusing to overwrite the canonical store; "
                      f"repair it or restore it before retrying.") from None
    good, findings = perry_store.validate_records(records)
    if findings:
        raise Refused(f"{path} is malformed ({findings[0]['message']}). "
                      f"Refusing to overwrite the canonical store.")
    baseline, _ = store_records(project_root, state_root, board, events,
                                preserve_terminal=True)
    stored_by_id = {r["id"]: r for r in good}
    baseline_by_id = {r["id"]: r for r in baseline}
    comparable = perry_store.STORED
    differs = any(
        stored_by_id.get(tid) is None or
        any(stored_by_id[tid].get(field) != rec.get(field)
            for field in comparable)
        for tid, rec in baseline_by_id.items())
    differs = differs or any(
        tid not in baseline_by_id and rec.get("status") not in ("done", "dropped")
        for tid, rec in stored_by_id.items())
    if differs:
        raise Refused(
            f"{path} differs from the records derived from BOARD.md. Until "
            f"TASK-090 the writer still reads the board to construct a write, "
            f"so proceeding would discard a valid store edit. Run `perry-tasks "
            f"render --write` to render the authoritative store to BOARD.md, "
            f"then retry. `perry-tasks write --from-board` is the explicit "
            f"destructive board-to-store direction.")


def parsed_status(cell: str, statuses) -> str:
    """A `Status` cell → the enum value in it, or `""` when there is none.

    The board-to-store migration uses this one rule. Normal reads never call
    it: typed status already lives in ``tasks.jsonl``.

    `**done**` is `done` wearing bold — formatting is not meaning, and a
    consumer that trusts the enum renders a finished task as an unrecognized
    state (17 of 41 rows on one real board). What survives stripping and is
    still not in the enum has no value in it at all.
    """
    st = (cell or "").strip().strip("*_`").strip()
    return st if st in statuses else ""


def unstorable_status_rows(conformance: dict) -> list[dict]:
    """Every row whose `Status` the store cannot hold, for the write's payload.

    Counted on every write that proceeds rather than discovered at TASK-090,
    when the board reader those bytes survive in goes away. A fallback nobody
    counts is how a renderer passes `cmp` while reproducing nothing, and the
    same is true of a cell nobody resolves.
    """
    return list(conformance.get("off_enum_status") or [])


# ── the recoverable canonical transaction ─────────────────────────────────


TRANSACTION_FILE = ".perry-task-transaction.json"


def _transaction_path(state_root: Path) -> Path:
    return state_root / TRANSACTION_FILE


def _digest(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def _safe_transaction_entry(state_root: Path, entry: dict) -> tuple[Path, Path]:
    target = (state_root / entry["target"]).resolve()
    tmp = (state_root / entry["tmp"]).resolve()
    root = state_root.resolve()
    if root not in target.parents or root not in tmp.parents \
            or tmp.parent != target.parent or tmp.suffix != ".t" + "mp":
        raise Refused(f"invalid recovery marker at {_transaction_path(state_root)}; "
                      f"refusing to touch paths outside the transaction")
    return target, tmp


def _remove_transaction(state_root: Path, payload: dict) -> None:
    for entry in payload.get("entries", []):
        _target, tmp = _safe_transaction_entry(state_root, entry)
        try:
            tmp.unlink()
        except FileNotFoundError:
            pass
    marker = _transaction_path(state_root)
    try:
        marker.unlink()
    except FileNotFoundError:
        pass
    lib.sync_directory(state_root)


def recover_transaction(state_root: Path) -> str | None:
    """Finish or roll back the canonical pair described by a durable marker."""
    marker = _transaction_path(state_root)
    if not marker.exists():
        return None
    try:
        payload = json.loads(marker.read_text(encoding="utf-8"))
        entries = payload["entries"]
        if payload.get("version") != 1 or not isinstance(entries, list):
            raise ValueError("unsupported marker shape")
    except (OSError, ValueError, KeyError, TypeError) as exc:
        raise Refused(f"cannot recover the pending task transaction at {marker} "
                      f"({type(exc).__name__}: {exc}). Nothing else was written; "
                      f"repair or remove the marker only after inspecting it.") from None

    phase = payload.get("phase", "commit")
    try:
        if phase == "rollback":
            for entry in entries:
                target, _tmp = _safe_transaction_entry(state_root, entry)
                old = entry.get("old")
                if old is None:
                    if target.exists() and _digest(target.read_text(encoding="utf-8")) \
                            == entry["new_sha256"]:
                        target.unlink()
                else:
                    current = (_digest(target.read_text(encoding="utf-8"))
                               if target.exists() else None)
                    if current != _digest(old):
                        lib.write_atomic(target, old)
                lib.sync_directory(target.parent)
            outcome = "rolled back"
        else:
            for entry in entries:
                target, tmp = _safe_transaction_entry(state_root, entry)
                current = (_digest(target.read_text(encoding="utf-8"))
                           if target.exists() else None)
                if current == entry["new_sha256"]:
                    continue
                if not tmp.exists():
                    raise OSError(f"staged replacement is missing for {target}")
                os.replace(tmp, target)
                lib.sync_directory(target.parent)
            outcome = "completed"
        _remove_transaction(state_root, payload)
        return outcome
    except (OSError, ValueError, KeyError, TypeError) as exc:
        raise Refused(f"the pending task transaction at {marker} could not be "
                      f"{phase}ed ({type(exc).__name__}: {exc}). The marker and "
                      f"its staged files were retained; fix the path and retry "
                      f"any Perry command to recover deterministically.") from None


def replace_canonical_pair(state_root: Path,
                           changes: list[tuple[Path, str]]) -> None:
    """Replace store+journal with rollback on failure and crash recovery."""
    marker = _transaction_path(state_root)
    if marker.exists():
        recover_transaction(state_root)
    staged: list[tuple[Path, Path]] = []
    payload = {"version": 1, "phase": "commit", "entries": []}
    try:
        for target, text in changes:
            old = target.read_text(encoding="utf-8") if target.exists() else None
            tmp = Path(lib.stage(target, text))
            staged.append((target, tmp))
            payload["entries"].append({
                "target": target.relative_to(state_root).as_posix(),
                "tmp": tmp.relative_to(state_root).as_posix(),
                "old": old, "new_sha256": _digest(text),
            })
        lib.write_atomic(marker, json.dumps(payload, ensure_ascii=False))
        lib.sync_directory(state_root)
    except OSError as exc:
        for _target, tmp in staged:
            try:
                tmp.unlink()
            except OSError:
                pass
        raise Refused(f"the store and journal could not be staged ({exc}). "
                      f"Nothing was written and staged files were cleaned.") from None

    try:
        for target, tmp in staged:
            os.replace(tmp, target)
            lib.sync_directory(target.parent)
        _remove_transaction(state_root, payload)
    except OSError as exc:
        # A normal failure returns the old pair. If rollback itself is blocked,
        # the marker remains and the next command resumes it under the lock.
        payload["phase"] = "rollback"
        try:
            lib.write_atomic(marker, json.dumps(payload, ensure_ascii=False))
            recover_transaction(state_root)
        except (OSError, Refused) as recovery:
            raise Refused(f"the canonical replacement failed ({exc}); recovery "
                          f"is pending at {marker} ({recovery}). Retry any Perry "
                          f"command after fixing the path; no raw traceback is "
                          f"required to recover.") from None
        raise Refused(f"the canonical replacement failed ({exc}). The store and "
                      f"journal were rolled back; nothing was written.") from None


def commit(project_root: Path, state_root: Path, board: Board,
           journal_line: str, event: dict, dry_run: bool,
           definition: str = "", signoff_block: str = "",
           off_board: bool = False, removed_id: str = "") -> dict:
    """Write the store and the journal together, render the board, log the event.

    **The three-way write is `store + journal + event` now, not `board +
    journal + event`** (TASK-089, ADR-007). `perry/tasks.jsonl` is what a field
    means; `BOARD.md` is a projection of it, re-rendered here from the record
    this write just produced. The subcommand still mutates the in-memory
    `Board` and that mutation is still load-bearing — it is the LAYOUT, the
    thing the store does not hold: where a section sits, what a cell is padded
    with, what decoration it wears. The VALUES come back out of the store, so a
    store and a board that disagree render as the store, which is what makes
    the projection falsifiable rather than a copy.

    **The guarantee, stated exactly.** Two renames cannot be one atomic
    filesystem operation. Both post-images and both pre-images are recorded in
    a durable marker before either rename. A caught failure rolls back; a crash
    is completed on the next run under the project lock. The marker is removed
    only after the pair reaches one deterministic state. `BOARD.md` and the
    event are written afterwards and may independently be stale or missing.

    That direction of failure is chosen, not tolerated. DESIGN-004 declares the
    event log derived and disposable, and a missing event is exactly the
    `unrecorded` condition drift reconciliation reports; ADR-007 decision 2
    declares `BOARD.md` rendered output, and a stale one is exactly the
    `store-drift` condition `perry-lint` reports. Losing either costs a
    projection that one command regenerates. Losing the store costs the truth.
    """
    # **Derived before anything is written, and before `--dry-run` returns**,
    # so a dry run previews the projection the real write would produce rather
    # than a cheaper approximation of it. The refusal that belongs to this
    # decision is `refuse_unstorable_status`, taken in `main()` against the
    # board as it stood: see that function for why it cannot live here.
    derived, conformance = store_records(
        project_root, state_root, board, read_events(project_root) + [event])
    current = load_task_records(state_root)
    current_by_id = {record["id"]: dict(record) for record in current}
    derived_by_id = {record["id"]: record for record in derived}
    subject = event.get("id") or ""

    # One command mutates at most one Task. Every other task crosses the write
    # from the store byte-for-field; otherwise an unrelated Board edit would
    # become truth merely because another row changed. Section-only commands
    # mutate no task at all.
    if removed_id:
        # **`purge`, and the only write that makes the store smaller.** It goes
        # through this function rather than beside it so the removal gets the
        # same guarantee every other write gets: store and journal replaced as
        # one recoverable transaction, board re-rendered after, event appended
        # last. A deletion written with `open(...,'w')` next door would be the
        # one mutation in this file that a crash could leave half-applied.
        #
        # Nothing else in the branch below applies. There is no projected row
        # to read the new values out of — the record is terminal and the board
        # has not carried a line for it since it closed — and there is no
        # `changed` whitelist, because no field is being written.
        #
        # `order` is deliberately NOT renumbered; see `cmd_purge`.
        records = [dict(record) for record in current
                   if record["id"] != removed_id]
    elif event.get("event") in TASK_EVENTS and subject:
        projected = derived_by_id.get(subject)
        old = current_by_id.get(subject)
        event_name = event.get("event")
        if projected is None and event_name == "summary" and old is not None:
            # A terminal Task remains editable even if its disposable event log
            # is gone and therefore cannot reconstruct a Board row.
            projected = dict(old)
        if off_board and event_name == "retitle" and old is not None:
            # **TASK-166.** The subject has no Board line to mutate, so the
            # projection cannot be the source of the new value the way it is
            # for every other write: `store_records` would rebuild this row off
            # the EVENT STREAM, and the field being repaired is precisely the
            # one an event predating the `title` key does not carry — so the
            # derivation returns the empty title that is the defect and the
            # write silently becomes a no-op.
            #
            # The value therefore comes from the event, exactly as `summary`'s
            # does, and for the same reason: a field the projection cannot hold
            # cannot be read back out of it. `changed` below is still what
            # bounds this to one cell — reaching the row and rewriting it are
            # separate permissions, and only `title` has both.
            projected = dict(old)
            projected["title"] = event.get("to") or ""
        if projected is None:
            raise Refused(
                f"{subject} could not be rendered into the task projection. "
                "Nothing was written; repair the projection layout or run "
                "`perry-tasks render --write` before retrying.")
        if old is None:
            target = dict(projected)
            if event_name == "add":
                target["summary"] = event.get("summary") or ""
        else:
            target = dict(old)
            changed = {
                "start": ("status", "next_action"),
                "stage": ("stage", "stage_since"),
                # Four fields, because a track move re-stamps the destination's
                # clock in the same write. Listing only `track` would land the
                # new track in the store and leave yesterday's `Stage` and
                # `Arrived` beside it — the store and the board would then
                # disagree, and the board is rendered FROM the store, so the
                # move would appear to half-revert on the next render.
                "track": ("track", "stage", "stage_since", "arrived"),
                "status": ("status", "next_action", "depends_on"),
                "depends": ("depends_on",),
                "next": ("next_action",),
                "retitle": ("title",),
                "summary": ("summary",),
                "rung": ("verification",),
                "evidence": ("evidence",),
                "done": ("status", "evidence", "verification"),
                "drop": ("status",),
                "prioritize": ("priority", "group"),
            }.get(event_name, ())
            for field in changed:
                target[field] = (event.get("to") or "" if field == "summary"
                                 else projected.get(field))

        # Summary is store-only metadata. Updating it must not turn one
        # field edit into a whole-store reorder by moving the record to the
        # final JSONL line. An off-board repair is the same case for the same
        # reason and one more: the record it edits is FINISHED, and its
        # position in the store is the order the work actually happened in.
        # Rewriting a name is not a reason to move history.
        in_place = old is not None and (event_name == "summary" or off_board)
        if in_place:
            records = [target if record["id"] == subject else dict(record)
                       for record in current]
        else:
            records = [dict(record) for record in current
                       if record["id"] != subject]
        if old is not None and event_name in {"done", "drop", "prioritize"}:
            old_group, old_order = old.get("group"), old.get("order")
            if old_order is not None:
                for record in records:
                    if (record.get("group") == old_group
                            and record.get("order") is not None
                            and record["order"] > old_order):
                        record["order"] -= 1
        if event_name in {"done", "drop"}:
            target["order"] = None
        elif event_name in {"add", "route", "prioritize"}:
            peers = [record.get("order") for record in records
                     if record.get("group") == target.get("group")
                     and record.get("order") is not None]
            target["order"] = max(peers, default=-1) + 1
        if not in_place:
            records.append(target)
    else:
        records = [dict(record) for record in current]
    unstorable = unstorable_status_rows(conformance)
    board_text, projection = perry_store.render(board, records, _ops())

    spath = perry_store.store_path(state_root)
    jpath = state_root / "journal" / f"{date.today():%Y-%m}" / f"{date.today():%Y-%m-%d}.md"
    hydration = getattr(board, "hydration_report", {})
    plan = {
        "store": str(spath),
        "records": len(records),
        "board": str(board.path),
        "journal": str(jpath),
        "events": str(events_path(project_root)),
        "journal_line": journal_line,
        "event": event,
        # What the projection could NOT fill from the store, carried in the
        # payload rather than left to a separate `perry-tasks diff` run. A
        # renderer's escape hatches are only honest while somebody counts them.
        "projection": {
            **{k: projection[k] for k in
               ("rows_from_store", "rows_verbatim", "rows_not_on_board",
                "cells_verbatim", "cells_wearing_decoration",
                "sections_out_of_stored_order",
                "cells_the_store_and_board_disagree_on")},
            # Not the same list as `cells_verbatim`, and both belong here. That
            # counts every cell the LAYOUT had to keep — including columns the
            # store has no field for at all (`By when`, `Notes`), which is
            # ordinary. This names the rows whose `Status` the store cannot
            # hold, which is not: each one is a row no `perry-task` command may
            # move until a human resolves it.
            "status_cells_the_store_cannot_hold": unstorable,
        },
    }
    for key in ("rows_verbatim", "rows_not_on_board",
                "sections_out_of_stored_order",
                "cells_the_store_and_board_disagree_on"):
        earlier = hydration.get(key) or []
        if earlier:
            plan["projection"][key] = earlier + plan["projection"][key]
    if dry_run:
        return plan

    jtext = ""
    try:
        if jpath.exists():
            jtext = jpath.read_text()
        elif not jpath.parent.exists():
            jpath.parent.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        raise Refused(f"the journal could not be prepared ({exc}). Nothing was "
                      f"written.") from None
    jtext = append_status_change(jtext, journal_line)
    if definition:
        # The task's full definition, written at creation. It used to be the
        # agent's job — `add-task` step 2 said "the tool writes the one-line
        # status change; this block is the rich record and is still written by
        # hand" — and the hand never wrote it. Measured the day this landed:
        # `## New tasks added` appeared 3 times in the journal of the day
        # BEFORE the tool existed and 0 times after, so every tool-created task
        # was one title and nothing else.
        jtext = append_block(jtext, "New tasks added", definition)
    if signoff_block:
        # The signature, in the canonical half of the write rather than beside
        # it. A V5 close whose journal line says "signed off" and whose record
        # of WHAT was signed lives only in the disposable event log would be
        # the same defect in a new place: the rung's entire content is what was
        # checked, so it belongs where the transaction guarantees reach.
        jtext = append_block(jtext, "V5 sign-off", signoff_block)

    replace_canonical_pair(
        state_root,
        [(spath, perry_store.store_text(records)), (jpath, jtext)])

    # `BOARD.md`, re-rendered from what was just stored. Outside the pair for
    # the same reason the event log is: it is derived, one command regenerates
    # it, and `perry-lint § store-drift` is the finding that says it is stale.
    # Writing it first would be worse — a board ahead of the store is a claim
    # nothing backs.
    plan["board_rendered"] = True
    try:
        lib.write_atomic(board.path, board_text)
    except OSError as exc:
        plan["board_rendered"] = False
        print(f"perry-task: warning — {spath.name} and the journal were "
              f"written, but {board.path.name} could not be re-rendered "
              f"({exc}). The state is correct and `perry-tasks render --write` "
              f"regenerates the file; `perry-lint` reports it as `store-drift` "
              f"until then.", file=sys.stderr)

    plan["event_written"] = True
    ev = events_path(project_root)
    try:
        ev.parent.mkdir(parents=True, exist_ok=True)
        with open(ev, "a") as fh:
            fh.write(json.dumps(event, ensure_ascii=False) + "\n")
    except OSError as exc:
        # The canonical write already landed and is correct. Report the loss
        # instead of crashing: a traceback here would suggest the whole call
        # failed, and the caller would be right to retry it — producing a
        # second row for work already recorded.
        plan["event_written"] = False
        print(f"perry-task: warning — {spath.name} and the journal were "
              f"written, but the event could not be appended to {ev}: {exc}. "
              f"State is correct; this row will show as `unrecorded` at the "
              f"next standup until the log is writable again.", file=sys.stderr)
    return plan


def append_block(text: str, heading: str, block: str) -> str:
    """Append a multi-line block under the LAST `## <heading>` of the day.

    Same walk as `append_status_change` and for the same reason — a day's
    journal accumulates several of each heading, and appending to the first
    buries this afternoon's entry inside this morning's.
    """
    if not text.strip():
        text = f"# {date.today():%Y-%m-%d}\n"
    lines = text.split("\n")
    starts = [i for i, l in enumerate(lines) if l.strip() == f"## {heading}"]
    if not starts:
        return text.rstrip("\n") + f"\n\n## {heading}\n\n" + block.rstrip("\n") + "\n"
    start = starts[-1]
    i = start + 1
    end = start
    while i < len(lines):
        s = lines[i].strip()
        if s.startswith("## "):
            break
        if s:
            end = i
        i += 1
    lines[end + 1:end + 1] = ["", block.rstrip("\n")]
    return "\n".join(lines)


def append_status_change(text: str, line: str) -> str:
    """Append under the LAST `## Status changes` of the day, creating it if none.

    The last, not the first. A day's journal accumulates one `## Status changes`
    per entry — this session's had seventeen — and appending to the first buries
    a change that happened at 18:33 inside the block written at 09:00. The file
    stays chronological only if new lines land at the end of it, which is the
    whole point of an append-only record.
    """
    if not text.strip():
        text = f"# {date.today():%Y-%m-%d}\n"
    lines = text.split("\n")
    starts = [i for i, l in enumerate(lines) if l.strip() == "## Status changes"]
    if not starts:
        return text.rstrip("\n") + "\n\n## Status changes\n\n" + line + "\n"

    start = starts[-1]
    # Walk to the end of that section's list: past its blank line, over its
    # bullets and table rows, stopping at the next heading or at prose.
    i = start + 1
    last_item = start
    while i < len(lines):
        s = lines[i].strip()
        if s.startswith("#"):
            break
        if s.startswith("- ") or s.startswith("|"):
            last_item = i
        elif s:
            break
        i += 1
    lines.insert(last_item + 1, line)
    return "\n".join(lines)


# ── subcommands ───────────────────────────────────────────────────────────


def stages_of(schema: dict, track: dict) -> list[str]:
    """The track's declared stage vocabulary, else its mode's default.

    Consumes `parse_tracks`'s computed `stage_list` rather than re-splitting
    `stages`. Both readings existed and nothing asserted they agreed — the
    register was parsed once into a list and then parsed again here from the
    raw cell, which is the same "one rule, two implementations" shape that put
    the `->` / `→` separator bug in circulation to begin with.
    """
    declared = track.get("stage_list")
    if declared is None:
        declared = split_stages(track.get("stages", ""))
    return list(declared) or default_stages(schema, track["mode"])


def entry_stage(mode: str, stages: list[str]) -> str:
    """The stage a row is born in.

    A QUEUE row skips `stages[0]`, because that stage means "sitting in
    intake" and the row has either just left intake (`route`) or never was
    there (`add`). A pipeline or inquiry row has no such stage to skip and must
    enter at the first one — routing those to `stages[1]` silently skipped
    `brief` / `open`.

    One function because it was two: `cmd_add` and `cmd_route` each carried the
    expression, both written in the same round. The rule is per-mode and it is
    the moment a row's clock starts, so a future mode that enters somewhere
    else has exactly one place to say so.
    """
    if mode == "queue" and len(stages) > 1:
        return stages[1]
    return stages[0] if stages else ""


def check_stage(track: dict, stages: list[str], stage: str) -> None:
    """Refuse a stage outside the track's vocabulary — on creation as on moves.

    `stage` enforced this from the day it shipped. `add` and `route` took
    `--stage` verbatim, so `--stage bogus` wrote a cell no reader can classify
    and exited 0: the vocabulary was checked when a row *moved* and not when it
    was *born*, which is the one moment the cell has no prior value to fall
    back to.
    """
    if stage and stages and stage not in stages:
        raise Refused(f"stage {stage!r} is not in track {track['track']!r}'s "
                      f"vocabulary {stages}")


def track_of(config: dict, name: str) -> dict:
    """The declared track by that name, or the implicit `main`.

    **The refusal is `check_role`'s shape, and for the same reason.** A track
    is a declaration the project makes about itself — one row of
    `.perry/config.md § Tracks` — so naming one that has no row is the same
    mistake as naming a role with no card, and the answer a user needs is the
    same: which names DO exist, and where to add the missing one. It used to
    print a Python list repr (`declared: ['main', 'intake']`) and stop there,
    which named the set and not the way forward. Nothing is created here: a
    tool that invented the track would turn a typo into a second track that
    every count then reports as real.
    """
    for t in config.get("tracks", []):
        if t["track"] == name:
            return t
    if name and name != "main":
        declared = [t["track"] for t in config.get("tracks", [])]
        shown = (", ".join(declared)
                 or "(none — this project has only the implicit `main`)")
        raise Refused(
            f"track {name!r} is not declared in `.perry/config.md § Tracks`. "
            f"Declared: {shown}. Add a row to that table naming its mode, or "
            f"name one of those. Nothing was written")
    return {"track": "main", "mode": "project", "default_rung": ""}


def target_section(board: "Board", args) -> tuple[str, str]:
    """Where a NEW row is filed: `(priority, group)`, one of them empty.

    One function because it was one function and a hole. `cmd_add` grew the
    `--group` branch — parse the flag, skip the `## P<n>` requirement, file
    under the project's own heading — and `cmd_route` grew nothing: `--group`
    parsed into `args.group` and `cmd_route` never read it. So on a board with
    no `## P0`/`## P1`/`## P2` at all, which is `~/proj/gimegime-pmo`'s actual
    shape, the intake drain had no landing site and could not be given one.

    Worse than a missing feature: `check_priority`'s refusal *recommends* the
    flag — "pass the whole heading to `--group` instead" — so the tool's own
    advice, followed exactly, produced the same refusal a second time. The
    round-5 fix repaired the narrow-columns half of this and its guard's
    fixture carries a `## P1`, so the guard could not fail on the missing
    heading half. `--group` is now read in the one place every writer that
    files a row asks the question.
    """
    group = args.group or ""
    # A group names the section outright, so there is no priority to default:
    # defaulting one would file the row under `## P1` on a board that has none.
    priority = check_priority(args.priority or ("" if group else "P1"))
    if not group:
        try:
            board.table(priority)
        except Refused:
            headings = board.task_section_headings()
            raise Refused(
                f"BOARD.md has no `## {priority}` section, and this project "
                f"files work under its own headings. Name one with --group: "
                f"{headings or '(none carry ID+Title columns)'}. Perry will "
                f"not create a priority section on a board that does not use "
                f"them — rewriting a project's structure is an Anti-Goal")
    return priority, group


def widen_target_section(board: "Board", priority: str, group: str,
                         values: dict) -> None:
    """Add the columns `values` needs to whichever section was named.

    Existing rows are widened with empty cells; nothing is moved.

    **Both branches, because the board does not care which flag named the
    section.** The widening landed on `--group` alone once already, so on the
    one real adopted project available `add --group P2` succeeded and
    `add --priority P2` refused with "columns cannot be resolved" on the same
    four-column `## P2` — the narrow-section case is *more* likely under a
    priority heading, because a hand-written `## P2 (低优先 carry)` is the
    shape a project reaches for when it wants a short list.
    """
    if group:
        _, header = board.section_table(group)
        board.ensure_section_columns(group, widening_columns(header, values))
    else:
        _, _, header = board.table(priority)
        board.ensure_columns(priority, widening_columns(header, values))


def cmd_add(args, ctx) -> dict:
    if not args.title:
        raise Refused("--title is required")
    # A task whose only record is a title cannot be picked up by anyone who was
    # not in the conversation that created it. `add-task` step 2 asked an agent
    # to write the definition block by hand and nothing checked; the day this
    # landed, `## New tasks added` appeared three times in the journal written
    # BEFORE the tool existed and zero times after, and 6 of 10 open rows had
    # no written definition at all.
    if not args.deliverable:
        raise Refused(
            "--deliverable is required: name the ARTIFACT that exists when "
            "this is done, not the activity. 'refactor the parser' is an "
            "activity; 'parser resolves columns by name, with a test' is an "
            "artifact somebody else can check")
    if not args.verification:
        raise Refused(
            "--verification is required and must be falsifiable. 'looks good' "
            "is not a check; 'perry-lint clean on gimegime-pmo' is. This is "
            "the field the V-rungs are graded against, so a task without it "
            "cannot honestly close above V1")
    # `--verification` and `--rung` share a word and mean different things: this
    # one is the falsifiable CHECK a rung is graded against, `--rung` is the
    # rung itself and the cell the board shows. Typing the rung here is the
    # obvious mistake — it was made while opening six rows on Perry's own board
    # the night this was written — and it used to be accepted silently, filing
    # "V4" as though it were a check and leaving nothing to grade.
    #
    # Shaped as the CATEGORY, not the one spelling: any value that is nothing
    # but a rung token. A real check is prose and cannot be mistaken for one.
    if args.verification.strip() in ctx["schema"]["enums"]["verification_rung"]:
        raise Refused(
            f"--verification {args.verification.strip()!r} is a rung, not a "
            f"check. Pass the rung as --rung {args.verification.strip()} and "
            f"give --verification the falsifiable check it is graded against "
            f"— what someone else would run to disagree with you")
    track = track_of(ctx["config"], args.track or "main")
    mode = track["mode"]
    minting = minting_records(ctx)
    prefix = resolve_prefix(minting, args.prefix)
    tid = mint_id(minting, prefix)
    priority, group = target_section(ctx["board"], args)

    if mode == "project" and args.stage:
        # Project mode has no stages at all, so there is no vocabulary to check
        # the value against and nowhere for it to land. Swallowing it is the
        # same silent discard `--commitment` used to perform: the caller
        # believes they set something.
        raise Refused(
            f"track {track['track']!r} is mode `project`, which has no stages "
            f"(`modes/project.md`); --stage has nowhere to go")

    today = f"{date.today():%Y-%m-%d}"
    values = {
        "id": tid, "title": args.title,
        "owner": args.owner or "Coding Agent",
        "status": "not_started",
        "next action": args.next or "—",
        "evidence": "—",
    }
    if mode != "project":
        values["track"] = track["track"]
        stages = stages_of(ctx["schema"], track)
        check_stage(track, stages, args.stage)
        # Queue rows raised directly skip intake, so they start at the first
        # POST-intake stage — the same one `route` assigns, from the same
        # function.
        values["stage"] = args.stage or entry_stage(mode, stages)
        if mode == "queue":
            values["arrived"] = args.arrived or today
        else:
            values["stage since"] = today
        if args.parent:
            values["parent"] = args.parent
    if args.commitment:
        values["commitment"] = args.commitment
    # `--depends` used to reach exactly one place: `- **Dependencies**: <free
    # text>` in the journal's definition block, written once at creation, never
    # updatable, not on the board and not in any payload — the dependency graph
    # living in date-sharded append-only prose, which is verbatim what
    # DESIGN-004 § 1.3 named as the defect for the task set itself. It writes a
    # cell now. The journal line stays, rendering the same ids, because the
    # definition block is what a human reads back.
    depends = check_depends(tid, args.depends, ctx) if args.depends else []
    if depends:
        values["depends on"] = ", ".join(depends)
    rung = check_rung(args.rung, ctx["schema"])
    if rung:
        values["verification"] = rung
    role = check_role(args.role, ctx)
    if role:
        values["role"] = role

    # Run the real path in both cases. `commit()` is what `--dry-run` skips;
    # everything up to it happens for real against the in-memory Board, which is
    # discarded when the process exits.
    #
    # Previously the dry run took a shortcut, and it lied twice: it never called
    # `check_header`, so a board the real call refuses previewed a row and
    # exited 0 — "the tool reporting success while writing nothing the row
    # means" is `check_header`'s own reason for existing. And it rendered from a
    # hardcoded six-name tuple, so `--commitment` and `--track` were invisible
    # in the preview while the real write set them. A preview that is not the
    # write is worse than no preview.
    widen_target_section(ctx["board"], priority, group, values)
    if mode == "queue":
        # The section `triage` step 0 walks. Nothing created it before, so
        # step 0's "only applies when the section exists" gate no-opped
        # forever for every queue track ever made.
        ctx["board"].ensure_section("Intake", ["Arrived", "Request", "Outcome"])

    line = ctx["board"].append_row(priority, values, group=group)
    jline = (f"- [{tid}] — → not_started · {args.title} · "
             f"owner: {values['owner']} · priority: {priority}")
    definition = "\n".join([
        f"### {tid} — {args.title}", "",
        f"- **Owner**: {values['owner']}",
        f"- **Priority**: {priority}",
        f"- **Track / mode**: {track['track']} / {mode}",
        f"- **Deliverable**: {args.deliverable}",
        f"- **Verification**: {args.verification}",
        f"- **Dependencies**: {', '.join(depends) or '—'}",
        f"- **Out of scope**: {args.out_of_scope or '—'}",
        f"- **KR linkage**: {args.kr or 'unlinked'}",
    ])
    event = {"ts": lib.event_stamp(), "event": "add",
             "id": tid, "title": args.title, "track": track["track"], "mode": mode,
             "priority": priority, "actor": args.actor,
             "summary": args.summary or "",
             "depends_on": depends,
             "from": None, "to": "not_started"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run, definition=definition)
    return {"id": tid, "priority": priority, "prefix": prefix,
            "row": line, **plan}


def cmd_start(args, ctx) -> dict:
    tid = args.id
    pri, idx, header, values = task_projection_row(ctx, tid)
    prev = values.get("status", "")
    if prev == "in_progress":
        raise Refused(f"{tid} is already in_progress")
    values["status"] = "in_progress"
    if args.next:
        values["next action"] = args.next
    # `Stage since` is NOT touched here. It used to be, and `Status` and
    # `Stage` are orthogonal by design — starting work does not move a row to a
    # new stage, so restamping the clock reported 0 days' dwell for an item
    # that had sat in `review` for a fortnight. `dispatch` calls `start` on
    # every automated run, so this was the automated path, not a manual slip,
    # and it blinded pipeline triage's first question — the one aimed at that
    # mode's signature failure. The schema says this cell is "the date the row
    # entered its current Stage"; `cmd_stage` is its only writer.
    line = ctx["board"].replace_row(idx, header, values)
    jline = f"- [{tid}] {prev or '—'} → in_progress · started"
    event = {"ts": lib.event_stamp(), "event": "start",
             "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"),
             "actor": args.actor, "from": prev, "to": "in_progress"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "row": line, **plan}


# ── the V5 sign-off: selected from measured facts, never authored from memory ──
#
# V5 is "human sign-off — name, date, and what they checked". Until TASK-109 the
# tool took none of that: `done --rung V5` wrote a rung and the *signature* was
# a paragraph the user composed by hand into an evidence file. Measured on this
# project: 3 of 80 closed rows carry V5, so the cost is not frequency — it is
# what the paragraph asks for when it does fire.
#
# TASK-047 is the case that named both defects. Perry ran three checks, printed
# their output and showed the user; the user then wrote, from memory, a sentence
# describing those same three checks (`perry/evidence/2026-08/
# TASK-047-dispatch-2026-08-20-1416.md § V5 sign-off`). So:
#
#   1. the user re-derived by hand a record the tool already held, and
#   2. free text cannot distinguish *I re-ran this* from *Perry ran this and I
#      read the output*. The second collapses into the first the more Perry
#      does, which is the rung's failure mode wearing its own label.
#
# **The line that keeps this from becoming a rubber stamp.** If Perry drafts the
# signature and the user presses return, Perry has certified its own work — the
# exact failure V5 exists to prevent. So:
#
#     Perry may draft only facts it MEASURED. It may never draft a claim about
#     what the USER did.
#
# `claims[] has zero lines in the diff` is drafted — Perry ran the diff.
# `the user reviewed the diff` is refused — Perry cannot know that.
#
# `check_no_user_claim` enforces that mechanically at the option builder, which
# is the only place a drafted string is minted. The user's contribution is which
# of Perry's facts they personally re-checked, plus `--also` for anything Perry
# does not know about.

#: The two provenance labels an offered item can carry, stored **verbatim** in
#: the record because the label is the product. `checked` against a
#: Perry-verified fact means *I checked this too*; against a restated one it
#: means *I checked a claim Perry only passed along*. Collapse the labels and
#: those two become the same sentence, which is today's defect exactly.
PROVENANCE_VERIFIED = "Perry verified"
PROVENANCE_RESTATED = "restated — Perry did not verify this"

#: The three dispositions an offered item ends in.
#:
#: **Why three and not two.** The obvious design has `checked` and one bucket
#: for everything else. It loses the distinction the rung exists for. Perry's
#: own corpus already writes all three by hand: TASK-034's signature carries a
#: `**Not checked, and recorded because V5's whole value is saying so:**`
#: section beside what it did check, and TASK-047's carries "fixture opt-out 的
#: 理由已读并接受" (read, then accepted) beside two costs taken on the strength of
#: Perry's printed output. A format that cannot hold what the three existing
#: signatures already say is a regression against the corpus it must stay
#: compatible with.
#:
#: The second reason is the rule above. Defaulting every unselected item to
#: `accepted on report` is already the outer edge of what Perry may assert: it
#: is a statement about the SCOPE OF THE SIGNATURE — signing the close accepts
#: these on the strength of the report — and not a claim that the user
#: performed the act of reading. `not looked at` is therefore never a default.
#: It is only ever reached by the user naming the item, which is what keeps it
#: a user statement rather than a Perry one.
SIGNED_CHECKED = "checked"
SIGNED_ON_REPORT = "accepted on report"
SIGNED_UNSEEN = "not looked at"
SIGNED_DISPOSITIONS = (SIGNED_CHECKED, SIGNED_ON_REPORT, SIGNED_UNSEEN)

#: A subject that makes a sentence a claim about a person rather than about the
#: world. `(?![\w-])` after the match is the escape hatch that keeps
#: "the user-facing message" — a perfectly good measured fact — from tripping
#: the guard, because the hyphen is part of the following token.
#:
#: CJK terms sit OUTSIDE the boundary assertions on purpose: `\w` matches CJK,
#: so `用户已阅` has no boundary after `用户` and the guarded form silently never
#: fires. A guard that reports clean on the language half of this project's own
#: signatures would be worse than no guard.
_USER_SUBJECT = re.compile(
    r"(?<![\w-])(?:the (?:user|human|signer|approver|reviewer|owner)s?"
    r"|you|your|yours)(?![\w-])"
    r"|用户|你", re.I)

#: A verb that names an act of human judgement rather than an observation. A
#: measured fact is phrased as something that IS true ("the diff shows zero
#: lines"), never as something someone DID ("reviewed the diff"). Dropping the
#: subject does not make the claim Perry's to draft.
_ACT_OF_JUDGEMENT = re.compile(
    r"(?<![\w-])(?:reviewed|approved|acknowledged|agreed|accepted|"
    r"signed[- ]off|sign-off)(?![\w-])"
    r"|已阅|已确认|已接受|同意|认可", re.I)


def check_no_user_claim(text: str, flag: str) -> str:
    """Refuse a drafted option that asserts what a person did. Deliverable 6.

    This is a *mechanical* guard rather than a review note on purpose: the
    difference between a fact Perry measured and a claim about the user is the
    single thing standing between this feature and a rubber stamp, and a rule
    enforced by remembering it is a rule that holds until the first hurried
    close.

    A false positive is cheap and is meant to be: the refusal names the phrase
    and the fix is to restate the option as the observation it came from.
    """
    hit = _USER_SUBJECT.search(text)
    if hit:
        raise Refused(
            f"{flag} {text!r} names {hit.group(0)!r}. A sign-off option may "
            f"only state a fact Perry measured — never a claim about what a "
            f"person did, which Perry cannot know and must not draft on their "
            f"behalf. State the observation instead: not \"the user reviewed "
            f"the diff\" but \"the diff carries zero changed lines\".")
    hit = _ACT_OF_JUDGEMENT.search(text)
    if hit:
        raise Refused(
            f"{flag} {text!r} says {hit.group(0)!r}, which names an act of "
            f"judgement rather than an observation. Whether it was reviewed, "
            f"approved or accepted is what the signer decides by selecting "
            f"this item; drafting it here would have Perry certify its own "
            f"work. Restate it as what was measured.")
    return text


def signoff_options(measured, restated) -> list[dict]:
    """The one place a sign-off option is minted, numbered from 1.

    Order is `--measured` first, then `--restated`, and the numbering handed to
    the user by `signoff-offer` is the numbering `done --checked` reads. They
    are the same function so they cannot drift: a prompt whose option 3 is the
    tool's option 4 records the wrong item under a signature, which is the one
    failure this whole path exists to make impossible.
    """
    options: list[dict] = []
    for raw, provenance, flag in (
            [(t, PROVENANCE_VERIFIED, "--measured") for t in (measured or [])]
            + [(t, PROVENANCE_RESTATED, "--restated") for t in (restated or [])]):
        text = " ".join((raw or "").split())
        if not text:
            raise Refused(
                f"{flag} was given an empty item. An unnamed thing cannot be "
                f"checked, accepted or declined; drop the flag instead.")
        check_no_user_claim(text, flag)
        options.append({"n": len(options) + 1, "text": text,
                        "provenance": provenance})
    return options


def parse_item_selection(values, count: int, flag: str) -> set[int]:
    """`--checked 1,3`, `--checked all`, `--checked none`, or repeated flags.

    All four spellings exist because the host that has no selection UI gets the
    numbered free-text fallback (`reference/host-capabilities.md § Prompt
    rendering`), and what comes back from a person typing into that is
    `1,3` or `all` or `none`. Rendering differs per host; the record does not.
    """
    picked: set[int] = set()
    for value in values or []:
        for token in str(value or "").replace("，", ",").split(","):
            token = token.strip()
            if not token:
                continue
            low = token.lower()
            if low == "none":
                continue
            if low == "all":
                picked |= set(range(1, count + 1))
                continue
            try:
                n = int(token)
            except ValueError:
                raise Refused(
                    f"{flag} takes the numbers shown by `perry-task "
                    f"signoff-offer`, `all` or `none`; got {token!r}") from None
            if not 1 <= n <= count:
                raise Refused(
                    f"{flag} {n} is not one of the {count} offered item(s). "
                    f"Selecting an item nobody was offered would record a "
                    f"signature against something the record does not hold.")
            picked.add(n)
    return picked


def resolve_signer(project_root: Path, explicit: str | None) -> str:
    """The name, filled in rather than typed. Deliverable 3.

    Name and date are the two fields a human should never be retyping: they are
    the parts of a signature the machine knows for certain and the human can
    only get wrong. `git config user.name` is the same source the three existing
    signatures in this repository were written from.

    Refused rather than defaulted to a placeholder if nothing resolves — an
    anonymous signature is not a weaker signature, it is not one.
    """
    if explicit and explicit.strip():
        return explicit.strip()
    from_env = (os.environ.get("PERRY_SIGNER") or "").strip()
    if from_env:
        return from_env
    try:
        out = subprocess.run(
            ["git", "-C", str(project_root), "config", "user.name"],
            capture_output=True, text=True, timeout=5)
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        import getpass
        who = (getpass.getuser() or "").strip()
        if who:
            return who
    except Exception:                                   # noqa: BLE001
        pass
    raise Refused(
        "no name to sign with. Perry fills the signer in rather than asking a "
        "human to type it, and found nothing: set `git config user.name`, or "
        "pass --signer \"<full name>\".")


def build_signoff(options, checked, unseen, also, signer, signed_on) -> dict:
    """The record. Designed before the prompt, and identical on every host.

    Every offered item lands in the record with its provenance and its
    disposition. **Nothing is dropped**: an item the user did not select is
    written as `accepted on report`, which is strictly more than the free-text
    paragraph could say, since that form could not distinguish the two at all.
    """
    both = checked & unseen
    if both:
        raise Refused(
            f"item(s) {', '.join(str(n) for n in sorted(both))} were named "
            f"both `{SIGNED_CHECKED}` and `{SIGNED_UNSEEN}`. One item, one "
            f"disposition — a record that says both says neither.")
    items = [{
        "n": option["n"],
        "text": option["text"],
        "provenance": option["provenance"],
        "disposition": (SIGNED_CHECKED if option["n"] in checked
                        else SIGNED_UNSEEN if option["n"] in unseen
                        else SIGNED_ON_REPORT),
    } for option in options]
    also = (also or "").strip()
    if not any(i["disposition"] == SIGNED_CHECKED for i in items) and not also:
        # Deliverable 7. An empty signature is the failure the rung exists to
        # prevent, and the way it gets written is by pressing return at the
        # prompt. Refusing here is what makes that keystroke cost something.
        raise Refused(
            "a V5 sign-off with nothing checked and no free text is not a "
            "sign-off. Either name what you checked yourself (--checked), or "
            "write it in --also. If you checked nothing, the rung is not V5 — "
            "close at the rung the work actually reached.")
    return {
        "signed_by": signer,
        "signed_on": signed_on,
        "items": items,
        "also_checked": also,
        "counts": {label: sum(1 for i in items if i["disposition"] == label)
                   for label in SIGNED_DISPOSITIONS},
    }


def render_signoff(tid: str, record: dict) -> str:
    """The record as the block that lands in the journal.

    Headings are the disposition labels **verbatim**, so a reader of the
    markdown and a reader of the event see the same three words. The three
    signatures already in `perry/evidence/2026-08/` keep their own shape and
    are not touched: this adds a path, it does not rewrite history.
    """
    out = [f"**{tid} — V5 sign-off. {record['signed_by']}, "
           f"{record['signed_on']}.**", ""]
    for label in SIGNED_DISPOSITIONS:
        group = [i for i in record["items"] if i["disposition"] == label]
        if not group:
            continue
        out += [f"**{label}**", ""]
        out += [f"- {i['text']} *({i['provenance']})*" for i in group]
        out += [""]
    if record["also_checked"]:
        out += ["**checked, and not among what Perry offered**", "",
                record["also_checked"], ""]
    return "\n".join(out).rstrip() + "\n"


def signoff_from_args(args, ctx, rung: str) -> tuple[dict | None, str]:
    """Assemble the signature `done` was given, or `(None, "")` for no attempt.

    **When an empty signature is refused, stated exactly.** The refusal fires
    whenever the sign-off path was ENGAGED — any of the flags below was passed
    — and produced nothing. A bare `done --rung V5` with no sign-off flags at
    all is left alone and writes no signature rather than a blank one: rungs
    are advisory this release by DESIGN-003 § 4 decision 4, and hardening the
    rung itself is out of this row's scope. What is closed here is the hole
    deliverable 7 names — a signature that reads as one and says nothing.
    """
    engaged = any([args.measured, args.restated, args.checked,
                   args.not_looked_at, args.also, args.signer, args.signed_on])
    if not engaged:
        return None, ""
    if rung != "V5":
        raise Refused(
            f"a sign-off belongs to V5 and this close is {rung}. V5 is the "
            f"rung whose whole content is a name, a date and what was checked "
            f"(`schema/state-schema.json § verification`); attaching one to "
            f"{rung} would record a human gate that was never asked for.")
    options = signoff_options(args.measured, args.restated)
    checked = parse_item_selection(args.checked, len(options), "--checked")
    unseen = parse_item_selection(args.not_looked_at, len(options),
                                  "--not-looked-at")
    on = (args.signed_on or "").strip() or f"{date.today():%Y-%m-%d}"
    try:
        date.fromisoformat(on)
    except ValueError:
        raise Refused(f"--signed-on takes YYYY-MM-DD; got {on!r}") from None
    record = build_signoff(
        options, checked, unseen, args.also,
        resolve_signer(ctx["project_root"], args.signer), on)
    return record, render_signoff(args.id, record)


def cmd_signoff_offer(args, ctx) -> dict:
    """Read-only. Build the one selection prompt a V5 close offers.

    Separate from `done` because the numbering the human sees has to be the
    numbering `done --checked` reads, and the only way to guarantee that is for
    one function to mint both. It writes nothing: an offer is a question.

    The payload carries the host-native shape (`options`, `multi_select`) and
    the rendered numbered fallback together, because Perry runs on three hosts
    and only one of them has a selection UI. `SKILL.md § User-prompt
    convention` picks `AskUserQuestion` on Claude Code and `question` on
    OpenCode; Codex prints `prompt` and reads free text back. **The record is
    identical whichever produced it** — the host chooses the rendering, never
    the content.
    """
    tid = args.id
    if not tid:
        raise Refused(
            "perry-task signoff-offer <TASK-ID> --measured \"…\" "
            "[--restated \"…\"] — the id is the prompt's header.")
    if tid not in ctx["tasks_by_id"]:
        raise Refused(f"{tid} is not a task in this project's record, so there "
                      f"is nothing to sign off.")
    options = signoff_options(args.measured, args.restated)
    if not options:
        raise Refused(
            "nothing to offer. Pass what Perry measured during this task as "
            "--measured (the objective-verification commands it ran, the scope "
            "cross-check) and anything it is only restating as --restated. An "
            "offer built from nothing is a prompt that teaches the reader to "
            "press return.")
    header = f"{tid} — V5 sign-off"
    question = "Which of these did you check yourself?"
    lines = [f"[{header}]", f"  {question}"]
    lines += [f"  {o['n']}) {o['text']}  [{o['provenance']}]" for o in options]
    lines += [
        f"Reply with the numbers you checked yourself (e.g. `1,3`), `all`, or "
        f"`none`.",
        f"Anything you leave out is recorded as `{SIGNED_ON_REPORT}`; say "
        f"`unseen: <n>` for an item",
        f"you did not look at. Then add anything you checked that is not "
        f"listed here.",
    ]
    return {
        "id": tid,
        "rung": "V5",
        "header": header,
        "question": question,
        "multi_select": True,
        "options": options,
        "dispositions": list(SIGNED_DISPOSITIONS),
        "default_disposition": SIGNED_ON_REPORT,
        "prompt": "\n".join(lines),
        "free_text": {
            "flag": "--also",
            "invitation": "Anything you checked that Perry did not offer?",
        },
    }


def cmd_done(args, ctx) -> dict:
    tid = args.id
    if not args.evidence:
        raise Refused(
            f"{tid}: --evidence is required. Perry refuses `done` without it — "
            f"a claim of done that cites nothing is a claim about confidence, "
            f"not about the work")
    rung = check_rung(args.rung, ctx["schema"])
    pri, idx, header, values = task_projection_row(ctx, tid)
    prev = values.get("status", "")
    if not rung:
        track = track_of(ctx["config"], values.get("track", "main"))
        rung = (track.get("default_rung")
                or ctx["schema"]["work_modes"]["modes"][track["mode"]]["default_rung"])
    signoff, signoff_block = signoff_from_args(args, ctx, rung)
    line = ctx["board"].remove_row(idx)
    jline = (f"- [{tid}] {prev or '—'} → done · closed · "
             f"evidence: `{args.evidence}` · verification: {rung}")
    if signoff:
        counts = signoff["counts"]
        jline += (f" · signed off: {signoff['signed_by']} "
                  f"{signoff['signed_on']} — "
                  + ", ".join(f"{counts[label]} {label}"
                              for label in SIGNED_DISPOSITIONS
                              if counts[label])
                  + (", plus free text" if signoff["also_checked"] else ""))
    event = {"ts": lib.event_stamp(), "event": "done",
             "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"),
             # **`owner` and `role` travel with the close, or the closed half
             # of the board is anonymous.** `done` REMOVES the row, so
             # everything the row said that the event does not carry is gone.
             # aiMark measured it on this board: owner present on 21 of 21 open
             # rows and **0 of 60 closed** ones. Its control was a project with
             # no event log, where closed rows stay on the board and owner is
             # 17/17 — so this is a consequence of the log, not of the data.
             #
             # A declared role could show current workload and never a track
             # record. `evidence` and `rung` were carried for exactly this
             # reason and these two were simply missed.
             "owner": values.get("owner", ""),
             "role": values.get("role", ""),
             "actor": args.actor, "from": prev, "to": "done",
             "evidence": args.evidence, "rung": rung}
    if signoff:
        event["signoff"] = signoff
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run, signoff_block=signoff_block)
    # **A row that closed without ever being started is reported, not refused.**
    #
    # `DESIGN-004 § 1.3`'s second question is "what is being worked on right
    # now", and the whole event log exists to answer it. Measured on this
    # project's own log: 56 rows closed, **54 of them with no `start` event** —
    # so for an entire working session the board could not answer that question
    # about any row, and the design doc's own account of the old failure
    # ("the board said `in_progress` when an agent remembered to write it")
    # was reproduced exactly, by the tool's author.
    #
    # A warning rather than a refusal: work genuinely done in one sitting is
    # honestly `add → done`, and refusing that would teach people to write a
    # `start` they do not mean. What the warning buys is that the omission
    # becomes VISIBLE at the moment it is made, instead of being discoverable
    # only by counting events afterwards.
    started = any(e.get("id") == tid and e.get("event") == "start"
                  for e in ctx["events"])
    if not started and not args.as_json:
        print(f"perry-task: note — {tid} closed without ever being `start`ed, "
              f"so nothing ever showed it in flight. `perry-task start <id>` "
              f"is what makes `list` answer \"what is being worked on now\".",
              file=sys.stderr)
    return {"id": tid, "rung": rung, "removed": line,
            "was_started": started, "signoff": signoff,
            "signoff_block": signoff_block, **plan}


def cmd_stage(args, ctx) -> dict:
    """Move an item to a new stage and re-stamp its clock in the same write.

    Unconditional. `Stage` and `Status` are orthogonal by design, so a
    `draft → review` move produces no status change and would otherwise leave
    no trace anywhere — which is exactly how the dwell-time rule survived three
    review rounds as prose that nothing could compute.
    """
    tid, stage = args.id, args.stage
    if not stage:
        raise Refused("a stage is required: perry-task stage <ID> --stage <name>")
    pri, idx, header, values = task_projection_row(ctx, tid)
    track = track_of(ctx["config"], values.get("track", "main"))
    stages = stages_of(ctx["schema"], track)
    check_stage(track, stages, stage)
    prev = values.get("stage", "")
    if prev == stage:
        raise Refused(f"{tid} is already at stage {stage!r}")
    values["stage"] = stage
    values["stage since"] = f"{date.today():%Y-%m-%d}"
    # Create the column before writing to it. Without this the stamp was
    # dropped on any board that lacked `Stage since` — `replace_row` maps
    # values onto headers, so a missing header silently discards the value and
    # the call still exits 0. Same defect that lost `--commitment`.
    if pri in ("P0", "P1", "P2"):
        ctx["board"].ensure_columns(pri, ["Stage since"])
        pri, idx, header, values = task_projection_row(ctx, tid)
        values["stage"] = stage
        values["stage since"] = f"{date.today():%Y-%m-%d}"
    line = ctx["board"].replace_row(idx, header, values)
    jline = f"- [{tid}] stage {prev or '—'} → {stage}"
    event = {"ts": lib.event_stamp(), "event": "stage",
             "id": tid, "title": values.get("title", ""),
             "track": track["track"], "actor": args.actor,
             "from": prev, "to": stage}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "stage": stage, "row": line, **plan}


def widen_row_section(board: "Board", section: str, columns: list[str]) -> None:
    """Add columns to whichever section already holds a row.

    `Board.find` returns `P0`/`P1`/`P2` **or a project's own heading**, and the
    two widenings live on different methods. `cmd_stage` widens only in the
    first case, so on a board that files work under its own headings — the
    shape `--group` exists for, and the only real adopted project available —
    a `Stage since` stamp is dropped silently, because `replace_row` maps
    values onto headers and a missing header discards the value at exit 0.
    That is the same defect that lost `--commitment` and then `Stage since`.
    A track move writes FOUR such cells, so it asks the question once, here,
    for both section shapes.
    """
    if section in ("P0", "P1", "P2"):
        board.ensure_columns(section, columns)
    else:
        board.ensure_section_columns(section, columns)


def cmd_track(args, ctx) -> dict:
    """Move an existing row onto another declared track.

    **The second entrance a track has, and the reason it exists.** `--track`
    was accepted by `add` (at creation) and `route` (intake row → new task) and
    nowhere else, so a project that declared a second track started it empty
    and could not move a single existing row onto it. A declared track with no
    rows is not a mode running on a live track — measured on this repository,
    which declared `intake` and left six rows that genuinely arrived stranded
    on `main` (`perry/evidence/2026-08/TASK-133-track-experiment.md`).

    **Onto a queue track, this stamps what `route` stamps.** Not bookkeeping:
    `today − Arrived` is the number every SLA check measures, so a second
    entrance that omitted it would make `Arrived` mean one thing per entrance
    and silently exempt every moved row from the only clock governing it.
    `entry_stage` is the same function `add` and `route` call, so the three
    entrances cannot disagree about where a row begins on a track.

    **An existing `Arrived` is CARRIED, never restamped.** A queue → queue move
    that reset the clock to today would erase an in-flight breach — the same
    exemption, arriving through the other door. `--arrived` overrides, for the
    row whose arrival the board never recorded.

    **Off a track, `Stage` / `Stage since` / `Arrived` are CLEARED, and the
    cleared values are written into the journal line and the event.** This is
    the decision deliverable 2 asks for, and it is `drop`'s precedent applied
    to a cell rather than a row. The alternative — leaving them — loses nothing
    visibly and costs the thing they are for: `Arrived` is not provenance, it
    is *a queue's clock*, and a clock left on a row no queue governs is a
    live-looking number the next SLA reader picks up. It is already load-bearing
    in the negative direction too, and measured: `cmd_route` had to stop writing
    `Arrived` onto pipeline rows precisely because a non-empty `arrived` hides
    the row from `rows_with_no_computable_age`, which is the finding that says
    "this row has no clock at all". So keeping it would suppress the one report
    that could notice the move.

    Dropping the CELL is not dropping the FACT. The journal is append-only and
    the event carries `stage_from` / `arrived_from`, which is exactly where
    `drop` puts the stage a row died in and where every other post-removal
    question is already answered from. A move back onto a queue track re-stamps
    a fresh clock, and the log says what the old one read.

    `route` keeps a non-queue `Arrived` when it has one and this clears it;
    they do not contradict. `route` BIRTHS a row out of an intake row whose
    `Arrived` column is its only origin. This moves a row that already has a
    whole history somewhere else to be read.
    """
    tid = args.id
    if not args.track:
        raise Refused(
            f"--track is required: perry-task track {tid or '<ID>'} "
            f"--track <name>. This subcommand exists to change that cell")
    dest = track_of(ctx["config"], args.track)
    section, idx, header, values = task_projection_row(ctx, tid)
    was = (values.get("track") or "").strip() or "main"
    now = dest["track"]
    # A no-op that still emitted an event would put a move in the timeline that
    # did not happen, and the timeline is what `list` reports as history.
    if was == now:
        raise Refused(f"{tid} is already on track {now!r} — nothing to move")

    mode = dest["mode"]
    stages = stages_of(ctx["schema"], dest)
    check_stage(dest, stages, args.stage)
    stage = args.stage or entry_stage(mode, stages)
    prev_stage = (values.get("stage") or "").strip()
    prev_arrived = (values.get("arrived") or "").strip()
    today = f"{date.today():%Y-%m-%d}"
    if mode == "queue":
        arrived = args.arrived or prev_arrived or today
    else:
        # The destination does not read it. See the docstring: cleared here,
        # recorded on both surfaces that survive.
        if args.arrived:
            raise Refused(
                f"track {now!r} is mode `{mode or 'project'}`, which measures "
                f"`Stage since` rather than `Arrived` — there is no clock for "
                f"--arrived to set. Drop the flag; the move records the "
                f"`Arrived` this row is leaving behind")
        arrived = ""

    # Only the cells this move WRITES a value into. A column that does not
    # exist holds no stale clock to clear, so widening the board to add an
    # empty `Arrived` would cost every row a column to record an absence.
    wanted = {"track": now, "stage": stage,
              "stage since": today if stage else "", "arrived": arrived}
    widen_row_section(ctx["board"], section,
                      [canonical_column(c) for c, v in wanted.items() if v])
    # Re-locate: widening rewrites the header and every row in place, so the
    # values dict has to be refilled against the header that now exists.
    section, idx, header, values = task_projection_row(ctx, tid)
    values.update(wanted)
    line = ctx["board"].replace_row(idx, header, values)

    jline = (f"- [{tid}] track {was} → {now} · mode {mode or 'project'} · "
             f"stage {prev_stage or '—'} → {stage or '—'} · "
             f"arrived {prev_arrived or '—'} → {arrived or '—'}")
    if args.reason:
        jline += f" · reason: {args.reason}"
    event = {"ts": lib.event_stamp(),
             "event": "track", "id": tid, "title": values.get("title", ""),
             # The track the row is NOW on, like every other event's `track`.
             # `from`/`to` carry the move itself.
             "track": now, "mode": mode, "actor": args.actor,
             "field": "track", "from": was, "to": now,
             # The four cells this write touched, each with what it replaced.
             # A track change nothing recorded is TASK-139's shape; a CLEARED
             # clock recorded nowhere is the same defect one field down.
             "stage": stage, "stage_from": prev_stage,
             "arrived": arrived, "arrived_from": prev_arrived,
             "reason": args.reason or ""}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "from": was, "to": now, "mode": mode, "stage": stage,
            "arrived": arrived, "row": line, **plan}


def cmd_status(args, ctx) -> dict:
    """Any status transition the named subcommands do not cover.

    `add`/`route`, `start`, `done` and `drop` cover four of the six statuses.
    `blocked` and `review` had no tool path at all — and `dispatch` moves rows
    into `review` on every run, so every dispatch manufactured a post-tool edit
    that drift detection would report forever. A gap in coverage becomes a
    permanent false signal the moment detection exists, which is why this is not
    a nice-to-have.
    """
    tid, want = args.id, args.status
    allowed = ctx["schema"]["enums"]["task_status"]
    if not want:
        raise Refused(f"--status is required, one of {allowed}")
    if want not in allowed:
        raise Refused(f"status {want!r} is not one of {allowed}")
    if want in ("done", "dropped"):
        raise Refused(
            f"use `perry-task {'done' if want == 'done' else 'drop'}` — those "
            f"close a row and need evidence or a reason, which this does not take")
    pri, idx, header, values = task_projection_row(ctx, tid)
    prev = values.get("status", "")
    if prev == want:
        raise Refused(f"{tid} is already {want}")
    # `--on` is the queryable half of the same demand `--reason` has always
    # made. The refusal below was right — "a blocked row with no named
    # dependency is a row nobody can unblock" — and then it put the named
    # dependency into prose, where `subcommands.md`'s own triage rule ("the
    # same dependency cited in ≥ 2 rows") could not read it. Either flag
    # satisfies the gate, because a project blocked on something that is not a
    # task ("waiting on Apple") still has to be able to say so; only `--on`
    # reaches the payload, and that is the difference the two names carry.
    depends = check_depends(tid, args.on, ctx) if args.on else []
    if want == "blocked" and not (args.reason or depends):
        raise Refused(
            f"{tid}: blocked needs --on naming the task(s) it waits on, or "
            f"--reason if what it waits on is not a task. A blocked row with "
            f"no named dependency is a row nobody can unblock")
    values["status"] = want
    if depends:
        ctx["board"].ensure_columns(pri, [canonical_column("depends on")])
        pri, idx, header, values = task_projection_row(ctx, tid)
        values["status"] = want
        values["depends on"] = ", ".join(depends)
    if args.next:
        values["next action"] = args.next
    elif want == "blocked":
        values["next action"] = (f"blocked on {args.reason}" if args.reason
                                 else f"blocked on {', '.join(depends)}")
    line = ctx["board"].replace_row(idx, header, values)
    tail = f" · {args.reason or ', '.join(depends)}" if (args.reason or depends) else ""
    jline = f"- [{tid}] {prev or '—'} → {want}{tail}"
    event = {"ts": lib.event_stamp(), "event": "status",
             "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"), "actor": args.actor,
             "depends_on": depends,
             "from": prev, "to": want, "reason": args.reason or ""}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "status": want, "row": line, **plan}


def cmd_depends(args, ctx) -> dict:
    """Declare, replace or clear what a row waits on.

    The edge lives in a **board cell**, `Depends on`, and nowhere else. Three
    places were candidates and only one survives its own failure mode:

    - the event log alone — DERIVED AND DISPOSABLE, and `mode` already proved
      what that costs a contract: deleting `.perry/events.jsonl` blanked the
      field for every row on the board.
    - the journal definition block alone — where `add --depends` has been
      writing since it existed: append-only, date-sharded, written once at
      creation and never updatable. A dependency's whole life is being
      satisfied, and a record that cannot record that is not a record.
    - a board cell, with the log recording the transition. The markdown stays
      canonical, the log stays derived, and both say what they are for.

    A cell costs `BOARD.md` no LINES — the cap is 200 and the file is at 94 —
    only width, and only on the sections that carry a dependency: the column is
    added by `ensure_columns` on first use, per section, exactly like
    `Commitment` and `Verification` before it.

    This subcommand REPLACES the cell rather than appending to it. A dependency
    set is a statement about the present, and the two-flag alternative
    (`--add`/`--remove`) would make "what does this row wait on" a question
    whose answer depends on the order the flags were run in.
    """
    tid = args.id
    if not args.clear and not args.on:
        raise Refused(
            f"{tid}: --on is required, naming the id(s) this row waits on — "
            f"or --clear to record that it waits on nothing")
    if args.clear and args.on:
        raise Refused("--clear and --on contradict each other")
    pri, idx, header, values = task_projection_row(ctx, tid)
    prev = parse_depends(values.get("depends on", ""))
    ids = [] if args.clear else check_depends(tid, args.on, ctx)
    if prev == ids:
        raise Refused(f"{tid} already depends on "
                      f"{', '.join(ids) if ids else 'nothing'}")
    ctx["board"].ensure_columns(pri, [canonical_column("depends on")])
    pri, idx, header, values = task_projection_row(ctx, tid)
    values["depends on"] = ", ".join(ids) or "—"
    line = ctx["board"].replace_row(idx, header, values)
    shown = ", ".join(ids) or "—"
    jline = f"- [{tid}] depends on · {', '.join(prev) or '—'} → {shown}"
    event = {"ts": lib.event_stamp(),
             "event": "depends", "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"), "actor": args.actor,
             "depends_on": ids,
             "from": ", ".join(prev), "to": shown}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "depends_on": ids, "row": line, **plan}


#: The board columns, keyed the other way round. `off_board_repair` reaches a
#: record with no projection row, so it has to name the STORE field; every
#: other path in `cell_writer` goes through `task_projection_row`, which is
#: keyed by column.
_BOARD_TO_STORE = {column: field for field, column in _STORE_TO_BOARD.items()}


def _row_is_on_the_board(ctx, task_id: str) -> bool:
    """Does the projection hold a line for this id? (It does not, once closed.)"""
    board = ctx.get("board")
    if board is None:
        return False
    try:
        board.find(task_id)
    except Refused:
        return False
    return True


def repair_off_board_cell(args, ctx, field: str, event: str, why: str,
                          value: str, show_previous: bool) -> dict:
    """Write one cell of a record the projection no longer carries a row for.

    **TASK-166.** `cell_writer` refuses a row that is not on the board, and
    that refusal is right for the cell writers as a class — `next` refuses a
    finished row on purpose, `rung` and `evidence` are claims about work that
    was checked, and a closed row's `status` has exactly one writer. Closing
    REMOVES the row, so "not on the board" and "finished" are the same
    condition seen from the projection, and the refusal is how the tool says
    "that work is over".

    `title` is the one cell where that is false, and the reason is what the
    cell IS. Every other cell `cell_writer` writes is a claim about the work —
    where it got to, who checked it, what is next — and a claim about finished
    work is finished too. The title is the row's NAME: it is what a reader is
    handed instead of a bare id, which `reference/user-load.md` forbids
    outright, and a name is needed for exactly as long as anybody reads the
    record. On this repository the only permanently untitled row is
    `TASK-029`, and it is permanently untitled BECAUSE it closed: an open row
    with no title gets one the next time somebody reads the board, so the two
    halves of the defect were one shape — the check that would find it only
    looked where the writer could reach, and the writer only reached where the
    check already looked.

    **How narrow this door is, stated so a mutation can widen it and redden a
    test.** Three separate guards, none of which is the other's restatement:

    1. `off_board_repair=True` is passed by `retitle` and by nothing else, so
       `next`, `rung`, `evidence` and `status` never reach this function.
    2. It refuses a record that is not terminal. An OPEN row missing from the
       projection is a rendering failure, not a closed row, and repairing it
       here would paper over a stale `BOARD.md`.
    3. `commit`'s per-event `changed` whitelist still bounds the write to
       `("title",)`, so even this path cannot carry a second field across.
    """
    record = task_record(ctx, args.id)
    status = (record.get("status") or "").strip().lower()
    if status not in ("done", "dropped"):
        raise Refused(
            f"{args.id} is {status or 'unset'} and is not a row on the board. "
            f"An open row missing from the projection is a rendering failure, "
            f"not finished work: run `perry-tasks render --write` and retry.")
    store_field = _BOARD_TO_STORE[field]
    previous = record.get(store_field) or ""
    if previous.strip() == value.strip():
        raise Refused(f"{args.id}'s {field} is already that")
    jline = (f"- [{args.id}] {why} · {previous or '—'} → {value}"
             if show_previous else f"- [{args.id}] {why} · {value}")
    ev = {"ts": lib.event_stamp(),
          "event": event, "id": args.id, "title": value,
          "track": record.get("track") or "main", "actor": args.actor,
          "from": previous, "to": value}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, ev, args.dry_run, off_board=True)
    # No `row`: there is no projection line, and inventing one would be the
    # tool claiming a board edit it did not make.
    return {"id": args.id, field: value, **plan}


def cell_writer(field: str, flag: str, event: str, why: str,
                validate=None, terminal_ok: bool = True,
                required_msg: str = "", show_previous: bool = True,
                off_board_repair: bool = False):
    """One implementation for "correct this cell and nothing else".

    There were three — `next`, `retitle`, `rung` — written weeks apart and each
    a copy of the previous, and the fourth was about to be written for
    `Evidence` when a corrupted row needed repairing and no tool could do it.
    Three copies of one rule is the defect class this project has spent five
    review rounds finding in its own prose; here it was in its own code.

    Each writer keeps its own **event name**, which is the part that is not
    boilerplate. A reader has to be able to tell "the plan changed" from "what
    this is called changed" from "where this got to", and folding them into one
    event loses all three facts at once.
    """
    def run(args, ctx) -> dict:
        tid = args.id
        value = getattr(args, flag)
        if not value:
            raise Refused(required_msg or
                          f"--{flag.replace('_', '-')} is required: this "
                          f"subcommand exists to write that cell")
        if validate:
            value = validate(value, ctx)
        # Only `retitle` sets this, and only a row the projection has already
        # let go of takes the branch. Everything else falls through to
        # `task_projection_row`, whose `find()` is the refusal that protects
        # the other cells.
        if off_board_repair and not _row_is_on_the_board(ctx, tid):
            return repair_off_board_cell(args, ctx, field, event, why, value,
                                         show_previous)
        pri, idx, header, values = task_projection_row(ctx, tid)
        if not terminal_ok:
            status = values.get("status", "").strip().strip("*` ").lower()
            if status in ("done", "dropped"):
                raise Refused(f"{tid} is {values.get('status', '').strip()} — "
                              f"a row that has finished has no next step")
        prev = values.get(field, "")
        if prev.strip() == value.strip():
            raise Refused(f"{tid}'s {field} is already that")
        ctx["board"].ensure_columns(pri, [canonical_column(field)])
        pri, idx, header, values = task_projection_row(ctx, tid)
        values[field] = value
        line = ctx["board"].replace_row(idx, header, values)
        # Each writer keeps the journal line it shipped with. Unifying the
        # format would have been a behaviour change wearing a refactor's
        # clothes — `next` writes the new value alone, its two siblings write
        # the transition, and a reader may be parsing either.
        jline = (f"- [{tid}] {why} · {prev or '—'} → {value}" if show_previous
                 else f"- [{tid}] {why} · {value}")
        ev = {"ts": lib.event_stamp(),
              "event": event, "id": tid, "title": values.get("title", ""),
              "track": values.get("track", "main"), "actor": args.actor,
              "from": prev, "to": value}
        plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                      jline, ev, args.dry_run)
        return {"id": tid, field: value, "row": line, **plan}
    return run


#: `next` — the most common thing a triage does, and it had no tool path until
#: TASK-041: `status` is the only other writer of that cell and it refuses a
#: no-op, so correcting a plan meant changing a status the row did not warrant.
#: It refuses a finished row: a row that has completed has no next step, and
#: writing one puts a live-looking instruction on finished work.
cmd_next = cell_writer(
    "next action", "next", "next", "next action", terminal_ok=False,
    show_previous=False,
    required_msg="--next is required: this subcommand exists to write that "
                 "cell, and clearing it would leave the row with no stated "
                 "next step")

#: `retitle` — a row filed as two pieces of work whose second half later splits
#: out carries a title describing work it will never do. Safe because the `Id`
#: is the identity and never moves: a `Commitment` cell, a linkage graph and
#: every event point at the id, and none of them reads the title. That is also
#: why there is no subcommand for changing an id.
#:
#: It is also the ONE cell writer that reaches a row the board no longer
#: carries — `off_board_repair`, TASK-166. See `repair_off_board_cell` for why
#: the row's NAME is the only cell for which that is not a contradiction, and
#: for the three guards that keep the door this narrow.
cmd_retitle = cell_writer(
    "title", "title", "retitle", "retitled", off_board_repair=True,
    required_msg="--title is required: this subcommand exists to write that "
                 "cell, and a row with no title is one nobody can find")


def cmd_summary(args, ctx) -> dict:
    """Rewrite the non-projected Task summary and no other Task field."""
    if args.clear and args.summary is not None:
        raise Refused("pass either --summary or --clear, not both")
    if not args.clear and args.summary is None:
        raise Refused("--summary is required, or pass --clear to remove it")
    record = task_record(ctx, args.id)
    previous = record.get("summary") or ""
    value = "" if args.clear else args.summary
    if previous == value:
        raise Refused(f"{args.id}'s summary is already that")
    shown = value or "—"
    jline = f"- [{args.id}] summary · {previous or '—'} → {shown}"
    event = {
        "ts": lib.event_stamp(),
        "event": "summary", "id": args.id,
        "title": record.get("title") or "",
        "track": record.get("track") or "main", "actor": args.actor,
        "field": "summary", "from": previous, "to": value,
    }
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": args.id, "summary": value, **plan}


#: `rung` — `--rung` lived only on `done`, which is after the argument matters.
#: `ADR-005` is what makes the cell load-bearing: it is a claim about who is
#: hurt when the work is wrong, and a claim nobody can correct without a hand
#: edit is one nobody corrects.
cmd_rung = cell_writer("verification", "rung", "rung", "rung",
                       validate=lambda v, ctx: check_rung(v, ctx["schema"]))

#: `evidence` — the fourth, and the one that showed the other three were a
#: pattern. A row whose `Evidence` cell was corrupted could not be repaired:
#: `done --evidence` is the only other writer and closing a row to fix a cell
#: is not a correction, it is a lie about the work.
cmd_evidence = cell_writer("evidence", "evidence", "evidence", "evidence")


def cmd_drop(args, ctx) -> dict:
    """Remove a row deliberately, with a reason, and record why.

    Missing until a review found it: `drop` was in the accepted-subcommand
    guard and absent from the dispatch table, so it raised a bare KeyError.
    Worse than the crash was the consequence — a hand-removed row leaves its
    `add` event with no row and no close, which is drift's second condition, so
    every drop done by hand permanently manufactured the exact false drift
    § 5.7 exists to prevent.

    **The row leaves the board and the stage it died in does not.** Removing
    the row is deliberate: `BOARD.md` holds open work, a dropped item is not
    open work, and every count in both queue and pipeline mode is defined over
    rows that are still there. But `modes/pipeline.md` asks the record to say
    *where* an item died — that is the whole diagnostic value of a drop in a
    staged mode, since three items dying at `review` is a fact about the review
    stage and not about the three items. That fact used to be destroyed: the
    only cell holding it went with the row, and neither the journal line nor
    the event carried it. So `Stage` is written into both surfaces that
    survive, which is where every other post-removal question is already
    answered from.
    """
    tid = args.id
    if not args.reason:
        raise Refused(
            f"{tid}: --reason is required. A row that leaves the board without "
            f"one is indistinguishable from a row that was lost")
    pri, idx, header, values = task_projection_row(ctx, tid)
    prev = values.get("status", "")
    stage = values.get("stage", "").strip()
    line = ctx["board"].remove_row(idx)
    jline = (f"- [{tid}] {prev or '—'} → dropped · "
             + (f"at stage: {stage} · " if stage else "")
             + f"reason: {args.reason}")
    event = {"ts": lib.event_stamp(), "event": "drop",
             "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"),
             # Same reason as `done`: the row is leaving and these are the last
             # place it says who held it.
             "owner": values.get("owner", ""),
             "role": values.get("role", ""),
             # Empty on a project-mode row, which has no stages at all — the
             # key is always present, because a consumer that has to branch on
             # a missing key is a consumer that will forget to.
             "stage": stage, "actor": args.actor,
             "from": prev, "to": "dropped", "reason": args.reason}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "reason": args.reason, "removed": line, **plan}


# ── TASK-167: the removal path, and what it refuses ───────────────────────


def names_id(text: str, tid: str) -> bool:
    """Does `text` cite `tid` as an id, rather than contain it as a substring?

    The boundary on the RIGHT is a hyphen too, and that is the whole reason
    this is a function. Measured on this repository's own store: **109 of 176
    `Evidence` cells contain a `TASK-nnn` token**, and essentially all of them
    are filenames — `perry/evidence/2026-08/TASK-089-v4-review-r4.md`. A
    substring test, or `\\b` alone, reads every one of those as a reference and
    makes the removal path refuse every row on the project.
    """
    return re.search(r"(?<![0-9A-Za-z_-])" + re.escape(tid)
                     + r"(?![0-9A-Za-z_-])", text or "") is not None


#: A cited path this size is not prose somebody wrote a task id into, and
#: reading it is how a refusal check becomes slower than the write it guards.
_REFERENCE_SCAN_MAX_BYTES = 1 << 20

#: The suffixes `live_references` will read a cited evidence path as prose in.
#: The same set `bin/perry-explain § walk_md` resolves ids over — see that
#: function's docstring for why a code file's mention is not a reference.
_REFERENCE_SCAN_SUFFIXES = (".md", ".markdown")


def live_references(ctx, tid: str) -> list[str]:
    """Every place a SURVIVING record or register still names `tid`.

    **What counts as live, stated, because the spec's wording would have made
    this command unrunnable.** TASK-167 asked for a refusal on "a row … an
    evidence record cites", and taken as *any document that mentions the id*
    that is a refusal nothing can ever pass: `perry-task add` writes a journal
    line naming the id it minted, so **every** row the tool has ever created is
    named by a document, forever. Measured on the three rows this command was
    built to sweep: a whole-repo grep finds `TASK-081` in
    `perry/evidence/2026-08/TASK-067-round3-v4-review.md` and all three in two
    journal files. Under "any mention", the deliverable refuses its own first
    use.

    The distinction that does hold is between a **pointer** and a **record of
    what happened**:

    - A pointer is resolved by a reader. `depends_on`, `parent` and
      `commitment` are ids Perry follows from a row that is still there;
      `next_action` is prose the contract resolves ids in
      (`conformance.next_action_cites_closed`); `krs[].tasks` in a linkage
      register and `linked` in the goals store are the registers that tie work
      to a key result. Remove the row and each of those points at nothing.
    - A record of what happened is history. The journal, `.perry/events.jsonl`
      and a review write-up describe a day on which that row existed, and they
      go on being true after it is removed — which is exactly the reading
      `.perry/events.jsonl` already gets, and why the removal is appended to it
      rather than edited out of it.

    Evidence documents are checked, on the half where they are pointers: a
    **markdown** document **cited by the `Evidence` cell of a record that
    survives this removal**, which names the id. A reader following that
    surviving row's evidence lands on a page pointing at a row Perry can no
    longer resolve — that is a broken reference and this refuses it. A document
    nothing cites is somebody's file; refusing on it would be refusing on the
    repository.

    **Markdown, not every cited file, and that was measured too.** `Evidence`
    cells cite source as often as they cite prose — `bin/perry-task` is cited
    by three records on this project — and this function's own docstring
    naming an id it had swept made the first dry run refuse itself. A code
    comment recording why a line exists is history in the same sense the
    journal is. It is also the line Perry's own id resolver already draws:
    `bin/perry-explain § harvest` walks markdown and nothing else, so an id in
    a `.py` file is not a mention `perry-diagnose` can report dangling either.

    Returns one human-readable line per reference, empty when there are none.
    """
    out: list[str] = []
    survivors = [r for r in ctx["task_records"] if r.get("id") != tid]

    for rec in survivors:
        rid = rec.get("id") or "?"
        if tid in (rec.get("depends_on") or []):
            out.append(f"{rid}.depends_on — the edge would point at an id "
                       f"nothing resolves (`perry-task depends {rid}` rewrites it)")
        for field in ("parent", "commitment"):
            if (rec.get(field) or "").strip() == tid:
                out.append(f"{rid}.{field}")
        if names_id(rec.get("next_action") or "", tid):
            out.append(f"{rid}.next_action — `{(rec.get('next_action') or '')[:60]}`")

    # `phase/*-linkage.md § krs[].tasks` — the register that ties tasks to a
    # key result. Read as the lines they are written on rather than through a
    # YAML parser, because Perry is stdlib-only and this file is markdown with
    # a YAML-shaped block in it, not a YAML document.
    for path in sorted((ctx["state_root"] / "phase").glob("*-linkage.md")):
        try:
            text = path.read_text(errors="replace")
        except OSError:
            continue
        for n, line in enumerate(text.split("\n"), 1):
            if re.match(r"\s*tasks:", line) and names_id(line, tid):
                out.append(f"{path.name}:{n} krs[].tasks")

    # The goals store's own linkage field. Empty on this project today, which
    # is a fact about this project and not about the register.
    okr = ctx["state_root"] / "okr.jsonl"
    if okr.exists():
        for line in okr.read_text(errors="replace").split("\n"):
            if not line.strip():
                continue
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(row, dict) and names_id(str(row.get("linked") or ""), tid):
                out.append(f"okr.jsonl {row.get('id') or '?'}.linked")

    seen: set[str] = set()
    for rec in survivors:
        found, _missing = evidence_paths(rec.get("evidence") or "",
                                         ctx["state_root"], ctx["project_root"])
        for rel in found:
            target = ctx["project_root"] / rel
            files = (sorted(target.rglob("*")) if target.is_dir() else [target])
            for f in files:
                if f.suffix.lower() not in _REFERENCE_SCAN_SUFFIXES \
                        or not f.is_file():
                    continue
                key = f"{rec.get('id')}\0{f}"
                if key in seen:
                    continue
                seen.add(key)
                try:
                    if f.stat().st_size > _REFERENCE_SCAN_MAX_BYTES:
                        continue
                    body = f.read_text(errors="replace")
                except OSError:
                    continue
                if names_id(body, tid):
                    out.append(f"{rel} — evidence cited by {rec.get('id')}")
    return out


def cmd_purge(args, ctx) -> dict:
    """Take a record OUT of `tasks.jsonl`. The store's only removal path.

    **Why it is not `drop`, and why the two names must not be confusable.**
    `drop` writes a *status*: it records a decision about the work — this was
    not finished and will not be — and the record stays, because that decision
    is part of the project's history. `purge` writes *nothing*: it says the
    record should not be in the store at all, which is a claim about the store
    and not about the work. Three rows titled `t`, added and dropped inside
    sixty seconds on 2026-08-18 while somebody smoke-tested the writer, are the
    case: no decision about them is worth keeping, because there was never any
    work.

    The names share no prefix, so neither completes to the other and no
    abbreviation reaches both; and they are not synonyms in English, which
    `remove`, `discard` and `delete` all are for `drop`. `remove` was rejected
    for a second reason — `cmd_drop`'s payload already carries a `removed` key,
    holding the BOARD LINE it took out, so a `remove` subcommand beside it
    would put one word on two different objects.

    **What it refuses.** Four things, in this order, and each says which:

    1. No `--reason`. Same rule as `drop`, harder: this is a destructive write
       to the user's own state and the reason is the only prose that survives
       it in the canonical half of the transaction.
    2. A row that is not `done` or `dropped`. Removing an open row would leave
       its `add` event with no row and no close — which is precisely
       `perry-state § reconcile_drift`'s `orphaned` condition — so a purge of
       live work would MANUFACTURE the false drift that `drop` exists to
       prevent. Open work gets dropped, then purged, in that order.
    3. A row the projection still carries a line for. It should not, once
       terminal, and if it does then `BOARD.md` is stale — removing the record
       under a stale board would leave a line rendering from nothing.
    4. Any live reference. `live_references` above is where "live" is defined
       and measured; the refusal names the first one and counts the rest.

    **What it does to `order`: nothing, and that is the answer rather than an
    omission.** `order` records authored position within a board section
    (`perry_store § STORED`). A row that has closed is in no section — and
    `commit()` has already done the renumbering, at close time: `done` and
    `drop` decrement every peer that sat below the row and then set the row's
    own `order` to `null`. So every record this command can reach carries
    `order: null` (all three sweep targets do, though TASK-167's spec says two
    of the three), there is no position to vacate, and re-running the
    decrement here would shift peers a second time for one close. A record
    that somehow carries a non-null `order` is a store `perry-task` did not
    write, and guessing a renumbering for it means guessing at a board this
    command cannot see.

    **Whether it is reversible: the record is, by hand, from the log.** The
    `purge` event carries the removed record VERBATIM under `record`, so
    `json.loads(...)["record"]` is the line that was in `tasks.jsonl`, ready to
    be appended back. There is no `unpurge`, deliberately: restoring a record
    is rare enough that a tool for it would be a second, less-tested writer,
    and the log is where a restore should be read from anyway. What is NOT
    reversible is the id — `mint_id` reads the log, the `add` event is still
    in it, and a purged number is never handed out again. That is the property
    that makes this safe to do to a store other tools resolve ids against.
    """
    tid = args.id
    if not args.reason:
        raise Refused(
            f"{tid}: --reason is required. `purge` deletes a record from "
            f"{perry_store.store_path(ctx['state_root'])}; a removal with no "
            f"stated reason is indistinguishable from a store that was "
            f"corrupted")
    record = task_record(ctx, tid)
    status = (record.get("status") or "").strip().lower()
    if status not in ("done", "dropped"):
        raise Refused(
            f"{tid} is {status or 'unset'}, not done or dropped. `purge` "
            f"removes the record, and removing an OPEN row leaves its `add` "
            f"event with no row and no close — the `orphaned` drift "
            f"`perry-state` reports. Close it first: `perry-task drop {tid} "
            f"--reason \"…\"` records the decision, and this removes the "
            f"record afterwards if it should not be kept")
    if _row_is_on_the_board(ctx, tid):
        raise Refused(
            f"{tid} is {status} in the store and still has a line on "
            f"{ctx['board'].path.name}. The projection is stale, and removing "
            f"the record under it would leave a row rendering from nothing: "
            f"run `perry-tasks render --write` and retry")
    refs = live_references(ctx, tid)
    if refs:
        more = (f" (and {len(refs) - 1} more: {', '.join(refs[1:4])})"
                if len(refs) > 1 else "")
        raise Refused(
            f"{tid} is named by {refs[0]}{more}. Removing the record would "
            f"leave that reference pointing at an id nothing resolves. Clear "
            f"the reference first, or leave the row in the store — `dropped` "
            f"is a legitimate resting state and `purge` is for records that "
            f"should never have existed")

    jline = (f"- [{tid}] {status} → purged from the store · "
             f"reason: {args.reason}")
    event = {"ts": lib.event_stamp(), "event": "purge", "id": tid,
             "title": record.get("title") or "",
             "track": record.get("track") or "main",
             # Same reason as `done` and `drop`: this is the last place the
             # row says who held it.
             "owner": record.get("owner") or "",
             "role": record.get("role") or "",
             "actor": args.actor,
             # `to` is `""`, not a new state: there is no destination status
             # because there is no longer a record. See `EVENT_FIELD`.
             "from": record.get("status") or "", "to": "",
             "reason": args.reason,
             # **The reconstruction.** The whole record, verbatim, so the line
             # that left `tasks.jsonl` can be read back out of the log.
             "record": dict(record)}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run, removed_id=tid)
    return {"id": tid, "reason": args.reason, "record": dict(record), **plan}


def cmd_resolve_intake(args, ctx) -> dict:
    """Discharge an intake row without routing it — dropped or deferred.

    `triage` mandates that every intake row leave as routed, dropped-with-a-
    reason, or deferred-with-a-named-condition. Only the first had a tool, so
    two of three outcomes were still hand-written and invisible to every count
    and to drift detection.
    """
    if not args.reason:
        raise Refused("--reason carries the drop reason or the defer condition")
    rows = ctx["board"].section_rows("Intake")
    try:
        n = int(args.id or "0")
    except ValueError:
        raise Refused("resolve-intake takes the intake row number")
    if not 1 <= n <= len(rows):
        raise Refused(f"intake row {n} does not exist (there are {len(rows)})")
    idx, cells = rows[n - 1]
    sep, header = ctx["board"].section_table("Intake")
    keys = [norm(h) for h in header]
    intake = dict(zip(keys, cells))
    check_intake_undischarged(intake, str(n))
    outcome = args.outcome or "dropped"
    if outcome not in ("dropped", "deferred"):
        raise Refused("--outcome is `dropped` or `deferred`; routing uses `route`")
    text = f"{outcome} {date.today():%Y-%m-%d} — {args.reason}"
    if not args.dry_run:
        ctx["board"].lines[idx] = render_row(
            [intake.get(k, "") if k != "outcome" else text for k in keys])
    jline = f"- [intake] {intake.get('request', '')[:48]} → {text}"
    event = {"ts": lib.event_stamp(),
             "event": "resolve-intake", "id": "",
             "title": intake.get("request", ""),
             "arrived": intake.get("arrived", ""), "actor": args.actor,
             "from": "intake", "to": outcome, "reason": args.reason}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"outcome": outcome, **plan}


def cmd_intake(args, ctx) -> dict:
    """Record an unrouted external request, creating `## Intake` if absent."""
    if not args.title:
        raise Refused("--title is the request text")
    arrived = args.arrived or f"{date.today():%Y-%m-%d}"
    # Same as `add`: the real path runs either way; only `commit()` is skipped.
    ctx["board"].ensure_section("Intake", ["Arrived", "Request", "Outcome"])
    line = ctx["board"].append_section_row(
        "Intake", {"arrived": arrived, "request": args.title, "outcome": "—"})
    jline = f"- [intake] arrived {arrived} · {args.title}"
    event = {"ts": lib.event_stamp(), "event": "intake",
             "id": "", "title": args.title, "arrived": arrived,
             "actor": args.actor, "from": None, "to": "intake"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"arrived": arrived, "row": line, **plan}


USER_ID_RE = re.compile(r"\bUSER-(\d+)\b")


def mint_user_id(board: Board, events: list[dict], state_root: Path) -> str:
    """Next `USER-NNN` from max(board ∪ journal ∪ events), like `mint_id`."""
    seen = {int(m) for m in USER_ID_RE.findall(board.text())}
    seen |= {int(m) for e in events for m in USER_ID_RE.findall(e.get("id", ""))}
    for p in sorted((state_root / "journal").rglob("*.md")):
        try:
            seen |= {int(m) for m in USER_ID_RE.findall(p.read_text(errors="replace"))}
        except OSError:
            continue
    return f"USER-{max(seen, default=0) + 1:03d}"


def cmd_ask(args, ctx) -> dict:
    """Put a question to the user and start its clock.

    `## User Input Queue` had no writer, and the cost was measurable rather
    than theoretical: **both rows on Perry's own board carried `Idle: —`** —
    the one field the queue exists for, unfilled, because a human had to type
    a number that is wrong the next morning.

    So the tool stamps `Asked`, a date, and the age is computed at read time.
    `Idle` stays readable on boards that have it and is no longer required by
    the schema: a stored age is stale the moment it is written, and a real
    project had already dropped the column for exactly that reason.
    """
    if not args.needed:
        raise Refused(
            "--needed is required: it is the question, and a queue row that "
            "does not say what is being asked cannot be answered by anyone")
    sr = ctx["state_root"]
    uid = mint_user_id(ctx["board"], ctx["events"], sr)
    asked = args.arrived or f"{date.today():%Y-%m-%d}"

    ctx["board"].ensure_section(
        "User Input Queue", ["USER-id", "Needed from user", "Blocks", "Asked", "Status"],
        before_p0=False)
    ctx["board"].ensure_section_columns("User Input Queue", ["Asked"])
    line = ctx["board"].append_section_row("User Input Queue", {
        "user-id": uid, "needed from user": args.needed,
        "blocks": args.blocks or "—", "asked": asked, "status": "pending"})
    jline = f"- [{uid}] — → pending · {args.needed}" + (
        f" · blocks: {args.blocks}" if args.blocks else "")
    event = {"ts": lib.event_stamp(), "event": "ask",
             "id": uid, "title": args.needed, "asked": asked,
             "blocks": args.blocks or "", "actor": args.actor,
             "from": None, "to": "pending"}
    plan = commit(ctx["project_root"], sr, ctx["board"], jline, event, args.dry_run)
    return {"id": uid, "asked": asked, "row": line, **plan}


def cmd_answer(args, ctx) -> dict:
    """Record the user's answer, with the date they gave it."""
    if not args.answer:
        raise Refused(
            "--answer is required. Flipping the status without recording what "
            "was decided leaves the row closed and the decision nowhere")
    idx, header, cells = ctx["board"].find_section_row("User Input Queue", args.id)
    keys = [norm(h) for h in header]
    values = dict(zip(keys, cells))
    today = f"{date.today():%Y-%m-%d}"
    prev = values.get("status", "")
    if prev.strip().lower().startswith("answered"):
        raise Refused(f"{args.id} is already answered: {prev.strip()[:60]}")
    values["status"] = f"answered {today}: {args.answer}"
    ctx["board"].lines[idx] = render_row([values.get(k, "") for k in keys])
    jline = f"- [{args.id}] pending → answered · {args.answer}"
    event = {"ts": lib.event_stamp(), "event": "answer",
             "id": args.id, "title": values.get("needed from user", ""),
             "answer": args.answer, "actor": args.actor,
             "from": "pending", "to": "answered"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": args.id, "answered": today, **plan}


CAD_ID_RE = re.compile(r"\bCAD(?:ENCE)?-(\d+)\b")

# The section's own columns. `Last run` is new and optional: it is the INPUT
# `Next due` is computed from, and without it the due date is an assertion with
# nothing on the board to check it against. `Last evidence` moved the other way
# — from required to optional — because a real register does not have it and
# was carrying a `table-columns` lint error for being right, exactly as `Idle`
# was before TASK-039.
CADENCE_COLUMNS = ["ID", "Recurring task", "Owner", "Frequency",
                   "Last run", "Next due", "Last evidence"]

FREQ_HELP = ("a period — `daily`, `weekly`, `biweekly`, `monthly`, `quarterly`, "
             "`yearly`, or `Nd`/`Nw`/`Nm` (`14d`, `every 3 weeks`) — or one of "
             "the aperiodic words a real register already uses "
             "(`continuous`, `hourly`, `ad hoc`, `on demand`), which record a "
             "recurrence with no computable due date")


def mint_cadence_id(board: Board, events: list[dict], state_root: Path) -> str:
    """Next `CAD-NNN` from max(board ∪ journal ∪ events), like `mint_id`.

    It counts `CADENCE-NNN` as well as `CAD-NNN`. That is not hypothetical
    tidiness: a live register numbers its rows `CADENCE-000`, `CADENCE-002`,
    `CADENCE-003`, and a minter blind to that prefix would hand out `CAD-001`
    beside `CADENCE-002` and then `CAD-004` later — two numbering schemes in
    one five-row table, with `CAD-002` and `CADENCE-002` both live and neither
    obviously the other's neighbour. Reading both and minting one keeps the
    sequence continuous on a board that already has a history.

    Rows whose id carries no number at all (`CADENCE-NIGHTLY-RESEARCH`, also
    live) are simply not part of the sequence — they cannot collide with a
    number, so nothing needs to be done about them.
    """
    seen = {int(m) for m in CAD_ID_RE.findall(board.text())}
    seen |= {int(m) for e in events for m in CAD_ID_RE.findall(e.get("id", ""))}
    for p in sorted((state_root / "journal").rglob("*.md")):
        try:
            seen |= {int(m) for m in CAD_ID_RE.findall(p.read_text(errors="replace"))}
        except OSError:
            continue
    return f"CAD-{max(seen, default=0) + 1:03d}"


def check_frequency(freq: str, hint: str = "") -> tuple[str, int, str]:
    parsed = P.parse_frequency(freq)
    if parsed is None:
        raise Refused(
            f"frequency {freq!r} cannot be scheduled from. Give {FREQ_HELP}. "
            f"A frequency this tool cannot read would produce a `Next due` that "
            f"is confidently wrong, which is worse than refusing to stamp one"
            + (f". {hint}" if hint else ""))
    return parsed


def parse_on(value: str | None, label: str) -> date | None:
    if not value:
        return None
    try:
        return datetime.strptime(value.strip(), "%Y-%m-%d").date()
    except ValueError:
        raise Refused(f"--on must be YYYY-MM-DD ({label}); got {value!r}")


def stamp_due(run: date | None, freq: str) -> str:
    """The `Next due` cell for a ritual with this frequency.

    `n/a` for an aperiodic one, matching what a live register already writes in
    that cell rather than introducing a second spelling for the same idea.
    """
    due = P.next_due_after(run or date.today(), freq)
    return f"{due:%Y-%m-%d}" if due else "n/a"


def cmd_cadence_add(args, ctx) -> dict:
    """Register a recurring ritual, and stamp the first `Next due`.

    `BOARD.md § Cadence` is the register `modes/queue.md` builds its highest-
    value triage question on ("what recurs?"), `work/reference/subcommands.md`
    tells triage to surface rows past their `Next due`, and
    `perry-state --json` reported a count of them. Three readers, no writer:
    every row, every id and every due date was typed by hand.

    `Next due` is the cell that made that expensive. It is COMPUTED — frequency
    plus the last run — so a human had to redo the arithmetic after every
    single occurrence, and a register nobody re-dates is a register that reports
    everything as either permanently overdue or permanently fine. Both of those
    were live: one project's rows read `2026-W32` and `**2026-08-31**` with a
    parenthetical explaining which occurrences had been skipped, which is what
    a human keeping a computed cell by hand actually produces.

    So the tool owns the id, the frequency, the dates and the arithmetic. The
    prose — what the ritual is — stays the agent's, exactly as `ask` splits it.
    """
    if not args.title:
        raise Refused("--title is required: it is what recurs")
    if not args.frequency:
        raise Refused(f"--frequency is required. Give {FREQ_HELP}")
    kind, _, _ = check_frequency(args.frequency)
    sr = ctx["state_root"]
    # A registration is not a run. `--on` is for a ritual that already has a
    # history — "it last ran on this date" — and when it is absent `Last run`
    # stays empty rather than being stamped with today, because stamping it
    # would assert an occurrence that did not happen and make the very first
    # `Next due` unverifiable in the same stroke.
    ran = parse_on(args.on, "the date the ritual last ran")
    cid = mint_cadence_id(ctx["board"], ctx["events"], sr)
    due = stamp_due(ran, args.frequency)

    ctx["board"].ensure_section("Cadence", CADENCE_COLUMNS, before_p0=False)
    ctx["board"].ensure_section_columns(
        "Cadence", ["Frequency", "Next due", "Last run"])
    line = ctx["board"].append_section_row("Cadence", {
        "id": cid, "recurring task": args.title, "title": args.title,
        "owner": args.owner or "Coding Agent",
        "frequency": args.frequency,
        "last run": f"{ran:%Y-%m-%d}" if ran else "—",
        "next due": due,
        "last evidence": "—", "evidence": "—"})
    jline = (f"- [{cid}] — → registered · {args.title} · "
             f"frequency: {args.frequency} · next due {due}")
    event = {"ts": lib.event_stamp(),
             "event": "cadence-add", "id": cid, "title": args.title,
             "frequency": args.frequency, "kind": kind,
             "last_run": f"{ran:%Y-%m-%d}" if ran else "",
             "next_due": due, "actor": args.actor,
             "from": None, "to": "registered"}
    plan = commit(ctx["project_root"], sr, ctx["board"], jline, event, args.dry_run)
    return {"id": cid, "next_due": due, "row": line, **plan}


def cmd_cadence_done(args, ctx) -> dict:
    """Record one occurrence, and RECOMPUTE `Next due` in the same write.

    This is the half that makes the register self-maintaining. `done` on a task
    removes a row; a ritual has no such end — the only thing that changes is
    that its clock restarts. So the run is stamped into `Last run`, the
    evidence into `Last evidence`, and `Next due` is derived from the row's own
    `Frequency` rather than from anything the caller asserts.

    `--evidence` is required for the same reason `done` requires it: a claim
    that the month-end close ran, citing nothing, is a claim about confidence.
    """
    cid = args.id
    if not cid:
        raise Refused("cadence-done takes the row's id: perry-task cadence-done "
                      "CAD-001 --evidence <path>")
    if not args.evidence:
        raise Refused(
            f"{cid}: --evidence is required. A recurring task that reports "
            f"itself run, citing nothing, is exactly the ritual nobody notices "
            f"has stopped happening")
    idx, header, cells = ctx["board"].find_section_row("Cadence", cid)
    keys = [norm(h) for h in header]
    values = dict(zip(keys, cells))
    # By NAME. The register has at least two live column counts and a third
    # appears the moment `Last run` is added, so the frequency is not at a
    # fixed offset on any board this will ever run against.
    freq = (args.frequency or values.get("frequency", "")).strip()
    if not freq:
        raise Refused(
            f"{cid} has no readable `Frequency` cell, so `Next due` cannot be "
            f"recomputed. Pass --frequency to set it in this same write")
    # A row whose `Frequency` is prose the tool cannot read blocks the run from
    # being recorded, which is why the refusal names the way through: the same
    # write can set the frequency. Refusing without that would trade one lost
    # record for another.
    check_frequency(freq, f"Pass --frequency to correct {cid}'s cell in this "
                          f"same write")
    ran = parse_on(args.on, "the date the run happened") or date.today()
    due = stamp_due(ran, freq)

    ctx["board"].ensure_section_columns("Cadence", ["Last run", "Next due"])
    _, header = ctx["board"].section_table("Cadence")
    keys = [norm(h) for h in header]
    prev_due = values.get("next due", "")
    values["frequency"] = freq
    values["last run"] = f"{ran:%Y-%m-%d}"
    values["next due"] = due
    # `Last evidence` is optional in the schema because a live register does
    # not have it. So the column is resolved, then created if the board has
    # neither spelling — never dropped. A path silently discarded here is the
    # `--commitment` defect again, and what it would lose is the only artifact
    # proving the run happened.
    ev_key = next((k for k in ("last evidence", "evidence") if k in keys), None)
    if ev_key is None:
        header = ctx["board"].ensure_section_columns("Cadence", ["Last evidence"])
        keys = [norm(h) for h in header]
        ev_key = "last evidence"
    values[ev_key] = args.evidence
    ctx["board"].lines[idx] = render_row([values.get(k, "") for k in keys])

    jline = (f"- [{cid}] ran {ran:%Y-%m-%d} · {values.get('recurring task', '')} · "
             f"evidence: `{args.evidence}` · next due {due}")
    event = {"ts": lib.event_stamp(),
             "event": "cadence-done", "id": cid,
             "title": values.get("recurring task", ""), "frequency": freq,
             "last_run": f"{ran:%Y-%m-%d}", "next_due": due,
             "previous_due": prev_due, "evidence": args.evidence,
             "actor": args.actor, "from": "due", "to": "ran"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": cid, "last_run": f"{ran:%Y-%m-%d}", "next_due": due, **plan}
RISK_ID_RE = re.compile(r"\bRX-(\d+)\b")

# ── the risks register: this file ASKS, it does not answer ────────────────
#
# **TASK-040, ADR-007 applied to `## Top risks`.** Four of the five names below
# used to be definitions here, and each had a counterpart in
# `viewer/parsers.py` that was supposed to say the same thing. Twice they did
# not, and both times every exit closed at once: on `| ID | **Risk** | … |`
# this file said "risk table" and the reader said "not one", so `risk-add`
# wrote rows, `perry-state` reported 0 risks, `perry-lint` was clean and
# `risk-migrate` said "already migrated"; and on `1. a risk` this file saw a
# bullet the reader did not.
#
# They are BINDINGS now, not copies. `viewer/parsers.py` holds the rule because
# it is the bottom of the import graph — this file, `bin/perry-lint`,
# `bin/perry-state` and `bin/perry_store.py` all import it already — and
# `tests/test_risks_store.py` asserts these are the same objects rather than
# two functions that happen to agree on a corpus.
RISK_COLUMNS = P.RISK_COLUMNS
is_risk_header = P.is_risk_register_header
_RISK_PLACEHOLDER = P._RE_RISK_PLACEHOLDER
_RISK_BULLET = P._RE_RISK_BULLET


def risk_section_shape(board: Board) -> tuple[str, list[dict]]:
    """How `## Top risks` is currently written: `table` | `bullets` | `foreign`.

    `bin/perry_store.py § risk_section_shape` is the implementation — the store
    has to answer this to know which lines it renders, and the writer has to
    answer it to know whether it may write, and those are the same question.
    A section this returns `absent` for is one `has_section` already refused
    for the caller, so it collapses into `bullets` here rather than adding a
    fourth answer the three call sites would each have to handle.
    """
    shape, tables = perry_store.risk_section_shape(board, _ops())
    return ("bullets" if shape == "absent" else shape), tables


def refuse_foreign_risk_table(tables: list[dict]) -> None:
    if len(tables) > 1:
        raise Refused(
            "`## Top risks` holds more than one table, and this tool writes "
            "into a section's first one — so a row would land in the wrong "
            "table. Nothing was written. Move the other table under its own "
            "heading, then run this again")
    raise Refused(
        f"`## Top risks` holds a table with no `Risk` column "
        f"({tables[0]['header']}), so "
        f"it is not a risk register — a legend or a severity key reads exactly "
        f"like this. Nothing was written, and no column was added to it: "
        f"bolting the risk columns onto it would make the reader treat it as "
        f"the register and stop seeing every bullet below it. Give that table "
        f"its own `###` heading, or add a `Risk` column to it if it really is "
        f"the register")


def mint_risk_id(board: Board, events: list[dict], state_root: Path) -> str:
    """Next `RX-NNN` from max(board ∪ journal ∪ events), like `mint_id`.

    Same three sources for the same reason: a cleared risk still owns its
    number. `## Top risks` holds cleared rows rather than deleting them, so the
    board alone would nearly always be enough — but "nearly always" is how an id
    gets reissued the first time somebody prunes the section, and every journal
    line naming the old risk would then silently re-point.
    """
    seen = {int(m) for m in RISK_ID_RE.findall(board.text())}
    seen |= {int(m) for e in events for m in RISK_ID_RE.findall(e.get("id", ""))}
    for p in sorted((state_root / "journal").rglob("*.md")):
        try:
            seen |= {int(m) for m in RISK_ID_RE.findall(p.read_text(errors="replace"))}
        except OSError:
            continue
    return f"RX-{max(seen, default=0) + 1:03d}"


def risk_bullets(board: Board) -> list[tuple[int, str]]:
    """(line index, bullet text) for every risk bullet, placeholders excluded.

    What counts as a bullet and what counts as a placeholder is
    `parsers.risk_bullet_text`, which the reader calls too. This function only
    supplies the lines and keeps their indices, which the reader has no use for
    and the writer cannot do without.
    """
    start, end = board.named_section("Top risks")
    out = []
    for i in range(start + 1, end):
        text = P.risk_bullet_text(board.lines[i])
        if text:
            out.append((i, text))
    return out


def ensure_risk_table(board: Board, events: list[dict],
                      state_root: Path) -> list[dict]:
    """Put `## Top risks` into its table form, carrying any bullets across.

    Four states, four answers:

    - **no section** — create it, with the table. Same as `ensure_section`
      does for `## Intake`.
    - **a risk table already** — add any column it lacks, and touch nothing
      else. "A risk table" means a table with a `Risk` column, which is the
      reader's test (`is_risk_header`) and not "any table": deciding this with
      `section_table()` alone bolted the four risk columns onto a legend and
      left the live bullets below it invisible, because the legend then had a
      `Risk` header and the reader prefers the table.
    - **a table that is not a risk table** — refuse. See
      `refuse_foreign_risk_table`.
    - **a bullet list** — convert it.

    The conversion is what `risk-migrate` exists to ask for. It does not happen
    on the way to some other write: *appending a table above the bullets* would
    leave the board holding both, and since the reader prefers the table, every
    existing risk would vanish from every count while still sitting in the
    file — but rewriting a project's section as a side effect of `risk-add` is
    the Anti-Goal at `perry/OKR.md:37` ("no automatic rewrite of a project's
    existing structure. Adoption proposes; the user declares"), which
    `Board.append_row` cites 1,300 lines above to refuse a *smaller* rewrite.
    So the caller asks first, and this function does exactly what it is told.

    **What the conversion may and may not invent.** The bullet's text is copied
    into `Risk` byte-for-byte — it is the human's sentence and this function has
    no opinion about it. `Opened` is left **EMPTY**, because the date a
    pre-existing risk was raised is genuinely not recorded anywhere and stamping
    today would assert that a nine-month-old risk is new. An empty `Opened`
    reads back as `age_days: null`, which is already the honest answer for a
    bullet and stays honest here.

    `Status` is the one derived cell, and it is derived from the reader's OWN
    two markers and nothing else: a bullet is migrated as `cleared` exactly when
    `~~strikethrough~~` or `**RESOLVED` made the old parser call it resolved.
    So the conversion is verdict-preserving — the set of (statement, resolved)
    pairs is identical either side of it — which is a property a test can check
    rather than a claim a reviewer has to believe. Any date the human wrote into
    a cleared bullet is carried onto the cell; when they wrote none, the cell
    says `cleared` with no date rather than today's, for the same reason
    `Opened` stays blank.
    """
    if not board.has_section("Top risks"):
        board.ensure_section("Top risks", RISK_COLUMNS, before_p0=False)
        return []
    shape, tables = risk_section_shape(board)
    if shape == "table":
        board.ensure_section_columns("Top risks", RISK_COLUMNS)
        return []
    if shape == "foreign":
        refuse_foreign_risk_table(tables)

    bullets = risk_bullets(board)
    start, end = board.named_section("Top risks")
    try:
        lang = header_language(board.table("P0")[2])
    except Refused:
        lang = "en"
    header = [display_name(c, lang) for c in RISK_COLUMNS]

    base = int(mint_risk_id(board, events, state_root).split("-")[1])
    migrated, rows = [], []
    for n, (_, text) in enumerate(bullets):
        rid = f"RX-{base + n:03d}"
        resolved = text.startswith("~~") or bool(re.search(r"\*\*RESOLVED", text))
        status = "open"
        if resolved:
            d = re.search(r"\d{4}-\d{2}-\d{2}", text)
            status = f"cleared {d.group(0)}" if d else "cleared"
        rows.append(render_row([rid, text, "", status]))
        migrated.append({"id": rid, "risk": text, "status": status})

    block = [render_row(header),
             "|" + "|".join(["---"] * len(header)) + "|"] + rows
    # Replace the whole body of the section, preserving the heading line and
    # any prose the project keeps under it. Only the bullet lines go.
    keep = [l for i, l in enumerate(board.lines[start + 1:end], start + 1)
            if not _RISK_BULLET.match(l.strip())]
    while keep and not keep[0].strip():
        keep.pop(0)
    while keep and not keep[-1].strip():
        keep.pop()
    body = ([""] + keep if keep else []) + [""] + block + [""]
    board.lines[start + 1:end] = body
    return migrated


def require_migrated(board: Board) -> None:
    """Refuse to write a risk row into a section that has not migrated.

    **Consent, not disclosure.** `risk-add` used to convert the whole section
    on the way past — 9 bullets rewritten as 9 rows on a copy of a real board,
    exit 0, and the human-readable line said only `wrote RX-010 (risk-add)`.
    The rubric names automatic conversion as a defect, and `perry/OKR.md:37`
    names it an Anti-Goal: *"No automatic rewrite of a project's existing
    structure. Adoption proposes; the user declares."*

    So the refusal carries the two things a user needs to declare: **how many
    of their lines it would rewrite**, and **the command that does it**. A
    warning after the fact would be disclosure; this is the ask.

    A section with nothing in it to convert is not asked about — there is no
    consent to collect for creating a table out of an empty section or out of
    the `- (no active risks)` placeholder that `BOARD_TEMPLATE.md` ships. The
    thing being protected is the user's own writing, and there is none.
    """
    if not board.has_section("Top risks"):
        return
    shape, tables = risk_section_shape(board)
    if shape == "table":
        return
    if shape == "foreign":
        refuse_foreign_risk_table(tables)
    bullets = risk_bullets(board)
    if not bullets:
        return
    raise Refused(
        f"`## Top risks` is still a bullet list: {len(bullets)} risk(s) would "
        f"have to be rewritten as table rows before a row can be added, and "
        f"this tool does not rewrite a section you wrote without being asked. "
        f"Nothing was written. Run `perry-task risk-migrate` to convert them "
        f"(every bullet crosses verbatim; `risk-migrate --dry-run --json` "
        f"shows exactly what it would write), then run this again")


def cmd_risk_migrate(args, ctx) -> dict:
    """Convert `## Top risks` from bullets to the table, and nothing else.

    **Why a subcommand and not a `risk-add --migrate` flag.** Three reasons,
    in the order they decided it:

    - A flag makes you invent a risk in order to convert a section. On the
      real board this was measured against — 9 bullets, nothing new to
      say — `risk-add --migrate --title …` demands a tenth risk as the price
      of migrating the other nine.
    - The conversion is a fact about the project, and the event log is where
      facts about the project go. As a flag it was a `migrated: [...]` field
      hanging off a `risk-add` event, so the record that a project converted
      its risk register was attached to an unrelated new risk, and the journal
      line for the conversion was that risk's line.
    - It is reversible-by-inspection before it runs: `--dry-run --json`
      returns every row it would write, which is a preview a flag on another
      command cannot offer without also previewing that command's write.

    It joins `SECTION_EVENTS`, with `intake-sweep` — the other subcommand that
    acts on a section rather than on a row.
    """
    board = ctx["board"]
    if not board.has_section("Top risks"):
        raise Refused(
            "BOARD.md has no `## Top risks` section, so there is nothing to "
            "migrate. `perry-task risk-add` creates the section and its table")
    shape, tables = risk_section_shape(board)
    if shape == "foreign":
        refuse_foreign_risk_table(tables)
    if shape == "table":
        rows = len(board.section_rows("Top risks"))
        raise Refused(
            f"`## Top risks` is already a table ({rows} row(s)) — nothing to "
            f"migrate, and this command will not touch a row that has an id. "
            f"`perry-task risk-add` adds one; `risk-clear` retires one")
    if not risk_bullets(board):
        raise Refused(
            "`## Top risks` holds no risk bullets to migrate — only prose, or "
            "the `(no active risks)` placeholder. `perry-task risk-add` writes "
            "the table on its own when there is nothing of yours to convert")

    migrated = ensure_risk_table(board, ctx["events"], ctx["state_root"])
    ids = [m["id"] for m in migrated]
    jline = (f"- [risks] {len(migrated)} bullet(s) → table rows "
             f"({ids[0]}–{ids[-1]}) · `## Top risks` migrated")
    event = {"ts": lib.event_stamp(),
             "event": "risk-migrate", "id": "", "title": "",
             "count": len(migrated), "migrated": ids, "actor": args.actor,
             "from": "bullets", "to": "table"}
    plan = commit(ctx["project_root"], ctx["state_root"], board,
                  jline, event, args.dry_run)
    return {"migrated": migrated, "count": len(migrated), **plan}


def cmd_risk_add(args, ctx) -> dict:
    """Raise a risk: the tool mints the id and stamps the date.

    `## Top risks` was a bullet list with no writer, and it carried the two
    defects that shape always carries. **A cleared risk stayed live forever**:
    the only way to retire one was `~~strikethrough~~`, which is decoration, so
    a risk cleared on Perry's own board the day before was still one of the four
    that `perry-state` reported. And **the reader invented ids out of prose** —
    with no id column it split the first sentence on whitespace and published
    `id: "Perry"`, `title: "is half-adopted: …"`, a handle that names nothing
    and cannot be passed back to anything.

    Neither is fixable by writing the bullets more carefully. An id has to be
    minted against the ones already issued, and a status has to be a cell
    something can read — both are properties of a writer, not of a convention.
    """
    if not args.title:
        raise Refused(
            "--title is required: it is the risk statement, in your words. A "
            "risk row with no sentence in it is an id and a date")
    sr = ctx["state_root"]
    # The gate, before anything is minted: on a section this tool did not
    # write, `risk-add` asks rather than converts. `migrated` is therefore
    # always empty here and is no longer a field of this command's payload or
    # of its event — the conversion has its own subcommand, its own journal
    # line and its own event, and a `migrated: []` on every risk-add was a
    # field that only ever described something another command does.
    require_migrated(ctx["board"])
    ensure_risk_table(ctx["board"], ctx["events"], sr)
    rid = mint_risk_id(ctx["board"], ctx["events"], sr)
    opened = args.opened or f"{date.today():%Y-%m-%d}"
    line = ctx["board"].append_section_row("Top risks", {
        "id": rid, "risk": args.title, "opened": opened, "status": "open"})
    jline = f"- [{rid}] — → open · {args.title}"
    event = {"ts": lib.event_stamp(),
             "event": "risk-add", "id": rid, "title": args.title,
             "opened": opened, "actor": args.actor,
             "from": None, "to": "open"}
    plan = commit(ctx["project_root"], sr, ctx["board"], jline, event, args.dry_run)
    return {"id": rid, "opened": opened, "row": line, **plan}


def cmd_risk_clear(args, ctx) -> dict:
    """Retire a risk, with the reason and the date it stopped being one.

    The cleared row STAYS on the board. A risk that was real and is now over is
    the most useful thing in this section — it is the record that the mitigation
    worked — and deleting it would leave the same hole the strikethrough was
    trying to fill. It simply stops counting.
    """
    if not args.reason:
        raise Refused(
            f"{args.id}: --reason is required. A risk that leaves the live set "
            f"without one is indistinguishable from a risk everyone got tired of")
    try:
        idx, header, cells = ctx["board"].find_section_row("Top risks", args.id)
    except Refused as exc:
        if "has no table" in str(exc):
            raise Refused(
                "`## Top risks` is still a bullet list, so nothing in it has an "
                "id to clear. `perry-task risk-migrate` converts the section "
                "(every bullet crosses verbatim), after which the rows have "
                "ids") from None
        raise
    keys = [norm(h) for h in header]
    values = dict(zip(keys, cells))
    prev = (values.get("status", "") or "").strip()
    # `P.status_is_cleared`, not a local regex. This site had its own
    # `^(?:cleared|resolved|closed)\b` — three of the eight words the reader
    # knows — so a risk a human had retired as `mitigated` or `已缓解` read as
    # live here and as cleared everywhere else, and clearing it a second time
    # overwrote the first clear's date and its reason.
    if P.status_is_cleared(prev):
        raise Refused(f"{args.id} is already cleared: {prev[:60]}")
    today = f"{date.today():%Y-%m-%d}"
    values["status"] = f"cleared {today} — {args.reason}"
    ctx["board"].lines[idx] = render_row([values.get(k, "") for k in keys])
    jline = f"- [{args.id}] open → cleared · {args.reason}"
    event = {"ts": lib.event_stamp(),
             "event": "risk-clear", "id": args.id,
             "title": values.get("risk", ""), "reason": args.reason,
             "actor": args.actor, "from": "open", "to": "cleared"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": args.id, "cleared": today, **plan}


INTAKE_UNSET = {"", "—", "-", "–", "n/a", "tbd", "pending", "none"}


def check_intake_undischarged(intake: dict, n: str) -> None:
    """An intake row takes exactly one outcome — the rule both `modes/queue.md`
    and `subcommands.md` state, and which nothing enforced.

    Re-routing a request minted a SECOND task for it and overwrote the cell, so
    the first task's provenance was destroyed and two live rows carried one
    title. Re-resolving flipped a recorded drop into a defer. Neither refused.

    It is not theoretical: discharged rows stay in intake until the review
    period closes, so the next drain walks them again.

    `answer`, `status`, `stage` and `risk-clear` all refuse a repeat
    transition. This was the fourth implementation of "already discharged" and
    the only one that did not.
    """
    outcome = (intake.get("outcome") or "").strip().strip("*` ").lower()
    if outcome and outcome not in INTAKE_UNSET:
        raise Refused(
            f"intake row {n} already has an outcome: "
            f"{intake.get('outcome', '').strip()[:60]!r}. A row takes exactly "
            f"one — re-routing would mint a second task for one request and "
            f"erase where the first went")


def cmd_intake_sweep(args, ctx) -> dict:
    """Move discharged intake rows off the board and into today's journal.

    `modes/queue.md` states the rule and explains why it matters — "without
    this rule intake only grows, and a board could overflow on a year of
    recorded drops, which would destroy the argument above: overflow is
    supposed to mean *taking on more than you discharge*, not *having
    discharged a lot*." A V4 review found the rule existed in that one file
    and **nowhere else**: no subcommand, no triage step. The one part of the
    intake lifecycle nothing implemented was the part the overflow argument
    rests on.

    Rows keep their `Outcome` verbatim in the journal, so the record of where
    a request went survives leaving the board — the same live/history split
    `BOARD.md` and `journal/` use everywhere else.
    """
    rows = ctx["board"].section_rows("Intake")
    _, header = ctx["board"].section_table("Intake")
    keys = [norm(h) for h in header]
    discharged = []
    for idx, cells in rows:
        row = dict(zip(keys, cells))
        outcome = (row.get("outcome") or "").strip()
        if outcome and outcome.strip("*` ").lower() not in INTAKE_UNSET:
            discharged.append((idx, row))
    if not discharged:
        raise Refused(
            "no discharged intake rows to sweep — every row is still waiting "
            "for an outcome, which is what triage step 0 is for")

    for idx, _ in sorted(discharged, key=lambda x: -x[0]):
        ctx["board"].lines.pop(idx)

    block = "\n".join(
        [f"### Intake swept {date.today():%Y-%m-%d}", ""] +
        [f"- **{r.get('arrived', '—')}** · {r.get('request', '')} → "
         f"{r.get('outcome', '')}" for _, r in discharged])
    jline = f"- [intake] {len(discharged)} discharged row(s) left the board"
    event = {"ts": lib.event_stamp(),
             "event": "intake-sweep", "id": "", "title": "",
             "count": len(discharged), "actor": args.actor,
             "from": "intake", "to": "journal"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run, definition=block)
    return {"swept": len(discharged),
            "rows": [r.get("request", "") for _, r in discharged], **plan}


def cmd_route(args, ctx) -> dict:
    """Move an intake row onto the board, carrying `Arrived` with it.

    Not bookkeeping: `today − Arrived` is the number every SLA check measures,
    so a routing that drops it makes queue mode's own breach check uncomputable
    and silently exempts the row from the only clock governing it.
    """
    rows = ctx["board"].section_rows("Intake")
    if not rows:
        raise Refused("`## Intake` has no rows to route")
    try:
        n = int(args.id or "0")
    except ValueError:
        raise Refused("route takes the intake row number: perry-task route 1 --track ops")
    if not 1 <= n <= len(rows):
        raise Refused(f"intake row {n} does not exist (there are {len(rows)})")
    idx, cells = rows[n - 1]
    sep, header = ctx["board"].section_table("Intake")
    keys = [norm(h) for h in header]
    intake = dict(zip(keys, cells))

    check_intake_undischarged(intake, args.id)
    track = track_of(ctx["config"], args.track or "main")
    if track["mode"] == "project":
        raise Refused(f"track {track['track']!r} is mode `project`; routing is a "
                      f"queue-mode operation (`modes/queue.md`)")
    minting = minting_records(ctx)
    prefix = resolve_prefix(minting, args.prefix)
    tid = mint_id(minting, prefix)
    # Same function `cmd_add` calls, so `--group` cannot be a flag one of them
    # reads and the other throws away. It was: the drain could not run at all
    # on a board with no `## P0`/`## P1`/`## P2`, and `check_priority`'s
    # refusal sent the user to this exact flag to fix it.
    priority, group = target_section(ctx["board"], args)
    stages = stages_of(ctx["schema"], track)
    check_stage(track, stages, args.stage)
    # Same function `cmd_add` calls, so the two cannot disagree about where a
    # row is born.
    stage = args.stage or entry_stage(track["mode"], stages)

    values = {"id": tid, "title": intake.get("request", ""),
              "owner": args.owner or "Coding Agent", "status": "not_started",
              "next action": "—", "evidence": "—",
              "track": track["track"], "stage": stage}
    # The clock each mode actually reads. A queue row is measured from
    # `Arrived`; a pipeline or inquiry row from `Stage since`. Routing gave
    # every row `Arrived` regardless, so a pipeline row arrived with no dwell
    # clock at all — and `rows_with_no_computable_age` could not report it,
    # because `arrived` was non-empty.
    #
    # `--arrived` overrides, because an intake row a human typed straight into
    # the board has no `Arrived` cell to carry. Reading it out of the row and
    # then using it unconditionally three lines later raised `KeyError:
    # 'arrived'` — a traceback rather than a refusal, on the one board shape
    # every adopting project already has.
    arrived = args.arrived or intake.get("arrived", "")
    if track["mode"] == "queue":
        if not arrived:
            raise Refused(
                f"intake row {args.id} has no arrival date, and `{track['track']}` "
                f"is a queue track whose only clock is `Arrived`. Routing it "
                f"would file a request that can never breach an SLA.\n"
                f"Supply one: --arrived YYYY-MM-DD")
        values["arrived"] = arrived
    else:
        values["stage since"] = f"{date.today():%Y-%m-%d}"
        if arrived:
            values["arrived"] = arrived
    if args.commitment:
        values["commitment"] = args.commitment
    # Widened by the same function `cmd_add` calls. This is where it mattered
    # most: `## Intake` is created by the tool and fills on a board whose own
    # `## P2` predates Perry, so the drain refused on the one project that had
    # an intake to drain. The section filled and could never be emptied, which
    # turns `triage` step 1 into a step that cannot run.
    # **The intake row is written back BEFORE the new row is appended.**
    # `idx` came from `section_rows("Intake")` and `append_row` INSERTS a line;
    # if the landing site sits above `## Intake`, every line below it shifts by
    # one and `idx` addresses its neighbour. On a board with no `## P0`/`## P1`
    # — `~/proj/gimegime-pmo`'s actual shape, and the whole reason `--group`
    # exists — `ensure_section` anchors `## Intake` at the END of the file, so
    # the landing site is ALWAYS above it and this ALWAYS fires. Measured: the
    # intake table's separator row was overwritten, the request stayed
    # undischarged, and the next `route` refused "`## Intake` has no table".
    # One drain bricked the queue, at exit 0 with no warning.
    #
    # Writing first removes the hazard rather than compensating for it: no
    # index is held across a mutation at all.
    if split_row(ctx["board"].lines[idx])[:1] != cells[:1]:
        raise Refused(
            f"intake row {n} is no longer at line {idx} — nothing was written. "
            f"`route` must write the intake row back before it appends the new "
            f"one; an index taken from `section_rows` does not survive an insert")
    ctx["board"].lines[idx] = render_row(
        [intake.get(k, "") if k != "outcome" else f"routed → {tid}" for k in keys])
    widen_target_section(ctx["board"], priority, group, values)
    line = ctx["board"].append_row(priority, values, group=group)
    jline = (f"- [{tid}] — → not_started · routed from intake "
             f"(arrived {arrived or '—'}) · track: {track['track']}")
    event = {"ts": lib.event_stamp(), "event": "route",
             "id": tid, "title": values["title"], "track": track["track"],
             "arrived": arrived, "actor": args.actor,
             "from": "intake", "to": "not_started"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    # `priority` and `group` say where the row landed. A caller that passed
    # `--group` has to be able to read back the section it named, and one that
    # passed neither has to see the default it got.
    return {"id": tid, "arrived": arrived, "row": line,
            "priority": priority, "group": group, "prefix": prefix, **plan}


def cmd_prioritize(args, ctx) -> dict:
    """Move an existing row to another priority section, or to a named group.

    **Triage's central act had no writer.** `perry-task` shipped 22
    subcommands and not one of them could change a row's priority: `add` sets
    it once at creation, and `route` — the only other thing that writes a
    priority cell — takes an *intake row number*, mints a *new* id, and refuses
    on any track in `project` mode. So the operation `triage`, `monday-plan`,
    `friday-review` and `mid-phase-review` all end in could only be performed
    by hand-editing `BOARD.md`.

    That is not a cosmetic gap. A hand edit lands with **no event**, so
    `perry-state § reconcile_drift` reports it as unrecorded drift — the exact
    failure `DESIGN-004` was written against — and `priority` is a published
    field of `perry-task/list`, which aiMark's Projects view sorts on. A
    front-end could therefore display a priority no caller could change.

    Found by trying to execute a triage verdict, not by reading the code:
    TASK-038 was judged P1 and stayed P2 because the tool could not say so.

    **The row keeps its id and every cell.** This is a move, not a re-file:
    re-adding under a new priority would mint a second id, and an id is
    permanent and never reissued. The destination is resolved by the same
    `target_section` / `widen_target_section` pair `add` and `route` use, so a
    board that files work under its own headings (`## Open — 工程线`) is
    reachable with `--group` here exactly as it is there — the alternative
    being a subcommand that works only on boards shaped like Perry's own.
    """
    tid = args.id
    if not tid:
        raise Refused("prioritize takes a task id: "
                      "perry-task prioritize TASK-001 --priority P1")
    if not (args.priority or args.group):
        raise Refused(
            f"{tid}: name where it goes — --priority P0|P1|P2, or --group "
            f"'<heading>' on a board that files work under its own headings")

    actual, idx, header, values = task_projection_row(ctx, tid)
    current = task_record(ctx, tid)
    was = current.get("group") or current.get("priority") or actual
    priority, group = target_section(ctx["board"], args)
    now = group or priority

    # A no-op that still emitted an event would put a move in the timeline that
    # did not happen, and the timeline is what `list` reports as history.
    if now == was:
        raise Refused(f"{tid} is already under `{was}` — nothing to move")

    # `idx` was computed before the widening, and `remove_row` pops by index
    # without looking at what it pops. Today that is safe because both widening
    # paths — `ensure_columns` and `ensure_section_columns` — rewrite lines in
    # place and never insert, so no index moves. That is an assumption about
    # two other functions, held across a call, protecting the one operation on
    # this board that deletes a line. It is checked rather than trusted:
    # a widener that ever grows to insert a row would otherwise silently delete
    # somebody else's task and append this one, and both boards would still
    # parse.
    #
    # (An earlier version of this comment claimed the opposite — that widening
    # after the removal would drop cells. It would not; `values` is already
    # extracted. The mutation that was supposed to prove the ordering came back
    # green, which is how the real invariant was found.)
    widen_target_section(ctx["board"], priority, group, values)
    if split_row(ctx["board"].lines[idx])[0].replace("*", "").replace(
            "~", "").strip() != tid:
        raise Refused(
            f"{tid}: the board shifted under the write — line {idx} no longer "
            f"holds this row. Nothing was written. This means a widening "
            f"function started inserting lines; `cmd_prioritize` locates the "
            f"row before widening and removes it after")
    ctx["board"].remove_row(idx)
    line = ctx["board"].append_row(priority, values, group=group)

    jline = f"- [{tid}] {was} → {now} · reprioritized"
    if args.reason:
        jline += f" · reason: {args.reason}"
    event = {"ts": lib.event_stamp(),
             "event": "prioritize", "id": tid,
             "title": values.get("title", ""),
             "track": values.get("track", "main"),
             "actor": args.actor,
             # `priority` and `group` mirror what `add` and `route` put on their
             # own events, because `cmd_list` folds a CLOSED row back together
             # from the event stream with `t["priority"] = e.get("priority") or
             # t["priority"]` — a row that left the board has no cells left to
             # read. Without these two keys the fold silently kept the `add`
             # event's value, so a closed row reported a priority its own
             # timeline said it had moved away from. Found by running the
             # lifecycle, not by reading the code: the payload said `P1` with
             # `prioritize P1 → P0` sitting in its timeline directly above.
             "priority": priority, "group": group,
             # `from`/`to` are the SECTION here, where every other event uses
             # them for the status. Nothing extra is needed to disambiguate —
             # `event: "prioritize"` already does, and the timeline carries the
             # event name. (An earlier version added a `field` key claiming to
             # be what disambiguates; it never reached the payload at all,
             # because a timeline entry keeps only ts/event/from/to/actor.)
             "field": "section", "from": was, "to": now,
             "reason": args.reason or ""}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "from": was, "to": now, "row": line,
            "priority": priority, "group": group, **plan}


def board_sections(ctx) -> dict:
    """`## Top risks`, `## User Input Queue` and board drift — the three things
    a Work surface shows that had no contract at all.

    All three are written by `perry-task` and were readable only through
    `perry-state --json`, **the one payload that carries no version**. The task
    contract named the first two out of scope and invited a `1.x` bump if a
    front-end needed them; aiMark asked, having replaced every markdown parser
    it had with these calls. `## User Input Queue` is the *needs-you* list — the
    most decision-relevant section on the board — and it was the one behind the
    unversioned tool.

    Read through `viewer/parsers.py` and `bin/perry-state`, never reimplemented
    here. Two parsers of one file is this repository's most expensive recurring
    bug, and the `## Top risks` header question alone has already been asked in
    two places that disagreed.

    A project with none of these sections gets empty lists and zeroes, which is
    the documented shape and not an error.
    """
    ps = perry_state()
    empty_drift = {"checked": False, "baseline": "", "drift": 0,
                   "unrecorded": 0, "unrecorded_sample": [],
                   "orphaned": [], "stale_done": []}
    empty = {"risks": {"items": [], "open": 0, "cleared": 0, "source": ""},
             "asks": {"items": [], "open": 0}, "drift": empty_drift}
    if ctx.get("sections") is False:
        # `store_records` asks for the stored fields and discards everything
        # else. All three of these re-parse `BOARD.md` FROM DISK, which
        # mid-write is the version being replaced — so computing them there
        # costs a second parse to produce numbers about the wrong board.
        # Only that one internal caller sets this; `list` never does, and its
        # payload is unchanged.
        return empty
    try:
        snap = P.load_snapshot(ctx["state_root"])
    except Exception:
        # A snapshot this reader cannot build must not take `tasks[]` down with
        # it. `list` is the payload a front-end polls; the sections are an
        # addition to it, not a precondition for it.
        return empty
    open_risks = snap.open_top_risks
    risk_entry = lambda r: {  # noqa: E731 — named so the note below can point at it
        # `id` is `""` on a bullet, and that is the honest answer rather than
        # the first word of somebody's sentence. It used to be the SEVERITY
        # LETTER: `- H · Apple developer agreement expired` arrived as
        # `{"id": "H", "title": "· Apple …", "severity": "watch"}` — the marker
        # became the handle, the separator stayed glued to the title, and the
        # H/M/L a human wrote survived only inside `meta`. A table row keeps
        # the `RX-NNN` that `risk-add` minted; `source` says which you have.
        "id": r.id or "",
        "title": r.title or "",
        # Two axes, because they answer different questions and folding them
        # into one is what produced `severity: "watch"` for every row on a
        # board that had written H and M. `severity` is the STANCE — what we
        # decided to do about it, read from words like `TOP RISK` and `ACCEPT`.
        # `severity_text` is the magnitude marker verbatim, `severity_rank`
        # normalizes it so the same consumer can sort.
        "severity": r.severity or "",
        "severity_text": getattr(r, "severity_text", "") or "",
        "severity_rank": getattr(r, "severity_rank", "") or "",
        "source": r.source or "",
        "opened": r.opened or "",
        # Derived at read time, like every other age in this payload. A stored
        # age is stale the morning after it is written; `null` on a bullet,
        # which carries no date at all, rather than a zero a reader would take
        # for "raised today".
        "age_days": ps.days_since(r.opened or ""),
        "status": r.status or "",
        # The date the risk stopped being live — `cleared` in the store's
        # record (`perry_store.RISK_STORED`), `cleared_on` here because that is
        # the name this payload has carried since 1.6 and renaming a live key
        # buys nothing. `""` on an open risk AND on a risk retired without a
        # date: a cleared risk whose row names no day has no cleared date, and
        # stamping today would assert a fact about the project's history that
        # nothing in its files supports.
        "cleared_on": r.cleared_on or "",
        "meta": r.meta or "",
    }
    risks = [risk_entry(r) for r in open_risks]
    # **`bin/perry-state --json § risks` carries a `cleared_items` list and this
    # payload does not**, which is deliberate and was measured rather than
    # chosen. `tests/contract_key_parity.py § place` assigns a key table to the
    # container it best describes and refuses to place one that two containers
    # fit equally well. `items[]` and `cleared_items[]` are the same eleven
    # keys, so adding the second here left the page's one risk table matching
    # both and matching neither: KR-O2.4 went from 0 to 22 in a run. The
    # instrument is right — a page with one table and two identically shaped
    # arrays genuinely does not say which it documents — and teaching it about
    # tied containers is a change to the KR's own measurement, which is not
    # this row's to make. `perry-state --json` carries no contract page and no
    # parity coverage, so the cleared risks are readable there today; this
    # surface gains them when the page can name them unambiguously.
    asks = [{
        "id": u.id or "",
        "needed": u.needed_from_user or "",
        "blocks": u.blocks or "",
        "asked": getattr(u, "asked", "") or "",
        # The cell verbatim, and the number. `idle` was a RENDERED STRING
        # (`"9d"`) and the only thing this payload carried — displayable,
        # unsortable, and empty on any board that stores `Asked` instead, which
        # made a 7-day-old blocker look like it had no age at all.
        "idle": u.idle or "",
        "idle_days": (lambda d: d if d >= 0 else None)(ps.idle_days(u)),
        "status": u.status or "",
        "priority": u.priority or "",
    } for u in snap.board.user_input_queue if not ps.answered(u)]
    return {
        "risks": {"items": risks, "open": len(risks),
                  "cleared": len(snap.top_risks) - len(open_risks),
                  "source": snap.risks_source or ""},
        "asks": {"items": asks, "open": len(asks)},
        # **`board_as_authored`, not `board`.** Every other number here is
        # store-backed now (TASK-094); drift is the one question that has to
        # be asked of the rendered document, because the document is what it
        # is checking. See `viewer/parsers.py § PMOSnapshot.board_as_authored`.
        "drift": ps.reconcile_drift(ctx["project_root"], snap.board_as_authored,
                                    ps.read_event_log(ctx["project_root"])),
    }


# ── TASK-142: the rows a process bug stranded ─────────────────────────────
#
# Three checks, each traced to an incident on this project rather than
# invented, and all three stated ONCE for the two `list` paths that report
# them. `blocked_without_dependency` and `next_action_cites_closed` were
# written out at both sites and drifted apart in nothing only because nobody
# had needed to change them yet; TASK-148 is what that costs when somebody
# does.


def live_dispatch_ids() -> set[str]:
    """Task ids that currently hold a dispatch slot, read and never written.

    `bin/perry-dispatch-limit` reserves a slot by writing
    `~/.cache/perry/in-flight/<TASK-ID>-<EXECUTOR>.json` and frees it by
    removing the file. A marker older than `PERRY_DISPATCH_STALE_TTL`
    (default 14400s) is one that script will delete on its next run — a crashed
    session's leftover — so it is NOT evidence that anything is running, and
    this applies the same TTL rather than a second one.

    **The default is 14400 because that script's is** (TASK-160, which raised
    it from 3600 after the sweep reaped a marker 72 minutes into a live run).
    The two numbers are one number with two readers, and they may not drift: a
    reader with the SHORTER TTL calls a marker dead while the writer still
    counts the slot as live, which makes `in_progress_with_no_live_run` name a
    row an agent is actively holding — and the entry's own text then tells the
    PMO to consider re-dispatching it. That is the exact failure the dispatch
    limit exists to prevent, arriving through the check that was built to catch
    it. `tests/test_stranded_rows.py § TestThresholdsAgree` reads both files
    and fails if they stop matching.

    **This reads the directory and writes nothing to it.** `perry-dispatch-limit
    list` would answer the same question, but it cleans stale markers first and
    takes the lock to do it; a `list --json` that could delete another
    session's slot is a read command with a side effect on shared state, which
    is worse than the fork it saves.

    Honest about what it cannot see: an executor that never registered leaves
    nothing here at all, so an empty answer is only half of
    `in_progress_with_no_live_run` and the idle clock is the other half. That
    is why a row is named only when BOTH say so.
    """
    try:
        ttl = int(os.environ.get("PERRY_DISPATCH_STALE_TTL") or 14400)
    except ValueError:
        ttl = 14400
    # `Path.home()` at call time, not at import: the marker directory is keyed
    # on `$HOME` and a test that sets it has to be able to.
    markers = Path.home() / ".cache" / "perry" / "in-flight"
    live: set[str] = set()
    now = time.time()
    try:
        entries = list(markers.glob("*.json"))
    except OSError:                                       # pragma: no cover
        return live
    for path in entries:
        try:
            if now - path.stat().st_mtime > ttl:
                continue
        except OSError:                                   # pragma: no cover
            continue
        # The filename is `<TASK-ID>-<EXECUTOR>`, and BOTH halves carry
        # hyphens — `TASK-142`, `claude-subagent` — so no split on `-` reads
        # it. The marker's own JSON carries `task_id`, which is the answer;
        # stripping a known executor suffix is the fallback for a marker an
        # older script wrote without one.
        tid = ""
        try:
            tid = str(json.loads(path.read_text()).get("task_id") or "")
        except (OSError, ValueError):
            tid = ""
        if not tid:
            for executor in ("codex", "claude-subagent", "opencode-subagent"):
                if path.stem.endswith(f"-{executor}"):
                    tid = path.stem[: -len(executor) - 1]
                    break
        if tid:
            live.add(tid)
    return live


def rows_with_no_computable_age(tasks: dict, *, has_event_log: bool) -> list[str]:
    """Open rows carrying no clock at all — no event, no `Stage since`, no
    `Arrived`.

    **The date cells go through `lib.is_blank_cell`, not through raw
    truthiness.** They are columns a person edits by hand, and a person writing
    "there is nothing here" writes `—`, not an empty string. Raw truthiness
    reads that dash as a date: the row has an age, the age is unreadable, and
    the finding whose entire job is to say "this row has no age" stays silent.
    Measured on a hand-edited board before this was fixed:

        Arrived `—`   perry-task: not reported   perry-state: sla_no_clock

    — one cell, two tools, two answers, and `bin/perry-state § sla_no_clock`
    was the one that was right. It reached that answer through
    `lib.is_blank_cell`, so this reads the same rule from the same place rather
    than growing a second opinion beside it. The vocabulary itself lives in
    `schema § i18n.blank_cell`; `bin/perry-task § ABSENT` is an older, smaller
    hardcoded copy of the same idea (no `?`, no `待定`, no markdown stripping)
    and is deliberately NOT what this uses.

    It stayed invisible for weeks because the writer emits `""` for a row with
    no arrival, so no board Perry wrote could show the disagreement. Only a
    hand-edited one could, and that is the fixture the test uses.

    **Empty when there is no event log at all**, and that is not an oversight:
    on such a project EVERY open row lands here by construction — 17 of 17 on
    the front-end that reported it — so the list restated `has_event_log:
    false` once per row instead of naming a finding. Contract 1.9 `semantics`
    carries that decision; it is unchanged here.

    One statement for both `list` paths, which assemble `tasks` differently and
    once carried this expression twice. The board path had it, the record path
    had it, and a fix to either alone would have left the two disagreeing about
    a dash for the same reason the two tools did.
    """
    if not has_event_log:
        return []
    return sorted(
        task["id"] for task in tasks.values()
        if task["open"] and not task["updated"]
        and lib.is_blank_cell(str(task["stage_since"] or ""))
        and lib.is_blank_cell(str(task["arrived"] or "")))


def stranded_row_findings(tasks: dict, *, has_event_log: bool, thresholds: dict,
                          live: set, now: datetime) -> dict:
    """The four `conformance` entries about a row nothing is moving.

    Takes the rows AFTER `resolve_startability` and after the event merge, so
    `blocked_stale` and `updated` are both filled in. Returns the entries; it
    mutates neither the tasks nor the caller's `conformance`, because the two
    `list` paths assemble that dict differently and only one of them should be
    deciding what goes in it.

    **`blocked_by_closed_rows` READS `tasks[].blocked_stale`.** It is the
    aggregate of that field and nothing else. The rule behind it — a row that
    says `blocked`, declares dependencies, and has none of them left open — is
    stated exactly once, in `bin/lib § resolve_startability`, under an AST
    guard (`tests/one_startable_rule.py`) that counts homes by enclosing
    function and fails on a second one. Recomputing the predicate here would be
    a third statement of one rule; the guard exists because two copies once
    lived in a single file and a per-file count called that one home.

    Why this is not `blocked_without_dependency`, which already exists and is
    computed at each call site: that one tests `not depends_on` — the list
    being **empty**, the row's blocker still in prose Perry cannot read.
    TASK-037 and TASK-045 had a NON-EMPTY list every entry of which had closed.
    The two arrays are disjoint by construction and a row in neither is one
    whose blocker is real.

    **Both idle checks are empty when there is no event log**, for the reason
    the 1.9 `semantics` entry gives about `rows_with_no_computable_age`: on a
    project that predates the writer every open row lands in them by
    construction, and an array that restates `has_event_log: false` once per
    row has named no finding. A row inside the log but with no timestamp of its
    own is skipped for the same reason and is already reported by
    `rows_with_no_computable_age`.
    """
    def idle_hours(task: dict) -> float | None:
        # **Both sides through `lib.ts_moment`, including the clock reading.**
        # `task["updated"]` is an event `ts`, and since TASK-144 the log holds
        # two shapes — 798 zoneless lines and every line after them carrying
        # its offset. Subtracting one from a bare `datetime.now()` is either a
        # `TypeError` or an eight-hour lie depending on which shape it met, and
        # deciding that here would be the second converter this row exists to
        # prevent. `now` may arrive naive or aware; the one rule reads both.
        seen = lib.ts_moment(task["updated"])
        ref = lib.ts_moment(now)
        if seen is None or ref is None:
            return None
        return (ref - seen).total_seconds() / 3600.0

    def threshold(name: str, fallback: float) -> float:
        entry = (thresholds or {}).get(name) or {}
        value = entry.get("value")
        return float(value) if isinstance(value, (int, float)) else fallback

    # **One clock unit for both idle checks**, so a consumer needs one code
    # path and not two. `thresholds.review_idle_days` is declared in days
    # because that is the unit the judgement was calibrated in; the payload
    # carries hours because the entry shape is shared, and the human-readable
    # unit belongs in `means` where a person reads it.
    in_progress_limit = threshold("in_progress_idle_hours", 4)
    review_limit = threshold("review_idle_days", 3) * 24

    rows = sorted(tasks.values(), key=lambda task: task["id"])
    found: dict = {
        # The aggregate of the field, not a second computation of its rule.
        "blocked_by_closed_rows": sorted(
            task["id"] for task in rows if task["blocked_stale"]),
        "in_progress_with_no_live_run": [],
        "review_idle": [],
        "next_action_cites_closed": [],
    }

    # Two agents starved at the 600s watchdog on 2026-08-20 and their rows
    # stayed `in_progress` with no dispatch slot and no new event. Neither
    # signal alone is a finding: a long dispatch holds a slot and writes
    # nothing for an hour, and a row worked by hand never had a slot. Both
    # together mean nobody is holding this and nobody has said so.
    for task in rows:
        if not (has_event_log and task["open"]):
            continue
        idle = idle_hours(task)
        if idle is None:
            continue
        if task["status"] == "in_progress" and task["id"] not in live \
                and idle >= in_progress_limit:
            found["in_progress_with_no_live_run"].append({
                "id": task["id"], "status": task["status"],
                "last_event": task["updated"] or "",
                "idle_hours": round(idle, 1),
                "threshold_hours": round(in_progress_limit, 1),
                "means": (
                    f"{task['id']} says somebody is working on it. No "
                    f"executor holds a dispatch slot for it and nothing has "
                    f"moved it for {round(idle, 1)}h. Either a run died "
                    f"without reporting — two did, at the 600s watchdog on "
                    f"2026-08-20 — or the work is happening somewhere Perry "
                    f"cannot see. Ask before re-dispatching: a second agent "
                    f"on a row a first one is still holding is the failure "
                    f"the dispatch limit exists to prevent."),
            })
        elif task["status"] == "review" and idle >= review_limit:
            found["review_idle"].append({
                "id": task["id"], "status": task["status"],
                "last_event": task["updated"] or "",
                "idle_hours": round(idle, 1),
                "threshold_hours": round(review_limit, 1),
                "means": (
                    f"{task['id']} is waiting on a human and has been for "
                    f"{round(idle / 24, 1)} days. `review` is the one status "
                    f"no dependency edge can contradict, so nothing else in "
                    f"this payload will ever notice it — TASK-100, TASK-111, "
                    f"TASK-127 and TASK-133 all sat here after their PRs had "
                    f"already merged. Either the verdict was given and the "
                    f"row was not closed, or nobody has been asked for one."),
            })

    # An open row whose `Next action` points at a task that has since closed.
    #
    # **The entries say what the hit might MEAN.** On 2026-08-20 this check was
    # firing on exactly TASK-037 and TASK-045 — the only two rows on the board
    # that turned out to be stranded — and it was read as prose hygiene,
    # because a `{id, cites, status}` triple looks like a wording complaint.
    # The cells were rewritten to silence it, which settled the disagreement by
    # deleting the evidence of it. A check that reports a pattern without its
    # meaning gets suppressed by whoever reads it, so this one states both
    # readings and decides between them itself in no case.
    #
    # **Only ids in this payload are resolved.** `DESIGN-`, `ADR-` and `USER-`
    # ids appear in these cells constantly and are NOT checked here — saying
    # "cites nothing closed" while silently skipping three id families would be
    # a stronger claim than the data supports.
    for task in rows:
        if not task["open"]:
            continue
        for cited in sorted(set(ID_RE.findall(task["next_action"]))):
            cid = f"TASK-{int(cited):03d}"
            other = tasks.get(cid)
            if other is None or other["open"]:
                continue
            found["next_action_cites_closed"].append({
                "id": task["id"], "cites": cid, "status": other["status"],
                "row_status": task["status"],
                "blocked_stale": task["blocked_stale"],
                "readings": [
                    f"the `Next action` is stale prose and {task['id']} is "
                    f"still waiting on something else",
                    f"{task['id']} is unblocked and its own `Status` has not "
                    f"caught up",
                ],
                "means": (
                    f"{task['id']} is open and its `Next action` points at "
                    f"{cid}, which is {other['status']}. This check cannot "
                    f"tell the two readings apart and does not try: the prose "
                    f"is stale, or the row is unblocked. "
                    + (f"`blocked_stale` is true on {task['id']}, so the "
                       f"dependency graph already agrees with the second "
                       f"reading — treat that as the finding, not this."
                       if task["blocked_stale"] else
                       f"{task['id']} reads `{task['status']}` and its "
                       f"dependency graph contradicts neither reading, so "
                       f"somebody has to read the cell.")
                    + " Rewriting the cell is not the default fix — on "
                    "2026-08-20 that is what was done to the only two "
                    "stranded rows on this board, and it removed the "
                    "evidence rather than the problem."),
            })
    return found


# ── TASK-162: an ask IS a node in the dependency graph ────────────────────
#
# **The decision, and the argument for it.** A row waiting on a `USER-` ask had
# no honest shape: `depends --on USER-015` was accepted by the writer and then
# reported by the reader as `depends_on_unknown`, and `depends --clear` moved it
# to `blocked_without_dependency`, whose own message is *"a row nobody can
# unblock"*. The writer said yes and the reader said no about one row.
#
# Yes, because Perry ALREADY WRITES THIS EDGE — in the other direction.
# `perry-task ask --blocks TASK-114` puts `TASK-114` in the queue row's
# `Blocks` cell; `perry-task depends TASK-114 --on USER-015` puts `USER-015` in
# the task row's `Depends on` cell. Those are two ends of one edge, written by
# two subcommands of one tool into two registers of one lane, and the only
# thing missing was a reader that joined them. Refusing the write would have
# meant `ask --blocks` keeps declaring an edge the graph is forbidden to know
# about, which is the same disagreement with the arrow reversed.
#
# **What makes something a node is not being a task — it is having a state
# this tool can read that reaches a terminal value.** That is the line, and it
# is why this admits `USER-` and still admits nothing else:
#
#   - a task is `done`/`dropped`, or it is not;
#   - an ask is `answered …`, or it is `pending` — and `bin/perry-state §
#     answered` is the ONE predicate that decides which, already shared by
#     three callers because it has been written twice before;
#   - `DESIGN-006` and `ADR-005` have no state Perry can ever read. Nothing in
#     this repository will ever learn that a design decision is "satisfied", so
#     they stay unknown and stay unsatisfied, which is the honest answer and
#     the one `blocked_by` already gives.
#
# So an id this project has never issued is still unknown — a mistyped task
# number and a `USER-` id the queue never minted both reach
# `depends_on_unknown` — and the check did not get weaker, it got a second
# register to resolve against.


def ask_register(ctx) -> dict[str, dict]:
    """Every `USER-` ask this project has put to a human → the ask.

    **`{"answered": bool, "needed": str, "status": str}`, not a bare bool
    (1.15).** The verdict alone was everything `dependency_satisfied` needed
    and nothing a consumer could render: an answered ask leaves the `asks`
    payload by design, so `USER-016` in `TASK-040`'s `depends_on` was in no
    register a reader could query — not `tasks[]`, not `asks.items`, not
    `depends_on_unknown` — and the only way to learn it was an ask at all was
    to notice it was missing from all three. That is set arithmetic over three
    arrays, and aiMark refused to do it, correctly. `needed` is the question
    text and `status` is the `answered …` cell verbatim, so the edge can carry
    both and the reader needs no second lookup.

    Read from the board **in memory**, not from disk. `board_sections` builds
    the `asks` payload by re-parsing `BOARD.md` off disk, which mid-write is the
    version being replaced, and it drops answered rows — this needs exactly the
    answered ones, because an answered ask is what satisfies an edge.

    `bin/perry-state § answered` decides `answered` vs `pending`, and is called
    rather than re-spelled: that predicate's own docstring records that it had
    already been written twice, and a row's dependency being satisfied is a
    worse place for a third opinion than a dashboard count was.

    `{}` on a project with no `## User Input Queue`, and on one with no
    projection at all. Then every `USER-` id is unknown again and the payload
    reads exactly as it did before this existed.
    """
    board = ctx.get("board")
    if board is None:
        return {}
    try:
        _, header = board.section_table("User Input Queue")
        rows = board.section_rows("User Input Queue")
    except Refused:
        return {}                     # not every project asks the user anything
    answered = perry_state().answered
    keys = [norm(h) for h in header]
    register: dict[str, bool] = {}
    for _, cells in rows:
        values = dict(zip(keys, cells))
        aid = strip_handle(values.get("user-id", ""))
        if not aid:
            continue
        row = P.UserInput(
            id=aid, needed_from_user=values.get("needed from user", ""),
            blocks=values.get("blocks", ""), idle=values.get("idle", ""),
            status=values.get("status", ""))
        register[aid] = {"answered": answered(row),
                         "needed": row.needed_from_user,
                         "status": row.status}
    return register


def dependency_satisfied(dep: str, tasks: dict, asks: dict) -> bool:
    """Is this one declared edge resolved? The whole rule, in four lines.

    A task that has closed, or an ask that has been answered. Anything else —
    an open task, a pending ask, an id neither register carries — is NOT
    satisfied, and that last clause is the one that matters most: *"I do not
    know"* is not *"it is done"*, and reporting such a row startable is the one
    error that sends somebody to work on something still blocked.
    """
    task = tasks.get(dep)
    if task is not None:
        return not task["open"]
    return bool(asks.get(dep, {}).get("answered"))


def resolved_edge(dep: str, tasks: dict, asks: dict) -> dict:
    """One `depends_on` id, with what it IS attached to it (1.15).

    **The edge declares its own kind, rather than a consumer deducing it from
    three arrays the id is absent from.** `depends_on` stays exactly what it
    was — a list of ids, unchanged, still the key every consumer reads — and
    this is a parallel array beside it, because retyping that one would be a
    major on the most-read key in the payload.

    The alternative considered and rejected was putting answered asks back into
    `asks.items`. That register is not a neutral list: its contract row says
    *"the unanswered asks"*, `open` is documented as `len(items)`, and
    `bin/perry-state § answered` exists because a dashboard once said *"2 items
    waiting on you"* about two questions answered the same day. Widening
    `items` either breaks `open == len(items)` or re-creates that count —
    and `tests/test_diagnose.py § test_the_queue_register_reconciles_…` pins
    `asks.open` against `perry-diagnose`'s queue register across two tools. A
    key that keeps its name and changes what it holds is the 1.10 `status_text`
    lesson; this row is not the place to repeat it.

    `satisfied` is `dependency_satisfied`'s own answer, called and never
    re-spelled, so this array cannot disagree with `blocked_by` about an edge.
    `kind` is `task` | `ask` | `unknown`, and `unknown` is the honest third
    value: a `DESIGN-`/`ADR-` handle and a mistyped id have no register, which
    is the same thing `depends_on_unknown` says and is said here per edge.

    `title` is the human text — a task's title, an ask's *Needed from user*
    question — and `""` on an unknown id, because inventing one from a handle
    is what `risks[].id` was corrected for at 1.6.
    """
    satisfied = dependency_satisfied(dep, tasks, asks)
    task = tasks.get(dep)
    if task is not None:
        return {"id": dep, "kind": "task", "satisfied": satisfied,
                "title": task["title"], "status": task["status"]}
    ask = asks.get(dep)
    if ask is not None:
        return {"id": dep, "kind": "ask", "satisfied": satisfied,
                "title": ask["needed"], "status": ask["status"]}
    return {"id": dep, "kind": "unknown", "satisfied": satisfied,
            "title": "", "status": ""}


def resolve_dependency_edges(tasks: dict, asks: dict) -> list[dict]:
    """Set `blocked_by` and `blocks` in place; return `depends_on_unknown`.

    **One statement of the edge rule for both `list` paths**, for the reason
    `bin/lib § resolve_startability` gives and TASK-148 paid for: these three
    were written out at both call sites, ~200 lines apart, and TASK-141 had to
    fix one rule twice. This one had to change in both places again, which is
    the second time the same shape has asked for the same fix.

    Takes the rows before `resolve_startability`, which reads the `blocked_by`
    this fills in and decides nothing about the graph itself.

    **The raw edge, not the transitive closure.** If A waits on B and B waits on
    C, A becomes startable the moment B closes — B's own history is not A's
    business. One hop is the whole computation.

    `blocks` is the reverse edge and stays a TASK-to-TASK relation: an ask is a
    node here, but it is not a row in `tasks[]`, and the reverse direction is
    already on its own row in the `Blocks` cell `ask --blocks` writes.
    """
    for task in tasks.values():
        task["depends_on_resolved"] = [resolved_edge(dep, tasks, asks)
                                       for dep in task["depends_on"]]
        # Derived from the SAME entries, so 1.14's graph cannot move under
        # 1.15: an edge is in `blocked_by` exactly when its resolved entry says
        # `satisfied: false`, and there is one place that decides that.
        task["blocked_by"] = [edge["id"]
                              for edge in task["depends_on_resolved"]
                              if not edge["satisfied"]]
    for task in sorted(tasks.values(), key=lambda row: row["id"]):
        for dep in task["depends_on"]:
            other = tasks.get(dep)
            if other is not None and task["id"] not in other["blocks"]:
                other["blocks"].append(task["id"])
    unknown_rows = []
    for task in sorted(tasks.values(), key=lambda row: row["id"]):
        unknown = [dep for dep in task["depends_on"]
                   if dep not in tasks and dep not in asks]
        if unknown:
            unknown_rows.append({"id": task["id"], "unknown": unknown})
    return unknown_rows


def _cmd_list_from_board(args, ctx) -> dict:
    """The full task set, from one call.

    `BOARD.md` holds open work only — closed rows leave it — so the complete
    set has, until now, existed solely as a reconstruction from date-sharded
    journal prose. A reader would have to parse every file in every month and
    rebuild each task's timeline. This does that once, in code, so a front-end
    never learns Perry's file formats and Perry can change them without
    breaking a program it does not control.

    **This payload is a frozen contract.** Its shape is specified in
    `schema/task-list-contract.md` and locked by tests; `LIST_CONTRACT` below
    is the version handle a consumer checks. Every declared key is ALWAYS
    present — an unknown value is `""`, `null` or `[]`, never a missing key —
    so a consumer needs no defensive branch per field.

    It exists so a front-end does not write a second parser for `BOARD.md`.
    That is not a style preference: `viewer/parsers.py` and `bin/perry-task`
    were two parsers of one file and they disagreed silently — the writer
    placed cells by header name while the reader read them by position, so a
    board with one extra column reported every task's owner as its track and
    counted zero open work. A third parser would be a third chance at the same
    bug, and this payload is the alternative.
    """
    def blank(tid: str) -> dict:
        # One template, so a key can never exist on some tasks and not others.
        return {"id": tid, "title": "", "summary": "", "owner": "", "priority": "",
                "status": "", "status_text": "", "track": "main", "mode": "",
                "stage": "", "evidence_paths": [], "evidence_relations": [],
                "stage_since": "", "arrived": "", "parent": "",
                "commitment": "", "next_action": "", "evidence": "",
                "verification": "", "open": False, "group": "",
                "role": "",
                "depends_on": [], "depends_on_resolved": [],
                "blocked_by": [], "blocks": [],
                "startable": False, "blocked_stale": False,
                "created": None, "updated": None, "timeline": []}

    tasks: dict[str, dict] = {}
    conformance = {"sections_read": [], "sections_skipped": [],
                   "rows_with_unrecognized_id": [], "off_enum_status": [],
                   "rows_with_no_status": [], "evidence_not_found": [],
                   "rows_with_no_computable_age": [],
                   "next_action_cites_closed": [],
                   "depends_on_unknown": [], "dependency_cycles": [],
                   "blocked_without_dependency": [],
                   "blocked_by_closed_rows": [],
                   "in_progress_with_no_live_run": [], "review_idle": [],
                   "has_event_log": bool(ctx["events"])}
    statuses = set(ctx["schema"]["enums"]["task_status"])
    terminal = {"done", "dropped"}

    for tbl in ctx["board"].task_tables():
        if not tbl["readable"]:
            conformance["sections_skipped"].append(
                {"heading": tbl["heading"],
                 "why": "table has no ID and Title columns",
                 "columns": tbl["header"]})
            continue
        conformance["sections_read"].append(
            {"heading": tbl["heading"], "priority": tbl["priority"],
             "rows": len(tbl["rows"])})
        pri = tbl["priority"] or ""
        for c in tbl["rows"]:
            # `~~DATA-007~~` and `**TASK-1**` are both real, both from a real
            # board: strikethrough means retired, bold means emphasis, and the
            # id underneath is the handle either way.
            tid = strip_handle(c.get("id", ""))
            if not tid:
                continue
            if not HANDLE_RE.fullmatch(tid):
                # A row whose first cell is prose, not a handle. One real board
                # has `| 2 待核项 | …` sitting in its P2 table. Reported so a
                # reader knows the board holds something it could not index —
                # dropping it silently is how a front-end shows nonsense.
                conformance["rows_with_unrecognized_id"].append(
                    {"section": tbl["heading"], "cell": tid[:60]})
                continue
            raw = c.get("status", "")
            # `**done**` is `done` wearing bold. Formatting is not meaning, and
            # a consumer that trusts the enum renders a finished task as an
            # unrecognized state — 17 of 41 rows on one real board. Emphasis is
            # stripped here so the enum claim is true; `status_text` keeps the
            # cell verbatim, because some cells genuinely are not one state
            # ("迁移 done，占比目标 not_started" is two, and rounding it to
            # either is a lie about the work).
            st = parsed_status(raw, statuses)
            if not raw.strip():
                conformance["rows_with_no_status"].append(
                    {"id": tid, "section": tbl["heading"]})
            elif not st:
                conformance["off_enum_status"].append(
                    {"id": tid, "status": raw})
            t = blank(tid)
            t.update({
                "title": c.get("title", ""), "owner": c.get("owner", ""),
                "priority": pri, "group": tbl["heading"],
                "status": st, "status_text": raw,
                "track": c.get("track", "") or "main",
                "stage": c.get("stage", ""),
                "stage_since": c.get("stage since", ""),
                "arrived": c.get("arrived", ""), "parent": c.get("parent", ""),
                "commitment": c.get("commitment", ""),
                "next_action": c.get("next action", ""),
                "evidence": c.get("evidence", ""),
                "verification": c.get("verification", ""),
                "role": c.get("role", ""),
                "depends_on": parse_depends(c.get("depends on", "")),
                # `open` used to mean "still on the board", which was true when
                # the board held only P0/P1/P2 and closing removed the row.
                # Once the reader saw every section, a project that stages
                # finished work under its own heading — Perry's own board has
                # `## Done this period (leaves the board at next triage)` —
                # reported 20 done tasks as open. The contract tells consumers
                # this field IS the live/closed test, so it has to mean that.
                "open": st not in terminal,
            })
            tasks[tid] = t

    for e in ctx["events"]:
        tid = e.get("id", "")
        if not tid or e.get("event") not in TASK_EVENTS:
            # The log is one stream for the whole project, and not everything
            # in it is a task. `## User Input Queue`, `## Cadence`, `## Intake`
            # and `## Top risks` are not tasks, and
            # `schema/task-list-contract.md § What this contract does not cover`
            # says so — but this loop folded EVERY event carrying an id. `ask`
            # writes a `USER-` id and `risk-add` writes an `RX-` one; absorbed
            # here they became rows in `tasks[]` with no title, no priority and
            # `open: false`, counted as closed work. Measured on a board with
            # one `ask` and nothing else: `list --all` returned exactly one
            # "task", the question.
            #
            # The board half was always right — `_task_sections` skips those
            # headings. Only the event fold was not. **The id shape cannot be
            # the filter, because project ids are project-defined; the event
            # name can, because this file mints it.**
            #
            # Found independently by two agents working in separate worktrees,
            # neither aware of the other. That is corroboration, not noise.
            continue
        if e.get("event") == "purge":
            # **The one event that removes, and the reason `purge` cannot be a
            # store-only operation.** This reconstruction is what
            # `perry-tasks write --from-board` and `perry-tasks verify` derive
            # a store from, and it rebuilds a CLOSED task out of the event
            # stream alone — that is exactly how `TASK-081`…`TASK-083` got
            # into `tasks.jsonl`: they were never on the board, they were
            # `add` + `drop` in the log, and the migration derived them.
            #
            # So a `purge` that only deleted a JSONL line would be undone by
            # the next `write --from-board`, silently, and the row would come
            # back with no event saying it had. The removal has to be legible
            # to the derivation, and the only place it can be written without
            # rewriting the append-only log is the log's own tail: the event
            # is the record of the removal AND the instruction to the reader
            # that rebuilds from it.
            #
            # Log order is what makes this sound — the fold walks the file in
            # order, so `add` … `drop` … `purge` deletes last. The id is NOT
            # released: `mint_id` reads the log, the `add` event is still
            # there, and a purged number is never handed out again.
            tasks.pop(tid, None)
            continue
        t = tasks.setdefault(tid, blank(tid))
        # A row that has left the board is closed; one still on it stays open,
        # and its live cells win over anything the event stream remembers.
        if not t["open"]:
            # `from`/`to` is not always a status transition. In particular a
            # post-close summary edit carries prose there; treating it as status
            # would make migration reconstruct a Task whose status is its own
            # explanation.
            if EVENT_FIELD.get(e.get("event") or "") == "status":
                t["status"] = e.get("to") or t["status"]
            if e.get("event") == "summary":
                t["summary"] = e.get("to") or ""
            t["title"] = e.get("title") or t["title"]
            t["track"] = e.get("track") or t["track"]
            t["priority"] = e.get("priority") or t["priority"]
            t["evidence"] = e.get("evidence") or t["evidence"]
            t["verification"] = e.get("rung") or t["verification"]
            # A closed row has left the board, so its `Depends on` cell went
            # with it — the same reason `evidence` is taken off the `done`
            # event two lines up. This is the ONE place the log is the source,
            # and only for rows the markdown no longer holds: an open row's
            # cell always wins, so deleting the log cannot blank a live edge.
            t["depends_on"] = e.get("depends_on") or t["depends_on"]
        ts = e.get("ts") or ""
        if e.get("event") in ("add", "route") and ts:
            t["created"] = ts
        # `ts` and the stamp already held are compared through the ONE
        # converter, not as text: the log carries two shapes since
        # TASK-144 and `"…T02:15:22+08:00" > "…T02:11:03"` is a text
        # comparison that happens to be right only while every line
        # was written at one offset.
        if ts and (t["updated"] is None
                   or lib.ts_key(ts) > lib.ts_key(t["updated"])):
            t["updated"] = ts
        entry = {k: e.get(k) for k in ("ts", "event", "from", "to", "actor")}
        # **`field` says what `from`/`to` refer to**, so a consumer needs no
        # hardcoded set of events that overload the pair. Asked for by aiMark,
        # which had to write `SECTION_MOVE_EVENTS = new Set(["prioritize"])` —
        # a set that is wrong the day Perry adds a second such event, with
        # nothing in the payload to say so. That is one side knowing and the
        # other guessing, which is the defect these contracts exist against.
        #
        # Always present, never absent, so no branch is needed per event. An
        # event the map does not know reports `""` rather than a guess — the
        # test above makes that unreachable for task events, and a wrong word
        # here is worse than an empty one.
        entry["field"] = EVENT_FIELD.get(e.get("event") or "", "")
        t["timeline"].append(entry)

    # `mode` is DERIVED, from `track` + `.perry/config.md § Tracks` — the same
    # register `track_of` reads and the only place a project declares which
    # `modes/<mode>.md` governs a track.
    #
    # It used to be read back out of the event log, which made it a stored copy
    # of a derived value and wrong in two ways at once: only `cmd_add` ever
    # wrote it, so every row `route` created shipped `mode: ""` on a queue
    # track — the one mode where routing is the normal way a row is born — and
    # deleting `.perry/events.jsonl` blanked it for every row on the board. The
    # log is declared DERIVED AND DISPOSABLE at the top of this file, so
    # nothing in a frozen contract may depend on it for a value the markdown
    # already determines.
    #
    # The fallback mirrors `parse_tracks`: a project that never declared a
    # track has exactly one, named `main`, mode `project`. A row on a track the
    # register does not declare gets `""` — the payload says it does not know,
    # which is the documented meaning of `""` for this field and better than
    # naming a mode the project never chose.
    declared = ctx["config"].get("tracks") or [{"track": "main",
                                                "mode": "project"}]
    modes = {t["track"]: t.get("mode", "") for t in declared}
    for t in tasks.values():
        t["mode"] = modes.get(t["track"], "")

    # `evidence_paths` is resolved HERE, after the event merge, for EVERY row.
    #
    # It used to be resolved inside the board walk, which meant it was resolved
    # only for rows that are ON the board — and closed rows leave the board.
    # Measured on Perry's own board: **32 closed rows, every one carrying an
    # evidence cell, every one with `evidence_paths: []`, and every file
    # present on disk.** The identical path on the identical board resolved
    # while the row was open and stopped the day it closed. `evidence` was not
    # empty, so nothing looked wrong; `conformance.evidence_not_found` was
    # empty too, so a consumer could not tell "Perry did not resolve this" from
    # "the file is gone" — and aiMark rendered the document that JUSTIFIES a
    # close as a dead link. The one row a reader most wants the artifact for.
    #
    # Two other things fall out of resolving after the merge rather than
    # during the walk. A closed row's `evidence` comes off the `done` event,
    # which the merge above applies — resolving before it ran would have
    # resolved a cell the payload then replaced. And a row that is on the
    # board but closed had exactly that divergence: `evidence` from the event,
    # `evidence_paths` from the board cell.
    #
    # Sorted by id so the report is stable across board and log ordering.
    for t in sorted(tasks.values(), key=lambda r: r["id"]):
        found, missing = evidence_paths(
            t["evidence"], ctx["state_root"], ctx["project_root"])
        t["evidence_paths"] = found
        t["evidence_relations"] = evidence_relations(
            t["evidence"], ctx["state_root"], ctx["project_root"])
        if missing:
            conformance["evidence_not_found"].append(
                {"id": t["id"], "paths": missing})

    # ── the dependency edge, and the one question a dashboard asks ─────────
    #
    # `blocked` said a row was stopped and never said on what. The edge is a
    # board cell now (`board_depends`), and this is where it becomes something
    # a consumer can sort on WITHOUT walking a graph itself:
    #
    #   depends_on  the raw declared edge, verbatim, in cell order
    #   blocked_by  the subset that is NOT known-terminal — an open task, a
    #               `pending` ask, or an id neither register carries at all
    #   blocks      the reverse edge, so "what does closing this free up" is a
    #               lookup instead of a scan over every other row
    #   startable   open, not itself waiting, and nothing unsatisfied under it
    #
    # **The raw edge, not the transitive closure.** Closure would be wrong as
    # well as expensive: if A waits on B and B waits on C, A becomes startable
    # the moment B closes — B's own history is not A's business. So one hop is
    # the whole computation, and `blocks`/`blocked_by` are exact rather than
    # approximations of a closure nobody needs.
    #
    # Computed over the WHOLE task set, before `--track` and `--all` filter it.
    # A row filtered out of `tasks[]` still blocks the rows that name it, and a
    # `blocks` list that changed with the caller's flags would be a different
    # graph per query.
    #
    # An id NEITHER REGISTER carries counts as UNSATISFIED. Perry cannot see a
    # `DESIGN-006` or a typo'd `TASK-5O`, and "I do not know" is not "it is
    # finished" — reporting such a row startable is the one error that sends
    # somebody to work on something that is still blocked. An **answered** ask
    # is a different thing entirely and satisfies the edge; see
    # `resolve_dependency_edges` and the TASK-162 block above it for why an ask
    # is a node and a `DESIGN-` id is not.
    conformance["depends_on_unknown"] = resolve_dependency_edges(
        tasks, ask_register(ctx))
    # `blocked_stale` and `startable`, from `bin/lib § resolve_startability` —
    # the ONE statement of the rule, which `cmd_list` below calls too. It was
    # written out here and again there, ~200 lines apart, and TASK-141 had to
    # fix it in both places (TASK-148). The whole rule, its exception and the
    # three boundaries it deliberately does not cross are documented on that
    # function; nothing about them is decided here.
    lib.resolve_startability(tasks.values())

    edges = {tid: t["depends_on"] for tid, t in tasks.items()}
    in_cycle: set[str] = set()
    for tid in sorted(edges):
        if tid in in_cycle:
            continue
        cycle = find_cycle(edges, tid)
        if cycle:
            conformance["dependency_cycles"].append(cycle)
            in_cycle.update(cycle)
    # The migration worklist, and the honest measure of how far it has got. A
    # row whose `Status` is `blocked` and whose `Depends on` is empty is one
    # whose dependency is still in prose somewhere — `Next action`, a journal
    # line, a review verdict — where nothing can read it. On Perry's own board
    # this is every blocked row, because backfilling them is a board write and
    # this payload only reads.
    conformance["blocked_without_dependency"] = sorted(
        t["id"] for t in tasks.values()
        if t["open"] and t["status"] == "blocked" and not t["depends_on"])

    # A row with no event AND no date cell has no age at all. Every staleness
    # rule triage runs is "idle ≥ N days", so such a row reads as fresh
    # forever. The six standard board columns carry no date, so on a board
    # written before the event log this is most of them — including, when this
    # was added, the two rows on Perry's own board whose `Next action` still
    # described blockers that had already been fixed.
    #
    # Computed HERE, after the event merge: doing it during the board walk
    # flagged rows the tool had created itself, because `updated` was not
    # filled in yet. The rule itself — including why a hand-written `—` is no
    # clock and why the array is empty without an event log — is stated once,
    # above.
    conformance["rows_with_no_computable_age"] = rows_with_no_computable_age(
        tasks, has_event_log=conformance["has_event_log"])

    # The stranded-row family, from `stranded_row_findings` above — the ONE
    # statement of these four, which `cmd_list` below calls too. It carries
    # `next_action_cites_closed`, which used to be written out here and again
    # there; it is the check whose MEANING this row changed, and changing a
    # meaning in two places is the failure TASK-148 already paid for once.
    conformance.update(stranded_row_findings(
        tasks, has_event_log=conformance["has_event_log"],
        thresholds=ctx["schema"].get("thresholds") or {},
        live=live_dispatch_ids(), now=datetime.now()))

    rows = sorted(tasks.values(), key=lambda t: t["id"])
    if args.track:
        rows = [t for t in rows if t["track"] == args.track]

    # An id whose only record is an event with no title predates the `title`
    # field. Reported rather than papered over: a bare id is exactly what
    # `reference/user-load.md` forbids handing a reader.
    #
    # Before the `open` filter, as in `cmd_list` — which is the builder a
    # `list` call actually reaches, and where TASK-166's argument is written
    # out. This payload's `untitled` is discarded by `store_records`, its only
    # caller, and it is kept in step anyway: two builders of one contract that
    # disagree silently is the defect `store_records` itself exists to
    # prevent, and "the copy nobody reads may drift" is how it starts.
    untitled = [t["id"] for t in rows if not t["title"]]
    if not args.all:
        rows = [t for t in rows if t["open"]]
    # `## Intake` — the one section a procedure must act on by POSITION.
    # `route <n>` and `resolve-intake <n>` take a row number, and the only way
    # to get one was to open `BOARD.md` and count, twenty lines below the rule
    # that forbids exactly that. Undischarged rows and the oldest arrival are
    # what triage's step 0 asks for; both were uncomputable from any payload.
    intake_rows = []
    try:
        for pos, (_, cells) in enumerate(ctx["board"].section_rows("Intake"), 1):
            _, ihdr = ctx["board"].section_table("Intake")
            row = dict(zip([norm(h) for h in ihdr], cells))
            outcome = (row.get("outcome") or "").strip()
            intake_rows.append({
                "n": pos,
                "arrived": row.get("arrived", ""),
                "request": row.get("request", ""),
                "outcome": outcome,
                "discharged": bool(outcome)
                              and outcome.strip("*` ").lower() not in INTAKE_UNSET,
                "age_days": days_between(row.get("arrived", "")),
            })
    except Refused:
        pass                      # no `## Intake` — not every project is queue-shaped

    sections = board_sections(ctx)
    return {"contract": LIST_CONTRACT,
            # Sorted here rather than trusted to writing order: the list is
            # consumed as "everything newer than the minor I tested against",
            # and it shipped once as 1.5, 1.9, 1.7 because an entry was
            # inserted where it read well rather than where it belonged.
            "semantics": sorted(
                LIST_SEMANTICS,
                key=lambda e: tuple(int(x) for x in e["version"].split("."))),
            "risks": sections["risks"],
            "asks": sections["asks"],
            "drift": sections["drift"],
            "intake": {
                "rows": intake_rows,
                "undischarged": sum(1 for r in intake_rows if not r["discharged"]),
                "oldest_undischarged": next(
                    (r["n"] for r in sorted(
                        (x for x in intake_rows if not x["discharged"]),
                        key=lambda x: x["age_days"] if x["age_days"] is not None else -1,
                        reverse=True)), None),
            },
            "project_root": str(ctx["project_root"]),
            "state_root": str(ctx["state_root"]),
            "conformance": conformance,
            "tasks": rows,
            "open": sum(1 for t in rows if t["open"]),
            "closed": sum(1 for t in rows if not t["open"]),
            "events": len(ctx["events"]),
            "untitled": untitled}


def cmd_list(args, ctx) -> dict:
    """Return current Task truth from ``tasks.jsonl`` plus disposable history."""
    terminal = {"done", "dropped"}
    statuses = set(ctx["schema"]["enums"]["task_status"])
    conformance = {"sections_read": [], "sections_skipped": [],
                   "rows_with_unrecognized_id": [], "off_enum_status": [],
                   "rows_with_no_status": [], "evidence_not_found": [],
                   "rows_with_no_computable_age": [],
                   "next_action_cites_closed": [],
                   "depends_on_unknown": [], "dependency_cycles": [],
                   "blocked_without_dependency": [],
                   "blocked_by_closed_rows": [],
                   "in_progress_with_no_live_run": [], "review_idle": [],
                   "has_event_log": bool(ctx["events"]),
                   "missing_projection": ("" if ctx.get("board") is not None
                                          else str(ctx["state_root"] / "BOARD.md"))}

    def task_from_record(rec: dict) -> dict:
        status = rec.get("status") or ""
        tid = rec["id"]
        if not status:
            conformance["rows_with_no_status"].append(
                {"id": tid, "section": rec.get("group") or rec.get("priority") or ""})
        elif status not in statuses:
            conformance["off_enum_status"].append({"id": tid, "status": status})
        return {
            "id": tid, "title": rec.get("title") or "",
            "summary": rec.get("summary") or "",
            "owner": rec.get("owner") or "", "priority": rec.get("priority") or "",
            "status": status, "status_text": status,
            "track": rec.get("track") or "main", "mode": "",
            "stage": rec.get("stage") or "", "stage_since": rec.get("stage_since") or "",
            "arrived": rec.get("arrived") or "", "parent": rec.get("parent") or "",
            "commitment": rec.get("commitment") or "",
            "next_action": rec.get("next_action") or "",
            "evidence": rec.get("evidence") or "", "evidence_paths": [],
            "evidence_relations": [],
            "verification": rec.get("verification") or "",
            "open": status not in terminal, "group": rec.get("group") or "",
            "role": rec.get("role") or "",
            "depends_on": list(rec.get("depends_on") or []),
            "depends_on_resolved": [],
            "blocked_by": [], "blocks": [], "startable": False,
            "blocked_stale": False,
            "created": rec.get("created"), "updated": None, "timeline": [],
        }

    tasks = {rec["id"]: task_from_record(rec) for rec in ctx["task_records"]}

    groups: dict[tuple[str, str], int] = {}
    for task in tasks.values():
        heading = task["group"] or task["priority"]
        if not heading:
            continue
        key = (heading, heading if heading in {"P0", "P1", "P2"} else "")
        groups[key] = groups.get(key, 0) + 1
    conformance["sections_read"] = [
        {"heading": heading, "priority": priority or None, "rows": count}
        for (heading, priority), count in sorted(groups.items())]

    for event in ctx["events"]:
        tid = event.get("id") or ""
        task = tasks.get(tid)
        if task is None or event.get("event") not in TASK_EVENTS:
            continue
        ts = event.get("ts") or ""
        # `ts` and the stamp already held are compared through the ONE
        # converter, not as text: the log carries two shapes since
        # TASK-144 and `"…T02:15:22+08:00" > "…T02:11:03"` is a text
        # comparison that happens to be right only while every line
        # was written at one offset.
        if ts and (task["updated"] is None
                   or lib.ts_key(ts) > lib.ts_key(task["updated"])):
            task["updated"] = ts
        entry = {k: event.get(k) for k in ("ts", "event", "from", "to", "actor")}
        entry["field"] = EVENT_FIELD.get(event.get("event") or "", "")
        task["timeline"].append(entry)

    declared = ctx["config"].get("tracks") or [{"track": "main", "mode": "project"}]
    modes = {track["track"]: track.get("mode", "") for track in declared}
    for task in tasks.values():
        task["mode"] = modes.get(task["track"], "")
        found, missing = evidence_paths(
            task["evidence"], ctx["state_root"], ctx["project_root"])
        task["evidence_paths"] = found
        task["evidence_relations"] = evidence_relations(
            task["evidence"], ctx["state_root"], ctx["project_root"])
        if missing:
            conformance["evidence_not_found"].append(
                {"id": task["id"], "paths": missing})

    # The same call the board-derived path makes, because it is the same rule
    # and there is now one of it. `blocked_by`, `blocks` and
    # `depends_on_unknown` were restated here too — same meaning, different
    # spelling — and TASK-162 is the second fix that would have had to be
    # applied twice.
    conformance["depends_on_unknown"] = resolve_dependency_edges(
        tasks, ask_register(ctx))
    lib.resolve_startability(tasks.values())

    edges = {tid: task["depends_on"] for tid, task in tasks.items()}
    in_cycle: set[str] = set()
    for tid in sorted(edges):
        if tid in in_cycle:
            continue
        cycle = find_cycle(edges, tid)
        if cycle:
            conformance["dependency_cycles"].append(cycle)
            in_cycle.update(cycle)
    conformance["blocked_without_dependency"] = sorted(
        task["id"] for task in tasks.values()
        if task["open"] and task["status"] == "blocked" and not task["depends_on"])
    # Both of these are the same call the board-derived path makes, for the
    # same reason: the rule has one home, not one per `list` path.
    conformance["rows_with_no_computable_age"] = rows_with_no_computable_age(
        tasks, has_event_log=conformance["has_event_log"])
    conformance.update(stranded_row_findings(
        tasks, has_event_log=conformance["has_event_log"],
        thresholds=ctx["schema"].get("thresholds") or {},
        live=live_dispatch_ids(), now=datetime.now()))

    intake_rows = []
    board = ctx.get("board")
    if board is not None:
        try:
            _, ihdr = board.section_table("Intake")
            for pos, (_, cells) in enumerate(board.section_rows("Intake"), 1):
                row = dict(zip([norm(h) for h in ihdr], cells))
                outcome = (row.get("outcome") or "").strip()
                intake_rows.append({
                    "n": pos, "arrived": row.get("arrived", ""),
                    "request": row.get("request", ""), "outcome": outcome,
                    "discharged": bool(outcome)
                                  and outcome.strip("*` ").lower() not in INTAKE_UNSET,
                    "age_days": days_between(row.get("arrived", "")),
                })
        except Refused:
            pass

    sections = board_sections(ctx)
    rows = sorted(tasks.values(), key=lambda task: task["id"])
    if args.track:
        rows = [task for task in rows if task["track"] == args.track]
    # **Computed BEFORE the `open` filter, and that is TASK-166's half one.**
    # It used to be computed after, so the only kind of row that can be
    # PERMANENTLY untitled — a closed one, which no triage will look at again
    # and which nothing else in the payload names — was the one kind this
    # array could not report. Measured on this repository: `TASK-029` is
    # `done` at V3 with real evidence and an empty title, and `untitled` was
    # `[]` without `--all` and `["TASK-029"]` with it. An open row's missing
    # title gets noticed the next time somebody reads the board; a closed
    # row's never does, which is why the compounding was not bad luck — the
    # check only looked where `retitle` could reach, and `retitle` only
    # reached where the check already looked.
    #
    # Not a contract change: § The payload has always defined this key as
    # "ids with no title in ANY record", while `open` and `closed` are
    # documented as the counts that move with the flags. The code was out of
    # conformance with its own document, so the version does not move and
    # `LIST_SEMANTICS` gains no entry.
    #
    # `--track` still scopes it. That flag names a slice of the PROJECT and
    # every array in this payload respects it; `open` names a slice of TIME,
    # and a title does not stop being needed when the work finishes.
    untitled = [task["id"] for task in rows if not task["title"]]
    if not args.all:
        rows = [task for task in rows if task["open"]]
    return {"contract": LIST_CONTRACT,
            "semantics": sorted(
                LIST_SEMANTICS,
                key=lambda entry: tuple(int(x) for x in entry["version"].split("."))),
            "risks": sections["risks"], "asks": sections["asks"],
            "drift": sections["drift"],
            "intake": {
                "rows": intake_rows,
                "undischarged": sum(1 for row in intake_rows if not row["discharged"]),
                "oldest_undischarged": next(
                    (row["n"] for row in sorted(
                        (item for item in intake_rows if not item["discharged"]),
                        key=lambda item: (item["age_days"]
                                          if item["age_days"] is not None else -1),
                        reverse=True)), None),
            },
            "project_root": str(ctx["project_root"]),
            "state_root": str(ctx["state_root"]), "conformance": conformance,
            "tasks": rows, "open": sum(1 for task in rows if task["open"]),
            "closed": sum(1 for task in rows if not task["open"]),
            "events": len(ctx["events"]), "untitled": untitled}


_PERRY_STATE = None


def perry_state():
    """`bin/perry-state` as a module, loaded once per process.

    The loader was inline in `main()` and gated on `.perry/config.md` existing,
    so anything else that wanted a rule from `perry-state` had to copy it
    instead — which is what `split_stages` below was. Hoisted and cached so
    there is one way to reach that file and no reason to reimplement anything
    in it.
    """
    global _PERRY_STATE
    if _PERRY_STATE is None:
        import importlib.machinery
        import importlib.util
        sys.path.insert(0, str(PERRY_HOME / "bin"))
        spec = importlib.util.spec_from_loader(
            "perry_state", importlib.machinery.SourceFileLoader(
                "perry_state", str(PERRY_HOME / "bin" / "perry-state")))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        _PERRY_STATE = mod
    return _PERRY_STATE


_PERRY_CONFORM = None


def perry_conform():
    """`bin/perry-conform` as a module — the conformance gate (ADR-004)."""
    global _PERRY_CONFORM
    if _PERRY_CONFORM is None:
        import importlib.machinery
        import importlib.util
        sys.path.insert(0, str(PERRY_HOME / "bin"))
        spec = importlib.util.spec_from_loader(
            "perry_conform", importlib.machinery.SourceFileLoader(
                "perry_conform", str(PERRY_HOME / "bin" / "perry-conform")))
        mod = importlib.util.module_from_spec(spec)
        # Registered BEFORE exec: `perry-conform` declares dataclasses under
        # `from __future__ import annotations`, and `dataclasses` resolves
        # those string annotations through `sys.modules[cls.__module__]`. An
        # unregistered module makes that lookup return None and the import dies
        # inside the decorator, several frames from anything that names it.
        sys.modules["perry_conform"] = mod
        spec.loader.exec_module(mod)
        _PERRY_CONFORM = mod
    return _PERRY_CONFORM


#: The commands that only read. Everything else writes `BOARD.md` and is gated
#: on `BOARD.md` — on that file and on nothing else, because ADR-004 § 5 makes
#: conformance per-file so a project can migrate its board and not its risks.
#: `list` is a published contract (`schema/task-list-contract.md`) and reading
#: is never gated, so it is not merely excluded here — `tests/test_conformance`
#: asserts it still answers on an undeclared project with the gate enforcing.
READ_ONLY_COMMANDS = {"list", "events", "signoff-offer"}
TASK_ROW_COMMANDS = {"start", "stage", "track", "done", "drop", "purge",
                     "status", "depends", "next", "retitle", "summary",
                     "rung", "evidence", "prioritize"}
GATED_FILE = "BOARD.md"


def split_stages(cell: str) -> list[str]:
    """The stage vocabulary of a `Stages` cell — `perry-state`'s implementation.

    There were two, differing only in a loop variable, with the docstring that
    explains the normalization on one of them. Three spellings of the separator
    are in circulation (`->`, `→`, `→` with spaces) and "the first stage" and
    "the terminal stage" are both load-bearing rules, so the two copies were one
    edit away from disagreeing about where every row in a track begins and ends
    — silently, because nothing compared them. This file already loads
    `perry-state` to reuse `parse_tracks`; reusing this costs nothing more.
    """
    return perry_state().split_stages(cell)


def default_stages(schema: dict, mode: str) -> list[str]:
    return split_stages(schema["work_modes"]["modes"][mode].get("default_stages", ""))


# ── main ──────────────────────────────────────────────────────────────────


class Args:
    pass


def parse(argv: list[str]) -> Args:
    a = Args()
    a.cmd = None
    a.id = a.title = a.summary = a.track = a.owner = a.priority = None
    a.next = a.parent = a.commitment = a.stage = a.evidence = a.rung = None
    a.root = None
    a.actor = "agent"
    a.arrived = a.reason = a.outcome = a.status = None
    a.needed = a.blocks = a.answer = None
    a.frequency = a.on = None
    a.needed = a.blocks = a.answer = a.opened = None
    a.deliverable = a.verification = a.depends = a.out_of_scope = a.kr = None
    # The V5 sign-off. Four of these are LISTS: one offered item is one flag,
    # so an item containing a comma is still one item. `--checked` accepts both
    # spellings because the host without a selection UI hands back `1,3`.
    a.measured, a.restated, a.checked, a.not_looked_at = [], [], [], []
    a.also = a.signer = a.signed_on = None
    a.group = a.prefix = a.role = None
    a.limit = a.since = None
    a.dry_run = a.as_json = a.all = a.clear = False
    i = 0
    flags = {"--title": "title", "--summary": "summary",
             "--track": "track", "--owner": "owner",
             "--priority": "priority", "--next": "next", "--parent": "parent",
             "--commitment": "commitment", "--stage": "stage",
             "--evidence": "evidence", "--rung": "rung", "--root": "root",
             "--arrived": "arrived", "--reason": "reason",
             "--outcome": "outcome", "--status": "status",
             "--actor": "actor", "--needed": "needed",
             "--blocks": "blocks", "--answer": "answer",
             "--limit": "limit", "--since": "since",
             "--frequency": "frequency", "--on": "on",
             "--opened": "opened", "--deliverable": "deliverable",
             "--verification": "verification", "--depends": "depends",
             "--out-of-scope": "out_of_scope", "--kr": "kr",
             "--group": "group", "--prefix": "prefix", "--role": "role",
             "--also": "also", "--signer": "signer",
             "--signed-on": "signed_on"}
    repeated = {"--measured": "measured", "--restated": "restated",
                "--checked": "checked", "--not-looked-at": "not_looked_at"}
    while i < len(argv):
        t = argv[i]
        if t in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        elif t == "--dry-run":
            a.dry_run = True
        elif t == "--json":
            a.as_json = True
        elif t == "--all":
            a.all = True
        elif t == "--clear":
            a.clear = True
        elif t in repeated:
            i += 1
            getattr(a, repeated[t]).append(argv[i] if i < len(argv) else "")
        elif t in flags:
            i += 1
            setattr(a, flags[t], argv[i] if i < len(argv) else None)
        elif t.startswith("-"):
            print(f"perry-task: unknown argument {t!r} (try --help)", file=sys.stderr)
            sys.exit(2)
        elif a.cmd is None:
            a.cmd = t
        elif a.id is None:
            a.id = t
        i += 1
    return a


# The single source of truth for what `perry-task` accepts. Membership check,
# error message and dispatch all read this one dict on purpose: it used to be a
# tuple and a dict holding the same list, and they drifted apart twice — once
# leaving `drop` accepted but undispatched (a bare KeyError), once leaving
# `drop`, `status` and `resolve-intake` out of the "expected one of" line. A
# name added here is reachable, dispatchable and advertised in one edit.
# Which events describe a `## P0`/`## P1`/`## P2` row, and which describe one of
# the board sections that are explicitly not tasks. Written as a partition of
# `COMMANDS` rather than as one list, and checked to BE a partition by
# `tests/test_cadence.py`, because the alternative shapes both fail silently: an
# allowlist drops a future event from the payload, a denylist leaks one into it,
# and either way nobody finds out until a consumer reports it. This file has
# already lost that bet twice with a tuple and a dict holding "the same" list.
#
# `purge` is here and not in `SECTION_EVENTS`, which would have been the
# convenient answer: it is the only classification under which `commit()`'s
# task branch is skipped for free. It is also false. `SECTION_EVENTS` is the
# set of events written against `## Intake`, `## User Input Queue`,
# `## Cadence` and `## Top risks` — the board sections that are *not tasks* —
# and a `purge` carries a `TASK-` id and is about a task row. Classifying it
# there to save four lines would put the wrong word in the one register two
# contracts derive their event vocabulary from.
TASK_EVENTS = frozenset({"add", "route", "start", "stage", "track", "status",
                         "next", "retitle", "summary", "rung", "evidence",
                         "prioritize", "depends", "done", "drop", "purge"})
# **What a timeline entry's `from`/`to` pair actually refers to.** One row per
# task event, no default — `tests/test_prioritize.py` asserts this map's keys
# are exactly `TASK_EVENTS`, so an event cannot be added without declaring what
# its pair means, and a name left here after the event is deleted is a promise
# about something that cannot happen.
#
# Asked for by aiMark, which had to write
# `SECTION_MOVE_EVENTS = new Set(["prioritize"])` — a set that is wrong the day
# Perry adds a second event overloading the pair, with nothing in the payload to
# say so. One side knowing and the other guessing is the defect these contracts
# exist against.
#
# **It is a full map rather than the "everything else is `status`" the ask
# proposed, because that default is false.** `retitle`'s pair is a title,
# `next`'s is a next action, `rung`'s is a rung. Shipping `status` for those
# would put a wrong word in a field whose whole job is to stop a consumer
# guessing — the same defect in the fix for it.
EVENT_FIELD = {
    "add": "status", "route": "status", "start": "status",
    "status": "status", "done": "status", "drop": "status",
    # `purge`'s pair is the row's STATUS and its `to` is `""`, which is this
    # payload's documented unknown value and here means "there is no
    # destination status, because there is no longer a record". The
    # alternative — inventing a `purged` state — would put a word the
    # `task_status` enum does not carry into the one field a consumer
    # branches on, to describe a row it can no longer look up.
    "purge": "status",
    "stage": "stage",
    # `track` is a cell of its own and a key of the task payload. It is NOT
    # `stage`: a move re-stamps the stage as a consequence, and a consumer told
    # the pair was a stage would read `main → intake` as a stage vocabulary it
    # cannot find. The stage the move produced rides on the event's own
    # `stage` / `stage_from` keys.
    "track": "track",
    "prioritize": "section",
    "retitle": "title",
    "summary": "summary",
    "next": "next_action",
    "rung": "verification",
    "evidence": "evidence",
    "depends": "depends_on",
}

SECTION_EVENTS = frozenset({"intake", "resolve-intake", "intake-sweep",
                            "ask", "answer",
                            "cadence-add", "cadence-done",
                            "risk-add", "risk-clear", "risk-migrate"})

def cmd_events(args, ctx) -> dict:
    """`perry-task events` — the event log's TAIL, in log order.

    **Asked for by aiMark, and shaped against the alternative it proposed.**
    `--limit`/`--since` on `list` was rejected because three fields there are
    defined RELATIVE TO THE PAYLOAD — `blocks` is "ids in this payload whose
    `depends_on` names this row", `depends_on_unknown` is what this payload does
    not carry, and `next_action_cites_closed` says outright that only ids in
    this payload are resolved. Paging `list` silently shortens all three, so the
    same consumer reading the same field gets a different answer per page.

    Measured, which is what makes a second surface worth its cost rather than
    duplication: the last 20 events on this project span 10 tasks, which sit at
    positions 24 through 79 of 80 by id. **Any paging key except `updated`
    returns the wrong events** — and `updated` is exactly what a task-shaped
    payload cannot promise once it is filtered. Worse, without `--all` the feed
    is wrong today, because a close is what makes a row leave the board; and
    `--all` reconstructs every closed task from journal plus log to answer a
    question about the log's tail.

    **Order is the other half.** `ts` is seconds and ties are real — two drops
    in this log share one second — and `perry-task/list` promises array order
    only WITHIN one id. A flattened cross-task stream therefore has no
    authoritative order at all. This returns **log order**, and the contract
    says so.

    **Which END of the log, and the bug that named it (1.1, TASK-168).** Until
    1.1 the first page was the log's HEAD. Three texts — this docstring, the
    contract's first line and its § Why this exists, and `--help` — all said TAIL, and the
    contract's own paging example carried the comment `# newest window is the
    FIRST page`. The implementation was what drifted, not the design: a
    consumer that trusted the documentation shipped a "recent activity" panel
    of the OLDEST events in the project, and the one that caught it worked
    around it by asking for a window larger than any real log — 437 KB per
    project — and slicing the end itself. `--limit 6` now returns the six
    events somebody asking for six wants.

    **Paging therefore runs backwards, into older events, and that is forced
    rather than chosen.** If the first page is the newest window there is
    nothing after it to page to; the only direction left is older. `cursor` is
    the OLDEST event in the window — the boundary the next page ends at — and
    `more` says whether anything sits before it. `seq` is unchanged: it is the
    absolute position in the log, so a consumer reassembling the log from its
    pages sorts on `seq` and does not have to know which way it walked.
    """
    events = ctx["events"]
    limit = 20
    if args.limit is not None:
        try:
            limit = int(args.limit)
        except (TypeError, ValueError):
            raise Refused(f"--limit takes a number; got {args.limit!r}")
        if limit < 1:
            raise Refused("--limit must be at least 1")

    # The cursor is `<index>:<ts>`. The index is the position in the log; the ts
    # is what makes rotation DETECTABLE — if the event now at that index carries
    # a different ts, lines were removed beneath it and the consumer is told
    # rather than silently handed the wrong window.
    #
    # The window is a half-open `[start, end)` and it is ANCHORED AT ITS END:
    # with no cursor the end is the log's end, so the first page is the tail.
    # `--since` moves the end back to the cursored event, EXCLUSIVE, which is
    # what makes the pages a partition — the cursored event is the OLDEST row
    # of the page that produced the cursor and must not be handed out twice.
    end, rotated = len(events), False
    if args.since:
        raw = str(args.since)
        idx, _, want_ts = raw.partition(":")
        try:
            at_i = int(idx)
        except ValueError:
            raise Refused(
                f"--since takes a cursor from a previous call; got {raw!r}")
        at = events[at_i] if 0 <= at_i < len(events) else None
        if want_ts and (at is None or at.get("ts") != want_ts):
            # Rotation restarts at the NEWEST window, which is where a feed
            # with no cursor starts. Restarting at the head would hand a
            # consumer the oldest events in the project labelled as a fresh
            # page — the exact defect 1.1 exists to remove.
            rotated, end = True, len(events)
        else:
            end = max(0, min(at_i, len(events)))
    start = max(0, end - limit)

    window = events[start:end]
    return {
        "contract": EVENTS_CONTRACT,
        # The minors under which a value here changed MEANING, oldest first.
        # Rule 2 promises `1.x` only adds keys and that is still true; 1.1 adds
        # no key and returns different ROWS under the same one, which is
        # exactly the case this array reports and the reason the minor moved.
        "semantics": sorted(
            EVENTS_SEMANTICS,
            key=lambda e: tuple(int(x) for x in e["version"].split("."))),
        "project_root": ctx["project_root"].as_posix(),
        "events": [{
            "seq": start + n,
            "ts": e.get("ts", ""),
            "event": e.get("event", ""),
            "task": str(e.get("task") or e.get("id") or ""),
            # **The title AS WRITTEN when the event was appended.** A retitled
            # task's earlier events still carry the old name — correct for a
            # history view and wrong the moment a front-end renders it as the
            # row's current name. `perry-task/list` has the current one.
            "title_then": e.get("title", ""),
            "field": e.get("field", EVENT_FIELD.get(e.get("event", ""), "")),
            "from": e.get("from", ""),
            "to": e.get("to", ""),
            "actor": e.get("actor", ""),
            # Populated on 16 events in this project's own log and exposed by
            # no contract surface until now.
            "reason": e.get("reason", ""),
            "rung": e.get("rung", ""),
            "evidence": e.get("evidence", ""),
            "track": e.get("track", ""),
            "owner": e.get("owner", ""),
            "role": e.get("role", ""),
        } for n, e in enumerate(window)],
        "count": len(window),
        "total": len(events),
        # The OLDEST event in this window, since 1.1 — the boundary the NEXT
        # page ends at. Feeding it back returns the `limit` events immediately
        # before it, so the pages partition the log and neither skip nor repeat
        # one at a boundary.
        "cursor": (f"{start}:{window[0].get('ts', '')}" if window
                   else (args.since or "")),
        # There are OLDER events before `cursor`. Since 1.1: paging runs
        # backwards, so this is the question a consumer asks to keep going.
        "more": start > 0,
        # True when the cursor pointed at an event the log no longer holds.
        # Rotation under TASK-070 truncates history, and a feed that silently
        # restarted would look like a burst of new activity.
        "rotated": rotated,
    }


COMMANDS = {"add": cmd_add, "start": cmd_start, "stage": cmd_stage,
            "track": cmd_track,
            "ask": cmd_ask, "answer": cmd_answer, "next": cmd_next,
            "cadence-add": cmd_cadence_add, "cadence-done": cmd_cadence_done,
            "risk-add": cmd_risk_add, "risk-clear": cmd_risk_clear,
            "risk-migrate": cmd_risk_migrate,
            "done": cmd_done, "drop": cmd_drop, "purge": cmd_purge,
            "intake": cmd_intake,
            "route": cmd_route, "resolve-intake": cmd_resolve_intake,
            "retitle": cmd_retitle, "summary": cmd_summary, "rung": cmd_rung,
            "evidence": cmd_evidence, "prioritize": cmd_prioritize,
            "intake-sweep": cmd_intake_sweep,
            "status": cmd_status, "depends": cmd_depends,
            "list": cmd_list, "events": cmd_events,
            "signoff-offer": cmd_signoff_offer}


def project_lock(state_root: Path, timeout: float = 10.0):
    """Serialize the whole read-modify-write, not just the write.

    `lib.project_lock` carries the reasoning — it was written here first, and
    the other three copies were written from it. The lock must wrap the read as
    well as the write, which is why it is taken here and not inside `commit()`:
    a lock around the write alone would still let both processes mint the same
    id from the same stale board. `autopilot` dispatches concurrently by design,
    so this path is live rather than hypothetical.

    **This copy said "another perry-task is holding" on timeout, and the other
    three said "another Perry write".** The key is the project, not the tool, so
    the holder is as often `goals`, `decide` or `knowledge` — the shared wording
    is the true one and is what the caller now gets.
    """
    return lib.project_lock(state_root, timeout, Refused)


def main(argv: list[str]) -> int:
    args = parse(argv)
    if args.cmd not in COMMANDS:
        print(f"perry-task: expected one of {' / '.join(COMMANDS)} "
              f"(try --help)", file=sys.stderr)
        return 2
    try:
        schema = load_schema()
        project_root = (Path(args.root).expanduser().resolve() if args.root
                        else Path(os.environ.get("PERRY_PROJECT") or Path.cwd()).resolve())
        state_root = P.resolve_state_root(project_root)
        cfg_path = project_root / ".perry" / "config.md"
        config = {"tracks": []}
        if cfg_path.exists():
            config = {"tracks": perry_state().parse_tracks(cfg_path.read_text())}
        # ADR-004. Taken before the lock and before any command runs: a refusal
        # must mean nothing was written, and a dry run must preview the refusal
        # rather than the write it would not be allowed to perform.
        gate = None
        if args.cmd not in READ_ONLY_COMMANDS:
            gate = perry_conform().gate(project_root, state_root, GATED_FILE,
                                        tool="perry-task", root_arg=args.root)
            if not gate.ok:
                raise Refused(gate.message)
            if gate.message and not args.as_json:
                # `gate.mode`, not the literal "advisory": reaching this line
                # means the gate found something AND let the write through, so
                # the mode is the reason it was let through and is the one word
                # the reader needs. Hardcoding it survived only because the
                # shipped default made it true by construction (TASK-047).
                print(f"perry-task: ⚠ conformance ({gate.mode}) — "
                      f"{gate.message}", file=sys.stderr)
        with project_lock(state_root):
            recovered = recover_transaction(state_root)
            records = load_task_records(state_root)
            board_path = state_root / "BOARD.md"
            board = Board(board_path) if board_path.exists() else None
            if args.cmd not in READ_ONLY_COMMANDS and board is None:
                raise Refused(
                    f"no BOARD.md at {board_path}. Task truth is safe in "
                    f"{perry_store.store_path(state_root)}, but this command "
                    "needs the projection layout to render its write.")
            ctx = {"schema": schema, "project_root": project_root,
                   "state_root": state_root, "config": config,
                   "board": board, "events": read_events(project_root),
                   "task_records": records,
                   "tasks_by_id": {record["id"]: record for record in records}}
            if args.cmd not in READ_ONLY_COMMANDS:
                ctx["projection_before_write"] = hydrate_task_projection(
                    ctx["board"], records)
            if args.cmd in TASK_ROW_COMMANDS:
                task_record(ctx, args.id)
            for _f in ("next", "title", "reason", "note",
                       "deliverable"):
                _v = getattr(args, _f, None)
                if not isinstance(_v, str):
                    continue
                _bad = idish_tokens_that_resolve_nowhere(_v, ctx)
                if _bad and not args.as_json:
                    print(f"perry-task: ⚠ --{_f} contains "
                          f"{', '.join(sorted(set(_bad)))}, which reads as an "
                          f"id and names nothing. `perry-diagnose` reports it "
                          f"as dangling. Write it as prose (`round 3`) if you "
                          f"did not mean an id.", file=sys.stderr)
            command_args = args
            if args.cmd == "list" and not args.as_json and not args.all:
                # The JSON contract counts only rows present in its payload, so
                # a default `list --json` intentionally reports closed=0. The
                # human summary answers a different question: how much work is
                # open, active, and closed in this project. Build the complete
                # set once, then hide closed rows only while rendering the list.
                command_args = copy.copy(args)
                command_args.all = True
            result = COMMANDS[args.cmd](command_args, ctx)
        # `list` is a published contract and gets nothing added to it. Every
        # other subcommand's payload is Perry-internal, so the verdict rides
        # along there — an agent reading `--json` should not have to shell out
        # to a second tool to learn its write was allowed under protest.
        if gate is not None and isinstance(result, dict):
            result["conformance"] = gate.as_dict()
    # A value a markdown table row cannot carry. Translated into the ordinary
    # refusal channel here, at the boundary, rather than checked per
    # subcommand: the previous version of this rule lived inside `render_row`
    # as an escape for one character, and the next subcommand to grow a
    # free-text flag walked straight past it. `render_row` raises before
    # `commit()`, so a refusal means nothing was written.
    except UnrenderableCell as exc:
        # **Which flag?** `index` is a column position and means nothing to
        # the person who typed the command, so `--next` and `--title` produced
        # identical refusals and neither said what to fix. Threading a name
        # down to every `render_row` call would touch a dozen write sites; the
        # value the user typed is already in hand, so match it back to the
        # argument that carried it. Exact match only — a near-miss would name
        # the wrong flag, which is worse than naming none.
        where = ""
        for _name in ("next", "title", "deliverable", "verification",
                      "evidence", "promise", "reason", "discharged_by",
                      "note", "risk", "question", "answer"):
            _v = getattr(args, _name, None)
            if isinstance(_v, str) and _v.strip() == exc.value:
                where = "--" + _name.replace("_", "-") + " "
                break
        if not where and exc.field:
            where = exc.field + " "
        msg = (f"{where}was given {exc.value[:60]!r}…, which {exc.why}. "
               "A board cell is one line of a markdown table; pass a summary "
               "and put the long form in an evidence file."
               if len(exc.value) > 60 else
               f"{where}was given {exc.value!r}, which {exc.why}.")
        if args.as_json:
            print(json.dumps({"refused": msg}, ensure_ascii=False, indent=2))
        else:
            print(f"perry-task: refused — {msg}", file=sys.stderr)
        return 1
    except Refused as exc:
        if args.as_json:
            print(json.dumps({"refused": str(exc)}, ensure_ascii=False, indent=2))
        else:
            print(f"perry-task: refused — {exc}", file=sys.stderr)
        return 1

    if args.as_json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    elif args.cmd == "events":
        if result["rotated"]:
            print("  ⚠ the cursor pointed at an event this log no longer "
                  "holds — it was rotated. Restarted from the beginning.")
        for e in result["events"]:
            who = f" [{e['owner'] or e['role']}]" if (e["owner"] or e["role"]) else ""
            move = f"{e['from']}→{e['to']}" if e["to"] else ""
            print(f"  {e['seq']:>4} {e['ts']}  {e['event']:<10} "
                  f"{e['task']:<10} {e['field']:<12} {move}{who}")
            if e["reason"]:
                print(f"       reason: {e['reason'][:70]}")
        print(f"\n  {result['count']} of {result['total']} event(s)"
              + (f" · more: --since {result['cursor']}" if result["more"]
                 else " · caught up"))
    elif args.cmd == "list":
        displayed = (result["tasks"] if args.all else
                     [r for r in result["tasks"] if r["open"]])
        for r in displayed:
            mark = " " if r["open"] else "·"
            title = r["title"] or "(no title in the record)"
            print(f" {mark}{r['id']:10} {r['priority']:3} {r['status']:12} {title[:54]}")
        in_progress = sum(1 for r in result["tasks"]
                          if r["open"] and r["status"] == "in_progress")
        print(f"\n  {result['open']} open · {in_progress} in_progress · "
              f"{result['closed']} closed · "
              f"{result['events']} event(s)")
        # From the payload, not from `displayed`. The third copy of the same
        # filter and the one a human actually reads: recomputing it over the
        # rows on screen made the warning a caption for the listing, so a
        # closed untitled row was invisible here for the same reason it was
        # invisible in the JSON. The listing is scoped by `--all`; the finding
        # is not, and `perry-task retitle` repairs either kind.
        untitled = result["untitled"]
        if untitled:
            print(f"  ⚠ {len(untitled)} id(s) have no title in the record: "
                  f"{', '.join(untitled)}")
    elif args.cmd == "signoff-offer":
        # The numbered fallback, printed as-is. A host WITH a selection UI
        # reads `--json` and renders `options`; this is what Codex shows and
        # what a human reads at a terminal, and both produce the same record.
        print(result["prompt"])
    else:
        verb = "would write" if args.dry_run else "wrote"
        # `commit()` reports a lost event honestly; this line used to say
        # "→ board + journal + event" regardless, so the surface the agent
        # actually reads asserted a write that the function below it had
        # already recorded as failed.
        #
        # It names the STORE first now, because that is what the write writes
        # (ADR-007, TASK-089): `BOARD.md` is rendered from it and is reported
        # beside the event, as the other derived artefact that can fail alone.
        tail = "store + journal"
        for name, ok, why in (
                ("BOARD.md", result.get("board_rendered", True),
                  "BOARD.md not re-rendered — `perry-tasks render --write` regenerates "
                 "it, and `perry-lint` reports `store-drift` until then"),
                ("event", result.get("event_written", True),
                 "event log unwritable — this row will show as `unrecorded` "
                 "until it is fixed")):
            tail += f" + {name}" if ok else f" ({why})"
        # Not every subcommand mints an id — `intake`, `intake-sweep` and
        # `resolve-intake` act on a section row. Printing `None` there told the
        # user the write had no subject when it had a perfectly good one.
        subject = (result.get("id")
                   or (f"{result['swept']} row(s)" if "swept" in result else "")
                   or (f"{result['count']} risk(s)" if "count" in result else "")
                   or (f"intake row {args.id}" if args.id else "the row"))
        print(f"perry-task: {verb} {subject} ({args.cmd}) → {tail}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
