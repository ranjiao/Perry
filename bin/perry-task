#!/usr/bin/env python3
"""
perry-task — the one deterministic way Perry's state gets written.

Perry has nine read tools and, until this one, zero write tools. Every board
row, status change, journal line and ID was produced by an agent typing markdown
by hand — so the law that governs state ("never compute a number by reading
files and eyeballing it") protected the way out and not the way in.

Every mutating call writes three things:

  1. the `BOARD.md` row, rendered from schema/state-schema.json's column order
  2. the `## Status changes` line in journal/<YYYY-MM>/<today>.md
  3. one JSON object appended to .perry/events.jsonl

**(1) and (2) are atomic with each other**: both are staged and renamed, so
either both land or neither does. That is the pair that matters — a board row
without its journal line is exactly the board-vs-history divergence this tool
exists to remove, which makes a partial write there strictly worse than a
refusal.

**(3) is appended after and can fail alone.** It is reported, not raised: the
canonical state is already correct, and the row simply shows as `unrecorded`
until the log is writable. This is the direction the loss is allowed to run,
never the reverse. See `commit()`.

What the tool computes rather than accepts — the payload, per DESIGN-004 § 5.2:
IDs are minted from max(board ∪ journal ∪ events), never reused; timestamps are taken at
call time rather than asserted; `Stage since` / `Arrived` are stamped
structurally; any column a track's mode requires and the board lacks is created
in the same edit; rungs are validated against the schema enum before write.

The event log is DERIVED AND DISPOSABLE. Delete .perry/events.jsonl and Perry
still works — markdown is canonical. What is lost is history resolution and
drift detection, not truth. That constraint is what keeps this from becoming a
database with a markdown export.

That claim was false for one thing until `mint_id` learned to read the journal:
ID uniqueness depended on the log, so deleting it reissued the number of every
closed task. Anything load-bearing that lives only in this file is a bug in the
same class — the file is allowed to make Perry *slower to explain itself*, never
*wrong*.

Usage:
  perry-task add   --title "…" [--track T] [--owner O] [--priority P0|P1|P2]
                   [--next "…"] [--parent ID] [--commitment ID] [--stage S]
                   [--arrived YYYY-MM-DD]
  perry-task start <ID> [--next "…"]
  perry-task stage <ID> --stage <name>
  perry-task intake --title "…" [--arrived YYYY-MM-DD]
  perry-task ask    --needed "…" [--blocks <ID>] [--arrived YYYY-MM-DD]
  perry-task answer <USER-ID> --answer "…"
  perry-task risk-add   --title "…" [--opened YYYY-MM-DD]
  perry-task risk-clear <RX-ID> --reason "…"
  perry-task route <n> --track T [--priority P1] [--stage S] [--owner O]
                   [--commitment ID]
  perry-task resolve-intake <n> --outcome dropped|deferred --reason "…"
  perry-task drop  <ID> --reason "…"
  perry-task status <ID> --status blocked|review|not_started|in_progress
                    [--reason "…"] [--next "…"]
  perry-task done  <ID> --evidence <path> [--rung V1..V6]
  perry-task list  [--all] [--track T] [--json]

  --root <path>   project root; default $PERRY_PROJECT, else walk up from cwd
  --dry-run       print what would be written; touch nothing
  --json          machine-readable result
  --actor <name>  who is making the change; stamped into every event. Accepted
                  by every subcommand and defaulted rather than required —
                  DESIGN-004 § 8 asks whether it should be mandatory, and until
                  that is answered an unset actor is recorded as unset rather
                  than guessed.

Exit codes:
  0  written (or, with --dry-run, would be)
  1  refused — the reason is printed and nothing was written
  2  bad invocation / unreadable schema

No LLM, no external dependencies (stdlib only). DESIGN-004.
"""

from __future__ import annotations

import contextlib
import fcntl
import hashlib
import json
import os
import re
import sys
import tempfile
import time
from datetime import date, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
PERRY_HOME = Path(os.environ.get("PERRY_HOME") or HERE.parent).resolve()
SCHEMA_PATH = PERRY_HOME / "schema" / "state-schema.json"

sys.path.insert(0, str(PERRY_HOME / "viewer"))
import parsers as P  # noqa: E402


class Refused(Exception):
    """A refusal is a first-class outcome, not a crash. Nothing was written."""


# The `list --json` payload is a published contract with its own version, kept
# separate from Perry's because the whole point is that it does NOT move when
# Perry's storage does. Bump the minor for an ADDED key; the major only for a
# removed or retyped one. Specified in `schema/task-list-contract.md`.
LIST_CONTRACT = "perry-task/list/1.2"

# Which events describe a TASK. `## Intake`, `## User Input Queue` and
# `## Top risks` rows go through the same three-way commit and land in the same
# event log, but they are not tasks and must never appear in `list`'s `tasks[]`.
TASK_EVENTS = {"add", "start", "stage", "status", "done", "drop", "route"}


# ── schema ────────────────────────────────────────────────────────────────


def load_schema() -> dict:
    if not SCHEMA_PATH.exists():
        raise Refused(f"schema not found at {SCHEMA_PATH}")
    return json.loads(SCHEMA_PATH.read_text())


def board_table_spec(schema: dict) -> dict:
    board = next(f for f in schema["files"] if f["id"] == "board")
    return next(t for t in board["tables"] if "P[012]" in t["under"])


def columns_for(values: dict) -> list[str]:
    """Every column this row actually sets, beyond the six every board has.

    Derived from the row rather than from a per-mode table. The table version
    listed `Track`/`Stage`/`Stage since`/`Arrived`/`Parent` and omitted
    `Commitment` — so `--commitment` was accepted, stored into `values`, and
    then dropped by `append_row`, which maps values onto headers and had no
    header to map it to. Exit 0, success message, no cell. That silently
    emptied the scan `modes/queue.md` builds on ("given a commitment due this
    week, which board rows carry its id") and reproduced, for the one column
    the earlier review did not enumerate, the same defect that lost `Arrived`
    at routing a round before.

    A list of columns and a list of values written down separately will drift;
    one derived from the other cannot.
    """
    return [display for key, display in
            ((norm(k), canonical_column(k)) for k in values)
            if key not in REQUIRED_KEYS]


ABSENT = {"", "—", "-", "–", "n/a", "na", "tbd", "无", "none"}


def evidence_paths(cell: str, state_root: Path, project_root: Path) -> tuple[list[str], list[str]]:
    """Split an `Evidence` cell into paths, resolved against a real root.

    The column is free text that people put several things in. One real row:

        `schema/state-schema.json`, `state/adoption_dossier_TEMPLATE.md`, …

    — a comma-separated list, each span backticked, and relative to the
    *project* root while the contract declared `state_root`. Both conventions
    are live in that same column on that same board, and nothing in the string
    distinguishes them.

    Perry knows both roots, so Perry resolves. Returning the raw string and a
    rule would push the guess onto every consumer, and a guess in a consumer is
    how the last divergence started. Each returned path is relative to
    `project_root` and **exists**; spans that resolve nowhere come back
    separately so they can be reported rather than rendered as dead links.
    """
    raw = (cell or "").strip()
    if raw.lower() in ABSENT:
        return [], []
    spans = re.findall(r"`([^`]+)`", raw)
    if not spans:
        spans = [s.strip() for s in re.split(r"[,，;；]", raw) if s.strip()]
    found, unresolved = [], []
    for s in spans:
        # `path § Section` and `path (12 tests)` are both in circulation; the
        # path is the head of the span.
        cand = re.split(r"\s+§|\s+\(", s.strip())[0].strip().rstrip(",.")
        if not cand or cand.lower() in ABSENT:
            continue
        for root in (state_root, project_root):
            p = (root / cand)
            if p.exists():
                try:
                    found.append(str(p.resolve().relative_to(project_root.resolve())))
                except ValueError:
                    found.append(str(p.resolve()))
                break
        else:
            unresolved.append(cand)
    return found, unresolved


def canonical_column(key: str) -> str:
    """`"stage since"` → `"Stage since"` — the schema's own spelling."""
    if _ALIASES is None:
        _build_column_maps()
    return (_DISPLAY.get(norm(key)) or {}).get("en", key.title())


# ── board ─────────────────────────────────────────────────────────────────


PRIORITY_RE = {p: re.compile(rf"^##\s+{p}\b") for p in ("P0", "P1", "P2")}


class Board:
    """`BOARD.md` as lines, edited in place and rendered back byte-for-byte.

    Text-level rather than model-level on purpose: TASK-029's verification is
    that a tool-written board is byte-identical to the hand-written one it
    replaces. Round-tripping through a parsed model would normalize whitespace,
    alignment and column order — and every downstream reader keys on those.
    """

    def __init__(self, path: Path):
        self.path = path
        if not path.exists():
            raise Refused(f"no BOARD.md at {path}")
        self.lines = path.read_text().split("\n")

    # -- locating

    def section(self, priority: str) -> tuple[int, int]:
        """(first line index, end index) of the given priority section."""
        start = None
        for i, line in enumerate(self.lines):
            if PRIORITY_RE[priority].match(line):
                start = i
                continue
            if start is not None and line.startswith("## "):
                return start, i
        if start is None:
            raise Refused(f"BOARD.md has no `## {priority}` section")
        return start, len(self.lines)

    def table(self, priority: str) -> tuple[int, int, list[str]]:
        """(header index, separator index, header cells) for a section's table."""
        lo, hi = self.section(priority)
        for i in range(lo, hi):
            if re.match(r"^\|\s*:?-{2,}", self.lines[i]) and i > lo:
                header = split_row(self.lines[i - 1])
                return i - 1, i, header
        raise Refused(f"`## {priority}` has no table")

    def last_row(self, priority: str) -> int:
        """Index of the last data row, or the separator when there are none."""
        _, sep, _ = self.table(priority)
        lo, hi = self.section(priority)
        last = sep
        for i in range(sep + 1, hi):
            if self.lines[i].strip().startswith("|"):
                last = i
            elif self.lines[i].strip():
                break
        return last

    # -- reading

    def rows(self) -> list[tuple[str, str, dict]]:
        """(priority, raw line, cells-by-header) for every data row."""
        out = []
        for pri in ("P0", "P1", "P2"):
            try:
                hdr_i, sep, header = self.table(pri)
            except Refused:
                continue
            lo, hi = self.section(pri)
            for i in range(sep + 1, hi):
                s = self.lines[i].strip()
                if not s.startswith("|"):
                    if s:
                        break
                    continue
                cells = split_row(self.lines[i])
                if not cells or not cells[0]:
                    continue
                out.append((pri, self.lines[i],
                            dict(zip([norm(h) for h in header], cells))))
        return out

    # Sections that hold something other than task rows. Matched against the
    # canonical name and its `i18n.headings` aliases, so a localized board is
    # skipped for the same reasons an English one is.
    NON_TASK_SECTIONS = ("Intake", "Cadence", "User Input Queue", "Top risks")

    def _task_sections(self):
        """(heading, priority|None, separator index, header cells, end index).

        The ONE walk over the board's task-bearing sections. `task_tables()`
        (read) and `find()` (write) both go through it, because they drifted
        the moment they did not: the reader was taught to see every section and
        the finder was left on P0/P1/P2, so 20 rows in a project's own
        `## Done this period` archive were listed by `list` and refused by
        `done` with "is not an open row on the board" — a message that was
        false, about rows the same tool had just printed.
        """
        skip = {s.lower() for name in self.NON_TASK_SECTIONS
                for s in heading_spellings(name)}
        heads = [(i, l) for i, l in enumerate(self.lines) if l.startswith("## ")]
        for n, (start, line) in enumerate(heads):
            end = heads[n + 1][0] if n + 1 < len(heads) else len(self.lines)
            title = line[3:].strip()
            if any(title.lower().startswith(s) for s in skip):
                continue
            sep = next((i for i in range(start, end)
                        if re.match(r"^\|\s*:?-{2,}", self.lines[i]) and i > start
                        and self.lines[i - 1].strip().startswith("|")), None)
            if sep is None:
                continue
            pri = next((p for p in ("P0", "P1", "P2")
                        if PRIORITY_RE[p].match(line)), None)
            yield title, pri, sep, split_row(self.lines[sep - 1]), end

    def task_tables(self) -> list[dict]:
        """Every section of this board that holds task-shaped rows.

        `rows()` looks only at `## P0` / `## P1` / `## P2`, which is right for
        the WRITE path — a new row needs a priority and those are the only
        sections that mean one. It is wrong for the read path, and silently so.

        A real Perry project checked while writing this organizes its board by
        workstream: `## Open — 投资线`, `## Open — 工程线 · phase #004`,
        `## ✅ v2.0 build — DEPLOYED`, `## Backbone`, and one `## P2`. Reading
        only P0/P1/P2 found the single section whose name happened to match,
        reported three tasks for a project with dozens, and — because it never
        checked what it was reading — picked up rows from a `## ID prefixes`
        reference table as though they were work. A front-end handed that
        payload shows the user confident nonsense.

        So: every `## ` section whose table resolves at least `ID` and `Title`
        is a task table. `P0`/`P1`/`P2` carry their priority; anything else
        carries its heading as `group` and no priority, because inventing one
        would be claiming the project said something it did not.
        """
        out = []
        for title, pri, sep, header, end in self._task_sections():
            keys = [norm(h) for h in header]
            if "id" not in keys or "title" not in keys:
                # A table under a `## ` heading that is not a task table — a
                # reference table, a glossary, a legend. Reported, not read.
                out.append({"heading": title, "priority": None, "header": header,
                            "rows": [], "readable": False})
                continue
            rows = []
            for i in range(sep + 1, end):
                s = self.lines[i].strip()
                if not s.startswith("|"):
                    if s and not s.startswith(("#", ">")):
                        break
                    continue
                cells = split_row(self.lines[i])
                if cells and cells[0]:
                    rows.append(dict(zip(keys, cells)))
            out.append({"heading": title, "priority": pri, "header": header,
                        "rows": rows, "readable": True})
        return out

    def find(self, task_id: str) -> tuple[str, int, list[str], list[str]]:
        """(priority-or-heading, line index, header, cells) for one row.

        Searches EVERY task-bearing section, not only `P0`/`P1`/`P2`. Needing a
        priority is a rule about `add` — a new row has to be filed somewhere —
        and it was wrongly applied to the whole write path. Locating a row that
        already exists is a different question, and answering it "not on the
        board" about a row `list` had just printed made every archived row
        permanently unclosable.
        """
        for title, pri, sep, header, end in self._task_sections():
            for i in range(sep + 1, end):
                if not self.lines[i].strip().startswith("|"):
                    continue
                cells = split_row(self.lines[i])
                if cells and cells[0].replace("*", "").replace("~", "").strip() == task_id:
                    return pri or title, i, header, cells
        raise Refused(f"{task_id} is not a row on the board")

    # -- writing

    def ensure_columns(self, priority: str, needed: list[str]) -> list[str]:
        """Add any missing column to the header, separator and every row.

        The clause only `Verification` had before DESIGN-004: you cannot set a
        cell in a column with no header, and `BOARD_TEMPLATE.md` ships six.
        """
        hdr_i, sep_i, header = self.table(priority)
        missing = [c for c in needed
                   if not any(norm(h) == norm(c) for h in header)]
        if not missing:
            return header
        # A column joining a localized table is written in that table's
        # language. Appending `Stage` beside `阶段序列` would produce a header
        # in two languages and a column `perry-lint`'s localized `match`
        # regexes would then disagree about.
        lang = header_language(header)
        missing = [display_name(c, lang) for c in missing]
        header = header + missing
        self.lines[hdr_i] = render_row(header)
        self.lines[sep_i] = "|" + "|".join(["---"] * len(header)) + "|"
        lo, hi = self.section(priority)
        for i in range(sep_i + 1, hi):
            if not self.lines[i].strip().startswith("|"):
                continue
            cells = split_row(self.lines[i])
            if not cells:
                continue
            self.lines[i] = render_row(cells + [""] * len(missing))
        return header

    def ensure_section(self, heading: str, columns: list[str],
                       before_p0: bool = True) -> None:
        """Create `## <heading>` with its table if the board lacks it.

        `## Intake` is the organ queue mode is built on and the first thing
        `triage` walks. Nothing created it before DESIGN-004, so step 0 gated
        itself on "only applies when the section exists" and no-opped forever
        for every queue track ever made.

        `## Intake` is inserted before `## P0` so it reads above the work it
        becomes, which is the order `modes/queue.md` describes it in. Every
        other section is appended, because that is where `BOARD_TEMPLATE.md`
        puts them — `## User Input Queue` created above the board pushed the
        work below a list of open questions, which is not what a standup reads
        first.

        Heading and columns are both written in the board's own language.
        `ensure_columns` localized new headers and explained why in the same
        round this method was added, and this one hardcoded English — so a
        localized board got `## Intake | Arrived | Request | Outcome |` bolted
        onto a `编号 | 标题 | …` table. One of two siblings fixed is the shape
        every review round here has found.
        """
        rx = heading_re(heading)
        if any(rx.match(l) for l in self.lines):
            return
        try:
            lang = header_language(self.table("P0")[2])
        except Refused:
            lang = "en"
        shown = next((s for s in heading_spellings(heading)[1:]
                      if lang != "en"), heading)
        columns = [display_name(c, lang) for c in columns]
        anchor = (next((i for i, l in enumerate(self.lines)
                        if PRIORITY_RE["P0"].match(l)), len(self.lines))
                  if before_p0 else len(self.lines))
        block = [f"## {shown}", "", render_row(columns),
                 "|" + "|".join(["---"] * len(columns)) + "|", ""]
        self.lines[anchor:anchor] = block

    def named_section(self, heading: str) -> tuple[int, int]:
        """(heading line index, end index) for a named `## ` section.

        The span, not the table — `section_table` answers "where are this
        section's columns" and raises when there are none, which is the right
        answer for a reader and useless to the one caller that has to look at a
        section precisely BECAUSE it is not a table yet.
        """
        rx = heading_re(heading)
        start = next((i for i, l in enumerate(self.lines) if rx.match(l)), None)
        if start is None:
            raise Refused(f"BOARD.md has no `## {heading}` section")
        end = next((i for i in range(start + 1, len(self.lines))
                    if self.lines[i].startswith("## ")), len(self.lines))
        return start, end

    def has_section(self, heading: str) -> bool:
        rx = heading_re(heading)
        return any(rx.match(l) for l in self.lines)

    def section_table(self, heading: str) -> tuple[int, list[str]]:
        """(separator index, header cells) for a named non-priority section."""
        rx = heading_re(heading)
        start = next((i for i, l in enumerate(self.lines) if rx.match(l)), None)
        if start is None:
            raise Refused(f"BOARD.md has no `## {heading}` section")
        for i in range(start, len(self.lines)):
            if self.lines[i].startswith("## ") and i > start:
                break
            if re.match(r"^\|\s*:?-{2,}", self.lines[i]) and i > start:
                return i, split_row(self.lines[i - 1])
        raise Refused(f"`## {heading}` has no table")

    def section_rows(self, heading: str) -> list[tuple[int, list[str]]]:
        sep, _ = self.section_table(heading)
        out = []
        for i in range(sep + 1, len(self.lines)):
            s = self.lines[i].strip()
            if s.startswith("## "):
                break
            if not s.startswith("|"):
                if s:
                    break
                continue
            cells = split_row(self.lines[i])
            if cells and cells[0]:
                out.append((i, cells))
        return out

    def ensure_section_columns(self, heading: str, needed: list[str]) -> list[str]:
        """`ensure_columns`, for a named non-priority section.

        Its sibling existed for the priority tables from the day mode columns
        landed; this one did not, so a board that already had
        `## User Input Queue` without `Asked` had nowhere to put the date and
        the tool would have dropped it silently — the same defect that lost
        `--commitment` on the task tables.
        """
        sep, header = self.section_table(heading)
        missing = [c for c in needed
                   if not any(norm(h) == norm(c) for h in header)]
        if not missing:
            return header
        lang = header_language(header)
        header = header + [display_name(c, lang) for c in missing]
        self.lines[sep - 1] = render_row(header)
        self.lines[sep] = "|" + "|".join(["---"] * len(header)) + "|"
        for i, cells in self.section_rows(heading):
            self.lines[i] = render_row(cells + [""] * len(missing))
        return header

    def find_section_row(self, heading: str, row_id: str):
        """(line index, header, cells) for one row of a named section."""
        _, header = self.section_table(heading)
        for i, cells in self.section_rows(heading):
            if cells and cells[0].replace("*", "").replace("~", "").strip() == row_id:
                return i, header, cells
        raise Refused(f"{row_id} is not a row in `## {heading}`")

    def append_section_row(self, heading: str, values: dict) -> str:
        sep, header = self.section_table(heading)
        rows = self.section_rows(heading)
        at = (rows[-1][0] if rows else sep) + 1
        line = render_row([values.get(norm(h), "") for h in header])
        self.lines.insert(at, line)
        return line

    def append_row(self, priority: str, values: dict) -> str:
        _, _, header = self.table(priority)
        check_header(header)
        cells = [values.get(norm(h), "") for h in header]
        line = render_row(cells)
        self.lines.insert(self.last_row(priority) + 1, line)
        return line

    def replace_row(self, index: int, header: list[str], values: dict) -> str:
        check_header(header)
        cells = [values.get(norm(h), "") for h in header]
        self.lines[index] = render_row(cells)
        return self.lines[index]

    def remove_row(self, index: int) -> str:
        return self.lines.pop(index)

    def text(self) -> str:
        return "\n".join(self.lines)


def split_row(line: str) -> list[str]:
    cells = [c.strip() for c in line.strip().strip("|").split("|")]
    return cells


def render_row(cells: list[str]) -> str:
    return "| " + " | ".join(c.strip() for c in cells) + " |"


def squash(s: str) -> str:
    """Whitespace/decoration only — no language knowledge."""
    return re.sub(r"[\s`*]+", " ", s).strip().lower()


_ALIASES: dict[str, str] | None = None
_DISPLAY: dict[str, dict[str, str]] | None = None


def _build_column_maps() -> None:
    """Read `schema § i18n.columns` once — every spelling of every header.

    `perry-task` was the single component in this stack that never consulted
    this table. `perry-state`, `perry-lint` and the viewer all resolve headers
    through it; the writer keyed rows on hardcoded English. Because TASK-033
    routed *every* board write through this tool, that made it the one
    component able to corrupt a board written in the document language Perry
    advertises — and it did, silently, at exit 0: `add` wrote a row of empty
    cells on a `编号 | 标题 | …` board while the journal line and the event
    both asserted the task existed. The tool built to eliminate board-vs-history
    divergence produced it on its first write.

    Perry's own board is English, so no amount of dogfooding could surface
    this. Three review rounds read the migration and missed it for the same
    reason.
    """
    global _ALIASES, _DISPLAY
    aliases: dict[str, str] = {}
    display: dict[str, dict[str, str]] = {}
    try:
        columns = load_schema()["i18n"]["columns"]
    except Exception:
        columns = {}
    for canon, langs in columns.items():
        key = squash(canon)
        # First spelling wins: the table maps two English columns onto one
        # Chinese word in at least one case (`Deadline` / `By when` → 截止),
        # and an arbitrary-but-stable choice beats one that depends on dict
        # ordering. Neither is a board column, so no board write is affected.
        aliases.setdefault(key, key)
        display.setdefault(key, {"en": canon})
        for lang, names in (langs or {}).items():
            for name in names:
                aliases.setdefault(squash(name), key)
                display[key].setdefault(lang, name)
    _ALIASES, _DISPLAY = aliases, display


def norm(s: str) -> str:
    """A header cell → the canonical key rows are stored under.

    Applied to header cells and to canonical English column names, which is
    every use: a localized header and its English name resolve to one key, so
    `values["status"]` lands in `状态` without any call site knowing that.
    """
    if _ALIASES is None:
        _build_column_maps()
    k = squash(s)
    return _ALIASES.get(k, k)


def header_language(header: list[str]) -> str:
    """Which language this table's headers are already written in.

    Read off the board rather than out of `.perry/config.md`: a new column has
    to match the row it is joining, and the header is the only thing that
    states that without a second file being right.
    """
    if _ALIASES is None:
        _build_column_maps()
    for cell in header:
        key = norm(cell)
        for lang, name in (_DISPLAY.get(key) or {}).items():
            if lang != "en" and squash(name) == squash(cell):
                return lang
    return "en"


def display_name(canonical: str, lang: str) -> str:
    """The spelling a column gets when this board is missing it."""
    if _ALIASES is None:
        _build_column_maps()
    return (_DISPLAY.get(norm(canonical)) or {}).get(lang, canonical)


_HEADINGS: dict[str, dict[str, str]] | None = None


def heading_spellings(name: str) -> list[str]:
    """Every spelling of a `## <heading>`, canonical English first.

    `ensure_section` and `section_table` matched the English name exactly, so on
    a board that already carried `## 收件` the tool did not see it, appended a
    second `## Intake`, and then read and wrote only the new English one —
    leaving the queue the user was actually filling unreachable by every
    subcommand. `perry-lint` reports the duplicate clean, because the schema
    declares `^Intake\\b|^收件` for the table and says nothing about there being
    one of them.
    """
    global _HEADINGS
    if _HEADINGS is None:
        try:
            _HEADINGS = load_schema()["i18n"].get("headings", {})
        except Exception:
            _HEADINGS = {}
    out = [name]
    for names in (_HEADINGS.get(name) or {}).values():
        out += list(names)
    return out


def heading_re(name: str) -> re.Pattern:
    return re.compile(r"^##\s+(?:%s)\b" %
                      "|".join(re.escape(s) for s in heading_spellings(name)))


REQUIRED_KEYS = ("id", "title", "owner", "status", "next action", "evidence")


def check_header(header: list[str]) -> None:
    """Refuse to write against a header whose columns we cannot place.

    Without this the failure is a row of blank cells and exit 0 — the tool
    reporting success while writing nothing the row means. A refusal names the
    header it could not read; a blank row names nothing.
    """
    keys = {norm(h) for h in header}
    missing = [k for k in REQUIRED_KEYS if k not in keys]
    if missing:
        raise Refused(
            f"BOARD.md's columns cannot be resolved: no header matches "
            f"{missing}. Found {header}. Column headers may be written in the "
            f"document language, but only spellings listed in "
            f"`schema/state-schema.json § i18n.columns` are recognized — "
            f"nothing was written")


# ── ids ───────────────────────────────────────────────────────────────────


ID_RE = re.compile(r"\bTASK-(\d+)\b")


def mint_id(board: Board, events: list[dict], state_root: Path | None = None) -> str:
    """Next id from max(board ∪ journal ∪ events).

    A task whose row has closed still owns its number — reading only the board
    would hand a live id to a second task and silently re-point every reference
    to the first.

    **The journal is why this is safe, and it was missing.** Board and events
    alone put ID uniqueness at the mercy of `.perry/events.jsonl`, which this
    tool declares derived and disposable: delete it, and the next `add` reissues
    the number of every already-closed task, because a closed task is in neither
    remaining source. The docstring promised that deleting the log costs
    "history resolution and drift detection, not truth" — a reused id IS truth,
    and every journal line, evidence file and commit message naming the old task
    silently re-points to the new one.

    The journal closes it: it is canonical, append-only, and carries a creation
    line for every task ever raised — the one record that every procedure here
    forbids editing, including on drop and close. So an id is never reissued as
    long as the canonical files survive, and the disposable file is genuinely
    disposable again.
    """
    seen = {int(m) for _, line, _ in board.rows() for m in ID_RE.findall(line)}
    seen |= {int(m) for e in events for m in ID_RE.findall(e.get("id", ""))}
    seen |= {int(m) for m in ID_RE.findall(board.text())}
    if state_root is not None:
        for p in sorted((state_root / "journal").rglob("*.md")):
            try:
                seen |= {int(m) for m in ID_RE.findall(p.read_text(errors="replace"))}
            except OSError:
                continue
    return f"TASK-{max(seen, default=0) + 1:03d}"


# ── events ────────────────────────────────────────────────────────────────


def events_path(project_root: Path) -> Path:
    return project_root / ".perry" / "events.jsonl"


def read_events(project_root: Path) -> list[dict]:
    p = events_path(project_root)
    if not p.exists():
        return []
    out = []
    for line in p.read_text(errors="replace").split("\n"):
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue  # a corrupt line is not a reason to refuse a write
    return out


# ── the atomic three-way write ────────────────────────────────────────────


def commit(project_root: Path, state_root: Path, board: Board,
           journal_line: str, event: dict, dry_run: bool) -> dict:
    """Write the two canonical files together, then the derived event.

    **The guarantee, stated exactly.** `BOARD.md` and the journal are staged to
    temp files and renamed (atomic on POSIX), so either both land or neither
    does — that pair is what "atomic" covers, and it is the pair that matters,
    because a board row without its journal line is the divergence this tool
    exists to remove. The event is appended *after*, and can fail on its own.

    So the honest claim is: **the canonical files never disagree with each
    other; the derived record may be missing.** Four surfaces used to say "none
    of the three if any would fail", which is stronger and false — an
    unwritable `.perry/` left the row and the journal line on disk and the
    event absent, as an uncaught traceback. A guarantee overstated in prose is
    the same defect as one asserted in a row nothing implements.

    That direction of failure is chosen, not tolerated: DESIGN-004 declares the
    event log derived and disposable, and a missing event is exactly the
    `unrecorded` condition drift reconciliation reports. Losing an event costs
    history resolution. Losing a board write costs the truth.
    """
    jpath = state_root / "journal" / f"{date.today():%Y-%m}" / f"{date.today():%Y-%m-%d}.md"
    plan = {
        "board": str(board.path),
        "journal": str(jpath),
        "events": str(events_path(project_root)),
        "journal_line": journal_line,
        "event": event,
    }
    if dry_run:
        return plan

    jtext = ""
    if jpath.exists():
        jtext = jpath.read_text()
    elif not jpath.parent.exists():
        jpath.parent.mkdir(parents=True, exist_ok=True)
    jtext = append_status_change(jtext, journal_line)

    # Stage both canonical files before renaming either.
    staged: list[tuple[str, Path]] = []
    try:
        for path, text in ((board.path, board.text()), (jpath, jtext)):
            fd, tmp = tempfile.mkstemp(dir=str(path.parent), suffix=".tmp")
            with os.fdopen(fd, "w") as fh:
                fh.write(text)
                fh.flush()
                os.fsync(fh.fileno())
            staged.append((tmp, path))
        while staged:
            # Pop as we go. Clearing the whole list inside the loop meant a
            # failure on the second rename left the first temp file orphaned
            # beside BOARD.md with nothing to clean it up.
            tmp, path = staged.pop(0)
            os.replace(tmp, path)
    finally:
        for tmp, _ in staged:
            try:
                os.unlink(tmp)
            except OSError:
                pass

    plan["event_written"] = True
    ev = events_path(project_root)
    try:
        ev.parent.mkdir(parents=True, exist_ok=True)
        with open(ev, "a") as fh:
            fh.write(json.dumps(event, ensure_ascii=False) + "\n")
    except OSError as exc:
        # The canonical write already landed and is correct. Report the loss
        # instead of crashing: a traceback here would suggest the whole call
        # failed, and the caller would be right to retry it — producing a
        # second row for work already recorded.
        plan["event_written"] = False
        print(f"perry-task: warning — {board.path.name} and the journal were "
              f"written, but the event could not be appended to {ev}: {exc}. "
              f"State is correct; this row will show as `unrecorded` at the "
              f"next standup until the log is writable again.", file=sys.stderr)
    return plan


def append_status_change(text: str, line: str) -> str:
    """Append under the LAST `## Status changes` of the day, creating it if none.

    The last, not the first. A day's journal accumulates one `## Status changes`
    per entry — this session's had seventeen — and appending to the first buries
    a change that happened at 18:33 inside the block written at 09:00. The file
    stays chronological only if new lines land at the end of it, which is the
    whole point of an append-only record.
    """
    if not text.strip():
        text = f"# {date.today():%Y-%m-%d}\n"
    lines = text.split("\n")
    starts = [i for i, l in enumerate(lines) if l.strip() == "## Status changes"]
    if not starts:
        return text.rstrip("\n") + "\n\n## Status changes\n\n" + line + "\n"

    start = starts[-1]
    # Walk to the end of that section's list: past its blank line, over its
    # bullets and table rows, stopping at the next heading or at prose.
    i = start + 1
    last_item = start
    while i < len(lines):
        s = lines[i].strip()
        if s.startswith("#"):
            break
        if s.startswith("- ") or s.startswith("|"):
            last_item = i
        elif s:
            break
        i += 1
    lines.insert(last_item + 1, line)
    return "\n".join(lines)


# ── subcommands ───────────────────────────────────────────────────────────


def stages_of(schema: dict, track: dict) -> list[str]:
    """The track's declared stage vocabulary, else its mode's default."""
    return (split_stages(track.get("stages", ""))
            or default_stages(schema, track["mode"]))


def check_stage(track: dict, stages: list[str], stage: str) -> None:
    """Refuse a stage outside the track's vocabulary — on creation as on moves.

    `stage` enforced this from the day it shipped. `add` and `route` took
    `--stage` verbatim, so `--stage bogus` wrote a cell no reader can classify
    and exited 0: the vocabulary was checked when a row *moved* and not when it
    was *born*, which is the one moment the cell has no prior value to fall
    back to.
    """
    if stage and stages and stage not in stages:
        raise Refused(f"stage {stage!r} is not in track {track['track']!r}'s "
                      f"vocabulary {stages}")


def track_of(config: dict, name: str) -> dict:
    for t in config.get("tracks", []):
        if t["track"] == name:
            return t
    if name and name != "main":
        raise Refused(
            f"track {name!r} is not declared in `.perry/config.md § Tracks`; "
            f"declared: {[t['track'] for t in config.get('tracks', [])]}")
    return {"track": "main", "mode": "project", "default_rung": ""}


def cmd_add(args, ctx) -> dict:
    if not args.title:
        raise Refused("--title is required")
    track = track_of(ctx["config"], args.track or "main")
    mode = track["mode"]
    tid = mint_id(ctx["board"], ctx["events"], ctx["state_root"])
    priority = args.priority or "P1"
    if priority not in ("P0", "P1", "P2"):
        raise Refused(f"priority {priority!r} is not one of P0/P1/P2")

    if mode == "project" and args.stage:
        # Project mode has no stages at all, so there is no vocabulary to check
        # the value against and nowhere for it to land. Swallowing it is the
        # same silent discard `--commitment` used to perform: the caller
        # believes they set something.
        raise Refused(
            f"track {track['track']!r} is mode `project`, which has no stages "
            f"(`modes/project.md`); --stage has nowhere to go")

    today = f"{date.today():%Y-%m-%d}"
    values = {
        "id": tid, "title": args.title,
        "owner": args.owner or "Coding Agent",
        "status": "not_started",
        "next action": args.next or "—",
        "evidence": "—",
    }
    if mode != "project":
        values["track"] = track["track"]
        stages = stages_of(ctx["schema"], track)
        check_stage(track, stages, args.stage)
        # Queue rows raised directly skip intake, so they start at the first
        # POST-intake stage — the same one `route` assigns. `new` means "sitting
        # in intake", and a row that never was there should not claim it.
        first = (stages[1] if mode == "queue" and len(stages) > 1
                 else (stages[0] if stages else ""))
        values["stage"] = args.stage or first
        if mode == "queue":
            values["arrived"] = args.arrived or today
        else:
            values["stage since"] = today
        if args.parent:
            values["parent"] = args.parent
    if args.commitment:
        values["commitment"] = args.commitment

    # Run the real path in both cases. `commit()` is what `--dry-run` skips;
    # everything up to it happens for real against the in-memory Board, which is
    # discarded when the process exits.
    #
    # Previously the dry run took a shortcut, and it lied twice: it never called
    # `check_header`, so a board the real call refuses previewed a row and
    # exited 0 — "the tool reporting success while writing nothing the row
    # means" is `check_header`'s own reason for existing. And it rendered from a
    # hardcoded six-name tuple, so `--commitment` and `--track` were invisible
    # in the preview while the real write set them. A preview that is not the
    # write is worse than no preview.
    ctx["board"].ensure_columns(priority, columns_for(values))
    if mode == "queue":
        # The section `triage` step 0 walks. Nothing created it before, so
        # step 0's "only applies when the section exists" gate no-opped
        # forever for every queue track ever made.
        ctx["board"].ensure_section("Intake", ["Arrived", "Request", "Outcome"])

    line = ctx["board"].append_row(priority, values)
    jline = (f"- [{tid}] — → not_started · {args.title} · "
             f"owner: {values['owner']} · priority: {priority}")
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "add",
             "id": tid, "title": args.title, "track": track["track"], "mode": mode,
             "priority": priority, "actor": args.actor,
             "from": None, "to": "not_started"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "priority": priority, "row": line, **plan}


def cmd_start(args, ctx) -> dict:
    tid = args.id
    pri, idx, header, cells = ctx["board"].find(tid)
    values = dict(zip([norm(h) for h in header], cells))
    prev = values.get("status", "")
    if prev == "in_progress":
        raise Refused(f"{tid} is already in_progress")
    values["status"] = "in_progress"
    if args.next:
        values["next action"] = args.next
    if "stage since" in values:
        values["stage since"] = f"{date.today():%Y-%m-%d}"
    line = ctx["board"].replace_row(idx, header, values)
    jline = f"- [{tid}] {prev or '—'} → in_progress · started"
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "start",
             "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"),
             "actor": args.actor, "from": prev, "to": "in_progress"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "row": line, **plan}


def cmd_done(args, ctx) -> dict:
    tid = args.id
    if not args.evidence:
        raise Refused(
            f"{tid}: --evidence is required. Perry refuses `done` without it — "
            f"a claim of done that cites nothing is a claim about confidence, "
            f"not about the work")
    rungs = ctx["schema"]["enums"]["verification_rung"]
    rung = args.rung
    if rung and rung not in rungs:
        raise Refused(f"rung {rung!r} is not one of {rungs}")
    if rung == "V0":
        raise Refused(
            "V0 is 'asserted' — it is the name for what is being refused, "
            "never a rung a row may carry")
    pri, idx, header, cells = ctx["board"].find(tid)
    values = dict(zip([norm(h) for h in header], cells))
    prev = values.get("status", "")
    if not rung:
        track = track_of(ctx["config"], values.get("track", "main"))
        rung = (track.get("default_rung")
                or ctx["schema"]["work_modes"]["modes"][track["mode"]]["default_rung"])
    line = ctx["board"].remove_row(idx)
    jline = (f"- [{tid}] {prev or '—'} → done · closed · "
             f"evidence: `{args.evidence}` · verification: {rung}")
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "done",
             "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"),
             "actor": args.actor, "from": prev, "to": "done",
             "evidence": args.evidence, "rung": rung}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "rung": rung, "removed": line, **plan}


def cmd_stage(args, ctx) -> dict:
    """Move an item to a new stage and re-stamp its clock in the same write.

    Unconditional. `Stage` and `Status` are orthogonal by design, so a
    `draft → review` move produces no status change and would otherwise leave
    no trace anywhere — which is exactly how the dwell-time rule survived three
    review rounds as prose that nothing could compute.
    """
    tid, stage = args.id, args.stage
    if not stage:
        raise Refused("a stage is required: perry-task stage <ID> --stage <name>")
    pri, idx, header, cells = ctx["board"].find(tid)
    values = dict(zip([norm(h) for h in header], cells))
    track = track_of(ctx["config"], values.get("track", "main"))
    stages = stages_of(ctx["schema"], track)
    check_stage(track, stages, stage)
    prev = values.get("stage", "")
    if prev == stage:
        raise Refused(f"{tid} is already at stage {stage!r}")
    values["stage"] = stage
    values["stage since"] = f"{date.today():%Y-%m-%d}"
    line = ctx["board"].replace_row(idx, header, values)
    jline = f"- [{tid}] stage {prev or '—'} → {stage}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "stage",
             "id": tid, "title": values.get("title", ""),
             "track": track["track"], "actor": args.actor,
             "from": prev, "to": stage}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "stage": stage, "row": line, **plan}


def cmd_status(args, ctx) -> dict:
    """Any status transition the named subcommands do not cover.

    `add`/`route`, `start`, `done` and `drop` cover four of the six statuses.
    `blocked` and `review` had no tool path at all — and `dispatch` moves rows
    into `review` on every run, so every dispatch manufactured a post-tool edit
    that drift detection would report forever. A gap in coverage becomes a
    permanent false signal the moment detection exists, which is why this is not
    a nice-to-have.
    """
    tid, want = args.id, args.status
    allowed = ctx["schema"]["enums"]["task_status"]
    if not want:
        raise Refused(f"--status is required, one of {allowed}")
    if want not in allowed:
        raise Refused(f"status {want!r} is not one of {allowed}")
    if want in ("done", "dropped"):
        raise Refused(
            f"use `perry-task {'done' if want == 'done' else 'drop'}` — those "
            f"close a row and need evidence or a reason, which this does not take")
    pri, idx, header, cells = ctx["board"].find(tid)
    values = dict(zip([norm(h) for h in header], cells))
    prev = values.get("status", "")
    if prev == want:
        raise Refused(f"{tid} is already {want}")
    if want == "blocked" and not args.reason:
        raise Refused(
            f"{tid}: blocked needs --reason naming what it waits on. A blocked "
            f"row with no named dependency is a row nobody can unblock")
    values["status"] = want
    if args.next:
        values["next action"] = args.next
    elif want == "blocked":
        values["next action"] = f"blocked on {args.reason}"
    line = ctx["board"].replace_row(idx, header, values)
    tail = f" · {args.reason}" if args.reason else ""
    jline = f"- [{tid}] {prev or '—'} → {want}{tail}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "status",
             "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"), "actor": args.actor,
             "from": prev, "to": want, "reason": args.reason or ""}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "status": want, "row": line, **plan}


def cmd_drop(args, ctx) -> dict:
    """Remove a row deliberately, with a reason, and record why.

    Missing until a review found it: `drop` was in the accepted-subcommand
    guard and absent from the dispatch table, so it raised a bare KeyError.
    Worse than the crash was the consequence — a hand-removed row leaves its
    `add` event with no row and no close, which is drift's second condition, so
    every drop done by hand permanently manufactured the exact false drift
    § 5.7 exists to prevent.
    """
    tid = args.id
    if not args.reason:
        raise Refused(
            f"{tid}: --reason is required. A row that leaves the board without "
            f"one is indistinguishable from a row that was lost")
    pri, idx, header, cells = ctx["board"].find(tid)
    values = dict(zip([norm(h) for h in header], cells))
    prev = values.get("status", "")
    line = ctx["board"].remove_row(idx)
    jline = f"- [{tid}] {prev or '—'} → dropped · reason: {args.reason}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "drop",
             "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"), "actor": args.actor,
             "from": prev, "to": "dropped", "reason": args.reason}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "reason": args.reason, "removed": line, **plan}


def cmd_resolve_intake(args, ctx) -> dict:
    """Discharge an intake row without routing it — dropped or deferred.

    `triage` mandates that every intake row leave as routed, dropped-with-a-
    reason, or deferred-with-a-named-condition. Only the first had a tool, so
    two of three outcomes were still hand-written and invisible to every count
    and to drift detection.
    """
    if not args.reason:
        raise Refused("--reason carries the drop reason or the defer condition")
    rows = ctx["board"].section_rows("Intake")
    try:
        n = int(args.id or "0")
    except ValueError:
        raise Refused("resolve-intake takes the intake row number")
    if not 1 <= n <= len(rows):
        raise Refused(f"intake row {n} does not exist (there are {len(rows)})")
    idx, cells = rows[n - 1]
    sep, header = ctx["board"].section_table("Intake")
    keys = [norm(h) for h in header]
    intake = dict(zip(keys, cells))
    outcome = args.outcome or "dropped"
    if outcome not in ("dropped", "deferred"):
        raise Refused("--outcome is `dropped` or `deferred`; routing uses `route`")
    text = f"{outcome} {date.today():%Y-%m-%d} — {args.reason}"
    if not args.dry_run:
        ctx["board"].lines[idx] = render_row(
            [intake.get(k, "") if k != "outcome" else text for k in keys])
    jline = f"- [intake] {intake.get('request', '')[:48]} → {text}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"),
             "event": "resolve-intake", "id": "",
             "title": intake.get("request", ""),
             "arrived": intake.get("arrived", ""), "actor": args.actor,
             "from": "intake", "to": outcome, "reason": args.reason}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"outcome": outcome, **plan}


def cmd_intake(args, ctx) -> dict:
    """Record an unrouted external request, creating `## Intake` if absent."""
    if not args.title:
        raise Refused("--title is the request text")
    arrived = args.arrived or f"{date.today():%Y-%m-%d}"
    # Same as `add`: the real path runs either way; only `commit()` is skipped.
    ctx["board"].ensure_section("Intake", ["Arrived", "Request", "Outcome"])
    line = ctx["board"].append_section_row(
        "Intake", {"arrived": arrived, "request": args.title, "outcome": "—"})
    jline = f"- [intake] arrived {arrived} · {args.title}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "intake",
             "id": "", "title": args.title, "arrived": arrived,
             "actor": args.actor, "from": None, "to": "intake"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"arrived": arrived, "row": line, **plan}


USER_ID_RE = re.compile(r"\bUSER-(\d+)\b")


def mint_user_id(board: Board, events: list[dict], state_root: Path) -> str:
    """Next `USER-NNN` from max(board ∪ journal ∪ events), like `mint_id`."""
    seen = {int(m) for m in USER_ID_RE.findall(board.text())}
    seen |= {int(m) for e in events for m in USER_ID_RE.findall(e.get("id", ""))}
    for p in sorted((state_root / "journal").rglob("*.md")):
        try:
            seen |= {int(m) for m in USER_ID_RE.findall(p.read_text(errors="replace"))}
        except OSError:
            continue
    return f"USER-{max(seen, default=0) + 1:03d}"


def cmd_ask(args, ctx) -> dict:
    """Put a question to the user and start its clock.

    `## User Input Queue` had no writer, and the cost was measurable rather
    than theoretical: **both rows on Perry's own board carried `Idle: —`** —
    the one field the queue exists for, unfilled, because a human had to type
    a number that is wrong the next morning.

    So the tool stamps `Asked`, a date, and the age is computed at read time.
    `Idle` stays readable on boards that have it and is no longer required by
    the schema: a stored age is stale the moment it is written, and a real
    project had already dropped the column for exactly that reason.
    """
    if not args.needed:
        raise Refused(
            "--needed is required: it is the question, and a queue row that "
            "does not say what is being asked cannot be answered by anyone")
    sr = ctx["state_root"]
    uid = mint_user_id(ctx["board"], ctx["events"], sr)
    asked = args.arrived or f"{date.today():%Y-%m-%d}"

    ctx["board"].ensure_section(
        "User Input Queue", ["USER-id", "Needed from user", "Blocks", "Asked", "Status"],
        before_p0=False)
    ctx["board"].ensure_section_columns("User Input Queue", ["Asked"])
    line = ctx["board"].append_section_row("User Input Queue", {
        "user-id": uid, "needed from user": args.needed,
        "blocks": args.blocks or "—", "asked": asked, "status": "pending"})
    jline = f"- [{uid}] — → pending · {args.needed}" + (
        f" · blocks: {args.blocks}" if args.blocks else "")
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "ask",
             "id": uid, "title": args.needed, "asked": asked,
             "blocks": args.blocks or "", "actor": args.actor,
             "from": None, "to": "pending"}
    plan = commit(ctx["project_root"], sr, ctx["board"], jline, event, args.dry_run)
    return {"id": uid, "asked": asked, "row": line, **plan}


def cmd_answer(args, ctx) -> dict:
    """Record the user's answer, with the date they gave it."""
    if not args.answer:
        raise Refused(
            "--answer is required. Flipping the status without recording what "
            "was decided leaves the row closed and the decision nowhere")
    idx, header, cells = ctx["board"].find_section_row("User Input Queue", args.id)
    keys = [norm(h) for h in header]
    values = dict(zip(keys, cells))
    today = f"{date.today():%Y-%m-%d}"
    prev = values.get("status", "")
    if prev.strip().lower().startswith("answered"):
        raise Refused(f"{args.id} is already answered: {prev.strip()[:60]}")
    values["status"] = f"answered {today}: {args.answer}"
    ctx["board"].lines[idx] = render_row([values.get(k, "") for k in keys])
    jline = f"- [{args.id}] pending → answered · {args.answer}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "answer",
             "id": args.id, "title": values.get("needed from user", ""),
             "answer": args.answer, "actor": args.actor,
             "from": "pending", "to": "answered"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": args.id, "answered": today, **plan}


RISK_ID_RE = re.compile(r"\bRX-(\d+)\b")

# The tool owns the row and every computed cell; the agent owns the prose cell.
# `ID` and `Opened` are stamped, `Status` is a state machine with two moves, and
# `Risk` is the human's sentence and is never parsed, never enum-checked and
# never rewritten.
RISK_COLUMNS = ["ID", "Risk", "Opened", "Status"]

# A bullet that is a placeholder rather than a risk. `BOARD_TEMPLATE.md` ships
# `- (no active risks)` and several fixtures carry `- none`; migrating those
# would mint an id for a risk named "none".
_RISK_PLACEHOLDER = re.compile(
    r"^\(?\s*(?:no active risks?|none|n/a|na|tbd|—|-|–|无|暂无)\s*\)?[.。]?$", re.I)

_RISK_BULLET = re.compile(r"^(?:-|\d+\.)\s+(.*)$")


def mint_risk_id(board: Board, events: list[dict], state_root: Path) -> str:
    """Next `RX-NNN` from max(board ∪ journal ∪ events), like `mint_id`.

    Same three sources for the same reason: a cleared risk still owns its
    number. `## Top risks` holds cleared rows rather than deleting them, so the
    board alone would nearly always be enough — but "nearly always" is how an id
    gets reissued the first time somebody prunes the section, and every journal
    line naming the old risk would then silently re-point.
    """
    seen = {int(m) for m in RISK_ID_RE.findall(board.text())}
    seen |= {int(m) for e in events for m in RISK_ID_RE.findall(e.get("id", ""))}
    for p in sorted((state_root / "journal").rglob("*.md")):
        try:
            seen |= {int(m) for m in RISK_ID_RE.findall(p.read_text(errors="replace"))}
        except OSError:
            continue
    return f"RX-{max(seen, default=0) + 1:03d}"


def risk_bullets(board: Board) -> list[tuple[int, str]]:
    """(line index, bullet text) for every risk bullet, placeholders excluded."""
    start, end = board.named_section("Top risks")
    out = []
    for i in range(start + 1, end):
        m = _RISK_BULLET.match(board.lines[i].strip())
        if not m:
            continue
        text = m.group(1).strip()
        if not text or _RISK_PLACEHOLDER.match(text):
            continue
        out.append((i, text))
    return out


def ensure_risk_table(board: Board, events: list[dict],
                      state_root: Path) -> list[dict]:
    """Put `## Top risks` into its table form, carrying any bullets across.

    Three states, three answers:

    - **no section** — create it, with the table. Same as `ensure_section`
      does for `## Intake`.
    - **a table already** — add any column it lacks, and touch nothing else.
    - **a bullet list** — convert it, in this same write.

    The third is the one with a real choice in it, and the two alternatives are
    both worse. *Refusing* would make `risk-add` unusable on every project that
    exists — on the day this shipped that was every project except Perry — for
    the crime of not having migrated yet. *Appending a table above the bullets*
    would leave the board holding both, and since the reader prefers the table,
    every existing risk would vanish from every count while still sitting in the
    file. Silent loss is the worse failure of the two by a distance.

    **What the conversion may and may not invent.** The bullet's text is copied
    into `Risk` byte-for-byte — it is the human's sentence and this function has
    no opinion about it. `Opened` is left **EMPTY**, because the date a
    pre-existing risk was raised is genuinely not recorded anywhere and stamping
    today would assert that a nine-month-old risk is new. An empty `Opened`
    reads back as `age_days: null`, which is already the honest answer for a
    bullet and stays honest here.

    `Status` is the one derived cell, and it is derived from the reader's OWN
    two markers and nothing else: a bullet is migrated as `cleared` exactly when
    `~~strikethrough~~` or `**RESOLVED` made the old parser call it resolved.
    So the conversion is verdict-preserving — the set of (statement, resolved)
    pairs is identical either side of it — which is a property a test can check
    rather than a claim a reviewer has to believe. Any date the human wrote into
    a cleared bullet is carried onto the cell; when they wrote none, the cell
    says `cleared` with no date rather than today's, for the same reason
    `Opened` stays blank.
    """
    if not board.has_section("Top risks"):
        board.ensure_section("Top risks", RISK_COLUMNS, before_p0=False)
        return []
    try:
        board.section_table("Top risks")
    except Refused:
        pass
    else:
        board.ensure_section_columns("Top risks", RISK_COLUMNS)
        return []

    bullets = risk_bullets(board)
    start, end = board.named_section("Top risks")
    try:
        lang = header_language(board.table("P0")[2])
    except Refused:
        lang = "en"
    header = [display_name(c, lang) for c in RISK_COLUMNS]

    base = int(mint_risk_id(board, events, state_root).split("-")[1])
    migrated, rows = [], []
    for n, (_, text) in enumerate(bullets):
        rid = f"RX-{base + n:03d}"
        resolved = text.startswith("~~") or bool(re.search(r"\*\*RESOLVED", text))
        status = "open"
        if resolved:
            d = re.search(r"\d{4}-\d{2}-\d{2}", text)
            status = f"cleared {d.group(0)}" if d else "cleared"
        rows.append(render_row([rid, text, "", status]))
        migrated.append({"id": rid, "risk": text, "status": status})

    block = [render_row(header),
             "|" + "|".join(["---"] * len(header)) + "|"] + rows
    # Replace the whole body of the section, preserving the heading line and
    # any prose the project keeps under it. Only the bullet lines go.
    keep = [l for i, l in enumerate(board.lines[start + 1:end], start + 1)
            if not _RISK_BULLET.match(l.strip())]
    while keep and not keep[0].strip():
        keep.pop(0)
    while keep and not keep[-1].strip():
        keep.pop()
    body = ([""] + keep if keep else []) + [""] + block + [""]
    board.lines[start + 1:end] = body
    return migrated


def cmd_risk_add(args, ctx) -> dict:
    """Raise a risk: the tool mints the id and stamps the date.

    `## Top risks` was a bullet list with no writer, and it carried the two
    defects that shape always carries. **A cleared risk stayed live forever**:
    the only way to retire one was `~~strikethrough~~`, which is decoration, so
    a risk cleared on Perry's own board the day before was still one of the four
    that `perry-state` reported. And **the reader invented ids out of prose** —
    with no id column it split the first sentence on whitespace and published
    `id: "Perry"`, `title: "is half-adopted: …"`, a handle that names nothing
    and cannot be passed back to anything.

    Neither is fixable by writing the bullets more carefully. An id has to be
    minted against the ones already issued, and a status has to be a cell
    something can read — both are properties of a writer, not of a convention.
    """
    if not args.title:
        raise Refused(
            "--title is required: it is the risk statement, in your words. A "
            "risk row with no sentence in it is an id and a date")
    sr = ctx["state_root"]
    migrated = ensure_risk_table(ctx["board"], ctx["events"], sr)
    rid = mint_risk_id(ctx["board"], ctx["events"], sr)
    opened = args.opened or f"{date.today():%Y-%m-%d}"
    line = ctx["board"].append_section_row("Top risks", {
        "id": rid, "risk": args.title, "opened": opened, "status": "open"})
    tail = (f" · migrated {len(migrated)} bullet(s) into the table"
            if migrated else "")
    jline = f"- [{rid}] — → open · {args.title}{tail}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"),
             "event": "risk-add", "id": rid, "title": args.title,
             "opened": opened, "actor": args.actor,
             "from": None, "to": "open",
             "migrated": [m["id"] for m in migrated]}
    plan = commit(ctx["project_root"], sr, ctx["board"], jline, event, args.dry_run)
    return {"id": rid, "opened": opened, "row": line,
            "migrated": migrated, **plan}


def cmd_risk_clear(args, ctx) -> dict:
    """Retire a risk, with the reason and the date it stopped being one.

    The cleared row STAYS on the board. A risk that was real and is now over is
    the most useful thing in this section — it is the record that the mitigation
    worked — and deleting it would leave the same hole the strikethrough was
    trying to fill. It simply stops counting.
    """
    if not args.reason:
        raise Refused(
            f"{args.id}: --reason is required. A risk that leaves the live set "
            f"without one is indistinguishable from a risk everyone got tired of")
    try:
        idx, header, cells = ctx["board"].find_section_row("Top risks", args.id)
    except Refused as exc:
        if "has no table" in str(exc):
            raise Refused(
                "`## Top risks` is still a bullet list, so nothing in it has an "
                "id to clear. `perry-task risk-add` migrates the section (it "
                "carries every bullet across verbatim), after which the rows "
                "have ids") from None
        raise
    keys = [norm(h) for h in header]
    values = dict(zip(keys, cells))
    prev = (values.get("status", "") or "").strip()
    if re.match(r"^(?:cleared|resolved|closed)\b", prev.strip("*~` "), re.I):
        raise Refused(f"{args.id} is already cleared: {prev[:60]}")
    today = f"{date.today():%Y-%m-%d}"
    values["status"] = f"cleared {today} — {args.reason}"
    ctx["board"].lines[idx] = render_row([values.get(k, "") for k in keys])
    jline = f"- [{args.id}] open → cleared · {args.reason}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"),
             "event": "risk-clear", "id": args.id,
             "title": values.get("risk", ""), "reason": args.reason,
             "actor": args.actor, "from": "open", "to": "cleared"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": args.id, "cleared": today, **plan}


def cmd_route(args, ctx) -> dict:
    """Move an intake row onto the board, carrying `Arrived` with it.

    Not bookkeeping: `today − Arrived` is the number every SLA check measures,
    so a routing that drops it makes queue mode's own breach check uncomputable
    and silently exempts the row from the only clock governing it.
    """
    rows = ctx["board"].section_rows("Intake")
    if not rows:
        raise Refused("`## Intake` has no rows to route")
    try:
        n = int(args.id or "0")
    except ValueError:
        raise Refused("route takes the intake row number: perry-task route 1 --track ops")
    if not 1 <= n <= len(rows):
        raise Refused(f"intake row {n} does not exist (there are {len(rows)})")
    idx, cells = rows[n - 1]
    sep, header = ctx["board"].section_table("Intake")
    keys = [norm(h) for h in header]
    intake = dict(zip(keys, cells))

    track = track_of(ctx["config"], args.track or "main")
    if track["mode"] == "project":
        raise Refused(f"track {track['track']!r} is mode `project`; routing is a "
                      f"queue-mode operation (`modes/queue.md`)")
    tid = mint_id(ctx["board"], ctx["events"], ctx["state_root"])
    priority = args.priority or "P1"
    stages = stages_of(ctx["schema"], track)
    check_stage(track, stages, args.stage)
    stage = args.stage or (stages[1] if len(stages) > 1 else (stages[0] if stages else ""))

    values = {"id": tid, "title": intake.get("request", ""),
              "owner": args.owner or "Coding Agent", "status": "not_started",
              "next action": "—", "evidence": "—",
              "track": track["track"], "stage": stage,
              "arrived": intake.get("arrived", "")}
    if args.commitment:
        values["commitment"] = args.commitment
    ctx["board"].ensure_columns(priority, columns_for(values))
    line = ctx["board"].append_row(priority, values)
    # The intake row keeps its record; `Outcome` says where it went.
    ctx["board"].lines[idx] = render_row(
        [intake.get(k, "") if k != "outcome" else f"routed → {tid}" for k in keys])
    jline = (f"- [{tid}] — → not_started · routed from intake "
             f"(arrived {values['arrived']}) · track: {track['track']}")
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "route",
             "id": tid, "title": values["title"], "track": track["track"],
             "arrived": values["arrived"], "actor": args.actor,
             "from": "intake", "to": "not_started"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "arrived": values["arrived"], "row": line, **plan}


def cmd_list(args, ctx) -> dict:
    """The full task set, from one call.

    `BOARD.md` holds open work only — closed rows leave it — so the complete
    set has, until now, existed solely as a reconstruction from date-sharded
    journal prose. A reader would have to parse every file in every month and
    rebuild each task's timeline. This does that once, in code, so a front-end
    never learns Perry's file formats and Perry can change them without
    breaking a program it does not control.

    **This payload is a frozen contract.** Its shape is specified in
    `schema/task-list-contract.md` and locked by tests; `LIST_CONTRACT` below
    is the version handle a consumer checks. Every declared key is ALWAYS
    present — an unknown value is `""`, `null` or `[]`, never a missing key —
    so a consumer needs no defensive branch per field.

    It exists so a front-end does not write a second parser for `BOARD.md`.
    That is not a style preference: `viewer/parsers.py` and `bin/perry-task`
    were two parsers of one file and they disagreed silently — the writer
    placed cells by header name while the reader read them by position, so a
    board with one extra column reported every task's owner as its track and
    counted zero open work. A third parser would be a third chance at the same
    bug, and this payload is the alternative.
    """
    def blank(tid: str) -> dict:
        # One template, so a key can never exist on some tasks and not others.
        return {"id": tid, "title": "", "owner": "", "priority": "",
                "status": "", "status_text": "", "track": "main", "mode": "",
                "stage": "", "evidence_paths": [],
                "stage_since": "", "arrived": "", "parent": "",
                "commitment": "", "next_action": "", "evidence": "",
                "verification": "", "open": False, "group": "",
                "created": None, "updated": None, "timeline": []}

    tasks: dict[str, dict] = {}
    conformance = {"sections_read": [], "sections_skipped": [],
                   "rows_with_unrecognized_id": [], "off_enum_status": [],
                   "rows_with_no_status": [], "evidence_not_found": [],
                   "has_event_log": bool(ctx["events"])}
    statuses = set(ctx["schema"]["enums"]["task_status"])
    terminal = {"done", "dropped"}

    for tbl in ctx["board"].task_tables():
        if not tbl["readable"]:
            conformance["sections_skipped"].append(
                {"heading": tbl["heading"],
                 "why": "table has no ID and Title columns",
                 "columns": tbl["header"]})
            continue
        conformance["sections_read"].append(
            {"heading": tbl["heading"], "priority": tbl["priority"],
             "rows": len(tbl["rows"])})
        pri = tbl["priority"] or ""
        for c in tbl["rows"]:
            # `~~DATA-007~~` and `**TASK-1**` are both real, both from a real
            # board: strikethrough means retired, bold means emphasis, and the
            # id underneath is the handle either way.
            tid = c.get("id", "").replace("~", "").replace("*", "").replace("`", "").strip()
            if not tid:
                continue
            if not re.fullmatch(r"[A-Za-z][\w./-]*-?\d*", tid):
                # A row whose first cell is prose, not a handle. One real board
                # has `| 2 待核项 | …` sitting in its P2 table. Reported so a
                # reader knows the board holds something it could not index —
                # dropping it silently is how a front-end shows nonsense.
                conformance["rows_with_unrecognized_id"].append(
                    {"section": tbl["heading"], "cell": tid[:60]})
                continue
            raw = c.get("status", "")
            # `**done**` is `done` wearing bold. Formatting is not meaning, and
            # a consumer that trusts the enum renders a finished task as an
            # unrecognized state — 17 of 41 rows on one real board. Emphasis is
            # stripped here so the enum claim is true; `status_text` keeps the
            # cell verbatim, because some cells genuinely are not one state
            # ("迁移 done，占比目标 not_started" is two, and rounding it to
            # either is a lie about the work).
            st = raw.strip().strip("*_`").strip()
            if st not in statuses:
                st = ""
            if not raw.strip():
                conformance["rows_with_no_status"].append(
                    {"id": tid, "section": tbl["heading"]})
            elif not st:
                conformance["off_enum_status"].append(
                    {"id": tid, "status": raw})
            ev_found, ev_missing = evidence_paths(
                c.get("evidence", ""), ctx["state_root"], ctx["project_root"])
            if ev_missing:
                conformance["evidence_not_found"].append(
                    {"id": tid, "paths": ev_missing})
            t = blank(tid)
            t.update({
                "title": c.get("title", ""), "owner": c.get("owner", ""),
                "priority": pri, "group": tbl["heading"],
                "status": st, "status_text": raw,
                "track": c.get("track", "") or "main",
                "stage": c.get("stage", ""),
                "stage_since": c.get("stage since", ""),
                "arrived": c.get("arrived", ""), "parent": c.get("parent", ""),
                "commitment": c.get("commitment", ""),
                "next_action": c.get("next action", ""),
                "evidence": c.get("evidence", ""),
                "evidence_paths": ev_found,
                "verification": c.get("verification", ""),
                # `open` used to mean "still on the board", which was true when
                # the board held only P0/P1/P2 and closing removed the row.
                # Once the reader saw every section, a project that stages
                # finished work under its own heading — Perry's own board has
                # `## Done this period (leaves the board at next triage)` —
                # reported 20 done tasks as open. The contract tells consumers
                # this field IS the live/closed test, so it has to mean that.
                "open": st not in terminal,
            })
            tasks[tid] = t

    for e in ctx["events"]:
        tid = e.get("id", "")
        if not tid or e.get("event") not in TASK_EVENTS:
            # The log is one stream for the whole project, and not everything
            # in it is a task. `ask` writes `USER-001` and `risk-add` writes
            # `RX-001`; absorbed here they became rows in `tasks[]` with no
            # title, no priority and `open: false` — a published contract
            # asserting that a question put to the user is a closed task.
            # Measured on a board with one `ask` and nothing else: `list --all`
            # returned exactly one "task", `USER-001`. The id shape cannot be
            # the filter, because project ids are project-defined; the event
            # name can, because this file mints it.
            continue
        t = tasks.setdefault(tid, blank(tid))
        # A row that has left the board is closed; one still on it stays open,
        # and its live cells win over anything the event stream remembers.
        if not t["open"]:
            t["status"] = e.get("to") or t["status"]
            t["title"] = e.get("title") or t["title"]
            t["track"] = e.get("track") or t["track"]
            t["priority"] = e.get("priority") or t["priority"]
            t["evidence"] = e.get("evidence") or t["evidence"]
            t["verification"] = e.get("rung") or t["verification"]
        t["mode"] = e.get("mode") or t["mode"]
        ts = e.get("ts") or ""
        if e.get("event") in ("add", "route") and ts:
            t["created"] = ts
        if ts and (t["updated"] is None or ts > t["updated"]):
            t["updated"] = ts
        t["timeline"].append(
            {k: e.get(k) for k in ("ts", "event", "from", "to", "actor")})

    rows = sorted(tasks.values(), key=lambda t: t["id"])
    if args.track:
        rows = [t for t in rows if t["track"] == args.track]
    if not args.all:
        rows = [t for t in rows if t["open"]]

    # An id whose only record is an event with no title predates the `title`
    # field. Reported rather than papered over: a bare id is exactly what
    # `reference/user-load.md` forbids handing a reader.
    untitled = [t["id"] for t in rows if not t["title"]]
    return {"contract": LIST_CONTRACT,
            "project_root": str(ctx["project_root"]),
            "state_root": str(ctx["state_root"]),
            "conformance": conformance,
            "tasks": rows,
            "open": sum(1 for t in rows if t["open"]),
            "closed": sum(1 for t in rows if not t["open"]),
            "events": len(ctx["events"]),
            "untitled": untitled}


def split_stages(cell: str) -> list[str]:
    s = (cell or "").replace("→", "->").strip()
    if not s or s == "—":
        return []
    return [x.strip() for x in s.split("->") if x.strip()]


def default_stages(schema: dict, mode: str) -> list[str]:
    return split_stages(schema["work_modes"]["modes"][mode].get("default_stages", ""))


# ── main ──────────────────────────────────────────────────────────────────


class Args:
    pass


def parse(argv: list[str]) -> Args:
    a = Args()
    a.cmd = None
    a.id = a.title = a.track = a.owner = a.priority = None
    a.next = a.parent = a.commitment = a.stage = a.evidence = a.rung = None
    a.root = None
    a.actor = "agent"
    a.arrived = a.reason = a.outcome = a.status = None
    a.needed = a.blocks = a.answer = a.opened = None
    a.dry_run = a.as_json = a.all = False
    i = 0
    flags = {"--title": "title", "--track": "track", "--owner": "owner",
             "--priority": "priority", "--next": "next", "--parent": "parent",
             "--commitment": "commitment", "--stage": "stage",
             "--evidence": "evidence", "--rung": "rung", "--root": "root",
             "--arrived": "arrived", "--reason": "reason",
             "--outcome": "outcome", "--status": "status",
             "--actor": "actor", "--needed": "needed",
             "--blocks": "blocks", "--answer": "answer",
             "--opened": "opened"}
    while i < len(argv):
        t = argv[i]
        if t in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        elif t == "--dry-run":
            a.dry_run = True
        elif t == "--json":
            a.as_json = True
        elif t == "--all":
            a.all = True
        elif t in flags:
            i += 1
            setattr(a, flags[t], argv[i] if i < len(argv) else None)
        elif t.startswith("-"):
            print(f"perry-task: unknown argument {t!r} (try --help)", file=sys.stderr)
            sys.exit(2)
        elif a.cmd is None:
            a.cmd = t
        elif a.id is None:
            a.id = t
        i += 1
    return a


# The single source of truth for what `perry-task` accepts. Membership check,
# error message and dispatch all read this one dict on purpose: it used to be a
# tuple and a dict holding the same list, and they drifted apart twice — once
# leaving `drop` accepted but undispatched (a bare KeyError), once leaving
# `drop`, `status` and `resolve-intake` out of the "expected one of" line. A
# name added here is reachable, dispatchable and advertised in one edit.
COMMANDS = {"add": cmd_add, "start": cmd_start, "stage": cmd_stage,
            "ask": cmd_ask, "answer": cmd_answer,
            "risk-add": cmd_risk_add, "risk-clear": cmd_risk_clear,
            "done": cmd_done, "drop": cmd_drop, "intake": cmd_intake,
            "route": cmd_route, "resolve-intake": cmd_resolve_intake,
            "status": cmd_status, "list": cmd_list}


@contextlib.contextmanager
def project_lock(state_root: Path, timeout: float = 10.0):
    """Serialize the whole read-modify-write, not just the write.

    `BOARD.md` is read when `Board` is constructed and written in `commit()`.
    Between those two points another process can do the same thing, and the
    second rename then discards the first process's row entirely. Measured, not
    theorized: five concurrent `add` calls left **two** rows on the board, with
    `TASK-001` and `TASK-002` each issued twice. The event log took all five,
    because it is opened `O_APPEND` — the append-only file survived exactly the
    race the read-modify-write document lost.

    `autopilot` dispatches concurrently by design, so this path is live rather
    than hypothetical.

    The lock must wrap the read as well as the write, which is why it is taken
    here and not inside `commit()`: a lock around the write alone would still
    let both processes mint the same id from the same stale board.

    **It lives outside the project entirely**, in the temp dir, keyed by a hash
    of the state root. Two earlier placements each broke something real:

    - in `.perry/` — an unwritable `.perry/` made the lock uncreatable and
      refused the whole call, even though `BOARD.md` and the journal were both
      writable. The design's entire claim is that `.perry/` is derived and can
      never make Perry *wrong*.
    - beside `BOARD.md` — it then appears in the project, and a consumer repo
      does not inherit Perry's own `.gitignore`. Checked on a real Perry project
      the same night it shipped: `?? .board.lock`, untracked and unignored. A
      tool that makes every user edit their `.gitignore` to stay clean has
      pushed its own bookkeeping onto them.

    It is also not flock on `BOARD.md` itself: `commit()` renames a temp file
    over it, so every writer after the first would hold a lock on a replaced
    inode and exclusion would quietly stop working.

    A file outside the tree, never renamed, keyed by the path it guards, is the
    one shape that survives all three. It is pure runtime state — losing it
    between reboots costs nothing, because it only ever means "no one is writing
    right now", which is true after a reboot.
    """
    key = hashlib.sha1(str(state_root.resolve()).encode()).hexdigest()[:16]
    lock_path = Path(tempfile.gettempdir()) / f"perry-task-{key}.lock"
    fh = open(lock_path, "w")
    deadline = time.monotonic() + timeout
    try:
        while True:
            try:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    raise Refused(
                        f"another perry-task is holding {lock_path} and did not "
                        f"release it within {timeout:.0f}s. Nothing was written; "
                        f"retry, or remove the file if no other process is live")
                time.sleep(0.05)
        yield
    finally:
        try:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
        finally:
            fh.close()


def main(argv: list[str]) -> int:
    args = parse(argv)
    if args.cmd not in COMMANDS:
        print(f"perry-task: expected one of {' / '.join(COMMANDS)} "
              f"(try --help)", file=sys.stderr)
        return 2
    try:
        schema = load_schema()
        project_root = (Path(args.root).expanduser().resolve() if args.root
                        else Path(os.environ.get("PERRY_PROJECT") or Path.cwd()).resolve())
        state_root = P.resolve_state_root(project_root)
        cfg_path = project_root / ".perry" / "config.md"
        config = {"tracks": []}
        if cfg_path.exists():
            sys.path.insert(0, str(PERRY_HOME / "bin"))
            import importlib.machinery
            import importlib.util
            spec = importlib.util.spec_from_loader(
                "perry_state", importlib.machinery.SourceFileLoader(
                    "perry_state", str(PERRY_HOME / "bin" / "perry-state")))
            ps = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(ps)
            config = {"tracks": ps.parse_tracks(cfg_path.read_text())}
        with project_lock(state_root):
            ctx = {"schema": schema, "project_root": project_root,
                   "state_root": state_root, "config": config,
                   "board": Board(state_root / "BOARD.md"),
                   "events": read_events(project_root)}
            result = COMMANDS[args.cmd](args, ctx)
    except Refused as exc:
        if args.as_json:
            print(json.dumps({"refused": str(exc)}, ensure_ascii=False, indent=2))
        else:
            print(f"perry-task: refused — {exc}", file=sys.stderr)
        return 1

    if args.as_json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    elif args.cmd == "list":
        for r in result["tasks"]:
            mark = " " if r["open"] else "·"
            title = r["title"] or "(no title in the record)"
            print(f" {mark}{r['id']:10} {r['priority']:3} {r['status']:12} {title[:54]}")
        print(f"\n  {result['open']} open · {result['closed']} closed · "
              f"{result['events']} event(s)")
        if result["untitled"]:
            print(f"  ⚠ {len(result['untitled'])} id(s) have no title in the record: "
                  f"{', '.join(result['untitled'])}")
    else:
        verb = "would write" if args.dry_run else "wrote"
        # `commit()` reports a lost event honestly; this line used to say
        # "→ board + journal + event" regardless, so the surface the agent
        # actually reads asserted a write that the function below it had
        # already recorded as failed.
        wrote_event = result.get("event_written", True)
        tail = ("board + journal + event" if wrote_event
                else "board + journal (event log unwritable — this row will "
                     "show as `unrecorded` until it is fixed)")
        print(f"perry-task: {verb} {result.get('id')} ({args.cmd}) → {tail}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
