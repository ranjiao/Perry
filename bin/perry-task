#!/usr/bin/env python3
"""
perry-task — the one deterministic way Perry's state gets written.

Perry has nine read tools and, until this one, zero write tools. Every board
row, status change, journal line and ID was produced by an agent typing markdown
by hand — so the law that governs state ("never compute a number by reading
files and eyeballing it") protected the way out and not the way in.

Every mutating call writes three things:

  1. the `BOARD.md` row, rendered from schema/state-schema.json's column order
  2. the `## Status changes` line in journal/<YYYY-MM>/<today>.md
  3. one JSON object appended to .perry/events.jsonl

**(1) and (2) are atomic with each other**: both are staged and renamed, so
either both land or neither does. That is the pair that matters — a board row
without its journal line is exactly the board-vs-history divergence this tool
exists to remove, which makes a partial write there strictly worse than a
refusal.

**(3) is appended after and can fail alone.** It is reported, not raised: the
canonical state is already correct, and the row simply shows as `unrecorded`
until the log is writable. This is the direction the loss is allowed to run,
never the reverse. See `commit()`.

What the tool computes rather than accepts — the payload, per DESIGN-004 § 5.2:
IDs are minted from max(board ∪ journal ∪ events), never reused; timestamps are taken at
call time rather than asserted; `Stage since` / `Arrived` are stamped
structurally; any column a track's mode requires and the board lacks is created
in the same edit; rungs are validated against the schema enum before write.

The event log is DERIVED AND DISPOSABLE. Delete .perry/events.jsonl and Perry
still works — markdown is canonical. What is lost is history resolution and
drift detection, not truth. That constraint is what keeps this from becoming a
database with a markdown export.

That claim was false for one thing until `mint_id` learned to read the journal:
ID uniqueness depended on the log, so deleting it reissued the number of every
closed task. Anything load-bearing that lives only in this file is a bug in the
same class — the file is allowed to make Perry *slower to explain itself*, never
*wrong*.

Usage:
  perry-task add   --title "…" --deliverable "…" --verification "…"
                   [--depends "…"] [--out-of-scope "…"] [--kr KR-ID]
                   [--track T] [--owner O] [--priority P0|P1|P2]
                   [--group "<board heading>"]   file under a project's own section
                   [--prefix AIM]                mint into the board's own id family
                   [--next "…"] [--parent ID] [--commitment ID] [--stage S]
                   [--arrived YYYY-MM-DD]
  perry-task start <ID> [--next "…"]
  perry-task stage <ID> --stage <name>
  perry-task intake --title "…" [--arrived YYYY-MM-DD]
  perry-task ask    --needed "…" [--blocks <ID>] [--arrived YYYY-MM-DD]
  perry-task answer <USER-ID> --answer "…"
  perry-task cadence-add  --title "…" --frequency <weekly|monthly|quarterly|Nd|…>
                          [--owner O] [--on YYYY-MM-DD]
  perry-task cadence-done <CAD-ID> --evidence <path> [--on YYYY-MM-DD]
                          [--frequency F]
  perry-task risk-add   --title "…" [--opened YYYY-MM-DD]
  perry-task risk-clear <RX-ID> --reason "…"
  perry-task risk-migrate                  `## Top risks` bullets → the table
  perry-task route <n> --track T [--priority P1] [--stage S] [--owner O]
                   [--group "<board heading>"]   file under a project's own section
                   [--prefix AIM]                mint into the board's own id family
                   [--commitment ID]
  perry-task resolve-intake <n> --outcome dropped|deferred --reason "…"
  perry-task intake-sweep                  discharged intake rows → journal
  perry-task drop  <ID> --reason "…"
  perry-task status <ID> --status blocked|review|not_started|in_progress
                    [--reason "…"] [--next "…"]
  perry-task next   <ID> --next "…"        rewrite Next action, nothing else
  perry-task retitle <ID> --title "…"      rewrite Title, nothing else
  perry-task rung   <ID> --rung V1..V6     rewrite Verification, nothing else
  perry-task evidence <ID> --evidence "…"  rewrite Evidence, nothing else
  perry-task prioritize <ID> --priority P0|P1|P2 [--reason "…"]
                    move an existing row between priority sections; keeps its
                    id and every cell. --group "<heading>" on a board that
                    files work under its own headings instead of P0/P1/P2.
  perry-task done  <ID> --evidence <path> [--rung V1..V6]
  perry-task list  [--all] [--track T] [--json]

  --root <path>   project root; default $PERRY_PROJECT, else walk up from cwd
  --dry-run       print what would be written; touch nothing
  --json          machine-readable result
  --actor <name>  who is making the change; stamped into every event. Accepted
                  by every subcommand and defaulted rather than required —
                  DESIGN-004 § 8 asks whether it should be mandatory, and until
                  that is answered an unset actor is recorded as unset rather
                  than guessed.

Exit codes:
  0  written (or, with --dry-run, would be)
  1  refused — the reason is printed and nothing was written
  2  bad invocation / unreadable schema

No LLM, no external dependencies (stdlib only). DESIGN-004.
"""

from __future__ import annotations

import contextlib
import fcntl
import hashlib
import json
import os
import re
import sys
import tempfile
import time
from datetime import date, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
PERRY_HOME = Path(os.environ.get("PERRY_HOME") or HERE.parent).resolve()
SCHEMA_PATH = PERRY_HOME / "schema" / "state-schema.json"

sys.path.insert(0, str(PERRY_HOME / "viewer"))
import parsers as P
from tables import UnrenderableCell, render_row, split_row, squash  # noqa: E402


class Refused(Exception):
    """A refusal is a first-class outcome, not a crash. Nothing was written."""


# The `list --json` payload is a published contract with its own version, kept
# separate from Perry's because the whole point is that it does NOT move when
# Perry's storage does. Bump the minor for an ADDED key; the major only for a
# removed or retyped one. Specified in `schema/task-list-contract.md`.
LIST_CONTRACT = "perry-task/list/1.5"

# Which events describe a TASK. `## Intake`, `## User Input Queue` and
# `## Top risks` rows go through the same three-way commit and land in the same
# event log, but they are not tasks and must never appear in `list`'s `tasks[]`.
# ── schema ────────────────────────────────────────────────────────────────


def load_schema() -> dict:
    if not SCHEMA_PATH.exists():
        raise Refused(f"schema not found at {SCHEMA_PATH}")
    return json.loads(SCHEMA_PATH.read_text())


def board_table_spec(schema: dict) -> dict:
    board = next(f for f in schema["files"] if f["id"] == "board")
    return next(t for t in board["tables"] if "P[012]" in t["under"])


def columns_for(values: dict) -> list[str]:
    """Every column this row actually sets, beyond the six every board has.

    Derived from the row rather than from a per-mode table. The table version
    listed `Track`/`Stage`/`Stage since`/`Arrived`/`Parent` and omitted
    `Commitment` — so `--commitment` was accepted, stored into `values`, and
    then dropped by `append_row`, which maps values onto headers and had no
    header to map it to. Exit 0, success message, no cell. That silently
    emptied the scan `modes/queue.md` builds on ("given a commitment due this
    week, which board rows carry its id") and reproduced, for the one column
    the earlier review did not enumerate, the same defect that lost `Arrived`
    at routing a round before.

    A list of columns and a list of values written down separately will drift;
    one derived from the other cannot.
    """
    return [display for key, display in
            ((norm(k), canonical_column(k)) for k in values)
            if key not in REQUIRED_KEYS]


ABSENT = {"", "—", "-", "–", "n/a", "na", "tbd", "无", "none"}


def evidence_paths(cell: str, state_root: Path, project_root: Path) -> tuple[list[str], list[str]]:
    """Split an `Evidence` cell into paths, resolved against a real root.

    The column is free text that people put several things in. One real row:

        `schema/state-schema.json`, `state/adoption_dossier_TEMPLATE.md`, …

    — a comma-separated list, each span backticked, and relative to the
    *project* root while the contract declared `state_root`. Both conventions
    are live in that same column on that same board, and nothing in the string
    distinguishes them.

    Perry knows both roots, so Perry resolves. Returning the raw string and a
    rule would push the guess onto every consumer, and a guess in a consumer is
    how the last divergence started. Each returned path is relative to
    `project_root` and **exists**; spans that resolve nowhere come back
    separately so they can be reported rather than rendered as dead links.
    """
    raw = (cell or "").strip()
    if raw.lower() in ABSENT:
        return [], []
    spans = re.findall(r"`([^`]+)`", raw)
    if not spans:
        spans = [s.strip() for s in re.split(r"[,，;；]", raw) if s.strip()]
    found, unresolved = [], []
    for s in spans:
        # `path § Section` and `path (12 tests)` are both in circulation; the
        # path is the head of the span.
        cand = re.split(r"\s+§|\s+\(", s.strip())[0].strip().rstrip(",.")
        if not cand or cand.lower() in ABSENT:
            continue
        for root in (state_root, project_root):
            p = (root / cand)
            if p.exists():
                try:
                    found.append(str(p.resolve().relative_to(project_root.resolve())))
                except ValueError:
                    found.append(str(p.resolve()))
                break
        else:
            unresolved.append(cand)
    return found, unresolved


def canonical_column(key: str) -> str:
    """`"stage since"` → `"Stage since"` — the schema's own spelling."""
    if _ALIASES is None:
        _build_column_maps()
    return (_DISPLAY.get(norm(key)) or {}).get("en", key.title())


# ── board ─────────────────────────────────────────────────────────────────


PRIORITY_RE = {p: re.compile(rf"^##\s+{p}\b") for p in ("P0", "P1", "P2")}


# Why a task subcommand will not touch a row in each non-task section, and what
# to run instead. Keyed by the canonical `Board.NON_TASK_SECTIONS` name.
#
# `Board.find()` answered all five of these with "is not a row on the board",
# which is false about a row the same tool wrote one command earlier and which
# `perry-state --json` lists. A refusal that misdescribes the state sends the
# reader looking for a missing row instead of for the rule; a refusal that names
# the rule ends the question. The rule is per-section because the reasons are
# different — a recurrence has no end, an intake row is not yet work, a question
# is answered rather than finished — and one shared sentence would have to be
# vague enough to be true of all three, which is how the false one got written.
NON_TASK_REFUSAL = {
    "Cadence": (
        "{id} is a row in `## Cadence`, which is a recurrence register, not a "
        "task section. A recurrence has no end, so it is never `done`, "
        "`dropped` or moved through a status: closing it would delete the only "
        "record that the ritual is supposed to keep happening.\n"
        "  · record a run:  perry-task cadence-done {id} --evidence <path>\n"
        "  · retire it:     delete the row from `## Cadence` "
        "(`modes/queue.md § What recurs`)"),
    "Intake": (
        "{id} is a row in `## Intake`, which holds requests that are not yet "
        "work — they carry no `Status` to change and no owner to hold them.\n"
        "  · make it work:  perry-task route <row number> --track <track>\n"
        "  · discharge it:  perry-task resolve-intake <row number> --outcome "
        "dropped|deferred --reason <why>"),
    "User Input Queue": (
        "{id} is a row in `## User Input Queue`, which holds questions waiting "
        "on the user. A question is answered, not finished.\n"
        "  · answer it:     perry-task answer {id} --answer <text>"),
    "Top risks": (
        "{id} is a row in `## Top risks`. A risk is not a task: it is closed by "
        "being retired or accepted, not by being done.\n"
        "  · retire it:     perry-task risk-clear {id} --reason <why>"),
}


class Board:
    """`BOARD.md` as lines, edited in place and rendered back byte-for-byte.

    Text-level rather than model-level on purpose: TASK-029's verification is
    that a tool-written board is byte-identical to the hand-written one it
    replaces. Round-tripping through a parsed model would normalize whitespace,
    alignment and column order — and every downstream reader keys on those.
    """

    def __init__(self, path: Path):
        self.path = path
        if not path.exists():
            raise Refused(f"no BOARD.md at {path}")
        self.lines = path.read_text().split("\n")

    # -- locating

    def section(self, priority: str) -> tuple[int, int]:
        """(first line index, end index) of the given priority section."""
        start = None
        for i, line in enumerate(self.lines):
            if PRIORITY_RE[priority].match(line):
                start = i
                continue
            if start is not None and line.startswith("## "):
                return start, i
        if start is None:
            raise Refused(f"BOARD.md has no `## {priority}` section")
        return start, len(self.lines)

    def table(self, priority: str) -> tuple[int, int, list[str]]:
        """(header index, separator index, header cells) for a section's table."""
        lo, hi = self.section(priority)
        for i in range(lo, hi):
            if re.match(r"^\|\s*:?-{2,}", self.lines[i]) and i > lo:
                header = split_row(self.lines[i - 1])
                return i - 1, i, header
        raise Refused(f"`## {priority}` has no table")

    def last_row(self, priority: str) -> int:
        """Index of the last data row, or the separator when there are none."""
        _, sep, _ = self.table(priority)
        lo, hi = self.section(priority)
        last = sep
        for i in range(sep + 1, hi):
            if self.lines[i].strip().startswith("|"):
                last = i
            elif self.lines[i].strip():
                break
        return last

    # -- reading

    def rows(self) -> list[tuple[str, str, dict]]:
        """(priority, raw line, cells-by-header) for every data row."""
        out = []
        for pri in ("P0", "P1", "P2"):
            try:
                hdr_i, sep, header = self.table(pri)
            except Refused:
                continue
            lo, hi = self.section(pri)
            for i in range(sep + 1, hi):
                s = self.lines[i].strip()
                if not s.startswith("|"):
                    if s:
                        break
                    continue
                cells = split_row(self.lines[i])
                if not cells or not cells[0]:
                    continue
                out.append((pri, self.lines[i],
                            dict(zip([norm(h) for h in header], cells))))
        return out

    # Sections that hold something other than task rows. Matched against the
    # canonical name and its `i18n.headings` aliases, so a localized board is
    # skipped for the same reasons an English one is.
    NON_TASK_SECTIONS = ("Intake", "Cadence", "User Input Queue", "Top risks")

    def _task_sections(self):
        """(heading, priority|None, separator index, header cells, end index).

        The ONE walk over the board's task-bearing sections. `task_tables()`
        (read) and `find()` (write) both go through it, because they drifted
        the moment they did not: the reader was taught to see every section and
        the finder was left on P0/P1/P2, so 20 rows in a project's own
        `## Done this period` archive were listed by `list` and refused by
        `done` with "is not an open row on the board" — a message that was
        false, about rows the same tool had just printed.
        """
        skip = {s.lower() for name in self.NON_TASK_SECTIONS
                for s in heading_spellings(name)}
        heads = [(i, l) for i, l in enumerate(self.lines) if l.startswith("## ")]
        for n, (start, line) in enumerate(heads):
            end = heads[n + 1][0] if n + 1 < len(heads) else len(self.lines)
            title = line[3:].strip()
            if any(title.lower().startswith(s) for s in skip):
                continue
            sep = next((i for i in range(start, end)
                        if re.match(r"^\|\s*:?-{2,}", self.lines[i]) and i > start
                        and self.lines[i - 1].strip().startswith("|")), None)
            if sep is None:
                continue
            pri = next((p for p in ("P0", "P1", "P2")
                        if PRIORITY_RE[p].match(line)), None)
            yield title, pri, sep, split_row(self.lines[sep - 1]), end

    def task_tables(self) -> list[dict]:
        """Every section of this board that holds task-shaped rows.

        `rows()` looks only at `## P0` / `## P1` / `## P2`, which is right for
        the WRITE path — a new row needs a priority and those are the only
        sections that mean one. It is wrong for the read path, and silently so.

        A real Perry project checked while writing this organizes its board by
        workstream: `## Open — 投资线`, `## Open — 工程线 · phase #004`,
        `## ✅ v2.0 build — DEPLOYED`, `## Backbone`, and one `## P2`. Reading
        only P0/P1/P2 found the single section whose name happened to match,
        reported three tasks for a project with dozens, and — because it never
        checked what it was reading — picked up rows from a `## ID prefixes`
        reference table as though they were work. A front-end handed that
        payload shows the user confident nonsense.

        So: every `## ` section whose table resolves at least `ID` and `Title`
        is a task table. `P0`/`P1`/`P2` carry their priority; anything else
        carries its heading as `group` and no priority, because inventing one
        would be claiming the project said something it did not.
        """
        out = []
        for title, pri, sep, header, end in self._task_sections():
            keys = [norm(h) for h in header]
            if "id" not in keys or "title" not in keys:
                # A table under a `## ` heading that is not a task table — a
                # reference table, a glossary, a legend. Reported, not read.
                out.append({"heading": title, "priority": None, "header": header,
                            "rows": [], "readable": False})
                continue
            rows = []
            for i in range(sep + 1, end):
                s = self.lines[i].strip()
                if not s.startswith("|"):
                    if s and not s.startswith(("#", ">")):
                        break
                    continue
                cells = split_row(self.lines[i])
                if cells and cells[0]:
                    rows.append(dict(zip(keys, cells)))
            out.append({"heading": title, "priority": pri, "header": header,
                        "rows": rows, "readable": True})
        return out

    def find(self, task_id: str) -> tuple[str, int, list[str], list[str]]:
        """(priority-or-heading, line index, header, cells) for one row.

        Searches EVERY task-bearing section, not only `P0`/`P1`/`P2`. Needing a
        priority is a rule about `add` — a new row has to be filed somewhere —
        and it was wrongly applied to the whole write path. Locating a row that
        already exists is a different question, and answering it "not on the
        board" about a row `list` had just printed made every archived row
        permanently unclosable.
        """
        for title, pri, sep, header, end in self._task_sections():
            for i in range(sep + 1, end):
                if not self.lines[i].strip().startswith("|"):
                    continue
                cells = split_row(self.lines[i])
                if cells and cells[0].replace("*", "").replace("~", "").strip() == task_id:
                    return pri or title, i, header, cells
        section = self._non_task_row(task_id)
        if section:
            raise Refused(NON_TASK_REFUSAL[section].format(id=task_id))
        raise Refused(f"{task_id} is not a row on the board")

    def _non_task_row(self, task_id: str) -> str | None:
        """The canonical `NON_TASK_SECTIONS` name holding this id, or `None`.

        `find()` used to answer "is not a row on the board" for these, which is
        the defect `_task_sections` documents four docstrings up — *"a message
        that was false, about rows the same tool had just printed"* — and it was
        reintroduced the moment `Cadence` joined the skip list. `perry-task
        cadence-add` writes `CAD-001`, `perry-state --json` lists it, and
        `done` / `status` / `next` / `drop` / `retitle` all said it did not
        exist. Naming the section is half the fix; `NON_TASK_REFUSAL` carries
        the other half, which is the rule and the way forward.
        """
        aliases = {s.lower(): name for name in self.NON_TASK_SECTIONS
                   for s in heading_spellings(name)}
        heads = [(i, l) for i, l in enumerate(self.lines) if l.startswith("## ")]
        for n, (start, line) in enumerate(heads):
            end = heads[n + 1][0] if n + 1 < len(heads) else len(self.lines)
            title = line[3:].strip().lower()
            canonical = next((c for s, c in aliases.items()
                              if title.startswith(s)), None)
            if not canonical:
                continue
            for i in range(start + 1, end):
                s = self.lines[i].strip()
                if not s.startswith("|"):
                    continue
                cells = split_row(self.lines[i])
                if cells and cells[0].replace("*", "").replace("~", "").strip() == task_id:
                    return canonical
        return None

    # -- writing

    def ensure_columns(self, priority: str, needed: list[str]) -> list[str]:
        """Add any missing column to the header, separator and every row.

        The clause only `Verification` had before DESIGN-004: you cannot set a
        cell in a column with no header, and `BOARD_TEMPLATE.md` ships six.
        """
        hdr_i, sep_i, header = self.table(priority)
        missing = [c for c in needed
                   if not any(norm(h) == norm(c) for h in header)]
        if not missing:
            return header
        # A column joining a localized table is written in that table's
        # language. Appending `Stage` beside `阶段序列` would produce a header
        # in two languages and a column `perry-lint`'s localized `match`
        # regexes would then disagree about.
        lang = header_language(header)
        missing = [display_name(c, lang) for c in missing]
        header = header + missing
        self.lines[hdr_i] = render_row(header)
        self.lines[sep_i] = "|" + "|".join(["---"] * len(header)) + "|"
        lo, hi = self.section(priority)
        for i in range(sep_i + 1, hi):
            if not self.lines[i].strip().startswith("|"):
                continue
            cells = split_row(self.lines[i])
            if not cells:
                continue
            self.lines[i] = render_row(cells + [""] * len(missing))
        return header

    def ensure_section(self, heading: str, columns: list[str],
                       before_p0: bool = True) -> None:
        """Create `## <heading>` with its table if the board lacks it.

        `## Intake` is the organ queue mode is built on and the first thing
        `triage` walks. Nothing created it before DESIGN-004, so step 0 gated
        itself on "only applies when the section exists" and no-opped forever
        for every queue track ever made.

        `## Intake` is inserted before `## P0` so it reads above the work it
        becomes, which is the order `modes/queue.md` describes it in. Every
        other section is appended, because that is where `BOARD_TEMPLATE.md`
        puts them — `## User Input Queue` created above the board pushed the
        work below a list of open questions, which is not what a standup reads
        first.

        Heading and columns are both written in the board's own language.
        `ensure_columns` localized new headers and explained why in the same
        round this method was added, and this one hardcoded English — so a
        localized board got `## Intake | Arrived | Request | Outcome |` bolted
        onto a `编号 | 标题 | …` table. One of two siblings fixed is the shape
        every review round here has found.
        """
        rx = heading_re(heading)
        if any(rx.match(l) for l in self.lines):
            return
        try:
            lang = header_language(self.table("P0")[2])
        except Refused:
            lang = "en"
        shown = next((s for s in heading_spellings(heading)[1:]
                      if lang != "en"), heading)
        columns = [display_name(c, lang) for c in columns]
        anchor = (next((i for i, l in enumerate(self.lines)
                        if PRIORITY_RE["P0"].match(l)), len(self.lines))
                  if before_p0 else len(self.lines))
        block = [f"## {shown}", "", render_row(columns),
                 "|" + "|".join(["---"] * len(columns)) + "|", ""]
        self.lines[anchor:anchor] = block

    def named_section(self, heading: str) -> tuple[int, int]:
        """(heading line index, end index) for a named `## ` section.

        The span, not the table — `section_table` answers "where are this
        section's columns" and raises when there are none, which is the right
        answer for a reader and useless to the one caller that has to look at a
        section precisely BECAUSE it is not a table yet.
        """
        rx = heading_re(heading)
        start = next((i for i, l in enumerate(self.lines) if rx.match(l)), None)
        if start is None:
            raise Refused(f"BOARD.md has no `## {heading}` section")
        end = next((i for i in range(start + 1, len(self.lines))
                    if self.lines[i].startswith("## ")), len(self.lines))
        return start, end

    def has_section(self, heading: str) -> bool:
        rx = heading_re(heading)
        return any(rx.match(l) for l in self.lines)

    def section_table(self, heading: str) -> tuple[int, list[str]]:
        """(separator index, header cells) for a named non-priority section."""
        rx = heading_re(heading)
        start = next((i for i, l in enumerate(self.lines) if rx.match(l)), None)
        if start is None:
            raise Refused(f"BOARD.md has no `## {heading}` section")
        for i in range(start, len(self.lines)):
            if self.lines[i].startswith("## ") and i > start:
                break
            if re.match(r"^\|\s*:?-{2,}", self.lines[i]) and i > start:
                return i, split_row(self.lines[i - 1])
        raise Refused(f"`## {heading}` has no table")

    def section_rows(self, heading: str) -> list[tuple[int, list[str]]]:
        """Every row of a named section, across `###` sub-groups.

        The reader tolerates a `###` label inside `## Cadence` or `## Intake`
        and resumes on the same header (`viewer/parsers.py § _parse_cadence`,
        `_parse_task_table`); this stopped at the first one. The two then
        disagreed about what the section contained, and the writers answered the
        disagreement with another false message: `cadence-done` refused a
        sub-grouped row as "not a row in `## Cadence`" while `cadence-add`
        succeeded and widened the header past rows it never padded, leaving a
        ragged table that lints clean. A `>` note is skipped for the same
        reason. Anything else still ends the section — prose after a table is
        the boundary, and reading past it is how a writer starts editing text
        that is not a row.
        """
        sep, _ = self.section_table(heading)
        out = []
        for i in range(sep + 1, len(self.lines)):
            s = self.lines[i].strip()
            if s.startswith("## "):
                break
            if not s.startswith("|"):
                if s and not s.startswith(("#", ">")):
                    break
                continue
            cells = split_row(self.lines[i])
            if cells and cells[0]:
                out.append((i, cells))
        return out

    def ensure_section_columns(self, heading: str, needed: list[str]) -> list[str]:
        """`ensure_columns`, for a named non-priority section.

        Its sibling existed for the priority tables from the day mode columns
        landed; this one did not, so a board that already had
        `## User Input Queue` without `Asked` had nowhere to put the date and
        the tool would have dropped it silently — the same defect that lost
        `--commitment` on the task tables.
        """
        sep, header = self.section_table(heading)
        missing = [c for c in needed
                   if not any(norm(h) == norm(c) for h in header)]
        if not missing:
            return header
        lang = header_language(header)
        header = header + [display_name(c, lang) for c in missing]
        self.lines[sep - 1] = render_row(header)
        self.lines[sep] = "|" + "|".join(["---"] * len(header)) + "|"
        for i, cells in self.section_rows(heading):
            self.lines[i] = render_row(cells + [""] * len(missing))
        return header

    def find_section_row(self, heading: str, row_id: str):
        """(line index, header, cells) for one row of a named section.

        The id column is resolved by NAME through the glossary, like every
        other column this file touches (`schema/README.md § Columns resolve by
        name`). It used to read `cells[0]`, which made the writer disagree with
        the reader on a board that lists its columns in another order:

            board: | Status | Opened | Risk | ID |
            reader (parse_top_risks):    id='RX-001'
            writer (risk-clear RX-001):  "RX-001 is not a row in `## Top risks`"

        `perry-state` reporting a risk that `risk-clear` insists does not exist
        is the same defect class as a column resolved by position anywhere
        else — the row is there, and the tool cannot see it.

        Position stays as the fallback for a section whose header names no id
        column at all: those tables predate the glossary and their first cell
        is the handle by convention.
        """
        _, header = self.section_table(heading)
        keys = [norm(h) for h in header]
        at = next((i for i, k in enumerate(keys) if k in id_column_keys()), 0)
        for i, cells in self.section_rows(heading):
            cell = cells[at] if at < len(cells) else ""
            if cell.replace("*", "").replace("~", "").strip() == row_id:
                return i, header, cells
        raise Refused(f"{row_id} is not a row in `## {heading}`")

    def append_section_row(self, heading: str, values: dict) -> str:
        sep, header = self.section_table(heading)
        rows = self.section_rows(heading)
        at = (rows[-1][0] if rows else sep) + 1
        line = render_row([values.get(norm(h), "") for h in header])
        self.lines.insert(at, line)
        return line

    def append_row(self, priority: str, values: dict, group: str = "") -> str:
        """Append to a priority table, or to a named section when `group` is
        given.

        The write side required `## P0` / `## P1` / `## P2` long after the read
        side learned to see every section. On the only year-old real project
        available — a board filed under `## Open — 投资线` and
        `## Open — 工程线 · phase #004` — `add` refused with "BOARD.md has no
        `## P1` section", so arrivals could be recorded and never routed.

        Creating the missing priority section would have been the wrong fix:
        "no automatic rewrite of a project's existing structure" is an
        Anti-Goal, and a project that files work by workstream is not
        malformed. So the project says where the row goes instead.
        """
        if group:
            sep, header = self.section_table(group)
            check_header(header)
            rows = self.section_rows(group)
            at = (rows[-1][0] if rows else sep) + 1
        else:
            _, _, header = self.table(priority)
            check_header(header)
            at = self.last_row(priority) + 1
        cells = [values.get(norm(h), "") for h in header]
        line = render_row(cells)
        self.lines.insert(at, line)
        return line

    def task_section_headings(self) -> list[str]:
        """Headings a row could be filed under, for a refusal that helps."""
        return [title for title, _, _, header, _ in self._task_sections()
                if {"id", "title"} <= {norm(h) for h in header}]

    def replace_row(self, index: int, header: list[str], values: dict) -> str:
        check_header(header)
        cells = [values.get(norm(h), "") for h in header]
        self.lines[index] = render_row(cells)
        return self.lines[index]

    def remove_row(self, index: int) -> str:
        return self.lines.pop(index)

    def text(self) -> str:
        return "\n".join(self.lines)


_ALIASES: dict[str, str] | None = None
_DISPLAY: dict[str, dict[str, str]] | None = None


def _build_column_maps() -> None:
    """Read `schema § i18n.columns` once — every spelling of every header.

    `perry-task` was the single component in this stack that never consulted
    this table. `perry-state`, `perry-lint` and the viewer all resolve headers
    through it; the writer keyed rows on hardcoded English. Because TASK-033
    routed *every* board write through this tool, that made it the one
    component able to corrupt a board written in the document language Perry
    advertises — and it did, silently, at exit 0: `add` wrote a row of empty
    cells on a `编号 | 标题 | …` board while the journal line and the event
    both asserted the task existed. The tool built to eliminate board-vs-history
    divergence produced it on its first write.

    Perry's own board is English, so no amount of dogfooding could surface
    this. Three review rounds read the migration and missed it for the same
    reason.
    """
    global _ALIASES, _DISPLAY
    aliases: dict[str, str] = {}
    display: dict[str, dict[str, str]] = {}
    try:
        columns = load_schema()["i18n"]["columns"]
    except Exception:
        columns = {}
    for canon, langs in columns.items():
        key = squash(canon)
        # First spelling wins: the table maps two English columns onto one
        # Chinese word in at least one case (`Deadline` / `By when` → 截止),
        # and an arbitrary-but-stable choice beats one that depends on dict
        # ordering. Neither is a board column, so no board write is affected.
        aliases.setdefault(key, key)
        display.setdefault(key, {"en": canon})
        for lang, names in (langs or {}).items():
            for name in names:
                aliases.setdefault(squash(name), key)
                display[key].setdefault(lang, name)
    _ALIASES, _DISPLAY = aliases, display


def days_between(value: str) -> int | None:
    m = re.search(r"\d{4}-\d{2}-\d{2}", value or "")
    if not m:
        return None
    try:
        return (date.today() - datetime.strptime(m.group(0), "%Y-%m-%d").date()).days
    except ValueError:
        return None


def norm(s: str) -> str:
    """A header cell → the canonical key rows are stored under.

    Applied to header cells and to canonical English column names, which is
    every use: a localized header and its English name resolve to one key, so
    `values["status"]` lands in `状态` without any call site knowing that.
    """
    if _ALIASES is None:
        _build_column_maps()
    k = squash(s)
    return _ALIASES.get(k, k)


# The columns that hold a row's handle, in every section that has one. A set
# rather than a single name because `## User Input Queue` calls it `USER-id`
# and the rest call it `ID`; both resolve through the glossary, so `编号` and
# `用户输入编号` land here too. Computed on demand, never at import: `norm()`
# caches the glossary the first time it is called, and calling it while the
# module is still loading would cache an empty one.
def id_column_keys() -> set[str]:
    return {norm("ID"), norm("USER-id")}


def header_language(header: list[str]) -> str:
    """Which language this table's headers are already written in.

    Read off the board rather than out of `.perry/config.md`: a new column has
    to match the row it is joining, and the header is the only thing that
    states that without a second file being right.
    """
    if _ALIASES is None:
        _build_column_maps()
    for cell in header:
        key = norm(cell)
        for lang, name in (_DISPLAY.get(key) or {}).items():
            if lang != "en" and squash(name) == squash(cell):
                return lang
    return "en"


def display_name(canonical: str, lang: str) -> str:
    """The spelling a column gets when this board is missing it."""
    if _ALIASES is None:
        _build_column_maps()
    return (_DISPLAY.get(norm(canonical)) or {}).get(lang, canonical)


_HEADINGS: dict[str, dict[str, str]] | None = None


def heading_spellings(name: str) -> list[str]:
    """Every spelling of a `## <heading>`, canonical English first.

    `ensure_section` and `section_table` matched the English name exactly, so on
    a board that already carried `## 收件` the tool did not see it, appended a
    second `## Intake`, and then read and wrote only the new English one —
    leaving the queue the user was actually filling unreachable by every
    subcommand. `perry-lint` reports the duplicate clean, because the schema
    declares `^Intake\\b|^收件` for the table and says nothing about there being
    one of them.
    """
    global _HEADINGS
    if _HEADINGS is None:
        try:
            _HEADINGS = load_schema()["i18n"].get("headings", {})
        except Exception:
            _HEADINGS = {}
    out = [name]
    for names in (_HEADINGS.get(name) or {}).values():
        out += list(names)
    return out


def check_rung(rung: str, schema: dict) -> str:
    """One validator, because `done` had one and `add` had none.

    `add --rung V4` was accepted and silently dropped — the flag parsed, the
    cell was never written, and the row carried no rung. `--rung NONSENSE` was
    accepted the same way. A flag that does nothing is worse than a missing
    one: the caller believes the value landed.

    `V0` is refused by name wherever a rung is written. It is the label for
    what is being rejected, never a rung a row may carry.
    """
    if not rung:
        return ""
    rungs = schema["enums"]["verification_rung"]
    if rung not in rungs:
        # V0 is left out of the list on purpose: it is in the enum because a
        # linter must be able to name it, and offering it here would advertise
        # a value the next line refuses.
        raise Refused(f"rung {rung!r} is not one of "
                      f"{'/'.join(r for r in rungs if r != 'V0')}")
    if rung == "V0":
        raise Refused(
            "V0 is 'asserted' — it is the name for what is being refused, "
            "never a rung a row may carry")
    return rung


def check_priority(priority: str) -> str:
    """One validator, because there were two and only one of them ran.

    `cmd_add` refused an unknown priority; `cmd_route` passed `args.priority`
    straight into `PRIORITY_RE[...]`, so `route --priority "P2 (低优先 carry)"`
    — a real project's full heading, which is exactly what someone reading
    that board would type — raised `KeyError` instead of refusing. A traceback
    where a refusal belongs, for the third time in this file.

    The value is a key, so validating it in one place and indexing with it in
    another is the shape that guarantees a mismatch eventually.
    """
    if priority and priority not in ("P0", "P1", "P2"):
        raise Refused(f"priority {priority!r} is not one of P0/P1/P2. A board "
                      f"section whose heading carries more than that — "
                      f"`## P2 (低优先 carry)` — is still `--priority P2`; "
                      f"pass the whole heading to `--group` instead")
    return priority


def heading_re(name: str) -> re.Pattern:
    # `(?!\w)` rather than `\b`: a word boundary needs a word char on one
    # side, so a heading ending in punctuation — `## P2 (低优先 carry)` on a
    # real board — never matched, and `--group` refused a section the same
    # tool had just listed as available.
    return re.compile(r"^##\s+(?:%s)(?!\w)" %
                      "|".join(re.escape(s) for s in heading_spellings(name)))


REQUIRED_KEYS = ("id", "title", "owner", "status", "next action", "evidence")


def check_header(header: list[str]) -> None:
    """Refuse to write against a header whose columns we cannot place.

    Without this the failure is a row of blank cells and exit 0 — the tool
    reporting success while writing nothing the row means. A refusal names the
    header it could not read; a blank row names nothing.
    """
    keys = {norm(h) for h in header}
    missing = [k for k in REQUIRED_KEYS if k not in keys]
    if missing:
        raise Refused(
            f"BOARD.md's columns cannot be resolved: no header matches "
            f"{missing}. Found {header}. Column headers may be written in the "
            f"document language, but only spellings listed in "
            f"`schema/state-schema.json § i18n.columns` are recognized — "
            f"nothing was written")


def widening_columns(header: list[str], values: dict) -> list[str]:
    """Every column this row needs that the section may be widened to carry.

    A project's own section can be NARROWER than the six required columns — one
    real board files work under `| ID | Title | Owner | Status |` — and writing
    only what fits drops `Next action` and `Evidence` silently. So the required
    six are added, not just the mode extras.

    **A header whose IDENTITY columns cannot be resolved is refused instead.**
    That is not a narrow table, it is an unknown one: appending `ID` and `Title`
    beside `甲` and `乙` produces a row whose first two cells are blank and an
    exit code of 0, which is `check_header`'s own reason for existing wearing a
    disguise. Narrow means "this project wrote fewer columns"; unreadable means
    "we do not know what these columns are", and only the first can be fixed by
    adding more.
    """
    if not {"id", "title"} <= {norm(h) for h in header}:
        check_header(header)
    return [canonical_column(k) for k in REQUIRED_KEYS] + columns_for(values)


# ── ids ───────────────────────────────────────────────────────────────────


ID_RE = re.compile(r"\bTASK-(\d+)\b")

#: The default family, and the one every project that has never said otherwise
#: gets. Not special beyond being the default.
DEFAULT_PREFIX = "TASK"

#: A prefix is one or more `-`-joined segments, each starting with a LETTER.
#: `AIM`, `ARCH-V2` and `RW` pass; `TASK-001` does not, because `001` starts
#: with a digit — which is exactly the rule that keeps a whole id from being
#: mistaken for a prefix.
PREFIX_RE = re.compile(r"^[A-Za-z][A-Za-z0-9]*(?:-[A-Za-z][A-Za-z0-9]*)*$")

#: Prefixes this file mints for OTHER registers. A task minted as `RX-005`
#: would collide with the risk register's own numbering, and both writers would
#: then be right about their own file and wrong about the project.
RESERVED_PREFIXES = {"USER", "RX", "CAD", "CADENCE"}

#: An id cell → `(prefix, number-or-None)`. The contract says an id is opaque
#: and that some carry no number at all, so the number half is optional.
_ID_SHAPE = re.compile(r"^(?P<prefix>.+?)-(?P<tail>[^-]*)$")


def board_id_prefixes(board: Board) -> dict[str, int]:
    """`{prefix: how many NUMBERED ids the board files under it}`.

    Read from the `ID` cell of every readable TASK table, never from the whole
    document: `## Top risks`, `## Cadence` and `## User Input Queue` have their
    own families, and a `## ID prefixes` reference table is prose about ids
    rather than ids. A prefix with a zero count is one the board uses without
    numbers — it is a family, so it counts toward "how many families", but
    nothing can be minted into it.
    """
    counts: dict[str, int] = {}
    for tbl in board.task_tables():
        if not tbl["readable"]:
            continue
        for cells in tbl["rows"]:
            raw = (cells.get("id") or "").replace("~", "").replace(
                "*", "").replace("`", "").strip()
            m = _ID_SHAPE.match(raw)
            if not m or not PREFIX_RE.match(m.group("prefix")):
                continue
            p = m.group("prefix")
            counts[p] = counts.get(p, 0) + (1 if m.group("tail").isdigit() else 0)
    return counts


def resolve_prefix(board: Board, requested: str | None) -> str:
    """Which family a NEW id is minted into (TASK-060).

    On a board whose 17 rows are `AIM-001`…`AIM-017`, `add` minted `TASK-001`.
    Legitimate — the contract says ids are opaque and a board may carry several
    project-declared prefixes — but a user creating a task from a front-end
    watched their board sprout a second id family, and there was no flag with
    which to ask for the first. aiMark passes no id and *cannot*: nothing in
    the surface would let it.

    **The rule, and why it is not "adopt the most common prefix".**

    1. `--prefix` wins. It is the answer for every case, and it is the only
       answer for a board that carries several families or wants a new one.
    2. Otherwise, adopt the board's prefix **only when the board has exactly
       one**. Then there is nothing to guess: it is the only family the board
       has ever used.
    3. Otherwise `TASK`, unchanged.

    Rule 2 stops at one on purpose. `~/proj/gimegime-pmo` carries **36**
    families across its task tables, a dozen of them declared in its own
    `## ID prefixes (canonical)` section, and they are not stylistic:
    `IPS-*` / `ALLOC-*` / `DUE-*` mean 投资线 and `TECH-*` /
    `DATA-*` mean 工程线, filed in physically separate sections for a reason
    the board states. A plurality winner there mints an id that ASSERTS the row
    belongs to a workstream nobody chose — and an id is permanent and never
    reissued, so that assertion cannot be taken back. A foreign-looking
    `TASK-001` on such a board is visibly Perry's and obviously not a claim
    about the work; a wrong-family `IPS-014` is a claim, and a false one.
    Guessing is only safe where there is exactly one thing to guess.
    """
    if requested:
        p = requested.strip().rstrip("-")
        if not PREFIX_RE.match(p):
            raise Refused(
                f"--prefix {requested!r} is not an id prefix. Segments are "
                f"joined by `-` and each starts with a letter (`AIM`, "
                f"`ARCH-V2`); the number is appended by Perry, so pass "
                f"`AIM`, not `AIM-018`")
        if p.upper() in RESERVED_PREFIXES:
            raise Refused(
                f"--prefix {p!r} is the family `perry-task` mints for another "
                f"register on this same board ({sorted(RESERVED_PREFIXES)}). "
                f"A task numbered in it would collide with rows the tool "
                f"writes itself")
        return p
    families = board_id_prefixes(board)
    if len(families) == 1:
        only, numbered = next(iter(families.items()))
        # A family with no numbered id has nothing to count from, so minting
        # into it would start at 001 beside ids that are not numbers — Perry
        # would be inventing a numbering the project did not choose.
        if numbered and only.upper() not in RESERVED_PREFIXES:
            return only
    return DEFAULT_PREFIX


def mint_id(board: Board, events: list[dict], state_root: Path | None = None,
            prefix: str | None = None) -> str:
    """Next id from max(board ∪ journal ∪ events), within one prefix.

    A task whose row has closed still owns its number — reading only the board
    would hand a live id to a second task and silently re-point every reference
    to the first.

    **The journal is why this is safe, and it was missing.** Board and events
    alone put ID uniqueness at the mercy of `.perry/events.jsonl`, which this
    tool declares derived and disposable: delete it, and the next `add` reissues
    the number of every already-closed task, because a closed task is in neither
    remaining source. The docstring promised that deleting the log costs
    "history resolution and drift detection, not truth" — a reused id IS truth,
    and every journal line, evidence file and commit message naming the old task
    silently re-points to the new one.

    The journal closes it: it is canonical, append-only, and carries a creation
    line for every task ever raised — the one record that every procedure here
    forbids editing, including on drop and close. So an id is never reissued as
    long as the canonical files survive, and the disposable file is genuinely
    disposable again.

    **The three sources are scanned for the prefix being minted into, not for
    `TASK-`.** They were scanned for `TASK-` while the id was always `TASK-`,
    and once `resolve_prefix` could return `AIM` that spelling would have made
    the counter read a different family's numbers than the one it was about to
    write — `AIM-001` minted onto a board already holding `AIM-017`, which is
    the reissue this function exists to make impossible.
    """
    pat = re.compile(rf"\b{re.escape(prefix or DEFAULT_PREFIX)}-(\d+)\b")
    seen = {int(m) for _, line, _ in board.rows() for m in pat.findall(line)}
    seen |= {int(m) for e in events for m in pat.findall(e.get("id", ""))}
    seen |= {int(m) for m in pat.findall(board.text())}
    if state_root is not None:
        for p in sorted((state_root / "journal").rglob("*.md")):
            try:
                seen |= {int(m) for m in pat.findall(p.read_text(errors="replace"))}
            except OSError:
                continue
    return f"{prefix or DEFAULT_PREFIX}-{max(seen, default=0) + 1:03d}"


# ── events ────────────────────────────────────────────────────────────────


def events_path(project_root: Path) -> Path:
    return project_root / ".perry" / "events.jsonl"


def read_events(project_root: Path) -> list[dict]:
    p = events_path(project_root)
    if not p.exists():
        return []
    out = []
    for line in p.read_text(errors="replace").split("\n"):
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue  # a corrupt line is not a reason to refuse a write
    return out


# ── the atomic three-way write ────────────────────────────────────────────


def commit(project_root: Path, state_root: Path, board: Board,
           journal_line: str, event: dict, dry_run: bool,
           definition: str = "") -> dict:
    """Write the two canonical files together, then the derived event.

    **The guarantee, stated exactly.** `BOARD.md` and the journal are staged to
    temp files and renamed (atomic on POSIX), so either both land or neither
    does — that pair is what "atomic" covers, and it is the pair that matters,
    because a board row without its journal line is the divergence this tool
    exists to remove. The event is appended *after*, and can fail on its own.

    So the honest claim is: **the canonical files never disagree with each
    other; the derived record may be missing.** Four surfaces used to say "none
    of the three if any would fail", which is stronger and false — an
    unwritable `.perry/` left the row and the journal line on disk and the
    event absent, as an uncaught traceback. A guarantee overstated in prose is
    the same defect as one asserted in a row nothing implements.

    That direction of failure is chosen, not tolerated: DESIGN-004 declares the
    event log derived and disposable, and a missing event is exactly the
    `unrecorded` condition drift reconciliation reports. Losing an event costs
    history resolution. Losing a board write costs the truth.
    """
    jpath = state_root / "journal" / f"{date.today():%Y-%m}" / f"{date.today():%Y-%m-%d}.md"
    plan = {
        "board": str(board.path),
        "journal": str(jpath),
        "events": str(events_path(project_root)),
        "journal_line": journal_line,
        "event": event,
    }
    if dry_run:
        return plan

    jtext = ""
    if jpath.exists():
        jtext = jpath.read_text()
    elif not jpath.parent.exists():
        jpath.parent.mkdir(parents=True, exist_ok=True)
    jtext = append_status_change(jtext, journal_line)
    if definition:
        # The task's full definition, written at creation. It used to be the
        # agent's job — `add-task` step 2 said "the tool writes the one-line
        # status change; this block is the rich record and is still written by
        # hand" — and the hand never wrote it. Measured the day this landed:
        # `## New tasks added` appeared 3 times in the journal of the day
        # BEFORE the tool existed and 0 times after, so every tool-created task
        # was one title and nothing else.
        jtext = append_block(jtext, "New tasks added", definition)

    # Stage both canonical files before renaming either.
    staged: list[tuple[str, Path]] = []
    try:
        for path, text in ((board.path, board.text()), (jpath, jtext)):
            fd, tmp = tempfile.mkstemp(dir=str(path.parent), suffix=".tmp")
            with os.fdopen(fd, "w") as fh:
                fh.write(text)
                fh.flush()
                os.fsync(fh.fileno())
            staged.append((tmp, path))
        while staged:
            # Pop as we go. Clearing the whole list inside the loop meant a
            # failure on the second rename left the first temp file orphaned
            # beside BOARD.md with nothing to clean it up.
            tmp, path = staged.pop(0)
            os.replace(tmp, path)
    finally:
        for tmp, _ in staged:
            try:
                os.unlink(tmp)
            except OSError:
                pass

    plan["event_written"] = True
    ev = events_path(project_root)
    try:
        ev.parent.mkdir(parents=True, exist_ok=True)
        with open(ev, "a") as fh:
            fh.write(json.dumps(event, ensure_ascii=False) + "\n")
    except OSError as exc:
        # The canonical write already landed and is correct. Report the loss
        # instead of crashing: a traceback here would suggest the whole call
        # failed, and the caller would be right to retry it — producing a
        # second row for work already recorded.
        plan["event_written"] = False
        print(f"perry-task: warning — {board.path.name} and the journal were "
              f"written, but the event could not be appended to {ev}: {exc}. "
              f"State is correct; this row will show as `unrecorded` at the "
              f"next standup until the log is writable again.", file=sys.stderr)
    return plan


def append_block(text: str, heading: str, block: str) -> str:
    """Append a multi-line block under the LAST `## <heading>` of the day.

    Same walk as `append_status_change` and for the same reason — a day's
    journal accumulates several of each heading, and appending to the first
    buries this afternoon's entry inside this morning's.
    """
    if not text.strip():
        text = f"# {date.today():%Y-%m-%d}\n"
    lines = text.split("\n")
    starts = [i for i, l in enumerate(lines) if l.strip() == f"## {heading}"]
    if not starts:
        return text.rstrip("\n") + f"\n\n## {heading}\n\n" + block.rstrip("\n") + "\n"
    start = starts[-1]
    i = start + 1
    end = start
    while i < len(lines):
        s = lines[i].strip()
        if s.startswith("## "):
            break
        if s:
            end = i
        i += 1
    lines[end + 1:end + 1] = ["", block.rstrip("\n")]
    return "\n".join(lines)


def append_status_change(text: str, line: str) -> str:
    """Append under the LAST `## Status changes` of the day, creating it if none.

    The last, not the first. A day's journal accumulates one `## Status changes`
    per entry — this session's had seventeen — and appending to the first buries
    a change that happened at 18:33 inside the block written at 09:00. The file
    stays chronological only if new lines land at the end of it, which is the
    whole point of an append-only record.
    """
    if not text.strip():
        text = f"# {date.today():%Y-%m-%d}\n"
    lines = text.split("\n")
    starts = [i for i, l in enumerate(lines) if l.strip() == "## Status changes"]
    if not starts:
        return text.rstrip("\n") + "\n\n## Status changes\n\n" + line + "\n"

    start = starts[-1]
    # Walk to the end of that section's list: past its blank line, over its
    # bullets and table rows, stopping at the next heading or at prose.
    i = start + 1
    last_item = start
    while i < len(lines):
        s = lines[i].strip()
        if s.startswith("#"):
            break
        if s.startswith("- ") or s.startswith("|"):
            last_item = i
        elif s:
            break
        i += 1
    lines.insert(last_item + 1, line)
    return "\n".join(lines)


# ── subcommands ───────────────────────────────────────────────────────────


def stages_of(schema: dict, track: dict) -> list[str]:
    """The track's declared stage vocabulary, else its mode's default.

    Consumes `parse_tracks`'s computed `stage_list` rather than re-splitting
    `stages`. Both readings existed and nothing asserted they agreed — the
    register was parsed once into a list and then parsed again here from the
    raw cell, which is the same "one rule, two implementations" shape that put
    the `->` / `→` separator bug in circulation to begin with.
    """
    declared = track.get("stage_list")
    if declared is None:
        declared = split_stages(track.get("stages", ""))
    return list(declared) or default_stages(schema, track["mode"])


def entry_stage(mode: str, stages: list[str]) -> str:
    """The stage a row is born in.

    A QUEUE row skips `stages[0]`, because that stage means "sitting in
    intake" and the row has either just left intake (`route`) or never was
    there (`add`). A pipeline or inquiry row has no such stage to skip and must
    enter at the first one — routing those to `stages[1]` silently skipped
    `brief` / `open`.

    One function because it was two: `cmd_add` and `cmd_route` each carried the
    expression, both written in the same round. The rule is per-mode and it is
    the moment a row's clock starts, so a future mode that enters somewhere
    else has exactly one place to say so.
    """
    if mode == "queue" and len(stages) > 1:
        return stages[1]
    return stages[0] if stages else ""


def check_stage(track: dict, stages: list[str], stage: str) -> None:
    """Refuse a stage outside the track's vocabulary — on creation as on moves.

    `stage` enforced this from the day it shipped. `add` and `route` took
    `--stage` verbatim, so `--stage bogus` wrote a cell no reader can classify
    and exited 0: the vocabulary was checked when a row *moved* and not when it
    was *born*, which is the one moment the cell has no prior value to fall
    back to.
    """
    if stage and stages and stage not in stages:
        raise Refused(f"stage {stage!r} is not in track {track['track']!r}'s "
                      f"vocabulary {stages}")


def track_of(config: dict, name: str) -> dict:
    for t in config.get("tracks", []):
        if t["track"] == name:
            return t
    if name and name != "main":
        raise Refused(
            f"track {name!r} is not declared in `.perry/config.md § Tracks`; "
            f"declared: {[t['track'] for t in config.get('tracks', [])]}")
    return {"track": "main", "mode": "project", "default_rung": ""}


def target_section(board: "Board", args) -> tuple[str, str]:
    """Where a NEW row is filed: `(priority, group)`, one of them empty.

    One function because it was one function and a hole. `cmd_add` grew the
    `--group` branch — parse the flag, skip the `## P<n>` requirement, file
    under the project's own heading — and `cmd_route` grew nothing: `--group`
    parsed into `args.group` and `cmd_route` never read it. So on a board with
    no `## P0`/`## P1`/`## P2` at all, which is `~/proj/gimegime-pmo`'s actual
    shape, the intake drain had no landing site and could not be given one.

    Worse than a missing feature: `check_priority`'s refusal *recommends* the
    flag — "pass the whole heading to `--group` instead" — so the tool's own
    advice, followed exactly, produced the same refusal a second time. The
    round-5 fix repaired the narrow-columns half of this and its guard's
    fixture carries a `## P1`, so the guard could not fail on the missing
    heading half. `--group` is now read in the one place every writer that
    files a row asks the question.
    """
    group = args.group or ""
    # A group names the section outright, so there is no priority to default:
    # defaulting one would file the row under `## P1` on a board that has none.
    priority = check_priority(args.priority or ("" if group else "P1"))
    if not group:
        try:
            board.table(priority)
        except Refused:
            headings = board.task_section_headings()
            raise Refused(
                f"BOARD.md has no `## {priority}` section, and this project "
                f"files work under its own headings. Name one with --group: "
                f"{headings or '(none carry ID+Title columns)'}. Perry will "
                f"not create a priority section on a board that does not use "
                f"them — rewriting a project's structure is an Anti-Goal")
    return priority, group


def widen_target_section(board: "Board", priority: str, group: str,
                         values: dict) -> None:
    """Add the columns `values` needs to whichever section was named.

    Existing rows are widened with empty cells; nothing is moved.

    **Both branches, because the board does not care which flag named the
    section.** The widening landed on `--group` alone once already, so on the
    one real adopted project available `add --group P2` succeeded and
    `add --priority P2` refused with "columns cannot be resolved" on the same
    four-column `## P2` — the narrow-section case is *more* likely under a
    priority heading, because a hand-written `## P2 (低优先 carry)` is the
    shape a project reaches for when it wants a short list.
    """
    if group:
        _, header = board.section_table(group)
        board.ensure_section_columns(group, widening_columns(header, values))
    else:
        _, _, header = board.table(priority)
        board.ensure_columns(priority, widening_columns(header, values))


def cmd_add(args, ctx) -> dict:
    if not args.title:
        raise Refused("--title is required")
    # A task whose only record is a title cannot be picked up by anyone who was
    # not in the conversation that created it. `add-task` step 2 asked an agent
    # to write the definition block by hand and nothing checked; the day this
    # landed, `## New tasks added` appeared three times in the journal written
    # BEFORE the tool existed and zero times after, and 6 of 10 open rows had
    # no written definition at all.
    if not args.deliverable:
        raise Refused(
            "--deliverable is required: name the ARTIFACT that exists when "
            "this is done, not the activity. 'refactor the parser' is an "
            "activity; 'parser resolves columns by name, with a test' is an "
            "artifact somebody else can check")
    if not args.verification:
        raise Refused(
            "--verification is required and must be falsifiable. 'looks good' "
            "is not a check; 'perry-lint clean on gimegime-pmo' is. This is "
            "the field the V-rungs are graded against, so a task without it "
            "cannot honestly close above V1")
    # `--verification` and `--rung` share a word and mean different things: this
    # one is the falsifiable CHECK a rung is graded against, `--rung` is the
    # rung itself and the cell the board shows. Typing the rung here is the
    # obvious mistake — it was made while opening six rows on Perry's own board
    # the night this was written — and it used to be accepted silently, filing
    # "V4" as though it were a check and leaving nothing to grade.
    #
    # Shaped as the CATEGORY, not the one spelling: any value that is nothing
    # but a rung token. A real check is prose and cannot be mistaken for one.
    if args.verification.strip() in ctx["schema"]["enums"]["verification_rung"]:
        raise Refused(
            f"--verification {args.verification.strip()!r} is a rung, not a "
            f"check. Pass the rung as --rung {args.verification.strip()} and "
            f"give --verification the falsifiable check it is graded against "
            f"— what someone else would run to disagree with you")
    track = track_of(ctx["config"], args.track or "main")
    mode = track["mode"]
    prefix = resolve_prefix(ctx["board"], args.prefix)
    tid = mint_id(ctx["board"], ctx["events"], ctx["state_root"], prefix)
    priority, group = target_section(ctx["board"], args)

    if mode == "project" and args.stage:
        # Project mode has no stages at all, so there is no vocabulary to check
        # the value against and nowhere for it to land. Swallowing it is the
        # same silent discard `--commitment` used to perform: the caller
        # believes they set something.
        raise Refused(
            f"track {track['track']!r} is mode `project`, which has no stages "
            f"(`modes/project.md`); --stage has nowhere to go")

    today = f"{date.today():%Y-%m-%d}"
    values = {
        "id": tid, "title": args.title,
        "owner": args.owner or "Coding Agent",
        "status": "not_started",
        "next action": args.next or "—",
        "evidence": "—",
    }
    if mode != "project":
        values["track"] = track["track"]
        stages = stages_of(ctx["schema"], track)
        check_stage(track, stages, args.stage)
        # Queue rows raised directly skip intake, so they start at the first
        # POST-intake stage — the same one `route` assigns, from the same
        # function.
        values["stage"] = args.stage or entry_stage(mode, stages)
        if mode == "queue":
            values["arrived"] = args.arrived or today
        else:
            values["stage since"] = today
        if args.parent:
            values["parent"] = args.parent
    if args.commitment:
        values["commitment"] = args.commitment
    rung = check_rung(args.rung, ctx["schema"])
    if rung:
        values["verification"] = rung

    # Run the real path in both cases. `commit()` is what `--dry-run` skips;
    # everything up to it happens for real against the in-memory Board, which is
    # discarded when the process exits.
    #
    # Previously the dry run took a shortcut, and it lied twice: it never called
    # `check_header`, so a board the real call refuses previewed a row and
    # exited 0 — "the tool reporting success while writing nothing the row
    # means" is `check_header`'s own reason for existing. And it rendered from a
    # hardcoded six-name tuple, so `--commitment` and `--track` were invisible
    # in the preview while the real write set them. A preview that is not the
    # write is worse than no preview.
    widen_target_section(ctx["board"], priority, group, values)
    if mode == "queue":
        # The section `triage` step 0 walks. Nothing created it before, so
        # step 0's "only applies when the section exists" gate no-opped
        # forever for every queue track ever made.
        ctx["board"].ensure_section("Intake", ["Arrived", "Request", "Outcome"])

    line = ctx["board"].append_row(priority, values, group=group)
    jline = (f"- [{tid}] — → not_started · {args.title} · "
             f"owner: {values['owner']} · priority: {priority}")
    definition = "\n".join([
        f"### {tid} — {args.title}", "",
        f"- **Owner**: {values['owner']}",
        f"- **Priority**: {priority}",
        f"- **Track / mode**: {track['track']} / {mode}",
        f"- **Deliverable**: {args.deliverable}",
        f"- **Verification**: {args.verification}",
        f"- **Dependencies**: {args.depends or '—'}",
        f"- **Out of scope**: {args.out_of_scope or '—'}",
        f"- **KR linkage**: {args.kr or 'unlinked'}",
    ])
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "add",
             "id": tid, "title": args.title, "track": track["track"], "mode": mode,
             "priority": priority, "actor": args.actor,
             "from": None, "to": "not_started"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run, definition=definition)
    return {"id": tid, "priority": priority, "prefix": prefix,
            "row": line, **plan}


def cmd_start(args, ctx) -> dict:
    tid = args.id
    pri, idx, header, cells = ctx["board"].find(tid)
    values = dict(zip([norm(h) for h in header], cells))
    prev = values.get("status", "")
    if prev == "in_progress":
        raise Refused(f"{tid} is already in_progress")
    values["status"] = "in_progress"
    if args.next:
        values["next action"] = args.next
    # `Stage since` is NOT touched here. It used to be, and `Status` and
    # `Stage` are orthogonal by design — starting work does not move a row to a
    # new stage, so restamping the clock reported 0 days' dwell for an item
    # that had sat in `review` for a fortnight. `dispatch` calls `start` on
    # every automated run, so this was the automated path, not a manual slip,
    # and it blinded pipeline triage's first question — the one aimed at that
    # mode's signature failure. The schema says this cell is "the date the row
    # entered its current Stage"; `cmd_stage` is its only writer.
    line = ctx["board"].replace_row(idx, header, values)
    jline = f"- [{tid}] {prev or '—'} → in_progress · started"
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "start",
             "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"),
             "actor": args.actor, "from": prev, "to": "in_progress"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "row": line, **plan}


def cmd_done(args, ctx) -> dict:
    tid = args.id
    if not args.evidence:
        raise Refused(
            f"{tid}: --evidence is required. Perry refuses `done` without it — "
            f"a claim of done that cites nothing is a claim about confidence, "
            f"not about the work")
    rung = check_rung(args.rung, ctx["schema"])
    pri, idx, header, cells = ctx["board"].find(tid)
    values = dict(zip([norm(h) for h in header], cells))
    prev = values.get("status", "")
    if not rung:
        track = track_of(ctx["config"], values.get("track", "main"))
        rung = (track.get("default_rung")
                or ctx["schema"]["work_modes"]["modes"][track["mode"]]["default_rung"])
    line = ctx["board"].remove_row(idx)
    jline = (f"- [{tid}] {prev or '—'} → done · closed · "
             f"evidence: `{args.evidence}` · verification: {rung}")
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "done",
             "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"),
             "actor": args.actor, "from": prev, "to": "done",
             "evidence": args.evidence, "rung": rung}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "rung": rung, "removed": line, **plan}


def cmd_stage(args, ctx) -> dict:
    """Move an item to a new stage and re-stamp its clock in the same write.

    Unconditional. `Stage` and `Status` are orthogonal by design, so a
    `draft → review` move produces no status change and would otherwise leave
    no trace anywhere — which is exactly how the dwell-time rule survived three
    review rounds as prose that nothing could compute.
    """
    tid, stage = args.id, args.stage
    if not stage:
        raise Refused("a stage is required: perry-task stage <ID> --stage <name>")
    pri, idx, header, cells = ctx["board"].find(tid)
    values = dict(zip([norm(h) for h in header], cells))
    track = track_of(ctx["config"], values.get("track", "main"))
    stages = stages_of(ctx["schema"], track)
    check_stage(track, stages, stage)
    prev = values.get("stage", "")
    if prev == stage:
        raise Refused(f"{tid} is already at stage {stage!r}")
    values["stage"] = stage
    values["stage since"] = f"{date.today():%Y-%m-%d}"
    # Create the column before writing to it. Without this the stamp was
    # dropped on any board that lacked `Stage since` — `replace_row` maps
    # values onto headers, so a missing header silently discards the value and
    # the call still exits 0. Same defect that lost `--commitment`.
    header = ctx["board"].ensure_columns(pri, ["Stage since"]) \
        if pri in ("P0", "P1", "P2") else header
    line = ctx["board"].replace_row(idx, header, values)
    jline = f"- [{tid}] stage {prev or '—'} → {stage}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "stage",
             "id": tid, "title": values.get("title", ""),
             "track": track["track"], "actor": args.actor,
             "from": prev, "to": stage}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "stage": stage, "row": line, **plan}


def cmd_status(args, ctx) -> dict:
    """Any status transition the named subcommands do not cover.

    `add`/`route`, `start`, `done` and `drop` cover four of the six statuses.
    `blocked` and `review` had no tool path at all — and `dispatch` moves rows
    into `review` on every run, so every dispatch manufactured a post-tool edit
    that drift detection would report forever. A gap in coverage becomes a
    permanent false signal the moment detection exists, which is why this is not
    a nice-to-have.
    """
    tid, want = args.id, args.status
    allowed = ctx["schema"]["enums"]["task_status"]
    if not want:
        raise Refused(f"--status is required, one of {allowed}")
    if want not in allowed:
        raise Refused(f"status {want!r} is not one of {allowed}")
    if want in ("done", "dropped"):
        raise Refused(
            f"use `perry-task {'done' if want == 'done' else 'drop'}` — those "
            f"close a row and need evidence or a reason, which this does not take")
    pri, idx, header, cells = ctx["board"].find(tid)
    values = dict(zip([norm(h) for h in header], cells))
    prev = values.get("status", "")
    if prev == want:
        raise Refused(f"{tid} is already {want}")
    if want == "blocked" and not args.reason:
        raise Refused(
            f"{tid}: blocked needs --reason naming what it waits on. A blocked "
            f"row with no named dependency is a row nobody can unblock")
    values["status"] = want
    if args.next:
        values["next action"] = args.next
    elif want == "blocked":
        values["next action"] = f"blocked on {args.reason}"
    line = ctx["board"].replace_row(idx, header, values)
    tail = f" · {args.reason}" if args.reason else ""
    jline = f"- [{tid}] {prev or '—'} → {want}{tail}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "status",
             "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"), "actor": args.actor,
             "from": prev, "to": want, "reason": args.reason or ""}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "status": want, "row": line, **plan}


def cell_writer(field: str, flag: str, event: str, why: str,
                validate=None, terminal_ok: bool = True,
                required_msg: str = "", show_previous: bool = True):
    """One implementation for "correct this cell and nothing else".

    There were three — `next`, `retitle`, `rung` — written weeks apart and each
    a copy of the previous, and the fourth was about to be written for
    `Evidence` when a corrupted row needed repairing and no tool could do it.
    Three copies of one rule is the defect class this project has spent five
    review rounds finding in its own prose; here it was in its own code.

    Each writer keeps its own **event name**, which is the part that is not
    boilerplate. A reader has to be able to tell "the plan changed" from "what
    this is called changed" from "where this got to", and folding them into one
    event loses all three facts at once.
    """
    def run(args, ctx) -> dict:
        tid = args.id
        value = getattr(args, flag)
        if not value:
            raise Refused(required_msg or
                          f"--{flag.replace('_', '-')} is required: this "
                          f"subcommand exists to write that cell")
        if validate:
            value = validate(value, ctx)
        pri, idx, header, cells = ctx["board"].find(tid)
        values = dict(zip([norm(h) for h in header], cells))
        if not terminal_ok:
            status = values.get("status", "").strip().strip("*` ").lower()
            if status in ("done", "dropped"):
                raise Refused(f"{tid} is {values.get('status', '').strip()} — "
                              f"a row that has finished has no next step")
        prev = values.get(field, "")
        if prev.strip() == value.strip():
            raise Refused(f"{tid}'s {field} is already that")
        ctx["board"].ensure_columns(pri, [canonical_column(field)])
        pri, idx, header, cells = ctx["board"].find(tid)
        values = dict(zip([norm(h) for h in header], cells))
        values[field] = value
        line = ctx["board"].replace_row(idx, header, values)
        # Each writer keeps the journal line it shipped with. Unifying the
        # format would have been a behaviour change wearing a refactor's
        # clothes — `next` writes the new value alone, its two siblings write
        # the transition, and a reader may be parsing either.
        jline = (f"- [{tid}] {why} · {prev or '—'} → {value}" if show_previous
                 else f"- [{tid}] {why} · {value}")
        ev = {"ts": datetime.now().isoformat(timespec="seconds"),
              "event": event, "id": tid, "title": values.get("title", ""),
              "track": values.get("track", "main"), "actor": args.actor,
              "from": prev, "to": value}
        plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                      jline, ev, args.dry_run)
        return {"id": tid, field: value, "row": line, **plan}
    return run


#: `next` — the most common thing a triage does, and it had no tool path until
#: TASK-041: `status` is the only other writer of that cell and it refuses a
#: no-op, so correcting a plan meant changing a status the row did not warrant.
#: It refuses a finished row: a row that has completed has no next step, and
#: writing one puts a live-looking instruction on finished work.
cmd_next = cell_writer(
    "next action", "next", "next", "next action", terminal_ok=False,
    show_previous=False,
    required_msg="--next is required: this subcommand exists to write that "
                 "cell, and clearing it would leave the row with no stated "
                 "next step")

#: `retitle` — a row filed as two pieces of work whose second half later splits
#: out carries a title describing work it will never do. Safe because the `Id`
#: is the identity and never moves: a `Commitment` cell, a linkage graph and
#: every event point at the id, and none of them reads the title. That is also
#: why there is no subcommand for changing an id.
cmd_retitle = cell_writer(
    "title", "title", "retitle", "retitled",
    required_msg="--title is required: this subcommand exists to write that "
                 "cell, and a row with no title is one nobody can find")

#: `rung` — `--rung` lived only on `done`, which is after the argument matters.
#: `ADR-005` is what makes the cell load-bearing: it is a claim about who is
#: hurt when the work is wrong, and a claim nobody can correct without a hand
#: edit is one nobody corrects.
cmd_rung = cell_writer("verification", "rung", "rung", "rung",
                       validate=lambda v, ctx: check_rung(v, ctx["schema"]))

#: `evidence` — the fourth, and the one that showed the other three were a
#: pattern. A row whose `Evidence` cell was corrupted could not be repaired:
#: `done --evidence` is the only other writer and closing a row to fix a cell
#: is not a correction, it is a lie about the work.
cmd_evidence = cell_writer("evidence", "evidence", "evidence", "evidence")


def cmd_drop(args, ctx) -> dict:
    """Remove a row deliberately, with a reason, and record why.

    Missing until a review found it: `drop` was in the accepted-subcommand
    guard and absent from the dispatch table, so it raised a bare KeyError.
    Worse than the crash was the consequence — a hand-removed row leaves its
    `add` event with no row and no close, which is drift's second condition, so
    every drop done by hand permanently manufactured the exact false drift
    § 5.7 exists to prevent.

    **The row leaves the board and the stage it died in does not.** Removing
    the row is deliberate: `BOARD.md` holds open work, a dropped item is not
    open work, and every count in both queue and pipeline mode is defined over
    rows that are still there. But `modes/pipeline.md` asks the record to say
    *where* an item died — that is the whole diagnostic value of a drop in a
    staged mode, since three items dying at `review` is a fact about the review
    stage and not about the three items. That fact used to be destroyed: the
    only cell holding it went with the row, and neither the journal line nor
    the event carried it. So `Stage` is written into both surfaces that
    survive, which is where every other post-removal question is already
    answered from.
    """
    tid = args.id
    if not args.reason:
        raise Refused(
            f"{tid}: --reason is required. A row that leaves the board without "
            f"one is indistinguishable from a row that was lost")
    pri, idx, header, cells = ctx["board"].find(tid)
    values = dict(zip([norm(h) for h in header], cells))
    prev = values.get("status", "")
    stage = values.get("stage", "").strip()
    line = ctx["board"].remove_row(idx)
    jline = (f"- [{tid}] {prev or '—'} → dropped · "
             + (f"at stage: {stage} · " if stage else "")
             + f"reason: {args.reason}")
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "drop",
             "id": tid, "title": values.get("title", ""),
             "track": values.get("track", "main"),
             # Empty on a project-mode row, which has no stages at all — the
             # key is always present, because a consumer that has to branch on
             # a missing key is a consumer that will forget to.
             "stage": stage, "actor": args.actor,
             "from": prev, "to": "dropped", "reason": args.reason}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "reason": args.reason, "removed": line, **plan}


def cmd_resolve_intake(args, ctx) -> dict:
    """Discharge an intake row without routing it — dropped or deferred.

    `triage` mandates that every intake row leave as routed, dropped-with-a-
    reason, or deferred-with-a-named-condition. Only the first had a tool, so
    two of three outcomes were still hand-written and invisible to every count
    and to drift detection.
    """
    if not args.reason:
        raise Refused("--reason carries the drop reason or the defer condition")
    rows = ctx["board"].section_rows("Intake")
    try:
        n = int(args.id or "0")
    except ValueError:
        raise Refused("resolve-intake takes the intake row number")
    if not 1 <= n <= len(rows):
        raise Refused(f"intake row {n} does not exist (there are {len(rows)})")
    idx, cells = rows[n - 1]
    sep, header = ctx["board"].section_table("Intake")
    keys = [norm(h) for h in header]
    intake = dict(zip(keys, cells))
    check_intake_undischarged(intake, str(n))
    outcome = args.outcome or "dropped"
    if outcome not in ("dropped", "deferred"):
        raise Refused("--outcome is `dropped` or `deferred`; routing uses `route`")
    text = f"{outcome} {date.today():%Y-%m-%d} — {args.reason}"
    if not args.dry_run:
        ctx["board"].lines[idx] = render_row(
            [intake.get(k, "") if k != "outcome" else text for k in keys])
    jline = f"- [intake] {intake.get('request', '')[:48]} → {text}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"),
             "event": "resolve-intake", "id": "",
             "title": intake.get("request", ""),
             "arrived": intake.get("arrived", ""), "actor": args.actor,
             "from": "intake", "to": outcome, "reason": args.reason}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"outcome": outcome, **plan}


def cmd_intake(args, ctx) -> dict:
    """Record an unrouted external request, creating `## Intake` if absent."""
    if not args.title:
        raise Refused("--title is the request text")
    arrived = args.arrived or f"{date.today():%Y-%m-%d}"
    # Same as `add`: the real path runs either way; only `commit()` is skipped.
    ctx["board"].ensure_section("Intake", ["Arrived", "Request", "Outcome"])
    line = ctx["board"].append_section_row(
        "Intake", {"arrived": arrived, "request": args.title, "outcome": "—"})
    jline = f"- [intake] arrived {arrived} · {args.title}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "intake",
             "id": "", "title": args.title, "arrived": arrived,
             "actor": args.actor, "from": None, "to": "intake"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"arrived": arrived, "row": line, **plan}


USER_ID_RE = re.compile(r"\bUSER-(\d+)\b")


def mint_user_id(board: Board, events: list[dict], state_root: Path) -> str:
    """Next `USER-NNN` from max(board ∪ journal ∪ events), like `mint_id`."""
    seen = {int(m) for m in USER_ID_RE.findall(board.text())}
    seen |= {int(m) for e in events for m in USER_ID_RE.findall(e.get("id", ""))}
    for p in sorted((state_root / "journal").rglob("*.md")):
        try:
            seen |= {int(m) for m in USER_ID_RE.findall(p.read_text(errors="replace"))}
        except OSError:
            continue
    return f"USER-{max(seen, default=0) + 1:03d}"


def cmd_ask(args, ctx) -> dict:
    """Put a question to the user and start its clock.

    `## User Input Queue` had no writer, and the cost was measurable rather
    than theoretical: **both rows on Perry's own board carried `Idle: —`** —
    the one field the queue exists for, unfilled, because a human had to type
    a number that is wrong the next morning.

    So the tool stamps `Asked`, a date, and the age is computed at read time.
    `Idle` stays readable on boards that have it and is no longer required by
    the schema: a stored age is stale the moment it is written, and a real
    project had already dropped the column for exactly that reason.
    """
    if not args.needed:
        raise Refused(
            "--needed is required: it is the question, and a queue row that "
            "does not say what is being asked cannot be answered by anyone")
    sr = ctx["state_root"]
    uid = mint_user_id(ctx["board"], ctx["events"], sr)
    asked = args.arrived or f"{date.today():%Y-%m-%d}"

    ctx["board"].ensure_section(
        "User Input Queue", ["USER-id", "Needed from user", "Blocks", "Asked", "Status"],
        before_p0=False)
    ctx["board"].ensure_section_columns("User Input Queue", ["Asked"])
    line = ctx["board"].append_section_row("User Input Queue", {
        "user-id": uid, "needed from user": args.needed,
        "blocks": args.blocks or "—", "asked": asked, "status": "pending"})
    jline = f"- [{uid}] — → pending · {args.needed}" + (
        f" · blocks: {args.blocks}" if args.blocks else "")
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "ask",
             "id": uid, "title": args.needed, "asked": asked,
             "blocks": args.blocks or "", "actor": args.actor,
             "from": None, "to": "pending"}
    plan = commit(ctx["project_root"], sr, ctx["board"], jline, event, args.dry_run)
    return {"id": uid, "asked": asked, "row": line, **plan}


def cmd_answer(args, ctx) -> dict:
    """Record the user's answer, with the date they gave it."""
    if not args.answer:
        raise Refused(
            "--answer is required. Flipping the status without recording what "
            "was decided leaves the row closed and the decision nowhere")
    idx, header, cells = ctx["board"].find_section_row("User Input Queue", args.id)
    keys = [norm(h) for h in header]
    values = dict(zip(keys, cells))
    today = f"{date.today():%Y-%m-%d}"
    prev = values.get("status", "")
    if prev.strip().lower().startswith("answered"):
        raise Refused(f"{args.id} is already answered: {prev.strip()[:60]}")
    values["status"] = f"answered {today}: {args.answer}"
    ctx["board"].lines[idx] = render_row([values.get(k, "") for k in keys])
    jline = f"- [{args.id}] pending → answered · {args.answer}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "answer",
             "id": args.id, "title": values.get("needed from user", ""),
             "answer": args.answer, "actor": args.actor,
             "from": "pending", "to": "answered"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": args.id, "answered": today, **plan}


CAD_ID_RE = re.compile(r"\bCAD(?:ENCE)?-(\d+)\b")

# The section's own columns. `Last run` is new and optional: it is the INPUT
# `Next due` is computed from, and without it the due date is an assertion with
# nothing on the board to check it against. `Last evidence` moved the other way
# — from required to optional — because a real register does not have it and
# was carrying a `table-columns` lint error for being right, exactly as `Idle`
# was before TASK-039.
CADENCE_COLUMNS = ["ID", "Recurring task", "Owner", "Frequency",
                   "Last run", "Next due", "Last evidence"]

FREQ_HELP = ("a period — `daily`, `weekly`, `biweekly`, `monthly`, `quarterly`, "
             "`yearly`, or `Nd`/`Nw`/`Nm` (`14d`, `every 3 weeks`) — or one of "
             "the aperiodic words a real register already uses "
             "(`continuous`, `hourly`, `ad hoc`, `on demand`), which record a "
             "recurrence with no computable due date")


def mint_cadence_id(board: Board, events: list[dict], state_root: Path) -> str:
    """Next `CAD-NNN` from max(board ∪ journal ∪ events), like `mint_id`.

    It counts `CADENCE-NNN` as well as `CAD-NNN`. That is not hypothetical
    tidiness: a live register numbers its rows `CADENCE-000`, `CADENCE-002`,
    `CADENCE-003`, and a minter blind to that prefix would hand out `CAD-001`
    beside `CADENCE-002` and then `CAD-004` later — two numbering schemes in
    one five-row table, with `CAD-002` and `CADENCE-002` both live and neither
    obviously the other's neighbour. Reading both and minting one keeps the
    sequence continuous on a board that already has a history.

    Rows whose id carries no number at all (`CADENCE-NIGHTLY-RESEARCH`, also
    live) are simply not part of the sequence — they cannot collide with a
    number, so nothing needs to be done about them.
    """
    seen = {int(m) for m in CAD_ID_RE.findall(board.text())}
    seen |= {int(m) for e in events for m in CAD_ID_RE.findall(e.get("id", ""))}
    for p in sorted((state_root / "journal").rglob("*.md")):
        try:
            seen |= {int(m) for m in CAD_ID_RE.findall(p.read_text(errors="replace"))}
        except OSError:
            continue
    return f"CAD-{max(seen, default=0) + 1:03d}"


def check_frequency(freq: str, hint: str = "") -> tuple[str, int, str]:
    parsed = P.parse_frequency(freq)
    if parsed is None:
        raise Refused(
            f"frequency {freq!r} cannot be scheduled from. Give {FREQ_HELP}. "
            f"A frequency this tool cannot read would produce a `Next due` that "
            f"is confidently wrong, which is worse than refusing to stamp one"
            + (f". {hint}" if hint else ""))
    return parsed


def parse_on(value: str | None, label: str) -> date | None:
    if not value:
        return None
    try:
        return datetime.strptime(value.strip(), "%Y-%m-%d").date()
    except ValueError:
        raise Refused(f"--on must be YYYY-MM-DD ({label}); got {value!r}")


def stamp_due(run: date | None, freq: str) -> str:
    """The `Next due` cell for a ritual with this frequency.

    `n/a` for an aperiodic one, matching what a live register already writes in
    that cell rather than introducing a second spelling for the same idea.
    """
    due = P.next_due_after(run or date.today(), freq)
    return f"{due:%Y-%m-%d}" if due else "n/a"


def cmd_cadence_add(args, ctx) -> dict:
    """Register a recurring ritual, and stamp the first `Next due`.

    `BOARD.md § Cadence` is the register `modes/queue.md` builds its highest-
    value triage question on ("what recurs?"), `work/reference/subcommands.md`
    tells triage to surface rows past their `Next due`, and
    `perry-state --json` reported a count of them. Three readers, no writer:
    every row, every id and every due date was typed by hand.

    `Next due` is the cell that made that expensive. It is COMPUTED — frequency
    plus the last run — so a human had to redo the arithmetic after every
    single occurrence, and a register nobody re-dates is a register that reports
    everything as either permanently overdue or permanently fine. Both of those
    were live: one project's rows read `2026-W32` and `**2026-08-31**` with a
    parenthetical explaining which occurrences had been skipped, which is what
    a human keeping a computed cell by hand actually produces.

    So the tool owns the id, the frequency, the dates and the arithmetic. The
    prose — what the ritual is — stays the agent's, exactly as `ask` splits it.
    """
    if not args.title:
        raise Refused("--title is required: it is what recurs")
    if not args.frequency:
        raise Refused(f"--frequency is required. Give {FREQ_HELP}")
    kind, _, _ = check_frequency(args.frequency)
    sr = ctx["state_root"]
    # A registration is not a run. `--on` is for a ritual that already has a
    # history — "it last ran on this date" — and when it is absent `Last run`
    # stays empty rather than being stamped with today, because stamping it
    # would assert an occurrence that did not happen and make the very first
    # `Next due` unverifiable in the same stroke.
    ran = parse_on(args.on, "the date the ritual last ran")
    cid = mint_cadence_id(ctx["board"], ctx["events"], sr)
    due = stamp_due(ran, args.frequency)

    ctx["board"].ensure_section("Cadence", CADENCE_COLUMNS, before_p0=False)
    ctx["board"].ensure_section_columns(
        "Cadence", ["Frequency", "Next due", "Last run"])
    line = ctx["board"].append_section_row("Cadence", {
        "id": cid, "recurring task": args.title, "title": args.title,
        "owner": args.owner or "Coding Agent",
        "frequency": args.frequency,
        "last run": f"{ran:%Y-%m-%d}" if ran else "—",
        "next due": due,
        "last evidence": "—", "evidence": "—"})
    jline = (f"- [{cid}] — → registered · {args.title} · "
             f"frequency: {args.frequency} · next due {due}")
    event = {"ts": datetime.now().isoformat(timespec="seconds"),
             "event": "cadence-add", "id": cid, "title": args.title,
             "frequency": args.frequency, "kind": kind,
             "last_run": f"{ran:%Y-%m-%d}" if ran else "",
             "next_due": due, "actor": args.actor,
             "from": None, "to": "registered"}
    plan = commit(ctx["project_root"], sr, ctx["board"], jline, event, args.dry_run)
    return {"id": cid, "next_due": due, "row": line, **plan}


def cmd_cadence_done(args, ctx) -> dict:
    """Record one occurrence, and RECOMPUTE `Next due` in the same write.

    This is the half that makes the register self-maintaining. `done` on a task
    removes a row; a ritual has no such end — the only thing that changes is
    that its clock restarts. So the run is stamped into `Last run`, the
    evidence into `Last evidence`, and `Next due` is derived from the row's own
    `Frequency` rather than from anything the caller asserts.

    `--evidence` is required for the same reason `done` requires it: a claim
    that the month-end close ran, citing nothing, is a claim about confidence.
    """
    cid = args.id
    if not cid:
        raise Refused("cadence-done takes the row's id: perry-task cadence-done "
                      "CAD-001 --evidence <path>")
    if not args.evidence:
        raise Refused(
            f"{cid}: --evidence is required. A recurring task that reports "
            f"itself run, citing nothing, is exactly the ritual nobody notices "
            f"has stopped happening")
    idx, header, cells = ctx["board"].find_section_row("Cadence", cid)
    keys = [norm(h) for h in header]
    values = dict(zip(keys, cells))
    # By NAME. The register has at least two live column counts and a third
    # appears the moment `Last run` is added, so the frequency is not at a
    # fixed offset on any board this will ever run against.
    freq = (args.frequency or values.get("frequency", "")).strip()
    if not freq:
        raise Refused(
            f"{cid} has no readable `Frequency` cell, so `Next due` cannot be "
            f"recomputed. Pass --frequency to set it in this same write")
    # A row whose `Frequency` is prose the tool cannot read blocks the run from
    # being recorded, which is why the refusal names the way through: the same
    # write can set the frequency. Refusing without that would trade one lost
    # record for another.
    check_frequency(freq, f"Pass --frequency to correct {cid}'s cell in this "
                          f"same write")
    ran = parse_on(args.on, "the date the run happened") or date.today()
    due = stamp_due(ran, freq)

    ctx["board"].ensure_section_columns("Cadence", ["Last run", "Next due"])
    _, header = ctx["board"].section_table("Cadence")
    keys = [norm(h) for h in header]
    prev_due = values.get("next due", "")
    values["frequency"] = freq
    values["last run"] = f"{ran:%Y-%m-%d}"
    values["next due"] = due
    # `Last evidence` is optional in the schema because a live register does
    # not have it. So the column is resolved, then created if the board has
    # neither spelling — never dropped. A path silently discarded here is the
    # `--commitment` defect again, and what it would lose is the only artifact
    # proving the run happened.
    ev_key = next((k for k in ("last evidence", "evidence") if k in keys), None)
    if ev_key is None:
        header = ctx["board"].ensure_section_columns("Cadence", ["Last evidence"])
        keys = [norm(h) for h in header]
        ev_key = "last evidence"
    values[ev_key] = args.evidence
    ctx["board"].lines[idx] = render_row([values.get(k, "") for k in keys])

    jline = (f"- [{cid}] ran {ran:%Y-%m-%d} · {values.get('recurring task', '')} · "
             f"evidence: `{args.evidence}` · next due {due}")
    event = {"ts": datetime.now().isoformat(timespec="seconds"),
             "event": "cadence-done", "id": cid,
             "title": values.get("recurring task", ""), "frequency": freq,
             "last_run": f"{ran:%Y-%m-%d}", "next_due": due,
             "previous_due": prev_due, "evidence": args.evidence,
             "actor": args.actor, "from": "due", "to": "ran"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": cid, "last_run": f"{ran:%Y-%m-%d}", "next_due": due, **plan}
RISK_ID_RE = re.compile(r"\bRX-(\d+)\b")

# The tool owns the row and every computed cell; the agent owns the prose cell.
# `ID` and `Opened` are stamped, `Status` is a state machine with two moves, and
# `Risk` is the human's sentence and is never parsed, never enum-checked and
# never rewritten.
RISK_COLUMNS = ["ID", "Risk", "Opened", "Status"]

# A bullet that is a placeholder rather than a risk. `BOARD_TEMPLATE.md` ships
# `- (no active risks)` and several fixtures carry `- none`; migrating those
# would mint an id for a risk named "none".
_RISK_PLACEHOLDER = re.compile(
    r"^\(?\s*(?:no active risks?|none|n/a|na|tbd|—|-|–|无|暂无)\s*\)?[.。]?$", re.I)

_RISK_BULLET = re.compile(r"^(?:-|\d+\.)\s+(.*)$")

_TABLE_SEP = re.compile(r"^\|\s*:?-{2,}")


def risk_section_tables(board: Board) -> list[list[str]]:
    """Every table header under `## Top risks`, in document order.

    Deliberately NOT `Board.section_table`, which answers "the first table in
    this section" and cannot see a second one. This is the same scan
    `viewer/parsers.py:_has_risk_header` runs, asking the same question of the
    same section — and the writer has to ask it the same way, because the two
    answering it differently is what B-1 was.
    """
    start, end = board.named_section("Top risks")
    out = []
    for i in range(start + 1, end):
        if not _TABLE_SEP.match(board.lines[i].strip()):
            continue
        prev = board.lines[i - 1].strip()
        if prev.startswith("|"):
            out.append(split_row(board.lines[i - 1]))
    return out


def is_risk_header(header: list[str]) -> bool:
    """Whether a header declares the risk-statement column, resolved by name.

    `Risk` is the column that identifies the migrated shape — the reader says
    so at `viewer/parsers.py:_parse_risk_table`, and it is the cell that holds
    the sentence, so a table without it is not a risk table no matter what
    else it has.
    """
    return any(norm(h) == norm("Risk") for h in header)


def risk_section_shape(board: Board) -> tuple[str, list[list[str]]]:
    """How `## Top risks` is currently written: `table` | `bullets` | `foreign`.

    `foreign` covers both shapes this writer must not touch: a table under the
    heading that has no `Risk` column (a legend, a severity key), and a section
    holding two tables. Neither is malformed — the reader handles both — but
    `Board.section_table` and `Board.section_rows` address the FIRST table in a
    section and read straight through a blank line into the next one, so a
    write into either shape lands in the wrong table. Refusing is the only
    answer available that does not invent one.
    """
    tables = risk_section_tables(board)
    if len(tables) == 1 and is_risk_header(tables[0]):
        return "table", tables
    if tables:
        return "foreign", tables
    return "bullets", tables


def refuse_foreign_risk_table(tables: list[list[str]]) -> None:
    if len(tables) > 1:
        raise Refused(
            "`## Top risks` holds more than one table, and this tool writes "
            "into a section's first one — so a row would land in the wrong "
            "table. Nothing was written. Move the other table under its own "
            "heading, then run this again")
    raise Refused(
        f"`## Top risks` holds a table with no `Risk` column ({tables[0]}), so "
        f"it is not a risk register — a legend or a severity key reads exactly "
        f"like this. Nothing was written, and no column was added to it: "
        f"bolting the risk columns onto it would make the reader treat it as "
        f"the register and stop seeing every bullet below it. Give that table "
        f"its own `###` heading, or add a `Risk` column to it if it really is "
        f"the register")


def mint_risk_id(board: Board, events: list[dict], state_root: Path) -> str:
    """Next `RX-NNN` from max(board ∪ journal ∪ events), like `mint_id`.

    Same three sources for the same reason: a cleared risk still owns its
    number. `## Top risks` holds cleared rows rather than deleting them, so the
    board alone would nearly always be enough — but "nearly always" is how an id
    gets reissued the first time somebody prunes the section, and every journal
    line naming the old risk would then silently re-point.
    """
    seen = {int(m) for m in RISK_ID_RE.findall(board.text())}
    seen |= {int(m) for e in events for m in RISK_ID_RE.findall(e.get("id", ""))}
    for p in sorted((state_root / "journal").rglob("*.md")):
        try:
            seen |= {int(m) for m in RISK_ID_RE.findall(p.read_text(errors="replace"))}
        except OSError:
            continue
    return f"RX-{max(seen, default=0) + 1:03d}"


def risk_bullets(board: Board) -> list[tuple[int, str]]:
    """(line index, bullet text) for every risk bullet, placeholders excluded."""
    start, end = board.named_section("Top risks")
    out = []
    for i in range(start + 1, end):
        m = _RISK_BULLET.match(board.lines[i].strip())
        if not m:
            continue
        text = m.group(1).strip()
        if not text or _RISK_PLACEHOLDER.match(text):
            continue
        out.append((i, text))
    return out


def ensure_risk_table(board: Board, events: list[dict],
                      state_root: Path) -> list[dict]:
    """Put `## Top risks` into its table form, carrying any bullets across.

    Four states, four answers:

    - **no section** — create it, with the table. Same as `ensure_section`
      does for `## Intake`.
    - **a risk table already** — add any column it lacks, and touch nothing
      else. "A risk table" means a table with a `Risk` column, which is the
      reader's test (`is_risk_header`) and not "any table": deciding this with
      `section_table()` alone bolted the four risk columns onto a legend and
      left the live bullets below it invisible, because the legend then had a
      `Risk` header and the reader prefers the table.
    - **a table that is not a risk table** — refuse. See
      `refuse_foreign_risk_table`.
    - **a bullet list** — convert it.

    The conversion is what `risk-migrate` exists to ask for. It does not happen
    on the way to some other write: *appending a table above the bullets* would
    leave the board holding both, and since the reader prefers the table, every
    existing risk would vanish from every count while still sitting in the
    file — but rewriting a project's section as a side effect of `risk-add` is
    the Anti-Goal at `perry/OKR.md:37` ("no automatic rewrite of a project's
    existing structure. Adoption proposes; the user declares"), which
    `Board.append_row` cites 1,300 lines above to refuse a *smaller* rewrite.
    So the caller asks first, and this function does exactly what it is told.

    **What the conversion may and may not invent.** The bullet's text is copied
    into `Risk` byte-for-byte — it is the human's sentence and this function has
    no opinion about it. `Opened` is left **EMPTY**, because the date a
    pre-existing risk was raised is genuinely not recorded anywhere and stamping
    today would assert that a nine-month-old risk is new. An empty `Opened`
    reads back as `age_days: null`, which is already the honest answer for a
    bullet and stays honest here.

    `Status` is the one derived cell, and it is derived from the reader's OWN
    two markers and nothing else: a bullet is migrated as `cleared` exactly when
    `~~strikethrough~~` or `**RESOLVED` made the old parser call it resolved.
    So the conversion is verdict-preserving — the set of (statement, resolved)
    pairs is identical either side of it — which is a property a test can check
    rather than a claim a reviewer has to believe. Any date the human wrote into
    a cleared bullet is carried onto the cell; when they wrote none, the cell
    says `cleared` with no date rather than today's, for the same reason
    `Opened` stays blank.
    """
    if not board.has_section("Top risks"):
        board.ensure_section("Top risks", RISK_COLUMNS, before_p0=False)
        return []
    shape, tables = risk_section_shape(board)
    if shape == "table":
        board.ensure_section_columns("Top risks", RISK_COLUMNS)
        return []
    if shape == "foreign":
        refuse_foreign_risk_table(tables)

    bullets = risk_bullets(board)
    start, end = board.named_section("Top risks")
    try:
        lang = header_language(board.table("P0")[2])
    except Refused:
        lang = "en"
    header = [display_name(c, lang) for c in RISK_COLUMNS]

    base = int(mint_risk_id(board, events, state_root).split("-")[1])
    migrated, rows = [], []
    for n, (_, text) in enumerate(bullets):
        rid = f"RX-{base + n:03d}"
        resolved = text.startswith("~~") or bool(re.search(r"\*\*RESOLVED", text))
        status = "open"
        if resolved:
            d = re.search(r"\d{4}-\d{2}-\d{2}", text)
            status = f"cleared {d.group(0)}" if d else "cleared"
        rows.append(render_row([rid, text, "", status]))
        migrated.append({"id": rid, "risk": text, "status": status})

    block = [render_row(header),
             "|" + "|".join(["---"] * len(header)) + "|"] + rows
    # Replace the whole body of the section, preserving the heading line and
    # any prose the project keeps under it. Only the bullet lines go.
    keep = [l for i, l in enumerate(board.lines[start + 1:end], start + 1)
            if not _RISK_BULLET.match(l.strip())]
    while keep and not keep[0].strip():
        keep.pop(0)
    while keep and not keep[-1].strip():
        keep.pop()
    body = ([""] + keep if keep else []) + [""] + block + [""]
    board.lines[start + 1:end] = body
    return migrated


def require_migrated(board: Board) -> None:
    """Refuse to write a risk row into a section that has not migrated.

    **Consent, not disclosure.** `risk-add` used to convert the whole section
    on the way past — 9 bullets rewritten as 9 rows on a copy of a real board,
    exit 0, and the human-readable line said only `wrote RX-010 (risk-add)`.
    The rubric names automatic conversion as a defect, and `perry/OKR.md:37`
    names it an Anti-Goal: *"No automatic rewrite of a project's existing
    structure. Adoption proposes; the user declares."*

    So the refusal carries the two things a user needs to declare: **how many
    of their lines it would rewrite**, and **the command that does it**. A
    warning after the fact would be disclosure; this is the ask.

    A section with nothing in it to convert is not asked about — there is no
    consent to collect for creating a table out of an empty section or out of
    the `- (no active risks)` placeholder that `BOARD_TEMPLATE.md` ships. The
    thing being protected is the user's own writing, and there is none.
    """
    if not board.has_section("Top risks"):
        return
    shape, tables = risk_section_shape(board)
    if shape == "table":
        return
    if shape == "foreign":
        refuse_foreign_risk_table(tables)
    bullets = risk_bullets(board)
    if not bullets:
        return
    raise Refused(
        f"`## Top risks` is still a bullet list: {len(bullets)} risk(s) would "
        f"have to be rewritten as table rows before a row can be added, and "
        f"this tool does not rewrite a section you wrote without being asked. "
        f"Nothing was written. Run `perry-task risk-migrate` to convert them "
        f"(every bullet crosses verbatim; `risk-migrate --dry-run --json` "
        f"shows exactly what it would write), then run this again")


def cmd_risk_migrate(args, ctx) -> dict:
    """Convert `## Top risks` from bullets to the table, and nothing else.

    **Why a subcommand and not a `risk-add --migrate` flag.** Three reasons,
    in the order they decided it:

    - A flag makes you invent a risk in order to convert a section. On the
      real board this was measured against — 9 bullets, nothing new to
      say — `risk-add --migrate --title …` demands a tenth risk as the price
      of migrating the other nine.
    - The conversion is a fact about the project, and the event log is where
      facts about the project go. As a flag it was a `migrated: [...]` field
      hanging off a `risk-add` event, so the record that a project converted
      its risk register was attached to an unrelated new risk, and the journal
      line for the conversion was that risk's line.
    - It is reversible-by-inspection before it runs: `--dry-run --json`
      returns every row it would write, which is a preview a flag on another
      command cannot offer without also previewing that command's write.

    It joins `SECTION_EVENTS`, with `intake-sweep` — the other subcommand that
    acts on a section rather than on a row.
    """
    board = ctx["board"]
    if not board.has_section("Top risks"):
        raise Refused(
            "BOARD.md has no `## Top risks` section, so there is nothing to "
            "migrate. `perry-task risk-add` creates the section and its table")
    shape, tables = risk_section_shape(board)
    if shape == "foreign":
        refuse_foreign_risk_table(tables)
    if shape == "table":
        rows = len(board.section_rows("Top risks"))
        raise Refused(
            f"`## Top risks` is already a table ({rows} row(s)) — nothing to "
            f"migrate, and this command will not touch a row that has an id. "
            f"`perry-task risk-add` adds one; `risk-clear` retires one")
    if not risk_bullets(board):
        raise Refused(
            "`## Top risks` holds no risk bullets to migrate — only prose, or "
            "the `(no active risks)` placeholder. `perry-task risk-add` writes "
            "the table on its own when there is nothing of yours to convert")

    migrated = ensure_risk_table(board, ctx["events"], ctx["state_root"])
    ids = [m["id"] for m in migrated]
    jline = (f"- [risks] {len(migrated)} bullet(s) → table rows "
             f"({ids[0]}–{ids[-1]}) · `## Top risks` migrated")
    event = {"ts": datetime.now().isoformat(timespec="seconds"),
             "event": "risk-migrate", "id": "", "title": "",
             "count": len(migrated), "migrated": ids, "actor": args.actor,
             "from": "bullets", "to": "table"}
    plan = commit(ctx["project_root"], ctx["state_root"], board,
                  jline, event, args.dry_run)
    return {"migrated": migrated, "count": len(migrated), **plan}


def cmd_risk_add(args, ctx) -> dict:
    """Raise a risk: the tool mints the id and stamps the date.

    `## Top risks` was a bullet list with no writer, and it carried the two
    defects that shape always carries. **A cleared risk stayed live forever**:
    the only way to retire one was `~~strikethrough~~`, which is decoration, so
    a risk cleared on Perry's own board the day before was still one of the four
    that `perry-state` reported. And **the reader invented ids out of prose** —
    with no id column it split the first sentence on whitespace and published
    `id: "Perry"`, `title: "is half-adopted: …"`, a handle that names nothing
    and cannot be passed back to anything.

    Neither is fixable by writing the bullets more carefully. An id has to be
    minted against the ones already issued, and a status has to be a cell
    something can read — both are properties of a writer, not of a convention.
    """
    if not args.title:
        raise Refused(
            "--title is required: it is the risk statement, in your words. A "
            "risk row with no sentence in it is an id and a date")
    sr = ctx["state_root"]
    # The gate, before anything is minted: on a section this tool did not
    # write, `risk-add` asks rather than converts. `migrated` is therefore
    # always empty here and is no longer a field of this command's payload or
    # of its event — the conversion has its own subcommand, its own journal
    # line and its own event, and a `migrated: []` on every risk-add was a
    # field that only ever described something another command does.
    require_migrated(ctx["board"])
    ensure_risk_table(ctx["board"], ctx["events"], sr)
    rid = mint_risk_id(ctx["board"], ctx["events"], sr)
    opened = args.opened or f"{date.today():%Y-%m-%d}"
    line = ctx["board"].append_section_row("Top risks", {
        "id": rid, "risk": args.title, "opened": opened, "status": "open"})
    jline = f"- [{rid}] — → open · {args.title}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"),
             "event": "risk-add", "id": rid, "title": args.title,
             "opened": opened, "actor": args.actor,
             "from": None, "to": "open"}
    plan = commit(ctx["project_root"], sr, ctx["board"], jline, event, args.dry_run)
    return {"id": rid, "opened": opened, "row": line, **plan}


def cmd_risk_clear(args, ctx) -> dict:
    """Retire a risk, with the reason and the date it stopped being one.

    The cleared row STAYS on the board. A risk that was real and is now over is
    the most useful thing in this section — it is the record that the mitigation
    worked — and deleting it would leave the same hole the strikethrough was
    trying to fill. It simply stops counting.
    """
    if not args.reason:
        raise Refused(
            f"{args.id}: --reason is required. A risk that leaves the live set "
            f"without one is indistinguishable from a risk everyone got tired of")
    try:
        idx, header, cells = ctx["board"].find_section_row("Top risks", args.id)
    except Refused as exc:
        if "has no table" in str(exc):
            raise Refused(
                "`## Top risks` is still a bullet list, so nothing in it has an "
                "id to clear. `perry-task risk-migrate` converts the section "
                "(every bullet crosses verbatim), after which the rows have "
                "ids") from None
        raise
    keys = [norm(h) for h in header]
    values = dict(zip(keys, cells))
    prev = (values.get("status", "") or "").strip()
    if re.match(r"^(?:cleared|resolved|closed)\b", prev.strip("*~` "), re.I):
        raise Refused(f"{args.id} is already cleared: {prev[:60]}")
    today = f"{date.today():%Y-%m-%d}"
    values["status"] = f"cleared {today} — {args.reason}"
    ctx["board"].lines[idx] = render_row([values.get(k, "") for k in keys])
    jline = f"- [{args.id}] open → cleared · {args.reason}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"),
             "event": "risk-clear", "id": args.id,
             "title": values.get("risk", ""), "reason": args.reason,
             "actor": args.actor, "from": "open", "to": "cleared"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": args.id, "cleared": today, **plan}


INTAKE_UNSET = {"", "—", "-", "–", "n/a", "tbd", "pending", "none"}


def check_intake_undischarged(intake: dict, n: str) -> None:
    """An intake row takes exactly one outcome — the rule both `modes/queue.md`
    and `subcommands.md` state, and which nothing enforced.

    Re-routing a request minted a SECOND task for it and overwrote the cell, so
    the first task's provenance was destroyed and two live rows carried one
    title. Re-resolving flipped a recorded drop into a defer. Neither refused.

    It is not theoretical: discharged rows stay in intake until the review
    period closes, so the next drain walks them again.

    `answer`, `status`, `stage` and `risk-clear` all refuse a repeat
    transition. This was the fourth implementation of "already discharged" and
    the only one that did not.
    """
    outcome = (intake.get("outcome") or "").strip().strip("*` ").lower()
    if outcome and outcome not in INTAKE_UNSET:
        raise Refused(
            f"intake row {n} already has an outcome: "
            f"{intake.get('outcome', '').strip()[:60]!r}. A row takes exactly "
            f"one — re-routing would mint a second task for one request and "
            f"erase where the first went")


def cmd_intake_sweep(args, ctx) -> dict:
    """Move discharged intake rows off the board and into today's journal.

    `modes/queue.md` states the rule and explains why it matters — "without
    this rule intake only grows, and a board could overflow on a year of
    recorded drops, which would destroy the argument above: overflow is
    supposed to mean *taking on more than you discharge*, not *having
    discharged a lot*." A V4 review found the rule existed in that one file
    and **nowhere else**: no subcommand, no triage step. The one part of the
    intake lifecycle nothing implemented was the part the overflow argument
    rests on.

    Rows keep their `Outcome` verbatim in the journal, so the record of where
    a request went survives leaving the board — the same live/history split
    `BOARD.md` and `journal/` use everywhere else.
    """
    rows = ctx["board"].section_rows("Intake")
    _, header = ctx["board"].section_table("Intake")
    keys = [norm(h) for h in header]
    discharged = []
    for idx, cells in rows:
        row = dict(zip(keys, cells))
        outcome = (row.get("outcome") or "").strip()
        if outcome and outcome.strip("*` ").lower() not in INTAKE_UNSET:
            discharged.append((idx, row))
    if not discharged:
        raise Refused(
            "no discharged intake rows to sweep — every row is still waiting "
            "for an outcome, which is what triage step 0 is for")

    for idx, _ in sorted(discharged, key=lambda x: -x[0]):
        ctx["board"].lines.pop(idx)

    block = "\n".join(
        [f"### Intake swept {date.today():%Y-%m-%d}", ""] +
        [f"- **{r.get('arrived', '—')}** · {r.get('request', '')} → "
         f"{r.get('outcome', '')}" for _, r in discharged])
    jline = f"- [intake] {len(discharged)} discharged row(s) left the board"
    event = {"ts": datetime.now().isoformat(timespec="seconds"),
             "event": "intake-sweep", "id": "", "title": "",
             "count": len(discharged), "actor": args.actor,
             "from": "intake", "to": "journal"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run, definition=block)
    return {"swept": len(discharged),
            "rows": [r.get("request", "") for _, r in discharged], **plan}


def cmd_route(args, ctx) -> dict:
    """Move an intake row onto the board, carrying `Arrived` with it.

    Not bookkeeping: `today − Arrived` is the number every SLA check measures,
    so a routing that drops it makes queue mode's own breach check uncomputable
    and silently exempts the row from the only clock governing it.
    """
    rows = ctx["board"].section_rows("Intake")
    if not rows:
        raise Refused("`## Intake` has no rows to route")
    try:
        n = int(args.id or "0")
    except ValueError:
        raise Refused("route takes the intake row number: perry-task route 1 --track ops")
    if not 1 <= n <= len(rows):
        raise Refused(f"intake row {n} does not exist (there are {len(rows)})")
    idx, cells = rows[n - 1]
    sep, header = ctx["board"].section_table("Intake")
    keys = [norm(h) for h in header]
    intake = dict(zip(keys, cells))

    check_intake_undischarged(intake, args.id)
    track = track_of(ctx["config"], args.track or "main")
    if track["mode"] == "project":
        raise Refused(f"track {track['track']!r} is mode `project`; routing is a "
                      f"queue-mode operation (`modes/queue.md`)")
    prefix = resolve_prefix(ctx["board"], args.prefix)
    tid = mint_id(ctx["board"], ctx["events"], ctx["state_root"], prefix)
    # Same function `cmd_add` calls, so `--group` cannot be a flag one of them
    # reads and the other throws away. It was: the drain could not run at all
    # on a board with no `## P0`/`## P1`/`## P2`, and `check_priority`'s
    # refusal sent the user to this exact flag to fix it.
    priority, group = target_section(ctx["board"], args)
    stages = stages_of(ctx["schema"], track)
    check_stage(track, stages, args.stage)
    # Same function `cmd_add` calls, so the two cannot disagree about where a
    # row is born.
    stage = args.stage or entry_stage(track["mode"], stages)

    values = {"id": tid, "title": intake.get("request", ""),
              "owner": args.owner or "Coding Agent", "status": "not_started",
              "next action": "—", "evidence": "—",
              "track": track["track"], "stage": stage}
    # The clock each mode actually reads. A queue row is measured from
    # `Arrived`; a pipeline or inquiry row from `Stage since`. Routing gave
    # every row `Arrived` regardless, so a pipeline row arrived with no dwell
    # clock at all — and `rows_with_no_computable_age` could not report it,
    # because `arrived` was non-empty.
    #
    # `--arrived` overrides, because an intake row a human typed straight into
    # the board has no `Arrived` cell to carry. Reading it out of the row and
    # then using it unconditionally three lines later raised `KeyError:
    # 'arrived'` — a traceback rather than a refusal, on the one board shape
    # every adopting project already has.
    arrived = args.arrived or intake.get("arrived", "")
    if track["mode"] == "queue":
        if not arrived:
            raise Refused(
                f"intake row {args.id} has no arrival date, and `{track['track']}` "
                f"is a queue track whose only clock is `Arrived`. Routing it "
                f"would file a request that can never breach an SLA.\n"
                f"Supply one: --arrived YYYY-MM-DD")
        values["arrived"] = arrived
    else:
        values["stage since"] = f"{date.today():%Y-%m-%d}"
        if arrived:
            values["arrived"] = arrived
    if args.commitment:
        values["commitment"] = args.commitment
    # Widened by the same function `cmd_add` calls. This is where it mattered
    # most: `## Intake` is created by the tool and fills on a board whose own
    # `## P2` predates Perry, so the drain refused on the one project that had
    # an intake to drain. The section filled and could never be emptied, which
    # turns `triage` step 1 into a step that cannot run.
    # **The intake row is written back BEFORE the new row is appended.**
    # `idx` came from `section_rows("Intake")` and `append_row` INSERTS a line;
    # if the landing site sits above `## Intake`, every line below it shifts by
    # one and `idx` addresses its neighbour. On a board with no `## P0`/`## P1`
    # — `~/proj/gimegime-pmo`'s actual shape, and the whole reason `--group`
    # exists — `ensure_section` anchors `## Intake` at the END of the file, so
    # the landing site is ALWAYS above it and this ALWAYS fires. Measured: the
    # intake table's separator row was overwritten, the request stayed
    # undischarged, and the next `route` refused "`## Intake` has no table".
    # One drain bricked the queue, at exit 0 with no warning.
    #
    # Writing first removes the hazard rather than compensating for it: no
    # index is held across a mutation at all.
    if split_row(ctx["board"].lines[idx])[:1] != cells[:1]:
        raise Refused(
            f"intake row {n} is no longer at line {idx} — nothing was written. "
            f"`route` must write the intake row back before it appends the new "
            f"one; an index taken from `section_rows` does not survive an insert")
    ctx["board"].lines[idx] = render_row(
        [intake.get(k, "") if k != "outcome" else f"routed → {tid}" for k in keys])
    widen_target_section(ctx["board"], priority, group, values)
    line = ctx["board"].append_row(priority, values, group=group)
    jline = (f"- [{tid}] — → not_started · routed from intake "
             f"(arrived {arrived or '—'}) · track: {track['track']}")
    event = {"ts": datetime.now().isoformat(timespec="seconds"), "event": "route",
             "id": tid, "title": values["title"], "track": track["track"],
             "arrived": arrived, "actor": args.actor,
             "from": "intake", "to": "not_started"}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    # `priority` and `group` say where the row landed. A caller that passed
    # `--group` has to be able to read back the section it named, and one that
    # passed neither has to see the default it got.
    return {"id": tid, "arrived": arrived, "row": line,
            "priority": priority, "group": group, "prefix": prefix, **plan}


def cmd_prioritize(args, ctx) -> dict:
    """Move an existing row to another priority section, or to a named group.

    **Triage's central act had no writer.** `perry-task` shipped 22
    subcommands and not one of them could change a row's priority: `add` sets
    it once at creation, and `route` — the only other thing that writes a
    priority cell — takes an *intake row number*, mints a *new* id, and refuses
    on any track in `project` mode. So the operation `triage`, `monday-plan`,
    `friday-review` and `mid-phase-review` all end in could only be performed
    by hand-editing `BOARD.md`.

    That is not a cosmetic gap. A hand edit lands with **no event**, so
    `perry-state § reconcile_drift` reports it as unrecorded drift — the exact
    failure `DESIGN-004` was written against — and `priority` is a published
    field of `perry-task/list`, which aiMark's Projects view sorts on. A
    front-end could therefore display a priority no caller could change.

    Found by trying to execute a triage verdict, not by reading the code:
    TASK-038 was judged P1 and stayed P2 because the tool could not say so.

    **The row keeps its id and every cell.** This is a move, not a re-file:
    re-adding under a new priority would mint a second id, and an id is
    permanent and never reissued. The destination is resolved by the same
    `target_section` / `widen_target_section` pair `add` and `route` use, so a
    board that files work under its own headings (`## Open — 工程线`) is
    reachable with `--group` here exactly as it is there — the alternative
    being a subcommand that works only on boards shaped like Perry's own.
    """
    tid = args.id
    if not tid:
        raise Refused("prioritize takes a task id: "
                      "perry-task prioritize TASK-001 --priority P1")
    if not (args.priority or args.group):
        raise Refused(
            f"{tid}: name where it goes — --priority P0|P1|P2, or --group "
            f"'<heading>' on a board that files work under its own headings")

    was, idx, header, cells = ctx["board"].find(tid)
    values = dict(zip([norm(h) for h in header], cells))
    priority, group = target_section(ctx["board"], args)
    now = group or priority

    # A no-op that still emitted an event would put a move in the timeline that
    # did not happen, and the timeline is what `list` reports as history.
    if now == was:
        raise Refused(f"{tid} is already under `{was}` — nothing to move")

    # `idx` was computed before the widening, and `remove_row` pops by index
    # without looking at what it pops. Today that is safe because both widening
    # paths — `ensure_columns` and `ensure_section_columns` — rewrite lines in
    # place and never insert, so no index moves. That is an assumption about
    # two other functions, held across a call, protecting the one operation on
    # this board that deletes a line. It is checked rather than trusted:
    # a widener that ever grows to insert a row would otherwise silently delete
    # somebody else's task and append this one, and both boards would still
    # parse.
    #
    # (An earlier version of this comment claimed the opposite — that widening
    # after the removal would drop cells. It would not; `values` is already
    # extracted. The mutation that was supposed to prove the ordering came back
    # green, which is how the real invariant was found.)
    widen_target_section(ctx["board"], priority, group, values)
    if split_row(ctx["board"].lines[idx])[0].replace("*", "").replace(
            "~", "").strip() != tid:
        raise Refused(
            f"{tid}: the board shifted under the write — line {idx} no longer "
            f"holds this row. Nothing was written. This means a widening "
            f"function started inserting lines; `cmd_prioritize` locates the "
            f"row before widening and removes it after")
    ctx["board"].remove_row(idx)
    line = ctx["board"].append_row(priority, values, group=group)

    jline = f"- [{tid}] {was} → {now} · reprioritized"
    if args.reason:
        jline += f" · reason: {args.reason}"
    event = {"ts": datetime.now().isoformat(timespec="seconds"),
             "event": "prioritize", "id": tid,
             "title": values.get("title", ""),
             "track": values.get("track", "main"),
             "actor": args.actor,
             # `priority` and `group` mirror what `add` and `route` put on their
             # own events, because `cmd_list` folds a CLOSED row back together
             # from the event stream with `t["priority"] = e.get("priority") or
             # t["priority"]` — a row that left the board has no cells left to
             # read. Without these two keys the fold silently kept the `add`
             # event's value, so a closed row reported a priority its own
             # timeline said it had moved away from. Found by running the
             # lifecycle, not by reading the code: the payload said `P1` with
             # `prioritize P1 → P0` sitting in its timeline directly above.
             "priority": priority, "group": group,
             # `from`/`to` are the SECTION here, where every other event uses
             # them for the status. Nothing extra is needed to disambiguate —
             # `event: "prioritize"` already does, and the timeline carries the
             # event name. (An earlier version added a `field` key claiming to
             # be what disambiguates; it never reached the payload at all,
             # because a timeline entry keeps only ts/event/from/to/actor.)
             "field": "priority", "from": was, "to": now,
             "reason": args.reason or ""}
    plan = commit(ctx["project_root"], ctx["state_root"], ctx["board"],
                  jline, event, args.dry_run)
    return {"id": tid, "from": was, "to": now, "row": line,
            "priority": priority, "group": group, **plan}


def cmd_list(args, ctx) -> dict:
    """The full task set, from one call.

    `BOARD.md` holds open work only — closed rows leave it — so the complete
    set has, until now, existed solely as a reconstruction from date-sharded
    journal prose. A reader would have to parse every file in every month and
    rebuild each task's timeline. This does that once, in code, so a front-end
    never learns Perry's file formats and Perry can change them without
    breaking a program it does not control.

    **This payload is a frozen contract.** Its shape is specified in
    `schema/task-list-contract.md` and locked by tests; `LIST_CONTRACT` below
    is the version handle a consumer checks. Every declared key is ALWAYS
    present — an unknown value is `""`, `null` or `[]`, never a missing key —
    so a consumer needs no defensive branch per field.

    It exists so a front-end does not write a second parser for `BOARD.md`.
    That is not a style preference: `viewer/parsers.py` and `bin/perry-task`
    were two parsers of one file and they disagreed silently — the writer
    placed cells by header name while the reader read them by position, so a
    board with one extra column reported every task's owner as its track and
    counted zero open work. A third parser would be a third chance at the same
    bug, and this payload is the alternative.
    """
    def blank(tid: str) -> dict:
        # One template, so a key can never exist on some tasks and not others.
        return {"id": tid, "title": "", "owner": "", "priority": "",
                "status": "", "status_text": "", "track": "main", "mode": "",
                "stage": "", "evidence_paths": [],
                "stage_since": "", "arrived": "", "parent": "",
                "commitment": "", "next_action": "", "evidence": "",
                "verification": "", "open": False, "group": "",
                "created": None, "updated": None, "timeline": []}

    tasks: dict[str, dict] = {}
    conformance = {"sections_read": [], "sections_skipped": [],
                   "rows_with_unrecognized_id": [], "off_enum_status": [],
                   "rows_with_no_status": [], "evidence_not_found": [],
                   "rows_with_no_computable_age": [],
                   "next_action_cites_closed": [],
                   "has_event_log": bool(ctx["events"])}
    statuses = set(ctx["schema"]["enums"]["task_status"])
    terminal = {"done", "dropped"}

    for tbl in ctx["board"].task_tables():
        if not tbl["readable"]:
            conformance["sections_skipped"].append(
                {"heading": tbl["heading"],
                 "why": "table has no ID and Title columns",
                 "columns": tbl["header"]})
            continue
        conformance["sections_read"].append(
            {"heading": tbl["heading"], "priority": tbl["priority"],
             "rows": len(tbl["rows"])})
        pri = tbl["priority"] or ""
        for c in tbl["rows"]:
            # `~~DATA-007~~` and `**TASK-1**` are both real, both from a real
            # board: strikethrough means retired, bold means emphasis, and the
            # id underneath is the handle either way.
            tid = c.get("id", "").replace("~", "").replace("*", "").replace("`", "").strip()
            if not tid:
                continue
            if not re.fullmatch(r"[A-Za-z][\w./-]*-?\d*", tid):
                # A row whose first cell is prose, not a handle. One real board
                # has `| 2 待核项 | …` sitting in its P2 table. Reported so a
                # reader knows the board holds something it could not index —
                # dropping it silently is how a front-end shows nonsense.
                conformance["rows_with_unrecognized_id"].append(
                    {"section": tbl["heading"], "cell": tid[:60]})
                continue
            raw = c.get("status", "")
            # `**done**` is `done` wearing bold. Formatting is not meaning, and
            # a consumer that trusts the enum renders a finished task as an
            # unrecognized state — 17 of 41 rows on one real board. Emphasis is
            # stripped here so the enum claim is true; `status_text` keeps the
            # cell verbatim, because some cells genuinely are not one state
            # ("迁移 done，占比目标 not_started" is two, and rounding it to
            # either is a lie about the work).
            st = raw.strip().strip("*_`").strip()
            if st not in statuses:
                st = ""
            if not raw.strip():
                conformance["rows_with_no_status"].append(
                    {"id": tid, "section": tbl["heading"]})
            elif not st:
                conformance["off_enum_status"].append(
                    {"id": tid, "status": raw})
            t = blank(tid)
            t.update({
                "title": c.get("title", ""), "owner": c.get("owner", ""),
                "priority": pri, "group": tbl["heading"],
                "status": st, "status_text": raw,
                "track": c.get("track", "") or "main",
                "stage": c.get("stage", ""),
                "stage_since": c.get("stage since", ""),
                "arrived": c.get("arrived", ""), "parent": c.get("parent", ""),
                "commitment": c.get("commitment", ""),
                "next_action": c.get("next action", ""),
                "evidence": c.get("evidence", ""),
                "verification": c.get("verification", ""),
                # `open` used to mean "still on the board", which was true when
                # the board held only P0/P1/P2 and closing removed the row.
                # Once the reader saw every section, a project that stages
                # finished work under its own heading — Perry's own board has
                # `## Done this period (leaves the board at next triage)` —
                # reported 20 done tasks as open. The contract tells consumers
                # this field IS the live/closed test, so it has to mean that.
                "open": st not in terminal,
            })
            tasks[tid] = t

    for e in ctx["events"]:
        tid = e.get("id", "")
        if not tid or e.get("event") not in TASK_EVENTS:
            # The log is one stream for the whole project, and not everything
            # in it is a task. `## User Input Queue`, `## Cadence`, `## Intake`
            # and `## Top risks` are not tasks, and
            # `schema/task-list-contract.md § What this contract does not cover`
            # says so — but this loop folded EVERY event carrying an id. `ask`
            # writes a `USER-` id and `risk-add` writes an `RX-` one; absorbed
            # here they became rows in `tasks[]` with no title, no priority and
            # `open: false`, counted as closed work. Measured on a board with
            # one `ask` and nothing else: `list --all` returned exactly one
            # "task", the question.
            #
            # The board half was always right — `_task_sections` skips those
            # headings. Only the event fold was not. **The id shape cannot be
            # the filter, because project ids are project-defined; the event
            # name can, because this file mints it.**
            #
            # Found independently by two agents working in separate worktrees,
            # neither aware of the other. That is corroboration, not noise.
            continue
        t = tasks.setdefault(tid, blank(tid))
        # A row that has left the board is closed; one still on it stays open,
        # and its live cells win over anything the event stream remembers.
        if not t["open"]:
            t["status"] = e.get("to") or t["status"]
            t["title"] = e.get("title") or t["title"]
            t["track"] = e.get("track") or t["track"]
            t["priority"] = e.get("priority") or t["priority"]
            t["evidence"] = e.get("evidence") or t["evidence"]
            t["verification"] = e.get("rung") or t["verification"]
        ts = e.get("ts") or ""
        if e.get("event") in ("add", "route") and ts:
            t["created"] = ts
        if ts and (t["updated"] is None or ts > t["updated"]):
            t["updated"] = ts
        t["timeline"].append(
            {k: e.get(k) for k in ("ts", "event", "from", "to", "actor")})

    # `mode` is DERIVED, from `track` + `.perry/config.md § Tracks` — the same
    # register `track_of` reads and the only place a project declares which
    # `modes/<mode>.md` governs a track.
    #
    # It used to be read back out of the event log, which made it a stored copy
    # of a derived value and wrong in two ways at once: only `cmd_add` ever
    # wrote it, so every row `route` created shipped `mode: ""` on a queue
    # track — the one mode where routing is the normal way a row is born — and
    # deleting `.perry/events.jsonl` blanked it for every row on the board. The
    # log is declared DERIVED AND DISPOSABLE at the top of this file, so
    # nothing in a frozen contract may depend on it for a value the markdown
    # already determines.
    #
    # The fallback mirrors `parse_tracks`: a project that never declared a
    # track has exactly one, named `main`, mode `project`. A row on a track the
    # register does not declare gets `""` — the payload says it does not know,
    # which is the documented meaning of `""` for this field and better than
    # naming a mode the project never chose.
    declared = ctx["config"].get("tracks") or [{"track": "main",
                                                "mode": "project"}]
    modes = {t["track"]: t.get("mode", "") for t in declared}
    for t in tasks.values():
        t["mode"] = modes.get(t["track"], "")

    # `evidence_paths` is resolved HERE, after the event merge, for EVERY row.
    #
    # It used to be resolved inside the board walk, which meant it was resolved
    # only for rows that are ON the board — and closed rows leave the board.
    # Measured on Perry's own board: **32 closed rows, every one carrying an
    # evidence cell, every one with `evidence_paths: []`, and every file
    # present on disk.** The identical path on the identical board resolved
    # while the row was open and stopped the day it closed. `evidence` was not
    # empty, so nothing looked wrong; `conformance.evidence_not_found` was
    # empty too, so a consumer could not tell "Perry did not resolve this" from
    # "the file is gone" — and aiMark rendered the document that JUSTIFIES a
    # close as a dead link. The one row a reader most wants the artifact for.
    #
    # Two other things fall out of resolving after the merge rather than
    # during the walk. A closed row's `evidence` comes off the `done` event,
    # which the merge above applies — resolving before it ran would have
    # resolved a cell the payload then replaced. And a row that is on the
    # board but closed had exactly that divergence: `evidence` from the event,
    # `evidence_paths` from the board cell.
    #
    # Sorted by id so the report is stable across board and log ordering.
    for t in sorted(tasks.values(), key=lambda r: r["id"]):
        found, missing = evidence_paths(
            t["evidence"], ctx["state_root"], ctx["project_root"])
        t["evidence_paths"] = found
        if missing:
            conformance["evidence_not_found"].append(
                {"id": t["id"], "paths": missing})

    # A row with no event AND no date cell has no age at all. Every staleness
    # rule triage runs is "idle ≥ N days", so such a row reads as fresh
    # forever. The six standard board columns carry no date, so on a board
    # written before the event log this is most of them — including, when this
    # was added, the two rows on Perry's own board whose `Next action` still
    # described blockers that had already been fixed.
    #
    # Computed HERE, after the event merge: doing it during the board walk
    # flagged rows the tool had created itself, because `updated` was not
    # filled in yet.
    conformance["rows_with_no_computable_age"] = sorted(
        t["id"] for t in tasks.values()
        if t["open"] and not t["updated"]
        and not t["stage_since"] and not t["arrived"])

    # An open row whose `Next action` points at a task that has since closed.
    # Orthogonal to the age check and catches a different case: a row can be
    # touched yesterday and still be waiting on something that finished.
    #
    # **Only ids in this payload are resolved.** `DESIGN-`, `ADR-` and `USER-`
    # ids appear in these cells constantly and are NOT checked here — saying
    # "cites nothing closed" while silently skipping three id families would
    # be a stronger claim than the data supports.
    for t in tasks.values():
        if not t["open"]:
            continue
        for cited in sorted(set(ID_RE.findall(t["next_action"]))):
            cid = f"TASK-{int(cited):03d}"
            other = tasks.get(cid)
            if other is not None and not other["open"]:
                conformance["next_action_cites_closed"].append(
                    {"id": t["id"], "cites": cid, "status": other["status"]})

    rows = sorted(tasks.values(), key=lambda t: t["id"])
    if args.track:
        rows = [t for t in rows if t["track"] == args.track]
    if not args.all:
        rows = [t for t in rows if t["open"]]

    # An id whose only record is an event with no title predates the `title`
    # field. Reported rather than papered over: a bare id is exactly what
    # `reference/user-load.md` forbids handing a reader.
    untitled = [t["id"] for t in rows if not t["title"]]
    # `## Intake` — the one section a procedure must act on by POSITION.
    # `route <n>` and `resolve-intake <n>` take a row number, and the only way
    # to get one was to open `BOARD.md` and count, twenty lines below the rule
    # that forbids exactly that. Undischarged rows and the oldest arrival are
    # what triage's step 0 asks for; both were uncomputable from any payload.
    intake_rows = []
    try:
        for pos, (_, cells) in enumerate(ctx["board"].section_rows("Intake"), 1):
            _, ihdr = ctx["board"].section_table("Intake")
            row = dict(zip([norm(h) for h in ihdr], cells))
            outcome = (row.get("outcome") or "").strip()
            intake_rows.append({
                "n": pos,
                "arrived": row.get("arrived", ""),
                "request": row.get("request", ""),
                "outcome": outcome,
                "discharged": bool(outcome)
                              and outcome.strip("*` ").lower() not in INTAKE_UNSET,
                "age_days": days_between(row.get("arrived", "")),
            })
    except Refused:
        pass                      # no `## Intake` — not every project is queue-shaped

    return {"contract": LIST_CONTRACT,
            "intake": {
                "rows": intake_rows,
                "undischarged": sum(1 for r in intake_rows if not r["discharged"]),
                "oldest_undischarged": next(
                    (r["n"] for r in sorted(
                        (x for x in intake_rows if not x["discharged"]),
                        key=lambda x: x["age_days"] if x["age_days"] is not None else -1,
                        reverse=True)), None),
            },
            "project_root": str(ctx["project_root"]),
            "state_root": str(ctx["state_root"]),
            "conformance": conformance,
            "tasks": rows,
            "open": sum(1 for t in rows if t["open"]),
            "closed": sum(1 for t in rows if not t["open"]),
            "events": len(ctx["events"]),
            "untitled": untitled}


_PERRY_STATE = None


def perry_state():
    """`bin/perry-state` as a module, loaded once per process.

    The loader was inline in `main()` and gated on `.perry/config.md` existing,
    so anything else that wanted a rule from `perry-state` had to copy it
    instead — which is what `split_stages` below was. Hoisted and cached so
    there is one way to reach that file and no reason to reimplement anything
    in it.
    """
    global _PERRY_STATE
    if _PERRY_STATE is None:
        import importlib.machinery
        import importlib.util
        sys.path.insert(0, str(PERRY_HOME / "bin"))
        spec = importlib.util.spec_from_loader(
            "perry_state", importlib.machinery.SourceFileLoader(
                "perry_state", str(PERRY_HOME / "bin" / "perry-state")))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        _PERRY_STATE = mod
    return _PERRY_STATE


_PERRY_CONFORM = None


def perry_conform():
    """`bin/perry-conform` as a module — the conformance gate (ADR-004)."""
    global _PERRY_CONFORM
    if _PERRY_CONFORM is None:
        import importlib.machinery
        import importlib.util
        sys.path.insert(0, str(PERRY_HOME / "bin"))
        spec = importlib.util.spec_from_loader(
            "perry_conform", importlib.machinery.SourceFileLoader(
                "perry_conform", str(PERRY_HOME / "bin" / "perry-conform")))
        mod = importlib.util.module_from_spec(spec)
        # Registered BEFORE exec: `perry-conform` declares dataclasses under
        # `from __future__ import annotations`, and `dataclasses` resolves
        # those string annotations through `sys.modules[cls.__module__]`. An
        # unregistered module makes that lookup return None and the import dies
        # inside the decorator, several frames from anything that names it.
        sys.modules["perry_conform"] = mod
        spec.loader.exec_module(mod)
        _PERRY_CONFORM = mod
    return _PERRY_CONFORM


#: The commands that only read. Everything else writes `BOARD.md` and is gated
#: on `BOARD.md` — on that file and on nothing else, because ADR-004 § 5 makes
#: conformance per-file so a project can migrate its board and not its risks.
#: `list` is a published contract (`schema/task-list-contract.md`) and reading
#: is never gated, so it is not merely excluded here — `tests/test_conformance`
#: asserts it still answers on an undeclared project with the gate enforcing.
READ_ONLY_COMMANDS = {"list"}
GATED_FILE = "BOARD.md"


def split_stages(cell: str) -> list[str]:
    """The stage vocabulary of a `Stages` cell — `perry-state`'s implementation.

    There were two, differing only in a loop variable, with the docstring that
    explains the normalization on one of them. Three spellings of the separator
    are in circulation (`->`, `→`, `→` with spaces) and "the first stage" and
    "the terminal stage" are both load-bearing rules, so the two copies were one
    edit away from disagreeing about where every row in a track begins and ends
    — silently, because nothing compared them. This file already loads
    `perry-state` to reuse `parse_tracks`; reusing this costs nothing more.
    """
    return perry_state().split_stages(cell)


def default_stages(schema: dict, mode: str) -> list[str]:
    return split_stages(schema["work_modes"]["modes"][mode].get("default_stages", ""))


# ── main ──────────────────────────────────────────────────────────────────


class Args:
    pass


def parse(argv: list[str]) -> Args:
    a = Args()
    a.cmd = None
    a.id = a.title = a.track = a.owner = a.priority = None
    a.next = a.parent = a.commitment = a.stage = a.evidence = a.rung = None
    a.root = None
    a.actor = "agent"
    a.arrived = a.reason = a.outcome = a.status = None
    a.needed = a.blocks = a.answer = None
    a.frequency = a.on = None
    a.needed = a.blocks = a.answer = a.opened = None
    a.deliverable = a.verification = a.depends = a.out_of_scope = a.kr = None
    a.group = a.prefix = None
    a.dry_run = a.as_json = a.all = False
    i = 0
    flags = {"--title": "title", "--track": "track", "--owner": "owner",
             "--priority": "priority", "--next": "next", "--parent": "parent",
             "--commitment": "commitment", "--stage": "stage",
             "--evidence": "evidence", "--rung": "rung", "--root": "root",
             "--arrived": "arrived", "--reason": "reason",
             "--outcome": "outcome", "--status": "status",
             "--actor": "actor", "--needed": "needed",
             "--blocks": "blocks", "--answer": "answer",
             "--frequency": "frequency", "--on": "on",
             "--opened": "opened", "--deliverable": "deliverable",
             "--verification": "verification", "--depends": "depends",
             "--out-of-scope": "out_of_scope", "--kr": "kr",
             "--group": "group", "--prefix": "prefix"}
    while i < len(argv):
        t = argv[i]
        if t in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        elif t == "--dry-run":
            a.dry_run = True
        elif t == "--json":
            a.as_json = True
        elif t == "--all":
            a.all = True
        elif t in flags:
            i += 1
            setattr(a, flags[t], argv[i] if i < len(argv) else None)
        elif t.startswith("-"):
            print(f"perry-task: unknown argument {t!r} (try --help)", file=sys.stderr)
            sys.exit(2)
        elif a.cmd is None:
            a.cmd = t
        elif a.id is None:
            a.id = t
        i += 1
    return a


# The single source of truth for what `perry-task` accepts. Membership check,
# error message and dispatch all read this one dict on purpose: it used to be a
# tuple and a dict holding the same list, and they drifted apart twice — once
# leaving `drop` accepted but undispatched (a bare KeyError), once leaving
# `drop`, `status` and `resolve-intake` out of the "expected one of" line. A
# name added here is reachable, dispatchable and advertised in one edit.
# Which events describe a `## P0`/`## P1`/`## P2` row, and which describe one of
# the board sections that are explicitly not tasks. Written as a partition of
# `COMMANDS` rather than as one list, and checked to BE a partition by
# `tests/test_cadence.py`, because the alternative shapes both fail silently: an
# allowlist drops a future event from the payload, a denylist leaks one into it,
# and either way nobody finds out until a consumer reports it. This file has
# already lost that bet twice with a tuple and a dict holding "the same" list.
TASK_EVENTS = frozenset({"add", "route", "start", "stage", "status", "next",
                         "retitle", "rung", "evidence", "prioritize",
                         "done", "drop"})
SECTION_EVENTS = frozenset({"intake", "resolve-intake", "intake-sweep",
                            "ask", "answer",
                            "cadence-add", "cadence-done",
                            "risk-add", "risk-clear", "risk-migrate"})

COMMANDS = {"add": cmd_add, "start": cmd_start, "stage": cmd_stage,
            "ask": cmd_ask, "answer": cmd_answer, "next": cmd_next,
            "cadence-add": cmd_cadence_add, "cadence-done": cmd_cadence_done,
            "risk-add": cmd_risk_add, "risk-clear": cmd_risk_clear,
            "risk-migrate": cmd_risk_migrate,
            "done": cmd_done, "drop": cmd_drop, "intake": cmd_intake,
            "route": cmd_route, "resolve-intake": cmd_resolve_intake,
            "retitle": cmd_retitle, "rung": cmd_rung,
            "evidence": cmd_evidence, "prioritize": cmd_prioritize,
            "intake-sweep": cmd_intake_sweep,
            "status": cmd_status, "list": cmd_list}


@contextlib.contextmanager
def project_lock(state_root: Path, timeout: float = 10.0):
    """Serialize the whole read-modify-write, not just the write.

    `BOARD.md` is read when `Board` is constructed and written in `commit()`.
    Between those two points another process can do the same thing, and the
    second rename then discards the first process's row entirely. Measured, not
    theorized: five concurrent `add` calls left **two** rows on the board, with
    `TASK-001` and `TASK-002` each issued twice. The event log took all five,
    because it is opened `O_APPEND` — the append-only file survived exactly the
    race the read-modify-write document lost.

    `autopilot` dispatches concurrently by design, so this path is live rather
    than hypothetical.

    The lock must wrap the read as well as the write, which is why it is taken
    here and not inside `commit()`: a lock around the write alone would still
    let both processes mint the same id from the same stale board.

    **It lives outside the project entirely**, in the temp dir, keyed by a hash
    of the state root. Two earlier placements each broke something real:

    - in `.perry/` — an unwritable `.perry/` made the lock uncreatable and
      refused the whole call, even though `BOARD.md` and the journal were both
      writable. The design's entire claim is that `.perry/` is derived and can
      never make Perry *wrong*.
    - beside `BOARD.md` — it then appears in the project, and a consumer repo
      does not inherit Perry's own `.gitignore`. Checked on a real Perry project
      the same night it shipped: `?? .board.lock`, untracked and unignored. A
      tool that makes every user edit their `.gitignore` to stay clean has
      pushed its own bookkeeping onto them.

    It is also not flock on `BOARD.md` itself: `commit()` renames a temp file
    over it, so every writer after the first would hold a lock on a replaced
    inode and exclusion would quietly stop working.

    A file outside the tree, never renamed, keyed by the path it guards, is the
    one shape that survives all three. It is pure runtime state — losing it
    between reboots costs nothing, because it only ever means "no one is writing
    right now", which is true after a reboot.
    """
    key = hashlib.sha1(str(state_root.resolve()).encode()).hexdigest()[:16]
    lock_path = Path(tempfile.gettempdir()) / f"perry-task-{key}.lock"
    fh = open(lock_path, "w")
    deadline = time.monotonic() + timeout
    try:
        while True:
            try:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.monotonic() >= deadline:
                    raise Refused(
                        f"another perry-task is holding {lock_path} and did not "
                        f"release it within {timeout:.0f}s. Nothing was written; "
                        f"retry, or remove the file if no other process is live")
                time.sleep(0.05)
        yield
    finally:
        try:
            fcntl.flock(fh.fileno(), fcntl.LOCK_UN)
        finally:
            fh.close()


def main(argv: list[str]) -> int:
    args = parse(argv)
    if args.cmd not in COMMANDS:
        print(f"perry-task: expected one of {' / '.join(COMMANDS)} "
              f"(try --help)", file=sys.stderr)
        return 2
    try:
        schema = load_schema()
        project_root = (Path(args.root).expanduser().resolve() if args.root
                        else Path(os.environ.get("PERRY_PROJECT") or Path.cwd()).resolve())
        state_root = P.resolve_state_root(project_root)
        cfg_path = project_root / ".perry" / "config.md"
        config = {"tracks": []}
        if cfg_path.exists():
            config = {"tracks": perry_state().parse_tracks(cfg_path.read_text())}
        # ADR-004. Taken before the lock and before any command runs: a refusal
        # must mean nothing was written, and a dry run must preview the refusal
        # rather than the write it would not be allowed to perform.
        gate = None
        if args.cmd not in READ_ONLY_COMMANDS:
            gate = perry_conform().gate(project_root, state_root, GATED_FILE,
                                        tool="perry-task", root_arg=args.root)
            if not gate.ok:
                raise Refused(gate.message)
            if gate.message and not args.as_json:
                print(f"perry-task: ⚠ conformance (advisory) — {gate.message}",
                      file=sys.stderr)
        with project_lock(state_root):
            ctx = {"schema": schema, "project_root": project_root,
                   "state_root": state_root, "config": config,
                   "board": Board(state_root / "BOARD.md"),
                   "events": read_events(project_root)}
            result = COMMANDS[args.cmd](args, ctx)
        # `list` is a published contract and gets nothing added to it. Every
        # other subcommand's payload is Perry-internal, so the verdict rides
        # along there — an agent reading `--json` should not have to shell out
        # to a second tool to learn its write was allowed under protest.
        if gate is not None and isinstance(result, dict):
            result["conformance"] = gate.as_dict()
    # A value a markdown table row cannot carry. Translated into the ordinary
    # refusal channel here, at the boundary, rather than checked per
    # subcommand: the previous version of this rule lived inside `render_row`
    # as an escape for one character, and the next subcommand to grow a
    # free-text flag walked straight past it. `render_row` raises before
    # `commit()`, so a refusal means nothing was written.
    except UnrenderableCell as exc:
        msg = (f"the value {exc.value[:60]!r}… {exc.why}. "
               "A board cell is one line of a markdown table; pass a summary "
               "and put the long form in an evidence file."
               if len(exc.value) > 60 else
               f"the value {exc.value!r} {exc.why}.")
        if args.as_json:
            print(json.dumps({"refused": msg}, ensure_ascii=False, indent=2))
        else:
            print(f"perry-task: refused — {msg}", file=sys.stderr)
        return 1
    except Refused as exc:
        if args.as_json:
            print(json.dumps({"refused": str(exc)}, ensure_ascii=False, indent=2))
        else:
            print(f"perry-task: refused — {exc}", file=sys.stderr)
        return 1

    if args.as_json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    elif args.cmd == "list":
        for r in result["tasks"]:
            mark = " " if r["open"] else "·"
            title = r["title"] or "(no title in the record)"
            print(f" {mark}{r['id']:10} {r['priority']:3} {r['status']:12} {title[:54]}")
        print(f"\n  {result['open']} open · {result['closed']} closed · "
              f"{result['events']} event(s)")
        if result["untitled"]:
            print(f"  ⚠ {len(result['untitled'])} id(s) have no title in the record: "
                  f"{', '.join(result['untitled'])}")
    else:
        verb = "would write" if args.dry_run else "wrote"
        # `commit()` reports a lost event honestly; this line used to say
        # "→ board + journal + event" regardless, so the surface the agent
        # actually reads asserted a write that the function below it had
        # already recorded as failed.
        wrote_event = result.get("event_written", True)
        tail = ("board + journal + event" if wrote_event
                else "board + journal (event log unwritable — this row will "
                     "show as `unrecorded` until it is fixed)")
        # Not every subcommand mints an id — `intake`, `intake-sweep` and
        # `resolve-intake` act on a section row. Printing `None` there told the
        # user the write had no subject when it had a perfectly good one.
        subject = (result.get("id")
                   or (f"{result['swept']} row(s)" if "swept" in result else "")
                   or (f"{result['count']} risk(s)" if "count" in result else "")
                   or (f"intake row {args.id}" if args.id else "the row"))
        print(f"perry-task: {verb} {subject} ({args.cmd}) → {tail}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
