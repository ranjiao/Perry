#!/usr/bin/env python3
"""
perry-kernel-migrate — a project's old stores, imported into a TEMPORARY
kernel store and reconciled against it (DESIGN-023 § 6 row D, TASK-489).

    perry-kernel-migrate [--root <project>] [--json]                 plan only
    perry-kernel-migrate [--root <project>] --work <dir> [--json]    import

It reads `tasks.jsonl`, `asks.jsonl`, `risks.jsonl`, `intake.jsonl`,
`cadence.jsonl` and `.perry/events.jsonl` through the existing readers, takes
each ask's `Blocks` ids from `perry-task asks --all --json` (run read-only, as
a subprocess, when the project holds an ask), and builds a synthetic kernel
export. Without `--work` it stops there, prints what
the import would carry, drop and seed, and writes nothing. With it, it writes
the export under `<dir>/anchor/`, runs `bin/perry-kernel import` into
`<dir>/store.db`, and reads the store back through the kernel to check
DESIGN-023 row D's criteria 1–5. It writes nothing outside `<dir>`, which must
be empty or absent and outside the project and any `.git`, and it names that
store with `--store` on every kernel call. The run is reconciled when the
five criteria hold, every reference resolves to an imported id or is a key
result listed for TASK-492, and the kernel refused no reconciliation call.
Exit 0 planned or reconciled, 1 refused or not reconciled, 2 bad
invocation. It is one-shot: row H deletes it
with the rest of the old `bin/`. The mapping and its reasons: `bin/README.md §
perry-kernel-migrate`.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "viewer"))
sys.path.insert(0, str(HERE))
import lib  # noqa: E402
import parsers as P  # noqa: E402
import perry_store  # noqa: E402

KERNEL = HERE / "perry-kernel"
TEMPLATE = HERE.parent / "templates" / "process" / "perry.json"
ACTOR = {"kind": "agent", "name": "perry-kernel-migrate",
         "session": "perry-kernel-migrate"}
KERNEL_TIME = "%Y-%m-%dT%H:%M:%SZ"

#: DESIGN-023 decision 13, as TASK-489's spec carries it: which old register
#: becomes which type, which old field keeps (or changes) its name, which old
#: fields are consumed into the state, the dates, the relations and the
#: attachments, and which are not carried. Every key of an old record is in
#: exactly one of these, or must be blank: a populated key this table does not
#: name is refused, so nothing is dropped that the report does not count.
MAPPING = {
    "tasks": {
        "type": "task", "created": "created",
        "fields": {"title": "title", "summary": "summary",
                   "priority": "priority", "owner": "owner",
                   "track": "track", "verification": "verification",
                   "next_action": "next_action", "evidence": "evidence"},
        "consumed": ("id", "status", "created", "depends_on", "design_refs"),
        "dropped": ("group", "order", "commitment", "role", "stage",
                    "arrived", "stage_since"),
        "must_be_blank": ("parent",),
    },
    "asks": {
        "type": "ask", "created": "asked",
        "fields": {"needed": "question"},
        "consumed": ("id", "status", "answered", "asked", "blocks"),
        "dropped": ("order",),
        "must_be_blank": (),
    },
    "risks": {
        "type": "risk", "created": "opened",
        "fields": {"risk": "concern"},
        "consumed": ("id", "status", "opened", "cleared"),
        "dropped": ("order",),
        "must_be_blank": (),
    },
}
#: The registers that hold no type (decision 13). A row in either stops the
#: import: the spec says both are empty, and nothing here can place a row.
NO_TYPE = ("intake", "cadence")
#: § Decided 2026-09-29, option A: a closed task's `next_action` is not
#: imported; an open task's is imported as it is.
CLOSED = ("done", "dropped")
#: The measure the long-cell decision was taken on: bytes of UTF-8.
LONG_CELL_BYTES = 300
#: The importer holds no split of a reference cell (TASK-489 round 4, the
#: user's option B; root `ARCHITECTURE.md` § 3, NN-1). A task's `depends_on`
#: is taken entry by entry, whole: `tasks.jsonl` holds it as
#: `perry-task § parse_depends` output already. An ask's `Blocks` cell is
#: read by the old tool itself: `perry-task asks --all --json` publishes the
#: ids `perry-task § _BLOCKS_ID` finds in each cell as `blocks_ids`. It runs
#: as a subprocess, read-only, and a tool never imports another
#: (`bin/ARCHITECTURE.md` § 3).
PERRY_TASK = HERE / "perry-task"


class Refused(Exception):
    """The import cannot go on. Nothing was written outside `--work`."""

    def __init__(self, message, details=None):
        super().__init__(message)
        self.details = details or {}


SURFACE = {
    "name": "perry-kernel-migrate",
    "kind": "read",
    "summary": "import a project's old stores into a temporary kernel store "
               "and reconcile the two (DESIGN-023 row D)",
    "root_resolution": "standard",
    "exit_codes": {"0": "planned, or imported and reconciled",
                   "1": "refused, or not reconciled",
                   "2": "bad invocation"},
    "flags": [
        {"name": "--work", "arg": "dir", "summary":
         "import into a store here: an empty or absent directory outside the "
         "project, where the export, the anchor and the store go and nowhere "
         "else. Without it, plan only and write nothing"},
        {"name": "--json", "summary": "the reconciliation as one JSON object"},
    ],
    "subcommands": [],
}


# ── reading the old stores ─────────────────────────────────────────────────


def blank(value) -> bool:
    """A cell that says nothing, so it is unset and not imported (TASK-489
    round 3, item 1): null, or a string `lib.is_blank_cell` calls blank.
    That is the project's one blank rule, pinned by
    `tests/test_blank_cell_is_one_rule.py`. It reads its spellings from
    `schema/state-schema.json § i18n.blank_cell`, so besides an empty string
    and the old store's marker `—` it takes `-`, `n/a`, `TBD`, `none`, `?`,
    `待定` and the others, padded or decorated. The report counts the unset
    cells per field and per spelling."""
    return value is None or (isinstance(value, str)
                             and lib.is_blank_cell(value))


def unset_spelling(value) -> str:
    """How a blank cell was written, for the report's per-field counts."""
    text = value.strip() if isinstance(value, str) else ""
    return text if text else "empty"


def moment(value):
    """`lib.ts_moment`, the one converter, as the kernel's time text."""
    m = lib.ts_moment(value)
    return m.strftime(KERNEL_TIME) if m else None


def read_old(project_root: Path, state_root: Path) -> tuple[dict, list]:
    stores, findings = perry_store.load_board_stores(state_root)
    if findings:
        raise Refused(f"{len(findings)} old record(s) do not validate; the "
                      f"first: {findings[0]}", {"findings": findings})
    for name in NO_TYPE:
        if stores.get(name):
            raise Refused(f"{name}.jsonl holds {len(stores[name])} row(s); "
                          f"the template has no {name} type, and DESIGN-023 "
                          f"decision 13 says the store is empty. Stopped.",
                          {"register": name, "rows": len(stores[name])})
    log = project_root / ".perry" / "events.jsonl"
    events = P.load_register_store(project_root / ".perry", "events.jsonl")
    if events is None:
        if lib.exists_or_unreadable(log) is not False:
            raise Refused(f"{log} cannot be read as JSONL; its ids seed the "
                          f"ceilings, so the import does not guess",
                          {"path": str(log)})
        events = []
    return stores, events


# ── the snapshot (§ Decided 2026-09-29: one create, at most one move) ─────


class Plan:
    """Everything the import will write, and everything the report counts."""

    def __init__(self, template: dict, stores: dict, events: list,
                 run_at: str):
        self.template = template
        self.types = template["types"]
        self.stores = stores
        self.events = events
        self.run_at = run_at
        self.items: dict[str, dict] = {}
        self.counts = {"dropped": {}, "skipped_next_action": {},
                       "answers": {}, "reasons": {},
                       "status_not_carried": {}, "time_rules": {}}
        #: `{"<register>.<field>": {"empty": n, "—": m}}`: the mapped cells
        #: that said nothing and were not imported, by how they were written.
        self.unset: dict[str, dict] = {}
        #: References that resolve to no imported id. Any one of them makes
        #: the run "not reconciled" (TASK-489 round 3, item 4).
        self.unresolved: list[dict] = []
        #: References to a key result, which is not a kernel item yet.
        #: TASK-492 restores these edges once key results are items.
        self.for_task_492: list[dict] = []
        #: `{ask id: [ids]}`: what `perry-task asks` read out of each ask's
        #: `Blocks` cell (`ask_blocks`). Set before the edges are built.
        self.blocks_ids: dict[str, list] = {}
        #: Asks whose `Blocks` cell says something and names no id
        #: `perry-task` reads. Nothing of such a cell is carried.
        self.blocks_without_ids: list[str] = []
        #: The schema's declared shape of a key-result id (`kr_id_pattern`).
        self.kr_pattern: str | None = None
        self.self_edges: list[dict] = []
        self.long_open_cells: list[dict] = []
        self.clamped: list[dict] = []
        self.by_id = {}
        for n, e in enumerate(events):
            if isinstance(e, dict) and isinstance(e.get("id"), str):
                self.by_id.setdefault(e["id"], []).append((n, e))
        stamps = [moment(e.get("ts")) for e in events if isinstance(e, dict)]
        stamps = [s for s in stamps if s]
        self.log_start = min(stamps) if stamps else None

    def bump(self, group: str, key: str, n: int = 1):
        bucket = self.counts[group]
        bucket[key] = bucket.get(key, 0) + n

    # ── one record ────────────────────────────────────────────────────────

    def add(self, register: str, rec: dict):
        spec = MAPPING[register]
        type_name = spec["type"]
        tdecl = self.types[type_name]
        item_id = rec.get("id")
        number = self.number(item_id, tdecl)
        if number is None:
            raise Refused(f"{register}.jsonl holds id {item_id!r}, which is "
                          f"not an id type {type_name} mints "
                          f"({tdecl['prefix']}-<n> padded to "
                          f"{tdecl.get('digits', 1)} digits)",
                          {"register": register, "id": item_id})
        if item_id in self.items:
            raise Refused(f"{item_id} is held twice", {"id": item_id})
        known = (set(spec["fields"]) | set(spec["consumed"])
                 | set(spec["dropped"]) | set(spec["must_be_blank"]))
        for key in sorted(rec):
            if key in spec["dropped"] and not blank(rec[key]):
                self.bump("dropped", f"{register}.{key}")
            elif (key not in known or key in spec["must_be_blank"]) and \
                    not blank(rec[key]):
                raise Refused(f"{item_id}: {register}.jsonl field {key!r} "
                              f"holds a value the mapping does not carry "
                              f"and does not drop. Stopped.",
                              {"id": item_id, "field": key})
        state = self.state(register, rec, tdecl)
        fields = {}
        for old, new in spec["fields"].items():
            value = rec.get(old)
            if blank(value):
                cell = self.unset.setdefault(f"{register}.{old}", {})
                spelling = unset_spelling(value)
                cell[spelling] = cell.get(spelling, 0) + 1
                continue
            if register == "tasks" and old == "next_action":
                if state in CLOSED:
                    self.bump("skipped_next_action", state)
                    continue
                size = len(value.encode("utf-8"))
                if size > LONG_CELL_BYTES:
                    self.long_open_cells.append(
                        {"id": item_id, "state": state, "bytes": size})
            fields[new] = value
        closing = self.closing_text(register, rec, state)
        created_at, created_rule, created_note = self.created(
            item_id, rec.get(spec["created"]), spec["created"])
        self.bump("time_rules", f"create: {created_rule}")
        item = {"id": item_id, "type": type_name, "number": number,
                "prefix": tdecl["prefix"], "state": state, "fields": fields,
                "register": register, "status": rec.get("status"),
                "created_at": created_at, "created_note": created_note,
                "closing": closing, "attachments": [], "move": None}
        if state != tdecl["initial"]:
            item["move"] = self.move(item, rec, tdecl)
        elif closing:
            raise Refused(f"{item_id}: {type_name} state {state} is its "
                          f"initial state, and no move can carry "
                          f"{', '.join(sorted(closing))}", {"id": item_id})
        if register == "tasks":
            refs = rec.get("design_refs") or []
            for ref in refs:
                if blank(ref):
                    continue
                if "\n" in ref or "\r" in ref:
                    raise Refused(f"{item_id}: design ref {ref!r} holds a "
                                  f"line break", {"id": item_id})
                if ref not in item["attachments"]:
                    item["attachments"].append(ref)
        self.items[item_id] = item

    @staticmethod
    def number(item_id, tdecl):
        if not isinstance(item_id, str):
            return None
        prefix, _, digits = item_id.partition("-")
        if prefix != tdecl["prefix"] or not (digits.isascii()
                                             and digits.isdigit()):
            return None
        n = int(digits)
        if item_id != f"{prefix}-{n:0{tdecl.get('digits', 1)}d}":
            return None
        return n

    def state(self, register, rec, tdecl) -> str:
        """The item's state, from its status cell through the existing
        readers: `parsers.ask_is_answered` for an ask, and
        `parsers.status_is_cleared` for a risk (TASK-489 round 3, item 3)."""
        status = rec.get("status")
        text = status.strip() if isinstance(status, str) else ""
        if register == "tasks":
            if text not in tdecl["states"]:
                raise Refused(f"{rec['id']}: status {status!r} is not a "
                              f"state of the task type", {"id": rec["id"]})
            return text
        if register == "asks":
            answered = rec.get("answered")
            if not isinstance(answered, bool) or \
                    answered != P.ask_is_answered(status or ""):
                raise Refused(f"{rec['id']}: answered is {answered!r} and "
                              f"the status cell reads "
                              f"{'answered' if P.ask_is_answered(status or '') else 'open'}; "
                              f"the two disagree. Stopped.", {"id": rec["id"]})
            return "answered" if answered else "pending"
        if P.status_is_cleared(status or ""):
            return "cleared"
        if text == "open":
            return "open"
        raise Refused(f"{rec['id']}: risk status {status!r} is neither open "
                      f"nor cleared", {"id": rec["id"]})

    def closing_text(self, register, rec, state) -> dict:
        """What a closed ask or risk says about its closing, carried into its
        `answer` or `reason` (TASK-489 round 3, items 2 and 3). The field is
        set by the item's one move, as a live `item move` that sets a field
        writes it, and the move is the event that closes the item. No new
        parse cuts the text out of the status cell:
        - an answered ask's `answer` is the text `parsers.ask_answer`
          returns. Where that text is empty, as for `withdrawn …` or
          `dropped …`, it is the status cell verbatim;
        - a cleared risk's `reason` is its status cell verbatim.
        The report counts each kind, and the status text no field carries:
        the `answered <date>:` part of an answer `ask_answer` read, and a
        pending ask's status cell where it says more than `pending`."""
        status = rec.get("status") if isinstance(rec.get("status"),
                                                 str) else ""
        if register == "asks" and state == "answered":
            _on, text = P.ask_answer(status)
            if text.strip():
                self.bump("answers", "parsers.ask_answer")
                self.bump("status_not_carried",
                          "asks: the answered <date>: part")
                return {"answer": text}
            self.bump("answers", "status cell verbatim")
            return {"answer": status}
        if register == "asks" and not blank(status) and \
                status.strip() != state:
            self.bump("status_not_carried",
                      "asks: a pending status that says more")
        if register == "risks" and state == "cleared":
            self.bump("reasons", "status cell verbatim")
            return {"reason": status}
        return {}

    def created(self, item_id, raw, field) -> tuple[str, str, str]:
        """`(time, rule, note)`. A date-only field is read by `lib.ts_moment`,
        the one converter, as 00:00 UTC; the note says so, since that is
        08:00 on this project's +08:00 clock."""
        if not blank(raw):
            at = moment(raw)
            if at is None:
                raise Refused(f"{item_id}: {field} {raw!r} is not a time "
                              f"lib.ts_moment can read", {"id": item_id})
            if lib.is_iso_date(raw):
                return at, field, (f"{field} {raw.strip()}, a date, read as "
                                   f"00:00 UTC")
            return at, field, field
        stamps = [moment(e.get("ts")) for _n, e in self.by_id.get(item_id, [])]
        stamps = [s for s in stamps if s]
        if stamps:
            return min(stamps), "first old event", "first old event"
        if self.log_start:
            return (self.log_start, "start of the old log",
                    "start of the old log")
        return self.run_at, "import time", "import time"

    def move(self, item, rec, tdecl) -> dict:
        state = item["state"]
        names = sorted(name for name, t in tdecl["transitions"].items()
                       if tdecl["initial"] in t["from"] and t["to"] == state)
        if len(names) != 1:
            raise Refused(f"{item['id']}: {len(names)} transitions move a "
                          f"{item['type']} from {tdecl['initial']} to {state}",
                          {"id": item["id"], "transitions": names})
        at, rule = None, None
        for _n, e in reversed(self.by_id.get(item["id"], [])):
            if str(e.get("to") or "") in tdecl["states"]:
                at = moment(e.get("ts"))
                if at:
                    rule = "last old status event"
                    break
        if at is None and item["type"] == "risk" and not blank(
                rec.get("cleared")):
            at, rule = moment(rec["cleared"]), "cleared"
        if at is None:
            at, rule = item["created_at"], "creation date"
        self.bump("time_rules", f"move: {rule}")
        note = rule
        # A move is never timed before its item's create (TASK-489, decided
        # after round 1): it is timed at the later of its rule's time and the
        # create's. Where that moved it, the event's note says so and keeps
        # the time the rule gave.
        if at < item["created_at"]:
            self.clamped.append({"id": item["id"], "rule": rule,
                                 "rule_time": at,
                                 "clamped_to": item["created_at"]})
            note = f"{rule} ({at}), clamped to its create"
            at = item["created_at"]
        return {"transition": names[0], "from": tdecl["initial"],
                "to": state, "at": at, "rule": rule, "note": note}

    # ── relations ─────────────────────────────────────────────────────────

    def edges(self) -> list[tuple]:
        """`blocks` edges, `(from, to)`: a task's `depends_on` (each entry
        blocks the task) and an ask's `Blocks` cell (the ask blocks each id
        it names). Nothing here splits a cell (TASK-489 round 4, option B):
        - a `depends_on` entry is taken whole, as `tasks.jsonl` holds it,
          which is `perry-task § parse_depends` output;
        - an ask's ids are the `blocks_ids` `perry-task asks` read out of its
          cell (`ask_blocks`).
        Each reference is looked up among the imported ids, and nothing is
        guessed:
        - an imported id is an edge;
        - a key-result id, by the shape the schema declares for one
          (`kr_id_pattern`), is listed for TASK-492, which restores the edge
          once key results are kernel items. Both forms `perry-task` reads,
          `O1-KR1` and `P003-O2-KR3`, are one;
        - any other reference resolves to nothing, and makes the run "not
          reconciled"."""
        self.unresolved, self.for_task_492, self.self_edges = [], [], []
        found = []
        for rec in self.stores.get("tasks", []):
            for dep in rec.get("depends_on") or []:
                found.append(("tasks", rec["id"], "depends_on", dep,
                              (dep, rec["id"])))
        for rec in self.stores.get("asks", []):
            for ref in self.blocks_ids.get(rec["id"], []):
                found.append(("asks", rec["id"], "blocks", ref,
                              (rec["id"], ref)))
        out = []
        for register, owner, field, ref, (src, dst) in found:
            if ref not in self.items:
                where = {"register": register, "id": owner, "field": field,
                         "ref": ref}
                if re.fullmatch(self.kr_pattern, ref):
                    self.for_task_492.append(where)
                else:
                    self.unresolved.append(where)
                continue
            if src == dst:
                self.self_edges.append({"register": register, "id": owner,
                                        "field": field})
                continue
            if (src, dst) not in out:
                out.append((src, dst))
        return out

    # ── the ids ever issued ───────────────────────────────────────────────

    def ceilings(self) -> dict:
        out = {}
        for type_name, tdecl in sorted(self.types.items()):
            prefix = tdecl["prefix"]
            stored = [i["number"] for i in self.items.values()
                      if i["type"] == type_name]
            pat = re.compile(rf"{re.escape(prefix)}-(\d+)")
            logged = {}
            for e in self.events:
                for issued_id in event_ids(e):
                    m = pat.fullmatch(issued_id)
                    if m:
                        logged[issued_id] = int(m.group(1))
            only_logged = sorted((i for i in logged if i not in self.items),
                                 key=lambda i: logged[i])
            issued = max(stored + list(logged.values()), default=None)
            out[prefix] = {
                "type": type_name, "stored_max": max(stored, default=None),
                "issued_max": issued, "log_only_ids": only_logged,
                "seed": (issued if issued is not None
                         and issued > max(stored, default=0) else None)}
        return out


def event_ids(event) -> list[str]:
    """The ids one old event names under an id-bearing key: `id`, `task`
    and `record.id` (TASK-489 round 3, item 6). A purge keeps the purged
    record under `record`, and a `link-edge` event names its task under
    `task`. Each prefix's ceiling is seeded from all three."""
    if not isinstance(event, dict):
        return []
    record = event.get("record")
    values = (event.get("id"), event.get("task"),
              record.get("id") if isinstance(record, dict) else None)
    return [v for v in values if isinstance(v, str)]


def canonical(value) -> str:
    """The kernel's one serialisation (`kernel/ARCHITECTURE.md` § 5.8)."""
    return json.dumps(value, sort_keys=True, separators=(",", ":"),
                      ensure_ascii=False)


def id_key(item_id: str):
    prefix, _, digits = item_id.partition("-")
    return prefix, int(digits)


def build_export(plan: Plan, state_root: str) -> tuple[bytes, bytes, dict]:
    """`(items.jsonl, events.jsonl, the event seq of each item's create)`,
    byte for byte as the kernel's own `export` would write them."""
    edges = plan.edges()
    ceilings = plan.ceilings()
    steps = []
    for item in plan.items.values():
        steps.append(((item["created_at"], 0, item["prefix"], item["number"]),
                      "create", item))
        if item["move"]:
            steps.append(((item["move"]["at"], 1, item["prefix"],
                           item["number"]), "move", item))
    steps.sort(key=lambda s: s[0])
    create_seq = {}
    seq = 2
    for _key, kind, item in steps:
        seq += 1
        if kind == "create":
            create_seq[item["id"]] = seq
    # Each edge lands in the create of whichever end is created later, as a
    # live `item create` with `relations[]` would write it.
    hosted: dict[str, list] = {}
    for src, dst in edges:
        host = src if create_seq[src] > create_seq[dst] else dst
        hosted.setdefault(host, []).append((src, dst))

    events = [
        {"seq": 1, "at": plan.run_at, "actor": ACTOR, "command": "init",
         "items": [], "transition": None,
         "changes": [{"key": "state_root", "before": None,
                      "after": state_root}],
         "note": "perry-kernel-migrate (DESIGN-023 row D): a snapshot of "
                 "the old stores", "warnings": []},
        {"seq": 2, "at": plan.run_at, "actor": ACTOR,
         "command": "template apply", "items": [], "transition": None,
         "changes": [{"key": "template", "before": None,
                      "after": plan.template}],
         "note": None, "warnings": []},
    ]
    for _key, kind, item in steps:
        seq = len(events) + 1
        if kind == "create":
            tdecl = plan.types[item["type"]]
            mine = sorted(hosted.get(item["id"], []),
                          key=lambda e: (id_key(e[0]), id_key(e[1])))
            others = sorted({d if s == item["id"] else s for s, d in mine},
                            key=id_key)
            changes = [{"key": "type", "before": None, "after": item["type"]},
                       {"key": "state", "before": None,
                        "after": tdecl["initial"]}]
            changes += [{"key": f"field:{f}", "before": None, "after": v}
                        for f, v in sorted(item["fields"].items())]
            changes += [{"key": f"rel:blocks:{s}:{d}", "before": False,
                         "after": True} for s, d in mine]
            changes += [{"key": f"attach:{r}", "before": None,
                         "after": {"hash": None}}
                        for r in sorted(item["attachments"])]
            events.append({
                "seq": seq, "at": item["created_at"], "actor": ACTOR,
                "command": "item create", "items": [item["id"]] + others,
                "transition": None, "changes": changes,
                "note": f"from {item['register']}.jsonl; timed by "
                        f"{item['created_note']}", "warnings": []})
        else:
            move = item["move"]
            events.append({
                "seq": seq, "at": move["at"], "actor": ACTOR,
                "command": "item move", "items": [item["id"]],
                "transition": move["transition"],
                "changes": [{"key": "state", "before": move["from"],
                             "after": move["to"]}]
                + [{"key": f"field:{f}", "before": None, "after": v}
                   for f, v in sorted(item["closing"].items())],
                "note": f"status {item['status']!r} in "
                        f"{item['register']}.jsonl; timed by {move['note']}"
                        if item["register"] == "tasks" else
                        f"from {item['register']}.jsonl; timed by "
                        f"{move['note']}",
                "warnings": []})
    seeds = [(p, c) for p, c in sorted(ceilings.items())
             if c["seed"] is not None]
    if seeds:
        events.append({
            "seq": len(events) + 1, "at": plan.run_at, "actor": ACTOR,
            "command": "seed ceilings", "items": [], "transition": None,
            "changes": [{"key": f"ceiling:{p}", "before": c["stored_max"],
                         "after": c["seed"]} for p, c in seeds],
            "note": "the highest id each prefix issued in the old stores and "
                    ".perry/events.jsonl, purged ids included",
            "warnings": []})

    # items.jsonl: the replayed items as the kernel serialises them.
    last = {}
    for e in events:
        for item_id in e["items"]:
            last[item_id] = e
    lines = []
    for item in sorted(plan.items.values(),
                       key=lambda i: (i["prefix"], i["number"])):
        tdecl = plan.types[item["type"]]
        out_edges = sorted((d for s, d in edges if s == item["id"]),
                           key=id_key)
        lines.append({
            "id": item["id"], "type": item["type"], "state": item["state"],
            "fields": {f: {**item["fields"], **item["closing"]}.get(f)
                       for f in tdecl["fields"]},
            "relations": [{"kind": "blocks", "to": d} for d in out_edges],
            "attachments": [{"ref": r, "hash": None}
                            for r in sorted(item["attachments"])],
            "created_at": item["created_at"],
            "updated_at": last[item["id"]]["at"],
            "seq": last[item["id"]]["seq"]})
    items_bytes = "".join(canonical(x) + "\n" for x in lines).encode("utf-8")
    events_bytes = "".join(canonical(e) + "\n" for e in events).encode("utf-8")
    return items_bytes, events_bytes, {"edges": edges, "ceilings": ceilings,
                                       "events": events}


# ── what the old tools already read: references and key-result ids ────────


def kr_id_pattern() -> str:
    """The shape of a key-result id, as the schema declares it for a `kr`
    record of `linkage.jsonl`: `^(?:P\\d{3}-)?O\\d+-KR\\d+$` today, which
    takes both forms `perry-task § _BLOCKS_ID` reads, `O1-KR1` and
    `P003-O2-KR3`. Read through `lib.load_schema`, as `perry-goals` reads it
    to refuse a bad KR id, and never restated here (TASK-489 round 4)."""
    spec = (((((lib.load_schema(Refused).get("stores") or {})
               .get("declared") or {}).get(P.LINKAGE_STORE) or {})
             .get("records") or {}).get("kr") or {})
    pattern = (((spec.get("fields") or {}).get("id") or {}).get("pattern"))
    if not isinstance(pattern, str):
        raise Refused(f"schema/state-schema.json declares no id pattern for a "
                      f"`kr` record of {P.LINKAGE_STORE}, so a key-result id "
                      f"cannot be told from a reference to nothing. Stopped.")
    return pattern


def run_perry_task_asks(project_root: Path) -> dict:
    """`perry-task asks --all --json --root <project>`, the old tool's own
    reading of the User Input Queue, as a subprocess (a tool never imports
    another). It is one of `perry-task`'s read-only commands."""
    argv = [sys.executable, str(PERRY_TASK), "asks", "--all", "--json",
            "--root", str(project_root)]
    env = {k: v for k, v in os.environ.items()
           if k not in ("PERRY_PROJECT", "PERRY_STORE")}
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, env=env,
                              timeout=600)
    except subprocess.TimeoutExpired:
        raise Refused("perry-task asks did not answer within 600 s") from None
    try:
        payload = json.loads(proc.stdout)
    except ValueError:
        payload = None
    if proc.returncode != 0 or not isinstance(payload, dict):
        raise Refused(f"perry-task asks --all --json exited "
                      f"{proc.returncode} with no payload: "
                      f"{proc.stderr.strip()[:300]}")
    return payload


def files_under(*dirs: Path) -> dict:
    """`{path: (size, mtime_ns)}` for every file under `dirs`, `.git`
    skipped: the check that a read wrote nothing."""
    out = {}
    for base in dirs:
        for dirpath, dirnames, filenames in os.walk(base):
            dirnames[:] = [d for d in dirnames if d != ".git"]
            for name in filenames:
                path = os.path.join(dirpath, name)
                try:
                    st = os.lstat(path)
                except OSError:
                    continue
                out[path] = (st.st_size, st.st_mtime_ns)
    return out


def ask_blocks(plan: Plan, project_root: Path, state_root: Path) -> None:
    """Fill `plan.blocks_ids` from `perry-task asks --all --json`.

    Run only when the ask store holds a row, so a project with no asks runs
    nothing. `perry-task` finishes a pending write a crashed command left
    behind before any command, reads included. So the files under the state
    root and `.perry/` are compared before and after the read, and a read
    that changed one stops the import. The payload must cover exactly the
    store's asks, each with its `Blocks` cell and a `blocks_ids` list."""
    asks = plan.stores.get("asks") or []
    if not asks:
        return
    before = files_under(state_root, project_root / ".perry")
    payload = run_perry_task_asks(project_root)
    after = files_under(state_root, project_root / ".perry")
    if before != after:
        changed = sorted(set(before) ^ set(after)
                         | {p for p in set(before) & set(after)
                            if before[p] != after[p]})
        raise Refused(f"perry-task asks changed {len(changed)} file(s) under "
                      f"the project, the first {changed[0]}. The import reads "
                      f"the project and writes nothing there. Stopped.",
                      {"changed": changed})
    rows = payload.get("asks")
    if not isinstance(rows, list) or not all(
            isinstance(r, dict) and isinstance(r.get("blocks_ids"), list)
            for r in rows):
        raise Refused("perry-task asks --all --json carries no `blocks_ids` "
                      "list for each ask, so no reader splits a Blocks cell. "
                      "Stopped.")
    got = {r.get("id"): r for r in rows}
    stored = {r["id"]: r for r in asks}
    if set(got) != set(stored) or any(
            (got[i].get("blocks") or "") != (stored[i].get("blocks") or "")
            for i in stored):
        raise Refused("perry-task asks and the ask store disagree about the "
                      "asks or their Blocks cells. Stopped.",
                      {"payload": sorted(map(str, got)),
                       "store": sorted(stored)})
    for ask_id, row in got.items():
        plan.blocks_ids[ask_id] = list(row["blocks_ids"])
        if not row["blocks_ids"] and not blank(stored[ask_id].get("blocks")):
            plan.blocks_without_ids.append(ask_id)


# ── the kernel, always on the named temporary store ───────────────────────


def kernel(words, data, *, store: Path, anchor: Path, dry_run=False) -> dict:
    """One `bin/perry-kernel` call, with `--store` and `--root` named, and
    `PERRY_KERNEL_TESTING` set so that a call that somehow lost its `--store`
    is refused rather than derived to the shared store (§ 5.7)."""
    argv = [sys.executable, str(KERNEL), *words, "--store", str(store),
            "--root", str(anchor)]
    if data is not None:
        argv += ["--input", "-"]
    if dry_run:
        argv.append("--dry-run")
    env = {k: v for k, v in os.environ.items()
           if k not in ("PERRY_STORE", "PERRY_PROJECT")}
    env["PERRY_KERNEL_TESTING"] = "1"
    try:
        proc = subprocess.run(argv, input=json.dumps(data) if data is not None
                              else "", capture_output=True, text=True,
                              env=env, timeout=1800)
    except subprocess.TimeoutExpired:
        raise Refused(f"perry-kernel {' '.join(words)} did not answer within "
                      f"1800 s") from None
    try:
        envelope = json.loads(proc.stdout)
    except ValueError:
        raise Refused(f"perry-kernel {' '.join(words)} printed no envelope "
                      f"(exit {proc.returncode}): "
                      f"{proc.stderr.strip()[:300]}") from None
    if not isinstance(envelope, dict) or "ok" not in envelope:
        raise Refused(f"perry-kernel {' '.join(words)} printed JSON that is "
                      f"not an envelope (exit {proc.returncode})")
    envelope["exit"] = proc.returncode
    return envelope


def probe_fields(tdecl: dict) -> dict:
    """The fields a create guard requires, filled, so `item create --dry-run`
    reaches the mint. The values are never stored: the create rolls back."""
    need = []
    for guard in tdecl.get("create_guards", []):
        if guard["kind"] == "required":
            need += guard.get("fields", [])
    out = {}
    for name in need:
        decl = tdecl["fields"][name]
        out[name] = (decl["values"][0] if decl["kind"] == "enum"
                     else "ceiling probe")
    return out


# ── the run ────────────────────────────────────────────────────────────────


def check_work(work: Path, project_root: Path) -> None:
    if ".git" in work.parts:
        raise Refused(f"--work {work} is inside a .git directory, where the "
                      f"kernel's shared store lives. Name a scratch directory.")
    if work == project_root or project_root in work.parents:
        raise Refused(f"--work {work} is inside the project {project_root}; "
                      f"nothing is written there. Name a scratch directory.")
    if work in project_root.parents:
        raise Refused(f"--work {work} holds the project {project_root}; "
                      f"name an empty scratch directory.")
    if work.exists() and (not work.is_dir() or any(work.iterdir())):
        raise Refused(f"--work {work} is not an empty directory; the import "
                      f"needs an empty store, and nothing there is replaced.")


def planned(project_root: Path, work) -> tuple:
    """Read the old stores and build the export in memory. Writes nothing."""
    if not (project_root / ".perry").is_dir():
        raise Refused(f"{project_root} holds no .perry/; it is not a Perry "
                      f"project")
    if work is not None:
        check_work(work, project_root)
    state_root = Path(P.resolve_state_root(project_root)).resolve()
    rel = state_root.relative_to(project_root).as_posix()
    template = json.loads(TEMPLATE.read_text(encoding="utf-8"))
    for spec in MAPPING.values():
        if spec["type"] not in template["types"]:
            raise Refused(f"{TEMPLATE} declares no type {spec['type']}")
    stores, events = read_old(project_root, state_root)
    # The run's own time, through the one clock and the one converter.
    plan = Plan(template, stores, events, moment(lib.event_stamp()))
    for register in MAPPING:
        for rec in stores.get(register, []):
            plan.add(register, rec)
    plan.kr_pattern = kr_id_pattern()
    ask_blocks(plan, project_root, state_root)
    items_bytes, events_bytes, built = build_export(plan, rel)
    return plan, rel, items_bytes, events_bytes, built


def plan_only(project_root: Path) -> dict:
    """The default with no `--work`: what the import would carry, drop and
    seed, read from the old stores and written nowhere (DESIGN-016 C3: a
    flag-only tool does its documented default)."""
    project_root = project_root.resolve()
    plan, rel, items_bytes, events_bytes, built = planned(project_root, None)
    return {"project": str(project_root), "state_root": rel, "work": None,
            "planned_only": True,
            "old": old_side(plan, plan.stores, plan.events),
            "mapping": mapping_side(plan, built),
            "ceilings": built["ceilings"],
            "export": {"items_bytes": len(items_bytes),
                       "events_bytes": len(events_bytes)},
            "criteria": {}, "reconciled": None}


def run(project_root: Path, work: Path) -> dict:
    project_root = project_root.resolve()
    plan, rel, items_bytes, events_bytes, built = planned(project_root, work)
    stores, events = plan.stores, plan.events

    anchor = work / "anchor"
    store = work / "store.db"
    export = anchor / rel / "export"
    (anchor / ".perry").mkdir(parents=True)
    export.mkdir(parents=True)
    (export / "items.jsonl").write_bytes(items_bytes)
    (export / "events.jsonl").write_bytes(events_bytes)

    def call(words, data, **kw):
        return kernel(words, data, store=store, anchor=anchor, **kw)

    imported = call(["import"], {"state_root": rel})
    report = {
        "project": str(project_root), "state_root": rel, "work": str(work),
        "anchor": str(anchor), "store": str(store), "export": str(export),
        "old": old_side(plan, stores, events),
        "mapping": mapping_side(plan, built),
        "ceilings": built["ceilings"],
        "import": {"exit": imported["exit"], "ok": imported["ok"],
                   "result": imported["result"], "error": imported["error"]},
    }
    if not imported["ok"]:
        err = imported["error"] or {}
        seq = (err.get("details") or {}).get("seq")
        if isinstance(seq, int) and 1 <= seq <= len(built["events"]):
            report["import"]["event_items"] = built["events"][seq - 1]["items"]
        report["criteria"] = {}
        report["not_reconciled_because"] = [
            f"the kernel refused the import: {err.get('code')}"]
        report["reconciled"] = False
        return report
    report["kernel"], report["criteria"] = reconcile(plan, call, rel)
    why = [f"criterion {name} failed"
           for name, held in report["criteria"].items() if not held]
    if plan.unresolved:
        why.append(f"{len(plan.unresolved)} reference(s) resolve to no "
                   f"imported id")
    if report["kernel"]["errors"]:
        why.append(f"{len(report['kernel']['errors'])} kernel call(s) "
                   f"refused during reconciliation")
    report["not_reconciled_because"] = why
    report["reconciled"] = not why
    return report


def old_side(plan: Plan, stores: dict, events: list) -> dict:
    by_type: dict = {}
    for item in plan.items.values():
        t = by_type.setdefault(item["type"], {})
        t[item["state"]] = t.get(item["state"], 0) + 1
    return {"records": {r: len(stores.get(r, [])) for r in
                        ("tasks", "asks", "risks", "intake", "cadence")},
            "by_type_and_state": by_type, "events": len(events),
            "ids": len(plan.items)}


def mapping_side(plan: Plan, built: dict) -> dict:
    return {**plan.counts,
            "relations": len(built["edges"]),
            "attachments": sum(len(i["attachments"])
                               for i in plan.items.values()),
            "moves": sum(1 for i in plan.items.values() if i["move"]),
            "unresolved_references": plan.unresolved,
            "for_task_492": plan.for_task_492,
            "blocks_cells_with_no_id": plan.blocks_without_ids,
            "self_edges": plan.self_edges,
            "unset_cells": plan.unset,
            "clamped_moves": plan.clamped,
            "open_next_action_over_300_bytes": plan.long_open_cells,
            "export_events": len(built["events"])}


def reconcile(plan: Plan, call, rel: str) -> tuple[dict, dict]:
    """DESIGN-023 row D's criteria 1–5, asked of the kernel store.

    A kernel call here that is refused, or that prints no envelope, is
    reported under `kernel.errors`, and the criterion it serves fails. The
    run is then "not reconciled" and says why; nothing raises, so no
    traceback is printed (TASK-489 round 3, item 5)."""
    errors: list[dict] = []
    kernel_side: dict = {"errors": errors}
    criteria: dict = {}

    def attempt(words, data, **kw):
        """The envelope, or `None` after recording why there is none."""
        try:
            got = call(words, data, **kw)
        except Refused as exc:
            errors.append({"command": " ".join(words), "exit": None,
                           "code": None, "message": str(exc)})
            return None
        return got

    def ask(words, data, **kw):
        """The envelope of a call that must succeed, or `None` after
        recording the kernel's refusal."""
        got = attempt(words, data, **kw)
        if got is not None and not got["ok"]:
            err = got["error"] if isinstance(got.get("error"), dict) else {}
            errors.append({"command": " ".join(words), "exit": got["exit"],
                           "code": err.get("code"),
                           "message": err.get("message")})
            return None
        return got

    counted = ask(["query"], {"count_by": ["type", "state"], "limit": 1})
    got = None
    if counted is not None:
        got = {}
        for row in counted["result"]["counts"]:
            t = got.setdefault(row["key"]["type"], {})
            t[row["key"]["state"]] = row["n"]
    kernel_side["by_type_and_state"] = got
    criteria["1_counts_per_type_and_state"] = got is not None and (
        got == old_side(plan, plan.stores, plan.events)["by_type_and_state"])

    ids = sorted(plan.items, key=id_key)
    found = ask(["query"], {"ids": ids, "limit": 0})
    resolved = ({i["id"]: i["type"] for i in found["result"]["items"]}
                if found is not None else {})
    missing = [i for i in ids if resolved.get(i) != plan.items[i]["type"]]
    kernel_side["ids"] = {"asked": len(ids), "resolved": len(resolved),
                          "missing_or_wrong_type": missing}
    criteria["2_every_old_id_resolves"] = (
        found is not None and not missing and len(ids) == len(resolved))

    nexts, above = {}, True
    issued = plan.ceilings()
    for type_name, tdecl in sorted(plan.types.items()):
        r = ask(["item", "create"], {"actor": ACTOR, "type": type_name,
                                     "fields": probe_fields(tdecl)},
                dry_run=True)
        minted = r["result"]["item"]["id"] if r is not None else None
        ceiling = issued[tdecl["prefix"]]["issued_max"]
        ok = minted is not None and (ceiling is None
                                     or id_key(minted)[1] > ceiling)
        nexts[tdecl["prefix"]] = {"next_id": minted, "issued_max": ceiling,
                                  "above": ok}
        above = above and ok
    kernel_side["next_ids"] = nexts
    criteria["3_next_id_above_every_issued_id"] = above

    # The one call whose refusal is the answer wanted: it is not an error.
    again = attempt(["import"], {"state_root": rel})
    code = ((again.get("error") or {}).get("code")
            if again is not None else None)
    kernel_side["second_import"] = ({"exit": again["exit"], "code": code}
                                    if again is not None else None)
    criteria["4_import_refuses_a_store_that_is_not_empty"] = (
        again is not None and again["exit"] == 1
        and code == "store_not_empty")

    exported = ask(["export"], None)
    tail = ask(["events"], {"limit": 1})
    kernel_side["export"] = ({"effect": exported["effect"]}
                             if exported is not None else None)
    kernel_side["events"] = ({"total": tail["result"]["total"],
                              "unexported": tail["result"]["unexported"]}
                             if tail is not None else None)
    criteria["5_replay_reproduces_the_items"] = (
        exported is not None and exported["effect"] == "unchanged")
    return kernel_side, criteria


# ── the command line ───────────────────────────────────────────────────────


def summary(report: dict) -> str:
    lines = [f"perry-kernel-migrate: {report['project']} "
             f"(state root {report['state_root']})"]
    if report.get("planned_only"):
        lines.append(f"  plan only: no --work, so nothing was written; the "
                     f"export would hold {report['mapping']['export_events']} "
                     f"events for {report['old']['ids']} items")
        lines.append(f"  old by type and state: "
                     f"{canonical(report['old']['by_type_and_state'])}")
        lines.append("  ceilings: " + ", ".join(
            f"{p} issued up to {c['issued_max']}"
            for p, c in report["ceilings"].items()))
    else:
        lines += [f"  store  {report['store']}", f"  export {report['export']}"]
        imp = report["import"]
        if not imp["ok"]:
            lines.append(f"  import refused: {imp['error']['code']}: "
                         f"{imp['error']['message']}")
            if imp.get("event_items"):
                lines.append(f"  the event names "
                             f"{', '.join(imp['event_items'])}")
            return "\n".join(lines)
        for name, value in report["criteria"].items():
            lines.append(f"  {'PASS' if value else 'FAIL'}  {name}")
        unresolved = report["mapping"]["unresolved_references"]
        if unresolved:
            lines.append(f"  FAIL  {len(unresolved)} reference(s) resolve to "
                         f"no imported id: " + ", ".join(
                             f"{u['id']} {u['field']} {u['ref']}"
                             for u in unresolved))
        for err in report["kernel"]["errors"]:
            lines.append(f"  FAIL  the kernel refused {err['command']}: "
                         f"{err['code'] or 'no envelope'}: {err['message']}")
        lines.append("  reconciled" if report["reconciled"]
                     else "  NOT reconciled")
        lines.append(f"  old by type and state: "
                     f"{canonical(report['old']['by_type_and_state'])}")
        lines.append(f"  next ids: " + ", ".join(
            f"{p} {v['next_id']} (issued up to {v['issued_max']})"
            for p, v in report["kernel"]["next_ids"].items()))
    m = report["mapping"]
    if report.get("planned_only") and m["unresolved_references"]:
        lines.append(f"  references that resolve to no imported id, which "
                     f"the import would report as not reconciled: " +
                     ", ".join(f"{u['id']} {u['field']} {u['ref']}"
                               for u in m["unresolved_references"]))
    if m["blocks_cells_with_no_id"]:
        lines.append(f"  Blocks cells perry-task reads no id from, not "
                     f"carried: " + ", ".join(m["blocks_cells_with_no_id"]))
    if m["for_task_492"]:
        lines.append(f"  for TASK-492, key results that are not kernel items "
                     f"yet: " + ", ".join(f"{u['id']} {u['field']} {u['ref']}"
                                          for u in m["for_task_492"]))
    lines.append(f"  answers carried: {canonical(m['answers'])}; reasons "
                 f"carried: {canonical(m['reasons'])}; status text no field "
                 f"carries: {canonical(m['status_not_carried'])}")
    lines.append(f"  skipped next_action on closed tasks: "
                 f"{canonical(m['skipped_next_action'])}")
    lines.append(f"  dropped fields, populated rows: {canonical(m['dropped'])}")
    lines.append(f"  cells that said nothing, not imported: "
                 f"{canonical(m['unset_cells'])}")
    lines.append(f"  moves clamped to their create: {len(m['clamped_moves'])}")
    lines.append(f"  open next_action cells over {LONG_CELL_BYTES} bytes: "
                 f"{len(m['open_next_action_over_300_bytes'])}")
    return "\n".join(lines)


def main(argv: list[str]) -> int:
    read = lib.parse_surface(SURFACE, argv)
    if read["help"]:
        print(lib.usage_lines(SURFACE))
        print()
        print(__doc__.strip())
        return 0
    if read["describe"]:
        print(json.dumps(lib.describe_surface(SURFACE), ensure_ascii=False,
                         indent=2))
        return 0
    if read["error"]:
        print(f"perry-kernel-migrate: {read['error']}", file=sys.stderr)
        return 2
    if read["extra"]:
        print(f"perry-kernel-migrate: takes no argument, got "
              f"{read['extra'][0]!r}", file=sys.stderr)
        return 2
    work = read["values"].get("--work")
    if work is not None and not work.strip():
        print("perry-kernel-migrate: --work was given an empty value; name a "
              "scratch directory", file=sys.stderr)
        return 2
    as_json = "--json" in read["seen"]
    try:
        project_root = lib.resolve_project_root(read["values"].get("--root"))
        if work is None:
            report = plan_only(project_root)
            print(json.dumps(report, ensure_ascii=False, indent=2) if as_json
                  else summary(report))
            return 0
        report = run(project_root, Path(work).expanduser().resolve())
    except Refused as exc:
        if as_json:
            print(json.dumps({"reconciled": False, "refused": str(exc),
                              "details": exc.details}, ensure_ascii=False,
                             indent=2))
        print(f"perry-kernel-migrate: refused — {exc}", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"perry-kernel-migrate: refused — {exc.strerror or exc}: "
              f"{exc.filename or ''}", file=sys.stderr)
        return 1
    print(json.dumps(report, ensure_ascii=False, indent=2) if as_json
          else summary(report))
    return 0 if report["reconciled"] else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
