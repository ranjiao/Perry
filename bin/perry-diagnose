#!/usr/bin/env python3
"""
perry-diagnose — the deterministic read of how a project is *structured* for
agent work, as opposed to what its Perry state says.

`perry-state` answers "what does this project's board say?" and only works on
an adopted project. This script answers "is this project's working structure
sound?" and works on any folder, including one that has never heard of Perry.

It measures three things, matching the three failure modes in
`reference/project-archetypes.md`:

  1. context load  — what is loaded into every session, and whether it fits
     the budget;
  2. document graph — what exists, what is reachable, what duplicates what;
  3. tracking spine — whether goals, decisions, and a runnable check exist.

Plus the archetype signals, so the interview starts from evidence instead of
from a blank slate.

No LLM, no external dependencies (stdlib only), read-only, never writes.
Exit 0 always, even on an empty folder — an absent signal is a finding, not an
error.

Usage:
  perry-diagnose [--root <project_root>] [--json | --text] [--max-files N]

  --json        full payload (default)
  --text        human-readable summary
  --root        project root; default $PERRY_PROJECT, else cwd
  --max-files   walk cap, default 20000 (guards against a vendored monorepo)

Every threshold this script applies is a *calibrated default*, not a measured
law — see `reference/project-archetypes.md § Part 5`. They are emitted in the
payload under `thresholds` so the caller can show the user what it judged by.
"""

from __future__ import annotations

import fnmatch
import json
import os
import re
import subprocess
import sys
import textwrap
from datetime import date, datetime
from pathlib import Path

HERE = Path(__file__).resolve().parent
PERRY_HOME = Path(os.environ.get("PERRY_HOME") or HERE.parent).resolve()

sys.path.insert(0, str(PERRY_HOME / "viewer"))
from tables import split_row, squash  # noqa: E402

# ── thresholds (calibrated defaults; see project-archetypes.md § Part 5) ──

THRESHOLDS = {
    "tier0_total_lines": 200,       # all always-loaded files combined
    "single_doc_lines": 500,        # one doc that big is a tier problem
    "stale_spine_days": 30,         # goal spine untouched this long
    "orphan_ratio_warn": 0.30,      # share of docs reachable from nothing
    "doc_count_index_required": 12, # past this, an index is not optional
    "moc_note_threshold": 200,      # KB: add Maps of Content past this
    "id_lookup_required": 12,       # past this many IDs, the user needs a lookup
    "open_decisions_warn": 5,       # decisions queued on the user at once
}

# Files an agent host loads unconditionally at the project root.
TIER0_NAMES = [
    "CLAUDE.md",
    "AGENTS.md",
    "AGENT.md",
    "GEMINI.md",
    "CONVENTIONS.md",
    ".cursorrules",
    ".clinerules",
    ".windsurfrules",
]
TIER0_GLOBS = [
    ".github/copilot-instructions.md",
    ".cursor/rules/*.md",
    ".cursor/rules/*.mdc",
]

SKIP_DIRS = {
    ".git", "node_modules", ".venv", "venv", "env", "__pycache__", "dist",
    "build", "target", ".next", ".nuxt", ".cache", "vendor", "site-packages",
    ".pytest_cache", ".mypy_cache", ".ruff_cache", "coverage", ".tox",
    ".gradle", "Pods", "DerivedData", ".terraform", "bower_components",
    ".claude", ".agents", ".trae",
}


def is_nested_repo(d: Path) -> bool:
    """A directory carrying its own `.git` is a different project.

    Skipping by name never finishes: a vendored checkout, a submodule, a
    sibling repo dropped in by accident, and an agent worktree are all the same
    shape and only some of them have predictable names. This was found when
    `perry-diagnose` reported a dangling id that existed in no file of this
    repo — it was reading a subagent's half-written `bin/perry-task` from a
    worktree under `.claude/`, so Perry's own diagnostics were non-deterministic
    for as long as another agent was running.

    `.git` is a directory in a clone and a FILE in a worktree; both count.
    """
    return (d / ".git").exists()

CODE_EXT = {
    ".py", ".ts", ".tsx", ".js", ".jsx", ".go", ".rs", ".java", ".kt", ".rb",
    ".php", ".c", ".h", ".cc", ".cpp", ".hpp", ".cs", ".swift", ".m", ".mm",
    ".scala", ".ex", ".exs", ".sh", ".bash", ".zsh", ".lua", ".r", ".jl",
}

MANIFESTS = [
    "package.json", "pyproject.toml", "setup.py", "requirements.txt",
    "go.mod", "Cargo.toml", "Gemfile", "pom.xml", "build.gradle",
    "composer.json", "Makefile", "CMakeLists.txt",
]

SPINE_NAMES = [
    "OKR.md", "GOALS.md", "OBJECTIVES.md", "ROADMAP.md", "PLAN.md",
    "STATE.md", "PROJECT_STATE.md", "STATUS.md", "BOARD.md", "TASKS.md",
    "TODO.md", "TODOS.md", "BACKLOG.md", "index.md", "INDEX.md",
]
SPINE_DIRS = ["phase", "phases", "specs", "sprints", "milestones"]

DECISION_NAMES = ["DECISIONS.md", "ADR.md", "CHANGELOG.md"]
DECISION_DIRS = ["decisions", "adr", "adrs", "docs/adr", "docs/decisions", "rfcs"]

INDEX_NAMES = {"index.md", "readme.md", "index", "_index.md", "moc.md", "map.md"}

APPEND_ONLY_HINTS = ["journal", "log.md", "logs", "daily", "diary", "weekly"]

RAW_DIR_HINTS = ["raw", "sources", "clippings", "inbox", "imports", "attachments"]
KB_DIR_HINTS = ["wiki", "notes", "vault", "zettel", "permanent", "literature",
                "areas", "resources", "projects", "knowledge"]
OPS_DIR_HINTS = ["runbooks", "runbook", "incidents", "playbooks", "briefs",
                 "drafts", "posts", "content", "reports", "meetings"]

# A path-ish token: has a separator or a known doc/code extension.
PATHISH = re.compile(r"^[\w.@+-]+(?:/[\w.@+-]+)+/?$")
MD_LINK = re.compile(r"\[[^\]]*\]\(([^)\s]+)\)")
BACKTICK = re.compile(r"`([^`\n]{2,120})`")
WIKILINK = re.compile(r"\[\[([^\]|#]+)")
H1 = re.compile(r"^#\s+(.+?)\s*$", re.M)


# ── helpers ───────────────────────────────────────────────────────────────


def run_git(root: Path, *args: str) -> str:
    try:
        out = subprocess.run(
            ["git", *args],
            cwd=str(root),
            capture_output=True,
            text=True,
            timeout=15,
        )
        return out.stdout if out.returncode == 0 else ""
    except Exception:
        return ""


def is_script(path: Path) -> bool:
    try:
        with path.open("rb") as fh:
            return fh.read(2) == b"#!"
    except OSError:
        return False


def line_count(path: Path) -> int:
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            return sum(1 for _ in fh)
    except OSError:
        return 0


def read_text(path: Path, cap: int = 400_000) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")[:cap]
    except OSError:
        return ""


def days_since_mtime(path: Path) -> int | None:
    try:
        then = datetime.fromtimestamp(path.stat().st_mtime).date()
    except OSError:
        return None
    return (date.today() - then).days


def norm_title(s: str) -> str:
    return re.sub(r"[^a-z0-9]+", " ", s.lower()).strip()


ROUTED_DIRS = ("skills", "agents", "commands", "prompts")


def is_routed(root: Path, rel: str) -> bool:
    """True for a tier-1 document the host discovers on its own.

    A `SKILL.md` is reached through its frontmatter `description`, not through
    a link from an index. Progressive disclosure IS its routing, so it is
    reachable by construction — and it is the *fix* for document sprawl rather
    than a case of it."""
    p = Path(rel)
    if p.name.upper() == "SKILL.MD":
        return True
    if any(part.lower() in ROUTED_DIRS for part in p.parts[:-1]):
        head = read_text(root / rel, cap=600).lstrip()
        if head.startswith("---") and re.search(
                r"^\s*description\s*:", head, re.M):
            return True
    return False


def load_sibling(name: str):
    """Import an extensionless script from bin/ as a module.

    Used so the ID scan below shares `perry-explain`'s single implementation
    rather than carrying a second copy of it — the same rule `schema/README.md`
    applies to state parsing."""
    import importlib.util
    from importlib.machinery import SourceFileLoader

    path = HERE / name
    loader = SourceFileLoader(name.replace("-", "_"), str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


#: An inline code span or a fenced line. Content inside one is being QUOTED.
CODE_SPAN = re.compile(r"`[^`]*`|^\s{4,}\S.*$", re.M)

OPEN_DECISION = re.compile(r"\bTBD\b|\bundecided\b|\(decide\)|\bawaiting (?:your )?(?:input|decision)\b", re.I)

# A `TBD` that a template DECLARES as a legal value is not a decision anybody is
# waiting on. `state/design_TEMPLATE.md` writes `Implementation owner: <role or
# "TBD">` in the header of every design doc, so counting it queues three
# imaginary decisions on the user for every three designs they write — and
# LOAD-03 exists to measure the real queue, not to inflate it.
# Matched anywhere in the line, not anchored: the design header packs several
# fields onto one line (`> Author: X   · Implementation owner: TBD`), so the
# declared field is rarely the first thing on it.
DECLARED_TBD = re.compile(
    r"(?:Implementation owner|Deciders?|Sunset|Locked|Superseded by|Supersedes|"
    r"Linked OKR|Drop reason)\s*:\s*(?:TBD|undecided)\b", re.I)



# A USER- row that has been answered is not a decision waiting on anyone. The
# first version of this counted every `USER-` id that appeared in a tracking
# doc, regardless of its Status cell — so a project that answered its questions
# but had not yet swept the rows kept reporting them as an open backlog, and
# LOAD-03 measured "USER rows that have ever existed" while claiming to measure
# "open questions waiting on you". Sweeping answered rows is `triage`'s job and
# is optional; being counted as blocked for not doing it is not.
ANSWERED = re.compile(
    r"\b(answered|resolved|closed|done|decided|已回答|已解决|已决定)\b", re.I)


def count_unanswered_user_asks(root: Path, entries: dict) -> int:
    """USER- asks with no answer recorded in their own row.

    Falls back to the id-index count when no User Input Queue table can be
    read, so a project that tracks asks somewhere else is not silently
    reported as having none.
    """
    ids = {e["id"] for e in entries.values()
           if e["id"].startswith("USER-") and e.get("in_tracking_doc")}
    if not ids:
        return 0
    board = root / "BOARD.md"
    if not board.exists():
        for alt in root.glob("*/BOARD.md"):
            board = alt
            break
    if not board.exists():
        return len(ids)

    answered = set()
    seen_table = False
    try:
        text = board.read_text(errors="replace")
    except OSError:
        return len(ids)
    in_section = False
    for line in text.split("\n"):
        if line.startswith("## "):
            in_section = bool(re.match(r"##\s+(User Input Queue|用户输入队列)", line))
            continue
        if not in_section or not line.strip().startswith("|"):
            continue
        seen_table = True
        m = re.search(r"\bUSER-\d+\b", line)
        if m and ANSWERED.search(line):
            answered.add(m.group(0))
    if not seen_table:
        return len(ids)
    return len(ids - answered)


def scan_user_load(root: Path, inventory: dict, docs: dict, is_perry: bool) -> dict:
    """How much this project asks a *human* to hold in their head.

    The agent has perfect recall of every ID it ever minted and can reason
    about any subsystem on demand. The user has neither, and the project is
    theirs. So the binding constraint on an agent-run project is usually not
    the agent's capability — it is how much the person can look up, absorb, and
    decide. This measures that surface."""
    try:
        explain = load_sibling("perry-explain")
        entries = explain.harvest(root)
    except Exception:
        return {"available": False}

    # Only count an undefined ID when a *tracking* document relies on it.
    # Documentation and templates are full of illustrative IDs — `tag your task
    # like TASK-007` refers to nothing and is not supposed to. Without this,
    # running against Perry's own repo produced 25 findings, 21 of them noise.
    dangling = sorted(e["id"] for e in entries.values()
                      if not e["defined"] and e.get("in_tracking_doc"))
    untitled = sorted(e["id"] for e in entries.values()
                      if e["defined"] and not e["title"]
                      and e.get("in_tracking_doc"))

    # Does one document resolve most of the IDs, or are definitions scattered
    # across the whole tree with nowhere to look them up?
    by_file: dict[str, int] = {}
    for e in entries.values():
        if e["defined"]:
            by_file[e["defined"].split(":")[0]] = by_file.get(e["defined"].split(":")[0], 0) + 1
    defined_n = sum(by_file.values())
    best = max(by_file.values(), default=0)
    concentrated = bool(defined_n) and best / defined_n >= 0.6

    # A lookup exists if one doc covers most IDs, or the project ships a
    # resolver (Perry does — `bin/perry-explain`).
    has_resolver = is_perry or any(
        (root / d / "perry-explain").is_file() for d in ("bin", "scripts", "tools")
    )

    # Same illustrative filter as the ID scan: a skill file explaining that a
    # decision column starts life as `TBD` is documentation, not a decision
    # anyone is waiting on. Perry's own repo produced 14 of these before the
    # filter and 0 after.
    open_decisions = 0
    samples: list[str] = []
    # A `TBD` inside `## Implementation plan` is not queued on the user. That
    # section is a plan and its unknowns are resolved by doing the work — the
    # common form is a task-id column reading `TBD at handoff`, which waits on
    # the handoff, not on a person. The section that DOES queue decisions on
    # the user is `## User Decisions`, which has its own `Chosen` column.
    #
    # Found when a 402-line design doc written in a parallel session put six of
    # them in one table and tripped LOAD-03 on this repo. LOAD-03 measures the
    # real queue; a check that counts every planning placeholder trains the
    # user to ignore it, which is the failure `reference/diagnose.md` names.
    PLAN_SECTION = re.compile(r"^#{1,3}\s*(?:\d+\.\s*)?Implementation plan\b", re.I)
    for rel in inventory["md"]:
        if explain.is_illustrative(rel):
            continue
        in_plan = False
        for n, line in enumerate(read_text(root / rel, cap=200_000).splitlines(), 1):
            if line.startswith("#"):
                in_plan = bool(PLAN_SECTION.match(line))
            if in_plan:
                continue
            # **A marker inside a code span is a quotation, not a decision.**
            # Four review documents quote `{'', '-', 'n/a', 'tbd', '无'}` —
            # the tool's own empty-cell set — while reporting on it, and each
            # mention was counted as a decision queued on the user. Perry
            # tripped its own `LOAD-03` on documents whose subject was that
            # very set.
            #
            # The same shape as `perry-lint`'s module-docstring false positive
            # and `field_re`'s: a scanner that reports prose quoting the thing
            # it looks for. A guard that fires on documentation about itself is
            # one people switch off.
            bare = CODE_SPAN.sub("", DECLARED_TBD.sub("", line))
            if OPEN_DECISION.search(bare):
                open_decisions += 1
                if len(samples) < 8:
                    samples.append(f"{rel}:{n}")
    open_decisions += count_unanswered_user_asks(root, entries)

    return {
        "available": True,
        "total_ids": len(entries),
        "dangling": dangling,
        "untitled": untitled,
        "definitions_concentrated": concentrated,
        "has_resolver": has_resolver,
        "open_decisions": open_decisions,
        "open_decision_samples": samples,
    }


def perry_owned_globs() -> list[str]:
    """Paths Perry itself declares as state files, read from the schema so this
    script does not carry a second copy of that list.

    They matter twice over: a Perry state file is reachable *by convention*
    rather than by a link, so it is not an orphan; and Perry's own directory
    names (`knowledge/`, `design/`, `phase/`) must not be read as evidence of
    what kind of project this is."""
    globs = [
        # Fallback, used when the schema is unreadable (tarball install, etc).
        "BOARD.md", "OKR.md", "DECISIONS.md", "PROJECT_STATE.md",
        "ARCHITECTURE.md", "phase/*", "design/*", "runbook/*", ".perry/*",
    ]
    schema = PERRY_HOME / "schema" / "state-schema.json"
    try:
        declared = json.loads(read_text(schema)).get("files", [])
        found = [f["path"] for f in declared if f.get("path")]
        if found:
            globs = found
    except Exception:
        pass
    # Directories Perry writes into that the schema does not enumerate as a
    # single file glob.
    globs += [
        "journal/*", "journal/*/*", "evidence/*", "evidence/*/*", "weekly/*",
        "handoff/*", "knowledge/*", "knowledge/*/*", "inputs/*", "decisions/*",
        "phase/snapshots/*", ".perry/*", ".perry/*/*",
    ]
    return globs


PERRY_DIR_NAMES = {
    "phase", "journal", "evidence", "weekly", "handoff", "knowledge",
    "inputs", "decisions", "design", "runbook", "snapshots",
}

# Directories whose contents describe what a project *ships* rather than what
# it *is*. A repo with `templates/knowledge-base/raw/` is not a knowledge base;
# it is a tool that scaffolds one. Perry misread itself exactly this way.
EXAMPLE_DIR_NAMES = {
    "templates", "template", "examples", "example", "fixtures", "fixture",
    "samples", "sample", "scaffold", "scaffolds", "boilerplate", "testdata",
    "__fixtures__", "stubs",
}


def resolve_state_root(root: Path) -> Path:
    """Mirror of viewer/parsers.py § resolve_state_root, kept minimal so this
    script has no import dependency on the viewer. A state root that escapes
    the project is ignored rather than honoured."""
    cfg = root / ".perry" / "config.md"
    if not cfg.is_file():
        return root
    m = re.search(r"^\s*[-*]?\s*State root:\s*(.+?)\s*$", read_text(cfg), re.M | re.I)
    if not m:
        return root
    raw = m.group(1).strip().strip("`")
    if not raw or raw == ".":
        return root
    try:
        cand = (root / raw).resolve()
        cand.relative_to(root.resolve())
    except (ValueError, OSError):
        return root
    return cand if cand.is_dir() else root


# ── the walk ──────────────────────────────────────────────────────────────


def walk(root: Path, max_files: int) -> dict:
    md, code, other, dirs = [], {}, 0, set()
    seen = 0
    truncated = False
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames
                       if d not in SKIP_DIRS and not d.startswith(".claude-")
                       and not is_nested_repo(Path(dirpath) / d)]
        rel_dir = Path(dirpath).relative_to(root)
        if str(rel_dir) != ".":
            dirs.add(str(rel_dir))
        for fn in filenames:
            seen += 1
            if seen > max_files:
                truncated = True
                break
            p = Path(dirpath) / fn
            rel = str(p.relative_to(root))
            suf = p.suffix.lower()
            if suf in (".md", ".markdown", ".mdc"):
                md.append(rel)
            elif suf in CODE_EXT:
                code[suf] = code.get(suf, 0) + 1
            elif not suf and is_script(p):
                # Extensionless executables with a shebang — a CLI-tool repo's
                # source is invisible without this, and the archetype guess
                # then reads it as a docs pile.
                code["(script)"] = code.get("(script)", 0) + 1
            else:
                other += 1
        if truncated:
            break
    return {
        "md": sorted(md),
        "code_by_ext": code,
        "code_total": sum(code.values()),
        "other_files": other,
        "dirs": sorted(dirs),
        "truncated": truncated,
    }


# ── context load (tier 0) ─────────────────────────────────────────────────


def scan_context_load(root: Path, inventory: dict) -> dict:
    files, conditional = [], []
    for name in TIER0_NAMES:
        p = root / name
        if p.is_file():
            files.append({
                "path": name,
                "lines": line_count(p),
                "symlink": p.is_symlink(),
                "target": os.readlink(p) if p.is_symlink() else None,
            })
    for pattern in TIER0_GLOBS:
        for p in sorted(root.glob(pattern)):
            if p.is_file():
                files.append({
                    "path": str(p.relative_to(root)),
                    "lines": line_count(p),
                    "symlink": p.is_symlink(),
                    "target": os.readlink(p) if p.is_symlink() else None,
                })
    # Nested host files load only when work touches their directory.
    for rel in inventory["md"]:
        base = Path(rel).name
        if base in ("CLAUDE.md", "AGENTS.md") and "/" in rel:
            conditional.append({"path": rel, "lines": line_count(root / rel)})

    total = sum(f["lines"] for f in files)
    return {
        "always_loaded": files,
        "always_loaded_lines": total,
        "budget_lines": THRESHOLDS["tier0_total_lines"],
        "over_budget_by": max(0, total - THRESHOLDS["tier0_total_lines"]),
        "conditional": conditional,
    }


def broken_refs(root: Path, rel: str) -> list[str]:
    """Path-like tokens in a doc that no longer resolve.

    Deliberately conservative, because a false positive here is expensive: a
    diagnostic that cries wolf trains the user to ignore it, which is the
    failure mode this whole skill exists to prevent. Two restrictions do most
    of the work:

      - **Markdown link targets** are always checked. A link is a promise that
        the target is there.
      - **Backticked tokens** are checked only when they carry a file
        extension. Backticked prose routinely names paths *illustratively* —
        a schema doc describing `phase/CURRENT` in someone else's project, a
        template showing a folder that does not exist yet — and treating those
        as broken references makes every documentation repo look broken.
    """
    text = read_text(root / rel)
    base = (root / rel).parent
    cands: set[str] = set()
    for m in MD_LINK.finditer(text):
        cands.add(m.group(1))
    for m in BACKTICK.finditer(text):
        tok = m.group(1).strip()
        if Path(tok).suffix and not tok.endswith("/"):
            cands.add(tok)
    bad = []
    for tok in cands:
        tok = tok.strip()
        if not tok or tok.startswith(("http://", "https://", "#", "mailto:", "<")):
            continue
        tok = tok.split("#", 1)[0].split("?", 1)[0]
        if not tok or " " in tok:
            continue
        if not PATHISH.match(tok):
            continue
        if any(ch in tok for ch in "*$<>{}|"):
            continue
        if (base / tok).exists() or (root / tok.lstrip("/")).exists():
            continue
        bad.append(tok)
    return sorted(set(bad))[:12]


# ── document graph ────────────────────────────────────────────────────────


def scan_docs(root: Path, inventory: dict, tier0_paths: set[str],
              perry_owned: set[str]) -> dict:
    docs = []
    for rel in inventory["md"]:
        p = root / rel
        text = read_text(p)
        h1 = H1.search(text)
        docs.append({
            "path": rel,
            "lines": line_count(p),
            "title": h1.group(1).strip() if h1 else None,
            "age_days": days_since_mtime(p),
            "wikilinks": len(WIKILINK.findall(text)),
            "_text": text,
        })

    # Reference graph: which docs are named by which other docs.
    by_path = {d["path"] for d in docs}
    stems: dict[str, list[str]] = {}
    for d in docs:
        stems.setdefault(Path(d["path"]).name.lower(), []).append(d["path"])

    referenced: set[str] = set()
    for d in docs:
        base = Path(d["path"]).parent
        toks: set[str] = set()
        for m in MD_LINK.finditer(d["_text"]):
            toks.add(m.group(1))
        for m in BACKTICK.finditer(d["_text"]):
            toks.add(m.group(1))
        for m in WIKILINK.finditer(d["_text"]):
            toks.add(m.group(1).strip() + ".md")
        for tok in toks:
            tok = tok.split("#", 1)[0].strip()
            if not tok or tok.startswith(("http://", "https://")):
                continue
            try:
                resolved = str((base / tok).resolve().relative_to(root.resolve()))
            except (ValueError, OSError):
                resolved = None
            if resolved and resolved in by_path:
                referenced.add(resolved)
                continue
            if tok.lstrip("./") in by_path:
                referenced.add(tok.lstrip("./"))
                continue
            hit = stems.get(Path(tok).name.lower())
            if hit and len(hit) == 1:
                referenced.add(hit[0])

    # An index is any doc whose name says so, or the project README. On a
    # Perry project the board and the dashboard already do the routing job, so
    # they count — otherwise every correctly-adopted project is told to add an
    # index it already has under a different name.
    indexes = [
        d["path"] for d in docs
        if Path(d["path"]).name.lower() in INDEX_NAMES
        or (d["path"] in perry_owned
            and Path(d["path"]).name in ("BOARD.md", "PROJECT_STATE.md"))
    ]

    # Two classes of document are reachable without a link, and calling either
    # an orphan reports a correctly-structured project as broken — the one
    # thing a diagnostic may not do.
    #
    #   - Perry's own state files: every skill knows where BOARD.md is.
    #   - Tier-1 routed documents: a SKILL.md, subagent, or slash command is
    #     found by its frontmatter description, which IS the routing mechanism.
    #     They are the answer to doc sprawl, not an instance of it.
    routed = {d["path"] for d in docs if is_routed(root, d["path"])}
    entry_points = (
        set(tier0_paths) | set(indexes) | perry_owned | routed
        | {"README.md", "readme.md"}
    )
    orphans = [
        d["path"] for d in docs
        if d["path"] not in referenced and d["path"] not in entry_points
    ]

    # Duplicate signals: same normalized H1, or same filename in two places.
    # Duplicate titles are evidence of an accidentally-copied document, and
    # only when the match is specific. Three exclusions, each one learned from
    # a real repo where the naive check produced pure noise:
    #   - a title that normalizes to one word (or none) is usually the project
    #     name or an emoji heading, not a subject;
    #   - a title shared by more than four documents is a naming convention
    #     ("byteworker digest" across ten reference files), not duplication;
    #   - real accidental duplication is two or three files.
    project_name = norm_title(root.name)
    by_title: dict[str, list[str]] = {}
    for d in docs:
        key = norm_title(d["title"] or "")
        if len(key.split()) < 2 or key == project_name:
            continue
        by_title.setdefault(key, []).append(d["path"])
    dup_titles = {k: v for k, v in by_title.items() if 1 < len(v) <= 4}
    dup_names = {k: v for k, v in stems.items() if len(v) > 1 and k not in INDEX_NAMES}

    oversized = sorted(
        [
            {"path": d["path"], "lines": d["lines"]}
            for d in docs if d["lines"] > THRESHOLDS["single_doc_lines"]
        ],
        key=lambda d: -d["lines"],
    )

    # Only tier-0 files. A stale path in an always-loaded rules file misroutes
    # every session; a stale path in a reference doc is read by whoever opened
    # it deliberately and costs far less.
    broken: dict[str, list[str]] = {}
    for d in docs:
        if d["path"] in tier0_paths:
            bad = broken_refs(root, d["path"])
            if bad:
                broken[d["path"]] = bad

    total_lines = sum(d["lines"] for d in docs)
    for d in docs:
        d.pop("_text", None)

    return {
        "total": len(docs),
        "total_lines": total_lines,
        "indexes": indexes,
        "orphans": orphans,
        "orphan_ratio": round(len(orphans) / len(docs), 3) if docs else 0.0,
        "duplicate_titles": dup_titles,
        "duplicate_filenames": dup_names,
        "oversized": oversized[:10],
        "broken_refs": broken,
        "largest": sorted(
            [{"path": d["path"], "lines": d["lines"]} for d in docs],
            key=lambda d: -d["lines"],
        )[:10],
        "wikilink_total": sum(d["wikilinks"] for d in docs),
    }


# ── concurrency ───────────────────────────────────────────────────────────


def scan_concurrency(root: Path, inventory: dict, tier0_paths: set[str]) -> dict:
    is_repo = bool(run_git(root, "rev-parse", "--is-inside-work-tree").strip())
    worktrees, branches, hot = [], [], []
    if is_repo:
        wt = run_git(root, "worktree", "list", "--porcelain")
        worktrees = [ln.split(" ", 1)[1] for ln in wt.splitlines() if ln.startswith("worktree ")]
        branches = [
            b.strip().lstrip("* ").strip()
            for b in run_git(root, "branch", "--format=%(refname:short)").splitlines()
            if b.strip()
        ]
        log = run_git(root, "log", "--since=90.days", "--name-only", "--pretty=format:")
        counts: dict[str, int] = {}
        for ln in log.splitlines():
            ln = ln.strip()
            if ln:
                counts[ln] = counts.get(ln, 0) + 1
        hot = [
            {"path": p, "commits_90d": c}
            for p, c in sorted(counts.items(), key=lambda kv: -kv[1])[:10]
        ]

    # Does anything declare how concurrent sessions stay out of each other's way?
    declared, terms = [], (
        "worktree", "parallel session", "ownership", "owns ", "lane",
        "one writer", "concurrent", "multi-agent", "append-only",
    )
    for rel in sorted(tier0_paths):
        low = read_text(root / rel).lower()
        for t in terms:
            if t in low:
                declared.append({"path": rel, "term": t.strip()})
                break

    append_only = [
        d for d in inventory["dirs"] + inventory["md"]
        if any(h in d.lower() for h in APPEND_ONLY_HINTS)
    ][:20]

    return {
        "is_git_repo": is_repo,
        "worktrees": worktrees,
        "worktree_count": len(worktrees),
        "branches": branches[:40],
        "branch_count": len(branches),
        "hot_files_90d": hot,
        "isolation_declared": declared,
        "append_only_surfaces": append_only,
    }


# ── tracking spine ────────────────────────────────────────────────────────


def scan_tracking(root: Path, state_root: Path, inventory: dict) -> dict:
    spine = []
    for name in SPINE_NAMES:
        for base in {root, state_root}:
            p = base / name
            if p.is_file():
                rel = str(p.relative_to(root))
                if not any(s["path"] == rel for s in spine):
                    spine.append({
                        "path": rel,
                        "lines": line_count(p),
                        "age_days": days_since_mtime(p),
                    })
    spine_dirs = [
        d for d in inventory["dirs"]
        if Path(d).name.lower() in SPINE_DIRS
    ]

    decisions = []
    for name in DECISION_NAMES:
        for base in {root, state_root}:
            p = base / name
            if p.is_file():
                rel = str(p.relative_to(root))
                if rel not in decisions:
                    decisions.append(rel)
    for d in DECISION_DIRS:
        for base in {root, state_root}:
            if (base / d).is_dir():
                rel = str((base / d).relative_to(root))
                if rel not in decisions:
                    decisions.append(rel)

    # A check the agent can run.
    checks = []
    pkg = root / "package.json"
    if pkg.is_file():
        try:
            scripts = json.loads(read_text(pkg)).get("scripts", {}) or {}
        except Exception:
            scripts = {}
        for k in ("test", "lint", "typecheck", "build", "check"):
            if k in scripts:
                checks.append({"kind": "npm-script", "name": k, "cmd": f"npm run {k}"})
    for f, kind in [
        ("Makefile", "make"), ("justfile", "just"), ("Justfile", "just"),
        ("noxfile.py", "nox"), ("tox.ini", "tox"), ("pyproject.toml", "python"),
        ("Cargo.toml", "cargo"), ("go.mod", "go"),
    ]:
        if (root / f).is_file():
            checks.append({"kind": kind, "name": f, "cmd": None})
    for d in ("tests", "test", "spec", "__tests__", "e2e"):
        if (root / d).is_dir():
            checks.append({"kind": "test-dir", "name": d, "cmd": None})
    if (root / ".github" / "workflows").is_dir():
        wf = sorted((root / ".github" / "workflows").glob("*.y*ml"))
        if wf:
            checks.append({"kind": "ci", "name": f"{len(wf)} workflow(s)", "cmd": None})
    # Project-local lint/check scripts (the constructed loop for non-code work).
    for d in ("bin", "scripts", "tools"):
        if (root / d).is_dir():
            for p in sorted((root / d).iterdir()):
                if p.is_file() and re.search(r"(lint|check|verify|validate)", p.name, re.I):
                    checks.append({"kind": "script", "name": str(p.relative_to(root)), "cmd": None})

    perry = {
        "config": (root / ".perry" / "config.md").is_file(),
        "okr": (state_root / "OKR.md").is_file(),
        "board": (state_root / "BOARD.md").is_file(),
        "phase": (state_root / "phase").is_dir(),
        "state_root": str(state_root.relative_to(root)) if state_root != root else ".",
    }
    perry["installed"] = perry["config"] or (perry["okr"] and perry["board"])

    return {
        "spine_files": spine,
        "spine_dirs": spine_dirs,
        "has_spine": bool(spine or spine_dirs),
        "decision_log": decisions,
        "has_decision_log": bool(decisions),
        "checks": checks,
        "has_check": bool(checks),
        "perry": perry,
    }


# ── archetype signals ─────────────────────────────────────────────────────


def scan_archetype(inventory: dict, docs: dict, root: Path, is_perry: bool,
                   perry_owned: set[str]) -> dict:
    def is_example(rel: str) -> bool:
        return any(part.lower() in EXAMPLE_DIR_NAMES for part in Path(rel).parts)

    dirs_low = [d.lower() for d in inventory["dirs"] if not is_example(d)]
    subject_md = [m for m in inventory["md"] if not is_example(m)]
    if is_perry:
        # Perry's own folders and state files say what tooling the project
        # uses, not what kind of project it is. `knowledge/` is a digest store,
        # not a note vault, and 19 board/journal files are not a wiki.
        dirs_low = [
            d for d in dirs_low
            if not any(part in PERRY_DIR_NAMES for part in Path(d).parts)
        ]
        subject_md = [m for m in subject_md if m not in perry_owned]

    md_n = max(1, len(subject_md))
    code_n = inventory["code_total"]

    manifests = [m for m in MANIFESTS if (root / m).is_file()]
    kb_dirs = [d for d in dirs_low if any(h == Path(d).name for h in KB_DIR_HINTS)]
    raw_dirs = [d for d in dirs_low if any(h == Path(d).name for h in RAW_DIR_HINTS)]
    ops_dirs = [d for d in dirs_low if any(h == Path(d).name for h in OPS_DIR_HINTS)]

    scores = {"software": 0, "knowledge-base": 0, "ops": 0}
    why: dict[str, list[str]] = {"software": [], "knowledge-base": [], "ops": []}

    if manifests:
        scores["software"] += 3
        why["software"].append(f"manifests: {', '.join(manifests[:4])}")
    if code_n >= 20:
        scores["software"] += 3
        why["software"].append(f"{code_n} source files")
    elif code_n >= 3:
        scores["software"] += 1
        why["software"].append(f"{code_n} source files")
    if (root / ".github" / "workflows").is_dir():
        scores["software"] += 1
        why["software"].append("CI workflows")

    if docs["wikilink_total"] >= 10:
        scores["knowledge-base"] += 3
        why["knowledge-base"].append(f"{docs['wikilink_total']} wikilinks")
    if (root / ".obsidian").is_dir():
        scores["knowledge-base"] += 4
        why["knowledge-base"].append(".obsidian/ vault")
    if raw_dirs:
        scores["knowledge-base"] += 2
        why["knowledge-base"].append(f"raw/source dirs: {', '.join(raw_dirs[:3])}")
    if kb_dirs:
        scores["knowledge-base"] += 2
        why["knowledge-base"].append(f"note dirs: {', '.join(kb_dirs[:3])}")
    if code_n == 0 and len(subject_md) >= 15:
        scores["knowledge-base"] += 2
        why["knowledge-base"].append(f"{len(subject_md)} docs, no source files")

    if ops_dirs:
        scores["ops"] += 3
        why["ops"].append(f"ops dirs: {', '.join(ops_dirs[:3])}")
    if code_n < 5 and docs["wikilink_total"] < 5 and len(subject_md) >= 8:
        scores["ops"] += 2
        why["ops"].append("doc-heavy, no code, no wikilink graph")

    ranked = sorted(scores.items(), key=lambda kv: -kv[1])
    top, second = ranked[0], ranked[1]
    if top[1] == 0:
        guess, conf = None, "none"
    elif top[1] - second[1] >= 3:
        guess, conf = top[0], "high"
    elif top[1] - second[1] >= 1:
        guess, conf = top[0], "medium"
    else:
        guess, conf = top[0], "low"

    return {
        "scores": scores,
        "evidence": why,
        "guess": guess,
        "confidence": conf,
        "md_to_code_ratio": round(md_n / code_n, 2) if code_n else None,
        "manifests": manifests,
    }


# ── findings ──────────────────────────────────────────────────────────────


# ── why each check exists ─────────────────────────────────────────────────
#
# The person reading a finding has usually not read the research, and a
# finding they cannot evaluate is one they either obey blindly or ignore —
# both bad. So every ID carries a plain-language mechanism: what actually goes
# wrong, phrased as something the reader may have already experienced.
#
# Rules for writing one, because they rot in a predictable direction:
#   - describe the mechanism, never cite authority. "The agent starts ignoring
#     rules" beats "this violates the recommended budget."
#   - no Perry vocabulary. No "tier 0", no "rung", no "spine" — those are our
#     words for it, not the reader's.
#   - two sentences. Anything longer is a lecture, and the reader came here
#     with a broken project, not for a seminar.

WHY = {
    "CTX-01":
        "Files like CLAUDE.md load in full at the start of every single "
        "session, and the more instructions there are, the less reliably any "
        "one of them is followed. It doesn't fail loudly — the agent just "
        "quietly stops obeying some rules, and you can't tell which.",
    "CTX-02":
        "Two rule files that say slightly different things will drift further "
        "apart every month, and the agent obeys whichever one it happened to "
        "read. You get inconsistent behaviour that looks random.",
    "CTX-03":
        "The agent trusts these paths completely. When one points somewhere "
        "that no longer exists, it doesn't error — it goes looking in the "
        "wrong place with full confidence, which costs more than having said "
        "nothing at all.",
    "CTX-04":
        "With no rules file, every session starts by guessing your "
        "conventions, or by re-deriving them from the code. You end up "
        "repeating the same corrections in every conversation.",
    "CTX-05":
        "An empty rules file behaves exactly like no rules file, except it "
        "looks handled — so nobody notices the gap.",
    "DOC-01":
        "These documents aren't linked from anywhere, so nothing will lead an "
        "agent to them. They cost nothing to keep and deliver nothing, and "
        "because nobody reads them they're where contradictions quietly "
        "accumulate.",
    "DOC-02":
        "With this many documents and no list of what they are, an agent "
        "either reads everything (expensive, and it crowds out the actual "
        "work) or finds nothing. A one-line-per-document index is the "
        "cheapest fix in this whole report.",
    "DOC-03":
        "When one document exists in two places, both look authoritative and "
        "one starts going stale immediately. Whoever reads the stale copy has "
        "no way to know.",
    "DOC-05":
        "Large documents are fine when something opens them deliberately. "
        "They're only a problem if they get loaded on every session, where "
        "they crowd out everything else.",
    "CON-01":
        "You're running work in parallel, but nothing writes down how two "
        "sessions stay out of each other's way. That's the setup where one "
        "session's edits silently overwrite another's, and the work looks "
        "fine until you notice something you built is gone.",
    "CON-02":
        "Files that many sessions rewrite are where collisions happen. If one "
        "of these holds current status, splitting it into a small live file "
        "plus a dated history that only gets appended to removes the "
        "collision entirely.",
    "CON-03":
        "Separate checkouts stop agents colliding while they work, but the "
        "conflicts don't disappear — they move to the moment you combine the "
        "branches. Without someone reviewing the combined result, each piece "
        "is correct and the whole is broken.",
    "TRK-01":
        "Goals that live only in the conversation get summarized, then "
        "summarized again, until the agent is doing work that's related to "
        "the goal but no longer advances it. Writing them in a file small "
        "enough to re-read every session is what stops the slide.",
    "TRK-02":
        "A goal file nobody has updated in a month is one nobody is reading "
        "either, so it stops steering anything while still looking like it "
        "does.",
    "TRK-03":
        "An agent stops when the work looks finished. With nothing it can run "
        "to check, 'looks finished' is the only signal it has — which makes "
        "you the one who catches every mistake, and only when you happen to "
        "notice.",
    "TRK-04":
        "Without a record of what was decided and why, each new session "
        "re-opens settled questions and gradually reverses them. Nothing "
        "errors when this happens, which is why it goes unnoticed for months.",
    "FIT-01":
        "There's more process here than work for it to manage. Every file "
        "that has to be kept current is ongoing cost, and one that goes stale "
        "is worse than one that never existed.",
    "LOAD-01":
        "These short codes are precise for the agent and opaque to you. When a "
        "status line says one thing is blocked on another and gives you only "
        "the codes, you have to go searching your own project to find out what "
        "you're blocked on — and the agent, which remembers every code it ever "
        "created, has no idea you can't.",
    "LOAD-02":
        "Documents refer to codes that are never defined anywhere, so there is "
        "no way to find out what they mean. Usually it's work that was renamed, "
        "dropped, or only ever discussed — but you can't tell which without "
        "asking.",
    "LOAD-03":
        "Open questions are piling up faster than they're being answered. A "
        "backlog of decisions is worse than a backlog of work: everything "
        "downstream quietly stalls or proceeds on a guess, and nobody can tell "
        "which happened.",
    "LOAD-04":
        "Some of these codes have no readable name attached anywhere, so even "
        "looking them up doesn't tell you what they are.",
    "NS-01":
        "Perry claimed this folder, and now it holds files Perry did not "
        "write. It will read them as its own state and report them as broken — "
        "so the next check will tell you your own file is malformed. It "
        "isn't; it is just standing in a folder Perry took.",
    "MODE-01":
        "You wrote down what kind of work this is, and the board says "
        "something else. The questions asked at each review are picked from "
        "that label — so it will keep asking what is aging in review when the "
        "real question is what came in and never got answered, and the check "
        "that would have caught something never runs.",
    "FIT-02":
        "This project is small enough that three files would cover it: the "
        "rules, what's true right now, and what you've decided. Anything "
        "heavier would cost more to maintain than it returns.",
}


def scan_namespace(root: Path, state_root: Path, is_perry: bool) -> dict:
    """Paths Perry claims that now hold files Perry did not write.

    The state root is chosen once, at setup. This is the "after": a project
    adopted at `.` that later grows its own `design/proposal.md` currently gets
    that file reported as MALFORMED PERRY STATE — the user's own document called
    broken, which is precisely the failure the state root exists to prevent,
    arriving by a route it does not cover.

    Only meaningful on an adopted project. On anything else the collision check
    is `perry-lint --claims`, which runs before adoption and answers a different
    question ("where should the state root go?" rather than "has my state root
    been encroached on?")."""
    if not is_perry:
        return {"applicable": False, "collisions": []}
    try:
        schema = json.loads((HERE.parent / "schema" / "state-schema.json").read_text())
    except (OSError, ValueError):
        return {"applicable": False, "collisions": []}

    collisions = []
    for c in schema.get("claims") or []:
        if c["anchor"] == "project" or c["kind"] != "dir":
            continue
        target = state_root / c["path"].rstrip("/")
        if not target.is_dir():
            continue
        foreign = []
        for f in sorted(target.rglob("*.md")):
            rel = f.relative_to(root).as_posix()
            if not _perry_shaped(f, schema):
                foreign.append(rel)
        if foreign:
            collisions.append({"path": c["path"], "owner": c["owner"],
                               "foreign": foreign[:10], "count": len(foreign)})
    return {"applicable": True, "collisions": collisions}


def _perry_shaped(path: Path, schema: dict) -> bool:
    """Generous on purpose: a false 'yes' costs one missed warning, a false
    'no' tells the user their own working state is foreign."""
    if path.name in ("README.md", "INDEX.md"):
        return True
    stem = path.stem
    if re.match(r"^(DESIGN|ADR|TASK|USER)-\d", stem) or re.match(r"^\d{3}-", stem):
        return True
    if re.match(r"^\d{4}-\d{2}(-\d{2})?$", stem) or re.match(r"^\d{4}-W?\d{2}$", stem):
        return True
    if any(Path(spec["path"]).name == path.name for spec in schema["files"]):
        return True
    try:
        return "$PERRY_HOME" in path.read_text(encoding="utf-8", errors="replace")[:2000]
    except OSError:
        return False


# ── work modes ────────────────────────────────────────────────────────────
#
# DESIGN-003 gave a project four shapes, and `modes/*.md` says what tells them
# apart: what closes the horizon, and what the spine is. This scanner answers
# "which of the four does the *observable* work fit" — a different question
# from "which one did the register declare", and the whole value is in being
# able to answer the two differently.
#
# One rule it may not break: **"cannot tell" is a real answer.** Three of the
# four modes are recognised by columns and files a project may simply not have,
# and a scanner that fell back to `project` whenever it saw nothing would
# announce a verdict on every folder on earth while having measured none of
# them. `reference/diagnose.md` calls a signal that never clears worse than no
# check; a verdict that never abstains is that same defect facing the other way.
#
# And it never reads the `## Tracks` row it is judging. Scoring a track's own
# declared `Stages` / `SLA` / `Cycle` cells as evidence would let the
# declaration confirm itself, and `MODE-01` — the disagreement finding — could
# then never fire at all.

MODE_NAMES = ("project", "pipeline", "queue", "inquiry")

# Weights, and the rule for a signal two contracts claim.
#
# `STRUCTURAL` is a column, a directory or a board section that exactly **one**
# mode's contract table in `modes/*.md` defines. `CORROBORATING` is a signal
# that mode owns alone but which a project can carry for other reasons.
#
# `SHARED` is the third case, and getting it wrong is what this scanner shipped
# for a release. Two of the columns it reads are named by two contracts:
#
#   `Stage since` — pipeline's *Stage clock* (`modes/pipeline.md` § contract,
#                   and triage step 1 computes `today − Stage since`) **and**
#                   inquiry's *Question clock* (`modes/inquiry.md` § contract,
#                   whose triage step 2 computes the same subtraction).
#   `Commitment`  — pipeline's *Commitment link* (`modes/pipeline.md` §
#                   contract) **and** the cell a routed intake row takes in
#                   `modes/queue.md § triage drains intake first`, carries in
#                   § Standing commitments, and is named by when it breaches
#                   SLA in that file's triage step 2.
#
# A signal two modes own cannot tell those two apart. It can still tell them
# apart from the other two, so dropping it would throw away a real fact. It is
# therefore scored **for every owner** — which makes its contribution to the
# margin between them exactly zero — and at a **reduced** weight, because a
# fact that halves the field is not a fact that names a mode.
#
# The consequence to hold onto: with these numbers no verdict resting only on
# shared evidence can reach `high`, and `high` is the only confidence `MODE-01`
# fires on. An accusation is never assembled out of evidence two modes share.
STRUCTURAL, CORROBORATING, SHARED = 3, 2, 2

# `high` is that gate, so it takes more than one fact. `HIGH_SCORE` is set
# above the largest single signal on purpose: **no one signal can reach it**,
# so a `high` verdict always rests on at least two, and — since two shared
# signals sum to 4 — on at least one signal exactly one mode owns. `top >= 3`,
# one weight-3 signal, used to satisfy what `reference/diagnose.md` sells as
# *"with a clear margin"*, which meant a single column was enough to tell a
# user their own written declaration was wrong. `HIGH_MARGIN` is the second
# half: a lead of a whole structural signal over the runner-up, so a mode that
# merely edges ahead is reported as `medium` and accuses nobody.
#
# Both numbers are load-bearing rather than decorative, and
# `tests/test_diagnose.py` reverts each one on its own to prove it.
HIGH_SCORE, HIGH_MARGIN = 5, 3

# The default stage vocabularies from `modes/*.md`, minus every member that is
# ALSO a global `Status` value or another mode's stage. `review` is pipeline's
# and the status enum's; `in_progress` is queue's and the status enum's. A cell
# reading either of those distinguishes nothing, so neither is here.
STAGE_VOCAB = {
    "pipeline": {"brief", "draft", "approved", "published"},
    "queue": {"new", "triaged", "resolved"},
    "inquiry": {"open", "researching", "answered"},
}

# Board columns, and the modes each one belongs to — read off the four contract
# tables in `modes/*.md`, which is the source this scanner is derived from.
#
#   `Stage since` · `Commitment` — two owners each; see the SHARED note above.
#   `Arrived` — queue's alone (`modes/queue.md § contract` → Arrival).
#       `modes/pipeline.md § What this mode does not assume` sends work that
#       arrives to a second track in queue mode rather than bending pipeline,
#       so no other contract wants the column.
#   `Parent` — inquiry's alone (`modes/inquiry.md § contract` → Question tree,
#       Spine). No other mode has a tree to record.
COLUMN_SIGNALS = (
    ("stage since", ("pipeline", "inquiry"), "carry a `Stage since` date"),
    ("commitment", ("pipeline", "queue"), "name the `Commitment` they discharge"),
    ("arrived", ("queue",), "carry an `Arrived` date"),
    ("parent", ("inquiry",), "name a `Parent` question"),
)

DATEISH = re.compile(r"\b\d{4}-\d{2}-\d{2}\b")
BLANK_CELL = {"", "—", "-", "–", "n/a", "none"}

# Columns read by name. English always resolves; the other languages come from
# the schema, so this script carries no second copy of that list.
_FALLBACK_COLUMNS = ("id", "track", "stage", "stage since", "commitment",
                     "arrived", "parent", "by when", "title", "status")


def column_aliases() -> dict[str, set[str]]:
    """Canonical column name (lowercased) → every spelling a header may use."""
    out: dict[str, set[str]] = {c: {c} for c in _FALLBACK_COLUMNS}
    try:
        schema = json.loads(read_text(PERRY_HOME / "schema" / "state-schema.json"))
        cols = (schema.get("i18n") or {}).get("columns") or {}
    except Exception:
        cols = {}
    for canon, langs in cols.items():
        key = str(canon).lower()
        names = out.setdefault(key, {key})
        for spellings in (langs or {}).values():
            names |= {str(v).lower() for v in (spellings or [])}
    return out


def md_sections(text: str):
    """`## Heading` → its body lines, including a leading preamble section.

    Deliberately its own reader rather than `viewer/parsers.py`'s: `ADR-004`
    splits the tools in two, sending the steady-state readers strict against
    Perry's declared shape and keeping `diagnose` *"tolerant, and more so —
    they must read any shape to propose a migration."* A diagnose that borrowed
    the strict reader would stop being able to read the projects it exists to
    diagnose.
    """
    heading, body = "", []
    for line in text.splitlines():
        if line.startswith("## "):
            yield heading, body
            heading, body = line[3:].strip(), []
        else:
            body.append(line)
    yield heading, body


def md_table(lines: list[str], aliases: dict[str, set[str]]):
    """The first readable table in `lines` → (column → index, [row cells]).

    Resolved **by name**, never by position: a project may omit any column, and
    a positional read then attributes one column's value to another. That exact
    bug has been found twice in this repo's own parsers.
    """
    header: dict[str, int] = {}
    rows: list[list[str]] = []
    for line in lines:
        s = line.strip()
        if not s.startswith("|"):
            if rows:
                break
            continue
        if set(s) <= set("|- :"):
            continue
        cells = [c.strip("*` ") for c in split_row(s)]
        # `squash` resolves the header; `cells` keeps the values verbatim.
        # `.lower()` alone reads `| **Default** rung |` as `default** rung`,
        # so a project that bolded half a header loses that column entirely —
        # and `md_table` reads the USER's board and OKR.
        low = [squash(c) for c in cells]
        if not header:
            header = {canon: i for canon, names in aliases.items()
                      for i, c in enumerate(low) if c in names}
            if not header:
                break
            continue
        rows.append(cells)
    return header, rows


def _as_dict(header: dict[str, int], cells: list[str]) -> dict[str, str]:
    return {k: (cells[i] if 0 <= i < len(cells) else "") for k, i in header.items()}


def _filled(rows: list[dict], col: str) -> int:
    return sum(1 for r in rows if (r.get(col) or "").strip().lower() not in BLANK_CELL)


def _award(ev: dict[str, list], owners: tuple[str, ...], weight: int,
           label: str) -> None:
    """Score one signal for every mode `modes/*.md` gives it.

    One owner scores at `weight`. More than one scores each of them at `SHARED`
    — the same number for each, so a shared signal moves both scores together
    and can never open a margin between its own owners. The label is identical
    in every mode's evidence list, so a reader of the payload sees the fact
    once per mode that claims it rather than once, silently attributed.
    """
    w = weight if len(owners) == 1 else min(weight, SHARED)
    for m in owners:
        ev[m].append((w, label))


def _verdict(evidence: dict[str, list]) -> tuple[str | None, str, dict[str, int]]:
    """Score → (mode or None, confidence, scores).

    `None` is returned twice over, and the two are different facts the payload
    keeps apart: `none` means nothing distinguishing was found at all, `low`
    means two modes tied. Neither is a verdict, and neither may be rounded up
    into one.

    `high` is the fourth answer and the strictest, because `MODE-01` is gated
    on it — see the `HIGH_SCORE` note. Everything else that scores is `medium`:
    a mode worth naming in the report, on evidence too thin to contradict a
    user with.
    """
    scores = {m: sum(w for w, _ in evidence[m]) for m in MODE_NAMES}
    ranked = sorted(scores.items(), key=lambda kv: -kv[1])
    top, second = ranked[0], ranked[1]
    if top[1] == 0:
        return None, "none", scores
    if top[1] == second[1]:
        return None, "low", scores
    if top[1] >= HIGH_SCORE and top[1] - second[1] >= HIGH_MARGIN:
        return top[0], "high", scores
    return top[0], "medium", scores


def scan_work_modes(root: Path, state_root: Path) -> dict:
    """Which of DESIGN-003's four shapes each track's work actually fits."""
    try:
        state = load_sibling("perry-state")
        tracks = state.parse_tracks(read_text(root / ".perry" / "config.md"))
    except Exception:
        # Reported absent rather than defaulted. A fallback here would make
        # every project read as one implicit `project` track, and MODE-01 would
        # go quiet instead of red.
        return {"available": False, "register_declared": False, "tracks": []}

    aliases = column_aliases()
    board = read_text(state_root / "BOARD.md")
    okr = read_text(state_root / "OKR.md")

    rows: list[dict] = []
    intake_rows = 0
    for heading, body in md_sections(board):
        header, cells = md_table(body, aliases)
        if not header:
            continue
        if re.match(r"(?:Intake|收件)\b", heading, re.I):
            # Counted as its own organ, not as board rows — the `Arrived`
            # column appears in both and would otherwise be scored twice.
            intake_rows += len(cells)
            continue
        rows += [_as_dict(header, c) for c in cells]

    commitments: list[dict] = []
    for heading, body in md_sections(okr):
        if not re.match(r"(?:Commitments|承诺)\b", heading, re.I):
            continue
        header, cells = md_table(body, aliases)
        commitments += [_as_dict(header, c) for c in cells]

    phase_dir = state_root / "phase"
    phase_files = sorted(phase_dir.glob("[0-9][0-9][0-9]-*.md")) if phase_dir.is_dir() else []
    has_current = (phase_dir / "CURRENT").is_file()
    objectives = len(re.findall(r"^#{2,4}\s*(?:Objective|目标)\b", okr, re.M | re.I))
    ev_dir = state_root / "evidence"
    answers = sorted(ev_dir.glob("*/*-answer.md")) if ev_dir.is_dir() else []
    kdir = state_root / "knowledge"
    digests = 0
    if kdir.is_dir():
        for p in sorted(kdir.rglob("*.md")):
            if re.search(r"^\s*[-*>]?\s*Id\s*:\s*SRC-\d+\b",
                         read_text(p, cap=4000), re.M):
                digests += 1

    # Project-wide signals. They can only be attributed when there is exactly
    # one track to attribute them to — `phase/` and `## Intake` carry no track
    # column, so on a multi-track project they say nothing about any one track.
    # Each of these belongs to exactly one contract. `phase/` is project's
    # horizon and `modes/queue.md § Standing commitments` says in as many words
    # that Perry's phase machinery is not used by that mode; the objectives
    # cascade is disclaimed by the other three; `## Intake` is the organ
    # `modes/queue.md` opens by saying no other mode needs; the answer file and
    # the SRC- digest are `modes/inquiry.md`'s deliverable and its sources.
    # **Two kinds of file evidence, and lumping them together was the bug in
    # both directions.**
    #
    # `phase/` and `OKR.md`'s objectives describe the WHOLE REPOSITORY. Handing
    # them to a declared `ops` track told it the project's objectives were its
    # own evidence — `project 7 / pipeline 4`, and a `MODE-01` warn telling the
    # user to change a `Mode` cell that was correct.
    #
    # `## Intake`, answer files and `SRC-` digests describe a WORK SHAPE. They
    # are evidence that somebody in this repo works that way, and withholding
    # them from a declared queue or inquiry track made it unreadable — which
    # the first version of this fix did, turning three existing tests red. Those
    # tests were right.
    project_wide_ev: dict[str, list] = {m: [] for m in MODE_NAMES}
    shape_ev: dict[str, list] = {m: [] for m in MODE_NAMES}
    file_ev = project_wide_ev
    if phase_files or has_current:
        _award(file_ev, ("project",), STRUCTURAL,
               f"phase/ holds {len(phase_files)} numbered phase file(s)"
               + (" and a CURRENT pointer" if has_current else ""))
    if objectives:
        _award(file_ev, ("project",), CORROBORATING,
               f"OKR.md declares {objectives} objective(s)")
    file_ev = shape_ev
    if intake_rows:
        _award(file_ev, ("queue",), STRUCTURAL,
               f"BOARD.md § Intake carries {intake_rows} arrived request(s)")
    if answers:
        _award(file_ev, ("inquiry",), STRUCTURAL,
               f"{len(answers)} answer file(s) under evidence/")
    if digests:
        _award(file_ev, ("inquiry",), CORROBORATING,
               f"{digests} source digest(s) under knowledge/ carrying an SRC- id")

    # **`len(tracks) == 1` was a proxy for "no register exists", and it is
    # ALSO true when the register declares exactly one track.** In that case
    # every board row, every commitment row and every project-wide file was
    # scored as that track's — ignoring the `Track` column this scanner
    # already reads, and ignoring `schema/state-schema.json`'s own rule that a
    # blank `Track` means the implicit `main` track.
    #
    # A project declaring one `pipeline` track with its ordinary work in
    # untracked rows scored `project 7 / pipeline 4` and got a `MODE-01` warn
    # telling the user to change a `Mode` cell that was correct, citing
    # objectives and rows that are not that track's. `perry-lint` accepts that
    # shape and no test covered it.
    #
    # The declaredness was already computed sixty lines below, for the payload.
    # Asking the question the proxy was standing in for costs nothing.
    single = not any(t.get("declared") for t in tracks)

    # **The implicit `main` track was never enumerated.** With a register that
    # declares only `ops`, rows carrying no `Track` belong to `main` by the
    # schema's rule — and `main` was in nobody's list, so their evidence went
    # to `ops` or nowhere. Added only when such rows exist, so a project whose
    # every row is tracked gains no phantom.
    if not single and any(not (r.get("track") or "").strip() for r in rows):
        # The key is `track`, not `name` — `parse_tracks` returns
        # `{'track': 'ops', ...}`. Written as `name` first, which would have
        # matched nothing and injected a record every downstream reader would
        # have read as an unnamed track. Caught by printing the record rather
        # than by assuming its shape.
        if not any((t.get("track") or "").lower() == "main" for t in tracks):
            tracks = list(tracks) + [{"track": "main", "declared": False,
                                      "mode": "project", "stage_list": [],
                                      "stages_declared": False}]

    #: Which track owns evidence that describes the repository rather than a
    #: work shape: the implicit `main` when untracked rows put one on the
    #: board, the single declared track when it is the only candidate, and the
    #: one implicit track when no register exists at all. `""` when several
    #: tracks are declared and every row names one — then nothing owns it, which
    #: is what the two-track test asserts.
    project_wide = (
        "main" if any((t.get("track") or "").lower() == "main" for t in tracks)
        else (tracks[0].get("track") or "").lower() if len(tracks) == 1
        else "")

    def evidence_for(name: str) -> dict[str, list]:
        # **Project-wide file evidence belongs to the project-wide track.**
        # `phase/`, `OKR.md`'s objectives and the rest describe the whole
        # repository, so with no register they are the one track's — and with a
        # register they are `main`'s, which is what "blank `Track`" means. They
        # used to go to the single track whether or not it was declared, and
        # once that was fixed they went to nobody, which is the same error
        # pointed the other way: a declared `ops` track was being told the
        # project's objectives were its evidence, and then no track was told
        # anything at all.
        # Shape evidence reaches every track; repository evidence reaches the
        # project-wide one — which is the single track when no register exists
        # and the implicit `main` when one does.
        # **Two existing tests assert opposite things here, and both are
        # right.** One says a project with two declared tracks must attribute
        # `phase/` to neither. The other says a project with ONE declared track
        # does get the project-wide signals, because "withholding them would
        # throw away the strongest evidence a Perry project has".
        #
        # The V4 finding contradicted the second — until you look at its board:
        # it has **no rows**. The finding's scenario has one declared track
        # *and untracked rows beside it*, and those rows are the implicit
        # `main`'s. So the rule is not about how many tracks are declared; it
        # is about whether there is a project-wide track to own them.
        #
        # `main` is enumerated above exactly when such rows exist, so
        # `project_wide` is that question already answered.
        ev: dict[str, list] = {m: list(v) for m, v in shape_ev.items()}
        if name.lower() == project_wide:
            for mode, items in project_wide_ev.items():
                ev[mode] = list(items) + ev[mode]
        mine = [r for r in rows if single
                or (r.get("track") or "").strip().lower() == name.lower()]
        n = lambda col: _filled(mine, col)  # noqa: E731
        for col, owners, phrase in COLUMN_SIGNALS:
            filled = n(col)
            if filled:
                _award(ev, owners, STRUCTURAL,
                       f"{filled} board row(s) {phrase}")
        seen = {(r.get("stage") or "").strip().lower() for r in mine}
        for mode, vocab in STAGE_VOCAB.items():
            hit = sorted(seen & vocab)
            if hit:
                _award(ev, (mode,), CORROBORATING,
                       f"stage vocabulary in use: {', '.join(hit)}")
        krs = sum(1 for r in mine
                  if re.search(r"\bkr:\s*\S", " ".join(r.values()), re.I))
        if krs:
            _award(ev, ("project",), CORROBORATING,
                   f"{krs} board row(s) attribute work to a KR")
        mine_c = [c for c in commitments if single
                  or (c.get("track") or "").strip().lower() == name.lower()]
        dated = sum(1 for c in mine_c if DATEISH.search(c.get("by when") or ""))
        prose = sum(1 for c in mine_c
                    if (c.get("by when") or "").strip().lower() not in BLANK_CELL
                    and not DATEISH.search(c.get("by when") or ""))
        # `OKR.md § Commitments` is the spine of **both** pipeline and queue, so
        # the table's existence distinguishes nothing. The cell does: `By when`
        # "is a **date** for pipeline rows; queue rows in the same table may
        # carry prose" (`modes/pipeline.md § contract`), and `modes/queue.md §
        # Standing commitments` says the queue value is prose and the clock
        # lives once, in the register's `SLA`. So the form of the cell is the
        # signal, and each form has one owner.
        if dated:
            _award(ev, ("pipeline",), STRUCTURAL,
                   f"{dated} commitment(s) promise a dated `By when`")
        if prose:
            _award(ev, ("queue",), CORROBORATING,
                   f"{prose} standing commitment(s) whose `By when` is prose, not a date")
        return ev

    out = []
    for t in tracks:
        ev = evidence_for(t["track"])
        mode, confidence, scores = _verdict(ev)
        out.append({
            "track": t["track"],
            "declared": bool(t.get("declared")),
            "declared_mode": t.get("mode") or "project",
            "mode": mode,
            "confidence": confidence,
            "scores": scores,
            "evidence": {m: [lbl for _, lbl in ev[m]] for m in MODE_NAMES},
            "scope": "track" if t.get("declared") else "project",
        })
    return {
        "available": True,
        "register_declared": any(t.get("declared") for t in tracks),
        "tracks": out,
    }


def finding(fid, severity, title, detail, evidence=None):
    return {
        "id": fid,
        "severity": severity,
        "title": title,
        # `why` is the mechanism, for a reader who has read no research.
        # `detail` is what to do about it.
        "why": WHY.get(fid, ""),
        "detail": detail,
        "evidence": evidence or [],
    }


def derive_findings(ctx, docs, con, trk, arch, inv, load, ns=None,
                    modes=None) -> list[dict]:
    out = []

    # ── work modes ──
    # Fires only when the register DECLARED a mode and the evidence points
    # somewhere else with a clear margin. Three abstentions are deliberate: an
    # undeclared track (the implicit `main` is a default, not a claim), a
    # `cannot tell` verdict, and a `medium` one. Each of them is a case where
    # the report would be telling the user their own declaration is wrong on
    # thinner evidence than they used to write it.
    for t in (modes or {}).get("tracks", []):
        if not (t["declared"] and t["mode"] and t["confidence"] == "high"):
            continue
        if t["mode"] == t["declared_mode"]:
            continue
        out.append(finding(
            "MODE-01", "warn",
            f"track `{t['track']}` is written down as `{t['declared_mode']}` "
            f"work and looks like `{t['mode']}` work",
            f"One of the two is wrong and only you can say which. Either "
            f"change the `Mode` cell for `{t['track']}` in `.perry/config.md` "
            f"to `{t['mode']}`, or keep the label and fix what is on the board "
            f"to match it. Do not leave them disagreeing: the label is what "
            f"picks the review questions, so a wrong one asks about the wrong "
            f"thing every single time.",
            t["evidence"].get(t["mode"], [])[:6],
        ))

    # ── namespace ──
    # Stays `warn`, never `error`: a user may knowingly keep one file in a
    # claimed folder, and there is no per-path opt-out by design (DESIGN-002
    # decision #2 was taken strictly). A permanent red for a deliberate choice
    # is how a check trains its user to skip it.
    for c in (ns or {}).get("collisions", []):
        out.append(finding(
            "NS-01", "warn",
            f"`{c['path']}` holds {c['count']} file(s) Perry did not write",
            f"Either move Perry's state to its own root — `/perry relocate "
            f"perry` — or move these files out of `{c['path']}`. Both are "
            f"reversible; the first is one command.",
            c["foreign"],
        ))

    # ── context load ──
    if not ctx["always_loaded"]:
        out.append(finding(
            "CTX-04", "warn",
            "No file tells the agent this project's rules",
            "Create AGENTS.md (symlink CLAUDE.md to it). Put in only what an "
            "agent cannot work out by reading the project: the build and test "
            "commands, conventions that differ from the language default, and "
            "any setup quirk. Aim for under 60 lines.",
        ))
    empty = [f["path"] for f in ctx["always_loaded"] if f["lines"] == 0]
    if empty and len(empty) == len(ctx["always_loaded"]):
        out.append(finding(
            "CTX-05", "warn",
            "The rules file is empty",
            "Either fill it with the handful of rules that would change what "
            "an agent does here, or delete it so the gap is visible.",
            empty,
        ))
    if ctx["over_budget_by"] > 0:
        out.append(finding(
            "CTX-01", "error",
            f"{ctx['always_loaded_lines']} lines load into every session "
            f"(guideline: {ctx['budget_lines']})",
            "Go through it line by line and sort into three piles. Rules that "
            "change what the agent does: keep. Step-by-step procedures for "
            "recurring tasks: move to a skill, which loads only when relevant. "
            "Everything else is reference: move to its own file and link it "
            "from an index. Typical result is 30-50 lines kept.",
            [f"{f['path']} — {f['lines']} lines" for f in ctx["always_loaded"]],
        ))
    names = {Path(f["path"]).name for f in ctx["always_loaded"]}
    linked = any(f["symlink"] for f in ctx["always_loaded"])
    if {"CLAUDE.md", "AGENTS.md"} <= names and not linked:
        out.append(finding(
            "CTX-02", "warn",
            "CLAUDE.md and AGENTS.md both exist and neither is a symlink",
            "Merge them into whichever is more complete, then replace the "
            "other with a symlink: `ln -s AGENTS.md CLAUDE.md`.",
        ))
    for path, bad in docs["broken_refs"].items():
        out.append(finding(
            "CTX-03", "error",
            f"{path} points at files that no longer exist",
            "Update each path to where the file actually is, or drop the "
            "sentence. In general, describe fewer file locations in prose — "
            "that is what the agent's own search is for, and prose goes stale "
            "while the filesystem cannot.",
            bad,
        ))

    # ── document graph ──
    if docs["total"] >= THRESHOLDS["doc_count_index_required"] and not docs["indexes"]:
        out.append(finding(
            "DOC-02", "error",
            f"{docs['total']} documents and no list of what they are",
            "Create one index file listing every document with a one-line "
            "description of what it answers, then add a line to your rules file "
            "telling the agent to read the index first.",
        ))
    # Orphanhood only means something once there is enough material to get lost
    # in. A three-file project where STATE.md is not linked from AGENTS.md has
    # no navigation problem, and telling it so is the kind of noise that gets
    # the whole report discounted.
    if (docs["total"] >= THRESHOLDS["doc_count_index_required"]
            and docs["orphans"]
            and docs["orphan_ratio"] >= THRESHOLDS["orphan_ratio_warn"]):
        out.append(finding(
            "DOC-01", "warn",
            f"{len(docs['orphans'])} of {docs['total']} documents "
            f"({int(docs['orphan_ratio'] * 100)}%) aren't linked from anywhere",
            "Go through them in batches. Each one gets linked from the index, "
            "moved to an archive folder, or deleted. Deciding is the work; the "
            "outcome matters less than the pile shrinking.",
            docs["orphans"][:15],
        ))
    if docs["duplicate_titles"]:
        out.append(finding(
            "DOC-03", "warn",
            f"{len(docs['duplicate_titles'])} document title(s) appear in more than one file",
            "Pick the copy that should survive, then replace the other with a "
            "link to it. If both have content worth keeping, merge first.",
            [f"{k or '(untitled)'} → {', '.join(v)}" for k, v in
             list(docs["duplicate_titles"].items())[:8]],
        ))
    if docs["oversized"]:
        out.append(finding(
            "DOC-05", "info",
            f"{len(docs['oversized'])} doc(s) over "
            f"{THRESHOLDS['single_doc_lines']} lines",
            "No action needed unless one of these is loaded every session — "
            "check whether your rules file pulls it in. If it does, split it.",
            [f"{d['path']} — {d['lines']} lines" for d in docs["oversized"][:6]],
        ))

    # ── concurrency ──
    parallel_evidence = con["worktree_count"] > 1 or con["branch_count"] > 3
    if parallel_evidence and not con["isolation_declared"]:
        out.append(finding(
            "CON-01", "warn",
            "Work runs in parallel and nothing says how sessions avoid each other",
            f"Found {con['worktree_count']} checkout(s) and "
            f"{con['branch_count']} branch(es). Add a short section to your "
            "rules file naming which approach you use: one session at a time; "
            "several sessions each owning a listed set of files; or a separate "
            "checkout per session. Pick the simplest one that has survived the "
            "collisions you have actually had.",
        ))
    if con["worktree_count"] > 1 and not any(
        "merge" in d["term"] or "integrat" in d["term"] for d in con["isolation_declared"]
    ):
        out.append(finding(
            "CON-03", "info",
            f"{con['worktree_count']} separate checkouts, but nobody reviews the combined result",
            "Write down who or what reviews the combined result before it "
            "lands, and in what order branches merge.",
            con["worktrees"][:6],
        ))
    hot = [h for h in con["hot_files_90d"] if h["commits_90d"] >= 15]
    if hot:
        out.append(finding(
            "CON-02", "info",
            "Some files are rewritten by many sessions",
            "Informational. If one of these holds current status, split it: a "
            "short live file for what is true now, plus a dated file that only "
            "ever gets appended to. Appending never conflicts.",
            [f"{h['path']} — {h['commits_90d']} commits/90d" for h in hot[:6]],
        ))

    # ── tracking ──
    if not trk["has_spine"]:
        out.append(finding(
            "TRK-01", "error",
            "Nothing records what this project is trying to achieve",
            "Create STATE.md and keep it to one screen: the current goal, what "
            "is in flight, what is blocked, what you have ruled out, and the "
            "single next thing. Update it at the end of each session.",
        ))
    else:
        stale = [
            s for s in trk["spine_files"]
            if s["age_days"] is not None and s["age_days"] > THRESHOLDS["stale_spine_days"]
        ]
        if stale and len(stale) == len(trk["spine_files"]):
            out.append(finding(
                "TRK-02", "warn",
                "The goal file hasn't been touched in a month",
                "Bring it up to date in one pass, or retire it and rely on "
                "whatever you are actually using instead. A file in between "
                "misleads.",
                [f"{s['path']} — {s['age_days']}d" for s in stale],
            ))
    if not trk["has_check"]:
        out.append(finding(
            "TRK-03", "error",
            "No check the agent can run",
            "Give the agent one command that returns pass or fail, and tell it "
            "to run that before claiming anything is done. Code: the test suite "
            "or the build. No code: a script checking the output has its "
            "required parts, a second agent reviewing against written criteria "
            "in a fresh session, or a recorded human sign-off. One is enough.",
        ))
    if not trk["has_decision_log"]:
        out.append(finding(
            "TRK-04", "warn",
            "No decision log",
            "Create DECISIONS.md and add to the bottom of it whenever you "
            "settle something durable: the date, what was decided, why, and "
            "what it replaces. Only real decisions — not every choice.",
        ))

    # ── what the project asks a human to carry ──
    if load.get("available"):
        if (load["total_ids"] >= THRESHOLDS["id_lookup_required"]
                and not load["has_resolver"]
                and not load["definitions_concentrated"]):
            out.append(finding(
                "LOAD-01", "warn",
                f"{load['total_ids']} short codes in use with no way to look "
                "them up",
                "Add one file listing every code and what it means in a line, "
                "and keep it current. Or copy in a resolver — Perry ships "
                "`bin/perry-explain`, which reads the codes straight out of "
                "your documents so there is nothing extra to maintain. Either "
                "way, the rule that matters is that a code never appears "
                "without its name the first time it's mentioned.",
            ))
        if load["dangling"]:
            out.append(finding(
                "LOAD-02", "warn",
                f"{len(load['dangling'])} code(s) are referenced but never "
                "defined",
                "For each: point it at the real item, write the item down, or "
                "drop the reference. Prose that names work which does not "
                "exist anywhere is the hardest kind to resolve later.",
                load["dangling"][:10],
            ))
        if load["untitled"]:
            out.append(finding(
                "LOAD-04", "info",
                f"{len(load['untitled'])} code(s) are defined without a "
                "readable name",
                "Give each one a short title where it is defined, so looking "
                "it up actually answers the question.",
                load["untitled"][:10],
            ))
        if load["open_decisions"] >= THRESHOLDS["open_decisions_warn"]:
            out.append(finding(
                "LOAD-03", "warn",
                f"{load['open_decisions']} open questions are waiting on you",
                "Work through them oldest first, and for each one ask whether "
                "it actually needs you. Anything reversible and low-stakes is "
                "better decided by whoever is working on it and written down, "
                "rather than queued for a person who cannot evaluate it faster "
                "than it can be undone.",
                load["open_decision_samples"][:6],
            ))

    # ── fit ──
    doc_lines = docs["total_lines"]
    if arch["guess"] == "software" and inv["code_total"] < 10 and docs["total"] > 25:
        out.append(finding(
            "FIT-01", "info",
            "More process than work",
            f"{docs['total']} documents ({doc_lines} lines) against "
            f"{inv['code_total']} source files. Worth asking of each one: when "
            "did this last change a decision? Anything unused for a few months "
            "is a candidate for the archive.",
        ))
    if docs["total"] <= 3 and not trk["has_spine"]:
        out.append(finding(
            "FIT-02", "info",
            "Fewer files than this project needs",
            "Add AGENTS.md (rules), STATE.md (what is true now), and "
            "DECISIONS.md (settled calls, append-only). Stop there until "
            "something actually goes wrong that a fourth file would have "
            "prevented.",
        ))

    order = {"error": 0, "warn": 1, "info": 2}
    return sorted(out, key=lambda f: (order[f["severity"]], f["id"]))


# ── assembly ──────────────────────────────────────────────────────────────


def diagnose(root: Path, max_files: int) -> dict:
    state_root = resolve_state_root(root)
    inv = walk(root, max_files)
    ctx = scan_context_load(root, inv)
    tier0_paths = {f["path"] for f in ctx["always_loaded"]}

    is_perry = (root / ".perry" / "config.md").is_file() or (
        (state_root / "OKR.md").is_file() and (state_root / "BOARD.md").is_file()
    )
    perry_owned: set[str] = set()
    if is_perry:
        prefix = "" if state_root == root else f"{state_root.relative_to(root)}/"
        for g in perry_owned_globs():
            pattern = g if g.startswith(".perry") else f"{prefix}{g}"
            perry_owned |= {m for m in inv["md"] if fnmatch.fnmatch(m, pattern)}

    docs = scan_docs(root, inv, tier0_paths, perry_owned)
    con = scan_concurrency(root, inv, tier0_paths)
    trk = scan_tracking(root, state_root, inv)
    arch = scan_archetype(inv, docs, root, is_perry, perry_owned)
    load = scan_user_load(root, inv, docs, is_perry)
    ns = scan_namespace(root, state_root, is_perry)
    modes = scan_work_modes(root, state_root)
    findings = derive_findings(ctx, docs, con, trk, arch, inv, load, ns, modes)

    return {
        "schema": "diagnose/1",
        "root": str(root),
        "generated": date.today().isoformat(),
        "thresholds": THRESHOLDS,
        "inventory": {
            "md_files": len(inv["md"]),
            "code_files": inv["code_total"],
            "code_by_ext": inv["code_by_ext"],
            "other_files": inv["other_files"],
            "dir_count": len(inv["dirs"]),
            "walk_truncated": inv["truncated"],
        },
        "context_load": ctx,
        "documents": docs,
        "concurrency": con,
        "tracking": trk,
        "archetype": arch,
        "user_load": load,
        "namespace": ns,
        "work_modes": modes,
        "findings": findings,
        "counts": {
            "error": sum(1 for f in findings if f["severity"] == "error"),
            "warn": sum(1 for f in findings if f["severity"] == "warn"),
            "info": sum(1 for f in findings if f["severity"] == "info"),
        },
    }


def render_text(d: dict) -> str:
    L = []
    A = L.append
    inv, ctx, docs, con, trk, arch = (
        d["inventory"], d["context_load"], d["documents"],
        d["concurrency"], d["tracking"], d["archetype"],
    )
    A(f"🩺 Perry diagnose · {Path(d['root']).name} · {d['generated']}")
    A("")
    guess = arch["guess"] or "—"
    A(f"   Looks like     : {guess} ({arch['confidence']} confidence)")
    for k, v in arch["evidence"].items():
        if v and k == arch["guess"]:
            A(f"                    {'; '.join(v[:3])}")
    A(f"   Inventory      : {inv['md_files']} md · {inv['code_files']} source · "
      f"{inv['dir_count']} dirs")
    over = f" ⚠ over by {ctx['over_budget_by']}" if ctx["over_budget_by"] else " ok"
    A(f"   Always loaded  : {ctx['always_loaded_lines']}/{ctx['budget_lines']} lines"
      f"{over}"
      + (f" ({', '.join(f['path'] for f in ctx['always_loaded'])})"
         if ctx["always_loaded"] else " (none)"))
    A(f"   Doc graph      : {docs['total']} docs · {len(docs['indexes'])} index · "
      f"{len(docs['orphans'])} orphaned ({int(docs['orphan_ratio'] * 100)}%)")
    A(f"   Concurrency    : {max(0, con['worktree_count'] - 1)} extra worktree · "
      f"{con['branch_count']} branch · isolation declared: "
      f"{'yes' if con['isolation_declared'] else 'no'}")
    A(f"   Spine          : {'yes' if trk['has_spine'] else 'NO'} · "
      f"decisions: {'yes' if trk['has_decision_log'] else 'NO'} · "
      f"runnable check: {'yes' if trk['has_check'] else 'NO'}")
    if trk["perry"]["installed"]:
        A(f"   Perry state    : installed (state root {trk['perry']['state_root']})")
    wm = d.get("work_modes") or {}
    for t in wm.get("tracks", []):
        # "cannot tell" is printed as itself. Rounding an abstention up to the
        # commonest mode is the one thing this line may not do.
        said = t["mode"] or "cannot tell"
        scope = t["track"] if t["declared"] else "whole project"
        declared = f"declared {t['declared_mode']}" if t["declared"] \
            else "nothing declared"
        A(f"   Work mode      : {scope} — evidence says {said} "
          f"({t['confidence']}) · {declared}")
        for label in (t["evidence"].get(t["mode"]) or [])[:2]:
            A(f"                    {label}")
        if not t["mode"]:
            A("                    " + (
                "no distinguishing signal — the four modes are told apart by "
                "what closes the horizon"
                if t["confidence"] == "none"
                else "signals point two ways at once; neither is claimed"))
    A("")
    c = d["counts"]
    A(f"   Findings       : {c['error']} error · {c['warn']} warn · {c['info']} info")
    A("")
    def block(label: str, text: str) -> None:
        if not text:
            return
        lines = textwrap.wrap(text, width=72) or [""]
        A(f"       {label:<14} {lines[0]}")
        for ln in lines[1:]:
            A(f"       {'':<14} {ln}")

    for f in d["findings"]:
        mark = {"error": "✗", "warn": "!", "info": "·"}[f["severity"]]
        A(f"   {mark} [{f['id']}] {f['title']}")
        # Mechanism before remedy: a reader who cannot evaluate a finding will
        # either obey it blindly or ignore it, and both are worse than being
        # told plainly what goes wrong.
        block("why it bites", f.get("why", ""))
        block("what to do", f["detail"])
        if f["evidence"]:
            A(f"       {'evidence':<14} {f['evidence'][0]}")
            for e in f["evidence"][1:6]:
                A(f"       {'':<14} {e}")
            if len(f["evidence"]) > 6:
                A(f"       {'':<14} … and {len(f['evidence']) - 6} more")
        A("")
    if not d["findings"]:
        A("   ✓ Nothing to fix. Every structural check passed — this project is")
        A("     set up in a way that holds up under agent work.")
        A("")
    else:
        A("   Thresholds (line budgets, doc counts, staleness) are calibrated")
        A("   defaults, not laws. Disagree with one and it stops being a finding.")
        A("")
    return "\n".join(L)


def main(argv: list[str]) -> int:
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    root = os.environ.get("PERRY_PROJECT") or os.getcwd()
    fmt = "json"
    max_files = 20000
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--root" and i + 1 < len(argv):
            root = argv[i + 1]
            i += 1
        elif a == "--max-files" and i + 1 < len(argv):
            try:
                max_files = int(argv[i + 1])
            except ValueError:
                pass
            i += 1
        elif a == "--json":
            fmt = "json"
        elif a == "--text":
            fmt = "text"
        i += 1

    p = Path(root).expanduser()
    if not p.is_dir():
        print(json.dumps({"schema": "diagnose/1", "error": f"not a directory: {root}"}))
        return 0
    p = p.resolve()

    try:
        payload = diagnose(p, max_files)
    except Exception as exc:  # never block a standup on a scan failure
        payload = {"schema": "diagnose/1", "root": str(p), "error": f"{type(exc).__name__}: {exc}"}
        print(json.dumps(payload, indent=2) if fmt == "json" else f"perry-diagnose: {payload['error']}")
        return 0

    print(json.dumps(payload, indent=2) if fmt == "json" else render_text(payload))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
