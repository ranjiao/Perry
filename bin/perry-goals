                    append_separator_cell, cell_spans, header_index,
                    render_row, render_separator, splice_cell, split_row,
                    squash)
import lib  # noqa: E402
# TASK-092. The store `OKR.md` is now a projection of, and its renderer. This
# tool does not carry a second copy of either, for the same reason it parses
# nothing itself: a fourth reader of `OKR.md` would be a fourth chance at the
# defect that made `perry-task` and `viewer/parsers.py` disagree in silence.
import perry_md_store as md_store  # noqa: E402


class Refused(Exception):
    """A refusal is a first-class outcome, not a crash. Nothing was written."""


@contextmanager
def naming_the_flag(flag: "str | list[str]"):
    """Attach the flag a value arrived on to any `UnrenderableCell` inside.

    **`UnrenderableCell` carries `index`, which is a COLUMN POSITION**, and a
    column position means nothing to the person who typed the command:
    `--promise` and `--to` produced byte-identical refusals and neither said
    what to fix. The rule this restores is written over `SLA_TOKEN_RE` —
    *"the refusal says so and names the flag, so a user is never guessing
    where their words go"* — and `cmd_commit`'s whitespace refusal obeyed it
    (`--promise was given only whitespace…`) while its line-break sibling,
    on the same tool and the same value, did not.

    The flag is known only at the write site, which is why it is attached
    here rather than guessed later from the value: `bin/perry-task` matches
    `exc.value` back against `args` at its boundary, and that match is exact
    or nothing, so two flags carrying the same string name whichever comes
    first in a hand-kept list. A write site knows without matching.

    `flag` is one flag when the write is one cell, or a list parallel to the
    row's cells when the write is a whole row.
    """
    try:
        yield
    except UnrenderableCell as exc:
        if isinstance(flag, str):
            exc.naming(flag)
        elif 0 <= exc.index < len(flag):
            exc.naming(flag[exc.index])
        raise


def unrenderable_refusal(exc: UnrenderableCell) -> str:
    """`UnrenderableCell` as the one sentence the refusal channel prints.

    One spelling, used by `main` (which knows `--json`) and by the
    module-level last resort (which does not). Two spellings of one rule is
    the defect `tests/test_one_line_break_rule.py` was opened for —
    `render_row` and `check_cell` each carried their own line-break test and
    disagreed on six of the eleven boundaries `str.splitlines()` breaks on.
    """
    where = f"{exc.field} " if exc.field else ""
    return (f"{where}was given {exc.value[:60]!r}, which {exc.why}. "
            f"A register cell is one line of a markdown table.")


_SCHEMA = None


def load_schema() -> dict:
    """`lib.load_schema`, memoized. The memo is this tool's, not the library's.

    `okr_table_spec` and its callers read the schema on nearly every code path,
    and caching it in the shared function would hand every other tool a cache
    it never asked for — including the ones a test re-execs in-process."""
    global _SCHEMA
    if _SCHEMA is None:
        _SCHEMA = lib.load_schema(Refused)
    return _SCHEMA


def okr_table_spec(under: str) -> dict:
    """The schema's own declaration of one `OKR.md` table.

    Read rather than restated. The Commitments table's heading regex, its six
    columns and its one optional column are all declared in
    `schema/state-schema.json`, and a writer that hardcoded a second copy of
    them would be the "one rule, two implementations" defect this project has
    now found in five review rounds — with the added twist that `perry-lint`
    validates against the schema's copy, so the two would disagree silently
    until a project used a spelling only one of them knew.
    """
    for spec in load_schema()["files"]:
        if spec.get("path") != "OKR.md":
            continue
        for table in spec.get("tables", []):
            if table.get("under") == under:
                return table
    raise Refused(f"schema/state-schema.json declares no OKR.md table under "
                  f"{under!r}; this tool cannot invent one")


#: `^Commitments\b|^承诺` at the time of writing — taken from the schema so the
#: heading this tool finds and the heading `perry-lint` validates are one
#: string.
COMMITMENTS_UNDER = "^Commitments\\b|^承诺"


def heading_pattern(under: str) -> str:
    """A schema `under` regex, as a pattern that matches *after* the hashes.

    The schema anchors every alternative with `^` because `perry-lint` applies
    it to a heading line whose `## ` has already been stripped. `Okr.section`
    applies it after `^##\\s+`, where a second `^` can never match — so a
    literal hand-off of the schema's string silently finds no section at all,
    and the tool reports a missing `## Commitments` on a file that has one.
    Dropping the anchors is the entire translation; the alternatives stay the
    schema's, which is the point of reading them from there.
    """
    return re.sub(r"(?:^|(?<=\|))\^", "", under)


COMMITMENTS_HEADING = heading_pattern(COMMITMENTS_UNDER)


def column_spellings(canonical: str) -> list[str]:
    """Every squashed spelling of one column name, English first.

    Resolution here is deliberately **table-local**: "which header cell of THIS
    table is `By when`", not "what does this header cell mean anywhere". The
    global direction is ambiguous and the ambiguity is real — `schema/
    state-schema.json § i18n.columns` maps both `Deadline` and `By when` onto
    the same Chinese word `截止`, because a KR table's deadline and a
    commitment's due date are the same word in Chinese and different columns in
    Perry. Asked globally, `截止` resolves to `Deadline` and a Chinese
    Commitments table loses its `By when` column. Asked table-locally, the
    question has one answer.
    """
    i18n = load_schema().get("i18n", {}).get("columns", {}) or {}
    out = [squash(canonical)]
    for lang_spellings in (i18n.get(canonical) or {}).values():
        out += [squash(s) for s in lang_spellings]
    return out


def column_at(header: list[str], canonical: str) -> int:
    """Index of `canonical` in `header`, or -1. By NAME, never by position."""
    return header_index(header).column(column_spellings(canonical))


def header_language(header: list[str], declared: list[str]) -> str:
    """Which language THIS table's headers are written in, `en` by default.

    Table-local like everything else here, and for a further reason: a file may
    hold an English KR table and a Chinese Commitments table, because the two
    were written at different times by different hands. Asking the document is
    asking the wrong scope.
    """
    i18n = load_schema().get("i18n", {}).get("columns", {}) or {}
    cells = set(header_index(header))
    for canonical in declared:
        for lang, spellings in (i18n.get(canonical) or {}).items():
            if cells & {squash(s) for s in spellings}:
                return lang
    return "en"


def display_name(canonical: str, lang: str) -> str:
    """How to WRITE a column name into a table in `lang`.

    A widened Chinese table gets a Chinese header. Writing `Discharged by` into
    `| 编号 | 轨道 | … |` produces a table this tool can still read and a human
    cannot, which is the same failure as reformatting prose — the file stops
    being the user's.
    """
    spellings = (load_schema().get("i18n", {}).get("columns", {})
                 .get(canonical) or {}).get(lang) or []
    return spellings[0] if spellings else canonical


# ── one cell, without re-spacing the rest of its row ───────────────────────


SEPARATOR_RE = re.compile(r"^\s*\|[\s:|-]+\|?\s*$")


#: TASK-067: `append_separator_cell` moved to `viewer/tables.py`, beside the
#: `append_cell` it has to agree with. Imported above; this comment is here
#: because the name is used below and grep should find where it went.


class Okr:
    """`OKR.md` as a list of lines, edited in place. Never re-rendered.

    The same rule `perry-task`'s `Board` states, and it binds harder here:
    `BOARD.md` is mostly table, `OKR.md` is mostly prose the user argued with.
    A writer that round-trips through a parsed model normalizes whitespace,
    heading punctuation and blank-line runs, and the result still passes
    `perry-lint` while no longer reading the way its author wrote it — the one
    failure DESIGN-005 § 5.5 says is worse than having no writer at all.

    So the gate this class exists to pass, before any write path ships:

        load it, change nothing, write it back  →  byte-identical

    over every real `OKR.md` available, not over a fixture Perry generated.
    The four on this machine disagree about almost everything — heading
    punctuation, language, whether `Anti-Goals` sits inside a version, whether
    version numbers are contiguous — and not one of them is malformed.
    """

    def __init__(self, path: Path):
        self.path = path
        if not path.exists():
            raise Refused(f"no OKR.md at {path}")
        self.text = path.read_text()
        self.lines = self.text.split("\n")

    def render(self) -> str:
        """Exactly what `__init__` read, unless a cell was changed.

        `split("\n")` / `join("\n")` is lossless in both directions,
        including for a file with no trailing newline and for one with
        several — which `splitlines()` is not, and which is why it is not
        used.
        """
        return "\n".join(self.lines)

    def unchanged(self) -> bool:
        return self.render() == self.text

    # -- locating

    def section(self, pattern: str, level: int = 2) -> tuple[int, int]:
        """(first line, end line) of the first heading matching `pattern`.

        `end` is the next heading at the same level **or shallower**, so a
        `## Commitments` section ends at the next `##` or `#` and swallows any
        `###` beneath it. gimegime-pmo nests `### Anti-Goals` inside a version
        section; a scanner that stopped at any heading would cut that version
        in half.
        """
        hashes = "#" * level
        rx = re.compile(rf"^{hashes}\s+(?:{pattern})", re.I)
        stop = re.compile(rf"^#{{1,{level}}}\s")
        start = None
        for i, line in enumerate(self.lines):
            if start is None:
                if rx.match(line):
                    start = i
            elif stop.match(line):
                return start, i
        if start is None:
            raise Refused(
                f"OKR.md has no `{hashes} {pattern}` section")
        return start, len(self.lines)

    def has_section(self, pattern: str, level: int = 2) -> bool:
        try:
            self.section(pattern, level)
            return True
        except Refused:
            return False

    def table(self, lo: int, hi: int) -> tuple[int, list[str]]:
        """(separator line index, header cells) for the first table in range.

        The header is the line above the separator, which is how a markdown
        table is actually defined — looking for a line of pipes and calling
        the first one a header would match a row.
        """
        for i in range(lo, hi):
            if re.match(r"^\|\s*:?-{2,}", self.lines[i]) and i > lo:
                return i, split_row(self.lines[i - 1])
        raise Refused("that section has no table")

    def rows(self, lo: int, hi: int) -> list[tuple[int, dict]]:
        """(line index, cells keyed by squashed header) for each data row."""
        sep, header = self.table(lo, hi)
        keys = header_index(header)
        out = []
        for i in range(sep + 1, hi):
            line = self.lines[i]
            if not line.strip().startswith("|"):
                if line.strip():
                    break
                continue
            out.append((i, dict(zip(keys, split_row(line)))))
        return out

    def row_indexes(self, lo: int, hi: int) -> list[int]:
        """Just the line numbers of the data rows, in file order."""
        return [i for i, _ in self.rows(lo, hi)]

    # -- editing

    def set_cell(self, index: int, column: int, value: str) -> None:
        """One cell of one row. Every other cell keeps its own bytes."""
        self.lines[index] = splice_cell(self.lines[index], column, value)

    def widen(self, lo: int, hi: int, name: str) -> list[str]:
        """Add one column to a section's table, and pad every row for it.

        The only edit here that touches lines the caller did not name, which is
        why it is reported to the user rather than done quietly. It is still
        the right answer: `Discharged by` is optional in the schema, `--miss`
        has nowhere to put its reason without it, and refusing would strand a
        real promise on a table that is not malformed.
        """
        sep, header = self.table(lo, hi)
        rows = self.row_indexes(lo, hi)
        self.lines[sep - 1] = append_cell(self.lines[sep - 1], name)
        self.lines[sep] = append_separator_cell(self.lines[sep])
        for i in rows:
            self.lines[i] = append_cell(self.lines[i], "")
        return header + [name]

    def append_table_row(self, lo: int, hi: int, cells: list[str]) -> tuple[int, str]:
        """Insert a rendered row after the table's last row. (index, line)."""
        sep, _ = self.table(lo, hi)
        rows = self.row_indexes(lo, hi)
        at = (rows[-1] if rows else sep) + 1
        line = render_row(cells)
        self.lines.insert(at, line)
        return at, line

    def insert_section(self, block: list[str], before: list[str]) -> int:
        """Insert a `## ` section before the first heading in `before`.

        Falls back to the end of the file. Placement is by the file's own
        headings rather than by line number, because the four real `OKR.md`
        files on this machine agree about almost nothing else — one nests
        `### Anti-Goals` inside a version, one carries a section Perry's
        template has never heard of, and one has versions `v2` and `v4` with no
        `v3`. Appending at a computed offset would land inside a version block
        on at least one of them.
        """
        at = None
        for pattern in before:
            if self.has_section(pattern):
                at = self.section(pattern)[0]
                break
        if at is None:
            at = len(self.lines)
            # Land after the file's last non-blank line, keeping however many
            # trailing newlines it had — `render` is byte-exact and a section
            # appended past them would move them.
            while at > 0 and not self.lines[at - 1].strip():
                at -= 1
            self.lines[at:at] = [""] + block
            return at + 1
        self.lines[at:at] = block + [""]
        return at


# Versioned independently of the other two (DESIGN-005 § 4 decision 5). Goals
# move on a different clock from tasks; tying the versions together would make
# a consumer re-check code for a change in a domain it does not read.
#
# TASK-037 shipped the writer and did NOT move this. See
# `schema/goals-list-contract.md § Changelog`: a writer is not a read-contract
# change, and the commitments register gained no key here.
#
# TASK-120 DOES move it, to `2.1`. Four keys are added and none is removed or
# retyped: `krs[].current_provenance`, `krs[].current_staleness`,
# `krs[].linked_task_completion` and `conformance.krs_with_stale_current`. The
# contract document's own rule for this is written at the bottom of its
# Changelog — "if it is added later it is `2.1`, additive, and this table
# records it" — so the minor moves in the same edit that adds the keys.
#
# TASK-144 moves it to `2.2`, and adds no key at all. The three timestamps in
# those blocks — `asserted_at`, `staleness.since` and `moved_tasks[].at` — are
# UTC now and carry a `Z`, where `at` used to be the log's LOCAL text and was
# compared against the register's UTC as though the two were one clock. Same
# keys, different values, which is exactly the case `perry-task/events/1.1`
# moved its own minor for. A consumer rendering `at` sees the change.
#
# TASK-205 moves it to `2.3`, and the move is a plain key addition: this
# payload now carries `semantics`, the array below. Nothing already emitted
# changed, so `LIST_SEMANTICS` gains no entry for `2.3` itself —
# `perry-events/list/1.1` added the same key under the same reading.
#
# ADR-019 / TASK-155 moves it to `3.0`, and **`3.0` rather than `2.4`
# because a key is REMOVED.** `linkage.updated` is gone: it was the deleted
# register document's one file-level stamp, and there is no file left for it
# to be the stamp of. Keeping the key at `""` forever was the alternative and
# it is the same mistake `progress` was — a value a consumer reads as "never
# updated" when the truth is "that is not a thing any more". Rule 2 says `2.x`
# only adds keys, so this cannot be a minor; `2.0` set the precedent when it
# removed `progress` for the same reason.
#
# The same version also changes what three values under UNMOVED keys mean —
# `current_provenance.source`, `.asserted_at` and `.asserted_scope` — which
# would have been a minor on its own, on `2.2`'s reading. It is recorded in
# `LIST_SEMANTICS` under `3.0` so a consumer crossing the major is told both
# halves rather than only the removal it cannot miss.
#
# TASK-415 moves it to `3.1`, and adds no key. A MEASURED `current` is
# published to one decimal place — `34.2` where it was `34.21052631578947` —
# and the two ends, `0.0` and `100.0`, are reserved for the exact cases.
# Same key, different number, which is the case `2.2` moved its own minor for;
# `krs[].current_measurement.numerator` and `.denominator` carry the ratio
# unrounded beside it, so nothing is lost, only stated. The same row also
# writes down the invariant a consumer had no way to rely on before — a KR
# whose `current` is MEASURED carries a non-null `target` — which adds no key
# either. Rule 2 is untouched in both halves: nothing is removed and nothing
# is retyped.
#
# TASK-416 moves it to `3.5` (DESIGN-022 § 5.2): four keys on every KR —
# `checks`, `state`, `met`, `fraction` — derived from `check` and
# `measurement` records by `lib.kr_position`. Additive; `target` and `current`
# keep their meaning. It carries a `semantics` entry as `3.2` did, because
# `met` and `fraction` are the first keys since `2.0` removed `progress` that
# say how far along a KR is, and a consumer must read `state` before them.
#
# TASK-264 deliverable 3 moves it to `3.6` (DESIGN-022 § 5.7, ADR-022): two
# keys on every KR — `status` (`active` | `withdrawn`) and `revisions[]` —
# plus `withdrawn_at` and `withdrawn_reason`, from `lib.kr_revisions`, the
# one fold rule. Additive, and it carries a `semantics` entry because the
# fold also changes what existing keys RETURN for a restated KR.
LIST_CONTRACT = "perry-goals/list/3.6"

# **Minors where a value's MEANING changed, not just where a key was added.**
#
# The same rule, shape and order as `bin/perry-task § LIST_SEMANTICS`, and the
# same reason: rule 2 promises `2.x` only adds keys, that promise is unbroken,
# and it does not cover a value that starts returning something different
# under a key that did not move. A consumer records the minor it read against
# and reports every entry newer than that, which is why the list is **ordered
# oldest first** — a slice, not a search. Append; never insert where it reads
# well. `bin/perry-task` shipped 1.5, 1.9, 1.7 once, and a test caught it.
#
# **`2.1` is deliberately not here.** It added four keys and moved no existing
# value. An entry for it would tell a consumer still sitting on `2.0` that a
# field it has never seen changed meaning, which is a false alarm rather than
# a warning — the call `perry-task` made for its own `1.15` and `1.17`, both
# recorded as decisions in `tests/`.
LIST_SEMANTICS = [
    {"version": "2.2",
     "fields": ["krs[].current_provenance.asserted_at",
                "krs[].current_staleness.since",
                "krs[].current_staleness.moved_tasks[].at"],
     "note": "All three are UTC now and carry a `Z`. `at` in particular used "
             "to be the event log's LOCAL text, and it was compared against "
             "the register's UTC as though the two were one clock — so "
             "`current_staleness.stale` answered wrongly inside the machine's "
             "offset, in one direction or the other, on every project not "
             "running at UTC+0. No key was added, removed or retyped; the "
             "same three keys return a different string. A consumer that "
             "parsed these as naive local timestamps, or that compared one of "
             "them against a clock of its own, was correct before 2.2 and is "
             "not now."},
    {"version": "3.0",
     "fields": ["krs[].current_provenance.source",
                "krs[].current_provenance.asserted_at",
                "krs[].current_provenance.asserted_scope",
                "krs[].current_staleness.since",
                "krs[].current_staleness.evaluated"],
     "note": "The assertion date is PER KR now, not per file. `source` reads "
             "`linkage-store` where it read `linkage-register`; "
             "`asserted_scope` reads `kr` where it read `register`; and "
             "`asserted_at` is the KR's own `asserted_at` field rather than "
             "the deleted `phase/<NNN>-linkage.md`'s file-level `updated:` "
             "stamp. The consequence a consumer must handle: an ASSERTED "
             "`current` can now carry `asserted_at: \"\"` and "
             "`asserted_scope: \"\"`, which means nobody recorded when the "
             "number was arrived at — and `current_staleness.evaluated` is "
             "then `false`. Before ADR-019 the date was never empty on an "
             "asserted number, because it belonged to the file rather than to "
             "the number, which is the defect (TASK-155) this removes: "
             "appending one edge re-dated every asserted `current` in the "
             "phase. The same version REMOVES `linkage.updated`, which is "
             "why it is a major; that removal is in the Changelog rather than "
             "here, because a key a consumer can no longer read is not a "
             "meaning it has to re-check."},
    {"version": "3.1",
     "fields": ["krs[].current"],
     "note": "A MEASURED `current` — one whose "
             "`current_provenance.measured` is `true` — is rounded to ONE "
             "DECIMAL PLACE. It was the raw IEEE 754 quotient: `13 / 38` "
             "published as `34.21052631578947`, seventeen significant "
             "figures of a ratio of two small integers, sixteen of them an "
             "artefact of binary floating point. Every consumer rounded it "
             "differently or not at all, so one measurement rendered as "
             "several different numbers and none of them was Perry's. "
             "`0.0` and `100.0` are now RESERVED for the exact cases "
             "(`numerator == 0`, `numerator == denominator`): a ratio "
             "strictly between the ends is never published at an end, so "
             "`1999 / 2000` is `99.9` rather than the `100.0` one decimal "
             "place would otherwise give it, which would claim a phase was "
             "wholly answered about a row that was not. A consumer that "
             "needs the exact ratio divides "
             "`krs[].current_measurement.numerator` by `.denominator`, both "
             "published unrounded as integers; a consumer that needs to know "
             "whether the KR is MET compares those two rather than reading "
             "`current`, which is the comparison the reserved ends exist to "
             "stop it getting wrong. An ASSERTED `current` is unchanged: it "
             "is the number the register was given and nothing rounds it."},
    {"version": "3.2",
     "fields": ["installed"],
     "note": "`installed` is added (TASK-237 3b′). Before 3.2, on a directory that is not a Perry project this payload answered its empty shape at exit 0 — `okr.present` false, `krs` and `objectives` empty, `phase` null — exactly as it answers for a project that has nothing in it, so a consumer could not tell the two apart. `installed: false` now says which. The criterion is `schema/README.md § installed`: `.perry/config.jsonl` at the project root, or a canonical store under the state root; `BOARD.md`, `OKR.md`, `phase/` or `design/` alone do not count. A consumer that read an empty payload as 'this project has nothing' must read `installed` first."},
    {"version": "3.3",
     "fields": ["installed"],
     "note": "`installed` is narrower (TASK-237 Amendment (7), user decision 2026-09-14). At 3.2 a canonical store under the state root counted on its own, so a folder holding only a file named `tasks.jsonl` — another tool's — read `installed: true`. From 3.3 a store counts only when a `.perry/` directory exists at the project root beside it: `installed` is `.perry/config.jsonl` at the project root, or `.perry/` there and a canonical store under the state root (`schema/README.md § installed`). No key moved. A directory holding a store and no `.perry/` now answers `installed: false` with the empty shape at exit 0; every project Perry started writes `.perry/config.jsonl` first and is unaffected."},
    {"version": "3.4",
     "fields": ["krs[].linked_task_completion.done",
