]

_PERRY_STATE = None


def _sibling(name: str):
    """`bin/<name>` as a module, loaded once. The pattern `perry-task` and
    `perry-decide` already use to reach each other's rules rather than copy
    them."""
    import importlib.machinery
    import importlib.util
    mod_name = name.replace("-", "_")
    sys.path.insert(0, str(PERRY_HOME / "bin"))
    spec = importlib.util.spec_from_loader(
        mod_name, importlib.machinery.SourceFileLoader(
            mod_name, str(PERRY_HOME / "bin" / name)))
    mod = importlib.util.module_from_spec(spec)
    # See the identical note in `bin/perry-task`: `dataclasses` resolves
    # `from __future__ import annotations` strings through `sys.modules`.
    sys.modules[mod_name] = mod
    spec.loader.exec_module(mod)
    return mod


def perry_state():
    """`bin/perry-state` as a module — for the track register and nothing else.

    The register lives in `.perry/config.jsonl` and one reader of it already
    exists. A second would be a second opinion about which track is `queue`
    mode, and this tool refuses a promise based on that answer.
    """
    global _PERRY_STATE
    if _PERRY_STATE is None:
        _PERRY_STATE = _sibling("perry-state")
    return _PERRY_STATE


# ── the hand-off contract, as code ────────────────────────────────────────

#: Everything the `goals` lane may write, as paths relative to the state root.
#: `SKILL.md § The hand-off contract`. Stated as a predicate over the whole
#: filesystem rather than as a blacklist of the three files that lane keeps
#: getting wrong: the rule is "no lane writes outside its own", and a list of
#: forbidden names would pass a write to `weekly/` or `evidence/` that the same
#: rule forbids for the same reason.
def owned_by_goals(relative: str) -> bool:
    # `linkage.jsonl` is declared `owner: perry` in `schema/state-schema.json §
    # claims[]` — the same declaration `.perry/events.jsonl` carries, and the
    # same one `okr.jsonl` is written under here. DESIGN-015 § 5.5 says what
    # that buys and what it does not: it removes the FILE-level barrier the
    # hand-off contract imposes, because the edge is a fact spanning two lanes
    # and belongs to neither; it does not make the file a free-for-all. The
    # discipline that replaces it is per record KIND — `goals` writes `kr`,
    # `edge` and `unlinked`; `work` writes `edge` and `unlinked` and never
    # `kr` — and nothing mechanical enforces that yet, which is why every
    # record this tool writes carries `actor` and `via` (§ 7's mitigation:
    # auditable before it is enforced).
    # `plans/` — the planning drafts, DESIGN-020 decision 5 (TASK-444).
    # `okr.jsonl` — `owner: goals` in `schema § claims`; the store `OKR.md`
    # is projected from, and where `kr add|restate|withdraw` appends an
    # overall KR's records (TASK-264 D3).
    return (relative in ("OKR.md", P.LINKAGE_STORE, P.OKR_STORE)
            or relative.startswith(("phase/", "plans/")))


HANDOFF = {
    "BOARD.md": "work", "journal": "work", "PROJECT_STATE.md": "work",
    "evidence": "work", "weekly": "work", "handoff": "work",
    "decisions": "decide", "design": "decide",
}


def assert_owned(state_root: Path, path: Path) -> None:
    """Refuse, by name, any write outside the `goals` lane's own files.

    A lane that needs a change in another lane's file **asks in chat and
    stops** — it does not write and apologise. This is that sentence with a
    stack trace attached, so the rule cannot be broken by a future subcommand
    forgetting it.
    """
    try:
        rel = path.resolve().relative_to(state_root.resolve()).as_posix()
    except ValueError:
        rel = str(path)
    if owned_by_goals(rel):
        return
    lane = HANDOFF.get(rel) or HANDOFF.get(rel.split("/", 1)[0]) or "another lane"
    raise Refused(
        f"`goals` does not write {rel} — it belongs to `{lane}` "
        f"(SKILL.md § The hand-off contract). Hand it off: say what needs to "
        f"change and let `/perry {lane}` write it. Nothing was written")


def write_atomic(state_root: Path, path: Path, text: str) -> None:
    """`lib.write_atomic` behind this lane's hand-off gate.

    The extra argument and the extra line are the whole difference, and they
    are not part of the primitive: `assert_owned` is the `goals` lane refusing
    to write another lane's file (`SKILL.md § The hand-off contract`), which
    only this tool has. The atomic write underneath is everyone's."""
    assert_owned(state_root, path)
    lib.write_atomic(path, text)


def write_okr_and_store(state_root: Path, project_root: Path, okr,
                        touched, quiet: bool = False) -> dict:
    """Write `OKR.md` **and** the store it is a projection of — or neither.

    TASK-092. `OKR.md` is still edited in place, cell by cell, because
    DESIGN-005 § 5.5 rates a re-rendered prose file worse than no writer at
    all — that has not changed and must not. What changes is that the typed
    half of the file now also lives in `okr.jsonl` beside it in the state
    root, and this is the one place the two are written together.

    **The byte comparison is the gate, and it is the check that made this row
    dispatchable at all.** `TASK-037-spec` is marked manual on DESIGN-005 §
    5.5's verdict that "the risk is not one a test catches: the failure mode is
    a file that still parses and no longer reads the way its author wrote it".
    So before either file lands, the store is derived from the text this write
    produced, rendered back, and compared byte for byte with it. A file that no
    longer reads the way its author wrote it fails that comparison by
    definition. It is a refusal rather than a warning, and it happens while
    nothing has been written.

    **A hand edit is REPORTED, never refused.** That is one of Perry's own
    Operating Principles, and this function obeys it rather than inventing a
    second policy beside `check_hand_edit`: a store value the file no longer
    agrees with, on a row this command did not touch, comes back in
    `store_drift` and is printed. It is not silently absorbed — that is the
    measured defect `bin/perry-tasks § write` records, a canonical value
    replaced by the projection and reported as a success — and it is not
    refused either. `perry-okr diff` is where the same drift is asked about on
    its own, and `perry-okr render --write` is the way back.

    `touched` names the record-key prefixes this write is allowed to move.
    """
    text = okr.render()
    store = md_store.OKR.store_path(project_root, state_root)
    derived = md_store.derive(md_store.OKR, text)
    out = {"store": str(store), "store_records": len(derived),
           "store_drift": [], "records_the_file_no_longer_renders": []}
    prior: list[dict] = []
    if store.exists():
        try:
            prior, malformed = md_store.validate_records(
                md_store.load_store(store))
        except (OSError, ValueError) as exc:
            raise Refused(
                f"{store} exists but is not readable JSONL "
                f"({type(exc).__name__}: {exc}). Refusing to overwrite a store "
                f"this tool cannot compare against; move it aside and re-run. "
                f"Nothing was written") from None
        if malformed:
            raise Refused(
                f"{store} is malformed at line {malformed[0]['line']} "
                f"({malformed[0]['message']}); refusing to overwrite a store "
                f"that cannot be safely compared. Nothing was written")

    # **A record whose line has left the file is KEPT (TASK-123).** Deriving
    # the whole store from the text meant a row deleted from `OKR.md` by hand
    # deleted the canonical record with it — the file editing the store, which
    # is the direction ADR-007 reverses, and `perry-okr write --from-file`
    # refuses this exact loss by name (*"the whole record would be dropped"*)
    # while this path performed it and reported success. Nothing renders for a
    # kept record, so `rendered == text` still holds below and `perry-okr diff`
    # stays byte-clean; `perry-okr verify` is where it shows, under
    # `records_not_in_the_file`, which is what "reported rather than honoured"
    # means for a row that is gone rather than changed.
    #
    # No write path in this tool removes a line — `commit` appends, amends and
    # widens — so a key that has left is a hand edit by construction.
    have = {md_store.record_key(r) for r in derived}
    kept = [r for r in prior if md_store.record_key(r) not in have]
    final = derived + kept
    # **Kept and NOT reported, for a `store_only_kinds` record.** Every `kr`
    # record is in `kept` on every commit now, because TASK-236 took those
    # rows out of `OKR.md` for good — so reporting them as rows the file "no
    # longer renders" would print a 38-line warning after every single write
    # and teach the reader to scroll past the one case that matters. They stay
    # in `final` either way: what a store holds is not what a document shows.
    out["records_the_file_no_longer_renders"] = sorted(
        md_store.record_key(r).replace("\x00", "/") for r in kept
        if r.get("kind") not in md_store.OKR.store_only_kinds)
    out["store_records"] = len(final)

    _valid, malformed_now = md_store.validate_records(final)
    if malformed_now:
        raise Refused(
            f"the write would produce an OKR store this tool could not read "
            f"back ({malformed_now[0]['message']}). Two lines of `OKR.md` "
            f"carrying one key is the usual cause. Nothing was written")
    rendered, report = md_store.render(md_store.OKR, text, final)
    if rendered != text:
        where = report.get("first_difference") or {}
        raise Refused(
            f"the OKR store cannot reproduce the file this write would "
            f"produce, so writing either would lose the difference between "
            f"them (first at line {where.get('line', '?')}). That is this "
            f"renderer's bug, not the file's. Nothing was written")
    if prior:
        out["store_drift"] = [
            line for line in md_store.would_discard(prior, final)
            if not md_store.touches(line, touched)]
    if out["store_drift"] and not quiet:
        print(f"perry-goals: ⚠ `OKR.md` was edited by hand since the store was "
              f"last written — {len(out['store_drift'])} value(s) on row(s) "
              f"this command does not touch. The file's values are taken as "
              f"the new truth, which is what a hand edit means; "
              f"`perry-okr diff` asks about it on its own.", file=sys.stderr)
        for line in out["store_drift"][:5]:
            print(f"    {line}", file=sys.stderr)
    if out["records_the_file_no_longer_renders"] and not quiet:
        print(f"perry-goals: ⚠ {len(out['records_the_file_no_longer_renders'])} "
              f"record(s) are in `okr.jsonl` and no longer have a row in "
              f"`OKR.md`: "
              f"{', '.join(out['records_the_file_no_longer_renders'][:5])}. "
              f"The store keeps them — a row deleted from a rendered file does "
              f"not delete what it means (ADR-007 decision 2), and their ids "
              f"are never reused. `perry-okr verify` names them; `perry-okr "
              f"render --write{lib.root_flag(project_root)}` cannot bring a "
              f"deleted row back, so restoring "
              f"one is a hand edit or a new `commit`.", file=sys.stderr)
    write_atomic(state_root, okr.path, text)
    # The store is written second and unconditionally, under the same project
    # lock as the file above, so a reader cannot catch the pair half-written.
    # If the process dies between the two, the next command reports the
    # difference as drift rather than absorbing it in silence.
    lib.write_atomic(store, md_store.store_text(final))
    return out


def project_lock(state_root: Path, timeout: float = 10.0):
    """The same lock `perry-task` and `perry-decide` take, on the same key.

    One lock per project, not one per lane: a `goals` write and a `work` write
    touch different files but the same project, and a reader that catches them
    mid-flight sees a state neither lane intended (DESIGN-005 § 5.4).
    """
    return lib.project_lock(state_root, timeout, Refused)


# ── events ────────────────────────────────────────────────────────────────
#
# `.perry/events.jsonl` is the project's log, not a lane's file — `perry-task`
# appends to it today and DESIGN-005 § 5.2 makes it canonical for tasks in step
# 4. The user accepted that direction on 2026-08-17, BEFORE this writer existed
# and explicitly so that it would not be built against "the file is the truth"
# (DESIGN-005 § 9, last entry). So every write here emits an event, and the
# reconcile direction below is the one that decision implies.
#
# Event names are prefixed `commit-` and never reuse `add` / `route` / `done` /
# `drop`: `perry-state § reconcile_drift` keys the board's orphan detector on
# those four names, and a commitment id it had never seen carrying one of them
# would be reported as a task whose row went missing.


def events_path(project_root: Path) -> Path:
    return project_root / ".perry" / "events.jsonl"


def read_events(project_root: Path) -> list[dict]:
    p = events_path(project_root)
    if not p.exists():
        return []
    try:
        text = p.read_text(errors="replace")
    except OSError:
        # The log is derived and disposable (DESIGN-004 § 5.3). An unreadable
        # one costs history resolution; it must not be able to stop a write to
        # the canonical file, or the derived record would be load-bearing after
        # all.
        return []
    out = []
    for line in text.split("\n"):
        line = line.strip()
        if not line:
            continue
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue  # a corrupt line is not a reason to refuse a write
    return out


COMMIT_EVENTS = ("commit", "commit-update", "commit-close", "commit-miss")


def commitment_events(events: list[dict], cid: str = "") -> list[dict]:
    return [e for e in events if e.get("event") in COMMIT_EVENTS
            and (not cid or e.get("id") == cid)]


def logged_status(events: list[dict], cid: str) -> str | None:
    """What the log says this commitment's `Status` is, or None if it has
    never heard of it.

    None is not "unknown", it is **"predates the tool"** — and the two must not
    be conflated. Every Commitments table alive today was written by hand, and
    treating those rows as hand-edits would make the first write on every real
    project a wall of reconcile prompts about work that was done correctly
    under the old rules. `perry-state § reconcile_drift` makes exactly this
    correction for board rows and gives the reason: a check people learn to
    ignore is worse than no check.
    """
    seen = commitment_events(events, cid)
    return seen[-1].get("to") if seen else None


def append_event(project_root: Path, event: dict) -> bool:
    """Append one event. The canonical file has already landed.

    Same failure direction `perry-task § commit` chose and documents:
    `OKR.md` never disagrees with itself, and the derived record may be
    missing. Losing an event costs history resolution; losing the write costs
    the truth.
    """
    ev = events_path(project_root)
    try:
        ev.parent.mkdir(parents=True, exist_ok=True)
        with open(ev, "a") as fh:
            fh.write(json.dumps(event, ensure_ascii=False) + "\n")
        return True
    except OSError as exc:
        print(f"perry-goals: warning — {event.get('file') or 'canonical state'} "
              f"was written, but the event could "
              f"not be appended to {ev}: {exc}. State is correct; this row will "
              f"read as unrecorded until the log is writable again.",
              file=sys.stderr)
        return False


def plain(x):
    return asdict(x) if is_dataclass(x) else x


def kr_rows(snap, events: list | None = None,
            events_present: bool = False) -> list[dict]:
    """Every KR, flat, with its level and objective attached.

    Three sources, deliberately merged in one pass rather than three shapes:
    `OKR.md`'s overall KRs, the current phase file's KRs, and — where the
    linkage register carries them — `target` / `current` / `tasks`. A KR that
    appears in both the phase file and the register is one KR; the register's
    numbers win, because they are the ones a task edge actually updated.

    **`current` arrives with its provenance from TASK-120.** The register's
    numbers are hand-written and nothing re-derives them, so each row also
    carries who asserted the number and when, whether a linked task has moved
    since, and — separately, never folded in — how many of the linked tasks are
    closed. `bin/lib § kr_progress_provenance` computes all three; see its
    comment for why the tally is beside `current` rather than inside it.
    """
    reg: dict[str, dict] = {}
    lk = getattr(snap, "linkage", None)
    for o in (getattr(lk, "objectives", None) or []):
        for k in (getattr(o, "krs", None) or []):
            reg[k.id] = {"target": k.target, "current": k.current,
                         "due": k.due, "tasks": list(k.tasks or []),
                         # **Per KR, off its own record.** It was the
                         # register document's one file-level `updated:`
                         # stamp until ADR-019, shared by every KR in the
                         # phase — TASK-155.
                         "asserted_at": getattr(k, "asserted_at", "") or ""}
    # `state_root`, not `project_root` — the same sentence the line below has
    # carried since TASK-120, and this call did not. TASK-437: it read
    # `tasks.jsonl` from the PROJECT root, found no file there on any project
    # whose two roots differ, and `task_status_index` fell back to
    # `board.all_tasks` without saying so. Measured on Perry's own project at
    # `076ae21a`: 156 rows against 429 in the store, so every KR's progress
    # below was computed over 36 percent of the work and returned a plausible
    # number. It is invisible wherever the two roots coincide, which is most
    # projects, which is why it survived.
    # TASK-262 round 4b: the store alone. The held board's rows beneath it
    # are retired (`perry-goals/list` 3.4).
    status_by_id = lib.task_status_index(
        getattr(snap, "state_root", "."))
    # Raw store records for the one KR whose metric is re-run rather than read.
    # `state_root`, not `project_root`: the store sits beside the register.
    linkage_records = P.load_linkage_store(getattr(snap, "state_root", "."))
    # DESIGN-022 § 5.1: the current checks and values, ordered once in
    # `lib.kr_checks`. An overall KR is keyed by its OKR version too, because
    # `O1-KR1` exists in more than one version of `okr.jsonl`.
    checks_by_kr = lib.kr_checks(linkage_records)
    okr_version = (getattr(getattr(snap, "okr", None), "version", "") or "")
    # 3.6 (TASK-264 deliverable 3, DESIGN-022 § 5.7): `status` and
    # `revisions[]`, from the one fold rule over each KR's own store. The
    # snapshot's KRs are already folded (`build` passes `lib.fold_kr_records`
    # to `load_snapshot`), so the words below are the restated ones.
    revisions = {
        "phase": lib.kr_revisions(linkage_records or [], P.LINKAGE_STORE)[0],
        "overall": lib.kr_revisions(
            P.load_okr_store(getattr(snap, "state_root", ".")) or [],
            md_store.OKR.rel_store)[0],
    }

    # **The phase's KRs come from the register, not from the phase document.**
    # TASK-157: they used to be declared in both, in full, with nothing
    # comparing them — so this loop read the markdown copy and then overwrote
    # its numbers from the register, which meant a stale title or metric was
    # published and a stale target was not. `phase_key_results` is the one
    # resolver; it reads the document only on a project that has no register.
    phase_objectives = [
        (o, krs) for o, krs in zip(
            getattr(getattr(snap, "phase", None), "objectives", None) or [],
            P.phase_key_results_by_objective(getattr(snap, "phase", None), lk))]
    out = []
    for level, groups in (
            ("overall", [(o, list(o.krs)) for o in
                         (getattr(getattr(snap, "okr", None), "objectives",
                                  None) or [])]),
            ("phase", phase_objectives)):
        for o, group in groups:
            for k in group:
                r = reg.get(k.id, {})
                target, current = r.get("target"), r.get("current")
                out.append({
                    "id": k.id,
                    "level": level,
                    "objective": getattr(o, "title", ""),
                    "title": getattr(k, "text", "") or getattr(k, "title", ""),
                    "metric": getattr(k, "metric", ""),
                    "due": r.get("due", "") or getattr(k, "due", "") or "",
                    "qualifier": getattr(k, "qualifier", ""),
                    "linked_to": getattr(k, "linked", "") or "",
                    "stretch": bool(getattr(k, "stretch", False)),
                    # Numbers or null. NEVER a pre-computed percentage: half
                    # of a real OKR's targets are ceilings, not goals, and a
                    # max-drawdown limit rendered two-thirds achieved is the
                    # worst thing a dashboard can say. Only the project knows
                    # which direction a KR runs, so only the project may draw
                    # the bar. `progress` shipped in 1.0 and is removed here —
                    # that is why this is 2.0 and not 1.1.
                    "target": target,
                    "current": current,
                    "task_ids": r.get("tasks", []),
                    # AFTER `"current"` above, deliberately: for the one KR
                    # whose metric is re-run (DESIGN-015 § 6 row F) this
                    # mapping carries its own `current` and the measured value
                    # replaces the register's here as it does in
                    # `bin/perry-state`. Same helper, same answer — a second
                    # implementation is how the two would come to disagree
                    # about a number that now has only one source.
                    **lib.kr_progress_provenance(
                        current, r.get("tasks", []),
                        asserted_at=r.get("asserted_at", ""),
                        status_by_id=status_by_id,
                        events=events, events_present=events_present,
                        computed=lib.computed_kr_current(
                            k.id, linkage_records=linkage_records,
                            events=events)),
                    # 3.5 (TASK-416, DESIGN-022 § 5.2): `checks`, `state`,
                    # `met`, `fraction`. Derived from `check` / `measurement`
                    # records only — `target` and `current` above are not
                    # read, so a KR with no check is `undeclared` with
                    # `met: null` whatever numbers its record carries.
                    **lib.kr_position(
                        checks_by_kr.get(
                            (k.id, okr_version if level == "overall" else ""),
                            []),
                        task_ids=r.get("tasks", []), events=events),
                    **lib.kr_status(revisions[level].get(
                        (k.id, okr_version if level == "overall" else ""))),
                })
    return out


def days_since(value: str) -> int | None:
    m = re.search(r"\d{4}-\d{2}-\d{2}", value or "")
    if not m:
        return None
    try:
        return (date.today() - datetime.strptime(m.group(0), "%Y-%m-%d").date()).days
    except ValueError:
        return None


def objective_rows(src, lk) -> list[dict]:
    """Objectives with an id where one is *stated*, never invented.

    `OKR.md`'s objectives carry a title and no id — the heading is
    `### Objective 1 — <title>`, and the "1" is ordinal prose, not a handle.
    The linkage register does carry real ids, so an id is taken from there by
    title match and left empty otherwise. Deriving `O1`, `O2` from position
    would be minting a key the file never stated, and a consumer would key on
    it right up until someone reordered two headings.
    """
    by_title = {o.title.strip(): o.id
                for o in (getattr(lk, "objectives", None) or [])
                if getattr(o, "title", "")}
    out = []
    for o in (getattr(src, "objectives", None) or []):
        title = getattr(o, "title", "")
        out.append({"id": by_title.get(title.strip(), ""),
                    "title": title,
                    "krs": [k.id for k in (getattr(o, "krs", None) or [])]})
    return out


def build(project_root: Path, state_root: Path, level: str | None) -> dict:
    # `load_snapshot` takes the STATE root — it reads `root / "OKR.md"` directly.
    # Passing `project_root` made this tool read the wrong directory on every
    # project whose state root is not `.`, and report `okr_present: false` with
    # a payload that looked entirely well-formed. Perry and aiMark both keep
    # their state under `perry/`; both were reported as having no goals, and
    # that number was published to a consumer as measured data.
    # `kr_fold`: every KR is read folded — DESIGN-022 § 5.7's one rule.
    snap = P.load_snapshot(state_root, kr_fold=lib.fold_kr_records)
    okr, ph, lk = snap.okr, snap.phase, getattr(snap, "linkage", None)

    # `present`, `day` and `kr_total` are NOT fields on the parser dataclasses —
    # `perry-state` derives them in its own builder. Reading them with
    # `getattr(x, "present", False)` returned the default on every project and
    # said so to nobody: a live OKR reported `okr_present: false`. Derived here
    # explicitly, from fields that do exist.
    okr_present = bool(okr and (okr.version or okr.mission or okr.objectives))
    phase_day = days_since(ph.started) if ph else None
    # From the register, for the reason `kr_rows` gives: TASK-157 removed the
    # KR table from the phase document, and counting its objectives' `krs`
    # would report 0 on every migrated project.
    phase_krs = len(P.phase_key_results(ph, lk)) if ph else None

    # The event log answers ONE question here: has a linked task moved since
    # the register asserted its numbers. `present` is carried separately from
    # the events themselves because "nothing moved" and "there is no log to ask"
    # are different facts, and a KR that reports the first when it means the
    # second is the shape this whole row exists about.
    events_file = events_path(project_root)
    krs = kr_rows(snap, read_events(project_root), events_file.exists())
    if level:
        krs = [k for k in krs if k["level"] == level]

    # Which source actually answered. A consumer showing a cascade needs to say
    # "no register" rather than "no progress" — they are different facts and
    # only one of them is about the work.
    if getattr(lk, "objectives", None):
        answered_by = "linkage"
    elif okr_present or ph is not None:
        answered_by = "prose"
    else:
        answered_by = "none"

    # DECLARED, never inferred by set arithmetic. A task absent from every KR's
    # `task_ids` might be unlinked, or might be a payload the consumer
    # truncated — only Perry can tell the two apart, so Perry says which.
    # `perry-state` computes this from the same snapshot; it is read here rather
    # than recomputed so the two cannot come to disagree.
    unlinked = []
    try:
        att = P.attribution(snap) if hasattr(P, "attribution") else None
    except Exception:
        att = None
    if att is None:
        linked_ids = {tid for k in krs for tid in k["task_ids"]}
        board = getattr(snap, "board", None)
        rows = (list(getattr(board, "p0", [])) + list(getattr(board, "p1", []))
                + list(getattr(board, "p2", []))) if board else []
        unlinked = sorted({t.id for t in rows if getattr(t, "id", "")
                           and t.id not in linked_ids})

    # Every one of these is a real state a project can be in, and none of them
    # is an error. A project may run goals with no phase, a phase with no
    # linkage register, or an OKR whose KRs carry no metric at all. Reported so
    # a consumer can say which, instead of rendering an empty panel that looks
    # like a failure.
    conformance = {
        "okr_present": okr_present,
        "phase_present": ph is not None,
        "linkage_present": bool(getattr(lk, "objectives", None)),
        "krs_without_metric": [k["id"] for k in krs if not k["metric"]],
        "krs_without_numbers": [k["id"] for k in krs
                                if k["target"] is None or k["current"] is None],
        "krs_not_in_linkage": [k["id"] for k in krs
                               if k["level"] == "phase" and not k["task_ids"]
                               and k["target"] is None],
        "duplicate_kr_ids": sorted(
            {k["id"] for k in krs if [x["id"] for x in krs].count(k["id"]) > 1}),
        # A KR whose linked tasks moved after its `current` was asserted. The
        # number is not wrong here — it is unverifiable, which is a different
        # thing and the only one Perry can establish. There is deliberately NO
        # companion entry for "current disagrees with the linked tasks": that
        # judgement needs the metric re-run, and inferring it from the edges is
        # the fabrication `perry/OKR.md § Operating Principles` forbids.
        "krs_with_stale_current": [k["id"] for k in krs
                                   if k["current_staleness"]["stale"]],
    }

    # Task→KR attribution is deliberately NOT here. It is a derived join over
    # the board, and `perry-state --json § attribution` already computes it from
    # the same snapshot. Recomputing it in a second place is how the two would
    # disagree; a consumer that needs it reads it there, and `krs[].tasks`
    # carries the edges this file can state from the register alone.
    return {
        "contract": LIST_CONTRACT,
        # 3.2: `parsers § installed`, `schema/README.md § installed`.
        "installed": P.installed(project_root),
        # Sorted here rather than trusted to writing order, the same guard
        # `bin/perry-task` puts on its own list: it is consumed as
        # "everything newer than the minor I tested against", which is a
        # slice only while the array is sorted.
        "semantics": sorted(
            LIST_SEMANTICS,
            key=lambda entry: tuple(int(x)
                                    for x in entry["version"].split("."))),
        "project_root": str(project_root),
        "state_root": str(state_root),
        "conformance": conformance,
        "okr": {
            "present": okr_present,
            "version": (okr.version if okr else "") or "",
            "mission": (okr.mission if okr else "") or "",
            "operating_principles": list(getattr(okr, "operating_principles", []) or []),
            "anti_goals": list(getattr(okr, "anti_goals", []) or []),
            "objectives": objective_rows(okr, lk),
        },
        "phase": None if ph is None else {
            "id": getattr(ph, "number", ""),
            "name": getattr(ph, "slug", ""),
            "number": getattr(ph, "number", ""),
            "slug": getattr(ph, "slug", ""),
            "status": getattr(ph, "status", ""),
            "started": getattr(ph, "started", ""),
            "day": phase_day,
            "kr_total": phase_krs,
            "cost_ceiling": getattr(ph, "cost_ceiling_raw", "") or "",
            "objectives": objective_rows(ph, lk),
        },
        "krs": krs,
        "answered_by": answered_by,
        "unlinked_task_ids": unlinked,
        "linkage": {
            "present": bool(getattr(lk, "objectives", None)),
            "phase": getattr(lk, "phase", "") or "",
            # `updated` is GONE from this block (ADR-019 / TASK-155). It was
            # the deleted register document's one file-level stamp, and three
            # readers took it for three different facts. Each of the three is
            # per record now, and `krs[].current_provenance.asserted_at` is
            # the one a consumer of THIS payload wanted.
            "error": getattr(lk, "error", "") or "",
        },
        "counts": {
            "objectives": len(getattr(okr, "objectives", None) or []),
            "krs": len(krs),
            "stretch": sum(1 for k in krs if k["stretch"]),
        },
    }


# ── commit: the commitments register ──────────────────────────────────────
#
# `goals/reference/phases.md § commit <promise>` is this section's
# specification, rule for rule, and TASK-042 closes when that page stops being
# an agent procedure. Every refusal below quotes the sentence it implements.

#: The two column sets, read from the schema rather than restated here.
# ── linkage.jsonl, appended to ─────────────────────────────────────────────
#
# TASK-119 wrote this lane's first register writer, against
# `phase/<NNN>-linkage.md`. ADR-019 deleted that document, and with it ~530
# lines of line-locating, splicing and re-reading machinery that existed
# ENTIRELY because the target was markdown a human might have reformatted:
# `Register`, its YAML-subset flow/block editors, and the `verify` re-read that
# had to prove a splice had not changed a byte it was not asked to change.
# A JSONL store needs none of it. One record is one line, appending is
# appending, and there is no second copy for the write to disagree with.
#
# The two rules the old writer carried survive unchanged, because they were
# never about the file format:
#
# **Never guess an attribution.** `reference/okr-linkage.md`'s one rule:
# resolve by declared edge, then exact Project id, then registered alias, and
# if that does not yield exactly ONE KR, refuse and name the candidates. There
# is no fourth step. A writer that guesses is worse than no writer, because a
# guessed edge is indistinguishable from a declared one the moment it is
# written — and `bin/perry-state § resolve_kr` will then resolve every future
# progress report through it, with no inference of its own to blame.
#
# **`current` is an assertion, so it is never invented.** `target` / `current`
# are numbers or ABSENT. TASK-120 measured what a default costs: six of eight
# phase KRs in this project carry `target: 0`, so an unasserted `current`
# defaulting to `0` makes every drive-to-zero KR read as met on the day the
# register is written. Nothing here writes either field.


def check_writable(value: str, what: str) -> str:
    """Refuse a value the store cannot carry, rather than write a broken one.

    JSON escapes what YAML could not, so the quote rule the markdown register
    needed is gone. What is left is the shape of a register VALUE: one line,
    non-empty. A newline inside an id or a Project name is a paste accident,
    and the attribution registry is the one place this project has said, three
    documents deep, that a wrong answer is worse than no answer.
    """
    value = (value or "").strip()
    if not value:
        raise Refused(f"{what} is empty. Nothing was written")
    if "\n" in value or "\r" in value:
        raise Refused(
            f"{what} contains a line break. A store record is one line. "
            f"Nothing was written")
    return value


# ── link — accepting PMO's attribution hand-off ───────────────────────────


def linkage_store_path(state_root: Path) -> Path:
    """`<state root>/linkage.jsonl` — where an edge is canonically written.

    **DESIGN-015 § 5.6 site 1, and after ADR-019 the whole of it.** `link` is
    this graph's only writer in the goals lane, and the thing it writes that
    anyone reads is a record in this file. There is no longer a second file
    written under the same lock: `phase/<NNN>-linkage.md` is gone, so the
    half-written pair `perry-lint § linkage-store-drift` used to report cannot
    occur.
    """
    return state_root / P.LINKAGE_STORE


class Register:
    """One phase's slice of `linkage.jsonl`, and the records to append to it.

    It keeps the name the four `link_*` functions and their tests already use,
    and nothing else of what it was. The old class held a markdown document as
    a list of lines and spliced into it; this one holds the parsed graph and a
    list of records, because the file underneath is JSONL.

    `graph` is what the refusals are judged against — already linked, linked
    somewhere else, already declared — and it is now the same object the six
    readers see, rather than a store-derived graph checked beside a document
    model that might disagree. Where the two disagreed, `perry-lint §
    linkage-store-drift` reported it; there is one, so it cannot.
    """

    def __init__(self, state_root: Path, phase: str):
        self.state_root = Path(state_root)
        self.phase = phase
        self.path = linkage_store_path(self.state_root)
        self.number = P.linkage_phase_number(phase)
        if not self.number:
            raise Refused(
                f"{phase!r} does not name a phase (`<NNN>-<slug>`), so there "
                f"is no slice of {P.LINKAGE_STORE} to write into. Nothing was "
                f"written")
        if not self.path.exists():
            raise Refused(
                f"no linkage store at {self.path}. `plan-phase` writes the "
                f"phase's `objective` and `kr` records when the phase opens "
                f"(goals/reference/linkage.md § The four moments it changes). "
                f"Nothing was written")
        records = P.load_linkage_store(self.state_root)
        if records is None:
            raise Refused(
                f"{P.LINKAGE_STORE} cannot be read as JSONL — and a register "
                f"Perry cannot read is one this tool must not append to, "
                f"because the append would be judged against a graph nobody "
                f"can see. Run `perry-lint --root .` for the line. Nothing "
                f"was written")
        # Folded (DESIGN-022 § 5.7; TASK-264 D3 repair, V4 finding F3): the
        # graph `link` judges against is the one every reader sees, and
        # `withdrawn` names the KRs that take no new edge or Project.
        self.graph = P.load_linkage(self.state_root, self.number,
                                    kr_fold=lib.fold_kr_records)
        views, _findings = lib.kr_revisions(records, P.LINKAGE_STORE)
        self.withdrawn = {kr: view for (kr, _v), view in views.items()
                          if view["status"] == "withdrawn"}
        if not self.graph.ok:
            raise Refused(
                f"{P.LINKAGE_STORE} declares no key result for phase "
                f"{self.number}, so there is no graph for an edge to attach "
                f"to. `plan-phase` writes one when the phase opens. Nothing "
                f"was written")
        #: The `model` the old class exposed was the DOCUMENT's parse, kept
        #: separate from `graph` because a splice had to be checked against
        #: the file it landed in. One copy, one name — they are the same
        #: object now, and the alias stays so the refusal messages and the
        #: tests that read it need no second vocabulary.
        self.model = self.graph
        #: Records this write appends, flushed by `cmd_link` under the project
        #: lock. `store_retractions` names the task ids whose `unlinked`
        #: record this write removes — the "it renders as both attributed and
        #: drifting" rule, and the only line in this tool that takes a record
        #: out rather than appending one.
        self.store_records: list[dict] = []
        self.store_retractions: list[str] = []

    def diff(self) -> list[str]:
        """The records this write appends and retracts. What `--dry-run` prints."""
        out = [f"-{P.LINKAGE_STORE}  unlinked → {t}"
               for t in self.store_retractions]
        out += [f"+{P.LINKAGE_STORE}  {json.dumps(r, ensure_ascii=False)}"
                for r in self.store_records]
        return out


def linkage_store_text(reg, declared_at: str, actor: str) -> str | None:
    """The store's new text, or `None` when this write touches no record.

    **Appended, and rewritten only to retract.** New records go on the end,
    the way a JSONL store is meant to grow. The one removal is the `unlinked`
    record for a task that just took an edge, which is the rule `link_edge`
    applies: a row that is both attributed and declared drifting is a row the
    graph disagrees with itself about.

    `declared_at` is the moment of THIS write and belongs to the records this
    write appends — that is what a declaration's date is. It is emphatically
    not a file-level stamp: the field that used to be one,
    `phase/<NNN>-linkage.md`'s `updated:`, re-dated every record in the file
    on every write and is what TASK-155 was opened about.
    """
    if not reg.store_records and not reg.store_retractions:
        return None
    lines = [line for line in reg.path.read_text(encoding="utf-8").split("\n")
             if line.strip()]
    if reg.store_retractions:
        kept = []
        for line in lines:
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                # A line this tool cannot read is a line it must not drop.
                #
                # **Unreachable through `Register` today, and kept anyway.**
                # `load_linkage_store` answers `None` for a store with one bad
                # line, and `Register.__init__` refuses on that `None` — so a
                # write never reaches this loop over a file it cannot fully
                # parse. That was NOT true before ADR-019: the graph then fell
                # back to `phase/<NNN>-linkage.md`, the write proceeded, and
                # this branch was the only thing carrying an unreadable line
                # through the rewrite. `tests/test_linkage_store_readers.py §
                # test_a_store_with_a_line_the_writer_cannot_read_is_refused`
                # pins the refusal that replaced it, and deliberately does not
                # pin this line: a test over a branch nothing can reach
                # measures nothing and teaches the next reader that it does.
                kept.append(line)
                continue
            if (isinstance(rec, dict) and rec.get("kind") == "unlinked"
                    and str(rec.get("task") or "") in reg.store_retractions):
                continue
            kept.append(line)
        lines = kept
    for rec in reg.store_records:
        lines.append(json.dumps({**rec, "declared_at": declared_at,
                                 "actor": actor, "via": "link"},
                                ensure_ascii=False))
    return "\n".join(lines) + "\n"


def current_phase(state_root: Path) -> str:
    """The current phase's `<NNN>-<slug>`, or a refusal.

    The same three lines `parsers.load_snapshot` uses to find the phase it
    reads the graph for — deliberately the same rule, because a writer that
    picked a different phase from the one Perry reads would append edges
    nothing resolves.
    """
    _, slug = phase_pointer(state_root)
    if not slug:
        raise Refused(
            "there is no current phase (`phase/CURRENT` is empty or missing), "
            "so there is no linkage graph to write. `/perry goals "
            "plan-phase <slug>` opens one. Nothing was written")
    return slug


def kr_ids(model) -> list[str]:
    return [k.id for o in model.objectives for k in o.krs]


def objective_of(model, kr_id: str) -> str:
    for o in model.objectives:
        for k in o.krs:
            if k.id == kr_id:
                return o.id
    return ""


def resolve_target(model, token: str, where: str) -> str:
    """One KR id, or a refusal naming the candidates. Never a near match.

    `reference/okr-linkage.md § Resolution order`, which `perry-state §
    resolve_kr` already applies on the read side: a declared KR id, then an
    exact Project id, then an exact registered alias — stopping at the first
    step that yields exactly ONE KR. There is no fourth step, and the reason
    is worth keeping next to the code: the whole registry exists so that a
    name which drifted resolves through a recorded alias instead of through a
    resemblance. A writer that fell back to "closest match" would put a
    guessed edge into the one file both Perry and the frontend treat as
    declared truth, where nothing downstream can tell it from a real one.
    """
    ids = kr_ids(model)
    if token in ids:
        return token

    def candidates(match) -> list[tuple[str, str]]:
        out = []
        for p in model.projects:
            if not match(p) or not p.serves_kr:
                continue
            out.append((p.serves_kr, f'{p.serves_kr} (project {p.project_id} '
                                     f'"{p.name}", {p.status})'))
        return out

    live = {id(p) for p in model.projects
            if p.status not in {"dropped", "unlinked"}}
    for label, match in (
            ("Project id", lambda p: p.project_id == token),
            ("name or alias", lambda p: token.strip().lower() in
                [n.lower() for n in [p.name, *p.aliases] if n])):
        hits = candidates(lambda p: match(p) and id(p) in live)
        distinct = sorted({kr for kr, _ in hits})
        if len(distinct) == 1:
            return distinct[0]
        if len(distinct) > 1:
            raise Refused(
                f"{token!r} does not resolve to exactly one KR — it matches "
                f"{len(distinct)} by {label}: "
                + "; ".join(text for _, text in hits) +
                f". Attribution resolves by declared edge, then exact Project "
                f"id, then registered alias, and never by resemblance "
                f"(reference/okr-linkage.md § The one rule). Ask the user "
                f"which KR {where} serves and re-run with that KR id. "
                f"Nothing was written")
        retired = candidates(lambda p: match(p) and id(p) not in live)
        if retired:
            raise Refused(
                f"{token!r} matches only a retired Project by {label}: "
                + "; ".join(text for _, text in retired) +
                f". A dropped Project's KR edge is history, not an "
                f"attribution for new work. Ask the user which KR {where} "
                f"serves. Nothing was written")
    raise Refused(
        f"{token!r} is not a KR id, a Project id or a registered alias in "
        f"this phase's graph. Its KR ids are: {', '.join(ids) or '(none)'}. A "
        f"near-match is not a match — attribution is never guessed from a "
        f"name (reference/okr-linkage.md § The one rule). Ask the user which "
        f"KR {where} serves, or declare it unlinked with "
        f"`link --unlinked {where}`. Nothing was written")


def claimed_by(model, label: str) -> str:
    """Which Project already answers to this name or alias, if any.

    Case-insensitively, because `perry-lint § linkage-names-unique` folds case
    before comparing and a writer that did not would create the exact file the
    linter rejects.
    """
    key = label.strip().lower()
    for p in model.projects:
        if key in [n.strip().lower() for n in [p.name, *p.aliases] if n]:
            return p.project_id
    return ""


def refuse_withdrawn_target(reg: Register, kr: str, what: str,
                            task: str = "") -> None:
    """A withdrawn KR takes no new edge and no new Project (V4 finding F3).

    Its status is `lib.kr_revisions`' answer, read by `Register`; withdrawal
    is terminal, so the recovery is another KR or an unlinked declaration."""
    view = reg.withdrawn.get(kr)
    if not view:
        return
    active = [k for k in kr_ids(reg.graph) if k not in reg.withdrawn]
    raise Refused(
        f"{kr} was withdrawn at {view['withdrawn_at']} "
        f"({view['withdrawn_reason']}), so it takes no new {what}: a "
        f"withdrawn KR leaves every count and is never scored (DESIGN-022 § "
        f"5.7). Name an active KR of this phase instead — "
        f"{', '.join(active) or '(none)'}"
        + (f" — or declare the task unlinked with `link --unlinked {task}`"
           if task else "")
        + ". Nothing was written")


def link_edge(reg: Register, task: str, token: str) -> dict:
    """1 — resolved → append the edge (`goals/reference/linkage.md § link`).

    **Judged against the graph, written to the store, and after ADR-019 those
    are one file.** The question "is this task already linked, and to what" is
    a question about the project; it is answered from `linkage.jsonl`, which is
    also where the answer is written. The old writer asked the store and
    spliced the document, and the two could disagree between the two writes.
    """
    kr = resolve_target(reg.graph, token, task)
    if kr not in kr_ids(reg.graph):
        raise Refused(
            f"{token!r} resolves to {kr}, which this phase's graph does not "
            f"carry as a KR — the Project registry and the objectives "
            f"disagree. Fix the graph first (`perry-lint --root .`). "
            f"Nothing was written")
    refuse_withdrawn_target(reg, kr, "task edge", task)
    holder = reg.graph.kr_for_task(task)
    if holder == kr:
        return {"already": f"{task} is already linked to {kr}"}
    if holder:
        raise Refused(
            f"{task} is already listed under {holder}; linking it to {kr} as "
            f"well would make its attribution ambiguous, and `perry-lint` "
            f"rejects that (`linkage-task-single-kr`). Move it, don't "
            f"duplicate it — remove the edge under {holder} first, on the "
            f"user's confirmation. Nothing was written")
    out = {"kr": kr, "task": task}
    reg.store_records.append({"kind": "edge", "task": task, "kr": kr})
    # "If the task is currently declared unlinked, retract that in the same
    # write — otherwise it renders as both attributed and drifting."
    if task in reg.graph.unlinked:
        reg.store_retractions.append(task)
        out["undeclared_unlinked"] = True
    return out


#: What a task id looks like: one `PREFIX-NUMBER` handle, no whitespace.
#: Deliberately a SHAPE check and not a lookup — see `link_unlinked`.
TASK_ID_SHAPE = re.compile(r"^[A-Za-z][A-Za-z0-9_]*(?:-[A-Za-z0-9_]+)*-\d+$")


def link_unlinked(reg: Register, task: str) -> dict:
    """3 — unresolved → declare it unlinked. A DECLARATION, never inferred.

    **The argument is validated as a shape before anything is written**
    (TASK-227). This path validated nothing at all, and `perry-lint` did not
    check the declarations either, so two malformed ones went in on
    2026-08-28 and the lint reported 0 errors over both:

    - the literal string `NOT-A-TASK-ID at all`, and
    - **48 task ids space-joined into one argument** — `--unlinked` takes one
      positional, word splitting was off in that shell, and the whole sweep
      landed as a single list entry.

    The second is the one that matters: it is not a typo, it is the ordinary
    way this command gets called by a loop, and it failed silently while
    reporting success 48 times.

    A SHAPE check, not a store lookup, and the difference is the point. Two
    ids that both exist would pass a lookup and still be wrong when joined;
    whitespace is what tells them apart. And a declaration about a row that is
    later purged must not become unwritable — `perry-lint`'s
    `linkage-unlinked-exists` is where the store question is asked, at `warn`,
    because a stale declaration is a record to correct rather than a file to
    refuse.
    """
    if " " in task or "\t" in task:
        count = len(task.split())
        raise Refused(
            f"`--unlinked` takes ONE task id and got {count} whitespace-"
            f"separated values in a single argument: {task!r}. This is the "
            f"shape that put 48 ids on one line of `unlinked[]` on "
            f"2026-08-28 — a shell with word splitting off hands the whole "
            f"loop over as one string. Run it once per id. Nothing was written")
    if not TASK_ID_SHAPE.match(task):
        raise Refused(
            f"{task!r} is not a task id. `--unlinked` declares that a KNOWN "
            f"row serves no KR, so the argument has to be a handle something "
            f"can be looked up by — `TASK-123`, `REL-007`. Nothing was written")
    holder = reg.graph.kr_for_task(task)
    if holder:
        raise Refused(
            f"{task} is linked to {holder}. Declaring it unlinked as well "
            f"would render it as both attributed and drifting, and the graph "
            f"would disagree with itself about the same task. Remove the edge "
            f"under {holder} first, on the user's confirmation. Nothing was "
            f"written")
    if task in reg.graph.unlinked:
        return {"already": f"{task} is already declared unlinked"}
    reg.store_records.append({"kind": "unlinked", "task": task,
                              "phase": reg.graph.phase or reg.phase})
    return {"task": task, "unlinked": True}


def link_alias(reg: Register, pid: str, name: str) -> dict:
    """2 — a name was confirmed as an existing Project → append the alias.

    Only on the user's confirmation, which this tool cannot check and does not
    pretend to: what it can check is that the name is not already somebody
    else's, which is the ambiguity the registry exists to prevent.

    **An alias is a NEW `project` record, not an edit to the old one.** The
    store is append-only apart from the one retraction `link_edge` makes, so
    the alias arrives as a second record for the same Project id carrying the
    full alias list; `parsers.linkage_from_store` reads the records in file
    order and the later one wins. Rewriting the earlier line would be this
    writer editing a record it did not write, on a file where every other
    change is an append.
    """
    project = next((p for p in reg.graph.projects if p.project_id == pid), None)
    if project is None:
        raise Refused(
            f"no Project {pid} in this phase's graph. Its Project ids are: "
            f"{', '.join(p.project_id for p in reg.graph.projects) or '(none)'}"
            f". A new one is registered with `link --project <PROJECT-ID> "
            f"<KR-ID> \"<name>\"`. Nothing was written")
    owner = claimed_by(reg.graph, name)
    if owner == pid:
        return {"already": f"{pid} already answers to {name!r}"}
    if owner:
        raise Refused(
            f"{name!r} is already claimed by {owner}. Two Projects answering "
            f"to one name is the duplicate-name trap the registry exists to "
            f"prevent — attribution could not resolve it to one KR, and "
            f"`perry-lint` rejects it (`linkage-names-unique`). Nothing was "
            f"written")
    rec = {"kind": "project", "phase": reg.graph.phase or reg.phase,
           "id": pid, "kr": project.serves_kr, "name": project.name,
           "aliases": list(project.aliases) + [name]}
    if project.status and project.status != "active":
        rec["status"] = project.status
    reg.store_records.append(rec)
    return {"project": pid, "alias": name}


def link_project(reg: Register, pid: str, kr: str, name: str) -> dict:
    """4 — a new Project appeared mid-phase → append it to the registry."""
    if any(p.project_id == pid for p in reg.graph.projects):
        raise Refused(
            f"Project {pid} is already in this phase's graph. A Project "
            f"serves exactly one KR; if this is a second one, it needs its "
            f"own id. Nothing was written")
    if kr not in kr_ids(reg.graph):
        raise Refused(
            f"{kr} is not a KR id in this phase's graph. Its KR ids are: "
            f"{', '.join(kr_ids(reg.graph)) or '(none)'}. A Project is "
            f"registered against a declared KR, never against a new one. "
            f"Nothing was written")
    refuse_withdrawn_target(reg, kr, "Project")
    owner = claimed_by(reg.graph, name)
    if owner:
        raise Refused(
            f"{name!r} is already claimed by {owner}. Two Projects answering "
            f"to one name is the duplicate-name trap the registry exists to "
            f"prevent (`perry-lint § linkage-names-unique`). If this is the "
            f"same Project under a new name, that is an alias: `link --alias "
            f"{owner} \"{name}\"`. Nothing was written")
    # `objective` is DERIVED from the KR id — `P002-O1-KR2` → `O1` — and then
    # checked against the objective the KR actually sits under. The `project`
    # record STORES no objective for exactly this reason (one fact, one
    # place); what this refusal catches is a graph whose own KR ids already
    # disagree with the objectives they sit under, which is a disagreement
    # this writer must not pick a side in.
    # Anchored end to end (TASK-180). The pre-2026-08-28 `P-O1.2` [[old-form]]
    # was prefix-matched here because its phase was nowhere in the id; the
    # new form has every segment labelled, so a partial match would only
    # ever be a malformed id being read halfway. Pinned by
    # `tests/test_linkage_writer.py § TestTheRefusalFires.
    # test_a_kr_id_that_disagrees_with_its_nesting_is_refused` — before
    # that test the anchor could be reverted with nothing going red,
    # because `objective` falls back to the nesting and the refusal below
    # is the only thing that notices.
    m = re.match(r"^P\d{3}-(O\d+)-KR\d+$", kr)
    nests_under = objective_of(reg.graph, kr)
    objective = m.group(1) if m else nests_under
    if m and nests_under and objective != nests_under:
        raise Refused(
            f"{kr} encodes objective {objective} but sits under "
            f"{nests_under} in this graph. Whichever is wrong, this writer "
            f"cannot tell, and a Project entry would have to agree with one "
            f"of them. Fix the graph first (`perry-lint --root .`). "
            f"Nothing was written")
    reg.store_records.append({
        "kind": "project", "phase": reg.graph.phase or reg.phase,
        "id": pid, "kr": kr, "name": name, "aliases": []})
    return {"project": pid, "serves": kr, "objective": objective,
            "name": name}


LINK_MODES = ("alias", "unlinked", "project")


def cmd_link(args, ctx) -> dict:
    """`link` — the only writer of the O→KR→task graph in the goals lane.

        link <TASK-ID> <KR-ID>                     the edge
        link --alias <PROJECT-ID> "<name>"         a confirmed second name
        link --unlinked <TASK-ID>                  a declaration of drift
        link --project <PROJECT-ID> <KR-ID> "<name>"   a new Project
    """
    reg: Register = ctx["register"]
    rest = list(args.rest)
    modes = [m for m in LINK_MODES if getattr(args, m)]
    if len(modes) > 1:
        raise Refused(
            f"--{' and --'.join(modes)} are four different writes; run them "
            f"one at a time. Nothing was written")
    mode = modes[0] if modes else "edge"
    need = {"edge": 2, "alias": 2, "unlinked": 1, "project": 3}[mode]
    usage = {
        "edge": "link <TASK-ID> <KR-ID>",
        "alias": 'link --alias <PROJECT-ID> "<the other name>"',
        "unlinked": "link --unlinked <TASK-ID>",
        "project": 'link --project <PROJECT-ID> <KR-ID> "<name>"'}[mode]
    if len(rest) != need:
        why = ("no KR was named, and attribution is never inferred from a "
               "task id alone (reference/okr-linkage.md § The one rule) — "
               "`link --unlinked <TASK-ID>` is how an unresolved task is "
               "recorded. " if mode == "edge" and len(rest) < 2 else "")
        raise Refused(
            f"{why}{usage} takes {need} argument(s); {len(rest)} given. "
            f"Nothing was written")
    # **`link` takes its values positionally, so there is no flag to name** —
    # `goals/reference/linkage.md` writes the grammar that way and
    # `tests/test_procedures_call_the_tool.py` exists to keep the page and the
    # command in step. The slot is named instead, and it is read out of
    # `usage` rather than re-listed here, so the refusal cannot name a
    # placeholder the usage line above it does not show. `argument N` alone
    # was what the user got, and on a three-argument `--project` that is a
    # position to count out against a grammar they have to go and find.
    slots = re.findall(r"<[^>]+>", usage)
    values = [check_writable(v, f"{slots[n] if n < len(slots) else ''} "
                                f"(argument {n + 1})".strip())
              for n, v in enumerate(rest)]

    if mode == "edge":
        result = link_edge(reg, values[0], values[1])
    elif mode == "unlinked":
        result = link_unlinked(reg, values[0])
    elif mode == "alias":
        result = link_alias(reg, values[0], values[1])
    else:
        result = link_project(reg, values[0], values[1], values[2])

    result["mode"] = mode
    result["file"] = str(reg.path)
    if result.get("already"):
        # Nothing to write, and saying so is the whole answer.
        result["written"] = False
        result["diff"] = []
        return result
    # **THE `updated` BUMP IS GONE, AND SO IS THE WARNING THAT STOOD HERE.**
    #
    # What used to be here: every write bumped `phase/<NNN>-linkage.md`'s
    # file-level `updated:` stamp, because `goals/reference/linkage.md` said
    # every write bumps it and both readers needed it. But TASK-120's
    # `asserted_at` was read FROM that same field, at `asserted_scope:
    # "register"`, because there was no per-KR assertion date. So an edge
    # appended to one KR moved the staleness reference of numbers asserted
    # weeks ago under every other KR: a `current` whose linked task moved
    # yesterday reported STALE before the write and read fresh after it, with
    # nothing about the number changed. One field carried three facts — when
    # the graph changed, when a number was arrived at, and when each of 115
    # imported records was declared.
    #
    # Twenty-four lines here named that defect on every run and declined to
    # fix it, because a per-KR assertion date was a new field in
    # `schema/state-schema.json` and that file is behind this project's safety
    # gate. ADR-019 opened the gate and deleted the document. Each of the
    # three facts is now its own per-record field — `kr.asserted_at`,
    # `edge.declared_at`, `unlinked.declared_at` — so this write dates the
    # records it appends and touches no other. TASK-155 is not fixed here; it
    # is unable to happen here.
    result["diff"] = reg.diff()
    # **DESIGN-015 § 5.6 site 1, and § 5.5's per-kind discipline made
    # auditable.** Every record this lane writes carries `actor` and `via`
    # from the start, because § 7's mitigation for the risk that a lane writes
    # a kind it may not is that the rule be readable off the records.
    # `via: "link"` is the half of `P003-O3-KR2` this path is NOT — the KR
    # counts edges declared in the same action as `add`, and `perry-task add
    # --kr` writing `via: "add"` is row D.
    store_text = linkage_store_text(reg, lib.register_stamp(), args.actor)
    if store_text is not None:
        result["store"] = str(reg.path)
        result["store_records_written"] = len(reg.store_records)
        result["store_records_retracted"] = list(reg.store_retractions)
    event = {"ts": lib.event_stamp(),
             "event": f"link-{mode}", "actor": args.actor,
             "file": reg.path.name,
             **{k: v for k, v in result.items()
                if k in ("task", "kr", "project", "alias", "serves", "name")}}
    result["event"] = event
    if args.dry_run:
        result["dry_run"] = True
        result["written"] = False
        return result
    if store_text is not None:
        write_atomic(ctx["state_root"], reg.path, store_text)
    result["written"] = True
    result["event_written"] = append_event(ctx["project_root"], event)
    return result


def commitment_columns() -> tuple[list[str], list[str]]:
    spec = okr_table_spec(COMMITMENTS_UNDER)
    return list(spec.get("columns") or []), list(spec.get("optional_columns") or {})


#: Which flag a `## Commitments` cell's text arrived on. The register's own
#: column names are what both write paths already key on — `changes` on the
#: amend side, `values` on the create side — so this is the whole translation
#: from "the cell that could not be written" to "the words you typed".
#:
#: `Id` and `Status` are absent on purpose: neither is ever typed. `Id` is
#: minted here and `Status` is one of two literals, so a refusal naming a flag
#: for either would name a flag the caller does not have.
FLAG_FOR_COLUMN = {"Track": "--track", "Promise": "--promise",
                   "To whom": "--to", "Due": "--due",
                   "By when note": "--by-when-note",
                   "Discharged by": "--discharged-by"}


#: The typed half of the promise's clock, and the whole of what `Due` accepts.
#:
#: **The clock regex lived here and is gone** (ADR-007 decision 3, TASK-091).
#: It was one regex asked a natural-language question — *does this cell name a
#: clock?* — over a column holding both an ISO date and free prose. It failed five
#: V4 review rounds in four shapes; the last because `\b` does not exist in
#: Chinese, so the English half matched on word boundaries and the Chinese half
#: on bare substrings, and `下周期` ("next cycle") wrote a live commitment row
#: while `next cycle` was refused. No sixth round: the column split instead.
#:
#: What is left is a **format**, not a judgement. Two spellings, both closed:
#: an ISO date, or the `<n><unit>` SLA shorthand a track's `sla` field
#: already uses. Anything else is not "vague" — it is simply not this field,
#: and it belongs in `By when note`, which nothing validates. The refusal says
#: so and names the flag, so a user is never guessing where their words go.
SLA_TOKEN_RE = lib.SLA_TOKEN_RE  # see `lib.ISO_DATE_RE`

#: `lib.ISO_DATE_RE` — imported, not re-spelled. This module declared itself
#: "the one spelling" while `bin/perry-diagnose` carried a second, unanchored
#: one; a claim of uniqueness that a `grep` disproves is worse than no claim,
#: because it stops the next reader from grepping.
ISO_DATE_RE = lib.ISO_DATE_RE


def real_date(value: str) -> date | None:
    """The `Due` cell as a `date`, or `None` when it does not hold one.

    `None` covers both "empty" and "an SLA token" — neither is a calendar day,
    and every caller here wants a day it can compare against today.
    """
    text = lib.normalize_typed_cell(value)
    if not lib.is_iso_date(text):
        return None
    return date.fromisoformat(text)


def is_sla_token(value: str) -> bool:
    """`3d`, `2w`, `24h` — the shorthand a track's `sla` field writes."""
    return lib.is_sla_token(value)


def tracks_of(project_root: Path) -> list[dict]:
    """The declared tracks — from the STORE, `.perry/config.jsonl`.

    `bin/perry-state § declared_tracks` is the one reader (P003-O2-KR1): this
    used to parse `.perry/config.md § Tracks` directly, which was a projection
    of that store, so a register the store and the file disagreed about had two
    answers depending on which tool asked. ADR-019 then deleted the projection,
    so the store is not merely first — it is the only register there is.

    The empty list stays the answer for a project with no config at all — it is
    what `track_named` turns into "this project declares no tracks", and
    `declared_tracks`' implicit `main` would instead accept every `--track main`
    on a project that never configured Perry.
    """
    if not (project_root / ".perry" / "config.jsonl").exists():
        return []
    ps = perry_state()
    tracks, _source = ps.declared_tracks_detail(project_root)
    # **The store is present and unusable → refuse, do not answer.**
    # TASK-095's V4 round 1 review: this lane writes `phase/` and the linkage
    # register off the track list, so a register quietly missing a track lands
    # in a file the user reads as authoritative. Before ADR-019 the fallback
    # that made that possible was the projection; now it is DESIGN-003's
    # implicit `main`, which is the same silent truncation by another route.
    #
    # The two comparisons that stood here — `tracks_the_register_cannot_place`
    # and `tracks_the_register_contradicts` — both had `## Tracks` as their
    # other side and are gone with it.
    #
    # Whether to refuse is `parsers.config_store_unusable`'s answer — the one
    # predicate `perry-task` and `perry-lint`'s census also call (TASK-270). A
    # zero-record store is usable: it declares no track to lose.
    unusable = P.config_store_unusable(project_root)
    if unusable:
        raise Refused(
            f"the track register cannot be read: {ps.TRACKS_STORE_WHY[unusable]}. "
            f"`.perry/config.jsonl` is the only register, so writing now would "
            f"lay down `phase/` and the linkage register against DESIGN-003's "
            f"implicit `main` rather than this project's tracks. Nothing was "
            f"written. Repair the store — `perry-lint` names the records that "
            f"do not validate.")
    return tracks


def track_named(tracks: list[dict], name: str, flag: str = "") -> dict:
    """The declared track `name`, or a refusal.

    `flag` is passed **only** where the name was typed by the caller. Three of
    the four call sites read it out of a `Track` cell the file already held —
    `--migrate` walking rows, and the amend path checking `--due` against the
    row's own track — and naming `--track` there would send the user to fix a
    flag they never passed.
    """
    for t in tracks:
        if t.get("track") == name:
            return t
    declared = [t.get("track") for t in tracks if t.get("declared")]
    subject = f"{flag} was given {name!r}, which is" if flag else \
        f"track {name!r} is"
    raise Refused(
        f"{subject} not declared in `.perry/config.jsonl`; "
        f"declared: {declared or '(none)'}. A commitment is filed against a "
        f"track, and an undeclared one has no mode and no SLA. Nothing was written")


def check_due(track: dict, value: str) -> None:
    """`phases.md § commit` step 4 — **one column, one value space.**

    | pipeline | an ISO date            | an SLA token is refused: triage
    |          |                        | compares this cell against today
    | queue    | an ISO date, or the    | anything else is refused, and the
    |          | track's SLA shorthand  | refusal names `--by-when-note`

    The predecessor asked whether the cell *named a clock*, over a column that
    also held prose. That is not a question a regex can answer, and the regex
    that tried proved it five times. Here the question is *is this cell an ISO
    date or an SLA token*, which has one answer in every language — and the
    prose that column also carried now has a field nothing asks anything.
    """
    # Both value refusals below name `--due` outright. They can, because
    # `value` is `args.due` at every call site — `--migrate` classifies the
    # file's own cells through `lib.classify_due` and never comes here.
    classification = lib.classify_due(track, value)
    if classification == lib.DUE_UNFILLED:
        raise Refused(
            "--due is required and has no default. A promise with no date is "
            "not a commitment — and `--by-when-note` is a note ABOUT the "
            "deadline, never a substitute for one. Nothing was written")
    if lib.due_track_missing_clock(track):
        raise Refused(
            f"track {track.get('track')!r} is `queue` mode and its record in "
            f"`.perry/config.jsonl` gives it no `sla`. "
            f"A commitment measured against the track's SLA, pointing at "
            f"an empty register, is a promise with no clock at all. Set "
            f"the track's SLA first. Nothing was written")
    if ((track.get("mode") or "project").lower() == "pipeline"
            and classification != lib.DUE_DATE):
        raise Refused(
            f"--due was given {value!r}, and track {track.get('track')!r} is "
            f"`pipeline` mode, so `Due` must be an ISO date (2026-09-30) — "
            f"triage compares this cell against today, and an SLA token has "
            f"no day in it. Nothing was written")
    if classification == lib.DUE_INVALID:
        raise Refused(
            f"--due was given {value!r}, and `Due` is typed: an ISO date "
            f"(2026-09-30) or an SLA token (3d, 2w, 24h). If that is how the "
            f"deadline was WORDED to the party — \"within the track SLA\", "
            f"\"same business day\" — it belongs in `--by-when-note`, which "
            f"is prose and is never validated. Nothing was written")


def commitments_table(okr: Okr) -> tuple[int, int, list[str]]:
    lo, hi = okr.section(COMMITMENTS_HEADING)
    _, header = okr.table(lo, hi)
    return lo, hi, header


def read_commitments(okr: Okr) -> list[dict]:
    """Every row of the register, keyed by canonical column name."""
    lo, hi, header = commitments_table(okr)
    required, optional = commitment_columns()
    at = {c: column_at(header, c) for c in required + optional}
    at["Id"] = commitment_id_at(header)
    out = []
    for i, _ in okr.rows(lo, hi):
        cells = split_row(okr.lines[i])
        row = {"_line": i, "_cells": cells}
        for name, k in at.items():
            row[name] = cells[k] if 0 <= k < len(cells) else ""
        out.append(row)
    return out


#: The column this split replaced. Named once, here, and only ever read — no
#: writer in this file can produce it again.
LEGACY_DUE_COLUMN = "By when"


def legacy_due_at(header: list[str]) -> int:
    """Index of a pre-split `By when` header cell, or -1.

    The **English** spelling only, and that is not an oversight. A Chinese
    register spells the column `截止`, which is `Due`'s own Chinese spelling —
    the two columns are one word in that language, so there is no header cell
    to find and nothing to rename. The split is carried out on the **values**
    instead, which is the half that has an answer in both languages. That is
    the whole lesson of the deleted regex's fifth round, applied to its
    replacement.
    """
    return header_index(header).column(squash(LEGACY_DUE_COLUMN))


def unsplit_rows(okr: Okr, tracks: list[dict]) -> list[str]:
    """Ids whose `Due` cell is neither empty nor typed — a pre-split register.

    A **typed** question asked of a typed column: is this cell an ISO date or
    an SLA token? It is not the deleted regex under another name, because it
    never
    asks what the prose *means* — every answer of "no" routes the cell to a
    field that is never examined again.
    """
    out = []
    for row in read_commitments(okr):
        try:
            track = track_named(tracks, row.get("Track", ""))
        except Refused:
            track = {}
        if lib.classify_due(track, row.get("Due") or "") not in {
                lib.DUE_UNFILLED, lib.DUE_DATE, lib.DUE_DURATION}:
            out.append((row.get("Id") or "").strip() or f"line {row['_line'] + 1}")
    return out


def migrate_commitments(okr: Okr, tracks: list[dict]) -> dict:
    """Split a pre-TASK-091 `By when` column into `Due` + `By when note`.

    A bare ISO date or SLA token stays where it is and is now typed; anything
    else is moved verbatim into `By when note`, which nothing validates. **No
    cell is dropped and no cell is rewritten** — a moved value is the same
    string in a different column, which is what makes the before/after count
    of non-empty clock cells the proof that nothing was lost.

    ADR-004's *a project migrates once*: this runs from `commit --migrate`,
    and every other write path refuses while the register still needs it
    rather than half-splitting a table on the way past.
    """
    lo, hi, header = commitments_table(okr)
    required, optional = commitment_columns()
    out = {"renamed_column": "", "widened": [], "rows": 0,
           "kept_as_due": 0, "moved_to_note": 0, "empty": 0}

    at_due = column_at(header, "Due")
    at_legacy = legacy_due_at(header)
    if at_due < 0 and at_legacy < 0:
        raise Refused(
            "`## Commitments` has neither a `Due` column nor the `By when` "
            "column it replaced, so there is nothing to split. Nothing was "
            "written")
    if at_due >= 0 and at_legacy >= 0 and at_due != at_legacy:
        # Two clock columns, both populated, is not a migration this tool gets
        # to resolve: for a row carrying a date in each, only the person who
        # made the promise knows which one the party is holding them to. It is
        # also a shape nothing here can produce — a hand edit, or a
        # column-adding migration run before `perry-migrate` learned to stand
        # aside. Reported, and the file left alone.
        raise Refused(
            f"`## Commitments` carries BOTH a `Due` column and the retired "
            f"`{LEGACY_DUE_COLUMN}` column it replaced. A row with a value in "
            f"each is two deadlines for one promise, and only the person who "
            f"made it knows which one the party is holding them to. Move the "
            f"cells you want kept into `Due` or `By when note` and delete the "
            f"`{LEGACY_DUE_COLUMN}` column, then re-run. Nothing was written")
    lang = header_language(header, required + optional)
    if at_due < 0:
        sep, _ = okr.table(lo, hi)
        okr.set_cell(sep - 1, at_legacy, display_name("Due", lang))
        out["renamed_column"] = f"{LEGACY_DUE_COLUMN} → Due"
        lo, hi, header = commitments_table(okr)
        at_due = column_at(header, "Due")

    prose: list[tuple[int, str]] = []
    at_track = column_at(header, "Track")
    at_id = column_at(header, "Id")
    for i in okr.row_indexes(lo, hi):
        out["rows"] += 1
        cells = split_row(okr.lines[i])
        raw = cells[at_due] if 0 <= at_due < len(cells) else ""
        try:
            track = track_named(
                tracks, cells[at_track] if 0 <= at_track < len(cells) else "")
        except Refused:
            track = {}
        classification = lib.classify_due(track, raw)
        if classification == lib.DUE_UNFILLED:
            out["empty"] += 1
        elif classification in {lib.DUE_DATE, lib.DUE_DURATION}:
            out["kept_as_due"] += 1
        elif classification in {lib.DUE_PIPELINE_REQUIRES_DATE,
                              lib.DUE_QUEUE_MISSING_CLOCK}:
            cid = cells[at_id] if 0 <= at_id < len(cells) else "—"
            raise Refused(
                f"commitment {cid!r} has `Due` value {raw!r} that its track "
                f"does not allow ({classification}). Migration will not "
                f"relabel a typed value as prose. Fix the track configuration "
                f"or the value, then retry. Nothing was written")
        else:
            prose.append((i, raw.strip()))

    if prose:
        at_note = column_at(header, "By when note")
        if at_note < 0:
            okr.widen(lo, hi, display_name("By when note", lang))
            out["widened"].append("By when note")
            lo, hi, header = commitments_table(okr)
            at_note = column_at(header, "By when note")
        for i, value in prose:
            cells = split_row(okr.lines[i])
            existing = (cells[at_note] if 0 <= at_note < len(cells) else "").strip()
            okr.set_cell(i, at_note,
                         f"{existing} · {value}" if existing else value)
            okr.set_cell(i, at_due, "")
            out["moved_to_note"] += 1
    return out


def commitment_id_at(header: list[str]) -> int:
    at = column_at(header, "Id")
    if at < 0:
        at = column_at(header, "ID")
    if at < 0:
        raise Refused(
            "`## Commitments` has no `Id` column. Board rows point here by "
            "that id and nothing else, so a register without one cannot be "
            "written to. Nothing was written")
    return at


ID_N_RE = re.compile(r"^(?P<track>.+)/(?P<n>\d+)$")


def mint_commitment_id(track: str, rows: list[dict], events: list[dict],
                       stored_ids: "list[str] | tuple[str, ...]" = ()) -> str:
    """`<track>/<n>`, `<n>` one greater than the highest **for that track**.

    `phases.md`: *"Ids are never reused and never renumbered."* So the search
    is over the table AND the event log — a row created by this tool and later
    deleted from the file by hand is gone from the table and still in the log,
    and reusing its number would silently re-point every board row that carries
    it at a different promise. That is the one failure mode worse than a
    dangling link, because nothing looks broken.

    **And over `okr.jsonl`, which is the only one of the three that holds a row
    this tool never wrote.** TASK-123 measured the hole: a register imported
    with `perry-okr write --from-file` puts its rows in the store and NOT in
    the log — `commit` has never seen them — so deleting `ops/1` from the file
    by hand left the number in the store alone, invisible to both lists above.
    The next `commit --track ops` minted `ops/1` a second time, for a different
    promise, and reported success. `store_drift` did not catch it either: the
    new row's key IS `commitment/ops/1`, so `touches` excused the record it had
    just destroyed as this write's own doing. Reproduced end to end; the store
    is the third list because it is the only one that knew.
    """
    seen = [r.get("Id", "") for r in rows]
    seen += [e.get("id", "") for e in commitment_events(events)]
    seen += list(stored_ids)
    highest = 0
    for cid in seen:
        m = ID_N_RE.match((cid or "").strip().strip("*` "))
        if m and m.group("track") == track:
            highest = max(highest, int(m.group("n")))
    return f"{track}/{highest + 1}"


def find_commitment(rows: list[dict], cid: str, flag: str = "") -> dict:
    """The row `cid` names, or a refusal **naming the flag `cid` arrived on**.

    Three flags reach here — `--id`, `--close`, `--miss` — and all three take
    a value, so a mistyped command puts the NEXT flag in the id's place:
    `commit --id main/1 --close --discharged-by x` refused with
    `'--discharged-by' is not a row`, a sentence that names neither the flag
    that swallowed it nor the one that lost its value.
    """
    for r in rows:
        if r.get("Id", "").strip().strip("*` ") == cid:
            return r
    known = [r.get("Id", "") for r in rows]
    where = f"{flag} " if flag else ""
    raise Refused(f"{where}was given {cid!r}, which is not a row in "
                  f"`OKR.md § Commitments`; present: {known or '(none)'}. "
                  f"Nothing was written")


#: The commitment fields a hand edit can move. `kind` is the record's name and
#: `order` is its position — a row dragged up the table changes `order` and
#: says nothing about any value, which is why `perry-lint § check_store_drift`
#: excludes the same field from the same comparison.
COMMITMENT_FIELDS = tuple(f for f in md_store.STORED["commitment"]
                          if f not in ("kind", "order"))


def register_drift(state_root: Path, project_root: Path, okr) -> dict:
    """How `OKR.md § Commitments` differs from `okr.jsonl`, before any edit.

    TASK-123. **This is the read side of TASK-092's write side**, and until it
    existed `OKR.md` had two writers with opposite notions of which artifact is
    true: `perry-okr` treats `okr.jsonl` as canonical and reports a hand edit,
    while every decision `cmd_commit` makes — a row's `Status`, whether its
    `Due` is in the past, what its `Discharged by` already says, which id is
    free — was read out of the markdown and then written back INTO the store as
    the new truth. Three cases were reproduced end to end before this landed:

      * a hand edit to a row the command touches was absorbed into the store
        and **not reported at all** (`store_drift: []`), because `touches`
        excuses that row as the write's own doing;
      * a hand edit to a row the command does not touch was reported as drift
        and then written into the store anyway — reported AND honoured, which
        is the one outcome ADR-007 exists to prevent;
      * an id whose row was deleted by hand was minted again (see
        `mint_commitment_id`).

    So the store is consulted FIRST, and a cell the two disagree about is a
    hand edit: `cmd_commit` refuses on it rather than deciding against a value
    the canonical file does not carry. Nothing here re-renders `OKR.md` — the
    file is not touched, and once the comparison passes, every cell this tool
    reads out of the markdown is provably the store's own value.

    Presence is reported and never refused, because refusing would buy nothing
    that is not already bought: a record whose row has left is KEPT by
    `write_okr_and_store` and named in `records_the_file_no_longer_renders`,
    its id is protected by `mint_commitment_id`, and `find_commitment` refuses
    by name for a row that is not there. Nothing is lost by proceeding, and
    `phases.md`'s own worked example deletes a row by hand and expects the next
    `commit` to go through.

    A project with no store is not drifted, it **predates the store** — the
    same distinction `logged_status` draws for the log, and for the same
    reason: every register alive today was written by hand, and treating those
    as edits makes the first write on every real project a wall of prompts.
    """
    store = md_store.OKR.store_path(project_root, state_root)
    out = {"store": str(store), "compared": False, "stored_ids": [],
           "disagreements": [], "in_the_store_not_in_the_file": [],
           "in_the_file_not_in_the_store": []}
    if not store.exists():
        return out
    try:
        on_disk = md_store.load_store(store)
    except (OSError, ValueError) as exc:
        raise Refused(
            f"{store} exists but is not readable JSONL "
            f"({type(exc).__name__}: {exc}), so `OKR.md` cannot be compared "
            f"against the file it is a projection of. Move it aside and "
            f"re-run. Nothing was written") from None
    prior, malformed = md_store.validate_records(on_disk)
    if malformed:
        raise Refused(
            f"{store} is malformed at line {malformed[0]['line']} "
            f"({malformed[0]['message']}), so `OKR.md` cannot be compared "
            f"against it. Nothing was written")

    def by_id(records: list[dict]) -> dict:
        return {r.get("id", ""): r for r in records
                if r.get("kind") == "commitment" and r.get("id")}

    stored = by_id(prior)
    live = by_id(md_store.derive(md_store.OKR, okr.text))
    out["compared"] = True
    out["stored_ids"] = sorted(stored)
    for cid in sorted(set(stored) & set(live)):
        for field in COMMITMENT_FIELDS:
            was, now = stored[cid].get(field) or "", live[cid].get(field) or ""
            if was != now:
                out["disagreements"].append(
                    {"id": cid, "field": field, "store": was, "file": now})
    out["in_the_store_not_in_the_file"] = sorted(set(stored) - set(live))
    out["in_the_file_not_in_the_store"] = sorted(set(live) - set(stored))
    return out


def check_register_drift(drift: dict, accept: bool, quiet: bool = False,
                        root_flag: str = "") -> None:
    """Refuse a write decided against a cell `okr.jsonl` does not carry.

    `--accept-hand-edit` is the documented way past it and keeps the meaning it
    already has everywhere else in this tool: **the FILE's value becomes the
    new truth**, and the next write records it. That is DESIGN-005 § 9's
    reconcile — *never silently overwritten, and never silently authoritative
    either* — which is strictly stronger than ADR-007's "reported rather than
    honoured" and satisfies it. `perry-okr diff` asks the same question on its
    own, and `perry-okr render --write` is the other way back.
    """
    if not drift["disagreements"]:
        return
    shown = [f"{d['id']}.{d['field']}: `okr.jsonl` holds "
             f"{d['store'] or '(empty)'!r}, `OKR.md` reads "
             f"{d['file'] or '(empty)'!r}" for d in drift["disagreements"]]
    if accept:
        if not quiet:
            print(f"perry-goals: ⚠ taking the FILE's value on "
                  f"{len(shown)} cell(s) `okr.jsonl` disagrees with, because "
                  f"`--accept-hand-edit` says so:", file=sys.stderr)
            for line in shown[:5]:
                print(f"    {line}", file=sys.stderr)
        return
    raise Refused(
        f"{len(shown)} cell(s) of `OKR.md § Commitments` disagree with "
        f"`okr.jsonl`, which is the canonical record of this register "
        f"(ADR-007 decision 2) — someone edited the row by hand:\n    "
        + "\n    ".join(shown[:5])
        + (f"\n    … and {len(shown) - 5} more" if len(shown) > 5 else "")
        + f"\n\n  This write reads those cells to decide what to do, so it "
          f"will not run against a value the store does not carry. Re-run "
          f"with `--accept-hand-edit` to take `OKR.md`'s values as the truth "
          f"and record them, or `perry-okr render --write{root_flag}` to put "
          f"the file back in line with the store. Nothing was written")


def check_hand_edit(events: list[dict], row: dict, accept: bool) -> str:
    """The reconcile step DESIGN-005 § 9 requires, in the direction it names.

    The log became canonical for tasks on the user's signature, and the cost
    accepted with it was that a hand edit *"raises a reconcile prompt instead —
    never silently overwritten, and never silently authoritative either"*. So
    the file's value is never replaced by the log's; the disagreement is
    reported, and `--accept-hand-edit` records the FILE's value as the new
    truth. A row the log has never heard of predates the tool and is not an
    edit at all — see `logged_status`.
    """
    expected = logged_status(events, row.get("Id", ""))
    actual = (row.get("Status") or "").strip().strip("*` ")
    if expected is None or squash(expected) == squash(actual):
        return actual
    if not accept:
        raise Refused(
            f"{row.get('Id')} was last written by this tool as "
            f"`{expected}` and `OKR.md` now reads `{actual or '(empty)'}` — "
            f"someone edited the row by hand. That edit is not overwritten and "
            f"not ignored: re-run with `--accept-hand-edit` to take "
            f"`{actual or '(empty)'}` as the truth and record it, or fix the "
            f"row first. Nothing was written")
    return actual


COMMITMENTS_NOTE_FROM_TEMPLATE = "the section is copied from OKR_TEMPLATE.md"


def template_commitments_block() -> list[str]:
    """`goals/state/OKR_TEMPLATE.md § Commitments`, header and note included,
    minus the placeholder row.

    Copied, not restated — `phases.md` says to create the section *from the
    template*, and a second wording of that note in this file would be one more
    place for it to drift out of step with the one users read.
    """
    if not TEMPLATE_PATH.exists():
        raise Refused(f"no template at {TEMPLATE_PATH}; cannot create the "
                      f"`## Commitments` section. Nothing was written")
    doc = Okr(TEMPLATE_PATH)
    lo, hi = doc.section(COMMITMENTS_HEADING)
    sep, _ = doc.table(lo, hi)
    block = [l for l in doc.lines[lo:sep + 1]]
    while block and not block[-1].strip():
        block.pop()
    return block


def cmd_commit(args, ctx) -> dict:
    """Add, update, close or miss one row of `OKR.md § Commitments`."""
    okr, sr = ctx["okr"], ctx["state_root"]
    events = ctx["events"]
    # **The store is consulted before any decision is made against the file.**
    # Every branch below reads `Status`, `Due`, `Discharged by` and the set of
    # ids out of the markdown; `okr.jsonl` is what those fields MEAN (ADR-007
    # decision 2), so a cell the two disagree about is a hand edit and this
    # write does not get to act on it. `--dry-run` is gated too — a plan
    # computed against a drifted file is a plan for a file nobody has.
    drift = register_drift(sr, ctx["project_root"], okr)
    check_register_drift(drift, args.accept_hand_edit, quiet=args.as_json,
                         root_flag=lib.root_flag(ctx["project_root"]))
    ending = args.close or args.miss
    if args.close and args.miss:
        raise Refused("--close and --miss end a commitment two different ways; "
                      "pass one. Nothing was written")
    if args.migrate and (ending or args.id or args.track or args.due
                         or args.by_when_note or args.promise or args.to):
        raise Refused(
            "--migrate splits the register's clock column and writes nothing "
            "else; it does not take a row's flags. Run it alone, then commit. "
            "Nothing was written")

    if args.migrate:
        if not okr.has_section(COMMITMENTS_HEADING):
            raise Refused(
                "`OKR.md` has no `## Commitments` section, so there is no "
                "register to split. Nothing was written")
        counts = migrate_commitments(okr, ctx["tracks"])
        result = {"migrated": counts, "id": "—", "created_section": False,
                  "widened": list(counts["widened"]), "file": str(okr.path),
                  "register_drift": drift}
        result["event"] = {
            "ts": lib.event_stamp(),
            "event": "commit-migrate", "id": "—", "track": "",
            "actor": args.actor, "from": None, "to": None,
            "counts": result["migrated"]}
        if args.dry_run:
            result["dry_run"] = True
            result["would_write"] = okr.render() != okr.text
            return result
        # `--migrate` rewrites the clock cell of EVERY commitment row, so every
        # commitment key is touched. Nothing else in the file is.
        result.update(write_okr_and_store(
            sr, ctx["project_root"], okr, touched=("commitment/",),
            quiet=args.as_json))
        result["event_written"] = append_event(ctx["project_root"], result["event"])
        return result

    created_section = False
    if not okr.has_section(COMMITMENTS_HEADING):
        if ending or args.id:
            raise Refused(
                "`OKR.md` has no `## Commitments` section, so there is no row "
                "to end. Nothing was written")
        # `phases.md` step 1: refuse if the section is absent and no track is
        # `pipeline` or `queue`. `OKR_TEMPLATE.md` says to omit the section
        # entirely on an all-`project` project, so creating it because someone
        # typed `commit` would add a spine to a shape that has no use for one.
        modes = {(t.get("mode") or "project").lower() for t in ctx["tracks"]}
        if not modes & {"pipeline", "queue"}:
            raise Refused(
                "`OKR.md` has no `## Commitments` section and no track in "
                "`.perry/config.jsonl` is `pipeline` or `queue` mode. "
                "That section is the spine for exactly those two modes "
                "(modes/pipeline.md, modes/queue.md); on an all-`project` "
                "project a KR is the commitment, and the party is the project "
                "itself. Nothing was written")
        # Where the template puts it: after Mission / Operating Principles and
        # BEFORE the version blocks. The fallbacks are in that order for a
        # reason a real file made visible — gimegime-pmo has no level-2
        # `## Anti-Goals` (it nests one inside each version) and its
        # `## Versioning` sits at the very bottom, so an Anti-Goals-then-
        # Versioning rule dropped the section between the last version block
        # and the log, which is the one place in that file it does not belong.
        okr.insert_section(
            template_commitments_block(),
            before=[r"Anti-Goals\b|反目标", r"v\d+\s*[::]", r"Versioning|版本记录"])
        created_section = True

    lo, hi, header = commitments_table(okr)
    # ADR-004's *a project migrates once*, at the one point it can be enforced.
    # A register still carrying the pre-split column is not half-fixed on the
    # way past a `--close`: the split is a separate, named, countable write.
    #
    # It speaks only about a table that is OTHERWISE the schema's shape. A
    # register missing `To whom` has cells sitting under the wrong headers
    # entirely, so `Due` reads whatever the shift put there — reporting that
    # as "prose in Due" would name the wrong defect, and the create branch and
    # `perry-lint` already name the right one. `Due` itself is excluded from
    # the test, because a pre-split table is missing it by definition.
    if not created_section:
        misshapen = [c for c in commitment_columns()[0]
                     if c != "Due" and column_at(header, c) < 0]
        stale = [] if misshapen else unsplit_rows(okr, ctx["tracks"])
        if not misshapen and (legacy_due_at(header) >= 0 or stale):
            raise Refused(
                f"`OKR.md § Commitments` predates the `By when` split "
                f"(ADR-007 decision 3): "
                + (f"the table still has a `{LEGACY_DUE_COLUMN}` column"
                   if legacy_due_at(header) >= 0 else
                   f"{len(stale)} row(s) hold prose in `Due` — {stale[:4]}")
                + f". `Due` is typed and `By when note` is prose, and this "
                  f"tool will not write into a table that still mixes them. "
                  f"Run `perry-goals commit "
                  f"--migrate{lib.root_flag(ctx['project_root'])}` first: it "
                  f"moves each cell into the field its value belongs to and "
                  f"drops nothing. Nothing was written")
    rows = read_commitments(okr)
    required, optional = commitment_columns()
    widened = []

    def ensure(column: str) -> int:
        nonlocal lo, hi, header, rows
        at = column_at(header, column)
        if at >= 0:
            return at
        lang = header_language(header, required + optional)
        header = okr.widen(lo, hi, display_name(column, lang))
        widened.append(column)
        lo, hi = okr.section(COMMITMENTS_HEADING)
        rows = read_commitments(okr)
        return column_at(header, column)

    if ending:
        cid = args.close or args.miss
        row = find_commitment(rows, cid, "--close" if args.close else "--miss")
        was = check_hand_edit(events, row, args.accept_hand_edit)
        to = "closed" if args.close else "missed"
        if squash(was) == to:
            raise Refused(f"{cid} is already `{to}`. Nothing was written")
        if args.miss and not (args.reason or "").strip():
            raise Refused(
                "--miss needs a reason: it is the record of what happened, and "
                "the party the promise was made to is the one person who "
                "cannot see the row. Nothing was written")
        if args.close and not (row.get("Discharged by") or "").strip() \
                and not (args.discharged_by or "").strip():
            raise Refused(
                f"{cid} has an empty `Discharged by`. A promise closed with no "
                f"account of how is indistinguishable from one abandoned "
                f"quietly — pass `--discharged-by <one line>`. Nothing was written")

        okr.set_cell(row["_line"], column_at(header, "Status"), to)
        note = (args.reason if args.miss else args.discharged_by) or ""
        if note.strip():
            at = ensure("Discharged by")
            row = find_commitment(read_commitments(okr), cid)
            existing = (row.get("Discharged by") or "").strip()
            # `Discharged by` is the one cell two different flags write, so
            # the column is not enough to name it — `--miss` fills it from
            # `--reason` and `--close` from `--discharged-by`.
            flag = "--reason" if args.miss else "--discharged-by"
            with naming_the_flag(flag):
                okr.set_cell(row["_line"], at,
                             f"{existing} · {note.strip()}" if existing
                             else note.strip())
        result = {"id": cid, "from": was, "to": to}
        event = {"ts": lib.event_stamp(),
                 "event": "commit-close" if args.close else "commit-miss",
                 "id": cid, "track": row.get("Track", ""),
                 "promise": row.get("Promise", ""),
                 "note": note.strip(), "actor": args.actor,
                 "from": was, "to": to}

    elif args.id:
        row = find_commitment(rows, args.id, "--id")
        was = check_hand_edit(events, row, args.accept_hand_edit)
        changes = {}
        if args.due is not None:
            # `phases.md`: *"A missed commitment is recorded, never silently
            # re-dated."* Editing `Due` on a promise whose date has passed
            # erases the fact that it was missed, and the party it was made to
            # is the one person who cannot see the edit.
            current = real_date(row.get("Due", ""))
            if current and current < date.today() and squash(was) == "active":
                raise Refused(
                    f"{args.id}'s `Due` is {current:%Y-%m-%d}, which is in "
                    f"the past, and its `Status` is `active` — that promise was "
                    f"missed. Re-dating it here would erase the fact, and the "
                    f"party it was made to is the one person who cannot see the "
                    f"edit. Use `--miss {args.id} --reason <what happened>`, "
                    f"then `commit` a new row under the new date. "
                    f"Nothing was written")
            check_due(track_named(ctx["tracks"], row.get("Track", "")), args.due)
            changes["Due"] = args.due
        # **`By when note` is prose and this is the whole of its handling.**
        # No format check, no vocabulary, no regex — ADR-007 rule 2. It is not
        # swept into the whitespace guard below either: clearing the note is
        # how a wrong one is withdrawn, and `Due` still carries the promise.
        if args.by_when_note is not None:
            changes["By when note"] = args.by_when_note
        # **Whitespace-only is a refusal on create and was an ERASE on amend.**
        # `--promise '   '` was rejected outright by the create branch and
        # silently wiped the cell here, because this path tested `is not None`
        # where the other tests `.strip()`. The user's promise text was gone,
        # the event recorded the spaces, and nothing said so. Same tool, same
        # value, two answers — the defect this whole task is about, one flag
        # further along.
        #
        # `--discharged-by ''` is deliberately NOT swept in: clearing it is how
        # a mistaken discharge is undone, and there is no other way to say
        # "this is not discharged after all".
        for _flag, _column in (("promise", "Promise"), ("to", "To whom")):
            _v = getattr(args, _flag)
            if _v is not None and not _v.strip():
                raise Refused(
                    f"--{_flag} was given only whitespace, which would erase "
                    f"the {_column} cell rather than change it. Pass the new "
                    f"text, or use --close / --miss to retire the row. "
                    f"Nothing was written")
        if args.promise is not None:
            changes["Promise"] = args.promise
        if args.to is not None:
            changes["To whom"] = args.to
        if args.discharged_by is not None:
            changes["Discharged by"] = args.discharged_by
        if not changes:
            raise Refused(
                f"--id {args.id} with nothing to change. Pass --by / --promise "
                f"/ --to / --discharged-by, or use --close / --miss. "
                f"Nothing was written")
        for column, value in changes.items():
            at = ensure(column)
            line = find_commitment(read_commitments(okr), args.id)["_line"]
            with naming_the_flag(FLAG_FOR_COLUMN.get(column, "")):
                okr.set_cell(line, at, value)
        result = {"id": args.id, "changed": sorted(changes)}
        event = {"ts": lib.event_stamp(),
                 "event": "commit-update", "id": args.id,
                 "track": row.get("Track", ""), "changed": changes,
                 "actor": args.actor, "from": was, "to": was}

    else:
        if not (args.track or "").strip():
            raise Refused("--track is required: a commitment is filed against a "
                          "track, and the track's mode decides what `Due` "
                          "may say. Nothing was written")
        if not (args.promise or "").strip():
            raise Refused("--promise is required. Nothing was written")
        if not (args.to or "").strip():
            # `phases.md` step 3, and it is a routing rule, not a validation
            # one: the tool says where the thing belongs instead.
            raise Refused(
                "--to is required and has no default. A promise with no named "
                "party is a KR, and belongs under an Objective in this file "
                "rather than in the commitments register. Nothing was written")
        track = track_named(ctx["tracks"], args.track, "--track")
        check_due(track, args.due or "")
        cid = mint_commitment_id(args.track, rows, events,
                                 drift["stored_ids"])
        values = {"Id": cid, "Track": args.track, "Promise": args.promise,
                  "To whom": args.to, "Due": args.due,
                  # Prose, written exactly as given and never inspected.
                  "By when note": args.by_when_note or "",
                  # `phases.md` step 5: `Status: active`, `Discharged by` empty.
                  # That cell is free prose describing HOW the promise gets
                  # satisfied; it is never a list of row ids.
                  "Status": "active",
                  "Discharged by": args.discharged_by or ""}
        missing = [c for c in required if column_at(header, c) < 0]
        if missing:
            raise Refused(
                f"`## Commitments` is missing the column(s) {missing}, which "
                f"`schema/state-schema.json` declares required. Fix the table's "
                f"header first — widening it here would pad every row of a "
                f"register this tool did not write. Nothing was written")
        if values["Discharged by"]:
            ensure("Discharged by")
        if values["By when note"]:
            ensure("By when note")
        order = [canonical_of(h, required + optional) for h in header]
        # A row is written in one call, so which flag is named depends on
        # which CELL `render_row` refused — `exc.index` is a position in this
        # list, and this list is the only place that position has a meaning.
        with naming_the_flag([FLAG_FOR_COLUMN.get(c, "") for c in order]):
            _, line = okr.append_table_row(
                lo, hi, [values.get(c, "") for c in order])
        result = {"id": cid, "row": line, "track": args.track}
        event = {"ts": lib.event_stamp(),
                 "event": "commit", "id": cid, "track": args.track,
                 "mode": (track.get("mode") or "project").lower(),
                 "promise": args.promise, "to_whom": args.to,
                 "due": args.due, "by_when_note": args.by_when_note or "",
                 "actor": args.actor, "from": None, "to": "active"}

    result["created_section"] = created_section
    result["widened"] = widened
    result["file"] = str(okr.path)
    result["register_drift"] = drift
    result["event"] = event
    if args.dry_run:
        result["dry_run"] = True
        result["would_write"] = okr.render() != okr.text
        return result
    # The one row this command wrote. A widened table pads every OTHER row of
    # the register too, so `widened` opens the whole kind — a padding change is
    # this write's doing, not a hand edit somebody made.
    touched = ("commitment/",) if widened or created_section \
        else (f"commitment/{result['id']}",)
    result.update(write_okr_and_store(
        sr, ctx["project_root"], okr, touched=touched,
        quiet=args.as_json))
    result["event_written"] = append_event(ctx["project_root"], event)
    return result


def canonical_of(header_cell: str, names: list[str]) -> str:
    """Which declared column this header cell is, or the cell itself.

    Table-local, for the reason `column_spellings` gives. A cell the schema
    does not declare keeps its own name so a project's extra column is filled
    from `values` if the caller named it and left empty otherwise — never
    dropped, and never shifted into by position.
    """
    key = header_index([header_cell])[0]
    for name in names:
        if key in set(column_spellings(name)):
            return name
    return key


# ── `krs` — the phase's key results, printed from the one place they live ──
#
# TASK-157, under DESIGN-013 § 5.1 (locked 2026-08-29): *a fact that has a
# schema lives in exactly one store; a document holds what has no schema; no
# field lives in both.*
#
# A phase KR's id, title, metric, target and linked overall KR are schema'd
# fields of `linkage.jsonl` (they were fields of `phase/<NNN>-linkage.md`
# until ADR-019 deleted that file). They were ALSO written into a markdown
# table in `phase/<NNN>-<slug>.md`, by hand, by `plan-phase` — the same four
# facts twice, in two files in one directory, with nothing comparing them.
# `perry-lint` reported drift for six declared stores and nothing for this
# pair, and the markdown copy is the one that went stale: `P003-O2-KR1` read a
# target its register did not.
#
# The table is gone from the document. This is where a human reads it now, and
# it is READ-ONLY: it prints, it never writes, and there is nothing for a hand
# edit to drift from because there is no second copy to edit. That is the whole
# difference between this and the reconcile the row was originally scoped to
# build — see `perry/evidence/2026-08/TASK-157-result.md`.

def kr_table_columns() -> list[str]:
    """The header the phase document's KR table carried.

    A reader who knew that table meets the same four columns here. Read out of
    the schema rather than retyped: `perry-lint` still validates an adopted
    project's table against that list, and a second copy would disagree the day
    a column is added — silently, because an extra column would simply not be
    printed.
    """
    for spec in load_schema().get("files", []):
        if spec.get("path", "").startswith("phase/[0"):
            for table in spec.get("tables", []):
                if "Objective" in (table.get("under") or ""):
                    return list(table.get("columns") or [])
    raise Refused("schema/state-schema.json declares no phase KR table; this "
                  "tool cannot invent a header for one")


def phase_number_to_read(state_root: Path, phase: str | None) -> str:
    """Which phase's slice of the store to read — the current one, or `--phase`.

    `--phase` takes the number (`003`) rather than the slug, because that is
    the half of `<NNN>-<slug>` that cannot be misremembered and it is what
    every record in the store is filtered by.
    """
    if not phase:
        return P.linkage_phase_number(current_phase(state_root))
    number = str(phase).strip()
    if not re.fullmatch(r"\d{3}", number):
        raise Refused(f"--phase takes a three-digit phase number such as "
                      f"`003`, not {phase!r}")
    return number


def cmd_krs(args, ctx) -> dict:
    """`krs` — every KR of one phase, from `linkage.jsonl`.

    Read-only by construction: it takes no write path, appends no event and
    holds no `--write`. `perry-goals link` is still the register's only writer.

    **DESIGN-015 § 5.6 site 2, finished by ADR-019.** Every field printed
    here — ids, titles, `metric`, `target`, `current`, `stretch`, `linked`,
    and the edges under each KR — comes from `linkage.jsonl`. `metric` and
    `due` used to be read from `phase/<NNN>-linkage.md` beside it, on the
    ground that an argument about a number belongs in a document; that
    document is gone, so there is one file and one answer.
    """
    if args.rest:
        raise Refused(f"`krs` takes no positional arguments and no `--write`; "
                      f"got {' '.join(args.rest)!r}. It is a READ — the phase "
                      f"document has no KR table for it to write into, which "
                      f"is the whole of TASK-157. Nothing was printed")
    number = phase_number_to_read(ctx["state_root"], args.phase)
    # Folded (DESIGN-022 § 5.7): a restated KR prints its new words, and a
    # withdrawn one stays listed with its status.
    model = P.load_linkage(ctx["state_root"], number,
                           kr_fold=lib.fold_kr_records)
    if model.error:
        raise Refused(f"{P.LINKAGE_STORE} does not read as a linkage graph "
                      f"({model.error}). A half-read graph would print a KR "
                      f"table missing whichever rows it dropped, which is the "
                      f"one thing this command must never do")
    if not model.ok:
        raise Refused(f"{P.LINKAGE_STORE} declares no key result for phase "
                      f"{number}. `plan-phase` writes them when the phase "
                      f"opens; nothing was printed, because an empty table "
                      f"and a phase with no register read the same")
    # **The measured KRs are spliced here too** (TASK-382). `k.current` is the
    # register record's typed number, and for a KR in `lib.COMPUTED_KR_METRICS`
    # the register holds none at all — the metric is RE-RUN from
    # `linkage.jsonl` and `.perry/events.jsonl` on every read.
    # `bin/perry-state` and `perry-goals list` both splice it through
    # `lib.kr_progress_provenance`; this command read the register straight and
    # published `null` for the only KR in the register that is actually
    # measured. Same helper as the other two, deliberately: a second
    # implementation is how three publishers of one number come to disagree,
    # which is the whole of this row.
    linkage_records = P.load_linkage_store(ctx["state_root"])
    events = read_events(ctx["project_root"])

    def _current(k):
        computed = lib.computed_kr_current(
            k.id, linkage_records=linkage_records, events=events)
        if computed is None:
            return k.current
        # `"current"`, the same key `lib § kr_progress_provenance` reads off
        # the same mapping (`out["current"] = computed.get("current")`), so the
        # three publishers cannot drift by spelling a key differently.
        return computed.get("current")

    # DESIGN-022 § 5.2, from the same function `perry-goals list` calls. A
    # phase KR's checks carry `okr_version: ""`.
    checks_by_kr = lib.kr_checks(linkage_records)
    views, _findings = lib.kr_revisions(linkage_records or [], P.LINKAGE_STORE)
    objectives = []
    for obj in model.objectives:
        objectives.append({
            "id": obj.id, "title": obj.title,
            "krs": [{"id": k.id, "text": k.title,
                     "metric": P.kr_metric_cell(k), "linked": k.linked,
                     "target": k.target, "current": _current(k),
                     "stretch": bool(k.stretch), "tasks": list(k.tasks or []),
                     **lib.kr_position(checks_by_kr.get((k.id, ""), []),
                                       task_ids=list(k.tasks or []),
                                       events=events),
                     **lib.kr_status(views.get((k.id, "")))}
                    for k in obj.krs],
        })
    return {"register": P.LINKAGE_STORE, "phase": model.phase,
            "objectives": objectives,
            "counts": {"objectives": len(objectives),
                       "krs": sum(len(o["krs"]) for o in objectives)}}


def render_krs(result: dict) -> str:
    """The payload → the markdown the phase document used to carry.

    Rendered through `tables.render_row`, which is the one row renderer in this
    repository: a cell holding a `|` is escaped so it reads back as itself, and
    a cell holding a line break is REFUSED rather than written as a row that
    silently swallows the rest of the table.
    """
    columns = kr_table_columns()
    out = [f"# Phase {result['phase'] or '—'} — key results",
           f"> Declared in `{result['register']}`. This is a render, not a "
           f"file: the store is the only place these values live."]
    for obj in result["objectives"]:
        out += ["", f"## {obj['id']} — {obj['title']}", ""]
        if not obj["krs"]:
            out.append("_no key results declared under this objective_")
            continue
        out.append(render_row(columns))
        out.append(render_separator(len(columns)))
        for kr in obj["krs"]:
            out.append(render_row([kr["id"], withdrawn_marked(kr, kr["text"]),
                                   kr["metric"] or "—",
                                   kr["linked"] or "—"]))
    return "\n".join(out)


def withdrawn_marked(kr: dict, text: str) -> str:
    """A KR's text cell, with DESIGN-022 § 5.7's marker when it is withdrawn.

    `withdrawn <date>: <reason>` — the date is the `withdrawn_at` stamp's day,
    cut from the typed field and not parsed out of prose. A withdrawn row is
    never dropped from a render: it stays visible with the reason it left."""
    if kr.get("status") != "withdrawn":
        return text
    day = str(kr.get("withdrawn_at") or "")[:10]
    return (f"{text} — withdrawn {day}: {kr.get('withdrawn_reason') or ''}"
            .strip())


# ── `krs --level overall` — the OKR's key results, printed from `okr.jsonl` ──


#: The columns of the KR table `OKR.md` used to carry, in the order it carried
#: them. Derived from `md_store.KR_COLUMNS` rather than retyped, so the render
#: and the scanner that used to read those rows cannot disagree about either
#: the spelling of a header or the field behind it — the "one cell model"
#: rule ADR-007 exists to keep (`bin/perry-okr § the record shape`).
OVERALL_KR_COLUMNS = ("Id", "KR", "Metric / Target", "Stretch?", "Deadline")
OVERALL_KR_FIELDS = ("id", "text", "metric", "stretch", "deadline")


def overall_kr_model(state_root, project_root, want_version: str | None):
    """`okr.jsonl` → versions → objectives → KRs, in stored order.

    **Reads the store and nothing else.** `OKR.md` no longer carries these
    rows (TASK-236), so there is no second place to disagree with and no
    markdown to fall back to — the fallback is what `DESIGN-013 § 5.1` calls a
    fact with two homes. A project whose `okr.jsonl` is absent is REFUSED by
    the caller rather than printed as an empty table, because an empty
    register and a project that never had one read the same.
    """
    store = md_store.OKR.store_path(project_root, state_root)
    if not store.exists():
        raise Refused(
            f"no `{md_store.OKR.rel_store}` beside `{md_store.OKR.rel_file}` "
            f"— the overall key results live in that store and there is none "
            f"here. `perry-okr write --from-file"
            f"{lib.root_flag(project_root)}` builds one from an `OKR.md` that "
            f"still carries KR tables. Nothing was printed")
    try:
        good, malformed = md_store.validate_records(md_store.load_store(store))
    except (OSError, ValueError) as exc:
        raise Refused(
            f"`{md_store.OKR.rel_store}` does not read as JSONL "
            f"({type(exc).__name__}: {exc}). A half-read store would print a "
            f"KR table missing whichever rows it dropped, which is the one "
            f"thing this command must never do")
    if malformed:
        # **Refused, not filtered.** Dropping the bad records and printing the
        # rest is how a reader publishes a short table that looks complete —
        # TASK-437's shape, one register over.
        who = "; ".join(sorted(
            f"{m.get('key') or 'line ' + str(m.get('line'))} — "
            f"{m.get('message', 'unreadable')}" for m in malformed))
        raise Refused(
            f"{len(malformed)} record(s) in `{md_store.OKR.rel_store}` are "
            f"badly typed and this command will not print a table with them "
            f"silently missing ({who}). `perry-lint` names them too; nothing "
            f"was printed")

    # **Folded (DESIGN-022 § 5.7).** A KR restated by a `kr_revision` record
    # prints its new words, and a withdrawn one keeps its row, with its status
    # — the one rule, `lib.kr_revisions`, over the records this store holds.
    views, _findings = lib.kr_revisions(good, md_store.OKR.rel_store)
    good = lib.fold_kr_records(good, md_store.OKR.rel_store)
    objectives = [r for r in good if r.get("kind") == "objective"]
    krs = [r for r in good if r.get("kind") == "kr"]

    #: Version blocks in the order the store holds them; the LAST is current,
    #: the same way `## v<N>` blocks run oldest-first down `OKR.md`.
    order: list[str] = []
    for r in objectives + krs:
        if r.get("version") and r["version"] not in order:
            order.append(r["version"])
    if want_version and want_version not in ("all", "current"):
        if want_version not in order:
            raise Refused(
                f"`--version {want_version}` is not a version this store "
                f"holds. It has {len(order)}: {', '.join(order)}. Nothing "
                f"was printed")
        wanted = [want_version]
    elif want_version == "all":
        wanted = list(order)
    else:
        wanted = order[-1:]

    out = []
    placed: set[int] = set()
    for version in wanted:
        objs = []
        vobjs = [o for o in objectives if o.get("version") == version]
        # **THE JOIN IS A LOOKUP, AND THE IDENTITY IS CHECKED BEFORE IT**
        # (USER-929 answer C, part A). Four V4 rounds FAILed this join, each on
        # a different bad VALUE: round 2 lost one row, round 3 invented 75 from
        # blank keys, round 4 invented 3 from a DUPLICATE key. Each fix excluded
        # one value from `objective_id == obj["id"]` and the next round found
        # another, because nothing made that comparison an identity.
        #
        # So the objectives of a version are keyed by id FIRST, and a version
        # in which two objectives share an id is refused before a single key
        # result is placed. A dict cannot hold two objectives under one key,
        # which is the point: once `by_id` exists, a key result belongs to at
        # most one objective by construction rather than by a filter someone
        # has to keep correct.
        #
        # **Blank ids are not keys, and that is deliberate rather than a gap.**
        # An objective with no id can hold no key result, so every KR naming a
        # blank or unknown `objective_id` is left unplaced and the residual
        # below refuses NAMING EACH KR — which is what a reader with a
        # half-migrated store (`DESIGN-009` step 1 writes both blank) needs to
        # act on. Refusing here instead would name objectives, not the rows.
        #
        # Ids are compared stripped on both sides, so a padded id is the same
        # id. Round 4's reviewer found either `.strip()` deletable with every
        # test green; `TestTheJoinIsAnIdentity` pins both.
        by_id: dict[str, dict] = {}
        shared: dict[str, list] = {}
        for o in vobjs:
            oid = str(o.get("id") or "").strip()
            if not oid:
                continue
            if oid in by_id:
                shared.setdefault(oid, [by_id[oid]]).append(o)
            else:
                by_id[oid] = o
        if shared:
            said = "; ".join(
                f"{oid} is carried by "
                + ", ".join(repr(o.get("heading") or o.get("title") or "?")
                            for o in group)
                for oid, group in sorted(shared.items()))
            raise Refused(
                f"version {version!r} has {len(shared)} objective id(s) that "
                f"more than one objective carries: {said}. A key result names "
                f"its objective by that id, so it cannot be placed under one "
                f"of them without guessing and would be printed under all of "
                f"them — measured, three key results rendered as six. Nothing "
                f"was printed. Give each objective its own id in the store. "
                f"`perry-okr migrate-ids{lib.root_flag(project_root)}` used "
                f"to mint one id for two "
                f"same-titled objectives in a single version block and now "
                f"refuses to; a store it wrote before that is the likeliest "
                f"source")
        rows_for: dict[str, list] = {oid: [] for oid in by_id}
        for k in krs:
            if k.get("version") != version:
                continue
            key = str(k.get("objective_id") or "").strip()
            if key in rows_for:
                rows_for[key].append(k)
                placed.add(id(k))
        for obj in vobjs:
            oid = str(obj.get("id") or "").strip()
            rows = rows_for.get(oid, []) if oid else []
            objs.append({
                "id": obj.get("id", ""), "heading": obj.get("heading", ""),
                "title": obj.get("title", ""),
                "krs": [{**{f: (k.get(f) or "") for f in OVERALL_KR_FIELDS},
                         **lib.kr_status(views.get(
                             lib.kr_revision_key(k, md_store.OKR.rel_store)))}
                        for k in rows],
            })
        out.append({"version": version, "objectives": objs})

    # **THE RESIDUAL, and it is the whole of TASK-236's V4 FAIL.**
    #
    # The join above is `objective_id == obj["id"]` inside a loop over
    # OBJECTIVES, so a `kr` record that matches no objective is emitted
    # nowhere — and the renderer below then prints the survivors' count as
    # fact. Measured on this project: orphan ONE kr's `objective_id` and
    # `krs --level overall` renders 37 of 38 at exit 0 while `perry-okr diff`
    # reports `identical: true` AND
    # `every_line_and_cell_came_from_the_store: true`, and `perry-lint`
    # reports 0 errors with `OKR store: 0 row(s) drifted`. Five
    # user-producible corruptions do it: `objective_id` orphaned, blanked or
    # removed; an unknown `version`; a blank `id`.
    #
    # **Refusing is the sibling's rule, not a new one.** `cmd_krs` forty lines
    # up already says it about a half-read graph: *"would print a KR table
    # missing whichever rows it dropped, which is the one thing this command
    # must never do."* The same sentence is true here and this is where it
    # becomes code.
    #
    # Scoped to the WANTED versions, deliberately: with `--version v2` the v3
    # records are not orphans, they are out of scope, and reporting them would
    # be a refusal that fires on every correct store.
    stranded = [k for k in krs
                if k.get("version") in wanted and id(k) not in placed]
    if stranded:
        def _name(k):
            return (str(k.get("id") or "").strip()
                    or f"<no id, version {k.get('version') or '?'}>")
        raise Refused(
            f"{len(stranded)} key result(s) in the store belong to no "
            f"objective and would be dropped from this render: "
            f"{', '.join(sorted(_name(k) for k in stranded))}. Each carries "
            f"an `objective_id` that is blank, or that no objective record in "
            f"its version carries — a BLANK one is not a wildcard, it matches "
            f"no objective rather than all of them, which is what stops a "
            f"half-migrated store rendering every key result under every "
            f"objective. A table printed here would be missing them and the count "
            f"beneath it would report the survivors as the whole. Nothing was "
            f"printed. The store is where this is fixed: give each one an "
            f"`objective_id` that exists, or give the objective a record. "
            f"`perry-okr diff` cannot see this — a record with no line to land "
            f"in is invisible to a byte comparison")
    return out, order


def cmd_overall_krs(args, ctx) -> dict:
    """`krs --level overall` — every KR of the OKR, from `okr.jsonl`.

    Read-only by construction, like its phase-level twin: no write path, no
    event, no `--write`, and no project lock (see `main`).

    **This is the surface `OKR.md`'s KR tables used to be**, and TASK-236
    deleted those on the strength of `perry-okr diff` proving the store
    reproduced them byte for byte first. `ADR-019` is the rule: structured
    state lives in the store, and a document holds what has no schema. The
    `### Objective N` headings stay in the markdown because they are what
    these rows hang from — see the Bound of that row's spec.
    """
    if args.rest:
        raise Refused(f"`krs` takes no positional arguments and no `--write`; "
                      f"got {' '.join(args.rest)!r}. It is a READ — `OKR.md` "
                      f"has no KR table for it to write into, which is the "
                      f"whole of TASK-236. Nothing was printed")
    versions, known = overall_kr_model(
        ctx["state_root"], ctx["project_root"], getattr(args, "version", None))
    return {
        "register": md_store.OKR.rel_store,
        "level": "overall",
        "versions": versions,
        "known_versions": known,
        "counts": {
            "versions": len(versions),
            "objectives": sum(len(v["objectives"]) for v in versions),
            "krs": sum(len(o["krs"])
                       for v in versions for o in v["objectives"]),
        },
    }


def render_overall_krs(result: dict) -> str:
    """The payload → the tables `OKR.md` used to carry.

    Rendered through `tables.render_row`, the one row renderer in this
    repository, so a cell holding a `|` reads back as itself and a cell
    holding a line break is REFUSED rather than written as a row that
    swallows the rest of the table.

    **Every cell is printed whole.** `list --level overall` truncates KR text
    to a fixed column width, which is a legitimate thing for a dashboard to do
    and the wrong thing for the surface that replaced the document: the KR
    text on this project runs to 341 characters and the argument is in the
    words. Nothing here is elided.
    """
    columns = list(OVERALL_KR_COLUMNS)
    out = [f"# OKR — key results",
           f"> Declared in `{result['register']}`. This is a render, not a "
           f"file: the store is the only place these values live.",
           f"> Versions in this store: "
           f"{', '.join(result['known_versions']) or '—'}."]
    for block in result["versions"]:
        out += ["", f"## {block['version']}"]
        for obj in block["objectives"]:
            out += ["", f"### {obj['heading'] or obj['title']}", ""]
            if not obj["krs"]:
                out.append("_no key results declared under this objective_")
                continue
            out.append(render_row(columns))
            out.append(render_separator(len(columns)))
            for kr in obj["krs"]:
                out.append(render_row(
                    [(withdrawn_marked(kr, kr[f]) if f == "text" else kr[f])
                     or "—" for f in OVERALL_KR_FIELDS]))
    counts = result["counts"]
    out += ["", f"{counts['krs']} key result(s) under "
                f"{counts['objectives']} objective(s) across "
                f"{counts['versions']} version block(s)."]
    return "\n".join(out)


# ── `measure` and `check` — DESIGN-022 § 5.3 (TASK-264) ─────────────────────
#
# **What these two write, and nothing else.** One `measurement` or one `check`
# record, appended to `linkage.jsonl`, and one event. The shapes are
# `schema/state-schema.json § stores.declared["linkage.jsonl"].records`, which
# TASK-416 declared; nothing here adds a field. What a record MEANS — which
# declaration is current, which value is current, whether it is met — is not
# decided here either: `lib.kr_checks` holds both ordering rules and
# `lib.kr_position` the derivation, and every reader calls them. A writer that
# picked "the current check" by its own rule would be a second opinion about
# the answer the readers publish.
#
# **Every refusal compares typed values** (NN-4). `--label` is prose and is
# checked for one line only; `--evidence` is checked for EXISTENCE under the
# project and nothing is read out of it.
#
# **The journal is not written**, and that is the lane's rule rather than an
# omission: `journal/` belongs to `work` (`HANDOFF` above) and `assert_owned`
# refuses it, as it does for `link` and `commit`. The record lands first and
# the event is appended after it under the same project lock — `append_event`'s
# failure direction, and `event_written` in the payload says whether it did.

#: The flags each writer takes. `perry-goals` declares no `SURFACE`, so the
#: rule `bin/ARCHITECTURE.md § NN-B2` states — a declared flag on a subcommand
#: that does not list it exits 2 — is held here for the surface this row adds:
#: these two subcommands refuse every flag not in their set, and every other
#: subcommand refuses the flags only these two take.
KR_WRITER_FLAGS = {
    "measure": ("--root", "--json", "--dry-run", "--actor", "--okr-version",
                "--check", "--value", "--evidence"),
    "check": ("--root", "--json", "--dry-run", "--actor", "--okr-version",
              "--id", "--direction", "--target", "--baseline", "--label"),
}
#: `kr add|restate|withdraw` (DESIGN-022 § 5.7, TASK-264 deliverable 3).
#: Each op takes its own set, refused at exit 2 like the two above: a
#: `withdraw` given `--set` would otherwise drop it in silence.
KR_OP_FLAGS = {
    "add": ("--root", "--json", "--dry-run", "--actor", "--okr-version",
            "--objective", "--text", "--set", "--reason"),
    "restate": ("--root", "--json", "--dry-run", "--actor", "--okr-version",
                "--set", "--reason"),
    "withdraw": ("--root", "--json", "--dry-run", "--actor", "--okr-version",
                 "--reason"),
}
KR_WRITER_FLAGS["kr"] = tuple(dict.fromkeys(
    f for flags in KR_OP_FLAGS.values() for f in flags))
KR_WRITER_ONLY_FLAGS = frozenset(
    {"--okr-version", "--check", "--value", "--evidence", "--direction",
     "--target", "--baseline", "--label", "--objective", "--text", "--set"})

KR_WRITER_USAGE = {
    "measure": "perry-goals measure <KR-ID> [--okr-version V] --check S "
               "--value N --evidence <path> --actor <who>",
    "check": "perry-goals check <KR-ID> [--okr-version V] --id S "
             "--direction D --target N [--baseline N] --label \"…\" "
             "--actor <who>",
    "kr": "perry-goals kr add <KR-ID> [--okr-version V] --objective O "
          "--text \"…\" [--set FIELD=VALUE…] --reason \"…\" --actor <who> | "
          "kr restate <KR-ID> [--okr-version V] --set FIELD=VALUE… "
          "--reason \"…\" --actor <who> | kr withdraw <KR-ID> "
          "[--okr-version V] --reason \"…\" --actor <who>",
}


#: `objective add` (TASK-475). Only `add`: the store declares no objective
#: revision kind, and an objective id, like a KR id, is never reused.
KR_WRITER_USAGE["objective"] = ("perry-goals objective add <O-ID> --text "
                                "\"<title>\" --reason \"…\" --actor <who>")
KR_WRITER_FLAGS["objective"] = ("--root", "--json", "--dry-run", "--actor",
                                "--text", "--reason")


def linkage_record_spec(kind: str) -> dict:
    """The schema's declaration of one `linkage.jsonl` record kind — read, not
    restated, so the id and slug shapes refused here are `perry-lint`'s."""
    spec = (load_schema().get("stores", {}).get("declared", {})
            .get(P.LINKAGE_STORE, {}).get("records", {}).get(kind))
    if not spec:
        raise Refused(f"schema/state-schema.json declares no `{kind}` record "
                      f"on {P.LINKAGE_STORE}; this tool cannot invent one. "
                      f"Nothing was written")
    return spec


def typed_number(flag: str, text) -> "int | float":
    """A JSON number from a flag's value, or a refusal naming the flag.

    An integer stays an integer (`1702`, not `1702.0`), so the record says
    what was typed. `nan` and `inf` are refused: JSON cannot carry them and
    no comparison against a target means anything with one.
    """
    raw = str(text if text is not None else "").strip()
    if re.fullmatch(r"[+-]?\d+", raw):
        return int(raw)
    try:
        value = float(raw)
    except ValueError:
        value = None
    if value is None or not math.isfinite(value):
        raise Refused(f"{flag} takes a number; {raw!r} is not one. Nothing "
                      f"was written")
    return value


def required_flag(args, attr: str, flag: str, cmd: str) -> str:
    value = getattr(args, attr, None)
    if value is None:
        raise Refused(f"{flag} is required. Usage: {KR_WRITER_USAGE[cmd]}. "
                      f"Nothing was written")
    return value


def kr_flag_hint(kr: str, okr_version: str) -> str:
    """The `<KR-ID> [--okr-version "V"]` half of a recovery command."""
    return (kr if not okr_version
            else f"{kr} --okr-version {json.dumps(okr_version, ensure_ascii=False)}")


def resolve_kr_for_writer(ctx, kr_id: str, okr_version, *,
                          linkage_optional: bool = False) -> dict:
    """`<KR-ID> [--okr-version V]` → exactly one KR, or a refusal.

    Returns `{"kr", "okr_version", "level", "phase"}`. The key is the one
    `lib.kr_checks` files records under: `(kr, "")` for a phase KR and
    `(kr, <the okr.jsonl version label>)` for an overall KR.

    - A **phase KR** is a `kind: "kr"` record of `linkage.jsonl`.
    - An **overall KR** is a `kind: "kr"` record of `okr.jsonl`, read through
      `overall_kr_model` — the reader `krs --level overall` prints from — and
      its version is the record's `version` label, matched EXACTLY
      (`TASK-416`'s readers key on the full `v4: 2026-09-15`).
    - `--okr-version ""` names the phase KR; `--okr-version V` the overall one.
    - Without `--okr-version`, the id must name one KR: an overall id carried
      by two versions, or by a phase and a version, is refused with each
      candidate named, because `O1-KR1` exists in v2, v3 and v4 of this
      project's own store and a number filed under the wrong one is invisible
      to every reader.
    """
    kr_id = check_writable(kr_id, "<KR-ID>")
    records = P.load_linkage_store(ctx["state_root"])
    store = linkage_store_path(ctx["state_root"])
    if records is None:
        if store.exists():
            raise Refused(
                f"{P.LINKAGE_STORE} cannot be read as JSONL, and a record "
                f"appended to a store Perry cannot read is one no reader will "
                f"see. `perry-lint{lib.root_flag(ctx['project_root'])}` names "
                f"the line. Nothing was written")
    # `kr restate` / `kr withdraw` of an overall KR write `okr.jsonl` and
    # need no linkage store: with none, no phase KR can match.
    if records is None and linkage_optional:
        records = []
    elif records is None:
        raise Refused(
            f"no {P.LINKAGE_STORE} at {store}. Checks and measurements are "
            f"records in that store, beside the KRs `plan-phase` writes there "
            f"(goals/reference/phases.md § plan-phase). Nothing was written")
    phase_hits = [r for r in records if isinstance(r, dict)
                  and r.get("kind") == "kr" and str(r.get("id") or "") == kr_id]

    overall_versions: list[str] = []
    okr_store = md_store.OKR.store_path(ctx["project_root"], ctx["state_root"])
    if okr_store.exists() and okr_version != "":
        versions, _order = overall_kr_model(
            ctx["state_root"], ctx["project_root"], "all")
        for block in versions:
            if any(k.get("id") == kr_id for o in block["objectives"]
                   for k in o["krs"]):
                overall_versions.append(block["version"])

    if okr_version == "":
        if not phase_hits:
            raise Refused(
                f"{kr_id} is not a phase KR in {P.LINKAGE_STORE}, and "
                f"`--okr-version \"\"` names a phase KR. `perry-goals krs` "
                f"lists the current phase's KR ids; an overall KR is named "
                f"with `--okr-version \"<version>\"` (`perry-goals krs --level "
                f"overall --version all`). Nothing was written")
        return {"kr": kr_id, "okr_version": "", "level": "phase",
                "phase": str(phase_hits[-1].get("phase") or "")}

    if okr_version is not None:
        if okr_version not in overall_versions:
            carried = (", ".join(json.dumps(v, ensure_ascii=False)
                                 for v in overall_versions) or "none")
            raise Refused(
                f"no overall KR {kr_id} in OKR version {okr_version!r}. The "
                f"version is matched exactly, as its full label. Versions "
                f"carrying {kr_id}: {carried}. `perry-goals krs --level "
                f"overall --version all` prints every version's KR ids. "
                f"Nothing was written")
        return {"kr": kr_id, "okr_version": okr_version, "level": "overall",
                "phase": ""}

    candidates = ([f"phase KR {kr_id} (`--okr-version \"\"`)"]
                  if phase_hits else [])
    candidates += [f"overall KR {kr_id} in "
                   f"`--okr-version {json.dumps(v, ensure_ascii=False)}`"
                   for v in overall_versions]
    if len(candidates) > 1:
        raise Refused(
            f"{kr_id} names {len(candidates)} KRs: {'; '.join(candidates)}. "
            f"A number filed under the wrong one is read by no reader of the "
            f"other, so it is not guessed. Re-run with `--okr-version` naming "
            f"one of them. Nothing was written")
    if phase_hits:
        return {"kr": kr_id, "okr_version": "", "level": "phase",
                "phase": str(phase_hits[-1].get("phase") or "")}
    if overall_versions:
        return {"kr": kr_id, "okr_version": overall_versions[0],
                "level": "overall", "phase": ""}
    raise Refused(
        f"{kr_id} resolves to no KR: it is not a `kr` record in "
        f"{P.LINKAGE_STORE} or in {md_store.OKR.rel_store}. `perry-goals krs` "
        f"lists the phase's KR ids and `perry-goals krs --level overall "
        f"--version all` the OKR's. Nothing was written")


def refuse_closed_kr(ctx, target: dict) -> None:
    """`measure`'s two refusals about WHEN: a scored phase, a past OKR version.

    Both read a typed field. A phase's status is the header block
    `parsers.parse_phase` reads (`**Status**: scored`, the line
    `score-phase` step 7 flips); the current OKR version is the one
    `overall_kr_model` selects from the canonical store for `krs --level
    overall`. The markdown projection may lag or lead that store; it cannot
    authorize a measurement against a past version.
    """
    if target["level"] == "phase":
        slug = target["phase"]
        doc = ctx["state_root"] / "phase" / f"{slug}.md"
        status = ""
        if slug and doc.is_file():
            status = P.parse_phase(slug, doc.read_text(encoding="utf-8")).status
        if status.strip().lower() == "scored":
            raise Refused(
                f"{target['kr']} belongs to phase {slug}, which is scored "
                f"(`phase/{slug}.md` **Status**). A scored phase's KRs are "
                f"closed and a value measured now would re-open its score. "
                f"Measure a KR of the current phase instead — `perry-goals "
                f"krs` lists them. Nothing was written")
        return
    versions, _order = overall_kr_model(
        ctx["state_root"], ctx["project_root"], "current")
    current = versions[0]["version"] if versions else ""
    if target["okr_version"] != current:
        raise Refused(
            f"OKR version {target['okr_version']!r} is not the current one "
            f"({current!r}, from the canonical `okr.jsonl` store). A value "
            f"measured against a past version is published by no reader. "
            f"Measure the current version's KR — `perry-goals krs --level "
            f"overall` lists them. Nothing was written")


def resolve_evidence(ctx, text: str) -> str:
    """`--evidence` → a path relative to the state root, or a refusal.

    **Existence only** (NN-4): the file is not opened. A relative path is
    looked for under the state root first — where `evidence/` lives — and
    then under the project root; an absolute one is taken as given. Either
    way it must be a FILE inside the project, because a measurement pointing
    outside it points at something the project does not carry.
    """
    raw = check_writable(text, "--evidence")
    project = ctx["project_root"].resolve()
    state = ctx["state_root"].resolve()
    given = Path(raw).expanduser()
    tries = [given] if given.is_absolute() else [state / given, project / given]
    for path in tries:
        found = path.resolve()
        if not found.is_file():
            continue
        if found != project and project not in found.parents:
            continue
        try:
            return found.relative_to(state).as_posix()
        except ValueError:
            return found.relative_to(project).as_posix()
    raise Refused(
        f"--evidence {raw!r} does not exist under the project "
        f"({project}). A measurement is asserted on a file that exists: "
        f"write the evidence first (e.g. `evidence/<YYYY-MM>/<name>.md` under "
        f"the state root), then re-run with its path. Nothing was written")


def kr_writer_rest(args, cmd: str) -> str:
    if len(args.rest) != 1:
        raise Refused(
            f"`{cmd}` takes exactly one <KR-ID>; {len(args.rest)} given"
            f"{': ' + ' '.join(args.rest) if args.rest else ''}. Usage: "
            f"{KR_WRITER_USAGE[cmd]}. Nothing was written")
    return args.rest[0]


def append_linkage_records(ctx, records: list[dict]) -> str:
    """The store's new text: every existing byte, then the new lines.

    **An append, byte for byte.** The prior text is kept exactly — no blank
    line dropped, no record re-serialized — and the new records go on the end,
    published through the atomic replace every store write uses, under the
    project lock `main` holds.
    """
    path = linkage_store_path(ctx["state_root"])
    # Absent only before a project's first phase objective (TASK-475).
    text = path.read_text(encoding="utf-8") if path.is_file() else ""
    if text and not text.endswith("\n"):
        text += "\n"
    return text + "".join(json.dumps(r, ensure_ascii=False) + "\n"
                          for r in records)


def write_kr_writer_result(args, ctx, cmd: str, record: dict, event: dict,
                           result: dict) -> dict:
    path = linkage_store_path(ctx["state_root"])
    result.update({
        "file": str(path), "record": record, "event": event,
        "diff": [f"+{P.LINKAGE_STORE}  "
                 f"{json.dumps(record, ensure_ascii=False)}"],
    })
    if args.dry_run:
        result.update({"dry_run": True, "written": False,
                       "event_written": False})
        return result
    write_atomic(ctx["state_root"], path, append_linkage_records(ctx, [record]))
    result["written"] = True
    result["event_written"] = append_event(ctx["project_root"], event)
    return result


def cmd_measure(args, ctx) -> dict:
    """`measure` — one `measurement` record and one `measure` event.

    DESIGN-022 § 5.3. The refusals, in the order they are asked, each naming
    what would make the command pass:

    1. the KR resolves to no KR, or to more than one (`resolve_kr_for_writer`);
    2. the KR is in `lib.COMPUTED_KR_METRICS` — a computed value is never typed;
    3. its phase is scored, or its OKR version is not current;
    4. the check is not declared on it (`perry-goals check …`);
    5. `--value` is not a number;
    6. `--evidence` does not exist under the project.

    `asserted_at` is this write's own moment, with its zone; `computed` is
    `false` for every record this command writes.
    """
    kr_token = kr_writer_rest(args, "measure")
    check_id = check_writable(required_flag(args, "check", "--check",
                                            "measure"), "--check")
    value_text = required_flag(args, "value", "--value", "measure")
    evidence_text = required_flag(args, "evidence", "--evidence", "measure")

    target = resolve_kr_for_writer(ctx, kr_token, args.okr_version)
    kr, version = target["kr"], target["okr_version"]
    if kr in lib.COMPUTED_KR_METRICS:
        raise Refused(
            f"{kr} is measured by code: `lib.COMPUTED_KR_METRICS` re-runs "
            f"`{lib.COMPUTED_KR_METRICS[kr]}` on every read, and a computed "
            f"value is never typed (DESIGN-022 § 5.4). There is nothing to "
            f"write — `perry-goals krs` prints its current value. Nothing was "
            f"written")
    refuse_closed_kr(ctx, target)
    refuse_withdrawn_kr(ctx, target, "measure")

    entries = lib.kr_checks(P.load_linkage_store(ctx["state_root"])).get(
        (kr, version), [])
    declared = [str((e.get("check") or {}).get("id") or "") for e in entries]
    if check_id not in declared:
        raise Refused(
            f"no check {check_id!r} is declared on {kr}"
            f"{' (' + version + ')' if version else ''}; declared: "
            f"{', '.join(declared) or 'none'}. A value is measured against a "
            f"declared check: `perry-goals check {kr_flag_hint(kr, version)} "
            f"--id {check_id} --direction <D> --target <N> [--baseline <N>] "
            f"--label \"…\" --actor <who>` declares it. Nothing was written")
    value = typed_number("--value", value_text)
    evidence = resolve_evidence(ctx, evidence_text)

    record = {"kind": "measurement", "kr": kr, "okr_version": version,
              "check": check_id, "value": value,
              "asserted_at": lib.register_stamp(), "evidence": evidence,
              "computed": False, "actor": args.actor}
    event = {"ts": lib.event_stamp(), "event": "measure", "actor": args.actor,
             "file": P.LINKAGE_STORE, "kr": kr, "okr_version": version,
             "check": check_id, "value": value, "evidence": evidence}
    return write_kr_writer_result(args, ctx, "measure", record, event, {
        "mode": "measure", "kr": kr, "okr_version": version,
        "level": target["level"], "check": check_id, "value": value,
        "evidence": evidence})


def cmd_check(args, ctx) -> dict:
    """`check` — one `check` record and one `check` event.

    DESIGN-022 § 5.3 and the spec's § 2. Refused, writing nothing, when:

    - the KR resolves to no KR, or to more than one;
    - `--id` is not a slug (the schema's own pattern);
    - `--direction` is not one of `lib.KR_CHECK_DIRECTIONS`;
    - `increase` has `target <= baseline`, `decrease` has `target >=
      baseline`, or either has no `--baseline`;
    - `done` has a target other than 1;
    - `at_least`, `at_most` or `done` carries a `--baseline`.

    **Re-declaring the same `(kr, okr_version, id)` is allowed** and
    supersedes from its `declared_at` — `lib.kr_checks`' first ordering rule,
    which this command does not restate: it appends, and the reader decides.
    """
    kr_token = kr_writer_rest(args, "check")
    check_id = check_writable(required_flag(args, "id", "--id", "check"),
                              "--id")
    direction = check_writable(required_flag(args, "direction",
                                             "--direction", "check"),
                               "--direction")
    target_text = required_flag(args, "target", "--target", "check")
    label = check_writable(required_flag(args, "label", "--label", "check"),
                           "--label")

    target = resolve_kr_for_writer(ctx, kr_token, args.okr_version)
    kr, version = target["kr"], target["okr_version"]
    refuse_withdrawn_kr(ctx, target, "check")

    slug = linkage_record_spec("check")["fields"]["id"]["pattern"]
    if not re.fullmatch(slug, check_id):
        raise Refused(
            f"--id {check_id!r} is not a check slug (`{slug}`: lower-case "
            f"letters, digits, `_` and `-`). Re-run with one, e.g. "
            f"`--id {re.sub(r'[^a-z0-9_-]+', '-', check_id.lower()).strip('-_') or 'total'}`. "
            f"Nothing was written")
    if direction not in lib.KR_CHECK_DIRECTIONS:
        raise Refused(
            f"--direction {direction!r} is not one of "
            f"{' · '.join(lib.KR_CHECK_DIRECTIONS)}. Re-run with one of them. "
            f"Nothing was written")
    goal = typed_number("--target", target_text)
    baseline = (None if args.baseline is None
                else typed_number("--baseline", args.baseline))

    if direction in ("increase", "decrease"):
        if baseline is None:
            raise Refused(
                f"`{direction}` moves from a baseline toward a target, and "
                f"no --baseline was given. Re-run with `--baseline <N>`. "
                f"Nothing was written")
        if direction == "increase" and not goal > baseline:
            raise Refused(
                f"`increase` needs --target above --baseline; got target "
                f"{goal} and baseline {baseline}. A count that must fall is "
                f"`--direction decrease`; a floor is `at_least`. Nothing was "
                f"written")
        if direction == "decrease" and not goal < baseline:
            raise Refused(
                f"`decrease` needs --target below --baseline; got target "
                f"{goal} and baseline {baseline}. A count that must rise is "
                f"`--direction increase`; a ceiling is `at_most`. Nothing was "
                f"written")
    else:
        if baseline is not None:
            raise Refused(
                f"`{direction}` takes no --baseline: a limit or a milestone "
                f"is met or not, and draws no fraction from a starting point. "
                f"Re-run without `--baseline`, or with `--direction "
                f"increase`/`decrease` if it moves from one. Nothing was "
                f"written")
        if direction == "done" and goal != 1:
            raise Refused(
                f"`done` is a milestone valued 0 or 1 and targets 1; got "
                f"--target {goal}. Re-run with `--target 1`. Nothing was "
                f"written")

    prior = [e for e in lib.kr_checks(P.load_linkage_store(ctx["state_root"]))
             .get((kr, version), [])
             if str((e.get("check") or {}).get("id") or "") == check_id]
    record = {"kind": "check", "kr": kr, "okr_version": version,
              "id": check_id, "label": label, "direction": direction,
              "target": goal, "baseline": baseline,
              "declared_at": lib.register_stamp(), "actor": args.actor}
    event = {"ts": lib.event_stamp(), "event": "check", "actor": args.actor,
             "file": P.LINKAGE_STORE, "kr": kr, "okr_version": version,
             "id": check_id, "direction": direction, "target": goal,
             "baseline": baseline}
    return write_kr_writer_result(args, ctx, "check", record, event, {
        "mode": "check", "kr": kr, "okr_version": version,
        "level": target["level"], "id": check_id,
        "supersedes": (str(prior[0]["check"].get("declared_at") or "")
                       if prior else None)})


# ── `kr add | restate | withdraw` — DESIGN-022 § 5.7 (TASK-264 D3) ─────────
#
# **A KR's words change by appending, never by rewriting.** `add` appends a
# `kr` record; `restate` and `withdraw` append a `kr_revision` record — each to
# the store that holds the KR: `linkage.jsonl` for a phase KR, `okr.jsonl` for
# an overall KR (ADR-022). The KR's own record is never touched, and what the
# KR is NOW is `lib.kr_revisions`' fold, which this writer reads rather than
# restates: it refuses what the fold would not apply, and it asks the fold for
# the value a `restate` would change.
#
# **`OKR.md` is not written.** It has carried no KR row since TASK-236 (the
# rows are `krs --level overall`, rendered from the store), so an overall KR
# write changes no byte of it. The byte gate still runs, and on the records
# this write would leave: `OKR.md` must render from the store byte for byte,
# as `write_okr_and_store` requires. A project whose `OKR.md` still carries KR
# rows is refused — those rows render from the UNFOLDED record, and a restate
# would leave them saying the old words (see `append_okr_record`).
#
# Every refusal compares typed values (NN-4): ids, versions, statuses,
# declared field names and types. `--text`, `--reason` and string fields are
# checked for being one non-empty line and never read.

#: `goals/SKILL.md § Style rules`: *Cap phase KRs at 4 per Objective.* `add`
#: counts ACTIVE KRs only (§ 5.7) — a withdrawn KR frees its slot.
PHASE_KR_CAP = 4

#: `kr` record fields no command ever sets: derived on read, never stored
#: (`schema § … records.kr.fields.current_provenance`).
KR_FIELDS_NEVER_SET = frozenset(("current_provenance",))


def kr_record_fields(level: str) -> list[str]:
    """The `kr` record's fields at one level, in their declared order: the
    schema's for a phase KR, `perry_md_store.STORED` for an overall one."""
    if level == "phase":
        return list(linkage_record_spec("kr").get("fields") or {})
    return list(md_store.STORED["kr"])


def kr_store_name(level: str) -> str:
    return P.LINKAGE_STORE if level == "phase" else md_store.OKR.rel_store


def okr_store_records(ctx) -> list[dict]:
    """`okr.jsonl`'s records, or a refusal naming the bad line — a record
    appended to a store Perry cannot read back is one no reader sees."""
    store = md_store.OKR.store_path(ctx["project_root"], ctx["state_root"])
    try:
        records = md_store.load_store(store)
    except (OSError, ValueError) as exc:
        raise Refused(
            f"`{md_store.OKR.rel_store}` does not read as JSONL "
            f"({type(exc).__name__}: {exc}). "
            f"`perry-lint{lib.root_flag(ctx['project_root'])}` names the line. "
            f"Nothing was written")
    _good, malformed = md_store.validate_records(records)
    if malformed:
        raise Refused(
            f"`{md_store.OKR.rel_store}` line {malformed[0]['line']} is "
            f"malformed ({malformed[0]['message']}); a record appended beside "
            f"it would be read by no reader. `perry-lint"
            f"{lib.root_flag(ctx['project_root'])}` names it. Nothing was "
            f"written")
    return records


def kr_store_records(ctx, level: str) -> list[dict]:
    if level == "phase":
        return [r for r in (P.load_linkage_store(ctx["state_root"]) or [])
                if isinstance(r, dict)]
    return okr_store_records(ctx)


def kr_view(ctx, target: dict) -> dict:
    """The fold's view of one KR: `status`, its revisions, its folded record."""
    level = target["level"]
    records = kr_store_records(ctx, level)
    views, _findings = lib.kr_revisions(records, kr_store_name(level))
    key = (target["kr"], target["okr_version"])
    base = next((r for r in records if r.get("kind") == "kr"
                 and lib.kr_revision_key(r, kr_store_name(level)) == key), {})
    view = views.get(key) or {}
    return {**lib.kr_status(view),
            "record": {**base, **(view.get("fields") or {})}}


def refuse_withdrawn_kr(ctx, target: dict, verb: str) -> None:
    """DESIGN-022 § 5.7: a withdrawn KR is closed to every writer — `check`,
    `measure`, `restate` and `withdraw`. Withdrawal is terminal; the way on is
    a new KR under a new id."""
    view = kr_view(ctx, target)
    if view["status"] != "withdrawn":
        return
    kr, version = target["kr"], target["okr_version"]
    raise Refused(
        f"{kr}{' (' + version + ')' if version else ''} was withdrawn at "
        f"{view['withdrawn_at']} ({view['withdrawn_reason']}), and withdrawal "
        f"is terminal: a withdrawn KR takes no `{verb}` (DESIGN-022 § 5.7). "
        f"Its records stay in the store. To track the goal again, add it under "
        f"a new id — `perry-goals kr add <NEW-KR-ID>"
        f"{' --okr-version ' + json.dumps(version, ensure_ascii=False) if version else ''}"
        f" --objective <O> --text \"…\" --reason \"…\" --actor <who>"
        f"{lib.root_flag(ctx['project_root'])}`. Nothing was written")


def refuse_closed_for_revision(ctx, target: dict, verb: str) -> None:
    """`refuse_closed_kr`'s two questions — a scored phase, a past OKR
    version — asked for a KR write, with the answer a KR write needs:
    history is not revised."""
    try:
        refuse_closed_kr(ctx, target)
    except Refused:
        if target["level"] == "phase":
            slug = target["phase"]
            why = (f"phase {slug} is scored (`phase/{slug}.md` **Status**)")
            see = "`perry-goals krs` lists the current phase's KRs"
        else:
            versions, _order = overall_kr_model(
                ctx["state_root"], ctx["project_root"], "current")
            current = versions[0]["version"] if versions else ""
            why = (f"OKR version {target['okr_version']!r} is not the current "
                   f"one ({current!r})")
            see = ("`perry-goals krs --level overall` lists the current "
                   "version's KRs")
        raise Refused(
            f"`kr {verb}` refused: {target['kr']} is closed — {why}, and "
            f"history is not revised (DESIGN-022 § 5.7). {see}; change one of "
            f"those. Nothing was written") from None


def kr_hint(kr: str, version: str, level: str) -> str:
    """`<KR-ID> [--okr-version …]` as a recovery command must spell it: the
    label for an overall KR, `""` for a phase KR whose id carries no phase
    (`O2-KR1` is legal at both levels)."""
    if level == "overall" or not re.match(r"^P\d{3}-", kr):
        return f"{kr} --okr-version {json.dumps(version, ensure_ascii=False)}"
    return kr


def kr_reason(args, op: str, kr_hint: str, _r: str = "") -> str:
    reason = (args.reason or "").strip()
    if not reason or "\n" in reason or "\r" in reason:
        raise Refused(
            f"`kr {op}` needs --reason \"<why>\" on one line; "
            f"{'none was given' if not reason else 'it contains a line break'}"
            f". Every KR change records why (DESIGN-022 § 5.7). Re-run: "
            f"`perry-goals kr {op} {kr_hint} … --reason \"<why>\" --actor "
            f"<who>{_r}`. Nothing was written")
    return reason


def typed_kr_value(level: str, field: str, raw: str):
    """`--set FIELD=VALUE`'s value, typed as the `kr` record declares it.

    Phase KRs: the schema's type — a number through `typed_number`, a boolean
    as `true` / `false`, a string as one non-empty line. Overall KRs: every
    field of `perry_md_store.STORED["kr"]` is a string."""
    kind = "string"
    if level == "phase":
        kind = ((linkage_record_spec("kr").get("fields") or {})
                .get(field) or {}).get("type") or "string"
    if kind == "number":
        return typed_number(f"--set {field}", raw)
    if kind == "boolean":
        if raw.strip().lower() in ("true", "false"):
            return raw.strip().lower() == "true"
        raise Refused(f"--set {field} takes true or false; {raw!r} is "
                      f"neither. Nothing was written")
    return check_writable(raw, f"--set {field}")


def parse_kr_sets(args, level: str, op: str, kr_hint: str,
                  also_identity: tuple = (), _r: str = "") -> dict:
    """`--set FIELD=VALUE…` → `{field: typed value}`, or a refusal.

    Refused: a token with no `=`; a field named twice; an identity field
    (`schema § … kr_revision.identity_fields`) — or, for `add`, a field the
    command sets from its own flag; a field the level's `kr` record does not
    carry."""
    identity = lib.kr_identity_fields(kr_store_name(level)) | set(also_identity)
    allowed = [f for f in kr_record_fields(level)
               if f not in identity and f not in KR_FIELDS_NEVER_SET]
    typed: dict = {}
    for token in args.sets:
        field, eq, raw = token.partition("=")
        field = field.strip()
        if not eq or not field:
            raise Refused(f"--set takes FIELD=VALUE; {token!r} is not one. "
                          f"Nothing was written")
        if field in typed:
            raise Refused(f"--set {field} is given twice. Nothing was written")
        if field in also_identity:
            raise Refused(
                f"`kr {op}` refused: `{field}` is set by its own flag here, "
                f"not by --set. Fields --set may name: {', '.join(allowed)}. "
                f"Nothing was written")
        if field in identity:
            raise Refused(
                f"`kr {op}` refused: `{field}` is an identity field of the KR "
                f"and cannot be set with --set. A KR is renamed or moved by "
                f"withdrawing it and adding a new one: `perry-goals kr "
                f"withdraw {kr_hint} --reason \"…\" --actor <who>{_r}`, "
                f"then `perry-goals kr add …`. Fields --set may name: "
                f"{', '.join(allowed)}. Nothing was written")
        if field not in allowed:
            raise Refused(
                f"`kr {op}` refused: a {level} KR record has no field "
                f"`{field}`. Fields --set may name: {', '.join(allowed)}. "
                f"Nothing was written")
        typed[field] = typed_kr_value(level, field, raw)
    return typed


def append_okr_record(ctx, record: dict, dry_run: bool) -> None:
    """Append ONE record to `okr.jsonl`, behind the `OKR.md` byte gate.

    **The gate is `write_okr_and_store`'s, over this write's records.**
    `OKR.md` is not rewritten — no byte of it changes, because every KR record
    and every revision is a `store_only_kinds` record (TASK-236) — and the
    store must still reproduce it byte for byte: `render(OKR.md, the store
    after this append) == OKR.md`, or nothing is written. A store the file
    already disagrees with is refused rather than appended to.

    **A file that still carries KR rows is refused.** Those rows render from
    the `kr` record as written, never from the fold, so a restate would leave
    `OKR.md` showing the old words — "rendered from the unfolded record" —
    and folding them into the file would rewrite the canonical record, which
    § 5.7 forbids. The KR tables left the file with TASK-236;
    `perry-goals krs --level overall` prints them.

    The prior bytes of the store are kept exactly and the line goes on the
    end, through the same atomic replace every store write uses.
    """
    project_root, state_root = ctx["project_root"], ctx["state_root"]
    okr_md = md_store.OKR.file_path(project_root, state_root)
    store = md_store.OKR.store_path(project_root, state_root)
    if not okr_md.exists():
        raise Refused(
            f"no `{md_store.OKR.rel_file}` beside `{md_store.OKR.rel_store}`, so "
            f"the byte gate every OKR store write passes has nothing to "
            f"compare. `/perry goals init` writes one. Nothing was written")
    text = okr_md.read_text(encoding="utf-8")
    _lines, sites = md_store.OKR.scan(text)
    rows = [s for s in sites if s["kind"] == "kr"]
    if rows:
        raise Refused(
            f"`{md_store.OKR.rel_file}` still carries {len(rows)} KR row(s) "
            f"(first at line {rows[0]['line'] + 1}). They render from each "
            f"KR's record as written, so a KR changed by an appended revision "
            f"would keep its old words there, and folding them into the file "
            f"would rewrite the record (DESIGN-022 § 5.7). The KR tables left "
            f"`OKR.md` with TASK-236 — the store keeps every row and "
            f"`perry-goals krs --level overall` prints them: delete the KR "
            f"tables from `OKR.md`, check `perry-okr diff"
            f"{lib.root_flag(project_root)}` is clean, and re-run. Nothing was "
            f"written")
    prior = okr_store_records(ctx)
    final = prior + [record]
    _good, malformed = md_store.validate_records(final)
    if malformed:
        raise Refused(
            f"the record would make `{md_store.OKR.rel_store}` unreadable "
            f"({malformed[0]['message']}). An identical revision in the same "
            f"second is the usual cause; re-run. Nothing was written")
    rendered, report = md_store.render(md_store.OKR, text, final)
    if rendered != text:
        where = report.get("first_difference") or {}
        raise Refused(
            f"`{md_store.OKR.rel_store}` does not reproduce `"
            f"{md_store.OKR.rel_file}` byte for byte with this record added "
            f"(first at line {where.get('line', '?')}), so the file and the "
            f"store already disagree. `perry-okr diff"
            f"{lib.root_flag(project_root)}` shows where; reconcile it, then "
            f"re-run. Nothing was written")
    if dry_run:
        return
    prior_text = store.read_text(encoding="utf-8") if store.exists() else ""
    if prior_text and not prior_text.endswith("\n"):
        prior_text += "\n"
    # Through this lane's gated `write_atomic`, as the phase path writes
    # `linkage.jsonl`: `okr.jsonl` is `owner: goals` (`schema § claims`), and
    # `assert_owned` is what says so here (TASK-264 D3 repair, V4 finding F5).
    line = json.dumps(record, ensure_ascii=False) + "\n"
    write_atomic(state_root, store, prior_text + line)


def write_kr_change(args, ctx, level: str, record: dict, event: dict,
                    result: dict) -> dict:
    """The canonical store first, then one event, under the lock `main` holds."""
    store = kr_store_name(level)
    path = (linkage_store_path(ctx["state_root"]) if level == "phase"
            else md_store.OKR.store_path(ctx["project_root"], ctx["state_root"]))
    result.update({"file": str(path), "record": record, "event": event,
                   "diff": [f"+{store}  {json.dumps(record, ensure_ascii=False)}"]})
    if level == "overall":
        append_okr_record(ctx, record, args.dry_run)
    if args.dry_run:
        result.update({"dry_run": True, "written": False,
                       "event_written": False})
        return result
    if level == "phase":
        write_atomic(ctx["state_root"], path, append_linkage_records(ctx, [record]))
    result["written"] = True
    result["event_written"] = append_event(ctx["project_root"], event)
    return result


def kr_add_target(ctx, kr_id: str, okr_version) -> dict:
    """Which level an `add` writes to, and the refusals about WHERE.

    `--okr-version ""` is a phase KR and `--okr-version V` an overall KR of
    version V; without the flag, an id carrying its phase (`P004-O1-KR5`) is a
    phase KR and anything else is refused, because an id like `O2-KR1` is
    legal at both levels and a KR filed at the wrong one is read by no reader
    of the other."""
    if okr_version is None:
        if re.match(r"^P\d{3}-", kr_id):
            okr_version = ""
        else:
            raise Refused(
                f"`kr add {kr_id}` does not say its level: `{kr_id}` is a "
                f"legal id for a phase KR and an overall KR. Re-run with "
                f"`--okr-version \"\"` for a phase KR, or `--okr-version "
                f"\"<current version>\"` for an overall KR (`perry-goals krs "
                f"--level overall` prints the current version). Nothing was "
                f"written")
    if okr_version == "":
        slug = current_phase(ctx["state_root"])
        return {"kr": kr_id, "okr_version": "", "level": "phase",
                "phase": slug}
    return {"kr": kr_id, "okr_version": okr_version, "level": "overall",
            "phase": ""}


def cmd_kr_add(args, ctx, kr_id: str) -> dict:
    """`kr add` — one new `kr` record, and one `kr_add` event.

    Refused, writing nothing, when: the level is not said; the phase is scored
    or the OKR version is not current; the id is not a KR id, or names another
    phase; the id exists at that level — **including a withdrawn KR**, because
    ids are never reused; `--objective` is not an objective of the current
    phase / version, or disagrees with the objective the id names; the
    Objective already holds `PHASE_KR_CAP` active KRs; `--text` or `--reason`
    is missing; a `--set` field is an identity field, unknown or mistyped.
    """
    target = kr_add_target(ctx, kr_id, args.okr_version)
    level, version = target["level"], target["okr_version"]
    hint = kr_hint(kr_id, version, level)
    objective = check_writable(required_flag(args, "objective",
                                             "--objective", "kr"),
                               "--objective")
    text = check_writable(required_flag(args, "text", "--text", "kr"),
                          "--text")
    reason = kr_reason(args, "add", hint, lib.root_flag(ctx["project_root"]))
    text_field = "title" if level == "phase" else "text"
    sets = parse_kr_sets(args, level, "add", hint, also_identity=(text_field,),
                         _r=lib.root_flag(ctx["project_root"]))
    records = kr_store_records(ctx, level)
    store = kr_store_name(level)

    if level == "phase":
        slug = target["phase"]
        refuse_closed_for_revision(ctx, target, "add")
        number = P.linkage_phase_number(slug)
        pattern = linkage_record_spec("kr")["fields"]["id"]["pattern"]
        if not re.fullmatch(pattern, kr_id):
            raise Refused(f"`{kr_id}` is not a phase KR id (`{pattern}`), e.g. "
                          f"`P{number}-{objective}-KR1`. Nothing was written")
        named = re.match(r"^P(\d{3})-", kr_id)
        if named and named.group(1) != number:
            raise Refused(
                f"`{kr_id}` names phase {named.group(1)}, and the current "
                f"phase is {slug}. A phase KR is added to the current phase: "
                f"re-run with `P{number}-…`. Nothing was written")
        objectives = [str(r.get("id") or "") for r in records
                      if r.get("kind") == "objective"
                      and str(r.get("phase") or "") == slug]
        if objective not in objectives:
            raise Refused(
                f"--objective {objective!r} is not an objective of phase "
                f"{slug}; it has {', '.join(objectives) or 'none'}. "
                f"`perry-goals krs` lists them. Nothing was written")
        in_id = P.kr_objective_id(kr_id)
        if in_id and in_id != objective:
            raise Refused(
                f"`{kr_id}` names objective {in_id} and --objective is "
                f"{objective}. Re-run with `--objective {in_id}`, or with an "
                f"id under {objective}. Nothing was written")
        taken = [r for r in records if r.get("kind") == "kr"
                 and str(r.get("id") or "") == kr_id]
    else:
        versions, _order = overall_kr_model(ctx["state_root"],
                                            ctx["project_root"], "current")
        current = versions[0]["version"] if versions else ""
        if version != current:
            raise Refused(
                f"`kr add` refused: OKR version {version!r} is not the current "
                f"one ({current!r}) — history is not revised (DESIGN-022 § "
                f"5.7). Re-run with `--okr-version "
                f"{json.dumps(current, ensure_ascii=False)}`. Nothing was "
                f"written")
        if not P._RE_KR_ID.match(kr_id):
            raise Refused(f"`{kr_id}` is not an overall KR id (e.g. "
                          f"`O1-KR4`). Nothing was written")
        objs = versions[0]["objectives"] if versions else []
        chosen = next((o for o in objs if str(o.get("id") or "") == objective),
                      None)
        if chosen is None:
            raise Refused(
                f"--objective {objective!r} is not an objective id of "
                f"{version!r}; it has "
                f"{', '.join(str(o.get('id') or '?') for o in objs) or 'none'}"
                f". `perry-goals krs --level overall` prints them. Nothing "
                f"was written")
        taken = [r for r in records if r.get("kind") == "kr"
                 and str(r.get("id") or "") == kr_id
                 and str(r.get("version") or "") == version]

    if taken:
        views, _f = lib.kr_revisions(records, store)
        status = lib.kr_status(views.get((kr_id, version)))["status"]
        _r = lib.root_flag(ctx["project_root"])
        restate_it = (f"To change it, `perry-goals kr restate {hint} --set "
                      f"FIELD=VALUE --reason \"…\" --actor <who>{_r}`; to "
                      f"add another, choose a new id")
        raise Refused(
            f"`{kr_id}` already exists "
            f"{'in ' + P.LINKAGE_STORE if level == 'phase' else 'in ' + repr(version)}"
            f"{' and is withdrawn' if status == 'withdrawn' else ''}; KR ids "
            f"are never reused (DESIGN-022 § 5.7). "
            f"{'Choose a new id' if status == 'withdrawn' else restate_it}"
            f" — `perry-goals krs{' --level overall' if level == 'overall' else ''}` "
            f"lists the ids in use. Nothing was written")

    if level == "phase":
        views, _f = lib.kr_revisions(records, store)
        active = [str(r.get("id") or "") for r in records
                  if r.get("kind") == "kr"
                  and str(r.get("phase") or "") == target["phase"]
                  and str(r.get("objective") or "") == objective
                  and lib.kr_status(views.get(lib.kr_revision_key(r, store)))
                  ["status"] == "active"]
        if len(active) >= PHASE_KR_CAP:
            raise Refused(
                f"objective {objective} of phase {target['phase']} already "
                f"holds {len(active)} active KRs ({', '.join(active)}), the "
                f"cap of {PHASE_KR_CAP} per Objective (goals/SKILL.md § Style "
                f"rules). Withdraw one first — `perry-goals kr withdraw "
                f"<KR-ID> --reason \"…\" --actor <who>"
                f"{lib.root_flag(ctx['project_root'])}` — or add it under "
                f"another objective. Nothing was written")
        declared = kr_record_fields("phase")
        values = {"kind": "kr", "phase": target["phase"], "objective": objective,
                  "id": kr_id, "title": text, **sets}
        record = {f: values[f] for f in declared if f in values}
    else:
        orders = [r.get("order") for r in records if r.get("kind") == "kr"
                  and isinstance(r.get("order"), int)
                  and not isinstance(r.get("order"), bool)]
        values = {"kind": "kr", "version": version,
                  "objective": str(chosen.get("heading") or ""),
                  "objective_id": objective, "id": kr_id, "text": text,
                  "form": "table", "order": (max(orders) + 1) if orders else 0,
                  **sets}
        record = {f: values.get(f, "") for f in md_store.STORED["kr"]}

    event = {"ts": lib.event_stamp(), "event": "kr_add", "actor": args.actor,
             "file": store, "kr": kr_id, "okr_version": version,
             "level": level, "objective": objective, "reason": reason}
    return write_kr_change(args, ctx, level, record, event, {
        "mode": "kr", "op": "add", "kr": kr_id, "okr_version": version,
        "level": level, "objective": objective})


def cmd_kr_revise(args, ctx, op: str, kr_token: str) -> dict:
    """`kr restate` / `kr withdraw` — one `kr_revision` record and one event.

    Refused, writing nothing, when: the KR resolves to nothing, or a bare
    overall id names more than one version; its phase is scored or its OKR
    version is not current; it is withdrawn; `--reason` is missing; for
    `restate`, `--set` names no field, an identity field, an unknown or
    mistyped one, or changes nothing.
    """
    target = resolve_kr_for_writer(ctx, kr_token, args.okr_version,
                                   linkage_optional=True)
    kr, version, level = target["kr"], target["okr_version"], target["level"]
    hint = kr_hint(kr, version, level)
    refuse_closed_for_revision(ctx, target, op)
    refuse_withdrawn_kr(ctx, target, op)
    reason = kr_reason(args, op, hint, lib.root_flag(ctx["project_root"]))
    fields: dict = {}
    unchanged: list[str] = []
    changes: dict = {}
    if op == "restate":
        if not args.sets:
            raise Refused(
                f"`kr restate` names no field. Re-run with one or more "
                f"`--set FIELD=VALUE`: `perry-goals kr restate {hint} --set "
                f"{'title' if level == 'phase' else 'text'}=\"…\" --reason "
                f"\"…\" --actor <who>{lib.root_flag(ctx['project_root'])}`. "
                f"Nothing was written")
        sets = parse_kr_sets(args, level, "restate", hint,
                             _r=lib.root_flag(ctx["project_root"]))
        current = kr_view(ctx, target)["record"]
        for field, value in sets.items():
            if field in current and current.get(field) == value \
                    and type(current.get(field)) is type(value):
                unchanged.append(field)
            else:
                fields[field] = value
                changes[field] = {"before": current.get(field), "after": value}
        if not fields:
            raise Refused(
                f"`kr restate` changes nothing: {kr} already carries "
                f"{', '.join(f'{f}={json.dumps(sets[f], ensure_ascii=False)}' for f in unchanged)}"
                f". `perry-goals krs{' --level overall' if level == 'overall' else ''} "
                f"--json` prints its current values; re-run with a value that "
                f"differs. Nothing was written")
    elif args.sets:
        raise Refused("`kr withdraw` takes no --set. Nothing was written")

    store = kr_store_name(level)
    record = {"kind": "kr_revision", "kr": kr, "okr_version": version,
              "op": op, "fields": fields, "reason": reason,
              "revised_at": lib.event_stamp(), "actor": args.actor}
    event = {"ts": lib.event_stamp(), "event": f"kr_{op}", "actor": args.actor,
             "file": store, "kr": kr, "okr_version": version, "level": level,
             "reason": reason}
    if op == "restate":
        event["changes"] = changes
    return write_kr_change(args, ctx, level, record, event, {
        "mode": "kr", "op": op, "kr": kr, "okr_version": version,
        "level": level, "changes": changes, "unchanged": unchanged})


def cmd_kr(args, ctx) -> dict:
    """`kr add|restate|withdraw <KR-ID>` — DESIGN-022 § 5.7."""
    if len(args.rest) != 2 or args.rest[0] not in KR_OP_FLAGS:
        raise Refused(
            f"`kr` takes an operation and one <KR-ID>: "
            f"{' | '.join(KR_OP_FLAGS)}; got "
            f"{' '.join(args.rest) or 'nothing'}. Usage: "
            f"{KR_WRITER_USAGE['kr']}. Nothing was written")
    op, kr_token = args.rest
    kr_token = check_writable(kr_token, "<KR-ID>")
    if op == "add":
        return cmd_kr_add(args, ctx, kr_token)
    return cmd_kr_revise(args, ctx, op, kr_token)


def cmd_objective(args, ctx) -> dict:
    """`objective add <O-ID>` — one phase `objective` record, one event.

    The missing step between `phase new`, which writes the phase's prose and
    pointer and no record, and `kr add`, which refuses an `--objective` the
    phase does not declare. Without it a phase opened by the writer could
    carry no KR at all, and the procedure forbids appending one by hand.

    Refused, writing nothing, when: the op is not `add` or the id is missing;
    `--text` or `--reason` is missing or spans lines; there is no current
    phase, or it is scored; the id does not match the schema's pattern; the
    phase already declares that id.
    """
    if len(args.rest) != 2 or args.rest[0] != "add":
        raise Refused(
            f"`objective` takes `add` and one <O-ID>; got "
            f"{' '.join(args.rest) or 'nothing'}. Usage: "
            f"{KR_WRITER_USAGE['objective']}. Nothing was written")
    oid = check_writable(args.rest[1], "<O-ID>")
    title = check_writable(required_flag(args, "text", "--text", "objective"),
                           "--text")
    reason = (args.reason or "").strip()
    if not reason or "\n" in reason or "\r" in reason:
        raise Refused(
            f"`objective add` needs --reason \"<why>\" on one line; "
            f"{'none was given' if not reason else 'it contains a line break'}"
            f". Usage: {KR_WRITER_USAGE['objective']}. Nothing was written")
    slug = current_phase(ctx["state_root"])
    doc = ctx["state_root"] / "phase" / f"{slug}.md"
    status = (P.parse_phase(slug, doc.read_text(encoding="utf-8")).status
              if doc.is_file() else "")
    if status.strip().lower() == "scored":
        raise Refused(
            f"`objective add` refused: phase {slug} is scored (`phase/{slug}"
            f".md` **Status**), and history is not revised. Open the next "
            f"phase with `perry-goals phase new`. Nothing was written")
    spec = linkage_record_spec("objective")
    pattern = spec["fields"]["id"]["pattern"]
    if not re.fullmatch(pattern, oid):
        raise Refused(f"`{oid}` is not an objective id (`{pattern}`), e.g. "
                      f"`O1`. Nothing was written")
    records = kr_store_records(ctx, "phase")
    have = [str(r.get("id") or "") for r in records
            if r.get("kind") == "objective"
            and str(r.get("phase") or "") == slug]
    if oid in have:
        raise Refused(
            f"phase {slug} already declares objective {oid} (it has "
            f"{', '.join(have)}); objective ids are never reused. Choose "
            f"another id. Nothing was written")
    values = {"kind": "objective", "phase": slug, "id": oid, "title": title}
    record = {f: values[f] for f in spec["fields"] if f in values}
    event = {"ts": lib.event_stamp(), "event": "objective_add",
             "actor": args.actor, "file": P.LINKAGE_STORE, "phase": slug,
             "objective": oid, "reason": reason}
    # Through the phase KR writer's own path: one gated write to the
    # register, then the event — a second write site would be a second
    # mechanism for one job (`test_okr_store_is_the_source` pins the list).
    return write_kr_change(args, ctx, "phase", record, event, {
        "mode": "objective", "op": "add", "objective": oid, "phase": slug})


# ── draft: a first-OKR planning draft (TASK-444, DESIGN-020 § 5.5) ────────
# Frontmatter validated by `parsers § parse_plan`; the body is copied and
# hashed, never read. Only okr/first is written, and never a canonical goal.

_DRAFT_WRITE = "--root --path --expect-sha256 --actor --dry-run --json"
DRAFT_FLAGS = {mode: tuple(flags.split()) for mode, flags in {
    "create": "--root --horizon --route --date --slug --target --body-file "
              "--step --answered --ask --actor --dry-run --json",
    "show": "--root --path --json", "finalize": "--root --path --json",
    "update": _DRAFT_WRITE + " --body-file --step --answered --status --ask",
    "approve": _DRAFT_WRITE, "abandon": _DRAFT_WRITE}.items()}
DRAFT_OPTIONAL = set("--answered --ask --dry-run --json --body-file --step --status".split())
#: What `draft finalize` still has no writer for. The KR add/restate/withdraw
#: clause that stood here was retired on 2026-09-20: TASK-264 closed on
#: 2026-09-18 and `perry-goals kr add|restate|withdraw` exists (ADR-022), so
#: naming it as missing sent every reader looking for a writer that was two
#: days old. The phase lifecycle is not listed either, for the same reason —
#: `perry-goals phase new|activate|close` is below (TASK-474).
DRAFT_MISSING = [
    "an overall-OKR authoring writer (mission, objectives, version block); "
    "the perry-okr importer reads an existing OKR.md and authors nothing"]


def refusal(msg: str, **details) -> Refused:  # typed details for `--json`
    exc = Refused(msg + ". Nothing was written")
    exc.details = details
    return exc


def parse_draft(argv: list[str]) -> tuple[str, dict]:
    """`(mode, {flag: value})`; anything malformed exits 2, by name."""
    def usage(msg: str):
        print(f"perry-goals draft: {msg} (try --help)", file=sys.stderr)
        sys.exit(2)
    mode, vals, i = (argv or [""])[0], {}, 1
    if mode not in DRAFT_FLAGS:
        usage(f"expected a mode: {' / '.join(DRAFT_FLAGS)}")
    while i < len(argv):
        t = argv[i]
        if t not in DRAFT_FLAGS[mode] or t in vals:
            usage(f"`draft {mode}` takes each of {' '.join(DRAFT_FLAGS[mode])} "
                  f"at most once, not {t!r}")
        if t in ("--ask", "--dry-run", "--json"):
            vals[t] = True
        elif i + 1 >= len(argv) or argv[i + 1].startswith("--"):
            usage(f"{t} takes a value")
        else:
            i += 1
            vals[t] = argv[i]
            if lib.empty_root_error(t, argv[i]):
                usage(lib.empty_root_error(t, argv[i]))
        i += 1
    missing = [f for f in DRAFT_FLAGS[mode] if f not in DRAFT_OPTIONAL | set(vals)]
    actor = vals.get("--actor", "-")
    for bad, msg in ((missing, f"`draft {mode}` needs {' '.join(missing)}"),
                     (vals.get("--status") not in (None, "interviewing", "drafted"),
                      "--status takes interviewing or drafted; approval is `draft approve`"),
                     (not actor.strip() or set(actor) & {"\n", "\r"},
                      "--actor must be a non-empty single line (USER-950)")):
        if bad:
            usage(msg)
    return mode, vals


def render_plan(meta: dict, body: str) -> str:
    """The frontmatter in one stable shape, then the body byte for byte."""
    q = lambda v: json.dumps(v, ensure_ascii=False)  # noqa: E731
    return "\n".join([
        "---", f"horizon: {meta['horizon']}", f"route: {meta['route']}",
        f"status: {meta['status']}", f"step: {meta['step'] or q('')}",
        f"answered: [{', '.join(meta['answered'])}]",
        f"target: {q(meta['target'])}", f"created: {meta['created']}",
        f"updated: {meta['updated']}",
        f"finalized_refs: [{', '.join(map(q, meta['finalized_refs']))}]",
        f"questions_asked: {meta['questions_asked']}",
        f"approved_sha256: {q(meta['approved_sha256'])}",
        f"decided_by: {q(meta['decided_by'])}", "---", ""]) + body


def read_body(value: str, plan: Path) -> str:
    """`--body-file`: opaque UTF-8 prose, only read, never the plan itself."""
    src = Path(value).expanduser()
    try:
        if not src.is_file() or src.resolve() == plan.resolve():
            raise OSError("not a readable file other than the plan")
        body = src.read_bytes().decode("utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        raise refusal(f"--body-file {value}: {exc}")
    if not body.strip() or body.lstrip("\ufeff").startswith("---"):
        raise refusal("--body-file must be non-empty and must not open with a "
                      "`---` fence: the frontmatter is this tool's")
    return body


def draft_gate(project_root: Path, state_root: Path, rec: dict | None,
               expect: str | None = None) -> None:
    """Under the lock: recovery must not block, and a plan being changed must
    be valid, okr/first, not terminal, and the bytes last read."""
    rc = P.scan_recovery(state_root, project_root)
    if rc["blocking"]:
        raise refusal("recovery is blocking: " + ", ".join(
            r["path"] for r in rc["pending_transactions"] + rc["malformed_dossiers"])
            + "; repair it first", recovery=rc)
    m = (rec or {}).get("meta") or {}
    why = rec and ("; ".join(rec["errors"]) or (
        "only okr/first drafts are written"
        if (m["horizon"], m["route"]) != ("okr", "first") else
        f"{m['status']} is terminal" if m["status"] in ("abandoned", "finalized")
        else None))
    if why:
        raise refusal(f"{rec['path']}: {why}" + (
            "; fix those frontmatter fields by hand (goals/reference/planning.md "
            "§ The file), then re-read" if rec["errors"] else ""), errors=rec["errors"])
    if rec and rec["sha256"] != expect:
        raise refusal(f"{rec['path']} changed since it was read (expected "
                      f"{expect}, now {rec['sha256']}). Re-read it with `draft "
                      f"show`, keep its edits, and prepare the change against it",
                      conflict=True, current_sha256=rec["sha256"])


def publish_plan(path: Path, rel: str, meta: dict, body: str,
                 expect: str | None, dry_run: bool) -> dict:
    """Validate the exact image, then publish it: create-only by a hard link
    refusing an existing name, else replace after a last re-read, which
    narrows (cannot close) the race with an editor that takes no lock."""
    text = render_plan(meta, body)
    rec = P.parse_plan(text.encode("utf-8"), rel)
    if rec["errors"]:
        raise refusal("the draft would be invalid: " + "; ".join(rec["errors"]),
                      errors=rec["errors"])
    if not dry_run and expect is None:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = lib.stage(path, text)
        try:
            os.chmod(tmp, 0o644)
            os.link(tmp, path)
        except FileExistsError:
            raise refusal(f"a plan already exists at {rel}", existing=rel)
        finally:
            os.unlink(tmp)
    elif not dry_run:
        if hashlib.sha256(path.read_bytes()).hexdigest() != expect:
            raise refusal(f"{rel} changed during this write", conflict=True)
        lib.write_atomic(path, text)
    return {"path": rel, "file": str(path), "written": not dry_run,
            "sha256": rec["sha256"], "status": meta["status"],
            "step": meta["step"], "questions_asked": meta["questions_asked"],
            "approval_valid": rec["approval_valid"], "finalize_available": False}


def draft_command(mode: str, v: dict) -> dict:
    project_root = Path(v["--root"]).expanduser().resolve()
    state_root = P.resolve_state_root(project_root).resolve()
    if not state_root.is_relative_to(project_root):
        raise Refused(f"state root {state_root} is outside {project_root}")
    qids = lambda s: [q.strip() for q in s.split(",") if q.strip()]  # noqa: E731
    horizon = v.get("--horizon", "okr")
    rel = v.get("--path") or f"{P.PLAN_DIR}/{horizon}/{v['--date']}-{v['--slug']}.md"
    if mode == "create" and (horizon, v["--route"]) != ("okr", "first"):
        raise refusal(f"{horizon}/{v['--route']} is unsupported: only okr/first "
                      f"drafts are written", unsupported=True)
    path, why = P.plan_file(state_root, rel)
    if why or (mode != "create" and not path.is_file()):
        raise Refused(why or f"no plan at {rel}")
    if mode in ("show", "finalize"):
        rec = {**P.parse_plan(path.read_bytes(), rel), "file": str(path),
               "project_path": P.display_path(path, project_root),
               "finalize_available": False}
        if mode == "finalize":
            raise refusal(f"finalize is unavailable for {rel}: no writer exists "
                          f"for {' / '.join(DRAFT_MISSING)}", written=False,
                          missing=DRAFT_MISSING,
                          approval_valid=rec.get("approval_valid"))
        return rec
    assert_owned(state_root, path)
    today, dry = date.today().isoformat(), bool(v.get("--dry-run"))
    # A draft writes no store; the gate is asked about the one it plans for.
    lib.refuse_write_unless_installed(project_root, ("okr.jsonl",), Refused)
    if mode == "create":
        if v["--date"] > today:
            raise refusal(f"--date {v['--date']} is later than today ({today})")
        meta = {"horizon": "okr", "route": "first", "status": "interviewing",
                "step": v["--step"], "answered": qids(v.get("--answered", "")),
                "target": v["--target"], "created": v["--date"],
                "updated": v["--date"], "finalized_refs": [],
                "questions_asked": int(bool(v.get("--ask"))),
                "approved_sha256": None, "decided_by": None}
        body = read_body(v["--body-file"], path)
        if any((state_root / n).exists() for n in ("OKR.md", "okr.jsonl")):
            raise refusal("an overall OKR already exists: the first route is for "
                          "a project with none, and revision drafts are "
                          "unsupported", unsupported=True)
        with project_lock(state_root):
            draft_gate(project_root, state_root, None)
            if path.exists():
                raise refusal(f"a plan already exists at {rel}", existing=rel)
            return publish_plan(path, rel, meta, body, None, dry)
    with project_lock(state_root):
        rec = P.parse_plan(path.read_bytes(), rel)
        draft_gate(project_root, state_root, rec, v["--expect-sha256"])
        meta, body = dict(rec["meta"]), rec["body"]
        unchanged = {"path": rel, "written": False, "status": meta["status"],
                     "approval_valid": rec["approval_valid"],
                     "finalize_available": False}
        if mode == "approve":
            if meta["status"] == "approved" and rec["approval_valid"]:
                return unchanged
            if meta["status"] == "interviewing":
                raise refusal(f"{rel} is still interviewing: mark it drafted "
                              f"(`update --status drafted --step \"\"`) before approving")
            meta.update(status="approved", approved_sha256=rec["approval_sha256"],
                        decided_by=v["--actor"])
        elif mode == "abandon":
            meta.update(status="abandoned", step="", approved_sha256=None,
                        decided_by=v["--actor"])
        else:
            if "--body-file" in v:
                body = read_body(v["--body-file"], path)
            meta.update(step=v.get("--step", meta["step"]),
                        answered=qids(v.get("--answered", ",".join(meta["answered"]))),
                        status=v.get("--status", meta["status"]))
            if v.get("--ask"):     # past the cap, `parse_plan` refuses the image
                if meta["status"] != "interviewing":
                    raise refusal("--ask records a question; only an interviewing plan asks one")
                meta["questions_asked"] += 1
            if meta == rec["meta"] and body == rec["body"]:
                return unchanged
            meta.update(approved_sha256=None, decided_by=None, status=meta["status"].replace(
                "approved", "drafted"))
        meta["updated"] = today
        return publish_plan(path, rel, meta, body, v["--expect-sha256"], dry)


# ---------------------------------------------------------------------------
# The phase lifecycle (TASK-474)
#
# `goals/reference/phases.md` carried two instructions that could not both be
# obeyed: § Writing it forbids hand-writing a phase document or `phase/CURRENT`,
# and § score-phase step 7 instructs clearing `phase/CURRENT`. Neither had a
# writer, so the documented way to end a phase was the edit the same page
# prohibits. These three verbs are that writer.
#
# **Creation activates.** `new` writes the document and the pointer in one
# locked operation, because the same page requires the writer's result to
# identify "the ten-section phase prose and the activated phase pointer".
# The sentence one section earlier — a draft "does not reserve a number, set a
# start date, make a phase active or change `phase/CURRENT`" — governs the CHAT
# DRAFT that precedes approval, not the writer that follows it. Reading it as
# the writer's contract is what the spec for this row had to correct before
# implementation.
PHASE_FLAGS = {m: tuple(f.split()) for m, f in {
    "new": "--root --slug --body-file --actor --dry-run --json",
    "activate": "--root --phase --actor --dry-run --json",
    "close": "--root --phase --actor --dry-run --json"}.items()}
#: Per mode, because `--phase` is required to activate (the caller must say
#: which) and optional to close (it defaults to the active one). A single
#: global optional-set, which `draft` can afford, cannot express that.
PHASE_REQUIRED = {"new": ("--slug", "--body-file", "--actor"),
                  "activate": ("--phase", "--actor"),
                  "close": ("--actor",)}
#: `current_phase` above already treats these as "no current phase"; the
#: writer has to agree with the reader or it would clear a pointer the reader
#: thinks is empty and set one it thinks is full.
PHASE_NONE = {"", "(none)", "none", "\u2014"}
PHASE_SLUG_RE = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*\Z")


def phase_docs(state_root: Path) -> list[tuple[str, str, Path]]:
    """`(NNN, slug, path)` per phase document, lowest number first.

    Non-recursive on purpose: `phase/snapshots/` holds copies of these same
    documents, and a snapshot counted here would push the next number past a
    number nothing used.
    """
    out = []
    for f in sorted((state_root / "phase").glob("[0-9][0-9][0-9]-*.md")):
        num, _, slug = f.stem.partition("-")
        out.append((num, slug, f))
    return out


def phase_cap() -> int:
    """The tier-1 hard cap, from the schema rather than a second copy of 300."""
    for f in lib.load_schema(Refused).get("files", []):
        if f.get("id") == "phase":
            cap = f.get("cap")
            if isinstance(cap, int):
                return cap
            break
    raise Refused("schema/state-schema.json declares no integer `cap` for the "
                  "`phase` file, so its tier-1 limit cannot be read. Nothing "
                  "was written")


def phase_pointer(state_root: Path) -> tuple[Path, str]:
    """`(the CURRENT file, the active `<NNN>-<slug>` or '')`.

    **The one place inside this tool that reads the pointer sentinel.**
    `current_phase` above delegates here rather than keeping a second
    copy: `tests/test_blank_cell_is_one_rule.py § EXEMPT` already
    records this set as "three copies of one rule", and a writer adding
    a fourth is how that note becomes four. It stays a literal rather
    than `lib.is_blank_cell` for the reason the same note gives —
    `(none)` is the set's principal member and is not a declared blank
    spelling, so the shared rule would silently drop it.
    """
    f = state_root / "phase" / "CURRENT"
    # `phase_text`, not `read_text()`, even for a one-token pointer: one
    # reader shape for every phase read leaves no exception to argue
    # about later. The value is stripped, so the two agree here anyway.
    slug = phase_text(f).strip() if f.exists() else ""
    return f, ("" if slug in PHASE_NONE else slug)


def phase_text(path: Path) -> str:
    """A phase document's bytes, decoded and **not** newline-translated.

    `Path.read_text()` applies universal newlines: a lone `\r` becomes `\n`
    and a `\r\n` loses its `\r`. For a READER that silently disagrees with
    `bin/perry-lint`, which is round 2's F2/R2. For `close`, which writes what
    it read back out, it would also rewrite every line of a CRLF document
    while claiming to change one — the reviewer's R3.

    `phase new` normalises what IT writes (USER-973 A). What Perry did not
    write, Perry does not rewrite.
    """
    return path.read_bytes().decode("utf-8")


def phase_header(text: str, field: str) -> tuple[int, str] | None:
    """`(line index, current value)` for a `> **<field>**: …` header line.

    **`split("\n")`, not `splitlines()`, and the index is into that list.**
    This pair got it wrong once (TASK-474 V4 F1): the index came from
    `splitlines()` and `splice_header` subscripted `split("\n")`. Those agree
    only on a document with none of the nine other boundaries `splitlines()`
    breaks on — `\x0b \x0c \x1c \x1d \x1e \x85 \u2028 \u2029` and a lone
    `\r`. One such character above the header silently rewrote the wrong line;
    two ran the index off the end, mid-write. `Okr.render` forty lines up says
    why this file uses `split("\n")`, and `tests/test_one_line_break_rule.py`
    exists because two spellings of this rule once disagreed on six of eleven
    boundaries. This is the same rule, in the same file, for the third time.
    """
    for n, line in enumerate(text.split("\n")):
        m = re.match(rf"(>\s*\*\*{re.escape(field)}\*\*:)(.*)$", line)
        if m:
            return n, m.group(2).strip()
    return None


def splice_header(text: str, field: str, value: str) -> str:
    """Rewrite one header line's value, leaving every other byte alone.

    The same discipline `Okr.splice_cell` uses and for the same reason
    (DESIGN-005 § 5.5): a writer that round-trips a tier-1 document through a
    parsed model returns a file that still lints and no longer reads the way
    its author wrote it.
    """
    hit = phase_header(text, field)
    if hit is None:
        raise Refused(f"no `> **{field}**:` header line to rewrite. "
                      f"Nothing was written")
    n, _ = hit
    lines = text.split("\n")
    pattern = rf"(>\s*\*\*{re.escape(field)}\*\*:).*$"
    # **Never trust the index alone.** `phase_header` and this function split
    # with the same call now, so `n` is correct by construction — but the
    # failure this replaces was silent precisely because `re.sub` matching
    # nothing is not an error. If the two ever drift apart again, this refuses
    # instead of returning the text unchanged and reporting success.
    if n >= len(lines) or not re.match(pattern, lines[n]):
        raise Refused(
            f"line {n} is not the `> **{field}**:` header it was located as; "
            f"the document was not rewritten. Nothing was written")
    # Keep the line's own terminator. On a CRLF document `split("\n")` leaves
    # a trailing `\r` on every line, and `.*$` would eat this one's — leaving
    # one LF-terminated line in a CRLF file.
    cr = "\r" if lines[n].endswith("\r") else ""
    lines[n] = re.sub(pattern, rf"\g<1> {value}", lines[n].rstrip("\r")) + cr
    return "\n".join(lines)


def parse_phase(argv: list[str]) -> tuple[str, dict]:
    """`(mode, {flag: value})`; anything malformed exits 2, by name."""
    def usage(msg: str):
        print(f"perry-goals phase: {msg} (try --help)", file=sys.stderr)
        sys.exit(2)
    mode, vals, i = (argv or [""])[0], {}, 1
    if mode not in PHASE_FLAGS:
        usage(f"expected a mode: {' / '.join(PHASE_FLAGS)}")
    while i < len(argv):
        t = argv[i]
        if t not in PHASE_FLAGS[mode] or t in vals:
            usage(f"`phase {mode}` takes each of {' '.join(PHASE_FLAGS[mode])} "
                  f"at most once, not {t!r}")
        if t in ("--dry-run", "--json"):
            vals[t] = True
        elif i + 1 >= len(argv) or argv[i + 1].startswith("--"):
            usage(f"{t} takes a value")
        else:
            i += 1
            vals[t] = argv[i]
            if lib.empty_root_error(t, argv[i]):
                usage(lib.empty_root_error(t, argv[i]))
        i += 1
    missing = [f for f in PHASE_REQUIRED[mode] if f not in vals]
    actor = vals.get("--actor", "-")
    for bad, msg in ((missing, f"`phase {mode}` needs {' '.join(missing)}"),
                     (not actor.strip() or set(actor) & {"\n", "\r"},
                      "--actor must be a non-empty single line (USER-950)")):
        if bad:
            usage(msg)
    return mode, vals


def phase_command(mode: str, v: dict) -> dict:
    project_root = (Path(v["--root"]).expanduser().resolve() if v.get("--root")
                    else Path(os.environ.get("PERRY_PROJECT") or Path.cwd()).resolve())
    state_root = P.resolve_state_root(project_root).resolve()
    if not state_root.is_relative_to(project_root):
        raise Refused(f"state root {state_root} is outside {project_root}")
    lib.refuse_write_unless_installed(
        project_root, ("phase/CURRENT", ".perry/events.jsonl"), Refused)
    dry = bool(v.get("--dry-run"))
    today = date.today().isoformat()
    with project_lock(state_root):
        docs = phase_docs(state_root)
        by_num = {num: (slug, f) for num, slug, f in docs}
        pointer, active = phase_pointer(state_root)
        if mode == "new":
            if not any((state_root / n).exists() for n in ("OKR.md", "okr.jsonl")):
                raise refusal(
                    "no overall OKR exists under this state root (neither "
                    "`OKR.md` nor `okr.jsonl`), and a phase is a tactical "
                    "commitment against one. `/perry goals init` writes it "
                    "first", missing_prerequisite="overall OKR")
            if active:
                raise refusal(
                    f"phase {active} is still active. A phase is not replaced "
                    f"silently: close it with `perry-goals phase close` or "
                    f"choose to keep it", active=active)
            slug = v["--slug"]
            if not PHASE_SLUG_RE.match(slug):
                raise refusal(
                    f"--slug {slug!r} is not a short hyphenated slug "
                    f"(lower-case letters, digits and single hyphens)",
                    slug=slug)
            num = f"{max((int(n) for n, _, _ in docs), default=0) + 1:03d}"
            # `pid` is built once and every later path derives from it.
            # Spelling `f"{num}-{slug}"` inline instead binds each of
            # `target` / `payload` / `snap` to a hyphen constant, and
            # `tests/sweep_blank_cell_sites.py` keys its `bound` map by
            # BARE NAME across the module — so a local `payload` here was
            # reported as a blank-spelling site inside `cmd_kr_add`, a
            # function this row never touched.
            pid = f"{num}-{slug}"
            target = state_root / "phase" / (pid + ".md")
            if target.exists():
                raise refusal(f"phase/{target.name} already exists",
                              existing=target.name)
            body = read_body(v["--body-file"], target)
            # **USER-973 (2026-09-20), principle A: the writer normalises.**
            # Every boundary `str.splitlines()` knows becomes LF, so the bytes
            # on disk carry only LF and every reader agrees whatever call it
            # uses. `splitlines()` is the lossy call this file warns about
            # twice — here the loss IS the operation, which is why it is the
            # right call in exactly this one place and the wrong one in
            # `phase_header`. The accepted cost, stated in the answer: this
            # rewrites the author's bytes, which `Okr.render` declines to do
            # for `OKR.md`. Two V4 rounds failed on the disagreement it ends:
            # perry-goals counted a lone CR as no line break and perry-lint
            # counted it as one, so a 300-line body was written and then
            # rejected by the project's own linter at 301.
            text = "\n".join(body.splitlines()) + "\n"
            for field, value in (("Started", today), ("Status", "active")):
                if phase_header(text, field) is None:
                    raise refusal(
                        f"the body carries no `> **{field}**:` header line; "
                        f"start from goals/state/phase_TEMPLATE.md",
                        missing_header=field)
                text = splice_header(text, field, value)
            # `bin/perry-lint § size-cap` counts `raw.split("\n")`. A
            # gate that disagrees with the check it stands in for is
            # not a gate: at exactly `cap` written lines, `splitlines()`
            # is one lower, so this wrote a document the project's own
            # linter then rejected (TASK-474 V4 F2).
            cap, lines = phase_cap(), len(text.split("\n"))
            if lines > cap:
                raise refusal(
                    f"phase/{target.name} would be {lines} lines, over the "
                    f"tier-1 hard cap of {cap}. Move narrative into "
                    f"`evidence/<YYYY-MM>/phase-{num}-<topic>.md` and link it",
                    lines=lines, cap=cap)
            if not dry:
                target.parent.mkdir(parents=True, exist_ok=True)
                write_atomic(state_root, target, text)
                write_atomic(state_root, pointer, pid + "\n")
            payload = {"mode": mode, "phase": pid,
                      "path": f"phase/{target.name}", "file": str(target),
                      "lines": lines, "cap": cap, "started": today,
                      "status": "active", "activated": True}
        elif mode == "activate":
            num = v["--phase"]
            if num not in by_num:
                raise refusal(
                    f"no phase document numbered {num} — this project has "
                    f"{', '.join(n for n, _, _ in docs) or 'none'}",
                    known=[n for n, _, _ in docs])
            slug, target = by_num[num]
            pid = f"{num}-{slug}"
            if active == pid:
                raise refusal(f"phase {active} is already the active one",
                              active=active)
            # **The active phase is named first.** Criterion 4 asks the
            # refusal to name the phase that is holding the pointer, and when
            # the target was ALSO scored the scored gate answered first and
            # never named it (TASK-474 V4 F5). Both are refusals and both
            # write nothing; the order is what the caller reads.
            if active:
                raise refusal(
                    f"phase {active} is still active. Close it first; this "
                    f"command does not replace one phase with another",
                    active=active)
            # **A scored phase does not reopen.** Without this the pointer
            # could name a document whose `Status` says `scored`, which is a
            # state the enum has no word for — and `close` would then refuse
            # forever, because its own guard is exactly that Status. Found by
            # exercising the verbs in sequence, not by reading them.
            scored = phase_header(phase_text(target), "Status")
            if scored is not None and scored[1] == "scored":
                raise refusal(
                    f"phase {pid} is scored; a scored phase is "
                    f"terminal and is not reactivated. `phase new` opens the "
                    f"next one", status="scored")
            if not dry:
                write_atomic(state_root, pointer, pid + "\n")
            payload = {"mode": mode, "phase": pid,
                      "path": f"phase/{target.name}", "file": str(target),
                      "activated": True}
        else:  # close
            num = v.get("--phase") or (active.partition("-")[0] if active else "")
            if not num:
                raise refusal(
                    "there is no active phase to close and --phase names none",
                    active="")
            if num not in by_num:
                raise refusal(
                    f"no phase document numbered {num} — this project has "
                    f"{', '.join(n for n, _, _ in docs) or 'none'}",
                    known=[n for n, _, _ in docs])
            slug, target = by_num[num]
            pid = f"{num}-{slug}"
            if active != pid:
                raise refusal(
                    f"phase {pid} is not the active phase "
                    f"({active or 'none'} is). Only the active phase closes",
                    active=active)
            text = phase_text(target)
            hit = phase_header(text, "Status")
            if hit is None:
                raise refusal("the phase document carries no "
                              "`> **Status**:` header line to flip")
            if hit[1] == "scored":
                raise refusal(f"phase {pid} is already scored",
                              status="scored")
            snap = (state_root / "phase" / "snapshots"
                    / (today + "-" + pid + "-final.md"))
            if snap.exists():
                raise refusal(f"a final snapshot already exists at "
                              f"phase/snapshots/{snap.name}",
                              existing=snap.name)
            if not dry:
                snap.parent.mkdir(parents=True, exist_ok=True)
                write_atomic(state_root, snap, text)
                write_atomic(state_root, target,
                             splice_header(text, "Status", "scored"))
                write_atomic(state_root, pointer, "(none)\n")
            payload = {"mode": mode, "phase": pid,
                      "path": f"phase/{target.name}", "file": str(target),
                      "snapshot": f"phase/snapshots/{snap.name}",
                      "status": "scored", "activated": False}
        payload["written"] = not dry
        payload["actor"] = v["--actor"].strip()
        if not dry:
            payload["event_written"] = append_event(project_root, {
                "ts": lib.event_stamp(), "event": f"phase-{mode}",
                "phase": payload["phase"], "path": payload["path"],
                "actor": payload["actor"]})
    return payload


def phase_main(argv: list[str]) -> int:
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    mode, v = parse_phase(argv)
    try:
        try:
            payload = phase_command(mode, v)
        except OSError as exc:
            raise refusal(f"{type(exc).__name__}: {exc}", io_error=True)
    except Refused as exc:
        if v.get("--json"):
            print(json.dumps({"refused": str(exc), **getattr(exc, "details", {})},
                             ensure_ascii=False, indent=2))
        else:
            print(f"perry-goals: refused — {exc}", file=sys.stderr)
        return 1
    if v.get("--json"):
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(f"perry-goals: {'wrote' if payload['written'] else 'would write'} "
              f"{payload['path']} · phase {payload['phase']} · "
              f"{'active' if payload.get('activated') else payload['status']}"
              + (f" · snapshot {payload['snapshot']}" if "snapshot" in payload else ""))
    return 0


def draft_main(argv: list[str]) -> int:
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    mode, v = parse_draft(argv)
    try:
        try:
            payload = draft_command(mode, v)
        except OSError as exc:
            raise refusal(f"{type(exc).__name__}: {exc}", io_error=True)
    except Refused as exc:
        if v.get("--json"):
            print(json.dumps({"refused": str(exc), **getattr(exc, "details", {})},
                             ensure_ascii=False, indent=2))
        else:
            print(f"perry-goals: refused — {exc}", file=sys.stderr)
        return 1
    if v.get("--json") or mode == "show":
        # `show` is always the payload: the body verbatim, for the agent to
        # read and summarize. This tool summarizes nothing.
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    else:
        print(f"perry-goals: {'wrote' if payload['written'] else 'did not write'}"
              f" {payload['path']} · {payload['status']} · sha256 "
              f"{payload.get('sha256', 'unchanged')}"
              + (" · finalize unavailable" * (payload["status"] == "approved")))
    return 0


COMMANDS = {"list": None, "commit": cmd_commit, "link": cmd_link,
            "krs": cmd_krs, "measure": cmd_measure, "check": cmd_check,
            "kr": cmd_kr, "objective": cmd_objective}


# The existing dispatch has two reads; all other commands enter the write
# gate below. Share the actor validator with perry-task without converting
# this legacy parser to a full SURFACE in an actor-only change.
READ_COMMANDS = frozenset(("list", "krs"))
ACTOR_SURFACE = {
    "name": "perry-goals",
    "subcommands": [
        {"name": name, "flags": ["--actor"],
         "writes": [] if name in READ_COMMANDS else (
             ["linkage.jsonl", "okr.jsonl"] if name == "kr" else [
                 "OKR.md" if name == "commit" else "linkage.jsonl"])
         + ([] if name in READ_COMMANDS else [".perry/events.jsonl"])}
        for name in COMMANDS
    ],
}
ACTOR_USAGE = {
    **KR_WRITER_USAGE,
    "commit": 'perry-goals commit --track main --promise "…" --to "…" '
              '--due 2026-11-30 --actor goals',
    "link": "perry-goals link <TASK-ID> <KR-ID> --actor goals",
}


class Args:
    pass


def parse(argv: list[str]) -> Args:
    a = Args()
    a.cmd = a.root = a.level = a.phase = a.version = None
    a.id = a.track = a.promise = a.to = a.due = a.by_when_note = None
    a.close = a.miss = a.reason = a.discharged_by = None
    a.actor = None
    a.as_json = a.dry_run = a.accept_hand_edit = a.migrate = False
    #: `link`'s three alternative shapes, and its positional arguments. They
    #: are collected rather than consumed by name because
    #: `goals/reference/linkage.md` writes the grammar that way — `--alias
    #: <PROJECT-ID> "<name>"` is two values after a mode flag — and a page
    #: documenting a command that takes its arguments differently is the stale
    #: instruction `tests/test_procedures_call_the_tool.py` exists to end.
    a.alias = a.unlinked = a.project = False
    a.rest = []
    #: `measure` and `check` (TASK-264). `okr_version` stays `None` when the
    #: flag is absent, because `--okr-version ""` is a value: the phase KR.
    a.okr_version = a.check = a.value = a.evidence = None
    a.direction = a.target = a.baseline = a.label = None
    #: `kr` (TASK-264 D3). `--set` repeats, so it is collected, not set.
    a.objective = a.text = None
    a.sets = []
    #: Every flag token seen, so the two KR writers can refuse a flag that is
    #: not theirs at exit 2 — see `KR_WRITER_FLAGS`.
    a.seen = set()
    flags = {"--root": "root", "--level": "level", "--id": "id",
             "--phase": "phase", "--version": "version",
             "--track": "track", "--promise": "promise", "--to": "to",
             "--due": "due", "--by-when-note": "by_when_note",
             "--close": "close", "--miss": "miss",
             "--reason": "reason", "--discharged-by": "discharged_by",
             "--actor": "actor", "--okr-version": "okr_version",
             "--check": "check", "--value": "value", "--evidence": "evidence",
             "--direction": "direction", "--target": "target",
             "--baseline": "baseline", "--label": "label",
             "--objective": "objective", "--text": "text"}
    i = 0
    while i < len(argv):
        t = argv[i]
        if t.startswith("--"):
            a.seen.add(t)
        if t in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        elif t == "--json":
            a.as_json = True
        elif t == "--dry-run":
            a.dry_run = True
        elif t == "--migrate":
            a.migrate = True
        elif t in ("--alias", "--unlinked", "--project"):
            setattr(a, t[2:], True)
        elif t == "--accept-hand-edit":
            a.accept_hand_edit = True
        elif t == "--set":
            i += 1
            if i >= len(argv):
                print("perry-goals: --set takes a value", file=sys.stderr)
                sys.exit(2)
            a.sets.append(argv[i])
        elif t == "--by":
            # **The flag the split removed, refused by name rather than
            # swallowed.** `--by` fed one column that held both a date and
            # prose; silently aliasing it to `--due` would refuse every
            # standing commitment whose deadline was worded rather than dated,
            # with a message about a flag the caller never typed.
            raise Refused(
                "--by is gone. `By when` was one column carrying two value "
                "spaces, and it is now two fields: `--due` takes an ISO date "
                "or an SLA token (3d, 2w) and is validated, `--by-when-note` "
                "takes the words the deadline was promised in and is not. "
                "Nothing was written")
        elif t in flags:
            i += 1
            if i >= len(argv):
                # `argv[i] if i < len(argv) else None` made a valueless flag
                # indistinguishable from an absent one. For `--root` that is a
                # WRITE into the wrong project: `perry-goals commit … --root`
                # exited 0 having written into the cwd's project while the one
                # the caller named was untouched. Found by a V4 round after the
                # same line had been removed from four other tools and this one
                # was missed, because the sweep that found those probed
                # `<tool> --root` with no subcommand, where "expected one of …"
                # returns 2 for an unrelated reason.
                print(f"perry-goals: {t} takes a value", file=sys.stderr)
                sys.exit(2)
            # A value that is present but EMPTY is the same defect one layer
            # in, and `lib.empty_root_error` owns the rule — see its docstring
            # for the eight tools that had the refusal and the six that did.
            # Measured before this line existed: `perry-goals commit --track
            # main --promise … --root ""`, run from inside a DIFFERENT
            # project, exited 0 having written `OKR.md`, `okr.jsonl` and
            # `.perry/events.jsonl` into that project.
            bad = lib.empty_root_error(t, argv[i])
            if bad is not None:
                print(f"perry-goals: {bad}", file=sys.stderr)
                sys.exit(2)
            setattr(a, flags[t], argv[i])
        elif t.startswith("-"):
            # **An undeclared flag fell into `a.rest` and was dropped.**
            # Only `krs` and `link` read `a.rest`, so every other subcommand
            # accepted a misspelling in silence: `commit … --by-when-notes
            # "before the Q4 board meeting"` exited 0 and filed the commitment
            # with an EMPTY `By when note` cell, having swallowed both the
            # flag and its value. That is DESIGN-016 § 1.4 — accepted and
            # silently dropped — in the one lane whose output is a promise
            # somebody else reads. The positionals below are ids, slugs and
            # alias names, none of which begins with `-`.
            #
            # `--by` above is refused BY NAME before reaching here, and keeps
            # its own exit 1: it is a flag that existed and was retired, which
            # is a different thing to say than "this is not a flag".
            print(f"perry-goals: unknown argument {t!r} (try --help)",
                  file=sys.stderr)
            sys.exit(2)
        elif a.cmd is None:
            a.cmd = t
        else:
            # Before `link` there was nowhere for these to go and they were
            # dropped in silence — `commit --track ops extra` ignored `extra`.
            # They are collected now, and every subcommand that takes none
            # refuses when the list is not empty.
            a.rest.append(t)
        i += 1
    return a


#: Printed after a `commit` write. The board-side link — a row's `Commitment`
#: cell carrying an `Id` from this table — is the `work` lane's write, and this
#: tool asks in chat rather than reaching across (`SKILL.md § The hand-off
#: contract`). The link runs from the board side on purpose, so this register
#: never accumulates ids that rot as rows close.
def handoff_line(cid: str) -> str:
    return (f"  ↪ hand-off: to point work at this promise, `/perry work` puts "
            f"`{cid}` in a board row's `Commitment` cell. `goals` does not "
            f"write BOARD.md.")


def main(argv: list[str]) -> int:
    if argv[:1] == ["draft"]:
        return draft_main(argv[1:])
    if argv[:1] == ["phase"]:
        return phase_main(argv[1:])
    try:
        args = parse(argv)
    except Refused as exc:
        # A refusal raised while reading the flags has no `args` to ask about
        # `--json`, so the question is put to `argv` — the same answer, one
        # layer earlier. Without this the retired `--by` would have exited
        # through the module-level handler with empty stdout under `--json`,
        # which is the shape of defect `UnrenderableCell`'s handler already
        # cost this file once.
        if "--json" in argv:
            print(json.dumps({"refused": str(exc)}, ensure_ascii=False, indent=2))
        else:
            print(f"perry-goals: refused — {exc}", file=sys.stderr)
        return 1
    if args.cmd not in COMMANDS:
        print(f"perry-goals: expected one of {' / '.join(COMMANDS)} "
              f"(try --help)", file=sys.stderr)
        return 2
    own = (KR_OP_FLAGS.get(args.rest[0] if args.rest else "",
                           KR_WRITER_FLAGS["kr"])
           if args.cmd == "kr" else KR_WRITER_FLAGS.get(args.cmd))
    stray = (sorted(args.seen - set(own)) if own is not None
             else sorted(args.seen & KR_WRITER_ONLY_FLAGS))
    if stray:
        legal = " ".join(own) if own is not None else ""
        print(f"perry-goals: `{args.cmd}` does not take {', '.join(stray)}"
              + (f"; it takes {legal}" if legal else
                 f"; {', '.join(stray)} belong(s) to `measure` / `check` / "
                 f"`kr`")
              + " (try --help)", file=sys.stderr)
        return 2
    no_actor = lib.actor_refusal(ACTOR_SURFACE, args.cmd, args.actor,
                                 single_line=True)
    if no_actor:
        print(f"{no_actor} Usage: {ACTOR_USAGE[args.cmd]}", file=sys.stderr)
        return 2
    if args.cmd in KR_WRITER_FLAGS:
        # Keep the existing KR writer normalization; commit/link transport
        # their valid caller-supplied actor unchanged.
        args.actor = args.actor.strip()
    try:
        if args.level and args.level not in ("overall", "phase"):
            raise Refused(f"--level {args.level!r} is not `overall` or `phase`")
        project_root = (Path(args.root).expanduser().resolve() if args.root
                        else Path(os.environ.get("PERRY_PROJECT") or Path.cwd()).resolve())
        state_root = P.resolve_state_root(project_root)
        if args.cmd == "list":
            result = build(project_root, state_root, args.level)
        elif args.cmd == "krs":
            # **On the read path, deliberately.** `krs` prints a register; it
            # opens no lock and passes no conformance gate because both belong
            # to writing. Routing it through the `else` branch below would take
            # the project lock to print a table and would REFUSE to print one
            # on a project whose `OKR.md` is out of shape — a read that cannot
            # answer while the file it does not touch is malformed.
            #
            # **Two registers, one verb, chosen by `--level`** — the same axis
            # `list` already takes, rather than a second spelling of "key
            # result" in the same tool. `phase` (the default) is the phase's
            # register in `linkage.jsonl`; `overall` is the OKR's own, in
            # `okr.jsonl`, which is the surface `OKR.md`'s KR tables became
            # when TASK-236 deleted them.
            ctx = {"project_root": project_root, "state_root": state_root}
            result = (cmd_overall_krs(args, ctx) if args.level == "overall"
                      else cmd_krs(args, ctx))
        else:
            # **The file this command writes is not always `OKR.md`**: `link`
            # writes the phase's linkage register instead. The ADR-004 gate
            # that used to stand here is gone (TASK-261) — it read a stored
            # DECLARATION and refused a write whose file no longer matched its
            # declared shape, and on this repository its ledger held 23
            # records, all `route: declare`, all Perry's own files. Zero
            # disagreements, because a disagreement needs a foreign project.
            # `--migrate`'s exemption went with it: with no gate to be exempt
            # from, a migration is just a write.
            # **Nothing is written into a directory that is not installed**
            # (TASK-237 round 2, F1). This tool declares no `SURFACE`, so the
            # scope is named here: every command on this branch writes the
            # OKR or linkage store and appends the event log.
            lib.refuse_write_unless_installed(
                project_root, ("okr.jsonl", "linkage.jsonl",
                               ".perry/events.jsonl"), Refused)
            phase_slug = None
            if args.cmd == "link":
                phase_slug = current_phase(state_root)
            with project_lock(state_root):
                ctx = {"project_root": project_root, "state_root": state_root}
                if args.cmd in KR_WRITER_FLAGS:
                    # `measure` and `check` read the two KR stores and write
                    # one; like `link`, they need no `OKR.md` model and no
                    # track register. The lock spans the resolution, every
                    # refusal and the append (`bin/ARCHITECTURE.md § 3`).
                    pass
                elif phase_slug is not None:
                    # `link` needs no `OKR.md` and no track register: it writes
                    # one file and reads one file, and requiring the other two
                    # would refuse an attribution on a project whose OKR is
                    # mid-interview.
                    ctx["register"] = Register(state_root, phase_slug)
                else:
                    ctx.update({"okr": Okr(state_root / "OKR.md"),
                                "tracks": tracks_of(project_root),
                                "events": read_events(project_root)})
                result = COMMANDS[args.cmd](args, ctx)
    # A value a markdown table row cannot carry, translated into the ordinary
    # refusal channel **here, where `args` is in scope** — the twin in
    # `bin/perry-task § main` is in the same place for the same reason. The
    # previous version of this handler sat at module level, which is a scope
    # with no `args` and therefore no way to answer `--json`: every line-break
    # refusal exited 1 with an empty stdout for a caller reading the payload.
    # `render_row` raises before the write, so a refusal still means nothing
    # was written.
    except UnrenderableCell as exc:
        msg = unrenderable_refusal(exc)
        if args.as_json:
            print(json.dumps({"refused": msg}, ensure_ascii=False, indent=2))
        else:
            print(f"perry-goals: refused — {msg}", file=sys.stderr)
        return 1
    except Refused as exc:
        if args.as_json:
            print(json.dumps({"refused": str(exc)}, ensure_ascii=False, indent=2))
        else:
            print(f"perry-goals: refused — {exc}", file=sys.stderr)
        return 1

    if args.as_json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    elif args.cmd == "krs":
        print(render_overall_krs(result) if result.get("level") == "overall"
              else render_krs(result))
    elif args.cmd == "objective":
        verb = "would write" if args.dry_run else "wrote"
        print(f"perry-goals: {verb} {Path(result['file']).name} — objective "
              f"add {result['objective']} · phase {result['phase']}")
        for line in result["diff"]:
            print(f"  {line}")
        if not args.dry_run and not result.get("event_written"):
            print("  ⚠ the record was written and the event was not — see the "
                  "warning above", file=sys.stderr)
    elif args.cmd == "kr":
        verb = "would write" if args.dry_run else "wrote"
        where = (f" ({result['okr_version']})" if result.get("okr_version")
                 else "")
        what = f"kr {result['op']} {result['kr']}{where}"
        if result.get("changes"):
            what += " · " + "; ".join(
                f"{f}: {json.dumps(c['before'], ensure_ascii=False)} → "
                f"{json.dumps(c['after'], ensure_ascii=False)}"
                for f, c in result["changes"].items())
        print(f"perry-goals: {verb} {Path(result['file']).name} — {what}")
        for line in result["diff"]:
            print(f"  {line}")
        if result.get("unchanged"):
            print(f"  · already so, not recorded: "
                  f"{', '.join(result['unchanged'])}")
        if not args.dry_run and not result.get("event_written"):
            print("  ⚠ the record was written and the event was not — see the "
                  "warning above", file=sys.stderr)
        print(f"  ↪ read: \"$PERRY_HOME/bin/perry-goals\" krs"
              f"{' --level overall' if result.get('level') == 'overall' else ''}"
              f" --json")
    elif args.cmd in KR_WRITER_FLAGS:
        verb = "would write" if args.dry_run else "wrote"
        where = (f" ({result['okr_version']})" if result.get("okr_version")
                 else "")
        if args.cmd == "measure":
            what = (f"measurement {result['kr']}{where} · {result['check']} = "
                    f"{result['value']} (evidence {result['evidence']})")
        else:
            what = f"check {result['kr']}{where} · {result['id']}"
            if result.get("supersedes"):
                what += (f" — supersedes the declaration of "
                         f"{result['supersedes']}")
        print(f"perry-goals: {verb} {P.LINKAGE_STORE} — {what}")
        for line in result["diff"]:
            print(f"  {line}")
        if not args.dry_run and not result.get("event_written"):
            print("  ⚠ the record was written and the event was not — see the "
                  "warning above", file=sys.stderr)
        print(f"  ↪ read: \"$PERRY_HOME/bin/perry-goals\" krs"
              f"{' --level overall' if result.get('okr_version') else ''} --json")
    elif args.cmd == "commit" and result.get("migrated"):
        m = result["migrated"]
        verb = "would split" if args.dry_run else "split"
        print(f"perry-goals: {verb} OKR.md § Commitments — {m['rows']} row(s): "
              f"{m['kept_as_due']} kept as `Due`, {m['moved_to_note']} moved to "
              f"`By when note`, {m['empty']} already empty")
        if m["renamed_column"]:
            print(f"  · header cell renamed: {m['renamed_column']}")
        for column in m["widened"]:
            print(f"  · widened the table with a `{column}` column; every row "
                  f"was padded for it")
        print(f"  · {m['kept_as_due'] + m['moved_to_note']} non-empty clock "
              f"cell(s) before, {m['kept_as_due'] + m['moved_to_note']} after "
              f"— nothing was dropped")
    elif args.cmd == "link":
        if result.get("already"):
            print(f"perry-goals: nothing to write — {result['already']}")
        else:
            verb = "would write" if args.dry_run else "wrote"
            what = {
                "edge": lambda r: f"{r.get('task')} → {r.get('kr')}",
                "unlinked": lambda r: f"{r.get('task')} declared unlinked",
                "alias": lambda r: f"{r.get('project')} also answers to "
                                   f"{r.get('alias')!r}",
                "project": lambda r: f"{r.get('project')} serves "
                                     f"{r.get('serves')} ({r.get('name')!r})",
            }[result["mode"]](result)
            print(f"perry-goals: {verb} {Path(result['file']).name} — {what}")
            if result.get("undeclared_unlinked"):
                print("  · removed from `unlinked[]` in the same edit — it "
                      "would otherwise render as attributed and drifting")
            for line in result["diff"]:
                print(f"  {line}")
            print(f"  ↪ validate: \"$PERRY_HOME/bin/perry-lint\" --root .")
    elif args.cmd == "commit":
        verb = "would write" if args.dry_run else "wrote"
        print(f"perry-goals: {verb} OKR.md § Commitments — {result['id']}"
              f"{' → ' + result['to'] if result.get('to') else ''}")
        if result.get("created_section"):
            print("  · created the `## Commitments` section from "
                  "goals/state/OKR_TEMPLATE.md — header and note included")
        for column in result.get("widened") or []:
            print(f"  · widened the table with a `{column}` column; every row "
                  f"was padded for it")
        print(handoff_line(result["id"]))
    else:
        o = result["okr"]
        print(f"  OKR {o['version'] or '—'} · {o['mission'][:60] or '—'}")
        ph = result["phase"]
        if ph:
            print(f"  phase #{ph['number']} {ph['slug']} · day {ph['day']}")
        for k in result["krs"]:
            n = ("—" if k["target"] is None or k["current"] is None
                 else f"{k['current']}/{k['target']}")
            # The pair is never printed bare any more. `asserted` says the
            # number was typed by an author and not measured by anything, and
            # the tally beside it is a count of TASKS — the two are printed
            # apart, in different units, so neither can be read as the other.
            t = k["linked_task_completion"]
            # **`measured` is a third answer and it was missing** (TASK-382).
            # This branch folded every non-`unasserted` state into the word
            # `asserted`, so `P003-O3-KR2` — the one KR in this register whose
            # metric `bin/lib § computed_kr_current` RE-RUNS on every read —
            # printed as `31.0/100.0 asserted` while the same command's
            # `--json` reported `current_provenance.state: measured` for the
            # same row. One command, one invocation, one flag apart, two
            # answers. Staleness is not consulted for a measured number: a
            # measurement re-derived on this read cannot be stale, and asking
            # `current_staleness` about it would print `STALE` for a number
            # computed a millisecond ago.
            state = k["current_provenance"]["state"]
            note = "" if state == "unasserted" else (
                "measured" if state == "measured" else
                "asserted" if not k["current_staleness"]["stale"] else "STALE")
            edge = (f"  {t['done'] + t['dropped']}/{t['total']} tasks closed"
                    if t["total"] else "")
            print(f"  {k['id']:10} {k['level']:8} {n:>9} {note:<8}"
                  f"{edge:<22}{k['title'][:44]}")
        c = result["conformance"]
        print(f"\n  {result['counts']['krs']} KR(s) · "
              f"{len(c['krs_without_numbers'])} with no target/current pair")
        # **The footer stated a universal that `COMPUTED_KR_METRICS` makes
        # false** (TASK-382), and it stated it two lines under the row it was
        # false about. It is now computed from the payload it is describing
        # rather than asserted about it: a claim that quantifies over the rows
        # has to be derived from the rows, or it goes on being true only until
        # someone adds the first exception.
        measured = [k["id"] for k in result["krs"]
                    if k["current_provenance"]["state"] == "measured"]
        if measured:
            print(f"  {len(measured)} `current` here "
                  f"{'is' if len(measured) == 1 else 'are'} measured, re-run "
                  f"on this read ({', '.join(measured)}); the rest are "
                  f"asserted by an author. The task counts are not progress")
        else:
            print("  no `current` here is a measurement — every one is "
                  "asserted by an author; the task counts are not progress")
        if c["krs_with_stale_current"]:
            print(f"  ⚠ {len(c['krs_with_stale_current'])} KR(s) whose linked "
                  f"tasks moved since the number was asserted: "
                  + ", ".join(c["krs_with_stale_current"]))
        if not c["linkage_present"]:
            print("  ⚠ no linkage register — no KR carries task edges or a target")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    # See the twin in `bin/perry-task § main`. Both writers call `render_row`,
    # so both need the translation; a guard installed in only the tool where
    # the bug happened to surface is the mistake `render_row`'s own docstring
    # is about.
    except UnrenderableCell as exc:
        # **The last resort, not the handler.** `main` catches this where
        # `args` is in scope; what is left for module level is whatever could
        # be raised outside that `try` — today, nothing. It stays because the
        # alternative to a refusal here is a traceback, which is what this
        # file printed for 88 of 88 measured line-break refusals when the
        # ONLY handler lived here: it was a verbatim copy of `perry-task`'s
        # block, which runs inside `main()` where `args` is a local, so every
        # one of them ended in `NameError: name 'args' is not defined` and
        # `--json` got empty stdout. A test asserted `"line break" in stderr`
        # and passed **on the traceback**, whose own last line carries the
        # phrase. That is why nothing caught it.
        #
        # The flag is carried on the exception, set by whoever raises it —
        # the only layer that both knows the flag and is in scope. See
        # `naming_the_flag`.
        print(f"perry-goals: refused — {unrenderable_refusal(exc)}",
              file=sys.stderr)
        sys.exit(1)
    except Refused as exc:
        print(f"perry-goals: refused — {exc}", file=sys.stderr)
        sys.exit(1)
