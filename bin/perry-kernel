#!/usr/bin/env python3
"""perry-kernel — the kernel CLI (DESIGN-023). A thin wrapper: it imports the
package under kernel/ and runs its main(); it holds no logic of its own.
Usage, flags and commands: perry-kernel --help, or perry-kernel describe."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "kernel"))
from perry_kernel import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
