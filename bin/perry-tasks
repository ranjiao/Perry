#!/usr/bin/env python3
"""
`perry/tasks.jsonl` — the task store, and the projection of it.

**Phase 002, ADR-007's first slice.** This tool derives the store, proves it can
reproduce `BOARD.md`, and writes it. `bin/perry-task` is what writes it on every
ordinary command (TASK-089); this one is the migration and inspection surface.

The usage block is generated from this tool's `SURFACE`
declaration — run `perry-tasks --help`, or `perry-tasks <subcommand>
--help` for one of them, or `perry-tasks --describe --json` for the
whole surface as data.

**The argument for every refusal below is in
`bin/README.md § The argument, per tool`**, moved there whole on
2026-09-09 (DESIGN-016 Decision 2). Nothing was cut; `--help`
stopped being the place to read it.
"""

from __future__ import annotations

import hashlib
import json
import os
import sys
import tempfile
from itertools import zip_longest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "viewer"))
sys.path.insert(0, str(Path(__file__).resolve().parent))
import lib  # noqa: E402
import parsers as P  # noqa: E402
from tables import UnrenderableCell, header_index  # noqa: E402
import perry_store  # noqa: E402

#: Written to the store — `bin/perry_store.py` owns the list, and this name is
#: kept so a reader of either file lands in the same place.
STORED = perry_store.STORED


class Refused(Exception):
    pass


def build(project_root: Path) -> list[dict]:
    """The store, derived from today's canonical sources.

    Reads the board AND the event log, because `done` removes a row: a store
    built from the board alone would lose every closed task, which is the trap
    `check_verification` documents and `walk_design` repeated.

    **One derivation, in `bin/perry-task § store_records`.** This used to hold
    its own copy of the projection and `perry-task` grew a second one the day
    it started writing the store — two functions answering "what does the store
    hold for this row", which is the shape of every silent disagreement in this
    repository's history.
    """
    task_mod = _task_module()
    state_root = P.resolve_state_root(project_root)
    board = task_mod.Board(state_root / "BOARD.md")
    try:
        records, _conformance = task_mod.store_records(
            project_root, state_root, board, task_mod.read_events(project_root))
    except task_mod.Refused as exc:
        raise Refused(str(exc)) from None
    return records


_TASK_MODULE = None


def _task_module():
    """`bin/perry-task` as a module, loaded ONCE per process.

    It was loaded per call and this file now calls it three times on one
    `diff` — 4,200 lines re-executed each time, for a module with no state to
    reset between them.
    """
    global _TASK_MODULE
    if _TASK_MODULE is not None:
        return _TASK_MODULE
    import importlib.machinery
    import importlib.util
    path = Path(__file__).resolve().parent / "perry-task"
    spec = importlib.util.spec_from_loader(
        "perry_task_mod", importlib.machinery.SourceFileLoader(
            "perry_task_mod", str(path)))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    _TASK_MODULE = mod
    return mod


# ── the renderer ──────────────────────────────────────────────────────────
#
# `bin/perry_store.py` holds it. These names are re-bound rather than
# reimplemented so `perry-tasks.render` and the renderer `perry-task` runs on
# every write are the same function — a second copy here is exactly how the two
# parsers of `BOARD.md` came to disagree, and the round trip would go red one
# project later rather than one test earlier.

FIELD_BY_COLUMN = perry_store.FIELD_BY_COLUMN
cell_text = perry_store.cell_text
describe_cell = perry_store.describe_cell
render_line = perry_store.render_line


def plan(root: Path, records: list[dict]) -> dict:
    """Today's board on disk, split into the lines the store fills and the rest."""
    mod = _task_module()
    board = mod.Board(P.resolve_state_root(root) / "BOARD.md")
    return perry_store.plan(board, records, mod)


def render(root: Path, records: list[dict]) -> tuple[str, dict]:
    """`perry/tasks.jsonl` → the text of `BOARD.md`. Byte-for-byte is the bar."""
    mod = _task_module()
    board = mod.Board(P.resolve_state_root(root) / "BOARD.md")
    return perry_store.render(board, records, mod)


#: The two spellings a render report uses for "the store holds this record and
#: the file has no line to put it in". `perry_store`'s reports say
#: `rows_not_on_board`; `perry_md_store`'s say `records_not_in_the_file`. One
#: reader over both, so a register added later cannot be missed by the check
#: below just by naming its key the other way.
STRANDED_KEYS = ("rows_not_on_board", "records_not_in_the_file")


def stranded_records(report: dict) -> list[str]:
    for key in STRANDED_KEYS:
        if report.get(key):
            return list(report[key])
    return []


def stranded_after_render(text: str, records: list[dict], planner) -> list[str]:
    """Which records the TEXT ABOUT TO BE WRITTEN still has no line for.

    **The question is asked of the render, not of the file it came from**, and
    the difference is a whole register. `perry_store.plan` reports
    `rows_not_on_board` against the board ON DISK, which is the drift; whether
    that drift survives the write depends on the renderer. The task rows are
    filled in place, so a deleted row stays deleted and the record is stranded.
    `## Intake` is rebuilt from its records, so the same deleted line comes
    BACK — `tests/test_intake_store § test_the_shift_is_reported_rather_than
    _absorbed_by_a_re_render` asserts exactly that, and it is right.
    Refusing on the on-disk report would have broken a register whose recovery
    works.

    So the render is re-run against its own output. Empty means every record
    found a line and the write is a real recovery.
    """
    with tempfile.TemporaryDirectory() as tmp:
        probe = Path(tmp) / "BOARD.md"
        probe.write_text(text, encoding="utf-8")
        mod = _task_module()
        return stranded_records(planner(mod.Board(probe), records, mod))


def write_board_or_refuse(root: Path, text: str, records: list[dict], *,
                          flags: frozenset, planner, section: str = "",
                          unit: str = "stored record(s)") -> int:
    """Put the render on disk, or refuse and say what it could not place.

    **This is the recovery path, and it used to report a recovery it had not
    performed** (DESIGN-016 § 1.5, A5). `render` fills the line that already
    carries a record's id; it does not create lines. Delete the 151 task rows
    from a copy of `BOARD.md` and the old code printed `rendered … from 399
    stored record(s)`, exit 0, having restored none of them — while
    `perry-tasks diff` correctly listed all 151 under `rows_not_on_board` and
    `perry-lint` reported `151 row(s) drifted`. The detection layer was right
    and only the writer lied.

    Two changes. A write that cannot place every record refuses, exit 1, naming
    what it could not place. And the success line counts lines changed rather
    than records read, so a write and a no-op no longer print the same sentence
    (TASK-253 recorded that from the other side).
    """
    stranded = stranded_after_render(text, records, planner)
    where = f"BOARD.md{f' § {section}' if section else ''}"
    if stranded:
        print(f"perry-tasks: refusing to write {where} — {len(stranded)} "
              f"stored record(s) have no line in it to render into, and "
              f"`render` fills lines rather than creating them. Nothing was "
              f"written.", file=sys.stderr)
        for rid in stranded[:10]:
            print(f"    {rid}", file=sys.stderr)
        if len(stranded) > 10:
            print(f"    … and {len(stranded) - 10} more", file=sys.stderr)
        print(f"\n  `perry-tasks diff` lists them all. Putting the lines back "
              f"is a repair this command cannot do.", file=sys.stderr)
        return 1
    state_root = P.resolve_state_root(root)
    path = state_root / "BOARD.md"
    before = path.read_text(encoding="utf-8").splitlines() if path.exists() else []
    after = text.splitlines()
    changed = sum(1 for a, b in zip_longest(before, after) if a != b)
    if "--dry-run" in flags:
        verb, wrote = "would rewrite", False
    else:
        lib.write_atomic(path, text)
        verb, wrote = "rewrote", True
    if "--json" in flags:
        print(json.dumps({"file": str(path), "section": section or None,
                          "wrote": wrote, "dry_run": "--dry-run" in flags,
                          "lines_changed": changed,
                          "lines_unchanged": len(after) - changed,
                          "records": len(records)},
                         ensure_ascii=False, indent=2))
    else:
        print(f"perry-tasks: {verb} {path}"
              f"{f' § {section}' if section else ''} — {changed} line(s) "
              f"changed, {len(after) - changed} unchanged, from "
              f"{len(records)} {unit}")
    return 0


def write_store_or_say_what_would_land(dest: Path, records: list[dict], *,
                                       flags: frozenset, unit: str) -> int:
    """The store import's last step, with `--dry-run` and `--json` honoured.

    **Both were ACCEPTED and ignored here** — TASK-253 filed exactly that in
    2026-09-02, and DESIGN-016 A2 made the flag legal without making it do
    anything, which is the accepted-and-dropped shape the design exists to
    remove. Measured 2026-09-09 before this function: `perry-tasks write
    --from-board --dry-run` replaced a 404-record store and printed `wrote`.

    Honest because nothing is estimated: the records are derived and every
    refusal above has already been asked, so the only thing `--dry-run` skips
    is the rename.
    """
    if "--dry-run" in flags:
        held = 0
        if dest.exists():
            held = len([l for l in dest.read_text(encoding="utf-8").split("\n")
                        if l.strip()])
        if "--json" in flags:
            print(json.dumps({"store": str(dest), "wrote": False,
                              "dry_run": True, "records": len(records),
                              "records_on_disk": held}, ensure_ascii=False,
                             indent=2))
        else:
            print(f"perry-tasks: would write {dest} ({len(records)} {unit}, "
                  f"{held} on disk now). Nothing was written.")
        return 0
    lib.write_atomic(dest, perry_store.store_text(records))
    if "--json" in flags:
        print(json.dumps({"store": str(dest), "wrote": True, "dry_run": False,
                          "records": len(records)}, ensure_ascii=False,
                         indent=2))
    else:
        print(f"perry-tasks: wrote {dest} ({len(records)} {unit})")
    return 0


def load_store(root: Path) -> tuple[list[dict], Path]:
    """The store as it is ON DISK — never the one just built.

    `verify` documents why at length and the reason is the same one: a
    renderer fed a store built from the board it is being compared against
    proves that `split_row` and `render_row` are inverses, which nobody
    doubted, and proves nothing at all about the store.
    """
    store_path = P.resolve_state_root(root) / "tasks.jsonl"
    if not store_path.exists():
        return [], store_path
    return [json.loads(l) for l in store_path.read_text(encoding="utf-8")
            .split("\n") if l.strip()], store_path


def cmd_render(root: Path, byte_compare: bool,
               write_board: bool = False,
               flags: frozenset = frozenset()) -> int:
    try:
        records, store_path = load_store(root)
    except (OSError, ValueError) as exc:
        payload = {"identical": False, "store_valid": False,
                   "store_findings": [{"message":
                       f"store is not readable JSONL ({type(exc).__name__}: {exc})"}]}
        print(json.dumps(payload, ensure_ascii=False, indent=2),
              file=sys.stdout if byte_compare else sys.stderr)
        return 2
    if not records:
        print(json.dumps({
            "store": str(store_path), "exists": store_path.exists(),
            "note": f"no store on disk yet — run `perry-tasks write "
                    f"--from-board{lib.root_flag(root)}` to perform the "
                    f"explicit board import. Rendering the board from a store "
                    f"built out of that same board proves nothing.",
        }, ensure_ascii=False, indent=2), file=sys.stderr)
        return 2
    records, findings = perry_store.validate_records(records)
    if findings:
        payload = {"identical": False, "store_valid": False,
                   "store_findings": findings}
        print(json.dumps(payload, ensure_ascii=False, indent=2),
              file=sys.stdout if byte_compare else sys.stderr)
        return 2
    text, report = render(root, records)
    if not byte_compare:
        if write_board:
            # The missing direction. `write` ran board → store and `render` ran
            # store → stdout, so there was no command that put a drifted board
            # back in line with the store — which is exactly what
            # `perry-lint § store-drift` needs to recommend, and why it was
            # recommending `write` instead.
            return write_board_or_refuse(
                root, text, records, flags=flags,
                planner=lambda b, r, m: perry_store.render(b, r, m)[1])
        sys.stdout.write(text)
        return 0
    live = (P.resolve_state_root(root) / "BOARD.md").read_text(encoding="utf-8")
    report["identical"] = text == live
    if not report["identical"]:
        a, b = live.split("\n"), text.split("\n")
        n = next((i for i in range(max(len(a), len(b)))
                  if (a[i:i + 1] or [None]) != (b[i:i + 1] or [None])), 0)
        report["first_difference"] = {
            "line": n + 1,
            "file": (a[n] if n < len(a) else "<past end of file>")[:400],
            "rendered": (b[n] if n < len(b) else "<past end of render>")[:400],
        }
    print(json.dumps(report, ensure_ascii=False, indent=2))
    return 0 if report["identical"] else 1


# ── the board from its declarations alone (TASK-237 deliverable 1) ───────
#
# `render` fills today's `BOARD.md` in place and refuses when the file is gone.
# `board` prints the whole board from what the tree declares: it reads exactly
# the seven files below, and no other. `perry_store.declared_board` does the
# work and opens nothing itself; its `DECLARED_BOARD_CHOICES` lists every
# layout decision.
#
#     schema/state-schema.json § files[id=board]   (PERRY_HOME)
#     work/state/BOARD_TEMPLATE.md                 (PERRY_HOME, the entry's `template`)
#     .perry/config.jsonl                          (the project's, for `state_root`)
#     <state root>/tasks.jsonl, asks.jsonl, risks.jsonl, intake.jsonl,
#     cadence.jsonl                                (3b: the fifth store)
#
# **Read-only, so it takes no lock and no `--register`.** It dispatches ahead of
# both in `main`. A store that is absent is empty; a store that does not parse,
# or fails its own `validate_*`, refuses with exit 2 and prints no board.

BOARD_STORES = perry_store.BOARD_STORES


def cmd_board(root: Path) -> int:
    # **A board for a directory that is not a Perry project is a lie** (TASK-237
    # Amendment (4) item 1, aiMark 2.1): it printed the template's empty
    # skeleton at exit 0, which a reader cannot tell from a project with no
    # open work. The predicate is the payloads' own (`schema/README.md §
    # installed`). Refused before anything is read, and nothing on stdout.
    if not P.installed(root):
        print(f"perry-tasks: refused — {root} is not an installed Perry "
              f"project: no `.perry/config.jsonl` at its root and no "
              f"canonical store under its state root (`schema/README.md § "
              f"installed`). Nothing was printed.", file=sys.stderr)
        return 1
    try:
        schema = lib.load_schema(refused=Refused)
        spec = next((f for f in schema.get("files", [])
                     if f.get("id") == "board"), None)
        if spec is None:
            raise Refused("schema/state-schema.json declares no files[id=board]")
        template = (lib.PERRY_HOME / spec["template"]).read_text(encoding="utf-8")
    except (Refused, OSError, ValueError, KeyError) as exc:
        print(f"perry-tasks: refused — the board's declaration is unreadable "
              f"({type(exc).__name__}: {exc}). Nothing was printed.",
              file=sys.stderr)
        return 2
    state_root = P.resolve_state_root(root)
    stores, findings = perry_store.load_board_stores(state_root)
    if findings:
        print(json.dumps({"refused": "a store is malformed; no board was "
                          "printed", "store_findings": findings},
                         ensure_ascii=False, indent=2), file=sys.stderr)
        return 2
    try:
        text, report = perry_store.declared_board(
            spec, template, stores, project_name=P.project_name(root))
    except UnrenderableCell as exc:
        print(f"perry-tasks: refused — {exc.why}. Nothing was printed.",
              file=sys.stderr)
        return 1
    except perry_store.UnfilledPlaceholder as exc:
        print(f"perry-tasks: refused — {exc}. Nothing was printed.",
              file=sys.stderr)
        return 1
    sys.stdout.write(text)
    for title in report["undeclared_groups"]:
        print(f"perry-tasks: open tasks in group {title!r} match no declared "
              f"heading; printed under `## {title}`", file=sys.stderr)
    return 0


# ── the risks register ────────────────────────────────────────────────────
#
# `bin/perry_store.py` holds the record shape and the renderer, exactly as it
# does for tasks. These four verbs are the migration and inspection surface;
# `bin/perry-task risk-add` / `risk-clear` are what write it in the ordinary
# course.


def risk_board(root: Path):
    """The board, and `bin/perry-task` as `ops`."""
    mod = _task_module()
    return mod.Board(P.resolve_state_root(root) / "BOARD.md"), mod


#: How many repeated ids the refusal names before summarising the tail.
#: `bin/perry-task § DUPLICATE_IDS_SHOWN`'s value and its rule: the cap is on
#: the OUTPUT and never on the count.
DUPLICATE_IDS_SHOWN = 5


def refuse_duplicate_ids(section: str, dest, dupes: list[dict]) -> str:
    """The message for a board section carrying one id on more than one row.

    TASK-273. Written once and used by both `--from-board` importers, because
    two spellings of this refusal is how the risks register ends up telling a
    human something the asks register does not.

    **The wording differs from `perry-task`'s on purpose.** That one interrupts
    an ordinary command whose author was not thinking about the register at
    all; this one interrupts an explicit, consented board-to-store import, so
    it says what the import would have produced — a record count lower than the
    row count — rather than what a later mint would go on to overwrite.
    """
    named = "; ".join(
        "`%s` on lines %s" % (d["id"],
                              ", ".join(str(r["line"]) for r in d["rows"]))
        for d in dupes[:DUPLICATE_IDS_SHOWN])
    more = ("" if len(dupes) <= DUPLICATE_IDS_SHOWN else
            f" …and {len(dupes) - DUPLICATE_IDS_SHOWN} more repeated id(s)")
    rows = sum(len(d["rows"]) for d in dupes)
    # The rows themselves, not only their line numbers. "Line 23 differs" is
    # the thing the byte gate's refusal was built to avoid saying, and this
    # refusal now runs ahead of it — so it carries the same obligation.
    listing = "".join(
        f"\n    line {r['line']}: {r['text']!r}"
        for d in dupes[:DUPLICATE_IDS_SHOWN] for r in d["rows"])
    return (
        f"perry-tasks: refusing to write {dest}.\n\n"
        f"  `## {section}` carries the same id on more than one row — "
        f"{named}{more}. This store is keyed on that id, so those {rows} rows "
        f"would import as {len(dupes)} record(s): the derivation keeps the "
        f"FIRST row for each repeated id and the rest of its cells are "
        f"dropped.\n{listing}\n\n"
        f"  The byte gate below this check does not see it when the duplicate "
        f"rows carry IDENTICAL cells — they render back byte for byte and the "
        f"gate has no question to fail (TASK-273). Give each row its own id, "
        f"or delete the surplus row, and re-run.\n\n"
        f"  Nothing was written.")


def load_risk_store(root: Path) -> tuple[list[dict], Path]:
    """The risks store as it is ON DISK — never the one just derived.

    Same rule as `load_store` for the same reason: a renderer fed a store built
    from the section it is being compared against proves that `split_row` and
    `render_row` are inverses and proves nothing at all about the store.
    """
    path = perry_store.risk_store_path(P.resolve_state_root(root))
    if not path.exists():
        return [], path
    return [json.loads(l) for l in path.read_text(encoding="utf-8")
            .split("\n") if l.strip()], path


#: What `risks-write` refuses when the claim is not there, and why — reported
#: rather than worked around. `perry/risks.jsonl` is a canonical record file
#: sitting in the user's state root, and every such file is declared in
#: `schema/state-schema.json § claims` with an owner and an anchor. That
#: declaration is part of this project's claim surface and is released by the
#: user, not minted by the change that wants it. Without it this command names
#: the gap instead of writing an undeclared file into somebody's project —
#: which is the exact failure ADR-004 and the claim surface exist to prevent.
#:
#: **It is a live guard, not a historical note.** The declaration landed on
#: 2026-08-21 for THIS repository; a project running Perry off a schema that
#: does not carry the entry — an old install, a fork, a hand-edited schema —
#: reaches this refusal, and reverting the `claims[]` entry must switch the
#: command off rather than leave it writing.
RISK_STORE_UNDECLARED = (
    "perry-tasks: refusing to write `risks.jsonl`.\n\n"
    "  The risks register's record shape, its renderer and its drift report "
    "are implemented and tested, and `risks-diff` proves the projection "
    "round-trips byte for byte. What is missing is the DECLARATION: a "
    "canonical record file in the state root is declared in "
    "`schema/state-schema.json § claims` with an owner and an anchor, the way "
    "`tasks.jsonl` is, and writing one that is not declared puts a file Perry "
    "does not admit to owning into the user's project.\n\n"
    "  That declaration is the user's to give. Until it lands, "
    "`perry-tasks risks-build` derives the records and `risks-diff` checks the "
    "projection, both without writing anything.")


def risk_store_is_declared() -> bool:
    """Does `schema/state-schema.json § claims` carry `risks.jsonl`?

    Read from the schema rather than hardcoded, so the refusal below cannot
    outlive the condition it reports. A schema this tool cannot read is
    treated as NOT declaring it: "I cannot see it" is not "it is there", the
    same rule that makes an unknown dependency id unsatisfied.
    """
    try:
        claims = lib.load_schema(RuntimeError).get("claims", [])
    except Exception:
        return False
    return any(isinstance(c, dict) and c.get("path") == "risks.jsonl"
               for c in claims)


def cmd_risks_render(root: Path, byte_compare: bool,
                     write_board: bool = False,
                     flags: frozenset = frozenset()) -> int:
    """Render `## Top risks` from the risks store, or byte-compare the two.

    **From the store on disk when there is one, and from the section when
    there is not.** The second case is the migration gate and it says so in the
    payload (`source: "board"`): rendering records derived from the very
    section they are compared against cannot prove the store is right, and it
    is the only thing that can prove the RENDERER is — that every cell of the
    register rebuilds from a typed field rather than surviving as a literal.
    The report carries `cells_verbatim` and
    `cells_the_store_and_board_disagree_on` for exactly that reason: an
    uncounted fallback is how a renderer passes `cmp` while reproducing
    nothing.
    """
    board, ops = risk_board(root)
    try:
        records, store_path = load_risk_store(root)
    except (OSError, ValueError) as exc:
        print(json.dumps({"identical": False, "store_valid": False,
                          "store_findings": [{"message":
                              f"risks store is not readable JSONL "
                              f"({type(exc).__name__}: {exc})"}]},
                         ensure_ascii=False, indent=2),
              file=sys.stdout if byte_compare else sys.stderr)
        return 2
    # **An EMPTY store is a store.** `load_risk_store` returns `[]` for a file
    # that is not there AND for a file that holds no records, and this branch
    # read the second as the first — so a register whose table has a header
    # and no rows, imported by `risks-write --from-board`, came back reporting
    # `source: "board"` about a store that exists. That is the conflation
    # `risk_table` refuses one layer down ("a register with no rows in it" is
    # never the same answer as "there is nothing here this store can hold"),
    # and `perry-lint § check_risk_store_drift` already gets it right by
    # asking the path. The FILE decides which source this is; the record count
    # decides what there is to render.
    source = "store" if store_path.exists() else "board"
    if records:
        records, findings = perry_store.validate_risk_records(records)
        if findings:
            print(json.dumps({"identical": False, "store_valid": False,
                              "store_findings": findings},
                             ensure_ascii=False, indent=2),
                  file=sys.stdout if byte_compare else sys.stderr)
            return 2
    elif source == "board":
        if write_board:
            # **`--write` needs a store.** Rendering the section from records
            # derived out of that same section writes the file back over
            # itself: a no-op that reports success and would let somebody
            # believe a projection had been restored. `cmd_render` refuses the
            # storeless case for the same reason one register over.
            print(json.dumps({
                "store": str(store_path), "exists": store_path.exists(),
                "note": "no risks store on disk, so there is nothing to render "
                        "`## Top risks` FROM — rendering it from records "
                        "derived out of that same section would write the file "
                        "back over itself and report success. "
                        "`perry-tasks risks-diff` is the storeless check.",
            }, ensure_ascii=False, indent=2), file=sys.stderr)
            return 2
        records = perry_store.risk_records(board, ops)
    text, report = perry_store.risk_render(board, records, ops)
    report["source"] = source
    report["store"] = str(store_path)
    if not byte_compare:
        if write_board:
            return write_board_or_refuse(
                root, text, records, flags=flags, section="Top risks",
                unit="risk record(s)",
                planner=lambda b, r, m: perry_store.risk_render(b, r, m)[1])
        sys.stdout.write(text)
        return 0
    live = (P.resolve_state_root(root) / "BOARD.md").read_text(encoding="utf-8")
    report["identical"] = text == live
    if not report["identical"]:
        a, b = live.split("\n"), text.split("\n")
        n = next((i for i in range(max(len(a), len(b)))
                  if (a[i:i + 1] or [None]) != (b[i:i + 1] or [None])), 0)
        report["first_difference"] = {
            "line": n + 1,
            "file": (a[n] if n < len(a) else "<past end of file>")[:400],
            "rendered": (b[n] if n < len(b) else "<past end of render>")[:400],
        }
    print(json.dumps(report, ensure_ascii=False, indent=2))
    return 0 if report["identical"] else 1


def _would_discard(on_disk: list[dict], derived: list[dict]) -> list[str]:
    """Stored values the board-derived records do not carry, one line each.

    Compared **by field**, not by record and not by count. A record-level
    "differs" would print one line for a row whose title gained a comma and one
    line for a row whose status the store alone knows about, and the user
    cannot tell those apart — which is the whole decision this refusal is
    asking them to make.

    A record that is only in the store is reported as a whole: the board has no
    row for it, so `write` would delete it outright.
    """
    by_id = {r.get("id"): r for r in derived if r.get("id")}
    out: list[str] = []
    for rec in on_disk:
        tid = rec.get("id")
        if not tid:
            continue
        new = by_id.get(tid)
        if new is None:
            out.append(f"{tid}: in the store, no row on the board — "
                       f"the whole record would be dropped")
            continue
        for field in sorted(set(rec) | set(new)):
            a, b = rec.get(field), new.get(field)
            if a == b:
                continue
            out.append(f"{tid}.{field}: store={a!r} → board={b!r}")
    return out


#: Why `## Top risks` cannot be imported, per shape `risk_section_shape`
#: reports. **Refuse rather than guess**: each of these three is a section this
#: tool can read and must not write a store from, and each has a different
#: answer, so each says its own.
#:
#: `bullets` is the one that would otherwise pass the byte gate and be wrong.
#: `risk_records` returns `[]` for a bullet list, rendering it changes nothing,
#: and `cmp` is therefore clean — so a gate that only compared bytes would
#: write an empty store over a section holding real risks and report success.
#: **`{r}` is `lib.root_flag(root)`, and these are `str.format` templates
#: rather than plain strings because of it (TASK-253).** Two of the three
#: branches hand the reader a WRITER — `risk-add` creates the section,
#: `risk-migrate` rewrites it — and a constant at module scope has no root to
#: name, so the only place the caller's `--root` can be put in is the call
#: site. `{r}` is the sole field; nothing else in these strings is braced.
RISK_SECTION_UNIMPORTABLE = {
    "absent": (
        "there is no `## Top risks` section on this board, so there is no "
        "register to import. `perry-task risk-add{r}` creates the section and "
        "its table."),
    "bullets": (
        "`## Top risks` is still a bullet list. A bullet has no id, no "
        "`Opened` cell and no `Status` cell, so the records this would write "
        "are not a projection of it — they are `[]`, and writing them would "
        "report success over a section holding real risks. "
        "`perry-task risk-migrate{r}` converts the section (every bullet "
        "crosses verbatim), after which the rows have ids and this import has "
        "something to read — or, if the only bullet is the "
        "`(no active risks)` placeholder `BOARD_TEMPLATE.md` ships, "
        "`perry-task risk-add{r}` writes the table on its own and there is "
        "nothing here to migrate."),
    "foreign": (
        "`## Top risks` holds a table this tool must not treat as the "
        "register — either it has no `Risk` column (a legend, a severity key) "
        "or the section holds more than one table. Which one is the register "
        "is a question about somebody's document, and guessing it writes one "
        "table's cells into another table's store."),
}


def cmd_risks_write(root: Path, argv: list[str],
                    flags: frozenset = frozenset()) -> int:
    """`BOARD.md § Top risks` → `perry/risks.jsonl`. The ONE-WAY IMPORT.

    The model is `perry-tasks write --from-board` one register over and
    `perry-okr write --from-file` one document over: it exists to mint a store
    for a project that has none. ADR-007 decision 2 made the store canonical
    and the section rendered output, so this direction is the backwards one and
    is run once per project, at adoption, never in reverse. `perry-tasks
    risks-render --write` is the forward direction and the one a drifted
    section wants.

    **`--from-board` is the consent, and it is required.** The flag is not a
    modifier on a default behaviour; there is no other behaviour. A user who
    types `risks-write` alone is told which direction they asked for and which
    command runs the other one.

    **Four things are checked before a byte is written, and each one is a
    refusal that writes nothing (ADR-004).**

    1. The CLAIM. `risks.jsonl` is declared in `schema/state-schema.json §
       claims` or this does not run — see `RISK_STORE_UNDECLARED`.
    2. The SHAPE. `absent`, `bullets` and `foreign` are sections this tool can
       read and must not derive a store from — see
       `RISK_SECTION_UNIMPORTABLE`. Only `table` is importable.
    3. The BYTES. The derived records are rendered back over the section and
       byte-compared BEFORE the store is written. A migration that cannot
       reproduce what it replaces has not understood it, and the refusal names
       the row and the column rather than the line number alone.
    4. The STORE IS READABLE BACK. `validate_risk_records` is run on what is
       about to be written, so a section that mints a record this tool's own
       loader would reject is a finding about the section rather than an
       unreadable file reported as a success. This is the check
       `bin/perry_md_store.py § main` added for the same reason one document
       over.

    **`cleared` is carried across from the store on disk, and that is not the
    board losing an argument.** It is the one stored field the register has no
    column for — the day a risk stopped being live rides inside `Status` prose
    — so the board has nothing to say about it and `risk_records(…, current)`
    reads it from the store, exactly as `bin/perry-lint § check_risk_store_
    drift` does. Every field the section CAN express is taken from the section,
    which is what `--from-board` means. What that replaces is disclosed rather
    than swallowed: `_would_discard` prints it.

    **THE EVENT LOG: this command appends NOTHING, and that is the decision.**

    `perry-task risk-add` / `risk-clear` append `risk-add` / `risk-clear`
    events because a risk was raised or retired on that day, by that actor.
    An import raises nothing and retires nothing — it reads rows that already
    exist. Every event it could append would carry today's timestamp for a
    risk that may be nine months old, which is the same falsehood
    `risk_record` refuses when it stores `""` rather than today's date for an
    unrecorded `opened`; the event log would then be a history the project
    never had, and `perry-state` reads that log. The two importers this one is
    modelled on append nothing for the same reason. The store is the record
    that a store now exists; the file appearing on disk is the whole event.
    Asserted in `tests/test_risks_store.py`.
    """
    dest = perry_store.risk_store_path(P.resolve_state_root(root))

    if "--from-board" not in argv:
        r = lib.root_flag(root)
        print(f"perry-tasks: refusing section-to-store import without "
              f"`--from-board`. `risks.jsonl` is authoritative once it exists; "
              f"use `perry-tasks risks-render --write{r}` for store-to-section "
              f"recovery, or explicitly run `perry-tasks risks-write "
              f"--from-board{r}` to derive the store from "
              f"`BOARD.md § Top risks`.", file=sys.stderr)
        return 1

    if not risk_store_is_declared():
        print(RISK_STORE_UNDECLARED, file=sys.stderr)
        return 1

    board, ops = risk_board(root)
    shape, _tables = perry_store.risk_section_shape(board, ops)
    if shape != "table":
        print(f"perry-tasks: refusing to write {dest} — "
              f"{RISK_SECTION_UNIMPORTABLE[shape].format(r=lib.root_flag(root))}"
              f"\n\n"
              f"  Nothing was written.", file=sys.stderr)
        return 1

    try:
        on_disk, _path = load_risk_store(root)
    except (OSError, ValueError) as exc:
        print(f"perry-tasks: {dest} exists but cannot be read "
              f"({type(exc).__name__}: {exc}). Refusing to overwrite a store "
              f"this tool cannot compare against; move it aside and re-run.",
              file=sys.stderr)
        return 2
    _valid, malformed = perry_store.validate_risk_records(on_disk)
    if malformed:
        print(json.dumps({"refused": f"{dest} is malformed; refusing to "
                          f"overwrite a store that cannot be safely compared",
                          "store_findings": malformed},
                         ensure_ascii=False, indent=2), file=sys.stderr)
        return 2

    # **The byte gate below does not catch every duplicate id, and TASK-273
    # measured which ones it misses.** Two `## Top risks` rows sharing an id
    # with DIFFERENT prose render differently and the gate refuses — that is
    # the class `bin/perry-tasks § cmd_intake_write` names as the reason the
    # gate is not a tautology here, and it is real. Two rows sharing an id with
    # IDENTICAL prose render byte-for-byte identical: measured 2026-09-03,
    # three board rows became two records at exit code 0. The gate is a
    # question about BYTES and cannot be asked a question about counts.
    #
    # So the same refusal `perry-task § register_change` raises is raised here,
    # ahead of it, for the same reason and out of the same report. This is one
    # more caller of `risk_records`, not a new site: the two lines being
    # guarded are still `:748` and `:759-761`.
    dupes = perry_store.duplicate_row_ids(
        perry_store.risk_table(board, ops), ops, "id")
    if dupes:
        print(refuse_duplicate_ids("Top risks", dest, dupes), file=sys.stderr)
        return 1

    records = perry_store.risk_records(board, ops, on_disk)

    # The byte gate, run BEFORE the write rather than reported after it.
    # `risks-diff` answers the same question about a store that exists; this is
    # the one moment where the answer can still prevent the file.
    text, report = perry_store.risk_render(board, records, ops)
    live = (P.resolve_state_root(root) / "BOARD.md").read_text(encoding="utf-8")
    if text != live:
        a, b = live.split("\n"), text.split("\n")
        n = next((i for i in range(max(len(a), len(b)))
                  if (a[i:i + 1] or [None]) != (b[i:i + 1] or [None])), 0)
        print(f"perry-tasks: refusing to write {dest}.\n\n"
              f"  The records derived from `## Top risks` do not render that "
              f"section back byte for byte, so the store would not be a "
              f"projection of it — it would be a different register wearing "
              f"its name. A migration that cannot reproduce what it replaces "
              f"has not understood it.\n", file=sys.stderr)
        for d in report["cells_the_store_and_board_disagree_on"][:10]:
            print(f"    {d['id']} · column {d['column']}: "
                  f"board={d['board']!r} → would render {d['store']!r}",
                  file=sys.stderr)
        for r in report["rows_verbatim"][:10]:
            print(f"    row {r['cell']!r}: the store holds no record for it"
                  + (f" ({r['why']})" if r.get("why") else ""),
                  file=sys.stderr)
        print(f"\n  First differing line is {n + 1}:\n"
              f"    board:    {(a[n] if n < len(a) else '<past end of file>')[:200]}\n"
              f"    rendered: {(b[n] if n < len(b) else '<past end of render>')[:200]}\n"
              f"\n  Nothing was written.", file=sys.stderr)
        return 1

    _valid, bad = perry_store.validate_risk_records(records)
    if bad:
        print(json.dumps({"refused": "`## Top risks` produces a store this "
                          "tool could not read back; nothing was written",
                          "store_findings": bad},
                         ensure_ascii=False, indent=2), file=sys.stderr)
        return 1

    losses = _would_discard(on_disk, records)
    if losses:
        print(f"perry-tasks: {len(losses)} stored value(s) replaced by what "
              f"`## Top risks` says — `--from-board` is that instruction:",
              file=sys.stderr)
        for line in losses[:10]:
            print(f"    {line}", file=sys.stderr)
        if len(losses) > 10:
            print(f"    … and {len(losses) - 10} more", file=sys.stderr)

    # Staged and renamed under the project lock, like every other write to a
    # canonical file.
    return write_store_or_say_what_would_land(dest, records, flags=flags,
                                              unit="risk record(s)")


# ── the intake register ───────────────────────────────────────────────────
#
# TASK-196, and the four verbs are the risks four with one word changed. What
# is NOT the same is the key: an intake row has no id, so the store is keyed
# on `order` and every join is positional. `bin/perry_store.py § the intake
# register` holds that decision and what it costs.


def intake_board(root: Path):
    """The board, and `bin/perry-task` as `ops`."""
    mod = _task_module()
    return mod.Board(P.resolve_state_root(root) / "BOARD.md"), mod


def load_intake_store(root: Path) -> tuple[list[dict], Path]:
    """The intake store as it is ON DISK — never the one just derived."""
    path = perry_store.intake_store_path(P.resolve_state_root(root))
    if not path.exists():
        return [], path
    return [json.loads(l) for l in path.read_text(encoding="utf-8")
            .split("\n") if l.strip()], path


#: What `intake-write` refuses when the claim is not there, and why. The same
#: live guard `RISK_STORE_UNDECLARED` is, for the same reason: a canonical
#: record file in the user's state root is declared in `schema/state-schema.json
#: § claims` with an owner and an anchor, and that declaration is the user's to
#: give rather than the change's to mint.
INTAKE_STORE_UNDECLARED = (
    "perry-tasks: refusing to write `intake.jsonl`.\n\n"
    "  The intake register's record shape, its renderer and its drift report "
    "are implemented and tested, and `intake-diff` proves the projection "
    "round-trips byte for byte. What is missing is the DECLARATION: a "
    "canonical record file in the state root is declared in "
    "`schema/state-schema.json § claims` with an owner and an anchor, the way "
    "`tasks.jsonl` is, and writing one that is not declared puts a file Perry "
    "does not admit to owning into the user's project.\n\n"
    "  That declaration is the user's to give. Until it lands, "
    "`perry-tasks intake-build` derives the records and `intake-diff` checks "
    "the projection, both without writing anything.")


def intake_store_is_declared() -> bool:
    """Does `schema/state-schema.json § claims` carry `intake.jsonl`?

    Read from the schema at every call, so the refusal cannot outlive the
    condition it reports, and a schema this tool cannot read is treated as NOT
    declaring it — "I cannot see it" is not "it is there".
    """
    try:
        claims = lib.load_schema(RuntimeError).get("claims", [])
    except Exception:
        return False
    return any(isinstance(c, dict) and c.get("path") == "intake.jsonl"
               for c in claims)


def cmd_intake_render(root: Path, byte_compare: bool,
                      write_board: bool = False,
                      flags: frozenset = frozenset()) -> int:
    """Render `## Intake` from the intake store, or byte-compare the two.

    **From the store on disk when there is one, and from the section when
    there is not** — `source: "board"` in the payload for the second, which is
    the migration gate. The distinction is read off the FILE and never off the
    record count: an empty store is a store, and reading the second as the
    first is the bug `cmd_risks_render` shipped and fixed one register over.
    """
    board, ops = intake_board(root)
    try:
        records, store_path = load_intake_store(root)
    except (OSError, ValueError) as exc:
        print(json.dumps({"identical": False, "store_valid": False,
                          "store_findings": [{"message":
                              f"intake store is not readable JSONL "
                              f"({type(exc).__name__}: {exc})"}]},
                         ensure_ascii=False, indent=2),
              file=sys.stdout if byte_compare else sys.stderr)
        return 2
    source = "store" if store_path.exists() else "board"
    if records:
        records, findings = perry_store.validate_intake_records(records)
        if findings:
            print(json.dumps({"identical": False, "store_valid": False,
                              "store_findings": findings},
                             ensure_ascii=False, indent=2),
                  file=sys.stdout if byte_compare else sys.stderr)
            return 2
    elif source == "board":
        if write_board:
            print(json.dumps({
                "store": str(store_path), "exists": store_path.exists(),
                "note": "no intake store on disk, so there is nothing to "
                        "render `## Intake` FROM — rendering it from records "
                        "derived out of that same section would write the file "
                        "back over itself and report success. "
                        "`perry-tasks intake-diff` is the storeless check.",
            }, ensure_ascii=False, indent=2), file=sys.stderr)
            return 2
        records = perry_store.intake_records(board, ops)
    text, report = perry_store.intake_render(board, records, ops)
    report["source"] = source
    report["store"] = str(store_path)
    if not byte_compare:
        if write_board:
            return write_board_or_refuse(
                root, text, records, flags=flags, section="Intake",
                unit="intake record(s)",
                planner=lambda b, r, m: perry_store.intake_render(b, r, m)[1])
        sys.stdout.write(text)
        return 0
    live = (P.resolve_state_root(root) / "BOARD.md").read_text(encoding="utf-8")
    report["identical"] = text == live
    if not report["identical"]:
        a, b = live.split("\n"), text.split("\n")
        n = next((i for i in range(max(len(a), len(b)))
                  if (a[i:i + 1] or [None]) != (b[i:i + 1] or [None])), 0)
        report["first_difference"] = {
            "line": n + 1,
            "file": (a[n] if n < len(a) else "<past end of file>")[:400],
            "rendered": (b[n] if n < len(b) else "<past end of render>")[:400],
        }
    print(json.dumps(report, ensure_ascii=False, indent=2))
    return 0 if report["identical"] else 1


def _would_discard_intake(on_disk: list[dict], derived: list[dict]) -> list[str]:
    """Stored values the board-derived records do not carry, one line each.

    By field and by POSITION, because position is this store's key. A record
    the board has no row for is reported whole: the import would drop it.
    """
    by_order = {r.get("order"): r for r in derived
                if isinstance(r.get("order"), int)}
    out: list[str] = []
    for rec in on_disk:
        n = rec.get("order")
        if not isinstance(n, int) or isinstance(n, bool):
            continue
        new = by_order.get(n)
        if new is None:
            out.append(f"row {n + 1}: in the store, no row at that position "
                       f"on the board — the whole record would be dropped")
            continue
        for field in sorted(set(rec) | set(new)):
            a, b = rec.get(field), new.get(field)
            if a == b:
                continue
            out.append(f"row {n + 1}.{field}: store={a!r} → board={b!r}")
    return out


#: Why `## Intake` cannot be imported, per shape `intake_section_shape`
#: reports. **Refuse rather than guess**, one answer each.
#:
#: `prose` is the one that would otherwise pass the byte gate and be wrong, for
#: the reason `bullets` is one register over: `intake_records` returns `[]`,
#: rendering `[]` changes no line, so `cmp` is clean — and an empty store would
#: be written over a section holding real requests and reported as a success.
INTAKE_SECTION_UNIMPORTABLE = {
    "absent": (
        "there is no `## Intake` section on this board, so there is no "
        "register to import. `perry-task intake --title \"…\"` creates the "
        "section and its table."),
    "prose": (
        "`## Intake` holds no table — a heading with prose under it, or an "
        "empty section. The records this would write are not a projection of "
        "it, they are `[]`, and writing them would report success over a "
        "section somebody keeps requests in. `perry-task intake --title \"…\"` "
        "writes the table, after which this import has something to read."),
    "foreign": (
        "`## Intake` holds a table this tool must not treat as the register — "
        "either it has no `Request` column or the section holds more than one "
        "table. Which one is the register is a question about somebody's "
        "document, and guessing it writes one table's cells into another "
        "table's store."),
}


def cmd_intake_write(root: Path, argv: list[str],
                     flags: frozenset = frozenset()) -> int:
    """`BOARD.md § Intake` → `perry/intake.jsonl`. The ONE-WAY IMPORT.

    `cmd_risks_write` carries the argument in full and every word of it holds
    here: `--from-board` is the consent and there is no other behaviour; four
    things are checked before a byte is written and each is a refusal that
    writes nothing (ADR-004) — the CLAIM, the SHAPE, the BYTES, and that the
    store is READABLE BACK; and **the import appends no event**, because it
    discharges nothing and routes nothing, and every event it could append
    would carry today's timestamp for a request that arrived weeks ago.

    `discharged` is carried across from the store on disk, and only when it is
    `True` — the asymmetry `intake_record` states. It is the one stored field
    the register has no column for.

    **THE BYTE GATE IS RUN AND IT CANNOT FAIL, AND SAYING SO IS THE POINT.**

    For the risks register the byte comparison catches a real class of error:
    `risk_records` collapses a repeated `RX-001` into ONE record while
    `risk_plan` renders BOTH lines from it, so the second row comes back
    carrying the first row's prose and the bytes say so. Nothing here collapses
    anything — this register has no id to be repeated, nothing is
    de-decorated on the way in, and a line the descriptor cannot rebuild is
    left untouched rather than rewritten. The records are a verbatim
    transcription of the table, so rendering them back is an identity and
    `text != live` is unreachable today. Measured, not assumed: an escaped
    pipe, a ragged row, a row with no trailing pipe, a fourth column and a
    leading-whitespace line all render byte-identical.

    So the gate is kept — it is what `bin/perry-tasks:22` declares, it costs
    one comparison, and it starts biting the day a field of this store stops
    being a cell copied across — but **reading its green as proof that the
    store is right would be reading a tautology as evidence.** What carries
    the proof is the report's counters, `cells_verbatim` above all: a `Notes`
    column that no stored field claims is counted there rather than smuggled
    through as bytes that happen to match.

    **The gate that is NOT a tautology is the one below it: `n`.** The store's
    key is the row's position, and `perry-task resolve-intake <n>` reaches its
    row through `Board.section_rows`, which is a different function in a
    different file. If those two ever count rows differently, every integer a
    consumer holds points at a different request and nothing says so. They are
    compared here, row by row, before the store is written.
    """
    dest = perry_store.intake_store_path(P.resolve_state_root(root))

    if "--from-board" not in argv:
        r = lib.root_flag(root)
        print(f"perry-tasks: refusing section-to-store import without "
              f"`--from-board`. `intake.jsonl` is authoritative once it "
              f"exists; use `perry-tasks intake-render --write{r}` for "
              f"store-to-section recovery, or explicitly run `perry-tasks "
              f"intake-write --from-board{r}` to derive the store from "
              f"`BOARD.md § Intake`.", file=sys.stderr)
        return 1

    if not intake_store_is_declared():
        print(INTAKE_STORE_UNDECLARED, file=sys.stderr)
        return 1

    board, ops = intake_board(root)
    shape, _tables = perry_store.intake_section_shape(board, ops)
    if shape != "table":
        print(f"perry-tasks: refusing to write {dest} — "
              f"{INTAKE_SECTION_UNIMPORTABLE[shape]}\n\n"
              f"  Nothing was written.", file=sys.stderr)
        return 1

    try:
        on_disk, _path = load_intake_store(root)
    except (OSError, ValueError) as exc:
        print(f"perry-tasks: {dest} exists but cannot be read "
              f"({type(exc).__name__}: {exc}). Refusing to overwrite a store "
              f"this tool cannot compare against; move it aside and re-run.",
              file=sys.stderr)
        return 2
    _valid, malformed = perry_store.validate_intake_records(on_disk)
    if malformed:
        print(json.dumps({"refused": f"{dest} is malformed; refusing to "
                          f"overwrite a store that cannot be safely compared",
                          "store_findings": malformed},
                         ensure_ascii=False, indent=2), file=sys.stderr)
        return 2

    records = perry_store.intake_records(board, ops, on_disk)

    # The byte gate, run BEFORE the write rather than reported after it.
    text, report = perry_store.intake_render(board, records, ops)
    live = (P.resolve_state_root(root) / "BOARD.md").read_text(encoding="utf-8")
    if text != live:
        a, b = live.split("\n"), text.split("\n")
        n = next((i for i in range(max(len(a), len(b)))
                  if (a[i:i + 1] or [None]) != (b[i:i + 1] or [None])), 0)
        print(f"perry-tasks: refusing to write {dest}.\n\n"
              f"  The records derived from `## Intake` do not render that "
              f"section back byte for byte, so the store would not be a "
              f"projection of it — it would be a different register wearing "
              f"its name. A migration that cannot reproduce what it replaces "
              f"has not understood it.\n", file=sys.stderr)
        for d in report["cells_the_store_and_board_disagree_on"][:10]:
            print(f"    row {d['n']} · column {d['column']}: "
                  f"board={d['board']!r} → would render {d['store']!r}",
                  file=sys.stderr)
        for r in report["rows_verbatim"][:10]:
            print(f"    row {r.get('n', '?')} {r['cell']!r}: the store holds "
                  f"no record for it"
                  + (f" ({r['why']})" if r.get("why") else ""),
                  file=sys.stderr)
        print(f"\n  First differing line is {n + 1}:\n"
              f"    board:    {(a[n] if n < len(a) else '<past end of file>')[:200]}\n"
              f"    rendered: {(b[n] if n < len(b) else '<past end of render>')[:200]}\n"
              f"\n  Nothing was written.", file=sys.stderr)
        return 1

    _valid, bad = perry_store.validate_intake_records(records)
    if bad:
        print(json.dumps({"refused": "`## Intake` produces a store this tool "
                          "could not read back; nothing was written",
                          "store_findings": bad},
                         ensure_ascii=False, indent=2), file=sys.stderr)
        return 1

    # **THE `n` GATE.** The store is keyed on the row's position and
    # `perry-task resolve-intake <n>` reaches its row through
    # `Board.section_rows` — a different function, in a different file. The
    # two agree today (both walk `perry_store.markdown_tables`), and the day
    # they stop agreeing every integer a consumer holds points at a different
    # request with nothing to say so. Cheap to check, catastrophic to miss.
    keys = header_index(perry_store.intake_table(board, ops)["header"],
                        alias=ops.norm)
    addressable = [dict(zip(keys, cells))
                   for _line, cells in board.section_rows(
                       perry_store.INTAKE_SECTION)]
    mismatch = [n for n in range(max(len(addressable), len(records)))
                if n >= len(records) or n >= len(addressable)
                or records[n]["request"] != (addressable[n].get("request") or "")]
    if mismatch:
        print(f"perry-tasks: refusing to write {dest}.\n\n"
              f"  This store is keyed on the row's POSITION, and `perry-task "
              f"resolve-intake <n>` finds its row a different way — "
              f"`Board.section_rows`. The two disagree about "
              f"`## Intake` on this board: the store derives "
              f"{len(records)} row(s), `section_rows` addresses "
              f"{len(addressable)}, and they first differ at row "
              f"{mismatch[0] + 1}. Writing the store would give one integer "
              f"two meanings, which is the one failure a register with no id "
              f"cannot survive.\n\n"
              f"  Nothing was written.", file=sys.stderr)
        return 1

    losses = _would_discard_intake(on_disk, records)
    if losses:
        print(f"perry-tasks: {len(losses)} stored value(s) replaced by what "
              f"`## Intake` says — `--from-board` is that instruction:",
              file=sys.stderr)
        for line in losses[:10]:
            print(f"    {line}", file=sys.stderr)
        if len(losses) > 10:
            print(f"    … and {len(losses) - 10} more", file=sys.stderr)

    return write_store_or_say_what_would_land(dest, records, flags=flags,
                                              unit="intake record(s)")


# ── the ask register ──────────────────────────────────────────────────────
#
# TASK-197, and the four verbs are the risks four with one word changed —
# literally the risks four, because this register HAS ids and intake's
# positional machinery is the part that does not carry over. `perry-task
# answer USER-016` finds its row by name through `find_section_row`, so there
# is no `n` gate here and no need for one: nothing this store does can make an
# integer mean a different row, because no consumer holds an integer.


def ask_board(root: Path):
    """The board, and `bin/perry-task` as `ops`."""
    mod = _task_module()
    return mod.Board(P.resolve_state_root(root) / "BOARD.md"), mod


def load_ask_store(root: Path) -> tuple[list[dict], Path]:
    """The ask store as it is ON DISK — never the one just derived."""
    path = perry_store.ask_store_path(P.resolve_state_root(root))
    if not path.exists():
        return [], path
    return [json.loads(l) for l in path.read_text(encoding="utf-8")
            .split("\n") if l.strip()], path


#: What `asks-write` refuses when the claim is not there, and why. The same
#: live guard `RISK_STORE_UNDECLARED` and `INTAKE_STORE_UNDECLARED` are, for
#: the same reason: a canonical record file in the user's state root is
#: declared in `schema/state-schema.json § claims` with an owner and an anchor,
#: and that declaration is the user's to give rather than the change's to mint.
ASK_STORE_UNDECLARED = (
    "perry-tasks: refusing to write `asks.jsonl`.\n\n"
    "  The ask register's record shape, its renderer and its drift report are "
    "implemented and tested, and `asks-diff` proves the projection round-trips "
    "byte for byte. What is missing is the DECLARATION: a canonical record "
    "file in the state root is declared in `schema/state-schema.json § claims` "
    "with an owner and an anchor, the way `tasks.jsonl` is, and writing one "
    "that is not declared puts a file Perry does not admit to owning into the "
    "user's project.\n\n"
    "  That declaration is the user's to give. Until it lands, "
    "`perry-tasks asks-build` derives the records and `asks-diff` checks the "
    "projection, both without writing anything.")


def ask_store_is_declared() -> bool:
    """Does `schema/state-schema.json § claims` carry `asks.jsonl`?

    Read from the schema at every call, so the refusal cannot outlive the
    condition it reports, and a schema this tool cannot read is treated as NOT
    declaring it — "I cannot see it" is not "it is there".
    """
    try:
        claims = lib.load_schema(RuntimeError).get("claims", [])
    except Exception:
        return False
    return any(isinstance(c, dict) and c.get("path") == "asks.jsonl"
               for c in claims)


def cmd_ask_render(root: Path, byte_compare: bool,
                   write_board: bool = False,
                   flags: frozenset = frozenset()) -> int:
    """Render `## User Input Queue` from the ask store, or byte-compare the two.

    **From the store on disk when there is one, and from the section when there
    is not** — `source: "board"` in the payload for the second, which is the
    migration gate. Read off the FILE and never off the record count: an empty
    store is a store.
    """
    board, ops = ask_board(root)
    try:
        records, store_path = load_ask_store(root)
    except (OSError, ValueError) as exc:
        print(json.dumps({"identical": False, "store_valid": False,
                          "store_findings": [{"message":
                              f"ask store is not readable JSONL "
                              f"({type(exc).__name__}: {exc})"}]},
                         ensure_ascii=False, indent=2),
              file=sys.stdout if byte_compare else sys.stderr)
        return 2
    source = "store" if store_path.exists() else "board"
    if records:
        records, findings = perry_store.validate_ask_records(records)
        if findings:
            print(json.dumps({"identical": False, "store_valid": False,
                              "store_findings": findings},
                             ensure_ascii=False, indent=2),
                  file=sys.stdout if byte_compare else sys.stderr)
            return 2
    elif source == "board":
        if write_board:
            print(json.dumps({
                "store": str(store_path), "exists": store_path.exists(),
                "note": "no ask store on disk, so there is nothing to render "
                        "`## User Input Queue` FROM — rendering it from "
                        "records derived out of that same section would write "
                        "the file back over itself and report success. "
                        "`perry-tasks asks-diff` is the storeless check.",
            }, ensure_ascii=False, indent=2), file=sys.stderr)
            return 2
        records = perry_store.ask_records(board, ops)
    text, report = perry_store.ask_render(board, records, ops)
    report["source"] = source
    report["store"] = str(store_path)
    if not byte_compare:
        if write_board:
            return write_board_or_refuse(
                root, text, records, flags=flags, section="User Input Queue",
                unit="ask record(s)",
                planner=lambda b, r, m: perry_store.ask_render(b, r, m)[1])
        sys.stdout.write(text)
        return 0
    live = (P.resolve_state_root(root) / "BOARD.md").read_text(encoding="utf-8")
    report["identical"] = text == live
    if not report["identical"]:
        a, b = live.split("\n"), text.split("\n")
        n = next((i for i in range(max(len(a), len(b)))
                  if (a[i:i + 1] or [None]) != (b[i:i + 1] or [None])), 0)
        report["first_difference"] = {
            "line": n + 1,
            "file": (a[n] if n < len(a) else "<past end of file>")[:400],
            "rendered": (b[n] if n < len(b) else "<past end of render>")[:400],
        }
    print(json.dumps(report, ensure_ascii=False, indent=2))
    return 0 if report["identical"] else 1


#: Why `## User Input Queue` cannot be imported, per shape `ask_section_shape`
#: reports. **Refuse rather than guess**, one answer each.
#:
#: `prose` is the one that would otherwise pass the byte gate and be wrong, for
#: the reason `bullets` is two registers over: `ask_records` returns `[]`,
#: rendering `[]` changes no line, so `cmp` is clean — and an empty store would
#: be written over a section holding real questions and reported as a success.
ASK_SECTION_UNIMPORTABLE = {
    "absent": (
        "there is no `## User Input Queue` section on this board, so there is "
        "no register to import. `perry-task ask --needed \"…\"` creates the "
        "section and its table."),
    "prose": (
        "`## User Input Queue` holds no table — a heading with prose under it, "
        "or an empty section. The records this would write are not a "
        "projection of it, they are `[]`, and writing them would report "
        "success over a section somebody keeps open questions in. "
        "`perry-task ask --needed \"…\"` writes the table, after which this "
        "import has something to read."),
    "foreign": (
        "`## User Input Queue` holds a table this tool must not treat as the "
        "register — either it has no `Needed from user` column or the section "
        "holds more than one table. Which one is the register is a question "
        "about somebody's document, and guessing it writes one table's cells "
        "into another table's store."),
}


def cmd_asks_write(root: Path, argv: list[str],
                   flags: frozenset = frozenset()) -> int:
    """`BOARD.md § User Input Queue` → `perry/asks.jsonl`. The ONE-WAY IMPORT.

    `cmd_risks_write` carries the argument in full and every word of it holds
    here: `--from-board` is the consent and there is no other behaviour; four
    things are checked before a byte is written and each is a refusal that
    writes nothing (ADR-004) — the CLAIM, the SHAPE, the BYTES, and that the
    store is READABLE BACK; and **the import appends no event**, because it
    asks nobody anything and answers nothing, and every event it could append
    would carry today's timestamp for a question put weeks ago.

    `answered` is carried across from the store on disk, and only when it is
    `True` — the asymmetry `ask_record` states. It is the one stored field the
    register has no column for.

    **THE BYTE GATE IS LOAD-BEARING HERE, AND THAT WAS MEASURED RATHER THAN
    INHERITED.** TASK-196 found the same gate was a tautology for intake and
    said so; the argument it turned on is that intake rows have no id, so
    nothing collapses. **A `USER-` row has an id**, so the risks class is back:
    `ask_records` collapses a repeated `USER-001` into ONE record while
    `ask_plan` renders BOTH lines from it, and the second line comes back
    carrying the first row's question, blocker, date and status. Measured on
    eleven inputs — a duplicate id, an escaped pipe, a ragged short row, a
    ragged long row, a missing trailing pipe, a blank first cell, an indented
    line, a struck-out id, the five-column shape, an `Idle` cell with a real
    number in it, and a `Notes` column no stored field claims — **ten render
    byte-identical either way and the duplicate id does not.** So the gate
    catches exactly one class here, that class is real, and it is the class a
    register whose key is its id dies of.

    **The gate intake needed is the one this register does not.** Intake built
    a row-count check against `Board.section_rows` because its key is the row's
    POSITION and `resolve-intake <n>` addresses rows by integer. Nothing
    addresses an ask by position: `perry-task answer USER-016` goes through
    `find_section_row`, a name lookup, and `perry-explain` resolves `USER-`
    handles out of prose. `order` here records where a row sits and never
    decides which row it is, so a renumbering cannot change what any consumer's
    handle points at. A count gate would be the tautology in this register.
    """
    dest = perry_store.ask_store_path(P.resolve_state_root(root))

    if "--from-board" not in argv:
        r = lib.root_flag(root)
        print(f"perry-tasks: refusing section-to-store import without "
              f"`--from-board`. `asks.jsonl` is authoritative once it exists; "
              f"use `perry-tasks asks-render --write{r}` for store-to-section "
              f"recovery, or explicitly run `perry-tasks asks-write "
              f"--from-board{r}` to derive the store from "
              f"`BOARD.md § User Input Queue`.", file=sys.stderr)
        return 1

    if not ask_store_is_declared():
        print(ASK_STORE_UNDECLARED, file=sys.stderr)
        return 1

    board, ops = ask_board(root)
    shape, _tables = perry_store.ask_section_shape(board, ops)
    if shape != "table":
        print(f"perry-tasks: refusing to write {dest} — "
              f"{ASK_SECTION_UNIMPORTABLE[shape]}\n\n"
              f"  Nothing was written.", file=sys.stderr)
        return 1

    try:
        on_disk, _path = load_ask_store(root)
    except (OSError, ValueError) as exc:
        print(f"perry-tasks: {dest} exists but cannot be read "
              f"({type(exc).__name__}: {exc}). Refusing to overwrite a store "
              f"this tool cannot compare against; move it aside and re-run.",
              file=sys.stderr)
        return 2
    _valid, malformed = perry_store.validate_ask_records(on_disk)
    if malformed:
        print(json.dumps({"refused": f"{dest} is malformed; refusing to "
                          f"overwrite a store that cannot be safely compared",
                          "store_findings": malformed},
                         ensure_ascii=False, indent=2), file=sys.stderr)
        return 2

    # `cmd_risks_write`'s TASK-273 paragraph, and it bites HARDER here. The
    # docstring above measured eleven inputs and concluded the byte gate
    # catches the duplicate-id class; it catches the duplicates whose prose
    # DIFFERS, which is ten of those eleven. Two `USER-` rows carrying the same
    # id AND the same cells render identically and were written at exit code 0.
    dupes = perry_store.duplicate_row_ids(
        perry_store.ask_table(board, ops), ops, "user-id")
    if dupes:
        print(refuse_duplicate_ids("User Input Queue", dest, dupes),
              file=sys.stderr)
        return 1

    records = perry_store.ask_records(board, ops, on_disk)

    # The byte gate, run BEFORE the write rather than reported after it.
    text, report = perry_store.ask_render(board, records, ops)
    live = (P.resolve_state_root(root) / "BOARD.md").read_text(encoding="utf-8")
    if text != live:
        a, b = live.split("\n"), text.split("\n")
        n = next((i for i in range(max(len(a), len(b)))
                  if (a[i:i + 1] or [None]) != (b[i:i + 1] or [None])), 0)
        print(f"perry-tasks: refusing to write {dest}.\n\n"
              f"  The records derived from `## User Input Queue` do not render "
              f"that section back byte for byte, so the store would not be a "
              f"projection of it — it would be a different register wearing "
              f"its name. A migration that cannot reproduce what it replaces "
              f"has not understood it.\n\n"
              f"  The usual cause is a REPEATED `USER-` id: two lines, one "
              f"record, and the second line rendered from the first row's "
              f"cells. Give the duplicate its own id and re-run.\n",
              file=sys.stderr)
        for d in report["cells_the_store_and_board_disagree_on"][:10]:
            print(f"    {d['id']} · column {d['column']}: "
                  f"board={d['board']!r} → would render {d['store']!r}",
                  file=sys.stderr)
        for r in report["rows_verbatim"][:10]:
            print(f"    row {r['cell']!r}: the store holds no record for it"
                  + (f" ({r['why']})" if r.get("why") else ""),
                  file=sys.stderr)
        print(f"\n  First differing line is {n + 1}:\n"
              f"    board:    {(a[n] if n < len(a) else '<past end of file>')[:200]}\n"
              f"    rendered: {(b[n] if n < len(b) else '<past end of render>')[:200]}\n"
              f"\n  Nothing was written.", file=sys.stderr)
        return 1

    _valid, bad = perry_store.validate_ask_records(records)
    if bad:
        print(json.dumps({"refused": "`## User Input Queue` produces a store "
                          "this tool could not read back; nothing was written",
                          "store_findings": bad},
                         ensure_ascii=False, indent=2), file=sys.stderr)
        return 1

    losses = _would_discard(on_disk, records)
    if losses:
        print(f"perry-tasks: {len(losses)} stored value(s) replaced by what "
              f"`## User Input Queue` says — `--from-board` is that "
              f"instruction:", file=sys.stderr)
        for line in losses[:10]:
            print(f"    {line}", file=sys.stderr)
        if len(losses) > 10:
            print(f"    … and {len(losses) - 10} more", file=sys.stderr)

    return write_store_or_say_what_would_land(dest, records, flags=flags,
                                              unit="ask record(s)")


# ── the cadence register (TASK-237 deliverable 3b) ────────────────────────
#
# The ask register's four verbs, one register over, because the key is the
# same kind (the row's `ID`). Two refusals are added to the import, and both
# exist because this store's promise is stronger: EVERY cell is stored as
# written. The ask import lets a row with no `USER-` handle and the `Idle`
# column pass verbatim, and the byte gate cannot see either — rendering a row
# the store never took reproduces the row. Here a row with no id, or a column
# no stored field holds, would be a cell the file carries and the store drops,
# so the import names it and writes nothing.


def cadence_board(root: Path):
    """The board, and `bin/perry-task` as `ops`."""
    mod = _task_module()
    return mod.Board(P.resolve_state_root(root) / "BOARD.md"), mod


def load_cadence_store(root: Path) -> tuple[list[dict], Path]:
    """The cadence store as it is ON DISK — never the one just derived."""
    path = perry_store.cadence_store_path(P.resolve_state_root(root))
    if not path.exists():
        return [], path
    return [json.loads(l) for l in path.read_text(encoding="utf-8")
            .split("\n") if l.strip()], path


#: What `cadence-write` refuses when the claim is not there, and why — the
#: live guard `ASK_STORE_UNDECLARED` is, one register over.
CADENCE_STORE_UNDECLARED = (
    "perry-tasks: refusing to write `cadence.jsonl`.\n\n"
    "  A canonical record file in the state root is declared in "
    "`schema/state-schema.json § claims` with an owner and an anchor, the way "
    "`tasks.jsonl` is, and this schema carries no `cadence.jsonl` claim. "
    "Writing one would put a file Perry does not admit to owning into the "
    "user's project.\n\n"
    "  That declaration is the user's to give. Until it lands, "
    "`perry-tasks cadence-build` derives the records and `cadence-diff` checks "
    "the projection, both without writing anything.")


def cadence_store_is_declared() -> bool:
    """Does `schema/state-schema.json § claims` carry `cadence.jsonl`?

    Read at every call, and a schema this tool cannot read is NOT declaring
    it — `ask_store_is_declared`'s rule.
    """
    try:
        claims = lib.load_schema(RuntimeError).get("claims", [])
    except Exception:
        return False
    return any(isinstance(c, dict) and c.get("path") == "cadence.jsonl"
               for c in claims)


def cmd_cadence_render(root: Path, byte_compare: bool,
                       write_board: bool = False,
                       flags: frozenset = frozenset()) -> int:
    """Render `## Cadence` from the cadence store, or byte-compare the two.

    `cmd_ask_render` one register over: from the store on disk when there is
    one, from the section when there is not (`source: "board"`), and `--write`
    refuses without a store rather than write the section back over itself.
    """
    board, ops = cadence_board(root)
    try:
        records, store_path = load_cadence_store(root)
    except (OSError, ValueError) as exc:
        print(json.dumps({"identical": False, "store_valid": False,
                          "store_findings": [{"message":
                              f"cadence store is not readable JSONL "
                              f"({type(exc).__name__}: {exc})"}]},
                         ensure_ascii=False, indent=2),
              file=sys.stdout if byte_compare else sys.stderr)
        return 2
    source = "store" if store_path.exists() else "board"
    if records:
        records, findings = perry_store.validate_cadence_records(records)
        if findings:
            print(json.dumps({"identical": False, "store_valid": False,
                              "store_findings": findings},
                             ensure_ascii=False, indent=2),
                  file=sys.stdout if byte_compare else sys.stderr)
            return 2
    elif source == "board":
        if write_board:
            print(json.dumps({
                "store": str(store_path), "exists": store_path.exists(),
                "note": "no cadence store on disk, so there is nothing to "
                        "render `## Cadence` FROM — rendering it from records "
                        "derived out of that same section would write the "
                        "file back over itself and report success. "
                        "`perry-tasks cadence-diff` is the storeless check.",
            }, ensure_ascii=False, indent=2), file=sys.stderr)
            return 2
        records = perry_store.cadence_records(board, ops)
    text, report = perry_store.cadence_render(board, records, ops)
    report["source"] = source
    report["store"] = str(store_path)
    if not byte_compare:
        if write_board:
            return write_board_or_refuse(
                root, text, records, flags=flags, section="Cadence",
                unit="cadence record(s)",
                planner=lambda b, r, m: perry_store.cadence_render(b, r, m)[1])
        sys.stdout.write(text)
        return 0
    live = (P.resolve_state_root(root) / "BOARD.md").read_text(encoding="utf-8")
    report["identical"] = text == live
    if not report["identical"]:
        a, b = live.split("\n"), text.split("\n")
        n = next((i for i in range(max(len(a), len(b)))
                  if (a[i:i + 1] or [None]) != (b[i:i + 1] or [None])), 0)
        report["first_difference"] = {
            "line": n + 1,
            "file": (a[n] if n < len(a) else "<past end of file>")[:400],
            "rendered": (b[n] if n < len(b) else "<past end of render>")[:400],
        }
    print(json.dumps(report, ensure_ascii=False, indent=2))
    return 0 if report["identical"] else 1


#: Why `## Cadence` cannot be imported, per shape `cadence_section_shape`
#: reports. `prose` is the one that would pass the byte gate and be wrong:
#: `cadence_records` returns `[]` and rendering `[]` changes no line.
CADENCE_SECTION_UNIMPORTABLE = {
    "absent": (
        "there is no `## Cadence` section on this board, so there is no "
        "register to import. `perry-task cadence-add --title … --frequency …` "
        "creates the section and its store."),
    "prose": (
        "`## Cadence` holds no table — a heading with prose under it, or an "
        "empty section. The records this would write are `[]`, and writing "
        "them would report success over a section somebody keeps rituals in."),
    "foreign": (
        "`## Cadence` holds a table this tool must not treat as the register — "
        "either it has no `Frequency` column or the section holds more than "
        "one table. Which one is the register is a question about somebody's "
        "document."),
}


def cmd_cadence_write(root: Path, argv: list[str],
                      flags: frozenset = frozenset()) -> int:
    """`BOARD.md § Cadence` → `cadence.jsonl`. The ONE-WAY IMPORT.

    `cmd_asks_write`'s gates, in its order — `--from-board` is the consent; the
    CLAIM, the SHAPE, the store on disk READABLE, no REPEATED id, the BYTES,
    and the records READABLE BACK — and, like it, **no event is appended**: the
    import runs nothing and records no occurrence, and an event would date
    every ritual to the day of the migration.

    **Two gates the ask import does not have, both about cells the byte gate
    cannot see.** A row whose `ID` holds no handle is not a record, so the
    renderer leaves its line alone and `cmp` stays clean with the row absent
    from the store. A column no stored field holds (`Notes`) renders verbatim
    for the same reason. Each is a cell the section carries and the store
    would drop, so each refuses and names what it would drop.
    """
    dest = perry_store.cadence_store_path(P.resolve_state_root(root))

    if "--from-board" not in argv:
        r = lib.root_flag(root)
        print(f"perry-tasks: refusing section-to-store import without "
              f"`--from-board`. `cadence.jsonl` is authoritative once it "
              f"exists; use `perry-tasks cadence-render --write{r}` for "
              f"store-to-section recovery, or explicitly run `perry-tasks "
              f"cadence-write --from-board{r}` to derive the store from "
              f"`BOARD.md § Cadence`.", file=sys.stderr)
        return 1

    if not cadence_store_is_declared():
        print(CADENCE_STORE_UNDECLARED, file=sys.stderr)
        return 1

    board, ops = cadence_board(root)
    shape, _tables = perry_store.cadence_section_shape(board, ops)
    if shape != "table":
        print(f"perry-tasks: refusing to write {dest} — "
              f"{CADENCE_SECTION_UNIMPORTABLE[shape]}\n\n"
              f"  Nothing was written.", file=sys.stderr)
        return 1

    try:
        on_disk, _path = load_cadence_store(root)
    except (OSError, ValueError) as exc:
        print(f"perry-tasks: {dest} exists but cannot be read "
              f"({type(exc).__name__}: {exc}). Refusing to overwrite a store "
              f"this tool cannot compare against; move it aside and re-run.",
              file=sys.stderr)
        return 2
    _valid, malformed = perry_store.validate_cadence_records(on_disk)
    if malformed:
        print(json.dumps({"refused": f"{dest} is malformed; refusing to "
                          f"overwrite a store that cannot be safely compared",
                          "store_findings": malformed},
                         ensure_ascii=False, indent=2), file=sys.stderr)
        return 2

    dupes = perry_store.duplicate_row_ids(
        perry_store.cadence_table(board, ops), ops, "id")
    if dupes:
        print(refuse_duplicate_ids("Cadence", dest, dupes), file=sys.stderr)
        return 1

    records = perry_store.cadence_records(board, ops, on_disk)
    text, report = perry_store.cadence_render(board, records, ops)
    live = (P.resolve_state_root(root) / "BOARD.md").read_text(encoding="utf-8")
    if text != live:
        a, b = live.split("\n"), text.split("\n")
        n = next((i for i in range(max(len(a), len(b)))
                  if (a[i:i + 1] or [None]) != (b[i:i + 1] or [None])), 0)
        print(f"perry-tasks: refusing to write {dest}.\n\n"
              f"  The records derived from `## Cadence` do not render that "
              f"section back byte for byte, so the store would not be a "
              f"projection of it.\n", file=sys.stderr)
        for d in report["cells_the_store_and_board_disagree_on"][:10]:
            print(f"    {d['id']} · column {d['column']}: "
                  f"board={d['board']!r} → would render {d['store']!r}",
                  file=sys.stderr)
        print(f"\n  First differing line is {n + 1}:\n"
              f"    board:    {(a[n] if n < len(a) else '<past end of file>')[:200]}\n"
              f"    rendered: {(b[n] if n < len(b) else '<past end of render>')[:200]}\n"
              f"\n  Nothing was written.", file=sys.stderr)
        return 1

    dropped = ([f"row {r['cell']!r}: its `ID` cell holds no handle, so the "
                f"store would hold no record of it"
                + (f" ({r['why']})" if r.get("why") else "")
                for r in report["rows_verbatim"]]
               + [f"column {col!r}: no stored field holds it, so {n} cell(s) "
                  f"would be dropped" for col, n in
                  sorted(report["cells_verbatim"].items())])
    if dropped:
        print(f"perry-tasks: refusing to write {dest}.\n\n"
              f"  `cadence.jsonl` stores every cell of `## Cadence` as "
              f"written, and this section carries cells it would not "
              f"hold:\n", file=sys.stderr)
        for line in dropped[:10]:
            print(f"    {line}", file=sys.stderr)
        print("\n  Give the row an id, or move the column's text into a "
              "column the register declares, and re-run. Nothing was "
              "written.", file=sys.stderr)
        return 1

    _valid, bad = perry_store.validate_cadence_records(records)
    if bad:
        print(json.dumps({"refused": "`## Cadence` produces a store this tool "
                          "could not read back; nothing was written",
                          "store_findings": bad},
                         ensure_ascii=False, indent=2), file=sys.stderr)
        return 1

    losses = _would_discard(on_disk, records)
    if losses:
        print(f"perry-tasks: {len(losses)} stored value(s) replaced by what "
              f"`## Cadence` says — `--from-board` is that instruction:",
              file=sys.stderr)
        for line in losses[:10]:
            print(f"    {line}", file=sys.stderr)
        if len(losses) > 10:
            print(f"    … and {len(losses) - 10} more", file=sys.stderr)

    return write_store_or_say_what_would_land(dest, records, flags=flags,
                                              unit="cadence record(s)")


# ---------------------------------------------------------------------------
# The linkage import is GONE — ADR-019.
#
# DESIGN-015 row B (TASK-277) put three verbs here — `linkage-build`,
# `linkage-write --from-register` and `linkage-diff` — whose whole job was to
# derive `perry/linkage.jsonl` from `phase/<NNN>-linkage.md` and then prove
# the two agreed in both directions. ADR-019 deleted the document, so the
# import has no source and the diff has no second side. There is one copy of
# this graph and `perry-goals link` / `perry-task add --kr` write it in place.
#
# **The one line worth carrying forward** is what row B had to invent and
# where it got it, because the same question is answered differently now.
# `declared_at` was `required` on every `edge` and `unlinked` record and the
# document carried no per-record date, so the import used the register's ONE
# `updated:` stamp for all 115 of them. Today's clock was rejected at the
# time — it would have dated declarations made weeks ago to the moment of the
# migration — and the file-level stamp was the least-wrong value available.
# It was still wrong in the other direction: the SAME field was read as every
# KR's assertion date (`bin/lib § kr_progress_provenance`), so one write moved
# 115 declarations and 4 asserted numbers at once. That is TASK-155, and it
# is gone with the field: a declaration is now dated when it is declared, by
# the write that declares it, and a `current` carries its own `asserted_at`.
# ---------------------------------------------------------------------------


_LINT_MODULE = None


def _sibling_module(name: str, script: str, cache: str):
    """A sibling `bin/` script as a module, loaded once per process.

    `_task_module` above is the original; this is the same six lines it runs,
    named once rather than a third and fourth time. The scripts have no `.py`
    extension, so `SourceFileLoader` is what reaches them.
    """
    cached = globals().get(cache)
    if cached is not None:
        return cached
    import importlib.machinery
    import importlib.util
    path = Path(__file__).resolve().parent / script
    spec = importlib.util.spec_from_loader(
        name, importlib.machinery.SourceFileLoader(name, str(path)))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    globals()[cache] = mod
    return mod


def _perry_lint_module():
    """`bin/perry-lint` as a module, loaded ONCE per process.

    Same mechanism and same reason as `_task_module` above: the file has no
    `.py` extension, and it is 5,000 lines that would otherwise be
    re-executed on every call.
    """
    return _sibling_module("perry_lint_mod", "perry-lint", "_LINT_MODULE")


def registers() -> dict[str, str]:
    """`{register name: subcommand prefix}` — DERIVED, not typed.

    A register is a `work`-owned JSONL store anchored at the state root, which
    is what `schema/state-schema.json § claims` already declares each of them
    as. `tasks` takes the empty prefix because its verbs are the bare ones.

    **Why this is derived** (DESIGN-016 § 1.7). A project can declare a track
    by writing a row in `.perry/config.jsonl`; a register needed four new
    subcommand names in this file. They are the same kind of axis with two
    encodings, and only one of them could be extended. Reading the list from
    the schema puts them on one mechanism: a fifth `work` store declared there
    gets `build / render / write / diff` here without an edit.
    """
    out: dict[str, str] = {}
    for claim in lib.load_schema().get("claims", []):
        path = str(claim.get("path", ""))
        if (claim.get("owner") == "work" and claim.get("anchor") == "state"
                and path.endswith(".jsonl")):
            name = path[:-len(".jsonl")]
            out[name] = "" if name == "tasks" else f"{name}-"
    return out or {"tasks": ""}


#: **What this tool accepts, declared once** (DESIGN-016 C1, Decision 5).
#: `lib.parse_surface` reads the vector against it, `--describe --json` prints
#: it, and `bin/perry` and the generated usage block are the same table read
#: from somewhere else. A flag reaching a subcommand that does not list it is
#: REFUSED here rather than dropped there.
SURFACE = {
    "name": "perry-tasks",
    "kind": "write",
    "summary": "the task store and the four registers beside it: the whole "
               "board printed from them, and the import from and render onto "
               "a BOARD.md a project still holds",
    "root_resolution": "standard",
    "exit_codes": {"0": "read, or written", "1": "refused, or drifted",
                   "2": "bad invocation, or nothing usable to compare"},
    "flags": [
        {"name": "--write", "summary":
         "put the render on disk instead of on stdout"},
        {"name": "--from-board", "summary":
         "confirm the backwards direction: the file replaces the store"},
        {"name": "--dry-run", "summary":
         "print what would land and touch nothing"},
        {"name": "--json", "summary": "a machine-readable payload"},
        {"name": "--register", "arg": "name", "summary":
         "which register the verb acts on — the names come from the schema's "
         "`work`-owned stores; default `tasks`"},
    ],
    "subcommands": [
        {"name": "build", "summary":
         "derive the task store from BOARD.md and print it; write nothing",
         "flags": ["--register"]},
        {"name": "verify", "summary":
         "field-compare the store on disk with the board",
         "flags": ["--register"]},
        {"name": "write", "summary":
         "the one-way import: BOARD.md -> tasks.jsonl, for a project with no "
         "store yet",
         "flags": ["--from-board", "--dry-run", "--json", "--register"],
         "writes": ["tasks.jsonl"]},
        {"name": "render", "summary":
         "tasks.jsonl -> BOARD.md; refuses when a record has no line to land in",
         "flags": ["--write", "--dry-run", "--json", "--register"],
         "writes": ["BOARD.md"]},
        {"name": "diff", "summary":
         "render and byte-compare with the board on disk",
         "flags": ["--register"]},
        {"name": "risks-build", "summary":
         "derive the risks store from `## Top risks` and print it",
         "flags": []},
        {"name": "risks-render", "summary":
         "the risks store -> `## Top risks`",
         "flags": ["--write", "--dry-run", "--json"],
         "writes": ["BOARD.md"]},
        {"name": "risks-write", "summary":
         "the one-way import: `## Top risks` -> risks.jsonl",
         "flags": ["--from-board", "--dry-run", "--json"],
         "writes": ["risks.jsonl"]},
        {"name": "risks-diff", "summary":
         "render `## Top risks` and byte-compare with the board",
         "flags": []},
        {"name": "intake-build", "summary":
         "derive the intake store from `## Intake` and print it",
         "flags": []},
        {"name": "intake-render", "summary":
         "the intake store -> `## Intake`",
         "flags": ["--write", "--dry-run", "--json"],
         "writes": ["BOARD.md"]},
        {"name": "intake-write", "summary":
         "the one-way import: `## Intake` -> intake.jsonl",
         "flags": ["--from-board", "--dry-run", "--json"],
         "writes": ["intake.jsonl"]},
        {"name": "intake-diff", "summary":
         "render `## Intake` and byte-compare with the board",
         "flags": []},
        {"name": "asks-build", "summary":
         "derive the asks store from `## User Input Queue` and print it",
         "flags": []},
        {"name": "asks-render", "summary":
         "the asks store -> `## User Input Queue`",
         "flags": ["--write", "--dry-run", "--json"],
         "writes": ["BOARD.md"]},
        {"name": "asks-write", "summary":
         "the one-way import: `## User Input Queue` -> asks.jsonl",
         "flags": ["--from-board", "--dry-run", "--json"],
         "writes": ["asks.jsonl"]},
        {"name": "asks-diff", "summary":
         "render `## User Input Queue` and byte-compare with the board",
         "flags": []},
        {"name": "cadence-build", "summary":
         "derive the cadence store from `## Cadence` and print it",
         "flags": []},
        {"name": "cadence-render", "summary":
         "the cadence store -> `## Cadence`",
         "flags": ["--write", "--dry-run", "--json"],
         "writes": ["BOARD.md"]},
        {"name": "cadence-write", "summary":
         "the one-way import: `## Cadence` -> cadence.jsonl",
         "flags": ["--from-board", "--dry-run", "--json"],
         "writes": ["cadence.jsonl"]},
        {"name": "cadence-diff", "summary":
         "render `## Cadence` and byte-compare with the board",
         "flags": []},
        {"name": "board", "summary":
         "the whole board to stdout from the five stores and the declared "
         "skeleton; never reads BOARD.md",
         "flags": []},
    ],
}


def main(argv: list[str], _locked: bool = False) -> int:
    # **The whole vector is read against SURFACE before anything dispatches**
    # (DESIGN-016 A2 and C1). `-h` in any position prints and exits, so
    # `render --write --help` prints help instead of running the render; an
    # undeclared token is refused with exit 2 rather than ignored, so `--wrte`
    # is a typo again and not a silent no-op that reports success; and a
    # DECLARED flag on a subcommand that does not list it is refused too,
    # which is the `--dry-run`-accepted-and-ignored shape TASK-253 filed.
    read = lib.parse_surface(SURFACE, argv)
    if read["help"]:
        # **Usage first** (DESIGN-016 C2, goal 8). Generated from `SURFACE`, so
        # it cannot describe a flag the parser does not take.
        print(lib.usage_lines(SURFACE, read["sub"]))
        if not read["sub"]:
            print()
            print(__doc__.strip())
        return 0
    if not argv:
        # **One no-argument behaviour, and the declaration decides which**
        # (DESIGN-016 C3, goal 3). A tool that takes subcommands cannot act
        # without one, so a bare call is a bad invocation: the usage on stderr
        # and exit 2. A flag-only tool — `perry-state`, `perry-diagnose` — does
        # its documented default and exits 0. Bare calls used to answer four
        # ways: usage and exit 2, the whole help and exit 0, 187KB of JSON, and
        # a 3.7-second lint (§ 1.3).
        print(lib.usage_lines(SURFACE), file=sys.stderr)
        return 2
    if read["describe"]:
        print(json.dumps(lib.describe_surface(SURFACE, read["sub"]),
                         ensure_ascii=False, indent=2))
        return 0
    if read["error"]:
        print(f"perry-tasks: {read['error']}", file=sys.stderr)
        return 2
    cmd = read["sub"]
    seen, given = read["seen"], read["values"]
    flags = frozenset(seen)

    if cmd == "board":
        # **Ahead of the `--register` rewrite and the lock, on purpose.** It is
        # a read of seven declared files, so it neither takes a register nor
        # serialises behind a writer, and nothing below this point runs for it.
        if read["extra"]:
            print(f"perry-tasks: {read['extra'][0]!r} is not a flag, and "
                  f"'board' takes no second argument (try --help)",
                  file=sys.stderr)
            return 2
        return cmd_board(lib.resolve_project_root(given.get("--root")))

    # **`--register` is the verb's argument, and the twelve prefixed names are
    # aliases for it** (DESIGN-016 C5). `risks-build` and `build --register
    # risks` are the same call; the prefixes stay for one release so nothing
    # that already types them breaks. The rewrite happens here, before
    # dispatch, so every branch below still sees the name it was written for.
    if "--register" in given:
        table = registers()
        name = given["--register"]
        if name not in table:
            print(f"perry-tasks: no register {name!r}. Declared: "
                  f"{', '.join(sorted(table))}. A register is a `work`-owned "
                  f"store in `schema/state-schema.json § claims`.",
                  file=sys.stderr)
            return 2
        wanted = f"{table[name]}{cmd}"
        if wanted != cmd:
            legal = {s["name"] for s in SURFACE["subcommands"]}
            if wanted not in legal:
                verbs = sorted(v.removeprefix(table[name]) for v in legal
                               if table[name] and v.startswith(table[name]))
                print(f"perry-tasks: the {name!r} register has no {cmd!r} — "
                      f"it takes {', '.join(verbs)}.", file=sys.stderr)
                return 2
            cmd = wanted
    # `--root` first, `$PERRY_PROJECT` second — `bin/README.md § Which
    # project?`'s order, which this line had inverted while two of the commands
    # below write (DESIGN-016 § 1.1, A1).
    root = lib.resolve_project_root(given.get("--root"))

    if read["extra"]:
        print(f"perry-tasks: {read['extra'][0]!r} is not a flag, and {cmd!r} "
              f"takes no second argument (try --help)", file=sys.stderr)
        return 2

    # One lock spans source reads, derivation, comparison, and replacement.
    # Taking it only around `os.replace` still lets a concurrent writer make
    # every decision above that point against stale bytes.
    if not _locked:
        # **The `except` covers the whole locked run, not just the lock**
        # (DESIGN-016 A6, goal 10). It used to cover only `project_lock`
        # itself, so a `Refused` raised deeper — `mod.Board` on a root with no
        # `BOARD.md`, the commonest one — reached the caller as a full Python
        # traceback and exit 1, while the same condition through `perry-task`
        # printed one line. `bin/README.md` says exit 1 is "refused, and the
        # reason is printed"; a traceback is not that.
        state_root = P.resolve_state_root(root)
        try:
            with lib.project_lock(state_root, refused=Refused):
                return main(argv, _locked=True)
        except Refused as exc:
            print(f"perry-tasks: refused — {exc}", file=sys.stderr)
            return 1
        except _task_module().Refused as exc:
            # `perry-task`'s own class, raised by the board reader this tool
            # loads. The `Refused` above is this file's; a command that reaches
            # `mod.Board` directly — `render` on a root with no `BOARD.md` —
            # raises `perry-task`'s, and that is the one that used to escape.
            print(f"perry-tasks: refused — {exc}", file=sys.stderr)
            return 1

    if cmd in ("risks-render", "risks-diff"):
        return cmd_risks_render(root, byte_compare=cmd == "risks-diff",
                                write_board="--write" in flags, flags=flags)

    if cmd == "risks-build":
        board, ops = risk_board(root)
        records = perry_store.risk_records(board, ops)
        shape, _tables = perry_store.risk_section_shape(board, ops)
        print(json.dumps({"records": len(records),
                          "stored_fields": len(perry_store.RISK_STORED),
                          "register": shape,
                          "sample": records[0] if records else None},
                         ensure_ascii=False, indent=2))
        return 0

    if cmd == "risks-write":
        return cmd_risks_write(root, argv, flags)

    if cmd in ("intake-render", "intake-diff"):
        return cmd_intake_render(root, byte_compare=cmd == "intake-diff",
                                 write_board="--write" in flags, flags=flags)

    if cmd == "intake-build":
        board, ops = intake_board(root)
        records = perry_store.intake_records(board, ops)
        shape, _tables = perry_store.intake_section_shape(board, ops)
        print(json.dumps({"records": len(records),
                          "stored_fields": len(perry_store.INTAKE_STORED),
                          "register": shape,
                          "undischarged": sum(1 for r in records
                                              if not r["discharged"]),
                          "sample": records[0] if records else None},
                         ensure_ascii=False, indent=2))
        return 0

    if cmd == "intake-write":
        return cmd_intake_write(root, argv, flags)

    if cmd in ("asks-render", "asks-diff"):
        return cmd_ask_render(root, byte_compare=cmd == "asks-diff",
                              write_board="--write" in flags, flags=flags)

    if cmd == "asks-build":
        board, ops = ask_board(root)
        records = perry_store.ask_records(board, ops)
        shape, _tables = perry_store.ask_section_shape(board, ops)
        print(json.dumps({"records": len(records),
                          "stored_fields": len(perry_store.ASK_STORED),
                          "register": shape,
                          # The needs-you count, which is the number this
                          # register exists to produce. `asks.open` in
                          # `perry-task/list` is the same figure by the same
                          # predicate.
                          "unanswered": sum(1 for r in records
                                            if not r["answered"]),
                          "sample": records[0] if records else None},
                         ensure_ascii=False, indent=2))
        return 0

    if cmd == "asks-write":
        return cmd_asks_write(root, argv, flags)

    if cmd in ("cadence-render", "cadence-diff"):
        return cmd_cadence_render(root, byte_compare=cmd == "cadence-diff",
                                  write_board="--write" in flags, flags=flags)

    if cmd == "cadence-build":
        board, ops = cadence_board(root)
        records = perry_store.cadence_records(board, ops)
        shape, _tables = perry_store.cadence_section_shape(board, ops)
        print(json.dumps({"records": len(records),
                          "stored_fields": len(perry_store.CADENCE_STORED),
                          "register": shape,
                          "sample": records[0] if records else None},
                         ensure_ascii=False, indent=2))
        return 0

    if cmd == "cadence-write":
        return cmd_cadence_write(root, argv, flags)

    if cmd in ("render", "diff"):
        # **Not `build(root)`.** These two read the store from disk for the
        # reason `verify` spells out below.
        return cmd_render(root, byte_compare=cmd == "diff",
                          write_board="--write" in flags, flags=flags)

    records = build(root)
    if cmd == "build":
        print(json.dumps({"records": len(records),
                          "stored_fields": len(STORED),
                          "sample": records[0] if records else None},
                         ensure_ascii=False, indent=2))
        return 0

    if cmd == "write":
        state_root = P.resolve_state_root(root)
        dest = state_root / "tasks.jsonl"

        if "--from-board" not in argv:
            r = lib.root_flag(root)
            print(f"perry-tasks: refusing board-to-store import without "
                  f"`--from-board`. `tasks.jsonl` is authoritative; use "
                  f"`perry-tasks render --write{r}` for store-to-board "
                  f"recovery, or explicitly run `perry-tasks write "
                  f"--from-board{r}` to replace the store from BOARD.md.",
                  file=sys.stderr)
            return 1

        # **This command runs BOARD.md → store, and since TASK-089 that is the
        # backwards direction.** It is the migration and adoption surface: it
        # exists to mint a store for a project that has none. ADR-007 decision
        # 2 made the store canonical and `BOARD.md` rendered output, so once a
        # store exists, re-deriving it from the file overwrites the canonical
        # value with the projection.
        #
        # `perry-lint § store-drift` PRINTED THIS COMMAND AS A REMEDY, in the
        # same sentence that called `tasks.jsonl` "what the field means".
        # Measured on a copy: a store carrying `status: in_progress` and a
        # next-action the board did not have, one `perry-tasks write`, and both
        # were gone — reported as a success, with a record count that did not
        # change. A remedy that destroys the thing it is repairing is worse
        # than no remedy, because the user runs it *because Perry told them
        # to*.
        #
        # So it refuses when a store already exists and disagrees, and names
        # what it would discard. `--from-board` is the explicit opt-in, for the
        # one case where the board really is the truth: someone edited it
        # before the store existed, or adoption is importing a foreign one.
        if dest.exists():
            try:
                on_disk = [json.loads(l) for l in
                           dest.read_text(encoding="utf-8").split("\n") if l.strip()]
            except (OSError, ValueError) as exc:
                print(f"perry-tasks: {dest} exists but cannot be read "
                      f"({type(exc).__name__}: {exc}). Refusing to overwrite a "
                      f"store this tool cannot compare against; move it aside "
                       f"and re-run.", file=sys.stderr)
                return 2
            _valid, malformed = perry_store.validate_records(on_disk)
            if malformed:
                print(json.dumps({"refused": f"{dest} is malformed; refusing "
                                  f"to overwrite a store that cannot be safely "
                                  f"compared", "store_findings": malformed},
                                 ensure_ascii=False, indent=2), file=sys.stderr)
                return 2
            losses = _would_discard(on_disk, records)
            if losses and "--from-board" not in argv:
                print(f"perry-tasks: refusing to overwrite {dest}.\n\n"
                      f"  This command derives the store FROM `BOARD.md`, and "
                      f"the board is rendered output (ADR-007 decision 2). "
                      f"{len(losses)} stored value(s) would be replaced by "
                      f"what the file happens to say:\n",
                      file=sys.stderr)
                for line in losses[:10]:
                    print(f"    {line}", file=sys.stderr)
                if len(losses) > 10:
                    print(f"    … and {len(losses) - 10} more", file=sys.stderr)
                print(f"\n  If the STORE is right — the ordinary case, because "
                      f"`perry-task` writes it — run `perry-tasks render "
                      f"--write{lib.root_flag(root)}` to bring the board back "
                      f"in line.\n"
                      f"  If the BOARD is right — someone edited it before the "
                      f"store existed, or adoption is importing one — re-run "
                      f"with --from-board.", file=sys.stderr)
                return 1

        # Staged and renamed under the project lock, like every other write to
        # a canonical file. `dest.write_text` was a plain truncate-and-write on
        # the ONE file `bin/perry-task` stages so carefully, and it completed
        # while another process held the lock.
        return write_store_or_say_what_would_land(dest, records, flags=flags,
                                                  unit="records")

    if cmd != "verify":
        # **The fall-through is a refusal.** Everything above dispatches on
        # `cmd ==` or `cmd in (…)`, and what reaches here used to be `verify`
        # OR anything the chain missed — so deleting `asks-build`'s branch made
        # `perry-tasks asks-build` answer with the TASK store's verification,
        # exit 0, while `--describe` still listed the subcommand. A V4 review
        # found it by mutation; `bin/perry-config § main` had the identical
        # hole one commit earlier. A declared subcommand that reaches no
        # handler of its own is a bug in this file, not a caller error.
        print(f"perry-tasks: {cmd!r} is declared and reaches no handler — "
              f"that is a defect in this tool, not in your command. Nothing "
              f"was written.", file=sys.stderr)
        return 2

    # **`verify` reads the store FROM DISK, not the one just built.**
    #
    # The first version rebuilt the store and compared it to the board it had
    # just been built from — a tautology that could never fail. A test planted
    # a hand edit into the board and `verify` passed, because both sides saw
    # the same edited value. That is the same defect as a test that passes with
    # its subject deleted, in the tool written to detect exactly that.
    #
    # The store on disk is the only independent thing to compare against, and
    # when there is none the honest answer is "nothing to verify" rather than a
    # pass.
    state_root = P.resolve_state_root(root)
    store_path = state_root / "tasks.jsonl"
    if not store_path.exists():
        print(json.dumps({
            "store": str(store_path), "exists": False,
            "records": 0, "board_rows": 0,
            "note": f"no store on disk yet — run `perry-tasks write "
                    f"--from-board{lib.root_flag(root)}` to perform the "
                    f"explicit board import. Verifying a store against the "
                    f"board it was just built from proves nothing.",
        }, ensure_ascii=False, indent=2))
        return 2
    try:
        records = [json.loads(l) for l in store_path.read_text().split("\n")
                   if l.strip()]
    except (OSError, ValueError) as exc:
        print(json.dumps({"store_valid": False, "store_findings": [
            {"message": f"store is not readable JSONL ({type(exc).__name__}: {exc})"}
        ]}, ensure_ascii=False, indent=2))
        return 2
    records, findings = perry_store.validate_records(records)
    if findings:
        print(json.dumps({"store_valid": False, "store_findings": findings},
                         ensure_ascii=False, indent=2))
        return 2
    board = P.parse_board((state_root / "BOARD.md").read_text(errors="replace"))
    by_id = {r["id"]: r for r in records}
    missing = [t.id for t in board.all_tasks if t.id and t.id not in by_id]
    wrong = []
    for t in board.all_tasks:
        r = by_id.get(t.id)
        if not r:
            continue
        for field, live in (("title", t.title), ("owner", t.owner),
                            ("status", t.status), ("next_action", t.next_action),
                            ("evidence", t.evidence),
                            ("verification", t.verification)):
            if (r.get(field) or "") != (live or ""):
                wrong.append(f"{t.id}.{field}: store={r.get(field)!r} "
                             f"board={live!r}")
    print(json.dumps({"records": len(records),
                      "board_rows": len([t for t in board.all_tasks if t.id]),
                      "rows_missing_from_store": missing,
                      "field_mismatches": wrong[:10],
                      "mismatch_count": len(wrong)},
                     ensure_ascii=False, indent=2))
    return 0 if not missing and not wrong else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
