#!/usr/bin/env python3
"""`perry/tasks.jsonl` — the task store, and the projection of it.

**Phase 002, ADR-007's first slice, and it does not write yet.** This builds the
store from what exists today and proves it can reproduce `BOARD.md`. Nothing
here is canonical until that proof holds on a real project, which is the same
posture `perry-migrate` takes and for the same reason: a store that cannot
reproduce the document it replaces is a store that has already lost data.

    perry-tasks build   [--root <p>]        derive the store; write nothing
    perry-tasks verify  [--root <p>]        field-compare the store to the board
    perry-tasks write   [--root <p>]        actually write perry/tasks.jsonl
    perry-tasks render  [--root <p>]        the store → BOARD.md, on stdout
    perry-tasks diff    [--root <p>]        render and byte-compare with the file

**Eighteen fields are STORED and nine are DERIVED.** That split is the design,
not an optimisation: `blocked_by`, `blocks`, `startable`, `mode`, `open`,
`evidence_paths`, `status_text`, `timeline` and `updated` are all computable
from the eighteen plus the event log, and storing any of them would be the
"a stored value that is derived" defect this repository keeps finding.

Because the derived nine keep being computed the same way, `perry-task/list`
does not change shape — which is phase 002's `P-O3.2`, and the reason a
consumer pinned at `perry-task/list/1.9` needs no edit.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "viewer"))
import parsers as P  # noqa: E402
from tables import cell_spans, split_row  # noqa: E402

#: Written to the store. Everything else in `perry-task/list` is computed.
STORED = ("id", "title", "owner", "status", "priority", "track", "stage",
          "stage_since", "arrived", "verification", "evidence", "next_action",
          "depends_on", "commitment", "parent", "group", "role", "created")


def build(project_root: Path) -> list[dict]:
    """The store, derived from today's canonical sources.

    Reads the board AND the event log, because `done` removes a row: a store
    built from the board alone would lose every closed task, which is the trap
    `check_verification` documents and `walk_design` repeated.
    """
    out, seen = [], set()
    task_mod = _task_module()
    payload = task_mod.cmd_list(_all_args(project_root), _ctx(project_root, task_mod))
    for t in payload["tasks"]:
        rec = {k: t.get(k, "") for k in STORED}
        rec["depends_on"] = list(t.get("depends_on") or [])
        out.append(rec)
        seen.add(t["id"])
    return out


def _task_module():
    import importlib.machinery
    import importlib.util
    path = Path(__file__).resolve().parent / "perry-task"
    spec = importlib.util.spec_from_loader(
        "perry_task_mod", importlib.machinery.SourceFileLoader(
            "perry_task_mod", str(path)))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _all_args(project_root: Path):
    mod = _task_module()
    args = mod.parse(["list", "--all", "--root", str(project_root)])
    return args


def _ctx(project_root: Path, mod):
    state_root = P.resolve_state_root(project_root)
    return {"schema": mod.load_schema(), "project_root": project_root,
            "state_root": state_root, "config": {"tracks": []},
            "board": mod.Board(state_root / "BOARD.md"),
            "events": mod.read_events(project_root)}


# ── the renderer ──────────────────────────────────────────────────────────
#
# **A store that cannot reproduce the document it replaces has already lost
# data**, and "reproduce" has to mean the bytes. `viewer/tables.py §
# render_row` argues the same thing one row down: it refuses to column-align
# because aligning rewrites every row whenever one cell grows, "turning a
# one-cell edit into a whole-table diff and burying the change nobody can then
# review". A renderer that reformats the board does that to the whole file, on
# the first write, forever. So the acceptance here is `cmp`, not "equivalent".
#
# Two things go into a rendered board and they are different things:
#
#   the STORE      the typed values — id, title, status, next action, the
#                  eighteen fields of `STORED`. Every one of them is read out
#                  of `perry/tasks.jsonl` and out of nothing else.
#   the LAYOUT     the projection's shape — the preamble, the section order and
#                  headings, the separator rows, which column sits where, and
#                  the padding and decoration each cell wears. Derived from the
#                  board itself in this slice, because this slice renders and
#                  TASK-089 is what moves the writers.
#
# The line between them is the whole proof, so the report counts every cell the
# layout had to keep VERBATIM rather than fill from the store. A verbatim cell
# is a cell the store cannot reproduce; `diff` can be byte-clean with a hundred
# of them and that is not the same result at all, which is why the number is
# printed next to the verdict rather than hidden behind it.

#: `norm(header cell)` → the store field that column is rendered from. The keys
#: are exactly what `bin/perry-task § cmd_list` zips its cells under, so a
#: localized header resolves here for the same reason it resolves there, and
#: this table cannot drift from the reader without the round trip going red.
FIELD_BY_COLUMN = {
    "id": "id", "title": "title", "owner": "owner", "status": "status",
    "track": "track", "stage": "stage", "stage since": "stage_since",
    "arrived": "arrived", "parent": "parent", "commitment": "commitment",
    "next action": "next_action", "evidence": "evidence",
    "verification": "verification", "role": "role", "depends on": "depends_on",
}


def cell_text(field: str, rec: dict) -> str:
    """One stored field → the text of its cell, escaped the way a row carries it.

    `depends_on` is a list in the store and a cell on the board, so the join is
    here and the split is `bin/perry-task § parse_depends`. The separator that
    round-trips is the one `add --depends` writes; a board that spells its list
    with `、` renders as a verbatim cell and is counted as one, rather than
    being quietly rewritten into English punctuation.
    """
    v = rec.get(field, "")
    if field == "depends_on":
        v = ", ".join(v or [])
    return str("" if v is None else v).strip().replace("|", "\\|")


def describe_cell(raw: str, field: str, rec: dict) -> dict:
    """How one raw cell is rebuilt from one stored value — or that it cannot be.

    Four cases, and **the third is the one the first version of this got
    wrong**:

      the cell IS the value    `{"f": …}` — padding aside, they are the same
                               text.
      the value, decorated     `{"f": …, "p"/"s": …}` — `~~**ALLOC-01**~~` is a
                               real id cell from a real board and
                               `strip_handle` drops the `~~**` before the store
                               ever sees it. The decoration is presentation and
                               is kept here; the id is data and is kept there.
      they DISAGREE            `{"f": …}` again — the store's value is
                               rendered, the board's text is not, and the byte
                               difference is the report. The first version
                               fell back to verbatim here, which meant the
                               layout was derived against the store it was
                               meant to be testing: change a stored value and
                               the cell silently stopped being store-backed,
                               so the board rendered unchanged and `cmp` was
                               clean. **A renderer that cannot be made to
                               print a wrong value cannot be shown to print a
                               right one.**
      the store is EMPTY       `{"lit": …}` — `""` is the contract's word for
                               "not known" (`schema/task-list-contract.md`),
                               and an off-enum status cell like
                               `**迁移 done，占比目标 not_started**` is exactly
                               that: two states in one sentence, so `status` is
                               `""` and only the cell holds the text. Kept
                               verbatim AND COUNTED, because a fallback nobody
                               counts is how a renderer passes `cmp` while
                               reproducing nothing.
    """
    want = cell_text(field, rec)
    body = raw.strip()
    lead = raw[:len(raw) - len(raw.lstrip())]
    trail = raw[len(raw.rstrip()):]
    if not body:
        # A blank cell is ALL padding, and splitting it into a leading half and
        # a trailing half counts it twice — `|  |` came back `|    |` on every
        # empty `Depends on` cell of Perry's own board. The padding it had is
        # kept as one piece for as long as the value is empty; the day the
        # store fills that field the cell gets ordinary `| x |` spacing,
        # because there is no hand alignment in a cell that held nothing.
        c = {"f": field, "lead": " ", "trail": " ", "blank": raw}
        if want:
            c["disagrees"] = body
        return c
    if body == want:
        return {"f": field, "lead": lead, "trail": trail}
    if not want:
        return {"lit": raw}
    if want in body:
        at = body.index(want)
        return {"f": field, "lead": lead, "trail": trail,
                "p": body[:at], "s": body[at + len(want):]}
    return {"f": field, "lead": lead or " ", "trail": trail or " ",
            "disagrees": body}


def render_line(desc: dict, rec: dict) -> str:
    """One row descriptor + one store record → the row's line.

    The separators are `|` because `cell_spans` splits on exactly that and
    leaves the escaped ones inside the span, so a cell whose value contains a
    pipe rebuilds through `cell_text` and lands back where it started.
    """
    out = []
    for c in desc["cells"]:
        if "lit" in c:
            out.append(c["lit"])
            continue
        v = cell_text(c["f"], rec)
        if not v and "blank" in c:
            out.append(c["blank"])
            continue
        out.append(c["lead"] + c.get("p", "") + v + c.get("s", "") + c["trail"])
    return desc["pre"] + "|".join(out) + desc["post"]


def plan(root: Path, records: list[dict]) -> dict:
    """Today's board, split into the lines the store fills and the lines it does not.

    A row line is filled from the record whose `id` it carries and whose
    `group` is the section it sits in; everything else about the line — where
    it sits, what its cells are padded with, what decoration they wear — is
    layout.

    **Row ORDER is layout and not the store, measured rather than assumed.**
    `perry-task/list` returns `sorted(tasks.values(), key=id)` and Perry's own
    `## P1` runs `TASK-047` before `TASK-038`, so a renderer that ordered rows
    out of the store would move two rows of the board it is supposed to
    reproduce. A board's order is authored — triage puts a row where it wants
    it — and nothing in `STORED` records that today. TASK-089 is where that
    has to be answered, because that is where the writers move.

    Disagreements are reported rather than smoothed over: a row on the board
    that the store does not hold renders verbatim and lands in
    `rows_verbatim`, and a row the store holds for a section that has no line
    for it lands in `rows_not_on_board`. Either one is a hole in the
    projection, and neither shows up in `cmp`.
    """
    task_mod = _task_module()
    state_root = P.resolve_state_root(root)
    board = task_mod.Board(state_root / "BOARD.md")
    lines = board.lines
    by_id = {r["id"]: r for r in records}
    by_group: dict[str, list[dict]] = {}
    for r in records:
        if r.get("group"):
            by_group.setdefault(r["group"], []).append(r)

    rows: dict[int, dict] = {}
    report = {"rows_from_store": 0, "rows_verbatim": [],
              "rows_not_on_board": [], "cells_verbatim": {},
              "cells_the_store_and_board_disagree_on": [], "sections": []}

    for heading, _pri, sep, header, end in board._task_sections():
        keys = [task_mod.norm(h) for h in header]
        if "id" not in keys or "title" not in keys:
            # Not a task table — a reference table, a legend. `task_tables()`
            # reports it and reads nothing from it; so does this.
            continue
        wanted = {r["id"] for r in by_group.get(heading, [])}
        seen: set = set()
        for i in range(sep + 1, end):
            s = lines[i].strip()
            if not s.startswith("|"):
                if s and not s.startswith(("#", ">")):
                    break
                continue
            cells = split_row(lines[i])
            if not cells or not cells[0]:
                continue
            tid = task_mod.strip_handle(cells[0])
            rec = by_id.get(tid)
            if rec is None or rec.get("group") != heading:
                report["rows_verbatim"].append(
                    {"section": heading, "cell": cells[0][:60]})
                continue
            seen.add(tid)
            spans = cell_spans(lines[i])
            if len(spans) != len(cells):
                # The two scans disagree about this line, which means one of
                # them is wrong about it. Rendering from the one that is wrong
                # would move a cell; leaving the line alone does not.
                report["rows_verbatim"].append(
                    {"section": heading, "cell": cells[0][:60],
                     "why": "cell spans and split disagree"})
                continue
            desc = {"id": tid, "pre": lines[i][:spans[0][0]],
                    "post": lines[i][spans[-1][1]:], "cells": []}
            for n, (a, b) in enumerate(spans):
                col = header[n] if n < len(header) else f"#{n}"
                field = FIELD_BY_COLUMN.get(keys[n]) if n < len(keys) else None
                c = ({"lit": lines[i][a:b]} if field is None
                     else describe_cell(lines[i][a:b], field, rec))
                if "lit" in c:
                    report["cells_verbatim"][col] = \
                        report["cells_verbatim"].get(col, 0) + 1
                elif "disagrees" in c:
                    report["cells_the_store_and_board_disagree_on"].append(
                        {"id": tid, "column": col,
                         "board": c["disagrees"][:120],
                         "store": cell_text(field, rec)[:120]})
                desc["cells"].append(c)
            rows[i] = desc
            report["rows_from_store"] += 1
        report["rows_not_on_board"].extend(sorted(wanted - seen))
        report["sections"].append({"heading": heading, "rows": len(seen)})
    return {"lines": lines, "rows": rows, "report": report,
            "records": {r["id"]: r for r in records}}


def render(root: Path, records: list[dict]) -> tuple[str, dict]:
    """`perry/tasks.jsonl` → the text of `BOARD.md`. Byte-for-byte is the bar."""
    p = plan(root, records)
    out = list(p["lines"])
    for i, desc in p["rows"].items():
        out[i] = render_line(desc, p["records"][desc["id"]])
    return "\n".join(out), p["report"]


def load_store(root: Path) -> tuple[list[dict], Path]:
    """The store as it is ON DISK — never the one just built.

    `verify` documents why at length and the reason is the same one: a
    renderer fed a store built from the board it is being compared against
    proves that `split_row` and `render_row` are inverses, which nobody
    doubted, and proves nothing at all about the store.
    """
    store_path = P.resolve_state_root(root) / "tasks.jsonl"
    if not store_path.exists():
        return [], store_path
    return [json.loads(l) for l in store_path.read_text(encoding="utf-8")
            .split("\n") if l.strip()], store_path


def cmd_render(root: Path, byte_compare: bool) -> int:
    records, store_path = load_store(root)
    if not records:
        print(json.dumps({
            "store": str(store_path), "exists": store_path.exists(),
            "note": "no store on disk yet — run `perry-tasks write` first. "
                    "Rendering the board from a store built out of that same "
                    "board proves nothing.",
        }, ensure_ascii=False, indent=2), file=sys.stderr)
        return 2
    text, report = render(root, records)
    if not byte_compare:
        sys.stdout.write(text)
        return 0
    live = (P.resolve_state_root(root) / "BOARD.md").read_text(encoding="utf-8")
    report["identical"] = text == live
    if not report["identical"]:
        a, b = live.split("\n"), text.split("\n")
        n = next((i for i in range(max(len(a), len(b)))
                  if (a[i:i + 1] or [None]) != (b[i:i + 1] or [None])), 0)
        report["first_difference"] = {
            "line": n + 1,
            "file": (a[n] if n < len(a) else "<past end of file>")[:400],
            "rendered": (b[n] if n < len(b) else "<past end of render>")[:400],
        }
    print(json.dumps(report, ensure_ascii=False, indent=2))
    return 0 if report["identical"] else 1


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd = argv[0]
    root = Path.cwd()
    if "--root" in argv:
        root = Path(argv[argv.index("--root") + 1]).expanduser().resolve()
    root = Path(os.environ.get("PERRY_PROJECT") or root).resolve()

    if cmd not in ("build", "verify", "write", "render", "diff"):
        print(f"perry-tasks: expected build / verify / write / render / diff, "
              f"got {cmd!r}", file=sys.stderr)
        return 2

    if cmd in ("render", "diff"):
        # **Not `build(root)`.** These two read the store from disk for the
        # reason `verify` spells out below.
        return cmd_render(root, byte_compare=cmd == "diff")

    records = build(root)
    if cmd == "build":
        print(json.dumps({"records": len(records),
                          "stored_fields": len(STORED),
                          "sample": records[0] if records else None},
                         ensure_ascii=False, indent=2))
        return 0

    if cmd == "write":
        state_root = P.resolve_state_root(root)
        dest = state_root / "tasks.jsonl"
        dest.write_text("\n".join(json.dumps(r, ensure_ascii=False)
                                  for r in records) + "\n", encoding="utf-8")
        print(f"perry-tasks: wrote {dest} ({len(records)} records)")
        return 0

    # **`verify` reads the store FROM DISK, not the one just built.**
    #
    # The first version rebuilt the store and compared it to the board it had
    # just been built from — a tautology that could never fail. A test planted
    # a hand edit into the board and `verify` passed, because both sides saw
    # the same edited value. That is the same defect as a test that passes with
    # its subject deleted, in the tool written to detect exactly that.
    #
    # The store on disk is the only independent thing to compare against, and
    # when there is none the honest answer is "nothing to verify" rather than a
    # pass.
    state_root = P.resolve_state_root(root)
    store_path = state_root / "tasks.jsonl"
    if not store_path.exists():
        print(json.dumps({
            "store": str(store_path), "exists": False,
            "records": 0, "board_rows": 0,
            "note": "no store on disk yet — run `perry-tasks write` first. "
                    "Verifying a store against the board it was just built "
                    "from proves nothing.",
        }, ensure_ascii=False, indent=2))
        return 2
    records = [json.loads(l) for l in store_path.read_text().split("\n") if l.strip()]
    board = P.parse_board((state_root / "BOARD.md").read_text(errors="replace"))
    by_id = {r["id"]: r for r in records}
    missing = [t.id for t in board.all_tasks if t.id and t.id not in by_id]
    wrong = []
    for t in board.all_tasks:
        r = by_id.get(t.id)
        if not r:
            continue
        for field, live in (("title", t.title), ("owner", t.owner),
                            ("status", t.status), ("next_action", t.next_action),
                            ("evidence", t.evidence),
                            ("verification", t.verification)):
            if (r.get(field) or "") != (live or ""):
                wrong.append(f"{t.id}.{field}: store={r.get(field)!r} "
                             f"board={live!r}")
    print(json.dumps({"records": len(records),
                      "board_rows": len([t for t in board.all_tasks if t.id]),
                      "rows_missing_from_store": missing,
                      "field_mismatches": wrong[:10],
                      "mismatch_count": len(wrong)},
                     ensure_ascii=False, indent=2))
    return 0 if not missing and not wrong else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
