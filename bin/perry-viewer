#!/usr/bin/env bash
# perry-viewer — launch the optional read-only web viewer for a Perry project.
#
# The viewer is OPT-IN. Lightweight users never run it and carry zero extra
# dependencies. Power users run this once; it auto-creates a private venv,
# installs Flask + markdown, and starts a localhost server that renders the
# project's BOARD / OKR / phase / decisions / risks / architecture / atlas.
#
# Read-only: it never writes project files. It re-reads them on every request,
# so it always reflects the live state. Stop it with Ctrl-C; nothing runs when
# it's not started (no daemon).
#
# Usage (from inside your project dir — the PROJECT root, where `.perry/`
# lives; that is the same directory as BOARD.md unless `.perry/config.md §
# State root` moved the state into a subdirectory, as Perry's own does):
#   bash "$PERRY_HOME/bin/perry-viewer"
#   bash "$PERRY_HOME/bin/perry-viewer" --port 9000
#   bash "$PERRY_HOME/bin/perry-viewer" --root /path/to/project
#   bash "$PERRY_HOME/bin/perry-viewer" --reinstall   # rebuild the venv
set -e

# ─── Resolve PERRY_HOME (skill root = parent of bin/) ────────
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
PERRY_HOME="${PERRY_HOME:-$(cd "$SCRIPT_DIR/.." && pwd -P)}"
VIEWER_DIR="$PERRY_HOME/viewer"
VENV_DIR="$HOME/.cache/perry/viewer-venv"

# ─── Flags ───────────────────────────────────────────────────
PORT="${PERRY_VIEWER_PORT:-8080}"
ROOT=""
REINSTALL=0
while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT="$2"; shift 2 ;;
    --root) ROOT="$2"; shift 2 ;;
    --reinstall) REINSTALL=1; shift ;;
    -h|--help)
      sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "Unknown flag: $1 (try --help)" >&2; exit 2 ;;
  esac
done

if [ ! -f "$VIEWER_DIR/serve.py" ]; then
  echo "❌ Viewer source not found at $VIEWER_DIR. Is Perry installed correctly?" >&2
  exit 1
fi

# ─── Resolve project root ────────────────────────────────────
# Explicit --root wins; else the CWD, exported verbatim — the precedence and
# the meaning `bin/README.md` declares for `$PERRY_PROJECT` and every `bin/`
# tool reads: the PROJECT root, the directory `.perry/` is anchored in. So run
# this from there, and `--root` takes what `perry-state --root` takes.
#
# `viewer/parsers.py` derives the STATE root from it (`resolve_state_root`),
# which is why a project whose state lives in a subdirectory now renders from
# here. It used to read this value AS the state root, find no `BOARD.md` and
# serve an empty snapshot (TASK-159) — one value, two readings, and the
# launcher was pointing at the one the viewer was not expecting.
PROJECT="${ROOT:-$(pwd)}"
PROJECT="$(cd "$PROJECT" 2>/dev/null && pwd -P || echo "$PROJECT")"

# ─── Ensure venv (create + install on first run) ─────────────
PYBIN=""
for cand in python3 python; do
  command -v "$cand" >/dev/null 2>&1 && { PYBIN="$cand"; break; }
done
[ -z "$PYBIN" ] && { echo "❌ No python3 on PATH — required for the viewer." >&2; exit 1; }

if [ "$REINSTALL" -eq 1 ]; then
  rm -rf "$VENV_DIR"
fi

VENV_PY="$VENV_DIR/bin/python"
needs_install=0
if [ ! -x "$VENV_PY" ]; then
  needs_install=1
elif ! "$VENV_PY" -c "import flask, markdown" >/dev/null 2>&1; then
  needs_install=1
fi

if [ "$needs_install" -eq 1 ]; then
  echo "⏳ First-time setup: creating viewer venv at $VENV_DIR …"
  mkdir -p "$(dirname "$VENV_DIR")"
  "$PYBIN" -m venv "$VENV_DIR"
  echo "⏳ Installing dependencies (Flask + markdown)…"
  "$VENV_PY" -m pip install --quiet --upgrade pip >/dev/null 2>&1 || true
  if ! "$VENV_PY" -m pip install --quiet -r "$VIEWER_DIR/requirements.txt"; then
    echo "❌ Dependency install failed. Check network / pip. Venv left at $VENV_DIR." >&2
    exit 1
  fi
  echo "🟢 Viewer environment ready."
fi

# ─── Launch ──────────────────────────────────────────────────
echo "🅿  Perry viewer · project: $PROJECT"
echo "   Open http://127.0.0.1:$PORT   (Ctrl-C to stop)"
export PERRY_PROJECT="$PROJECT"
export PERRY_VIEWER_PORT="$PORT"
exec "$VENV_PY" "$VIEWER_DIR/serve.py"
