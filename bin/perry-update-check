#!/usr/bin/env bash
# perry-update-check — once-per-week background check that the Perry skill
# folder is current with the latest stable release (or reports dev main).
#
# Consumer checks use verified stable GitHub Releases; developers compare main.
# Symlink installs are report-only unless --channel release is explicit.
# Dirty/feature/local-work protections apply on either channel.
set -e

WEEK_SECS=$((7 * 24 * 60 * 60))

# ─── Parse flags ──────────────────────────────────────────────
QUIET=0
FORCE=0   # bypass the 7-day throttle (for manual invocation)
STRICT=0  # exit non-zero on any failure (for CI / debugging)
CHANNEL=auto
while [ $# -gt 0 ]; do
  case "$1" in
    --quiet)  QUIET=1; shift ;;
    --force)  FORCE=1; shift ;;
    --strict) STRICT=1; shift ;;
    --channel)
      case "${2:-}" in
        auto|release) CHANNEL="$2"; shift 2 ;;
        *) echo "--channel takes auto or release" >&2; exit 2 ;;
      esac ;;
    -h|--help)
      cat <<'USAGE'
perry-update-check — Perry skill auto-update probe (once per week).

Usage: perry-update-check [--force] [--quiet] [--strict] [--channel auto|release]

  --force   ignore the 7-day throttle; check now
  --quiet   suppress non-error output
  --strict  exit non-zero on any failure (default: always exit 0)
  --channel release  explicitly choose verified releases for a clean symlink
                     install; dirty/feature/local work remains report-only

Consumers use the latest published stable GitHub Release, never unverified
main. With no release or a failed validation, the checkout stays unchanged.

The script is invoked from the Perry skill standup ritual. Manual run:

  bash "${PERRY_HOME:-$HOME/.claude/skills/perry}/bin/perry-update-check" --force
USAGE
      exit 0 ;;
    # Exit 2, not 1. `bin/README.md` and DESIGN-016 criterion 10a make 1 "the
    # thing you asked for was refused, and the reason is printed" and 2 "the
    # invocation itself is malformed"; callers branch on the difference, and
    # this tool's own `--strict` documents 1 as "the check failed". A typo in a
    # flag is not a failed update check.
    *) echo "Unknown flag: $1 (try --help)" >&2; exit 2 ;;
  esac
done

mtime_of() {
  # See `bin/perry-dispatch-limit § mtime` (TASK-138). GNU `stat -f` is
  # `--file-system` and SUCCEEDS, so the `-f || -c` chain never falls through
  # on Linux. Try GNU first (BSD rejects `-c` outright) and accept digits only.
  local v
  v=$(stat -c %Y "$1" 2>/dev/null) && case "$v" in
    ""|*[!0-9]*) : ;;
    *) printf '%s\n' "$v"; return 0 ;;
  esac
  v=$(stat -f %m "$1" 2>/dev/null) && case "$v" in
    ""|*[!0-9]*) : ;;
    *) printf '%s\n' "$v"; return 0 ;;
  esac
  echo 0
}
log()  { [ "$QUIET" -eq 1 ] || echo "$@"; }
warn() { echo "$@" >&2; }
fail() { warn "$@"; [ "$STRICT" -eq 1 ] && exit 1 || exit 0; }

# ─── Resolve source dir ───────────────────────────────────────
# Resolution order:
#   1. $PERRY_HOME if set (explicit override; works for any custom install)
#   2. $HOME/.claude/skills/perry (Claude Code default)
#   3. $HOME/.agents/skills/perry (Codex CLI default)
#   4. $HOME/.config/opencode/skills/perry (OpenCode default)
#   5. Self-locate via $0 (script's own grandparent dir)
PERRY_LINK=""
for candidate in \
  "${PERRY_HOME:-}" \
  "$HOME/.claude/skills/perry" \
  "$HOME/.agents/skills/perry" \
  "$HOME/.config/opencode/skills/perry"
do
  [ -z "$candidate" ] && continue
  # Require a real Perry install (SKILL.md present), not just any existing path.
  # Matches the $0-fallback check below; prevents a stale empty
  # ~/.claude/skills/perry from shadowing a real ~/.agents/skills/perry on a
  # Codex-only box where PERRY_HOME is unset.
  if [ -e "$candidate" ] && [ -f "$candidate/SKILL.md" ]; then
    PERRY_LINK="$candidate"
    break
  fi
done

if [ -z "$PERRY_LINK" ]; then
  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
  CANDIDATE="$(cd "$SCRIPT_DIR/.." && pwd -P)"
  if [ -d "$CANDIDATE" ] && [ -f "$CANDIDATE/SKILL.md" ]; then
    PERRY_LINK="$CANDIDATE"
  fi
fi

if [ -z "$PERRY_LINK" ] || [ ! -e "$PERRY_LINK" ]; then
  fail "Perry install not found — checked \$PERRY_HOME, ~/.claude/skills/perry, ~/.agents/skills/perry, ~/.config/opencode/skills/perry. Set PERRY_HOME to override."
fi

# Resolve to real path (follows symlinks). readlink behavior differs on
# macOS vs Linux, so use a portable two-step.
if [ -L "$PERRY_LINK" ]; then
  IS_SYMLINK=1
  # macOS readlink prints the immediate target only; cd-then-pwd resolves
  SRC="$(cd "$PERRY_LINK" 2>/dev/null && pwd -P)"
else
  IS_SYMLINK=0
  SRC="$PERRY_LINK"
fi

if [ -z "$SRC" ] || [ ! -d "$SRC" ]; then
  fail "Could not resolve Perry source dir from $PERRY_LINK — skipping."
fi

# ─── Skip if not a git repo ───────────────────────────────────
if ! git -C "$SRC" rev-parse --git-dir >/dev/null 2>&1; then
  log "Perry source at $SRC is not a git checkout — skipping update check."
  exit 0
fi

# ─── Throttle: ≥ 7 days since last check ──────────────────────
CHECK_FILE="$SRC/.update-check"
NOW=$(date +%s)

if [ "$FORCE" -eq 0 ] && [ -f "$CHECK_FILE" ]; then
  # Portable mtime: try macOS stat first, fall back to GNU
  LAST=$(mtime_of "$CHECK_FILE")
  ELAPSED=$((NOW - LAST))
  if [ "$ELAPSED" -lt "$WEEK_SECS" ]; then
    # Recently checked; bail without noise
    exit 0
  fi
fi

# Keep host lookup in this portable shell entry point. The stdlib helper owns
# bounded network, release verification and the locked fast-forward decision.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
HELPER="$SCRIPT_DIR/../release/update.py"
args=(--source "$SRC" --channel "$CHANNEL")
[ "$IS_SYMLINK" -eq 1 ] && args+=(--symlink)
[ "$QUIET" -eq 1 ] && args+=(--quiet)
[ "$FORCE" -eq 1 ] && args+=(--force)
[ "$STRICT" -eq 1 ] && args+=(--strict)
if [ ! -f "$HELPER" ]; then
  fail "perry-update-check: release helper is missing; checkout unchanged."
fi
exec python3 "$HELPER" "${args[@]}"
