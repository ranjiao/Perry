    # `check_store_drift` says why.
    return findings


#: The markdown-backed stores, in the order the census prints them, with the
#: noun each line uses for the register. `bin/perry_md_store.py` holds "one
#: implementation, N instances" — a `Doc` differs only in its scanner — so the
#: census names them from that module rather than keeping a second list that
#: would go stale the day another document joins.
#:
#: **It held two until ADR-019.** `.perry/config.md` was the other, and a
#: document with no file has no projection to drift from; the config store is
#: checked by `check_config_store` below and printed on its own census line, so
#: the seven declared stores are still seven lines.
_MD_STORE_DOCS = ((_MD_STORE.OKR, "OKR store"),)


def _empty_md_store_drift_stats() -> dict:
    """The typed machine-readable state before an `OKR.md`/config comparison.

    Same four keys as the other four registers so a reader of `--json` meets
    one shape six times rather than six shapes. `drifted` stays `0` rather
    than `None` here because — unlike `check_store_drift` — this comparison
    has no second input that can be missing: the left-hand side is the file
    itself, so "the store is present and the file is not" is uncheckable and
    says so, and there is no third state where a number would be a lie.
    """
    return {"store_present": False, "comparison_performed": False,
            "records": 0, "drifted": 0}


def _empty_md_store_drift_stats_all() -> dict:
    return {doc.name: _empty_md_store_drift_stats()
            for doc, _label in _MD_STORE_DOCS}


def _empty_config_store_stats() -> dict:
    """The typed machine-readable state before `.perry/config.jsonl` is read.

    Same four keys as the six registers beside it so a reader of `--json` meets
    one shape seven times. `drifted` is `0` and stays `0`: ADR-019 left one
    copy of this state, and a single copy cannot disagree with itself. The key
    is kept rather than dropped because the payload's shape is what a caller
    iterates, and a seventh register that answers a different set of questions
    is how a reader comes to special-case one store.
    """
    return {"store_present": False, "comparison_performed": False,
            "records": 0, "drifted": 0}


def check_config_store(project_root: Path, state_root: Path) -> list["Finding"]:
    """`.perry/config.jsonl` — the records validate, and the tracks are whole.

    **This is what is left of `config-store-drift` after ADR-019.** That check
    handed `.perry/config.md` and the store to `perry_md_store.plan` and
    reported where the two disagreed. The file is gone, so the disagreement is
    impossible rather than clean — which is the outcome the ADR was taken for —
    and what remains are the two questions that were never about the
    projection:

    - **do the records validate**, which every writer already refuses on
      (`bin/perry-state § TRACKS_STORE_UNUSABLE`) but which nothing PRINTED
      outside a refusal, so a project could carry a broken register and read as
      a clean lint;
    - **does each track declare the columns its mode has no default for**,
      which used to ride on the `files[id=config].tables[Tracks]`
      `no_default_by_mode` spec and went with that entry. `work_modes.modes.
      <mode>.no_default` is still the one list, read through `MODE_NO_DEFAULT`,
      so the linter and `bin/perry-state § missing_defaults` cannot report
      different tracks;
    - **does `mode` / `default_rung` name something the schema declares**,
      which was `enum_columns` on the same table spec;
    - **did the `stages` field actually split**, which was the `Stages` column
      half of the same block. A cell using a separator Perry does not split on
      becomes ONE stage whose name is the whole list, and every stage-based
      measure then runs on it — silently. That failure mode does not care
      whether the value arrived through a markdown cell or a JSON string.

    **Three checks that would have gone quiet with the `files[]` entry, and
    did not.** Deleting a projection is allowed to remove a comparison; it is
    not allowed to remove a check about the thing that is left. Each reads the
    same schema list its table-driven twin read, so the linter cannot come to
    disagree with the splitter or with `bin/perry-state`.

    `no-default` and `stage-separator` stay WARN for the reason the schema
    gives at length: an error would retroactively invalidate every register
    written before the rule. The question is FORCED at creation instead, and
    the hard stops exist at the point of use (`goals/reference/phases.md`
    refuses a queue commitment against a track with no SLA). `bad-enum` stays
    an ERROR, as it is everywhere else.
    """
    findings: list[Finding] = []
    stats = _empty_config_store_stats()
    check_config_store.stats = stats

    store_path = Path(project_root) / ".perry" / "config.jsonl"
    if not store_path.exists():
        # "No store" and "clean" are different answers, and the caller prints
        # the absence. Silent here, with a payload — the six registers beside
        # this one return on exactly these terms.
        return []

    stats["store_present"] = True
    rel_store = _rel(store_path, project_root)

    try:
        on_disk = _MD_STORE.load_store(store_path)
    except (OSError, ValueError) as exc:
        return [Finding("warn", rel_store, "config-store-unreadable",
                        f"`.perry/config.jsonl` is not readable as JSONL "
                        f"({type(exc).__name__}: {exc}) — this project's "
                        f"settings and tracks cannot be read at all, and every "
                        f"writer refuses until it can be")]
    if not all(isinstance(r, dict) for r in on_disk):
        return [Finding("warn", rel_store, "config-store-unreadable",
                        f"`.perry/config.jsonl` holds something other than one "
                        f"JSON OBJECT per line — a whole-file array and a bare "
                        f"scalar both parse and neither is a record")]

    good, issues = _MD_STORE.validate_records(on_disk)
    for issue in issues:
        who = issue.get("key") or f"line {issue['line']}"
        findings.append(Finding(
            "warn", rel_store, "config-store-badly-typed",
            f"{who} — {issue['message']}. A store holding a record that does "
            f"not validate is refused whole by every writer, not per record."))

    # **The census verdict is the writers' own predicate, not this function's
    # reading of `issues`** (TASK-270). `comparison_performed` is what prints
    # "all valid" or "every writer refuses", and while it was keyed on this
    # file's own validation it said `0 record(s), all valid` about a store
    # every writer refused. `parsers.config_store_unusable` is the call
    # `perry-task` and `perry-goals` make; if it ever says unusable where the
    # findings above named nothing, that is reported rather than printed clean.
    unusable = P.config_store_unusable(Path(project_root))
    if unusable and not issues:
        findings.append(Finding(
            "warn", rel_store, "config-store-badly-typed",
            f"every writer refuses this store ({unusable}) and no record above "
            f"was named — `parsers.config_store_unusable` and this check have "
            f"come apart, which is a Perry defect to report"))
    stats["comparison_performed"] = not unusable
    stats["records"] = len(good)

    seps = STAGE_SEPARATORS
    for rec in good:
        if rec.get("kind") != "track":
            continue
        who = (rec.get("track") or "").strip() or "?"
        mode = (rec.get("mode") or "project").strip().lower()

        for field, enum_name in TRACK_ENUM_FIELDS.items():
            allowed = DECLARED_ENUMS.get(enum_name) or []
            value = str(rec.get(field) or "").strip()
            if not allowed or not value or lib.is_blank_cell(value):
                continue
            if value not in allowed:
                findings.append(Finding(
                    "error", rel_store, "bad-enum",
                    f"track {who!r}: `{field}: {value}` is not one of "
                    f"{allowed}"))

        # **A `stages` value that did not split is reported by name.**
        # `split_stages` accepts the separators in `schema § work_modes.
        # stage_separators.accepted`; a value using any other one becomes ONE
        # stage whose name is the whole list, and WIP, stage age and this
        # mode's triage question all measure against it. Reproduced on a
        # project reporting 8 lint errors, not one of which named the cell.
        # Both halves read the SAME schema list, which is what stops the
        # splitter and this check disagreeing about what a separator is.
        cell = str(rec.get("stages") or "").strip()
        if cell and not lib.is_blank_cell(cell) and seps.get("suspect") \
                and not any(a in cell for a in (seps.get("accepted") or [])):
            hit = next((c for c in seps["suspect"] if c in cell), None)
            if hit:
                findings.append(Finding(
                    "warn", rel_store, "stage-separator",
                    f"track {who!r} lists its stages with {hit!r}, which Perry "
                    f"does not split on — the whole value becomes ONE stage "
                    f"named {cell!r}, and WIP, stage age and this mode's "
                    f"triage question all measure against it. Use one of "
                    f"{', '.join(repr(a) for a in seps['accepted'])}."))

        for col in MODE_NO_DEFAULT.get(mode, []):
            # `lib.is_blank_cell` and `PLACEHOLDER` are the SAME two the table
            # check used, so a blank spelled `—` reads undeclared here exactly
            # as it did in the cell. `perry_md_store § stored_value`
            # normalises a declared blank to `""` on the way in, so most of
            # the set is unreachable from a store — it is kept because a
            # hand-written record is not, and this is the file that reports
            # hand-written records.
            value = str(rec.get(col.lower().replace(" ", "_")) or "").strip()
            if not lib.is_blank_cell(value) and not PLACEHOLDER.search(value):
                continue
            findings.append(Finding(
                "warn", rel_store, "no-default",
                f"track {who!r} is mode {mode!r} and its `{col}` is "
                f"undeclared. {mode} has no default `{col}` (schema "
                f"work_modes.modes.{mode}.no_default) because it is a "
                f"commitment the project makes to someone, and a number Perry "
                f"invented is one the project never made — every triage run "
                f"afterwards would measure real work against it. Declare it on "
                f"this track's record; until then triage reports the gap "
                f"instead of a verdict."))
    return findings


def check_md_store_drift(project_root: Path, state_root: Path,
                         doc) -> list["Finding"]:
    """`OKR.md` and its store disagree — TASK-209.

    **The comparison is not written here.** `perry-okr diff` and
    `perry-config diff` have compared these two files against their stores
    since TASK-092, and both ran clean on this project on 2026-08-28 — yet
    `perry-lint` called neither, so one run of the census covered two of the
    six declared stores and ADR-007's guarantee was checked for two. What this
    function adds is the CALL: it loads the store the way those commands do
    (`load_store` → `validate_records`), renders through `perry_md_store.plan`
    — the same plan `render`, `diff` and `verify` are all built on — and turns
    that one report into findings. A third and fourth implementation of the
    same comparison is the defect ADR-004 and this phase exist to stop, so
    there isn't one.

    **What counts as a drifted ROW.** `plan`'s report answers in three
    registers and all three are drift, so all three are counted, by record key:
    a cell the file and the store disagree on; a line the file carries that the
    store holds no record for (a hand-edited id or heading moves a row out of
    the store's reach — `record_key` says why); and a record the store holds
    that the file renders no line for. `perry-{okr,config} verify` fails on the
    same three, which is the point of borrowing them.

    **A decorated cell is reported and not counted.** `3 of 3 modes live,
    honest` over a stored `3 of 3 modes live` renders byte-identically and
    still carries words the store never asserted, so `plan` counts it under
    `cells_wearing_decoration` — by COLUMN, with no key to attribute it to a
    row. Counting it as a row would be inventing an attribution; leaving it
    silent would be the census reporting clean on a file carrying unstored
    text. It gets its own finding and the row count stays a row count, which
    is what `verify` does too.
    """
    findings: list[Finding] = []
    stats = _empty_md_store_drift_stats()
    if not hasattr(check_md_store_drift, "stats"):
        check_md_store_drift.stats = _empty_md_store_drift_stats_all()
    check_md_store_drift.stats[doc.name] = stats

    store_path = doc.store_path(project_root, state_root)
    if not store_path.exists():
        # "No store" and "clean" are different answers, and the caller prints
        # the absence. Silent here, with a payload — the four registers above
        # return on exactly these terms.
        return []

    stats["store_present"] = True
    rel_store = _rel(store_path, project_root)
    file_path = doc.file_path(project_root, state_root)
    rel_file = _rel(file_path, project_root)

    try:
        on_disk = _MD_STORE.load_store(store_path)
    except (OSError, ValueError) as exc:
        return [Finding("warn", rel_store, f"{doc.name}-store-unreadable",
                        f"`{doc.rel_store}` is not readable as JSONL "
                        f"({type(exc).__name__}: {exc}) — there is nothing to "
                        f"compare `{doc.rel_file}` against")]
    if not all(isinstance(r, dict) for r in on_disk):
        return [Finding("warn", rel_store, f"{doc.name}-store-unreadable",
                        f"`{doc.rel_store}` holds something other than one "
                        f"JSON OBJECT per line — a whole-file array and a "
                        f"bare scalar both parse and neither is a record")]

    if not file_path.exists():
        return [Finding("warn", rel_store, f"{doc.name}-store-drift-uncheckable",
                        f"`{rel_store}` exists and there is no "
                        f"`{doc.rel_file}` to project it onto, so drift is "
                        f"unknown here rather than absent")]

    good, issues = _MD_STORE.validate_records(on_disk)
    for issue in issues:
        who = issue.get("key") or f"line {issue['line']}"
        findings.append(Finding(
            "warn", rel_store, f"{doc.name}-store-badly-typed",
            f"{who} — {issue['message']}. The record is excluded from the "
            f"drift comparison, so this row's drift is unknown here rather "
            f"than absent."))

    try:
        text = file_path.read_text(encoding="utf-8", errors="replace")
        report = _MD_STORE.plan(doc, text, good)["report"]
    except Exception as exc:  # noqa: BLE001
        return findings + [Finding(
            "warn", rel_file, f"{doc.name}-store-drift-uncheckable",
            f"`{doc.rel_file}` could not be projected from `{rel_store}` "
            f"({type(exc).__name__}: {exc}), so drift is unknown here rather "
            f"than absent")]

    stats["comparison_performed"] = not issues
    stats["records"] = len(good)

    #: key → the sentence that says what is wrong with that row. Keyed rather
    #: than appended so a row whose two cells both drift is ONE drifted row —
    #: the same rule the four registers above follow.
    rows: dict[str, str] = {}
    for cell in report["cells_the_store_and_the_file_disagree_on"]:
        detail = (f"`{cell['column']}`: file={_cell(cell['file'])!r} "
                  f"store={_cell(cell['store'])!r}")
        rows[cell["key"]] = (rows[cell["key"]] + "; " + detail
                             if cell["key"] in rows else detail)
    for line in report["lines_verbatim"]:
        rows.setdefault(line["key"],
                        f"line {line['line']} — {line['why']}")
    for key in report["records_not_in_the_file"]:
        rows.setdefault(key, f"the store holds this record and "
                             f"`{doc.rel_file}` renders no line for it")

    stats["drifted"] = len(rows)
    # TASK-253's category, at the one site in this file that still had it. The
    # four sibling drift messages (`:3966`, `:4107`, `:4254`, `:4382`) each
    # build `_r` and paste it; these two did not, while `project_root` sat in
    # this function's own signature. Both commands here are WRITERS and the
    # second discards stored values, so a reader who copies one acts on
    # whatever project their cwd resolves to — the exact harm the row was
    # opened on, one tool over from where it was found.
    _r = lib.root_flag(project_root)
    for key in sorted(rows)[:DRIFT_ROWS_SHOWN]:
        findings.append(Finding(
            "warn", rel_file, f"{doc.name}-store-drift",
            f"{key} — {rows[key]}. Under ADR-007 `{doc.rel_file}` is rendered "
            f"output and `{rel_store}` is what the field means, so a hand edit "
            f"is drift. `perry-{doc.name} render --write{_r}` puts the file "
            f"back in line with the store when every stored record still has "
            f"a line, and REFUSES when one does not (DESIGN-016 A5); "
            f"`perry-{doc.name} write --from-file{_r}` runs the other "
            f"direction and DISCARDS the stored values."))
    if len(rows) > DRIFT_ROWS_SHOWN:
        findings.append(Finding(
            "warn", rel_file, f"{doc.name}-store-drift",
            f"and {len(rows) - DRIFT_ROWS_SHOWN} further row(s) of "
            f"`{doc.rel_file}` disagree with `{rel_store}`."))

    for column, n in sorted(report["cells_wearing_decoration"].items()):
        findings.append(Finding(
            "warn", rel_file, f"{doc.name}-store-decorated",
            f"`{column}` — {n} cell(s) render the stored value and then carry "
            f"further text the store does not hold. The bytes match, so this "
            f"is not counted as a drifted row; the words are still unstored, "
            f"and `perry-{doc.name} verify` fails on them too."))

    # Order, once per kind rather than once per row — `_order_drift` carries
    # the argument in full and `plan` has already done the comparison.
    for moved in report["records_out_of_stored_order"]:
        findings.append(Finding(
            "warn", rel_file, f"{doc.name}-store-drift",
            f"`{moved['kind']}` — the rows of this register sit in a "
            f"different order in the file than in `{rel_store}`: file "
            f"{' → '.join(moved['in_the_file'][:6])}, store "
            f"{' → '.join(moved['in_the_store'][:6])}. Row order is recorded, "
            f"not re-derived, so a row moved by hand is drift like any other "
            f"cell."))
    return findings


def is_adopted(project_root: Path, state_root: Path) -> bool:
    """Has this project any Perry state at all?

    Linting a folder that has never been adopted used to report every required
    file as missing — noise on someone else's project, and unusable as the
    stage-4 gate in `reference/adoption.md`, which needs to distinguish "the
    files adoption wrote are malformed" from "adoption hasn't run"."""
    # The predicate is `parsers § installed`, the criterion `schema/README.md §
    # installed` states. `BOARD.md`, `OKR.md` and `phase/` alone stopped
    # counting at TASK-237 3b′: every documented start writes
    # `.perry/config.jsonl` first. `state_root` stays in the signature for the
    # callers that pass it.
    return P.installed(project_root)


def iter_targets(root: Path, spec: dict) -> list[Path]:
    pattern = spec["path"]
    exclude = spec.get("exclude")
    if any(ch in pattern for ch in "*?["):
        out = sorted(root.glob(pattern))
    else:
        p = root / pattern
        out = [p] if p.exists() else []
    if exclude:
        out = [p for p in out if not fnmatch.fnmatch(p.relative_to(root).as_posix(), exclude)]
    return [p for p in out if p.is_file()]


#: The store declared by `schema/state-schema.json § stores.declared`, with the
#: noun the census line uses for it. Named here rather than spelled inline for
#: the reason `_MD_STORE_DOCS` is a table: the day a second store is declared
#: there, the census gains a line without a second list to keep in step.
_JSONL_STORE_KEY = "linkage.jsonl"
_JSONL_STORE_LABEL = "linkage store"


def _empty_linkage_store_stats() -> dict:
    """The typed machine-readable state before the linkage store is read.

    **`drifted` is gone from this shape, and its absence is the finding
    ADR-019 records.** The other six registers project from a markdown
    document and can disagree with it; `linkage.jsonl` projected from
    `phase/<NNN>-linkage.md`, and `linkage-store-drift` reported the
    disagreement — `1 row(s) drifted` on `P003-O3-KR2`, on this project, on
    the day the ADR was written. The document is deleted. A drift count over
    one copy is not zero, it is meaningless, and publishing `0 drifted` here
    would be the strongest possible version of the `unchecked`-read-as-`clean`
    mistake `P003-O1-KR3` exists to prevent. What is left to report is what
    can still be true or false: how many records there are and whether every
    one of them matches a declared shape.
    """
    return {"store_present": False, "records": 0, "malformed": 0}


def _linkage_record_findings(records: list, declared: dict,
                             enums: dict | None = None
                             ) -> tuple[list[dict], list]:
    """Valid records, and findings for the malformed ones — schema-driven.

    **The field list is not written here.** It is read from
    `schema/state-schema.json § stores.declared["linkage.jsonl"].records`,
    which is what TASK-276 declares. A second copy in Python is the
    two-lists-disagreeing defect DESIGN-002 and ADR-004 exist to stop, and it
    is the specific way a declaration becomes decorative: the schema would say
    one thing, the checker would enforce another, and nothing would compare
    them.
    """
    kinds = declared.get("records") or {}
    types = {"string": str, "number": (int, float), "boolean": bool,
             "object": dict, "array": list}
    # **The discriminating field is DECLARED, not assumed.** Hard-coding
    # `"kind"` here is what makes `stores.declared[…].discriminator`
    # decorative — a key the schema states and no code reads — which is the
    # same declaration-nothing-checks defect this store is being added to
    # remove one level up. A mutation round caught exactly that: changing
    # the declared discriminator to `"type"` left every test green, because
    # nothing was reading it. Recorded in `evidence/2026-09/TASK-276-result.md`.
    disc = declared.get("discriminator") or "kind"
    good: list[dict] = []
    findings: list = []
    for line, rec in enumerate(records, 1):
        if not isinstance(rec, dict):
            findings.append({"line": line,
                             "message": "expected one JSON object per line"})
            continue
        kind = rec.get(disc)
        if kind not in kinds:
            findings.append({"line": line, "message":
                             f"`{disc}` is {kind!r}, expected one of "
                             f"{'/'.join(sorted(kinds))}"})
            continue
        fields = kinds[kind].get("fields") or {}
        bad = []
        for name, spec in fields.items():
            if name not in rec:
                if spec.get("required"):
                    bad.append(f"`{name}` is missing and is required")
                continue
            value = rec[name]
            # `nullable: true` — present, and `null` is a legal value.
            # DESIGN-022 § 5.1's `check.baseline` is a number for `increase` /
            # `decrease` and `null` otherwise; without this the design's own
            # record shape would be malformed (TASK-416).
            if value is None and spec.get("nullable"):
                continue
            want = types.get(spec.get("type"))
            # `bool` is a subclass of `int` in Python and JSON `true` is not a
            # number. `perry_store.validate_records` makes the same exclusion
            # for the same reason.
            ok = want is None or (
                isinstance(value, want)
                and not (want is not bool and isinstance(value, bool)))
            if not ok:
                bad.append(f"`{name}` is {type(value).__name__}, expected "
                           f"{spec.get('type')}")
                continue
            const = spec.get("const")
            if const is not None and value != const:
                bad.append(f"`{name}` is {value!r}, expected {const!r}")
                continue
            pattern = spec.get("pattern")
            if pattern and isinstance(value, str) and not re.match(pattern,
                                                                   value):
                bad.append(f"`{name}` is {value!r}, which does not match "
                           f"`{pattern}`")
                continue
            # **A named enum, read from `schema.enums` rather than restated as
            # a pattern.** `project.status` is `linkage_status`, which four
            # other declarations already key on; spelling it `^(active|done)$`
            # here is how a value space comes to have two definitions that
            # disagree — and it did: that pattern named two of the four, so a
            # `dropped` Project was a malformed record, and `bin/perry-goals §
            # resolve_target`'s "a retired Project is named rather than used"
            # refusal was unreachable through a record the linter accepted.
            named = spec.get("enum")
            if named and isinstance(value, str):
                allowed = (enums or {}).get(named)
                if allowed is None:
                    bad.append(f"`{name}` declares enum {named!r}, which "
                               f"`schema.enums` does not define")
                elif value not in allowed:
                    bad.append(f"`{name}` is {value!r}, which is not one of "
                               f"{'/'.join(allowed)}")
        if bad:
            findings.append({"line": line, "message": "; ".join(bad)})
            continue
        good.append(rec)
    return good, findings


def _linkage_graph_findings(records: list, rel: str) -> list["Finding"]:
    """The three graph-integrity rules, over one phase's records.

    They lived in `check_frontmatter`, grading `phase/<NNN>-linkage.md`'s
    frontmatter against `files[id=linkage]`. ADR-019 deleted that entry and
    that file. The rules are unchanged in id, severity and wording — what
    changed is that `tasks[]` is now a set of `edge` records and `projects[]`
    a set of `project` records, so each reads the store instead of a mapping.
    """
    findings: list[Finding] = []

    # A task may serve at most one KR. **`error`, and not softened by the
    # move**: an ambiguous attribution is what `perry-goals link` refuses to
    # create and what `resolve_kr` cannot answer.
    seen: dict[str, str] = {}
    for rec in records:
        if not isinstance(rec, dict) or rec.get("kind") != "edge":
            continue
        task, kr = str(rec.get("task") or ""), str(rec.get("kr") or "")
        prev = seen.get(task)
        if prev and prev != kr:
            findings.append(Finding(
                "error", rel, "linkage-task-single-kr",
                f"task {task} is listed under both {prev} and {kr} — "
                "its attribution would be ambiguous"))
        seen[task] = kr

    # Objective agreement + name/alias uniqueness across projects.
    claimed: dict[str, str] = {}
    for rec in records:
        if not isinstance(rec, dict) or rec.get("kind") != "project":
            continue
        pid, serves = str(rec.get("id") or ""), str(rec.get("kr") or "")
        # **`objective` is derived from the KR id and checked against the
        # OBJECTIVE RECORDS**, where it used to be checked against a second
        # `objective:` field on the registry entry. `kind: project` stores no
        # such field — ADR-019 declined to carry a fact the id already
        # encodes — so the disagreement this rule reports is now between the
        # KR id a Project serves and the set of objectives its phase declares.
        # The old form could only be prefix-matched: `P002-O3-KR1` says which
        # phase, which objective and which KR, so there is nothing left to
        # infer from position. A `kr` still written `P-O3.1` [[old-form]] no
        # longer matches — and does not slip past unmentioned:
        # `check_cross_file § kr-id-legacy-form` reads every `phase/*.md` and
        # errors on it by name.
        m = re.match(r"^P\d{3}-(O\d+)-KR\d+$", serves)
        objectives = {str(r.get("id") or "") for r in records
                      if isinstance(r, dict) and r.get("kind") == "objective"}
        if m and objectives and m.group(1) not in objectives:
            findings.append(Finding(
                "error", rel, "linkage-objective-agrees",
                f"{pid}: serves {serves} (which is {m.group(1)}) but this "
                f"phase declares no objective {m.group(1)}"))
        for label in [rec.get("name"), *(rec.get("aliases") or [])]:
            key2 = str(label or "").strip().lower()
            if not key2:
                continue
            if key2 in claimed and claimed[key2] != pid:
                findings.append(Finding(
                    "error", rel, "linkage-names-unique",
                    f"name/alias {label!r} is claimed by both {claimed[key2]} and {pid} — "
                    "attribution cannot resolve it to one KR"))
            claimed[key2] = pid
    return findings


def check_linkage_store(project_root: Path, state_root: Path,
                       schema: dict) -> list["Finding"]:
    """`linkage.jsonl` — TASK-276, DESIGN-015 row A, ADR-019.

    **THE DRIFT COMPARISON IS GONE, AND THAT IS THE POINT OF ADR-019.** This
    function used to hold `linkage.jsonl` up against `phase/<NNN>-linkage.md`
    and report where the two disagreed, exactly as the other six registers are
    held against their markdown. It found something, too — `linkage store: 124
    record(s), 1 row(s) drifted` on `P003-O3-KR2`, this project's own computed
    KR, on the day the ADR was written. ADR-019's argument is that a check for
    a disagreement is the ongoing cost of the duplication rather than a fix
    for it, so the document was deleted and the class of defect became
    impossible instead of detected. There is one copy; there is nothing to
    compare it to.

    What remains is the half that was never about a second file: every record
    is validated against the shapes `schema/state-schema.json §
    stores.declared` declares, so a record of the wrong shape is a finding
    rather than a silent row.

    **`unchecked`, not `clean`, still governs the census line.** `P003-O1-KR3`
    is the phase-003 operating rule that a store reports `unchecked` when its
    file is absent, measured for the other six by TASK-229. An absent store
    returns before reading anything and the line says so.
    """
    findings: list[Finding] = []
    check_linkage_store.stats = _empty_linkage_store_stats()

    declared = ((schema.get("stores") or {}).get("declared")
                or {}).get(_JSONL_STORE_KEY)
    if not declared:
        return []

    store_path = state_root / _JSONL_STORE_KEY
    if not store_path.exists():
        return []

    check_linkage_store.stats["store_present"] = True
    rel_store = _rel(store_path, project_root)
    try:
        on_disk = [json.loads(line) for line in
                   store_path.read_text(errors="replace").split("\n")
                   if line.strip()]
    except (OSError, ValueError) as exc:
        return [Finding("warn", rel_store, "linkage-store-unreadable",
                        f"`{_JSONL_STORE_KEY}` is not readable as JSONL "
                        f"({type(exc).__name__}: {exc}) — there is nothing "
                        f"here to check")]

    good, issues = _linkage_record_findings(on_disk, declared,
                                            schema.get("enums"))
    check_linkage_store.stats["records"] = len(good)
    check_linkage_store.stats["malformed"] = len(issues)
    for issue in issues[:DRIFT_ROWS_SHOWN]:
        findings.append(Finding(
            "warn", rel_store, "linkage-store-malformed",
            f"line {issue['line']}: {issue['message']}. The record shapes are "
            f"declared in `schema/state-schema.json § stores.declared` "
            f"(DESIGN-015 § 5.1, extended by ADR-019)."))
    if len(issues) > DRIFT_ROWS_SHOWN:
        findings.append(Finding(
            "warn", rel_store, "linkage-store-malformed",
            f"and {len(issues) - DRIFT_ROWS_SHOWN} further record(s) do not "
            f"match a declared shape."))

    # **Per phase, because both rules are per phase.** One task may serve one
    # KR *in a phase*, and a Project name is unique *within the registry it is
    # in*; grading the whole store at once would report a `REL-001` linked in
    # phase 001 and again in 002 as an ambiguity, which is two phases doing
    # their job. Only the valid records are graded: a malformed record has
    # been reported once by name and line, and grading it again would report
    # one defect twice in two vocabularies.
    phases = sorted({str(r.get("phase") or "") for r in good
                     if r.get("kind") in ("objective", "kr") and r.get("phase")})
    for slug in phases:
        number = P.linkage_phase_number(slug)
        mine = P.linkage_records_for_phase(good, number) if number else None
        if mine:
            findings.extend(_linkage_graph_findings(mine, rel_store))
    return findings


def check_claims(project_root: Path, schema: dict, state_root: Path) -> tuple[list, dict]:
    """What Perry would occupy here, and what is already there.

    `claims[]` is the one authoritative list — `files[]` describes the files
    Perry VALIDATES, this describes the territory Perry OCCUPIES, and the two
    are different units. Perry writes `journal/<YYYY-MM>/<YYYY-MM-DD>.md`, but
    the thing that collides with a user's folder is `journal/`, and no prefix
    of that glob is the claim.

    A directory already holding genuine Perry state is a RE-ADOPTION, not a
    collision. Only a parse can tell the two apart, so this reuses the same
    heading check the default mode runs rather than a second heuristic.

    **Two callers, one computation.** `--claims` renders these rows, and the
    default pass turns the `collision` ones into `NS-01`. DESIGN-002 exists to
    close a defect that was two lists disagreeing; shipping a second collision
    check next to this one would reintroduce it one level down. So each row also
    carries `rel` (the claimed path as the project sees it) and `foreign` (the
    offending files, which `NS-01` cites as evidence) — machine fields that
    `--claims` projects away, since its payload is a contract with the setup and
    adopt flows.
    """
    claims = schema.get("claims") or []
    rows, collisions = [], 0
    for c in claims:
        base = project_root if c["anchor"] == "project" else state_root
        target = base / c["path"].rstrip("/")
        rel = _rel(target, project_root)
        if not target.exists():
            rows.append({"path": c["path"], "state": "free", "owner": c["owner"],
                         "detail": None, "rel": rel, "foreign": []})
            continue
        # Perry-shaped? Anything we would have written is not a collision.
        if c["kind"] == "dir":
            present = [f for f in sorted(target.rglob("*.md"))]
        else:
            present = [target]
        foreign = [f for f in present if not looks_like_perry_state(f, schema, c)]
        if not present:
            rows.append({"path": c["path"], "state": "free", "owner": c["owner"],
                         "detail": "exists but empty", "rel": rel, "foreign": []})
        elif foreign:
            collisions += 1
            rows.append({"path": c["path"], "state": "collision", "owner": c["owner"],
                         "detail": f"{len(foreign)} file(s) Perry did not write, "
                                   f"e.g. {foreign[0].relative_to(project_root)}",
                         "rel": rel,
                         "foreign": [_rel(f, project_root) for f in foreign]})
        else:
            rows.append({"path": c["path"], "state": "perry", "owner": c["owner"],
                         "detail": f"{len(present)} existing Perry file(s)",
                         "rel": rel, "foreign": []})
    return rows, {"claimed": len(claims), "collisions": collisions}


# The keys `--claims` has always published, in the order it published them.
# `check_claims` rows carry two more for the default pass's `NS-01` evidence;
# they are projected out at the `--json` boundary so `--claims` stays
# byte-identical (TASK-086 deliverable 5). Named here rather than spelled inline
# so the projection is a declaration a reader can check, not a literal to skim.
CLAIM_ROW_KEYS = ("path", "state", "owner", "detail")


def check_ns_collisions(project_root: Path, state_root: Path,
                        schema: dict) -> list["Finding"]:
    """`NS-01` — a path Perry claims now holds files Perry did not write.

    DESIGN-002 decision #4, locked 2026-08-16: *lint warns, and names it a
    collision*. The state root is chosen once, at setup; this is the **after**.
    A project adopted at `.` that later grows its own `design/proposal.md` used
    to get that file reported as MALFORMED PERRY STATE — the user's own document
    called broken, which is exactly what `State root:` exists to prevent,
    arriving by a route it does not reach. Reporting it as a collision instead
    is the whole of the fix; nothing here moves a file or changes a verdict on
    one.

    **`warn`, never `error`.** Decision #2 was taken strictly — there is no
    per-path opt-out — so a user may knowingly keep one file in a claimed folder
    and has no way to silence this. A permanent red for a deliberate choice is
    how a check trains its user to skip it. See `main()` for the matching
    `--strict` carve-out, which is the same commitment at the exit code.

    **Gated on adoption, unlike `--claims`.** `--claims` answers *where should
    the state root go* and must run before adoption; this answers *what has
    encroached on the one I already have*, which is not a question a folder Perry
    has never touched can be asked. `main()` calls it inside the `adopted`
    branch for that reason.
    """
    rows, _ = check_claims(project_root, schema, state_root)
    findings: list[Finding] = []
    for r in rows:
        if r["state"] != "collision":
            continue
        # Evidence is capped the way `bin/perry-diagnose` caps it: a directory
        # someone else owns can hold hundreds of files, and a finding that
        # prints all of them is a finding nobody reads.
        shown = r["foreign"][:10]
        more = len(r["foreign"]) - len(shown)
        evidence = ", ".join(shown) + (f", +{more} more" if more else "")
        findings.append(Finding(
            "warn", r["rel"], "NS-01",
            f"`{r['path']}` holds {len(r['foreign'])} file(s) Perry did not "
            f"write. Perry will read them as its own state and report them as "
            f"broken, and the next lint run will say your file is malformed. It "
            f"is not — it is in a folder Perry claimed. Either move Perry's "
            f"state to its own root — `/perry relocate perry` — or move these "
            f"files out of `{r['path']}`. Both are reversible; the first is one "
            f"command. Evidence: {evidence}"))
    return findings


def looks_like_perry_state(path: Path, schema: dict, claim: dict) -> bool:
    """Would Perry have written this file?

    Deliberately generous: the cost of a false 'yes' is one collision Perry
    fails to warn about, while a false 'no' reports the user's own adopted
    state as foreign and pushes them to relocate a working project."""
    if path.name in ("README.md", "INDEX.md"):
        return True
    # The conformance record is Perry's own bookkeeping and deliberately not a
    # `files[]` entry (it records decisions ABOUT state, not state), so the loop
    # below cannot see it. Named from `parsers` rather than spelled out here —
    # one name, one definition.
    if path.name == Path(P.CONFORMANCE_FILE).name:
        return True
    # Perry's two JSONL artifacts — the store and the event log. Every rule
    # below reads a markdown document: a heading, a `files[]` name, an
    # `Owner**:` line. A `.jsonl` file has none of them, so without this the
    # file Perry rewrites on EVERY mutating command is reported as foreign
    # against Perry's own claim, on every Perry project there is. What
    # identifies it is the record, not the name.
    #
    # **An EMPTY file at a claim anchored in `.perry/` is Perry's** (TASK-270).
    # `looks_like_perry_record` reads the first record and an empty file has
    # none, so `perry-config unset` of the last setting — a write Perry made —
    # was reported as a file Perry did not write, with advice to relocate.
    # The anchor is what makes this safe rather than a name match: `.perry/`
    # is the directory Perry creates to hold its pointer, and the file claims
    # anchored there (`.perry/config.jsonl`, `.perry/events.jsonl`) are
    # Perry's by construction. An empty file there holds nothing a user could
    # lose and nothing Perry could misread as broken —
    # `parsers.config_store_unusable` answers usable for it.
    #
    # **So is an EMPTY file at a declared canonical store** (TASK-275).
    # `intake-sweep` empties `intake.jsonl` when it discharges the last row,
    # and the next lint run called Perry's own store foreign beside its own
    # census line `intake store: 0 record(s)`. The criterion is
    # `parsers.canonical_store_names` — the one reading of `claims[]` that
    # `installed` also asks — not a list here, so a store claimed later is
    # covered with no edit. An empty file carries no record that could be
    # misread as Perry's, so this excuses nothing foreign. A NON-empty file at
    # the same path is still judged by its first record, exactly as before.
    if path.suffix == ".jsonl":
        if _holds_no_record(path) and (
                claim.get("anchor") == "project"
                or claim.get("path") in P.canonical_store_names()):
            return True
        return looks_like_perry_record(path, schema)
    stem = path.stem
    # Perry names its own artifacts: DESIGN-001-…, ADR-002-…, 001-slug, dates.
    if lib.perry_named_artifact(stem) or re.match(r"^\d{3}-", stem):
        return True
    if re.match(r"^\d{4}-\d{2}(-\d{2})?$", stem) or re.match(r"^\d{4}-W?\d{2}$", stem):
        return True
    for spec in schema["files"]:
        if Path(spec["path"]).name == path.name:
            return True
    try:
        head = path.read_text(encoding="utf-8", errors="replace")[:2000]
    except OSError:
        return False
    return "Owner**: `perry`" in head or "$PERRY_HOME" in head


#: An event as `bin/perry-task § log_event` appends it. `ts` and `event` are on
#: every line it has ever written; `id` is not, since a lane event carries none.
_EVENT_FIELDS = ("ts", "event")


def _matches_a_declared_store(rec: dict, schema: dict) -> bool:
    """Does this record match a shape `schema § stores.declared` declares?

    **The fifth shape, and the last one written out by hand.** Four times now
    a new store has been added and `looks_like_perry_record` has had to be
    taught its field tuple — tasks, risks, intake, asks — and the comments on
    those four say what happens when it is not: Perry reports its own store as
    a file Perry did not write, against Perry's own claim, on every project
    that runs the import. TASK-277 is the fifth and hit exactly that: the
    import landed and the very next `perry-lint` run raised `NS-01` on
    `perry/linkage.jsonl`, advising the user to `/perry relocate` away from
    Perry's own store.

    So this one is not a fifth tuple. `stores.declared` already carries the
    record shapes — that is what row A of DESIGN-015 declared and what
    `_linkage_record_findings` validates against — and this reads them from
    there, keyed on the store's own declared `discriminator`. A store declared
    that way in future is recognised here with no edit at all, which is the
    difference between a declaration and a decoration.

    Shape, never name: the docstring below carries the reason, and it holds
    here. A project's own `linkage.jsonl` full of something else is still the
    collision the claim exists to report.
    """
    keys = set(rec)
    for declared in ((schema.get("stores") or {}).get("declared")
                     or {}).values():
        if not isinstance(declared, dict):
            continue
        kinds = declared.get("records") or {}
        disc = declared.get("discriminator")
        if not disc or not kinds:
            continue
        shape = kinds.get(rec.get(disc))
        if isinstance(shape, dict) and keys <= set(shape.get("fields") or {}):
            return True
    return False


def _holds_no_record(path: Path) -> bool:
    """True when `path` reads and has no non-blank line — the file
    `perry_md_store.load_store` parses to `[]`. An unreadable file is not
    empty; it is unknown, and stays with `looks_like_perry_record`."""
    try:
        return not path.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return False


def looks_like_perry_record(path: Path, schema: dict | None = None) -> bool:
    """Is this JSONL the store or the event log Perry itself wrote?

    Read from the first record rather than the filename. A project that happens
    to own a `tasks.jsonl` is exactly the collision the claim exists to report,
    so matching on the name would make the claim self-defeating: every file
    sitting at the claimed path would be excused, including the user's.

    The store's vocabulary is `perry_store.STORED` — the same tuple
    `check_store_drift` reads, not a second copy — and a store record is a JSON
    object with an `id` and no field outside it. An event is `{ts, event, …}`.
    A project's own JSONL is neither, and is reported.

    Generous in the same direction as the rules above: an unreadable or
    unparseable file is not claimed as Perry's, because a file Perry wrote
    parses.
    """
    try:
        with path.open(encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                rec = json.loads(line)
                break
            else:
                return False        # an empty file tells us nothing
    except (OSError, json.JSONDecodeError):
        return False
    if not isinstance(rec, dict):
        return False
    keys = set(rec)
    if "id" in keys and (keys <= set(_STORED_FIELDS)
                         or keys <= set(_RISK_STORED_FIELDS)
                         or keys <= set(_ASK_STORED_FIELDS)
                         or keys <= set(_CADENCE_STORED_FIELDS)):
        return True                 # a store — tasks, risks, asks or cadence
    # `intake.jsonl` keys on `order` and carries no `id` at all: the register
    # has no id column and a row is addressed by position (TASK-196). The
    # branch above cannot see it, and `order` alone is too weak a signal, so
    # the whole key set is matched against the tuple.
    if "order" in keys and "request" in keys \
            and keys <= set(_INTAKE_STORED_FIELDS):
        return True                 # a store — intake
    # `okr.jsonl` and `.perry/config.jsonl` key on `kind`, not on `id`: a
    # `setting` record carries `key` and a `track` record carries `track`, so
    # the branch above cannot see them. Same rule, read off the same tuple.
    kind = rec.get("kind")
    if isinstance(kind, str) and kind in _MD_STORE.STORED:
        if keys <= set(_MD_STORE.STORED[kind]):
            return True             # a store — okr or config
    # Any store whose record shapes `schema § stores.declared` declares —
    # `linkage.jsonl` today, and whatever is declared there tomorrow with no
    # edit here. See `_matches_a_declared_store`.
    if schema and _matches_a_declared_store(rec, schema):
        return True
    return keys.issuperset(_EVENT_FIELDS)


def render_claims(project_root: Path, state_root: Path, rows: list, summary: dict,
                  suggested: str | None) -> None:
    rel = state_root.relative_to(project_root).as_posix() or "."
    print(f"\n🚧 Namespace check · {project_root.name} · candidate state root: {rel}\n")
    print(f"   Claimed by Perry : {summary['claimed']} paths")
    print(f"   Already present  : {summary['collisions']} collision(s)\n")
    shown = [r for r in rows if r["state"] != "free"]
    if not shown:
        print("   ✓ nothing Perry claims is taken — the project root is safe")
    for r in shown:
        mark = "✗" if r["state"] == "collision" else "·"
        print(f"   {mark} {r['path']:<18} {r['detail']}")
    if suggested:
        print(f"\n   Suggested state root: {suggested}   (0 collisions)")
    print()


def main(argv: list[str]) -> int:
    root_arg = None
    mode_templates = mode_claims = mode_verification = False
    mode_provenance = mode_knowledge = mode_reviews = False
    mode_glossary = mode_specs = mode_summaries = False
    as_json = strict = quiet = False
    state_root_arg = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        elif a == "--root":
            i += 1
            if i >= len(argv):
                # **Refused, not dropped.** This read `argv[i] if i < len(argv)
                # else None`, so `--root` with its value missing became no
                # `--root` at all and the tool linted the CURRENT DIRECTORY.
                # `bin/README.md § --quiet` says that mode is read by its exit
                # code alone, and `§ Lint after every tier-1 write` makes this a
                # gate — so `perry-lint --quiet --root` exited 0 with empty
                # stdout and empty stderr about a project the caller never
                # named. Measured by a V4 round with a clean cwd and a dirty
                # named project: exit 1 with the value, exit 0 without it.
                print("perry-lint: --root takes a value", file=sys.stderr)
                return 2
            # A value that is present but EMPTY is the same gate failing the
            # same way: `--quiet --root ""` exited 0 about the cwd's project
            # while the named one went unlinted. The rule and its sentence
            # live in `lib.empty_root_error`.
            bad = lib.empty_root_error(a, argv[i])
            if bad is not None:
                print(f"perry-lint: {bad}", file=sys.stderr)
                return 2
            root_arg = argv[i]
        elif a == "--templates":
            mode_templates = True
        elif a == "--claims":
            mode_claims = True
        elif a == "--verification":
            mode_verification = True
        elif a == "--provenance":
            mode_provenance = True
        elif a == "--knowledge":
            mode_knowledge = True
        elif a == "--reviews":
            mode_reviews = True
        elif a == "--glossary":
            mode_glossary = True
        elif a == "--specs":
            mode_specs = True
        elif a == "--summaries":
            mode_summaries = True
        elif a == "--state-root":
            i += 1
            if i >= len(argv):
                print("perry-lint: --state-root takes a value", file=sys.stderr)
                return 2
            state_root_arg = argv[i]
        elif a == "--json":
            as_json = True
        elif a == "--strict":
            strict = True
        elif a == "--quiet":
            quiet = True
        else:
            print(f"perry-lint: unknown argument {a!r} (try --help)", file=sys.stderr)
            return 2
        i += 1

    if not SCHEMA_PATH.exists():
        print(f"perry-lint: schema not found at {SCHEMA_PATH}", file=sys.stderr)
        return 2
    schema = json.loads(SCHEMA_PATH.read_text())
    enums = schema["enums"]
    SCHEMA_THRESHOLDS.update(schema.get("thresholds") or {})
    TASK_STATUSES.update((schema.get("enums") or {}).get("task_status") or ())

    if mode_claims:
        project_root = (Path(root_arg).expanduser().resolve() if root_arg
                        else Path.cwd().resolve())
        if state_root_arg:
            state_root = (project_root / state_root_arg).resolve()
        else:
            state_root = P.resolve_state_root(project_root)
        rows, summary = check_claims(project_root, schema, state_root)

        # Only propose an alternative when the current candidate actually
        # collides — a clean root must cost the user zero questions.
        suggested = None
        if summary["collisions"] and not state_root_arg:
            for candidate in ("perry", "_perry", ".perry-state"):
                alt = (project_root / candidate).resolve()
                _, alt_sum = check_claims(project_root, schema, alt)
                if not alt_sum["collisions"]:
                    suggested = f"{candidate}/"
                    break
        if as_json:
            print(json.dumps({
                "project_root": str(project_root),
                "state_root": state_root.relative_to(project_root).as_posix() or ".",
                "claimed": summary["claimed"],
                "collisions": summary["collisions"],
                "suggested_state_root": suggested,
                "paths": [{k: r[k] for k in CLAIM_ROW_KEYS} for r in rows],
            }, ensure_ascii=False, indent=2))
        elif not quiet:
            render_claims(project_root, state_root, rows, summary, suggested)
        # A collision is a fact to act on, not a failure — and `--strict` does
        # NOT promote it. There is no per-path opt-out by design (DESIGN-002
        # decision #2), so a project that knowingly keeps one file in a claimed
        # folder would otherwise have permanently red CI with no way to accept
        # it. Same reasoning that keeps NS-01 at `warn`. Branch on the
        # `collisions` count in --json instead.
        return 0

    if mode_verification:
        project_root = (Path(root_arg).expanduser().resolve() if root_arg
                        else Path.cwd().resolve())
        state_root = ((project_root / state_root_arg).resolve() if state_root_arg
                      else P.resolve_state_root(project_root))
        findings = check_verification(state_root, project_root / ".perry")
        scanned = getattr(check_verification, "rows_seen", 0)
        if as_json:
            print(json.dumps({
                "project_root": str(project_root),
                "done_rows_scanned": scanned,
                "findings": [f.as_dict() for f in findings],
                "count": len(findings),
            }, ensure_ascii=False, indent=2))
        elif not quiet:
            print(f"perry-lint --verification · {project_root}")
            for f in findings:
                print(f)
            if findings:
                tail = f"\n  {len(findings)} advisory finding(s) over {scanned} done row(s)"
            elif scanned:
                tail = f"\n  ✓ all {scanned} done row(s) carry a satisfiable rung"
            else:
                # Not a pass. Perry's own board moves closed rows out of the
                # P-sections into `## Done this period`, so an empty scan is the
                # normal state there — say so rather than printing a checkmark
                # for having checked nothing.
                tail = ("\n  · no done rows under P0/P1/P2 to rate "
                        "(closed rows leave those sections at triage)")
            print(tail)
        # Advisory for one release by DESIGN-003 decision 4 — a hard gate now
        # would retroactively invalidate every `done` row written before rungs
        # existed. `--strict` does NOT promote these; branch on --json `count`.
        return 0


    if mode_summaries:
        project_root = (Path(root_arg).expanduser().resolve() if root_arg
                        else Path.cwd().resolve())
        state_root = ((project_root / state_root_arg).resolve() if state_root_arg
                      else P.resolve_state_root(project_root))
        findings = check_summaries(state_root)
        st = getattr(check_summaries, "stats", {})
        if as_json:
            print(json.dumps({
                "project_root": str(project_root),
                "summaries": dict(st),
                "findings": [f.as_dict() for f in findings],
                "count": len(findings),
            }, ensure_ascii=False, indent=2))
        elif not quiet:
            print(f"perry-lint --summaries · {project_root}")
            # Uncapped here — this is the mode you type when you want the list.
            for f in findings:
                print(f)
            if not st.get("store_present"):
                print("\n  · no `tasks.jsonl` — summaries are unchecked, "
                      "not clean")
            elif not st.get("open_rows"):
                print("\n  · no open rows to check")
            else:
                print(f"\n  {st['carrying']} of {st['open_rows']} open row(s) "
                      f"carry a summary · {st['blank']} blank · "
                      f"{st['shape_findings']} shape finding(s) on rows that "
                      f"do carry one")
        # Advisory, like `--verification` and `--specs`, and for the same
        # reason: the field was optional until today and a hard gate here
        # would redden every existing project's CI over history it cannot
        # change. The hard half is `perry-task add`, which refuses.
        return 0

    if mode_glossary:
        project_root = (Path(root_arg).expanduser().resolve() if root_arg
                        else Path.cwd().resolve())
        findings = check_glossary(project_root)
        n = getattr(check_glossary, "entries", 0)
        po = getattr(check_glossary, "prose_only", 0)
        if as_json:
            print(json.dumps({
                "project_root": str(project_root), "entries": n,
                "prose_only": po,
                "findings": [f.as_dict() for f in findings],
                "count": len(findings),
            }, ensure_ascii=False, indent=2))
        elif not quiet:
            print(f"perry-lint --glossary \u00b7 {project_root}")
            for f in findings:
                print(f)
            print(f"\n  {n} term(s) \u00b7 {po} prose-only \u00b7 "
                  f"{len(findings)} advisory finding(s)")
        return 0

    if mode_reviews:
        project_root = (Path(root_arg).expanduser().resolve() if root_arg
                        else Path.cwd().resolve())
        state_root = ((project_root / state_root_arg).resolve() if state_root_arg
                      else P.resolve_state_root(project_root))
        load_glossary(schema)
        findings = check_reviews(state_root, project_root)
        blocks = getattr(check_reviews, "blocks_seen", 0)
        if as_json:
            print(json.dumps({
                "project_root": str(project_root),
                "verdict_blocks": blocks,
                "findings": [f.as_dict() for f in findings],
                "count": len(findings),
            }, ensure_ascii=False, indent=2))
        elif not quiet:
            print(f"perry-lint --reviews \u00b7 {project_root}")
            for f in findings:
                print(f)
            # The block count prints at zero findings, for the reason
            # `--knowledge` prints its card count: "0 violations" over 0
            # verdicts is trivially true, and a number that cannot tell "the
            # convention holds" from "nobody has written one" is not a
            # measurement.
            print(f"\n  {blocks} verdict block(s) \u00b7 {len(findings)} "
                  f"advisory finding(s)" if findings else
                  f"\n  \u2713 {blocks} verdict block(s), every one readable "
                  f"and acted on" if blocks else
                  "\n  \u00b7 no verdict blocks yet \u2014 see "
                  "work/reference/review.md \u00a7 3")
        # `--reviews` stays advisory by DEFAULT for the reason its docstring
        # gives — a project predating the convention would be condemned
        # retroactively. `--strict` is opt-in and is what `review.md § 2` tells
        # the dispatcher to run: a red exhibit must be able to STOP a round,
        # or the pre-check is one more rule stated in prose that nothing
        # implements, which is the defect this whole page exists over.
        return 1 if (strict and findings) else 0

    if mode_knowledge:
        project_root = (Path(root_arg).expanduser().resolve() if root_arg
                        else Path.cwd().resolve())
        state_root = ((project_root / state_root_arg).resolve() if state_root_arg
                      else P.resolve_state_root(project_root))
        load_glossary(schema)
        findings = check_knowledge(state_root, project_root) + check_role_cards(
            project_root, schema)
        kdir = state_root / "knowledge"
        cards = sum(1 for md in (kdir.rglob("*.md") if kdir.exists() else [])
                    if md.name != "INDEX.md"
                    and card_kind(strip_comments(md.read_text(errors="replace"))))
        if as_json:
            print(json.dumps({
                "project_root": str(project_root),
                "cards": cards,
                "findings": [f.as_dict() for f in findings],
                "count": len(findings),
            }, ensure_ascii=False, indent=2))
        elif not quiet:
            print(f"perry-lint --knowledge · {project_root}")
            for f in findings:
                print(f)
            # **The count is printed even at zero findings.** `KR-O5.1` reads
            # "0 violations", and zero over zero cards is trivially true — a
            # number that cannot tell "provenance is enforced" from "nobody has
            # written a card". Printing both is what makes the KR mean
            # something.
            print(f"\n  {cards} card(s) · {len(findings)} advisory finding(s)"
                  if findings else
                  f"\n  ✓ {cards} card(s), every provenance field present and "
                  f"resolving" if cards else
                  "\n  · no knowledge cards yet — the check is live and has "
                  "nothing to judge")
        return 0

    if mode_provenance:
        project_root = (Path(root_arg).expanduser().resolve() if root_arg
                        else Path.cwd().resolve())
        state_root = ((project_root / state_root_arg).resolve() if state_root_arg
                      else P.resolve_state_root(project_root))
        # Arms `CARD_KINDS`, without which `card_kind()` is always None and
        # every knowledge card is reported here as a digest with no id.
        load_glossary(schema)
        findings = check_provenance(state_root)
        stats = getattr(check_provenance, "stats", {"defined": 0, "cited": 0})
        if as_json:
            print(json.dumps({
                "project_root": str(project_root),
                "sources_defined": stats["defined"],
                "ids_cited": stats["cited"],
                "findings": [f.as_dict() for f in findings],
                "count": len(findings),
            }, ensure_ascii=False, indent=2))
        elif not quiet:
            print(f"perry-lint --provenance · {project_root}")
            for f in findings:
                print(f)
            if findings:
                print(f"\n  {len(findings)} advisory finding(s)")
            elif stats["defined"] or stats["cited"]:
                print(f"\n  ✓ {stats['cited']} cited id(s) all resolve; "
                      f"{stats['defined']} source(s) carry an origin and a date")
            else:
                # Same discipline as --verification: an empty scan is not a pass.
                print("\n  · no digests under knowledge/ and no citations to check")
        return 0

    if mode_specs:
        project_root = (Path(root_arg).expanduser().resolve() if root_arg
                        else Path.cwd().resolve())
        state_root = ((project_root / state_root_arg).resolve() if state_root_arg
                      else P.resolve_state_root(project_root))
        # `load_glossary(schema)` is deliberately NOT called here, and the
        # first draft of this branch called it with a comment claiming it
        # "arms `alias("headings", …)`". It does not. `load_glossary` fills
        # THIS module's `HEADING_ALIASES`; `P.alias` reads
        # `parsers._i18n()`, which loads `schema/state-schema.json` itself and
        # caches per name. Nothing in this branch reads a `perry-lint` alias
        # table. The localized behaviour was right either way — `## 交付物`
        # scans and refuses, and a census that never called `load_glossary`
        # returned the identical 45 — but a call kept alive by a false reason
        # is a fact this file asserts and cannot back, which is the defect
        # ADR-007 rule 3 names. Localization here comes from the gate, and
        # that is the property worth keeping true: one answer to "which
        # spellings count", owned by the reader that does the matching.
        findings = check_specs(state_root, project_root)
        stats = getattr(check_specs, "stats",
                        {"specs": 0, "unscannable": 0, "unbounded": 0})
        if as_json:
            print(json.dumps({
                "project_root": str(project_root),
                "specs_scanned": stats["specs"],
                "unscannable": stats["unscannable"],
                # Carried beside `unscannable` and not folded into it: they are
                # two different rules over the same file set, and a caller that
                # wants "how many specs cannot bound a round" must not have to
                # subtract one from the other. TASK-308.
                "unbounded": stats["unbounded"],
                "findings": [f.as_dict() for f in findings],
                "count": len(findings),
            }, ensure_ascii=False, indent=2))
        elif not quiet:
            print(f"perry-lint --specs · {project_root}")
            # Named one by one up to the same cap `store-drift` uses, and for
            # the same reason: 45 identical warnings is a check people learn
            # to scroll past. `--json` still carries every one, because "every
            # member of the set is reported" is the acceptance here.
            for f in findings[:DRIFT_ROWS_SHOWN]:
                print(f)
            if len(findings) > DRIFT_ROWS_SHOWN:
                print(f"  · … and {len(findings) - DRIFT_ROWS_SHOWN} more "
                      f"(--json names every one)")
            # Each rule reports its OWN count. Folding them into one
            # `if findings:` line would print "0 of 146 declare no scope"
            # whenever the only findings were unbounded ones —
            # a true sentence attached to the wrong measurement. TASK-308.
            if stats["unscannable"]:
                print(f"\n  {stats['unscannable']} of {stats['specs']} spec(s) "
                      f"declare no scope for `dispatch.md` step 4.2 to read — "
                      f"nobody can say those rows were screened")
            elif stats["specs"]:
                print(f"\n  ✓ all {stats['specs']} spec(s) declare a scope "
                      f"`dispatch.md` step 4.2 can read")
            if stats["specs"] and stats["unbounded"]:
                print(f"  {stats['unbounded']} of {stats['specs']} spec(s) "
                      f"carry no `## Bound` — a round against those has no "
                      f"finite set to check and no last element "
                      f"(work/reference/review.md § 1)")
            elif stats["specs"]:
                print(f"  ✓ all {stats['specs']} spec(s) carry a `## Bound`")
            else:
                # The count prints at zero for the reason --knowledge prints
                # its card count: "0 unscannable" over 0 specs is trivially
                # true, and a number that cannot tell "the gate can see every
                # spec" from "there are no specs" is not a measurement.
                print("\n  · no `*-spec.md` under evidence/ — the check is "
                      "live and has nothing to judge")
        # `--strict` promotes, on the `--reviews` precedent and for the same
        # reason: the pre-flight this reports on is a SAFETY gate, so a
        # dispatcher must be able to make "the gate could not see the spec"
        # stop the round rather than cost one.
        return 1 if (strict and findings) else 0

    # Localized column headers are legal in whatever the project's document
    # language is; the glossary that says which spellings count lives in the
    # schema so every reader (this linter, viewer/parsers.py, aiMark) agrees.
    # Loaded HERE and not above the early-returning modes on purpose: that is
    # where it has always been loaded, and moving it would quietly change what
    # `--verification` matches on a localized board.
    load_glossary(schema)

    findings: list[Finding] = []
    check_store_drift.stats = _empty_store_drift_stats()
    check_risk_store_drift.stats = _empty_risk_store_drift_stats()
    check_intake_store_drift.stats = _empty_intake_store_drift_stats()
    check_ask_store_drift.stats = _empty_ask_store_drift_stats()
    check_cadence_store_drift.stats = _empty_cadence_store_drift_stats()
    check_md_store_drift.stats = _empty_md_store_drift_stats_all()
    check_config_store.stats = _empty_config_store_stats()
    check_specs.stats = {"specs": 0, "unscannable": 0, "unbounded": 0,
                         "checked": False}

    if mode_templates:
        root = PERRY_HOME
        for spec in schema["files"]:
            tpl = spec.get("template")
            if not tpl:
                continue
            path = PERRY_HOME / tpl
            if not path.exists():
                findings.append(Finding("error", tpl, "missing-template",
                                        "schema names this template but the file is absent"))
                continue
            findings.extend(check_file(path, tpl, spec, enums, is_template=True))
        label = f"templates in {PERRY_HOME}"
    else:
        project_root = Path(root_arg).expanduser().resolve() if root_arg else Path.cwd().resolve()
        if not root_arg:
            # `parsers § installed_project_root` — the walk every tool takes
            # (TASK-237 3b′; `BOARD.md` / `OKR.md` no longer stop it).
            found = P.installed_project_root(project_root)
            if found is not None:
                project_root = found
        # State may live in a subdirectory when the project already uses a name
        # Perry claims; `.perry/` stays at the project root either way.
        root = P.resolve_state_root(project_root)
        adopted = is_adopted(project_root, root)
        for spec in schema["files"]:
            if spec.get("id") == "board":
                # **A held `BOARD.md` is retired, and is not linted** (TASK-262
                # Amendment (4), round 4b; `files[id=board].note`). Its cap,
                # headings and tables policed a file nothing writes and no
                # reader opens any more. The declaration stays for
                # `perry-tasks board`, which lays the board out from it, and
                # for `--templates` above, which still checks the template
                # against it. The file is named by `retired-board` below.
                continue
            base = project_root if spec.get("anchor") == "project" else root
            # Nothing outside `.perry/` can be malformed Perry state before the
            # project is a Perry project: a pre-existing `design/` belongs to
            # whoever built it, and reporting their file as a broken design doc
            # is Perry claiming a namespace it was never given.
            if not adopted and spec.get("anchor") != "project":
                continue
            targets = iter_targets(base, spec)
            if not targets:
                # "required" means required OF A PERRY PROJECT. On a folder that
                # has never been adopted it is not a finding, it is the answer.
                if spec.get("required") and adopted:
                    findings.append(Finding("error", spec["path"], "missing-file",
                                            "required state file not found"))
                continue
            for path in targets:
                # Same rule `perry-conform § state_files` applies, so a file
                # lint validates and a file that can be declared conformant
                # cannot come apart. One function, two call sites, no copy.
                if not spec_claims(spec, strip_comments(
                        path.read_text(errors="replace")), schema):
                    continue
                try:
                    rel = path.relative_to(project_root).as_posix()
                except ValueError:
                    rel = path.as_posix()
                findings.extend(check_file(path, rel, spec, enums,
                                           is_template=False,
                                           root_flag=lib.root_flag(project_root)))
        if adopted:
            # **The retired board, named** (TASK-262 Amendment (4), round 4b).
            # One `warn` per held `BOARD.md` at the state root or the project
            # root, in `lib.retired_board_hint`'s one wording. A warning, never
            # an error, so the exit code is unchanged without `--strict`. It is
            # NOT carved out of `--strict` the way `NS-01` is: `NS-01` has no
            # way out a user can take, and this one names the way out — import,
            # then `git rm` — so the one-rule-wide carve-out stays one rule.
            # Existence only: `held_board_paths` opens nothing.
            for held in lib.held_board_paths(project_root, root):
                findings.append(Finding(
                    "warn", _rel(held, project_root), "retired-board",
                    lib.retired_board_hint(held)))
            findings.extend(check_cross_file(root, enums, project_root))
            # DESIGN-002 decision #4: the collision the state root cannot cover
            # is the one that appears AFTER setup, so the check has to run on
            # every ordinary lint rather than only behind `--claims`. Same
            # computation as `--claims`, not a second one.
            findings.extend(check_ns_collisions(project_root, root, schema))
            # Costs nothing on a project with no store — it returns before
            # deriving anything — and that is every project today, which is
            # why it runs in the default pass rather than behind a flag.
            findings.extend(check_document_sizes(root))
            findings.extend(check_store_drift(project_root, root))
            # Same shape, same cost, one register over (TASK-040): it returns
            # before deriving anything when there is no `risks.jsonl`, which is
            # every project today.
            findings.extend(check_risk_store_drift(project_root, root))
            # And the third register (TASK-196), on the same terms: it
            # returns before deriving anything when there is no
            # `intake.jsonl`, which is every project today.
            findings.extend(check_intake_store_drift(project_root, root))
            # And the fourth register (TASK-197), on the same terms: it
            # returns before deriving anything when there is no `asks.jsonl`,
            # which is every project today.
            findings.extend(check_ask_store_drift(project_root, root))
            # And the cadence register (TASK-237 deliverable 3b), on the same
            # terms: it returns before deriving anything when there is no
            # `cadence.jsonl`.
            findings.extend(check_cadence_store_drift(project_root, root))
            # And the fifth and sixth (TASK-209), on the same terms and at the
            # same cost: they return before deriving anything when there is no
            # `okr.jsonl` / `.perry/config.jsonl`. These two are the reason the
            # census read two of six — the comparators existed and nothing
            # called them.
            for _doc, _label in _MD_STORE_DOCS:
                findings.extend(
                    check_md_store_drift(project_root, root, _doc))
            # The config store, on the same terms: it returns before reading
            # anything when there is no `.perry/config.jsonl`. It is checked
            # rather than compared — ADR-019 left it no projection to disagree
            # with — and it is in this list so that seven declared stores stay
            # seven census lines.
            findings.extend(check_config_store(project_root, root))
            # And the seventh (TASK-276, DESIGN-015 row A), on the same
            # terms and at the same cost: it returns before reading anything
            # when there is no `linkage.jsonl`. It is in the DEFAULT pass
            # rather than behind a flag for the reason the six above are — a
            # store the census does not print is a store nobody checked. It
            # reports no DRIFT, because ADR-019 left it no second copy to
            # drift from; what it reports is whether every record matches a
            # declared shape.
            findings.extend(
                check_linkage_store(project_root, root, schema))
            # **In the DEFAULT pass, not behind `--specs`.** A flag nobody
            # types is not a report: `--specs` shipped in round 1 and was
            # invoked from nothing — not `work/`, not `modes/`, not `tests/run`
            # — while every other mode of this linter is named by at least one
            # procedure. The condition it reports is a SAFETY gate reading a
            # spec it cannot see, so "somebody would have to know to ask" is
            # the wrong bar; `dispatch.md` step 4 is the per-spec reader and
            # this is the whole-tree one. Same cost argument as the drift
            # checks above: with no `evidence/` it returns before reading
            # anything, and it stays `warn` so a project carrying pre-rule
            # specs still lints green-with-warnings rather than newly broken.
            findings.extend(check_specs(root, project_root,
                                        cap=DRIFT_ROWS_SHOWN))
            # **In the DEFAULT pass, for the reason `check_specs` is** — "a
            # flag nobody types is not a report". TASK-325's whole measured
            # cause is that nothing ever ASKED for this field: it has existed
            # since contract 1.11, has two writers and three readers, and
            # reached 25 of 114 open rows because no procedure and no check
            # ever mentioned it. Putting the report behind `--summaries` only
            # would reproduce that exactly. Capped like the drift checks so 89
            # findings do not bury the other fifteen; `--summaries` and
            # `--json` both name every one.
            findings.extend(check_summaries(root)[:DRIFT_ROWS_SHOWN])
        label = str(project_root)
        if root != project_root:
            label += f" (state root: {root.relative_to(project_root).as_posix()}/)"
        if not adopted:
            label += " — not a Perry project yet"

    errors = [f for f in findings if f.severity == "error"]
    warns = [f for f in findings if f.severity == "warn"]

    if as_json:
        payload = {
            "target": label,
            "errors": len(errors), "warnings": len(warns),
            "findings": [f.as_dict() for f in findings],
        }
        if not mode_templates:
            payload["store_drift"] = dict(getattr(
                check_store_drift, "stats", _empty_store_drift_stats()))
            payload["risk_store_drift"] = dict(getattr(
                check_risk_store_drift, "stats",
                _empty_risk_store_drift_stats()))
            payload["intake_store_drift"] = dict(getattr(
                check_intake_store_drift, "stats",
                _empty_intake_store_drift_stats()))
            payload["ask_store_drift"] = dict(getattr(
                check_ask_store_drift, "stats",
                _empty_ask_store_drift_stats()))
            payload["cadence_store_drift"] = dict(getattr(
                check_cadence_store_drift, "stats",
                _empty_cadence_store_drift_stats()))
            _md = getattr(check_md_store_drift, "stats",
                          None) or _empty_md_store_drift_stats_all()
            for _doc, _label in _MD_STORE_DOCS:
                payload[f"{_doc.name}_store_drift"] = dict(
                    _md.get(_doc.name) or _empty_md_store_drift_stats())
            # **The key is `linkage_store`, not `linkage_store_drift`.** It
            # was renamed rather than kept with a `drifted: 0` inside it,
            # because a consumer reading `drifted` off a store with one copy
            # would be reading a number that cannot be non-zero and taking it
            # for a check that passed. `perry-lint/1.x` records the move.
            payload["linkage_store"] = dict(getattr(
                check_linkage_store, "stats",
                _empty_linkage_store_stats()))
            # **INCONSISTENT WITH THE BLOCK ABOVE, DELIBERATELY, AND FILED.**
            # `config_store_drift` keeps its name while `linkage_store` was
            # renamed, and both halves of ADR-019 argued the opposite case for
            # the same situation: a `drifted` that is now structurally 0 rather
            # than measured 0. The rename side says a consumer reads that as a
            # check that passed; the keep side says renaming makes every
            # existing reader report "no config store" on a project that has
            # one. Both are true and the disagreement was only visible at
            # merge. Resolved here by taking each half's own call in its own
            # area, because deciding it during a conflict resolution would
            # ship an unverified API change; see the board row for the
            # decision this defers.
            payload["config_store_drift"] = dict(getattr(
                check_config_store, "stats", _empty_config_store_stats()))
            # Carried in the default payload for the reason the drift stats
            # are: a caller reading this JSON to decide whether to dispatch
            # should not have to run a second command to learn that the gate
            # cannot see a third of the specs.
            payload["specs"] = dict(getattr(
                check_specs, "stats",
                {"specs": 0, "unscannable": 0, "unbounded": 0,
                 "checked": False}))
            # Carried for the reason the drift stats are: the human pass caps
            # the findings at ten, so the COUNT has to reach a caller that
            # wants to know how many rows a reader cannot identify.
            payload["summaries"] = dict(getattr(
                check_summaries, "stats",
                {"store_present": False, "open_rows": 0, "carrying": 0,
                 "blank": 0, "shape_findings": 0}))
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif not quiet:
        print(f"perry-lint · {label}")
        if not findings:
            print("  ✓ clean — every state file matches schema/state-schema.json")
        else:
            for f in errors + warns:
                print(f)
            print(f"\n  {len(errors)} error(s), {len(warns)} warning(s)")
        # **"no store" and "clean" printed byte-identically.** `stats` was
        # assigned three times and read nowhere — its sibling
        # `check_provenance.stats` is printed, which is what made the omission
        # look deliberate. A V4 round caught it. Two different answers must not
        # look the same, which is the same rule `perry-tasks verify` follows
        # when it returns rc 2 rather than 0 with no store.
        # **`task store`, not `store`** (TASK-267). This was the only one of
        # the seven census lines that did not name its own register: the other
        # six say risks / intake / ask / OKR / config / linkage store, and
        # this one said `store:` and `drift against the store`. It is also the
        # line a reader is most likely to be looking at. The wording is keyed
        # in `tests/test_store_drift.py § CENSUS_LINES`, which is what makes
        # renaming it a two-file edit rather than a silent one.
        # **No board file is read, so no drift** (TASK-237 deliverable 3c;
        # TASK-262 round 4b). The five board registers below compared a store
        # with the section a board file held. With no file they printed
        # "comparison incomplete — drift is unchecked, not clean", which is
        # false: there is nothing the store can disagree with. Since round 4b a
        # held `BOARD.md` is retired and read by no check, so every project
        # prints this line, and the retired file is named by its own warning.
        _board_absent = not mode_templates
        _no_board = ("no board file is read — nothing is projected from one, "
                     "so there is nothing to drift")
        _st = getattr(check_store_drift, "stats", None)
        if _st and not mode_templates:
            if not _st["store_present"]:
                print("  · no `tasks.jsonl` — drift against the tasks store "
                      "is unchecked, not clean")
            elif _board_absent:
                print(f"  · tasks store: {_st['records']} record(s); {_no_board}")
            elif not _st["log_present"]:
                # Named rather than folded into "comparison incomplete": the
                # user can DO something about a missing log, and a reason is
                # the difference between a diagnosis and a shrug. The route
                # out is named too — `perry-tasks verify` compares the six
                # rendered columns in the board-to-store direction and needs
                # no log, which is why it reports 0 mismatches on the same
                # tree this check reported 175 drifted rows on.
                print(f"  · tasks store: {_st['records']} record(s), but no "
                      f"`.perry/events.jsonl` — the board-to-store derivation "
                      f"reads the log, so drift is unchecked, not clean; "
                      f"`perry-tasks verify` compares the rendered columns "
                      f"without it")
            elif not _st["comparison_performed"]:
                print(f"  · tasks store: {_st['records']} valid record(s), "
                      "comparison incomplete — drift is unchecked, not clean")
            else:
                print(f"  · tasks store: {_st['records']} record(s), "
                      f"{_st['drifted']} row(s) drifted")
        # Printed on its own line rather than folded into the one above: "no
        # risks store" and "a clean risks store" are different answers, and so
        # are "no task store" and "no risks store".
        _rst = getattr(check_risk_store_drift, "stats", None)
        if _rst and not mode_templates:
            if not _rst["store_present"]:
                print("  · no `risks.jsonl` — drift against the risks store "
                      "is unchecked, not clean")
            elif _board_absent:
                print(f"  · risks store: {_rst['records']} record(s); {_no_board}")
            elif not _rst["comparison_performed"]:
                print(f"  · risks store: {_rst['records']} valid record(s), "
                      "comparison incomplete — drift is unchecked, not clean")
            else:
                print(f"  · risks store: {_rst['records']} record(s), "
                      f"{_rst['drifted']} risk(s) drifted")
        # Its own line for the reason the one above has its own line: "no
        # intake store" and "a clean intake store" are different answers.
        _ist = getattr(check_intake_store_drift, "stats", None)
        if _ist and not mode_templates:
            if not _ist["store_present"]:
                print("  · no `intake.jsonl` — drift against the intake store "
                      "is unchecked, not clean")
            elif _board_absent:
                print(f"  · intake store: {_ist['records']} record(s); {_no_board}")
            elif not _ist["comparison_performed"]:
                print(f"  · intake store: {_ist['records']} valid record(s), "
                      "comparison incomplete — drift is unchecked, not clean")
            else:
                print(f"  · intake store: {_ist['records']} record(s), "
                      f"{_ist['drifted']} row(s) drifted")
        # Its own line for the reason the two above have their own lines: "no
        # ask store" and "a clean ask store" are different answers.
        _ast = getattr(check_ask_store_drift, "stats", None)
        if _ast and not mode_templates:
            if not _ast["store_present"]:
                print("  · no `asks.jsonl` — drift against the ask store is "
                      "unchecked, not clean")
            elif _board_absent:
                print(f"  · ask store: {_ast['records']} record(s); {_no_board}")
            elif not _ast["comparison_performed"]:
                print(f"  · ask store: {_ast['records']} valid record(s), "
                      "comparison incomplete — drift is unchecked, not clean")
            else:
                print(f"  · ask store: {_ast['records']} record(s), "
                      f"{_ast['drifted']} ask(s) drifted")
        # And the cadence register's (TASK-237 deliverable 3b), for the same
        # reason: "no cadence store" and "a clean one" are different answers.
        _cst = getattr(check_cadence_store_drift, "stats", None)
        if _cst and not mode_templates:
            if not _cst["store_present"]:
                print("  · no `cadence.jsonl` — drift against the cadence store "
                      "is unchecked, not clean")
            elif _board_absent:
                print(f"  · cadence store: {_cst['records']} record(s); {_no_board}")
            elif not _cst["comparison_performed"]:
                print(f"  · cadence store: {_cst['records']} valid record(s), "
                      "comparison incomplete — drift is unchecked, not clean")
            else:
                print(f"  · cadence store: {_cst['records']} record(s), "
                      f"{_cst['drifted']} row(s) drifted")
        # And the fifth and sixth lines, for the same reason the four above
        # have their own: "no OKR store" and "a clean OKR store" are different
        # answers, and so are "no OKR store" and "no config store". Six
        # declared stores, six lines, every run — which is what TASK-209 is
        # for. Printed from the same `_MD_STORE_DOCS` the checks are driven
        # from, so a store cannot be checked and then not reported.
        _mst = getattr(check_md_store_drift, "stats", None)
        if _mst and not mode_templates:
            for _doc, _label in _MD_STORE_DOCS:
                _s = _mst.get(_doc.name)
                if not _s:
                    continue
                _rel_store = Path(_doc.rel_store).as_posix()
                if not _s["store_present"]:
                    print(f"  · no `{_rel_store}` — drift against the "
                          f"{_label} is unchecked, not clean")
                elif not _s["comparison_performed"]:
                    print(f"  · {_label}: {_s['records']} valid record(s), "
                          "comparison incomplete — drift is unchecked, "
                          "not clean")
                else:
                    print(f"  · {_label}: {_s['records']} record(s), "
                          f"{_s['drifted']} row(s) drifted")
        # The config store gets its own line rather than joining the loop
        # above, because it answers a different question: not "does the file
        # agree with the store" — there is no file — but "do these records
        # validate". Saying `0 row(s) drifted` about a register that cannot
        # drift would be the census reporting a check it did not run.
        _cs = getattr(check_config_store, "stats", None)
        if _cs and not mode_templates:
            if not _cs["store_present"]:
                print("  · no `.perry/config.jsonl` — this project declares no "
                      "settings and no tracks")
            elif not _cs["comparison_performed"]:
                print(f"  · config store: {_cs['records']} valid record(s), "
                      "and at least one that is not — every writer refuses "
                      "the store whole")
            elif not _cs["records"]:
                # Empty is usable (`parsers.config_store_unusable`), and it is
                # not the same news as "N record(s), all valid": every setting
                # is at its default and the one track is DESIGN-003's `main`.
                print("  · config store: empty — this project declares no "
                      "settings and no tracks, so every writer uses the "
                      "defaults (`perry-config set <label> <value>` or "
                      "`perry-config track <name>` declares one)")
            else:
                print(f"  · config store: {_cs['records']} record(s), all valid")

        # The seventh line, for the reason the six above have their own:
        # "no linkage store" and "a clean linkage store" are different
        # answers, and `P003-O1-KR3`'s rule is that the absent one must not
        # print as the clean one.
        #
        # **It does not say `drifted`, and no line of this census will again
        # for this store.** The six above compare a store against the markdown
        # it projects; ADR-019 deleted the markdown this one projected, so
        # there is one copy and `0 row(s) drifted` would be a verdict about
        # nothing. What is checkable is the shape of every record, and that is
        # what is printed.
        _lst = getattr(check_linkage_store, "stats", None)
        if _lst and not mode_templates:
            if not _lst["store_present"]:
                print(f"  · no `{_JSONL_STORE_KEY}` — the "
                      f"{_JSONL_STORE_LABEL} is unchecked, not clean")
            else:
                print(f"  · {_JSONL_STORE_LABEL}: {_lst['records']} "
                      f"record(s), {_lst['malformed']} malformed")
        # And a line for the dispatch pre-flight's own input, on the same rule
        # the six above follow: "no specs" and "every spec declares a scope"
        # are different answers, and the second one is the only one that means
        # the dispatch pre-flight can see what it screens. Printed every run,
        # findings or none — a count that only appears when it is bad teaches
        # a reader that its absence means nothing was checked.
        _sst = getattr(check_specs, "stats", None)
        if _sst and not mode_templates:
            if not _sst.get("checked"):
                print("  · specs: not a Perry project yet — the dispatch "
                      "pre-flight's input is unchecked, not clean")
            elif not _sst["specs"]:
                print("  · no `*-spec.md` under evidence/ — the dispatch "
                      "pre-flight has nothing to read here")
            elif _sst["unscannable"]:
                print(f"  · specs: {_sst['unscannable']} of {_sst['specs']} "
                      f"declare no scope for `dispatch.md` step 4.2 to read — "
                      f"nobody can say those rows were screened "
                      f"(`perry-lint --specs --json` names every one)")
            else:
                print(f"  · specs: all {_sst['specs']} offer the escalation "
                      f"gate a section to scan")
            # The bound census, printed on the same rule and every run — for
            # TASK-308's reason: this number was 127 for the whole life of the
            # project and nothing ever said it out loud, so two rows reached V4
            # unbounded on the day the check was written. A count that only
            # appears when it is bad teaches a reader that its absence means
            # nothing was checked. Its own line, because "the gate can read
            # this spec" and "a round against this spec can end" are different
            # questions with different remedies.
            if _sst and not mode_templates and _sst.get("checked") \
                    and _sst["specs"]:
                if _sst["unbounded"]:
                    print(f"  · bounds: {_sst['unbounded']} of {_sst['specs']} "
                          f"spec(s) carry no `## Bound` — a round against "
                          f"those has no finite set to check and no last "
                          f"element (`perry-lint --specs --json` names every "
                          f"one)")
                else:
                    print(f"  · bounds: all {_sst['specs']} spec(s) carry a "
                          f"`## Bound`")
        # And a line for the summaries, on the same rule as the seven above:
        # the findings themselves are capped at ten, so without this the reader
        # of a board with 89 blank rows sees ten warnings and no total. Printed
        # every run, findings or none.
        _sum = getattr(check_summaries, "stats", None)
        if _sum and not mode_templates:
            if not _sum["store_present"]:
                print("  · no `tasks.jsonl` — summaries are unchecked, "
                      "not clean")
            elif not _sum["open_rows"]:
                print("  · no open rows — summaries unchecked, not clean")
            elif _sum["blank"] or _sum["shape_findings"]:
                print(f"  · summaries: {_sum['carrying']} of "
                      f"{_sum['open_rows']} open row(s) carry one · "
                      f"{_sum['blank']} blank · {_sum['shape_findings']} shape "
                      f"finding(s) (`perry-lint --summaries` names every one)")
            else:
                print(f"  · summaries: all {_sum['open_rows']} open row(s) "
                      f"carry one that is not just the title again")

    if errors:
        return 1
    # **`NS-01` is the one warning `--strict` does not promote.** DESIGN-002 § 9,
    # appended at lock on 2026-08-16: *"A collision never sets a non-zero exit."*
    # That sentence was written about `--claims`, and the same argument reaches
    # here unchanged, because it is an argument about the finding and not about
    # the mode: decision #2 was taken strictly, so there is no per-path opt-out,
    # and a user who has deliberately chosen to keep one file in a claimed folder
    # would otherwise have permanently red CI with no way to accept it. That is
    # the outcome DESIGN-002 rejects by name, in the same breath that it keeps
    # `NS-01` at `warn` — a severity that cannot be escaped by a flag is not
    # really `warn`.
    #
    # It does narrow what `--strict` means, from "every warning fails" to "every
    # warning except this one", so it is stated here rather than left to be
    # inferred, and `tests/test_ns_collision.py` pins BOTH directions: `NS-01`
    # alone exits 0 under `--strict`, and any other warning alongside it still
    # exits 1. The carve-out is one rule wide and stays that way.
    promotable = [f for f in warns if f.rule != "NS-01"]
    return 1 if (strict and promotable) else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as exc:
        print(f"perry-lint: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(2)
