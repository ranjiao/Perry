#!/usr/bin/env python3
"""
perry-lint — validate a Perry project's state files against schema/state-schema.json.

Perry's state format is described in three places: SKILL.md prose, the
`state/*_TEMPLATE.md` files, and `viewer/parsers.py`. This script is what keeps
them honest — it checks real files (and, with --templates, Perry's own
templates) against the one declared schema.

Usage:
  perry-lint [--root <project_root>] [--templates | --claims | --verification |
              --provenance | --knowledge]
             [--json]
             [--state-root <path>] [--strict] [--quiet]

  --templates   lint Perry's own state/*_TEMPLATE.md instead of a project.
                This is the drift guard: a template that stops matching the
                schema is what silently breaks the viewer and the standup.
  --claims      report which paths Perry would claim in this folder are already
                taken by someone else's files. Runs BEFORE adoption, so unlike
                the default mode it is deliberately NOT gated on is_adopted() —
                a collision check that only ran on adopted projects would answer
                the question after the moment it mattered.
  --verification  advisory pass over every done row's verification rung
                (DESIGN-003 section 5.3): a missing rung, a rung the cited
                evidence cannot satisfy, and any row matching the project's
                own high-stakes list that closed below V5. Never sets a
                non-zero exit - advisory for one release by decision 4.
  --knowledge   advisory pass over knowledge CARDS (DESIGN-006 section 5.3):
                the four provenance fields present, `Source:` resolving to
                something a reader can re-open, and staleness against
                thresholds.knowledge_stale_days. Prints the card count even at
                zero findings, because zero over zero cards is not a result.
                Cards and digests share `knowledge/*/*.md` and are told apart
                by the card's `Kind:`; this skips digests and --provenance
                skips cards.
  --provenance  advisory pass over source citations (DESIGN-003 section 5.4):
                every `SRC-n` cited anywhere resolves to a digest under
                knowledge/, every digest carries an id, an origin and a
                fetch date, and no id is reused. Never exits non-zero.
  --state-root  with --claims, test a candidate state root other than the one
                .perry/config.md declares (or `.` when there is none).
  --json        machine-readable findings
  --strict      warnings count as failures
  --quiet       print nothing; use the exit code

Exit codes:
  0  clean (or warnings only, without --strict)
  1  errors found
  2  bad invocation / unreadable schema

No LLM, no external dependencies (stdlib only). Read-only.
"""

from __future__ import annotations

import fnmatch
import json
import os
import re
import sys
from datetime import date
from pathlib import Path

HERE = Path(__file__).resolve().parent
PERRY_HOME = Path(os.environ.get("PERRY_HOME") or HERE.parent).resolve()
SCHEMA_PATH = PERRY_HOME / "schema" / "state-schema.json"

# Frontmatter files are read with the SAME reader Perry uses, so "the linter
# passed" and "Perry can read it" cannot diverge.
sys.path.insert(0, str(PERRY_HOME / "viewer"))
import parsers as P
from tables import split_row, squash  # noqa: E402

PLACEHOLDER = re.compile(r"\{\{.*?\}\}")


class Finding:
    def __init__(self, severity: str, file: str, rule: str, message: str, line: int | None = None):
        self.severity = severity
        self.file = file
        self.rule = rule
        self.message = message
        self.line = line

    def as_dict(self) -> dict:
        return {
            "severity": self.severity, "file": self.file, "rule": self.rule,
            "message": self.message, "line": self.line,
        }

    def __str__(self) -> str:
        mark = {"error": "✗", "warn": "⚠"}.get(self.severity, "·")
        where = f"{self.file}:{self.line}" if self.line else self.file
        return f"  {mark} {where} [{self.rule}] {self.message}"


# ── markdown helpers ──────────────────────────────────────────────────────

KR_ID_RE = r"\bP-O\d+\.\d+\b"
RE_COMMENT = re.compile(r"<!--.*?-->", re.S)


def strip_comments(text: str) -> str:
    return RE_COMMENT.sub("", text)


def headings(text: str) -> list[tuple[int, str, int]]:
    """(level, text, line_no) for every ATX heading."""
    out = []
    in_fence = False
    for i, line in enumerate(text.split("\n"), start=1):
        if line.lstrip().startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = re.match(r"^(#{1,6})\s+(.*)$", line)
        if m:
            out.append((len(m.group(1)), m.group(2).strip(), i))
    return out


def section_body(text: str, level: int, matcher: re.Pattern) -> list[tuple[str, int]]:
    """Bodies of every section whose heading matches, as (body, start_line)."""
    lines = text.split("\n")
    heads = headings(text)
    out = []
    for idx, (lvl, htext, lineno) in enumerate(heads):
        if lvl != level or not matcher.search(htext):
            continue
        end = len(lines)
        for lvl2, _, line2 in heads[idx + 1:]:
            if lvl2 <= level:
                end = line2 - 1
                break
        out.append(("\n".join(lines[lineno:end]), lineno))
    return out


def tables(section: str) -> list[tuple[list[str], list[list[str]]]]:
    """Every markdown table in the section as (header_cells, data_rows).

    Rows are split by `viewer/tables.py § split_row` — the same function the
    writer's `render_row` is the inverse of, and the same one every reader in
    `viewer/parsers.py` uses. This file used to carry its own
    naive split on every `|`, which did not honour the escape, so the linter read
    eight cells where the contract reader read seven on a row `perry-task`
    itself had written, and reported `bad-enum Verification = '—'` against a
    correctly-formed row. A checker that reads a file differently from the
    tool that wrote it does not check that file.
    """
    out: list[tuple[list[str], list[list[str]]]] = []
    prev: list[str] = []
    header: list[str] | None = None
    rows: list[list[str]] = []
    for line in section.split("\n"):
        s = line.strip()
        if re.match(r"^\|\s*:?-{2,}", s):
            header = [c.strip() for c in prev]
            rows = []
            continue
        if s.startswith("|"):
            cells = split_row(s)
            if header is None:
                prev = cells
            else:
                rows.append(cells)
            continue
        if header is not None:
            out.append((header, rows))
            header = None
        prev = []
    if header is not None:
        out.append((header, rows))
    return out


#: `perry-task` defined this character-for-character under the name `squash`.
#: One rule, one implementation — extracted for TASK-037.
norm = squash


# ── localized column headers ──────────────────────────────────────────────
#
# A project writes its state files in the language declared by
# `.perry/config.md § Document language`. Section headings are handled by the
# `match` regexes in the schema (each carries its localized alternatives);
# table column headers are exact strings, so they resolve through the
# `i18n.columns` glossary instead. Populated once from the schema in main();
# empty means "English only", which is the correct behaviour for a schema
# that declares no glossary.
COLUMN_ALIASES: dict[str, list[str]] = {}
FIELD_ALIASES: dict[str, list[str]] = {}
HEADING_ALIASES: dict[str, list[str]] = {}

#: mode -> the columns that mode has no honest default for, read from
#: `schema/state-schema.json § work_modes.modes.<mode>.no_default`. Read, never
#: copied: the moment this file carried its own list of which modes need an
#: `SLA`, the schema's list and the linter's list would be two answers to one
#: question, which is the defect ADR-004 is about.
MODE_NO_DEFAULT: dict[str, list[str]] = {}

#: Separators a `## Tracks` § Stages cell may use, and the ones that look like
#: separators and are not — read from `schema/state-schema.json §
#: work_modes.stage_separators`, never copied. `bin/perry-state § split_stages`
#: reads the SAME list, so the splitter and the check below cannot disagree
#: about what an accepted separator is. Two answers to that question is what
#: put the `->` / `→` bug in circulation to begin with.
STAGE_SEPARATORS: dict[str, list[str]] = {}

#: What a user writes in a cell to mean "nothing here". `SKILL.md`'s own
#: example track row spells an empty cell `—`, so a check that only tested for
#: the empty string would pass over every register Perry itself taught people
#: to write. This is the CATEGORY, not the one spelling that bit.
UNDECLARED_CELL = {"", "—", "–", "-", "n/a", "N/A", "tbd", "TBD", "?", "—/—"}


def load_glossary(schema: dict) -> None:
    """Arm the localization glossary and the declared thresholds.

    Every check below reads these module-level tables, so calling `check_file`
    without this first silently reports a localized project's own column
    headers as wrong columns. It used to live inline in `main()`, which meant
    the only way to reach `check_file` correctly was to be `main()`;
    `bin/perry-conform` needs the same validation on one file, and a second
    copy of this loop is exactly the two-implementations-of-one-rule defect
    ADR-004 is about."""
    SCHEMA_THRESHOLDS.update(schema.get("thresholds") or {})
    for mode, cfg in ((schema.get("work_modes") or {}).get("modes") or {}).items():
        MODE_NO_DEFAULT[mode] = list((cfg or {}).get("no_default") or [])
    STAGE_SEPARATORS.update(
        (schema.get("work_modes") or {}).get("stage_separators") or {})
    card = next((f for f in (schema.get("files") or [])
                 if f.get("id") == "knowledge-card"), None) or {}
    CARD_KINDS[:] = ((card.get("discriminator") or {}).get("values") or [])
    CARD_REQUIRED[:] = [h["name"] for h in (card.get("header_fields") or [])
                        if h.get("name") != "Kind"]
    i18n = schema.get("i18n") or {}
    for col, per_lang in (i18n.get("columns") or {}).items():
        COLUMN_ALIASES[col] = [a for aliases in per_lang.values() for a in aliases]
    for fld, per_lang in (i18n.get("fields") or {}).items():
        FIELD_ALIASES[fld] = [a for aliases in per_lang.values() for a in aliases]
    for head, per_lang in (i18n.get("headings") or {}).items():
        HEADING_ALIASES[head] = [a for aliases in per_lang.values() for a in aliases]


def accepted(column: str) -> list[str]:
    """Every normalized header spelling that satisfies this schema column."""
    names = [column, *COLUMN_ALIASES.get(column, [])]
    out: list[str] = []
    for n in names:
        v = norm(n)
        if v not in out:
            out.append(v)
    return out


def column_index(got: list[str], column: str) -> int:
    """Position of `column` in a table's normalized header row, or -1."""
    for alias in accepted(column):
        if alias in got:
            return got.index(alias)
    return -1


def field_re(name: str) -> str:
    """Alternation matching a header field name in any accepted language."""
    names = [name, *FIELD_ALIASES.get(name, [])]
    return "(?:" + "|".join(re.escape(n) for n in names) + ")"


def heading_re(name: str) -> re.Pattern:
    """Matcher for a section heading in any accepted language.

    For the cross-file checks, which look up a section by name rather than
    walking `files[].headings`. Both paths must agree — a safety gate the
    linter reports as unarmed while `bin/perry-state` reads it as armed is
    worse than either answer alone."""
    names = [name, *HEADING_ALIASES.get(name, [])]
    return re.compile("|".join("^" + re.escape(n) for n in names))


# ── checks ────────────────────────────────────────────────────────────────


# Filled from schema["thresholds"] in main(). Module-level rather than threaded
# through two signatures, so every check reads the one declared number.
SCHEMA_THRESHOLDS: dict = {}

#: The `Kind:` values that make a `knowledge/*/*.md` file a CARD rather than a
#: digest, and the fields a card must carry — both read from
#: `schema/state-schema.json § files[id=knowledge-card]`, never written here.
#: `Owner role` is in the required list and handled separately in the check,
#: because an em dash legitimately answers it until roles exist.
CARD_KINDS: list[str] = []
CARD_REQUIRED: list[str] = []


def _days_since(stamp: str) -> int | None:
    """Whole days since an ISO date or datetime. None when unparseable —
    a missing timestamp must not silently read as "0 days old"."""
    m = re.match(r"(\d{4})-(\d{2})-(\d{2})", stamp.strip().strip("\"'"))
    if not m:
        return None
    try:
        then = date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
    except ValueError:
        return None
    return (date.today() - then).days


def check_frontmatter(path: Path, rel: str, spec: dict, enums: dict,
                      is_template: bool) -> list[Finding]:
    """Validate a YAML-frontmatter file (currently: the linkage graph).

    Uses the same reader Perry itself uses, so "the linter passed" and "Perry
    can read it" mean the same thing."""
    findings: list[Finding] = []
    fm = spec["frontmatter"]
    raw = path.read_text(errors="replace")
    front, _ = P.split_frontmatter(raw)
    if not front.strip():
        return [Finding("error", rel, "missing-frontmatter",
                        "expected a `---` fenced YAML block at the top of the file")]
    if is_template and "{{" in front:
        return []          # unfilled template placeholders are expected
    try:
        data = P.parse_yaml_subset(front)
    except ValueError as exc:
        return [Finding("error", rel, "bad-frontmatter", str(exc))]
    if not isinstance(data, dict):
        return [Finding("error", rel, "bad-frontmatter", "frontmatter is not a mapping")]

    key, want = fm["spec_key"], fm["spec_version"]
    if data.get(key) != want:
        findings.append(Finding("error", rel, "bad-spec-version",
                                f"`{key}: {data.get(key)!r}` — expected {want}"))

    def walk(node, fields: dict, where: str):
        for name, rule in fields.items():
            value = node.get(name) if isinstance(node, dict) else None
            if value is None:
                if rule.get("required"):
                    findings.append(Finding("error", rel, "missing-field",
                                            f"{where}{name} is required"))
                continue
            if rule.get("type") == "array":
                if not isinstance(value, list):
                    findings.append(Finding("error", rel, "bad-type",
                                            f"{where}{name} must be a list"))
                    continue
                item_rule = rule.get("items") or {}
                if item_rule and not item_rule.get("type"):
                    for i, item in enumerate(value):
                        if isinstance(item, dict):
                            walk(item, item_rule, f"{where}{name}[{i}].")
                continue
            if rule.get("type") == "number" and not isinstance(value, (int, float)):
                findings.append(Finding(
                    "error", rel, "bad-type",
                    f"{where}{name} must be a number or omitted — "
                    f"got {value!r}. A prose target must be omitted, not coerced."))
            if rule.get("pattern") and isinstance(value, str) \
                    and not re.match(rule["pattern"], value):
                findings.append(Finding("error", rel, "bad-id",
                                        f"{where}{name} = {value!r} does not match "
                                        f"/{rule['pattern']}/"))
            if rule.get("enum") and str(value) not in enums[rule["enum"]]:
                findings.append(Finding("error", rel, "bad-enum",
                                        f"{where}{name} = {value!r} is not one of "
                                        f"{enums[rule['enum']]}"))
            # A field whose legal values depend on a sibling — `step` is only
            # meaningful against the `stage` it sits inside. A dossier reading
            # `stage: confirm, step: rx-3` resumes into nothing, and the whole
            # point of `step` is that resume lands somewhere real.
            by_stage = rule.get("enum_by_stage") or {}
            pat_by_stage = rule.get("pattern_by_stage") or {}
            if by_stage or pat_by_stage:
                stage = str(node.get("stage") or "") if isinstance(node, dict) else ""
                if stage in by_stage:
                    allowed = enums[by_stage[stage]]
                    if str(value) not in allowed:
                        findings.append(Finding(
                            "error", rel, "bad-step",
                            f"{where}{name} = {value!r} is not a valid step of "
                            f"stage {stage!r} — expected one of {allowed}"))
                elif stage in pat_by_stage:
                    if not re.match(pat_by_stage[stage], str(value)):
                        findings.append(Finding(
                            "error", rel, "bad-step",
                            f"{where}{name} = {value!r} does not match "
                            f"/{pat_by_stage[stage]}/ for stage {stage!r}"))
                elif stage:
                    findings.append(Finding(
                        "warn", rel, "step-without-substeps",
                        f"{where}{name} = {value!r} but stage {stage!r} has no "
                        f"sub-steps — resume reads `stage` alone here, so this "
                        f"field is noise"))

    walk(data, fm["fields"], "")

    # A pipeline someone walked away from and never came back to. Reported so
    # the interrupted-run card can also offer to retire it, rather than showing
    # the same abandoned dossier at every entry forever.
    stale = SCHEMA_THRESHOLDS.get("stale_run_days") or {}
    if spec.get("id") in (stale.get("applies_to") or []):
        stage = str(data.get("stage") or "")
        if stage and stage not in ("done", "abandoned"):
            days = _days_since(str(data.get("updated") or data.get("started") or ""))
            limit = stale.get("value")
            if days is not None and limit and days >= limit:
                findings.append(Finding(
                    "warn", rel, "stale-run",
                    f"stage {stage!r} has not advanced in {days}d "
                    f"(threshold {limit}d) — resume it, or retire it with "
                    f"`stage: abandoned` so it stops being offered. The "
                    f"threshold is a calibrated default, not a law."))

    # A task may serve at most one KR.
    seen: dict[str, str] = {}
    for obj in data.get("objectives") or []:
        for kr in (obj or {}).get("krs") or []:
            for task in (kr or {}).get("tasks") or []:
                prev = seen.get(str(task))
                if prev and prev != kr.get("id"):
                    findings.append(Finding(
                        "error", rel, "linkage-task-single-kr",
                        f"task {task} is listed under both {prev} and {kr.get('id')} — "
                        "its attribution would be ambiguous"))
                seen[str(task)] = str(kr.get("id"))

    # Objective agreement + name/alias uniqueness across projects.
    claimed: dict[str, str] = {}
    for pr in data.get("projects") or []:
        if not isinstance(pr, dict):
            continue
        pid, serves, obj = str(pr.get("id") or ""), str(pr.get("serves") or ""), pr.get("objective")
        m = re.match(r"^P-(O\d+)\.", serves)
        if m and obj and m.group(1) != str(obj):
            findings.append(Finding("error", rel, "linkage-objective-agrees",
                                    f"{pid}: serves {serves} (which is {m.group(1)}) but "
                                    f"objective says {obj}"))
        for label in [pr.get("name"), *(pr.get("aliases") or [])]:
            key2 = str(label or "").strip().lower()
            if not key2:
                continue
            if key2 in claimed and claimed[key2] != pid:
                findings.append(Finding(
                    "error", rel, "linkage-names-unique",
                    f"name/alias {label!r} is claimed by both {claimed[key2]} and {pid} — "
                    "attribution cannot resolve it to one KR"))
            claimed[key2] = pid
    return findings


def spec_claims(spec: dict, text: str, schema: dict) -> bool:
    """Does this spec own this file, when two specs share one glob?

    `knowledge/*/*.md` is matched by both the digest spec and the knowledge-card
    spec. A card is a claim the project made; a digest is a source it read.
    Without this, the generic checker judged every card against the digest's
    required fields and reported three `missing-header-field` errors on a
    perfectly well-formed card — the same collision `--knowledge` and
    `--provenance` already resolve for themselves, one layer lower and missed.

    The rule is declared, not inferred: a spec carrying a `discriminator` owns a
    file whose named field holds one of its values, and a spec **sharing that
    glob without one** owns the files the discriminated spec rejected. Any spec
    whose glob nothing else matches is unaffected and answers `True`.
    """
    disc = spec.get("discriminator")
    if disc:
        return field_value(text, disc["field"]) in (disc.get("values") or [])
    rivals = [f for f in (schema.get("files") or [])
              if f is not spec and f.get("path") == spec.get("path")
              and f.get("discriminator")]
    for r in rivals:
        d = r["discriminator"]
        if field_value(text, d["field"]) in (d.get("values") or []):
            return False
    return True


def check_file(path: Path, rel: str, spec: dict, enums: dict, is_template: bool) -> list[Finding]:
    if spec.get("format") == "yaml-frontmatter":
        return check_frontmatter(path, rel, spec, enums, is_template)

    findings: list[Finding] = []
    raw = path.read_text(errors="replace")
    text = strip_comments(raw)
    lines = raw.split("\n")

    cap = spec.get("cap")
    if cap and len(lines) > cap:
        sev = "error" if spec.get("cap_kind") == "hard" else "warn"
        findings.append(Finding(
            sev, rel, "size-cap",
            f"{len(lines)} lines, over the tier-{spec.get('tier')} cap of {cap}. "
            "Split the overflow into a sibling file rather than writing past it.",
        ))

    # Some sections are only mandatory once the doc reaches a given status —
    # a design doc in `draft` is allowed to be incomplete; `locked` is not.
    gate = spec.get("required_at_status")
    doc_status = ""
    if gate:
        sm = re.search(rf"{field_re(gate['field'])}\s*\**\s*[:：]\s*\**\s*(\w+)", text)
        doc_status = sm.group(1).lower() if sm else ""
    sections_are_hard = not gate or doc_status in gate["values"]

    heads = headings(text)
    for req in spec.get("headings", []):
        matcher = re.compile(req["match"])
        if not any(lvl == req["level"] and matcher.search(t) for lvl, t, _ in heads):
            severity = "error" if sections_are_hard else "warn"
            suffix = "" if sections_are_hard else (
                f" (not yet blocking at {gate['field']}: {doc_status or '—'}; "
                f"required at {'/'.join(gate['values'])})"
            )
            findings.append(Finding(
                severity, rel, "missing-section",
                f"required section not found: {req['label']}{suffix}",
            ))

    for field in spec.get("header_fields", []):
        name = field["name"]
        m = re.search(rf"{field_re(name)}\s*\**\s*[:：]\s*\**\s*([^\n]+)", text)
        if not m:
            # A field declared `required: false` is a pointer with a default —
            # absent means "use the default", not "malformed".
            if field.get("required") is False:
                continue
            findings.append(Finding("error", rel, "missing-header-field",
                                    f"header field `{name}:` not found"))
            continue
        value = m.group(1).strip().strip("*`> ")
        if is_template and PLACEHOLDER.search(value):
            continue
        if field.get("enum"):
            allowed = enums[field["enum"]]
            first = re.split(r"[|/,]", value)[0].strip()
            if first and first not in allowed and not PLACEHOLDER.search(value):
                findings.append(Finding(
                    "error", rel, "bad-enum",
                    f"`{name}: {first}` is not one of {allowed}",
                ))
        elif field.get("pattern") and not re.search(field["pattern"], value):
            findings.append(Finding(
                "warn", rel, "bad-format",
                f"`{name}: {value}` does not match /{field['pattern']}/",
            ))

    for tspec in spec.get("tables", []):
        matcher = re.compile(tspec["under"])
        level = tspec.get("under_level", 2)
        bodies = section_body(text, level, matcher)
        if not bodies:
            continue
        prefix_match = tspec.get("column_match") == "prefix"
        found_any = False

        def satisfied(col: str, got: list[str]) -> bool:
            """A column is present under its English name or any localized alias."""
            return any(
                any(g.startswith(a) for g in got) if prefix_match else a in got
                for a in accepted(col)
            )

        for body, start in bodies:
            for header, rows in tables(body):
                got = [norm(c) for c in header]
                if not got:
                    continue
                found_any = True
                # A row that is not as wide as its header. Both directions are
                # wrong and neither was reported until now: a SHORT row reads
                # as one whose trailing columns are empty — and empty is legal
                # for `Evidence`, so nothing downstream objects — while a LONG
                # row shifts every column after the extra `|`.
                #
                # This is the check that was missing when `perry-task add`
                # wrote raw newlines into three rows of Perry's own board.
                # Each ended mid-cell with no closing `|`; `perry-lint`
                # reported `✓ clean`; the next `add` then parsed the truncated
                # line as the table's last row and inserted into the middle of
                # the spilled text. Every column read below is index-guarded
                # (`if ci >= len(row): continue`), which is exactly why a
                # malformed row passed every one of them in silence.
                #
                # Deliberately ABOVE the missing-columns branch, which bails
                # out with `continue`. Comparing a row's width to its header's
                # needs no interpretation of what the columns mean, so a table
                # whose headers Perry does not recognize can still be told its
                # rows do not line up — and that is precisely the table a
                # project arriving from outside Perry has.
                for row in rows:
                    if len(row) == len(header):
                        continue
                    if not any(c.strip() for c in row):
                        continue          # a blank spacer row inside a table
                    shown = (row[column_index(got, tspec["id_column"])]
                             if tspec.get("id_column")
                             and 0 <= column_index(got, tspec["id_column"]) < len(row)
                             else " | ".join(row)[:60])
                    findings.append(Finding(
                        "error", rel, "ragged-row", line=start,
                        message=f"row {shown!r} has {len(row)} cell(s) but its "
                                f"header has {len(header)} — "
                                + ("the trailing column(s) read as empty"
                                   if len(row) < len(header)
                                   else "every column after the extra `|` is shifted"),
                    ))
                missing = [c for c in tspec["columns"] if not satisfied(c, got)]
                if missing:
                    findings.append(Finding(
                        "error", rel, "table-columns", line=start,
                        message=f"table under section at line {start} is missing column(s) "
                                f"{missing}; parsers key on these headers. Found: {header}",
                    ))
                    continue
                for col, enum_name in (tspec.get("enum_columns") or {}).items():
                    ci = column_index(got, col)
                    if ci < 0:
                        continue
                    for row in rows:
                        if ci >= len(row):
                            continue
                        val = row[ci].replace("*", "").strip()
                        if not val or PLACEHOLDER.search(val):
                            continue
                        base = re.split(r"[\s(（]", val)[0]
                        if base not in enums[enum_name]:
                            findings.append(Finding(
                                "error", rel, "bad-enum",
                                f"{col} = {val!r} is not one of {enums[enum_name]}",
                            ))
                # A column the row's own mode has no honest default for, left
                # undeclared.
                #
                # `work_modes.defaults_note` already draws the distinction this
                # reads: an empty `WIP` under `queue` means THIS MODE HAS NO
                # SUCH CONTROL, while an empty `SLA` under `queue` means NOBODY
                # HAS SAID YET — and only the second is a finding. The note
                # stated the rule and left it to be obeyed by hand, so a queue
                # track with no SLA lints clean, and then `modes/queue.md`'s
                # breach step, age sort and triage question all measure against
                # a clock that does not exist.
                #
                # Deliberately WARN. The full argument is in the schema; the
                # short version is that an error would retroactively invalidate
                # every register written before this rule, and — because a file
                # carrying errors cannot be declared conformant — would
                # escalate one blank cell into a write refusal on the whole of
                # `.perry/config.md`. The question is FORCED at creation
                # instead, where there is no legacy and no default to fall back
                # on, and the hard stop already exists at the point of use.
                nd = tspec.get("no_default_by_mode") or {}
                mi = column_index(got, nd["mode_column"]) if nd else -1
                if mi >= 0:
                    ti = column_index(got, nd.get("id_column") or "")
                    for row in rows:
                        if mi >= len(row):
                            continue
                        mode = re.split(
                            r"[\s(（]", row[mi].replace("*", "").strip())[0]
                        who = (row[ti].replace("*", "").strip()
                               if 0 <= ti < len(row) else "?")
                        for col in MODE_NO_DEFAULT.get(mode, []):
                            k = column_index(got, col)
                            val = ("" if k < 0 or k >= len(row)
                                   else row[k].replace("*", "").strip())
                            if val not in UNDECLARED_CELL \
                                    and not PLACEHOLDER.search(val):
                                continue
                            findings.append(Finding(
                                "warn", rel, "no-default", line=start,
                                message=(
                                    f"track {who!r} is mode {mode!r} and its "
                                    f"`{col}` is undeclared. {mode} has no "
                                    f"default `{col}` (schema "
                                    f"work_modes.modes.{mode}.no_default) "
                                    f"because it is a commitment the project "
                                    f"makes to someone, and a number Perry "
                                    f"invented is one the project never made — "
                                    f"every triage run afterwards would measure "
                                    f"real work against it. Declare it in the "
                                    f"`{col}` cell of `.perry/config.md § "
                                    f"Tracks`; until then triage reports the gap "
                                    f"instead of a verdict."),
                            ))

                # **A Stages cell that did not split is reported by name.**
                #
                # `split_stages` accepts the separators in
                # `schema/state-schema.json § work_modes.stage_separators.
                # accepted`; a cell using any other one becomes ONE stage whose
                # name is the whole list, and every stage-based measure in
                # queue, pipeline and inquiry mode then runs on it. That is
                # silent today: reproduced on a project reporting 8 errors, and
                # not one of them named this cell.
                #
                # Both halves read the SAME schema list, so the splitter and
                # this check cannot disagree about what an accepted separator
                # is — which is the shape that put the `->` / `→` bug in
                # circulation to begin with.
                seps = STAGE_SEPARATORS
                si = column_index(got, "Stages")
                if si >= 0 and seps.get("suspect"):
                    # The table's own id column is declared under
                    # `no_default_by_mode`, not at the table's top level —
                    # `tspec["id_column"]` is None here, and reading it named
                    # every track `'?'`.
                    ti2 = column_index(got, (nd or {}).get("id_column") or "")
                    for row in rows:
                        if si >= len(row):
                            continue
                        cell = row[si].replace("*", "").strip()
                        if cell in UNDECLARED_CELL or not cell:
                            continue
                        if any(a in cell for a in (seps.get("accepted") or [])):
                            continue
                        hit = next((c for c in seps["suspect"] if c in cell), None)
                        if not hit:
                            continue
                        who = (row[ti2].replace("*", "").strip()
                               if 0 <= ti2 < len(row) else "?")
                        findings.append(Finding(
                            "warn", rel, "stage-separator", line=start,
                            message=(
                                f"track {who!r} lists its stages with {hit!r}, "
                                f"which Perry does not split on — the whole "
                                f"cell becomes ONE stage named "
                                f"{cell!r}, and WIP, stage age and this mode's "
                                f"triage question all measure against it. Use "
                                f"one of "
                                f"{', '.join(repr(a) for a in seps['accepted'])}."),
                        ))

                ci = column_index(got, tspec["id_column"]) if tspec.get("id_column") else -1
                if ci >= 0:
                    pat = re.compile(tspec["id_pattern"])
                    for row in rows:
                        if ci >= len(row):
                            continue
                        val = row[ci].replace("*", "").strip()
                        if not val or PLACEHOLDER.search(val):
                            continue
                        if not pat.match(val):
                            findings.append(Finding(
                                "error", rel, "bad-id",
                                f"id {val!r} does not match /{tspec['id_pattern']}/ — "
                                "attribution resolves on these ids",
                            ))
        # `optional` = this section is allowed to hold something other than a
        # table. `## Top risks` is the case: it is a bullet list on every
        # project that has not migrated to the tool-written table, and a bullet
        # list is a valid `## Top risks` — readers fall back to it. Without
        # this the table spec added for TASK-040 would have turned every
        # unmigrated board red for a shape it was never asked to adopt.
        #
        # Note this is NOT the same optionality Intake has. Intake is skipped
        # because `section_body` returns nothing when the SECTION is absent;
        # here the section is present and merely has no table.
        if not found_any and not is_template and not tspec.get("optional"):
            findings.append(Finding(
                "warn", rel, "missing-table",
                f"no table found under /{tspec['under']}/",
            ))
    return findings


def check_cross_file(root: Path, enums: dict, project_root: Path | None = None) -> list[Finding]:
    findings: list[Finding] = []
    # `.perry/` is anchored at the project root even when state lives in a
    # subdirectory — it is the pointer, so it cannot sit behind the pointer.
    perry_dir = (project_root or root) / ".perry"

    # phase/CURRENT resolves
    cur = root / "phase" / "CURRENT"
    phase_file = None
    if cur.exists():
        slug = cur.read_text().strip()
        if slug and slug not in {"(none)", "none", "—", ""}:
            phase_file = root / "phase" / f"{slug}.md"
            if not phase_file.exists():
                findings.append(Finding(
                    "error", "phase/CURRENT", "current-phase-resolves",
                    f"points at {slug!r} but phase/{slug}.md does not exist",
                ))
                phase_file = None

    # linkage: every KR the graph names must exist in the phase file
    phase_krs: set[str] = set()
    if phase_file and phase_file.exists():
        phase_krs = set(re.findall(KR_ID_RE, strip_comments(phase_file.read_text())))
    for lf in sorted((root / "phase").glob("*-linkage.md")) if (root / "phase").is_dir() else []:
        link = P.parse_linkage(lf.read_text())
        rel = lf.relative_to(root).as_posix()
        if not link.ok:
            continue
        for pr in link.projects:
            if pr.serves_kr and phase_krs and pr.serves_kr not in phase_krs:
                findings.append(Finding(
                    "warn", rel, "linkage-kr-exists",
                    f"{pr.project_id}: serves {pr.serves_kr}, which is not in the "
                    "current phase's KR set"))
        for obj in link.objectives:
            for kr in obj.krs:
                if phase_krs and kr.id not in phase_krs:
                    findings.append(Finding(
                        "warn", rel, "linkage-kr-exists",
                        f"{kr.id} is in the graph but not in the current phase file"))

    # design: locked docs need an implementation plan
    for df in sorted((root / "design").glob("*.md")) if (root / "design").is_dir() else []:
        if df.name == "README.md":
            continue
        text = strip_comments(df.read_text())
        rel = df.relative_to(root).as_posix()
        sm = re.search(r"Status\s*\**\s*[:：]\s*\**\s*(\w+)", text)
        if not sm or sm.group(1).lower() != "locked":
            continue
        # design docs number their sections (## 6. Implementation plan)
        plan = section_body(text, 2, re.compile(r"^(?:\d+\.\s*)?Implementation plan"))
        if not plan or not plan[0][0].strip():
            findings.append(Finding(
                "error", rel, "locked-design-has-plan",
                "Status: locked but the Implementation plan section is empty — "
                "PMO has nothing to open tasks from",
            ))

    # BOARD: done rows need evidence
    board = root / "BOARD.md"
    if board.exists():
        for header, rows in tables(strip_comments(board.read_text())):
            got = [norm(c) for c in header]
            if "status" not in got or "evidence" not in got:
                continue
            si, ei = got.index("status"), got.index("evidence")
            for row in rows:
                if max(si, ei) >= len(row):
                    continue
                if row[si].replace("*", "").strip().startswith("done"):
                    ev = row[ei].strip()
                    if not ev or ev in {"—", "-", ""}:
                        findings.append(Finding(
                            "warn", "BOARD.md", "done-needs-evidence",
                            f"row {row[0]!r} is done with no evidence path",
                        ))

    # hook safety list
    hook = perry_dir / "hook.md"
    armed = False
    if hook.exists():
        body = section_body(strip_comments(hook.read_text()), 2,
                            heading_re("High-stakes operations"))
        armed = bool(body and [
            b for b in body[0][0].split("\n")
            if b.strip().startswith("-") and "{{" not in b
        ])
    if not armed:
        findings.append(Finding(
            "warn", ".perry/hook.md", "hook-high-stakes-armed",
            "no high-stakes operations list — /perry work dispatch's safety re-validation and "
            "/perry work autopilot's safety scan have nothing to match against",
        ))
    return findings


# ── verification ladder (DESIGN-003 § 5.3) ────────────────────────────────


DATE_RE = re.compile(r"\b\d{4}-\d{2}-\d{2}\b")
RUNNABLE_RE = re.compile(r"`[^`]+`|\.(?:py|sh|json|md|ya?ml)\b|/")


def high_stakes_fragments(perry_dir: Path) -> list[str]:
    """The scan list: `.perry/hook.md`'s fragments **unioned** with every role's.

    Reused rather than re-declared. The consequence rule — anything
    outward-facing or irreversible needs V5 regardless of its mode's default —
    has no field of its own to read, and inventing one would mean asking the
    user to classify every task twice. The hook already carries the project's
    own statement of what is dangerous, so that list *is* the consequence
    signal. A project with an unarmed hook simply gets no consequence checks,
    which is honest: nothing has told Perry what matters there.

    **A role adds to that list and never replaces it** (DESIGN-006 § 5.2, goal
    6). `P.escalation_union` is the one implementation — this function does not
    carry a second copy, because two extractions of one rule is how a scan
    quietly stops scanning what it used to. With no roles declared the union is
    the hook's list unchanged, which is Goal 7 at this surface.
    """
    project_root = perry_dir.parent if perry_dir.name == ".perry" else perry_dir
    return P.escalation_union(project_root)["union"]


def rung_satisfied(rung: str, evidence: str) -> str | None:
    """Why this rung is NOT satisfiable from this evidence, or None if it is.

    Deliberately shallow. The linter can tell that a V5 claim carries no date,
    or that a V4 claim cites no rubric file; it cannot tell whether the reviewer
    was genuinely fresh-context or whether the human actually read the thing.
    Checking the checkable and staying quiet about the rest is what keeps this
    advisory pass from becoming theatre in the other direction.
    """
    ev = (evidence or "").strip()
    if rung == "V0":
        return ("V0 is 'asserted' — it is the name for what is being refused, "
                "never a rung a row may carry")
    if not ev or ev in ("—", "-"):
        return f"{rung} claimed with no evidence at all"
    if rung in ("V2", "V3") and not RUNNABLE_RE.search(ev):
        return (f"{rung} means a check something can re-run; the evidence names "
                f"no command, script or path")
    if rung == "V4" and not re.search(r"rubric|criteria|\.md\b", ev, re.I):
        return ("V4 requires a written acceptance rubric the reviewer scored "
                "against; the evidence cites none (see DESIGN-003 § 5.3)")
    if rung == "V5" and not DATE_RE.search(ev):
        return ("V5 is a human sign-off recording name, date and what was "
                "checked; the evidence carries no date")
    return None


def check_verification(state_root: Path, perry_dir: Path) -> list["Finding"]:
    """Advisory pass over every `done` row's verification rung.

    Advisory for one release by DESIGN-003 § 4 decision 4: a hard gate on day
    one would retroactively invalidate every `done` row in every existing
    project, since none of them carry a rung. This mode never sets a non-zero
    exit — branch on the `--json` counts if you want CI to care.
    """
    findings: list[Finding] = []
    board = state_root / "BOARD.md"
    if not board.exists():
        return findings

    def judge(where: str, tid: str, title: str, ev: str, rung: str,
              stakes: list[str]) -> int:
        """One closure, judged. Called for board rows AND for close events.

        Reading only board rows measured an empty set: `perry-task done`
        REMOVES the row it closes, so on this repo 29 closures carrying rungs
        produced "no done rows to rate". The consequence rule below — anything
        outward-facing or carrying money needs V5 regardless of mode — could
        therefore never fire on a task the tool had closed, which by then was
        every task.
        """
        if not rung:
            findings.append(Finding(
                "warn", where, "no-verification-rung",
                f"{tid} is done with no verification rung — "
                f"'evidence exists' does not say what was checked"))
            return 0
        why = rung_satisfied(rung, ev)
        if why:
            findings.append(Finding("warn", where, "rung-not-satisfied",
                                    f"{tid}: {why}"))
        # The id and the title — what the work IS. NOT the evidence path:
        # that is where the proof lives, not what was done, and matching
        # fragments inside it made every task high-stakes. Perry's own hook
        # lists `evidence/` under "destructive filesystem operations —
        # overwriting a project's own design/, evidence/, …", so once this
        # check started seeing tool-closed tasks it flagged all 29 of them.
        # A latent bug that could not fire while the check rated nothing.
        hay = f"{tid} {title}".lower()
        hit = next((f for f in stakes if f in hay), None)
        if hit and rung < "V5":
            findings.append(Finding(
                "warn", where, "consequence-needs-signoff",
                f"{tid} matches the project's own high-stakes list "
                f"({hit!r}) but closed at {rung}; outward-facing or "
                f"irreversible work needs V5 regardless of mode"))
        return 1
    # `seen` is returned alongside the findings so the caller can tell "every
    # done row is fine" from "there were no done rows" — printing a checkmark
    # for an empty scan is how a gate quietly stops being one.
    check_verification.rows_seen = 0
    text = strip_comments(board.read_text(errors="replace"))
    stakes = high_stakes_fragments(perry_dir)

    rows_seen = rows_ranked = 0
    seen_ids: set[str] = set()
    for body, _ in section_body(text, 2, re.compile(r"^P[012]\b")):
        for header, rows in tables(body):
            got = [norm(c) for c in header]
            ci_id, ci_st = column_index(got, "ID"), column_index(got, "Status")
            ci_ev, ci_v = column_index(got, "Evidence"), column_index(got, "Verification")
            ci_ti = column_index(got, "Title")
            if ci_st < 0:
                continue
            for row in rows:
                def cell(i):
                    return row[i].replace("*", "").strip() if 0 <= i < len(row) else ""
                if cell(ci_st) != "done":
                    continue
                rows_seen += 1
                tid = cell(ci_id) or "(unnamed row)"
                seen_ids.add(tid)
                rows_ranked += judge("BOARD.md", tid, cell(ci_ti),
                                     cell(ci_ev), cell(ci_v), stakes)

    # The closures that have already left the board. `done` removes the row,
    # so without this pass the check rated only work closed by hand — and on a
    # project using the tool, that is none of it.
    log = perry_dir / "events.jsonl"
    if log.exists():
        for line in log.read_text(errors="replace").split("\n"):
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            if e.get("event") != "done" or not e.get("id"):
                continue
            if e["id"] in seen_ids:
                continue          # still on the board; the row is canonical
            seen_ids.add(e["id"])
            rows_seen += 1
            rows_ranked += judge(".perry/events.jsonl", e["id"],
                                 e.get("title", ""), e.get("evidence", ""),
                                 (e.get("rung") or "").strip().upper(), stakes)

    if rows_seen and not rows_ranked:
        findings.append(Finding(
            "warn", "BOARD.md", "board-declares-no-rungs",
            f"{rows_seen} done row(s), none carrying a Verification column — "
            f"add one to start rating closures (advisory this release)",
        ))
    check_verification.rows_seen = rows_seen
    return findings



# ── provenance (DESIGN-003 § 5.4) ──────────────────────────────────────────


SRC_RE = re.compile(r"\bSRC-(\d+)\b")


def field_value(text: str, name: str) -> str | None:
    """A header field's value, in any accepted language, or None.

    Uses the **existing** `field_re` — which carries the `i18n.fields` aliases —
    rather than a second matcher. This function shipped with one for about ten
    minutes: a same-named `field_re` defined 750 lines below the original,
    silently shadowing it, so every caller of the original got a compiled
    pattern where it expected an alternation fragment and the default lint died
    with `multiple repeat at position 30`. One rule, two implementations, in the
    file whose whole job is finding that — caught by the suite, not by review.
    """
    m = re.search(rf"^\s*[->*]*\s*\**\s*{field_re(name)}\s*\**\s*[:：]\s*([^\n]*)$",
                  text, re.M)
    return m.group(1).strip().strip("*` ") if m else None


def card_kind(text: str) -> str | None:
    """The `Kind:` of a knowledge card, or None when this is not a card.

    The discriminator between a card and a digest, declared in
    `schema/state-schema.json § files[id=knowledge-card].discriminator` and
    read — never copied — by both `--knowledge` and `--provenance`. A digest
    carries no `Kind`, so `None` means "not mine" to the card check and "mine"
    to the provenance check, and neither reports the other's files.
    """
    v = field_value(text, "Kind")
    return v if v in CARD_KINDS else None


def resolves_somewhere(src: str, state_root: Path, project_root: Path) -> bool:
    """Can a reader re-open what this `Source:` names?

    Three forms are in circulation and all three are legitimate, so the check
    is "any token in the cell resolves" rather than a grammar:

    - a **path** — `evidence/2026-08/TASK-001-x.md`, resolved against the state
      root and then the project root, the same order `evidence_paths` uses;
    - a **`SRC-n`** — a digest in this tree carrying that id;
    - a **task id** — any id-shaped token the board or the event log knows.

    Deliberately permissive: this is advisory, and reporting a source that a
    human can plainly follow would train people to ignore the check. What it
    catches is the case that matters — a cell naming nothing that exists.

    **`project_root` is passed, never derived from `state_root`.** The first
    version computed `state_root.parent`, which is right only when the state
    root is nested. `resolve_state_root` returns the PROJECT root by default —
    so on every project that has not moved its state, that expression named the
    directory ABOVE the project, `.perry/events.jsonl` was looked for there,
    and a card citing the task id of a closed row was reported as dangling. The
    same wrong idiom was in `check_knowledge`, one screen down.
    """
    for tok in re.split(r"[\s,;·|]+", src.strip()):
        tok = tok.strip("*`()[]<>")
        if not tok:
            continue
        if "/" in tok or tok.endswith(".md"):
            if (state_root / tok).exists() or (project_root / tok).exists():
                return True
            continue
        if SRC_RE.fullmatch(tok):
            kdir = state_root / "knowledge"
            for md in (kdir.rglob("*.md") if kdir.exists() else []):
                if re.search(r"^>\s*Id\s*[:：]\s*" + re.escape(tok) + r"\b",
                             strip_comments(md.read_text(errors="replace")), re.M):
                    return True
            continue
        if re.fullmatch(r"[A-Z][A-Z0-9]{1,7}-\d+", tok):
            for hay in (state_root / "BOARD.md",
                        project_root / ".perry" / "events.jsonl"):
                if hay.exists() and tok in hay.read_text(errors="replace"):
                    return True
    return False


def check_role_cards(project_root: Path, schema: dict) -> list["Finding"]:
    """A role card is a hiring contract, never a workflow.

    `DESIGN-006 § 5.2`, decision #1. Each of the four blocks has a mechanical
    consumer — `Context` and `May touch` are rendered into the delegation
    prompt, `Loads` drives knowledge injection, `Must escalate` is **unioned**
    with the project high-stakes list in the dispatch pre-flight — and a fifth
    section is prose nothing reads.

    **The check is the closed set, not a blacklist of `## Workflow`.** That
    heading is only the first spelling; `## Steps`, `## Procedure`, `## How to`
    are the same violation wearing other names, and a guard written against the
    literal string is the instance-shaped guard this project has found in every
    review round. A card carrying a workflow-like heading gets a sharper
    message, because it made decision #1's exact mistake and deserves to be told
    which rule it broke.

    Advisory. The refusal belongs at `delegate` (phase D), where a card that
    cannot be rendered is a run that should not start.
    """
    spec = next((f for f in (schema.get("files") or [])
                 if f.get("id") == "role-card"), None)
    if not spec:
        return []
    sec = spec.get("sections") or {}
    allowed = set(sec.get("allowed") or [])
    workflowish = {w.lower() for w in (sec.get("workflow_like") or [])}
    findings: list[Finding] = []
    rdir = project_root / ".perry" / "roles"
    for md in sorted(rdir.glob("*.md")) if rdir.exists() else []:
        text = strip_comments(md.read_text(errors="replace"))
        rel = md.relative_to(project_root).as_posix()
        seen = set()
        for level, title, line in headings(text):
            if level != 2:
                continue
            seen.add(title)
            if title in allowed:
                continue
            if title.lower() in workflowish:
                findings.append(Finding(
                    "warn", rel, "role-card-is-a-workflow", line=line,
                    message=(
                        f"`## {title}` — a role card is a **hiring contract the "
                        f"harness instantiates, never a workflow** (DESIGN-006 "
                        f"decision #1). What the role *does* belongs in the "
                        f"task and the lane docs; this file says who it is, "
                        f"what it may touch, and what it must escalate.")))
            else:
                findings.append(Finding(
                    "warn", rel, "role-card-unknown-section", line=line,
                    message=(
                        f"`## {title}` is not one of "
                        f"{', '.join(sorted(allowed))}. Each of those four has "
                        f"a mechanical consumer — prompt, injection, "
                        f"pre-flight union, close gate — and a fifth section is "
                        f"prose nothing reads.")))
        for want in sorted(allowed - seen):
            findings.append(Finding(
                "warn", rel, "role-card-incomplete", line=1,
                message=(f"`## {want}` is missing. A card without it cannot be "
                         f"rendered into a delegation prompt.")))

        # An escalation line with no backticked span enforces NOTHING.
        #
        # The pre-flight scan extracts backticked fragments and matches those.
        # A line written as plain prose reads like a rule, sits under the
        # heading that carries the only hard field on the card, and contributes
        # zero fragments to the union — so the role looks constrained and is
        # not. This is the `hook_TEMPLATE.md` backtick bug, in the file that
        # inherited its extraction rule; DESIGN-006 § 7 names it as the same
        # failure class and this is the same fix.
        card = P.parse_role_card(md.stem, md.read_text(errors="replace"))
        for bullet in card.escalate_unextractable:
            findings.append(Finding(
                "warn", rel, "role-escalation-not-extractable",
                message=(
                    f"`Must escalate` line {bullet!r} has no backticked span, "
                    f"so it contributes nothing to the pre-flight scan. The "
                    f"union matches `backticked` fragments only: a prose line "
                    f"here reads as a rule and enforces nothing.")))
    return findings


def check_knowledge(state_root: Path, project_root: Path) -> list["Finding"]:
    """Every knowledge card can say where its claim came from and when.

    `DESIGN-006 § 5.3`: all four provenance fields are mandatory, because
    without them the store becomes a farm of confident errors that agents then
    execute against — strictly worse than no store. That is the axiom *no
    `done` without evidence*, extended to the knowledge layer.

    Advisory, like `--verification` and `--provenance`: it reports, it does not
    refuse. The refusal belongs at the write path (`DESIGN-006` phase B), where
    the person who knows the answer is still in the room.

    **`cards` is reported even when `violations` is 0.** `KR-O5.1` reads
    "lint live · 0 violations", and zero violations over zero cards is
    trivially true — a number that cannot distinguish "provenance is enforced"
    from "nobody has written a card". The count is what makes the KR mean
    something.
    """
    findings: list[Finding] = []
    kdir = state_root / "knowledge"
    stale_days = int((SCHEMA_THRESHOLDS.get("knowledge_stale_days")
                      or {}).get("value") or 90)
    today = date.today()
    # `.perry/` is anchored to the PROJECT root and never moves, so this takes
    # the project root rather than deriving it — see `resolves_somewhere`.
    rdir = project_root / ".perry" / "roles"
    roles_declared = rdir.exists() and any(rdir.glob("*.md"))

    for md in sorted(kdir.rglob("*.md")) if kdir.exists() else []:
        if md.name == "INDEX.md":
            continue
        text = strip_comments(md.read_text(errors="replace"))
        kind = card_kind(text)
        if kind is None:
            continue                      # a digest; `--provenance` owns it
        rel = md.relative_to(state_root).as_posix()

        for name in CARD_REQUIRED:
            val = field_value(text, name)
            if val and val not in UNDECLARED_CELL:
                continue
            # `Owner role` is the one field an em dash legitimately answers,
            # and only until roles exist. Saying so in the finding keeps a
            # pre-phase-C project from reading this as an error it must fix.
            if name == "Owner role":
                # **Silent until the project has roles.** `DESIGN-006 § 5.3`
                # writes the field as "`finance` — or `—` before roles exist",
                # so warning today would put a finding on every card in every
                # project until phase C lands, which is how a check teaches
                # people to ignore it. Once `.perry/roles/` holds a card there
                # IS an answer, and leaving it blank means nobody is
                # accountable for re-verifying the claim.
                if roles_declared:
                    findings.append(Finding(
                        "warn", rel, "card-unowned",
                        f"`Owner role` is undeclared on a project that has "
                        f"declared roles — nobody is accountable for "
                        f"re-verifying this claim."))
                continue
            findings.append(Finding(
                "warn", rel, "card-no-provenance",
                f"`{name}` is missing or blank. All four provenance fields are "
                f"mandatory: a card that cannot say where its claim came from, "
                f"when it was last true, or what would break it is a confident "
                f"error waiting to be executed against."))

        src = field_value(text, "Source")
        if src and src not in UNDECLARED_CELL:
            if not resolves_somewhere(src, state_root, project_root):
                findings.append(Finding(
                    "warn", rel, "card-source-dangling",
                    f"`Source: {src}` resolves to no file, task id or `SRC-n` "
                    f"in this project — a claim citing a source nobody can "
                    f"re-open is a claim about the agent's memory."))

        seen = field_value(text, "Last verified")
        if seen and re.fullmatch(r"\d{4}-\d{2}-\d{2}", seen):
            age = (today - date.fromisoformat(seen)).days
            if age > stale_days:
                trip = field_value(text, "Invalidated by")
                findings.append(Finding(
                    "warn", rel, "card-stale",
                    f"last verified {seen} ({age}d ago, threshold "
                    f"{stale_days}d)." + (
                        f" Its tripwire is {trip!r} — check whether that has "
                        f"happened rather than just re-dating it."
                        if trip and trip not in UNDECLARED_CELL else
                        " It names no tripwire, so age is the only signal "
                        "there is.")))
    return findings


def check_provenance(state_root: Path) -> list["Finding"]:
    """Every cited source resolves; every source has an origin and a date.

    Outside code, provenance IS the test suite. `modes/inquiry.md` lets a
    finding carry `[SRC-n]`, and the citation is worth nothing unless the id
    resolves to a digest that says where the material came from and when it was
    fetched — a claim citing a source nobody can re-open is a claim about the
    agent's memory.

    Advisory, like `--verification`: it reports, it does not refuse.
    """
    findings: list[Finding] = []
    kdir = state_root / "knowledge"

    # 1. Build the id → file map, reporting malformed and duplicate ids.
    defined: dict[str, Path] = {}
    for md in sorted(kdir.rglob("*.md")) if kdir.exists() else []:
        if md.name == "INDEX.md":
            continue
        text = strip_comments(md.read_text(errors="replace"))
        rel = md.relative_to(state_root).as_posix()
        # A knowledge CARD and a digest share this glob. A card is a claim the
        # project made; a digest is a source it read. Neither is malformed for
        # not being the other, so each check skips the other's files — the
        # discriminator is declared once, in the schema, and read by both.
        if card_kind(text):
            continue
        m = re.search(r"^>\s*Id\s*[:：]\s*(\S+)", text, re.M)
        if not m:
            findings.append(Finding(
                "warn", rel, "source-has-no-id",
                "digest carries no `Id: SRC-<n>` — nothing can cite it",
            ))
            continue
        sid = m.group(1).strip("*` ")
        if not SRC_RE.fullmatch(sid):
            findings.append(Finding(
                "warn", rel, "source-id-malformed",
                f"`Id: {sid}` is not of the form SRC-<n>",
            ))
            continue
        if sid in defined:
            findings.append(Finding(
                "warn", rel, "source-id-reused",
                f"{sid} is already defined by {defined[sid]} — ids are minted "
                f"once and never reused, or an old citation silently re-points",
            ))
            continue
        defined[sid] = rel
        for field, rule in (("Source", "origin"), ("Received", "fetch date")):
            if not re.search(rf"^>\s*{field}\s*[:：]\s*\S", text, re.M):
                findings.append(Finding(
                    "warn", rel, "source-missing-field",
                    f"{sid} has no `{field}:` — a source with no {rule} cannot "
                    f"be re-verified, which is what citing it was for",
                ))

    # 2. Every citation anywhere in the state tree must resolve.
    cited: dict[str, list[str]] = {}
    for md in sorted(state_root.rglob("*.md")):
        if kdir.exists() and kdir in md.parents:
            continue
        try:
            text = strip_comments(md.read_text(errors="replace"))
        except (UnicodeDecodeError, OSError):
            continue
        rel = md.relative_to(state_root).as_posix()
        for sid in {f"SRC-{n}" for n in SRC_RE.findall(text)}:
            cited.setdefault(sid, []).append(rel)
    for sid, where in sorted(cited.items()):
        if sid not in defined:
            findings.append(Finding(
                "warn", where[0], "citation-dangling",
                f"{sid} is cited in {len(where)} file(s) and defined by no "
                f"digest under knowledge/",
            ))

    check_provenance.stats = {"defined": len(defined), "cited": len(cited)}
    return findings


# ── main ──────────────────────────────────────────────────────────────────


def is_adopted(project_root: Path, state_root: Path) -> bool:
    """Has this project any Perry state at all?

    Linting a folder that has never been adopted used to report every required
    file as missing — noise on someone else's project, and unusable as the
    stage-4 gate in `reference/adoption.md`, which needs to distinguish "the
    files adoption wrote are malformed" from "adoption hasn't run"."""
    return ((project_root / ".perry" / "config.md").exists()
            or (state_root / "BOARD.md").exists()
            or (state_root / "OKR.md").exists()
            or (state_root / "phase").is_dir())


def iter_targets(root: Path, spec: dict) -> list[Path]:
    pattern = spec["path"]
    exclude = spec.get("exclude")
    if any(ch in pattern for ch in "*?["):
        out = sorted(root.glob(pattern))
    else:
        p = root / pattern
        out = [p] if p.exists() else []
    if exclude:
        out = [p for p in out if not fnmatch.fnmatch(p.relative_to(root).as_posix(), exclude)]
    return [p for p in out if p.is_file()]


def check_claims(project_root: Path, schema: dict, state_root: Path) -> tuple[list, dict]:
    """What Perry would occupy here, and what is already there.

    `claims[]` is the one authoritative list — `files[]` describes the files
    Perry VALIDATES, this describes the territory Perry OCCUPIES, and the two
    are different units. Perry writes `journal/<YYYY-MM>/<YYYY-MM-DD>.md`, but
    the thing that collides with a user's folder is `journal/`, and no prefix
    of that glob is the claim.

    A directory already holding genuine Perry state is a RE-ADOPTION, not a
    collision. Only a parse can tell the two apart, so this reuses the same
    heading check the default mode runs rather than a second heuristic."""
    claims = schema.get("claims") or []
    rows, collisions = [], 0
    for c in claims:
        base = project_root if c["anchor"] == "project" else state_root
        target = base / c["path"].rstrip("/")
        if not target.exists():
            rows.append({"path": c["path"], "state": "free", "owner": c["owner"],
                         "detail": None})
            continue
        # Perry-shaped? Anything we would have written is not a collision.
        if c["kind"] == "dir":
            present = [f for f in sorted(target.rglob("*.md"))]
        else:
            present = [target]
        foreign = [f for f in present if not looks_like_perry_state(f, schema, c)]
        if not present:
            rows.append({"path": c["path"], "state": "free", "owner": c["owner"],
                         "detail": "exists but empty"})
        elif foreign:
            collisions += 1
            rows.append({"path": c["path"], "state": "collision", "owner": c["owner"],
                         "detail": f"{len(foreign)} file(s) Perry did not write, "
                                   f"e.g. {foreign[0].relative_to(project_root)}"})
        else:
            rows.append({"path": c["path"], "state": "perry", "owner": c["owner"],
                         "detail": f"{len(present)} existing Perry file(s)"})
    return rows, {"claimed": len(claims), "collisions": collisions}


def looks_like_perry_state(path: Path, schema: dict, claim: dict) -> bool:
    """Would Perry have written this file?

    Deliberately generous: the cost of a false 'yes' is one collision Perry
    fails to warn about, while a false 'no' reports the user's own adopted
    state as foreign and pushes them to relocate a working project."""
    if path.name in ("README.md", "INDEX.md"):
        return True
    # The conformance record is Perry's own bookkeeping and deliberately not a
    # `files[]` entry (it records decisions ABOUT state, not state), so the loop
    # below cannot see it. Named from `parsers` rather than spelled out here —
    # one name, one definition.
    if path.name == Path(P.CONFORMANCE_FILE).name:
        return True
    stem = path.stem
    # Perry names its own artifacts: DESIGN-001-…, ADR-002-…, 001-slug, dates.
    if re.match(r"^(DESIGN|ADR|TASK|USER)-\d", stem) or re.match(r"^\d{3}-", stem):
        return True
    if re.match(r"^\d{4}-\d{2}(-\d{2})?$", stem) or re.match(r"^\d{4}-W?\d{2}$", stem):
        return True
    for spec in schema["files"]:
        if Path(spec["path"]).name == path.name:
            return True
    try:
        head = path.read_text(encoding="utf-8", errors="replace")[:2000]
    except OSError:
        return False
    return "Owner**: `perry`" in head or "$PERRY_HOME" in head


def render_claims(project_root: Path, state_root: Path, rows: list, summary: dict,
                  suggested: str | None) -> None:
    rel = state_root.relative_to(project_root).as_posix() or "."
    print(f"\n🚧 Namespace check · {project_root.name} · candidate state root: {rel}\n")
    print(f"   Claimed by Perry : {summary['claimed']} paths")
    print(f"   Already present  : {summary['collisions']} collision(s)\n")
    shown = [r for r in rows if r["state"] != "free"]
    if not shown:
        print("   ✓ nothing Perry claims is taken — the project root is safe")
    for r in shown:
        mark = "✗" if r["state"] == "collision" else "·"
        print(f"   {mark} {r['path']:<18} {r['detail']}")
    if suggested:
        print(f"\n   Suggested state root: {suggested}   (0 collisions)")
    print()


def main(argv: list[str]) -> int:
    root_arg = None
    mode_templates = mode_claims = mode_verification = False
    mode_provenance = mode_knowledge = False
    as_json = strict = quiet = False
    state_root_arg = None
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        elif a == "--root":
            i += 1
            root_arg = argv[i] if i < len(argv) else None
        elif a == "--templates":
            mode_templates = True
        elif a == "--claims":
            mode_claims = True
        elif a == "--verification":
            mode_verification = True
        elif a == "--provenance":
            mode_provenance = True
        elif a == "--knowledge":
            mode_knowledge = True
        elif a == "--state-root":
            i += 1
            state_root_arg = argv[i] if i < len(argv) else None
        elif a == "--json":
            as_json = True
        elif a == "--strict":
            strict = True
        elif a == "--quiet":
            quiet = True
        else:
            print(f"perry-lint: unknown argument {a!r} (try --help)", file=sys.stderr)
            return 2
        i += 1

    if not SCHEMA_PATH.exists():
        print(f"perry-lint: schema not found at {SCHEMA_PATH}", file=sys.stderr)
        return 2
    schema = json.loads(SCHEMA_PATH.read_text())
    enums = schema["enums"]
    SCHEMA_THRESHOLDS.update(schema.get("thresholds") or {})

    if mode_claims:
        project_root = (Path(root_arg).expanduser().resolve() if root_arg
                        else Path.cwd().resolve())
        if state_root_arg:
            state_root = (project_root / state_root_arg).resolve()
        else:
            state_root = P.resolve_state_root(project_root)
        rows, summary = check_claims(project_root, schema, state_root)

        # Only propose an alternative when the current candidate actually
        # collides — a clean root must cost the user zero questions.
        suggested = None
        if summary["collisions"] and not state_root_arg:
            for candidate in ("perry", "_perry", ".perry-state"):
                alt = (project_root / candidate).resolve()
                _, alt_sum = check_claims(project_root, schema, alt)
                if not alt_sum["collisions"]:
                    suggested = f"{candidate}/"
                    break
        if as_json:
            print(json.dumps({
                "project_root": str(project_root),
                "state_root": state_root.relative_to(project_root).as_posix() or ".",
                "claimed": summary["claimed"],
                "collisions": summary["collisions"],
                "suggested_state_root": suggested,
                "paths": rows,
            }, ensure_ascii=False, indent=2))
        elif not quiet:
            render_claims(project_root, state_root, rows, summary, suggested)
        # A collision is a fact to act on, not a failure — and `--strict` does
        # NOT promote it. There is no per-path opt-out by design (DESIGN-002
        # decision #2), so a project that knowingly keeps one file in a claimed
        # folder would otherwise have permanently red CI with no way to accept
        # it. Same reasoning that keeps NS-01 at `warn`. Branch on the
        # `collisions` count in --json instead.
        return 0

    if mode_verification:
        project_root = (Path(root_arg).expanduser().resolve() if root_arg
                        else Path.cwd().resolve())
        state_root = ((project_root / state_root_arg).resolve() if state_root_arg
                      else P.resolve_state_root(project_root))
        findings = check_verification(state_root, project_root / ".perry")
        scanned = getattr(check_verification, "rows_seen", 0)
        if as_json:
            print(json.dumps({
                "project_root": str(project_root),
                "done_rows_scanned": scanned,
                "findings": [f.as_dict() for f in findings],
                "count": len(findings),
            }, ensure_ascii=False, indent=2))
        elif not quiet:
            print(f"perry-lint --verification · {project_root}")
            for f in findings:
                print(f)
            if findings:
                tail = f"\n  {len(findings)} advisory finding(s) over {scanned} done row(s)"
            elif scanned:
                tail = f"\n  ✓ all {scanned} done row(s) carry a satisfiable rung"
            else:
                # Not a pass. Perry's own board moves closed rows out of the
                # P-sections into `## Done this period`, so an empty scan is the
                # normal state there — say so rather than printing a checkmark
                # for having checked nothing.
                tail = ("\n  · no done rows under P0/P1/P2 to rate "
                        "(closed rows leave those sections at triage)")
            print(tail)
        # Advisory for one release by DESIGN-003 decision 4 — a hard gate now
        # would retroactively invalidate every `done` row written before rungs
        # existed. `--strict` does NOT promote these; branch on --json `count`.
        return 0


    if mode_knowledge:
        project_root = (Path(root_arg).expanduser().resolve() if root_arg
                        else Path.cwd().resolve())
        state_root = ((project_root / state_root_arg).resolve() if state_root_arg
                      else P.resolve_state_root(project_root))
        load_glossary(schema)
        findings = check_knowledge(state_root, project_root) + check_role_cards(
            project_root, schema)
        kdir = state_root / "knowledge"
        cards = sum(1 for md in (kdir.rglob("*.md") if kdir.exists() else [])
                    if md.name != "INDEX.md"
                    and card_kind(strip_comments(md.read_text(errors="replace"))))
        if as_json:
            print(json.dumps({
                "project_root": str(project_root),
                "cards": cards,
                "findings": [f.as_dict() for f in findings],
                "count": len(findings),
            }, ensure_ascii=False, indent=2))
        elif not quiet:
            print(f"perry-lint --knowledge · {project_root}")
            for f in findings:
                print(f)
            # **The count is printed even at zero findings.** `KR-O5.1` reads
            # "0 violations", and zero over zero cards is trivially true — a
            # number that cannot tell "provenance is enforced" from "nobody has
            # written a card". Printing both is what makes the KR mean
            # something.
            print(f"\n  {cards} card(s) · {len(findings)} advisory finding(s)"
                  if findings else
                  f"\n  ✓ {cards} card(s), every provenance field present and "
                  f"resolving" if cards else
                  "\n  · no knowledge cards yet — the check is live and has "
                  "nothing to judge")
        return 0

    if mode_provenance:
        project_root = (Path(root_arg).expanduser().resolve() if root_arg
                        else Path.cwd().resolve())
        state_root = ((project_root / state_root_arg).resolve() if state_root_arg
                      else P.resolve_state_root(project_root))
        # Arms `CARD_KINDS`, without which `card_kind()` is always None and
        # every knowledge card is reported here as a digest with no id.
        load_glossary(schema)
        findings = check_provenance(state_root)
        stats = getattr(check_provenance, "stats", {"defined": 0, "cited": 0})
        if as_json:
            print(json.dumps({
                "project_root": str(project_root),
                "sources_defined": stats["defined"],
                "ids_cited": stats["cited"],
                "findings": [f.as_dict() for f in findings],
                "count": len(findings),
            }, ensure_ascii=False, indent=2))
        elif not quiet:
            print(f"perry-lint --provenance · {project_root}")
            for f in findings:
                print(f)
            if findings:
                print(f"\n  {len(findings)} advisory finding(s)")
            elif stats["defined"] or stats["cited"]:
                print(f"\n  ✓ {stats['cited']} cited id(s) all resolve; "
                      f"{stats['defined']} source(s) carry an origin and a date")
            else:
                # Same discipline as --verification: an empty scan is not a pass.
                print("\n  · no digests under knowledge/ and no citations to check")
        return 0

    # Localized column headers are legal in whatever the project's document
    # language is; the glossary that says which spellings count lives in the
    # schema so every reader (this linter, viewer/parsers.py, aiMark) agrees.
    # Loaded HERE and not above the early-returning modes on purpose: that is
    # where it has always been loaded, and moving it would quietly change what
    # `--verification` matches on a localized board.
    load_glossary(schema)

    findings: list[Finding] = []

    if mode_templates:
        root = PERRY_HOME
        for spec in schema["files"]:
            tpl = spec.get("template")
            if not tpl:
                continue
            path = PERRY_HOME / tpl
            if not path.exists():
                findings.append(Finding("error", tpl, "missing-template",
                                        "schema names this template but the file is absent"))
                continue
            findings.extend(check_file(path, tpl, spec, enums, is_template=True))
        label = f"templates in {PERRY_HOME}"
    else:
        project_root = Path(root_arg).expanduser().resolve() if root_arg else Path.cwd().resolve()
        if not root_arg:
            for d in [project_root, *project_root.parents]:
                if ((d / "BOARD.md").exists() or (d / "OKR.md").exists()
                        or (d / ".perry" / "config.md").exists()):
                    project_root = d
                    break
        # State may live in a subdirectory when the project already uses a name
        # Perry claims; `.perry/` stays at the project root either way.
        root = P.resolve_state_root(project_root)
        adopted = is_adopted(project_root, root)
        for spec in schema["files"]:
            base = project_root if spec.get("anchor") == "project" else root
            # Nothing outside `.perry/` can be malformed Perry state before the
            # project is a Perry project: a pre-existing `design/` belongs to
            # whoever built it, and reporting their file as a broken design doc
            # is Perry claiming a namespace it was never given.
            if not adopted and spec.get("anchor") != "project":
                continue
            targets = iter_targets(base, spec)
            if not targets:
                # "required" means required OF A PERRY PROJECT. On a folder that
                # has never been adopted it is not a finding, it is the answer.
                if spec.get("required") and adopted:
                    findings.append(Finding("error", spec["path"], "missing-file",
                                            "required state file not found"))
                continue
            for path in targets:
                # Same rule `perry-conform § state_files` applies, so a file
                # lint validates and a file that can be declared conformant
                # cannot come apart. One function, two call sites, no copy.
                if not spec_claims(spec, strip_comments(
                        path.read_text(errors="replace")), schema):
                    continue
                try:
                    rel = path.relative_to(project_root).as_posix()
                except ValueError:
                    rel = path.as_posix()
                findings.extend(check_file(path, rel, spec, enums, is_template=False))
        if adopted:
            findings.extend(check_cross_file(root, enums, project_root))
        label = str(project_root)
        if root != project_root:
            label += f" (state root: {root.relative_to(project_root).as_posix()}/)"
        if not adopted:
            label += " — not a Perry project yet"
        # The declaration ADR-004 needs is a DIFFERENT fact from anything above:
        # this loop answers "does the shape hold", and that answers "did the user
        # say so". Reported as a note rather than as a Finding — a project that
        # has simply not run `perry-conform declare` yet is not malformed, and
        # promoting it to a warning would make `--strict` red on every project
        # in existence for a reason lint cannot fix.
        declared = P.read_conformance(project_root).declarations
        conformance_note = {
            "declared": len(declared),
            "shape_version": schema.get("schema_version"),
            "command": "perry-conform status",
        }

    errors = [f for f in findings if f.severity == "error"]
    warns = [f for f in findings if f.severity == "warn"]

    if as_json:
        payload = {
            "target": label,
            "errors": len(errors), "warnings": len(warns),
            "findings": [f.as_dict() for f in findings],
        }
        if not mode_templates:
            payload["conformance"] = conformance_note
        print(json.dumps(payload, ensure_ascii=False, indent=2))
    elif not quiet:
        print(f"perry-lint · {label}")
        if not findings:
            print("  ✓ clean — every state file matches schema/state-schema.json")
        else:
            for f in errors + warns:
                print(f)
            print(f"\n  {len(errors)} error(s), {len(warns)} warning(s)")
        if not mode_templates:
            n = conformance_note["declared"]
            print(f"  · {n} file(s) declared conformant at shape version "
                  f"{conformance_note['shape_version']} "
                  f"(`perry-conform status` for the per-file verdict)")

    if errors:
        return 1
    return 1 if (strict and warns) else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as exc:
        print(f"perry-lint: {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(2)
