def check_ask_store_drift(project_root: Path, state_root: Path) -> list["Finding"]:
    """`## User Input Queue` and `asks.jsonl` disagree — ADR-007, TASK-197.

    The same posture, the same `warn`, and silent-with-a-payload when there is
    no store, as the three checks above. The key is the `USER-` id, so this is
    `check_risk_store_drift`'s comparison rather than the intake one: an
    inserted line renumbers `order` and renames nothing, so `_order_drift`'s
    argument applies and the rows keep their own names.

    **`Idle` is not compared and cannot drift, because no stored field claims
    it.** It is an age derived from `Asked` at read time (`bin/perry-state §
    idle_days`); a hand edit to that cell changes a number the store never
    asserted, so reporting it would be this checker inventing a claim to
    enforce. `Asked` IS compared — the input the age comes from is stored, and
    editing it moves every age computed from it.
    """
    findings: list[Finding] = []
    check_ask_store_drift.stats = _empty_ask_store_drift_stats()

    store_path = _STORE.ask_store_path(state_root)
    if not store_path.exists():
        return []

    check_ask_store_drift.stats["store_present"] = True
    rel_store = _rel(store_path, project_root)
    try:
        on_disk = [json.loads(line) for line in
                   store_path.read_text(errors="replace").split("\n")
                   if line.strip()]
    except (OSError, ValueError) as exc:
        return [Finding("warn", rel_store, "ask-store-unreadable",
                        f"`asks.jsonl` is not readable as JSONL "
                        f"({type(exc).__name__}: {exc}) — there is nothing to "
                        f"compare `## User Input Queue` against")]
    if not all(isinstance(r, dict) for r in on_disk):
        return [Finding("warn", rel_store, "ask-store-unreadable",
                        "`asks.jsonl` holds something other than one JSON "
                        "OBJECT per line — a whole-file array and a bare "
                        "scalar both parse and neither is a record")]

    # **A badly-typed record is a fact about the store** and is reported
    # on every project. Until TASK-262 round 4b this was reached only
    # after a held board had been derived, so a board-less project never
    # heard it; with the comparison gone it must not go too.
    good, issues = _STORE.validate_ask_records(on_disk)
    findings = []
    for issue in issues:
        who = issue.get("id") or f"line {issue['line']}"
        findings.append(Finding(
            "warn", rel_store, "ask-store-badly-typed",
            f"{who} — {issue['message']}. The record is excluded "
            f"from the board the stores print, and `perry-tasks board` "
            f"refuses while it is there."))
    check_ask_store_drift.stats["records"] = len(good)
    # No board file is read, so no drift (TASK-262 round 4b) —
    # `check_store_drift` says why.
    return findings


