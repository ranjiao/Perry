#!/usr/bin/env python3
"""
perry-lint — validate a Perry project's state files against schema/state-schema.json.

Perry's state format is described in three places: SKILL.md prose, the
`state/*_TEMPLATE.md` files, and `viewer/parsers.py`. This script is what keeps
them honest — it checks real files (and, with --templates, Perry's own
templates) against the one declared schema.

Usage:
  perry-lint [--root <project_root>] [--templates | --claims | --verification |
              --provenance | --knowledge | --reviews | --glossary | --specs |
              --summaries]
             [--json]
             [--state-root <path>] [--strict] [--quiet]

The default pass also reports `store-drift`: when `<state root>/tasks.jsonl`
exists, a rendered file whose fields disagree with what the store would produce
(ADR-007 decision 2 — the board is rendered output, so a hand edit is drift).
`warn`, on the `NS-01` precedent, and SILENT when there is no store, because
"no store" and "clean" are different answers.

**The census covers ALL SEVEN declared stores, one verdict line each, on one
run** (TASK-209): `tasks.jsonl`, `risks.jsonl`, `intake.jsonl`, `asks.jsonl`,
`okr.jsonl`, `linkage.jsonl` and `.perry/config.jsonl`. It said SIX until
2026-09-09 and printed seven lines — `linkage.jsonl` became the seventh under
TASK-276 and nothing updated the sentence, which is the drift DESIGN-016 § 1.6
counted. It covered two for a while — `okr.jsonl` and `.perry/config.jsonl`
printed nothing at all while `perry-okr diff` and `perry-config diff` compared
both of them clean on the same tree the same day, so a guarantee that claimed
six files was checked on a third of them. Those two reach the SAME comparator
through `bin/perry_md_store.py` rather than a third and fourth copy of it. An
absent store is still an absence line and never a clean verdict; seven lines is
not seven clean answers.

On an adopted project the default pass also emits `NS-01` (DESIGN-002 decision
4) when a directory Perry claims holds files Perry did not write — the same
computation `--claims` performs, so the two can never disagree. It is `warn`,
and it is the one warning `--strict` does not promote: DESIGN-002 § 9 says a
collision never sets a non-zero exit, and with no per-path opt-out there would
otherwise be no way to accept one.

  --templates   lint Perry's own state/*_TEMPLATE.md instead of a project.
                This is the drift guard: a template that stops matching the
                schema is what silently breaks the standup.
  --claims      report which paths Perry would claim in this folder are already
                taken by someone else's files. Runs BEFORE adoption, so unlike
                the default mode it is deliberately NOT gated on is_adopted() —
                a collision check that only ran on adopted projects would answer
                the question after the moment it mattered.
  --verification  advisory pass over every done row's verification rung
                (DESIGN-003 section 5.3): a missing rung, a rung the cited
                evidence cannot satisfy, and any row matching the project's
                own high-stakes list that closed below V5. Never sets a
                non-zero exit - advisory for one release by decision 4.
  --glossary    advisory pass over reference/glossary.md: every concept names
                where it is implemented, that path exists, and no term is
                defined but unused. Prints the prose-only count, which is the
                brake on adding concepts that nothing implements.
  --reviews     advisory pass over V4 VERDICT blocks (work/reference/review.md
                section 3): every block readable, every FAIL naming a file, every
                V4 close carrying one, and no row left at `review` after its
                own verdict already failed it. Also reports a row that has
                FAILed TWICE without escalating (`review-rounds-exhausted`) —
                round 3 is where this board stopped converging. That limit is
                `schema § thresholds.review_fail_rounds_before_escalation`,
                overridable per project (`- Review rounds before escalation:`)
                and per run (`PERRY_REVIEW_ROUNDS`); the finding names its
                source. Also runs the two PRE-CHECK findings review.md
                section 2 moves out of the round itself: a cited path the
                branch does not carry (`citation-not-on-branch`) and a
                criteria file with no `## Bound` (`criteria-unbounded`). With
                --strict this mode EXITS NON-ZERO, which is what lets a red
                exhibit stop a dispatch instead of costing a round. Prints the
                block count even at zero findings.
  --knowledge   advisory pass over knowledge CARDS (DESIGN-006 section 5.3):
                the four provenance fields present, `Source:` resolving to
                something a reader can re-open, and staleness against
                thresholds.knowledge_stale_days. Prints the card count even at
                zero findings, because zero over zero cards is not a result.
                Cards and digests share `knowledge/*/*.md` and are told apart
                by the card's `Kind:`; this skips digests and --provenance
                skips cards.
  --provenance  advisory pass over source citations (DESIGN-003 section 5.4):
                every `SRC-n` cited anywhere resolves to a digest under
                knowledge/, every digest carries an id, an origin and a
                fetch date, and no id is reused. Never exits non-zero.
  --specs       the full, uncapped form of TWO checks the DEFAULT pass already
                runs — `perry-lint --root .` reports `spec-scope-unscannable`
                and `spec-unbounded` on its own, names the first ten of each
                and counts the rest, so this flag is for the whole list, not
                for turning the checks on.
                Advisory pass over `evidence/**/*-spec.md`: every spec the
                dispatch pre-flight must read actually offers it a
                `## Files in scope` or `## Deliverable` section to read, and
                every spec carries a `## Bound` so a round against it has a
                finite set to check and a last element (`review.md § 1`).
                `spec-unbounded` is the SPEC-side half of the bound rule and
                answers "this spec cannot end a round"; `criteria-unbounded`
                under --reviews is the verdict-side half and answers "this
                round scored against an unbounded criterion". The second
                cannot speak until a round has already run, which is why on
                2026-09-03 it read 0 across 127 unbounded specs (TASK-308).
                Presence and shape only — whether a bound is WELL DRAWN is the
                reviewer's judgement and is deliberately not checked.
                A spec with neither is matched against the empty string and
                reports `verdict: pass` with `touches: {}` — output identical
                to a spec read in full and found clean, which is why an empty
                scan has to be REPORTED rather than inferred from a green
                verdict (TASK-284). Prints the spec count even at zero
                findings. With --strict this mode EXITS NON-ZERO, so a
                dispatcher can refuse to run a pre-flight over nothing.
  --summaries   the full, uncapped form of a check the DEFAULT pass already
                runs, like --specs above. Advisory pass over every OPEN task
                row's `summary` — the field `perry-explain` prints and a
                front-end renders, which is why a blank one costs a reader
                who was not in the conversation that filed the row.
                STRUCTURAL ONLY. It reports two things: the field is absent
                (`summary-missing`); it restates the title after folding case
                and punctuation (`summary-repeats-title`). It used to report
                two more — no sentence terminator, and under five tokens —
                until TASK-330 removed them on 2026-09-03, because how well a
                summary reads is the writing agent's job and not this one's.
                It does NOT judge whether the prose
                is readable, plain, well-written, or true, and must not be
                quoted as though it does — see `summary_shape`'s docstring for
                the list of properties deliberately not checked and why,
                including the one this row's own spec proposed and the corpus
                refuted. Closed rows are not scanned; they are history.
  --state-root  with --claims, test a candidate state root other than the one
                .perry/config.jsonl declares (or `.` when there is none).
  --json        machine-readable findings
  --strict      warnings count as failures
  --quiet       print nothing; use the exit code

Exit codes:
  0  clean (or warnings only, without --strict)
  1  errors found
  2  bad invocation / unreadable schema

No LLM, no external dependencies (stdlib only). Read-only.
"""

from __future__ import annotations

import fnmatch
import json
import os
import re
import sys
from datetime import date
from pathlib import Path

HERE = Path(__file__).resolve().parent
PERRY_HOME = Path(os.environ.get("PERRY_HOME") or HERE.parent).resolve()
SCHEMA_PATH = PERRY_HOME / "schema" / "state-schema.json"

# Frontmatter files are read with the SAME reader Perry uses, so "the linter
# passed" and "Perry can read it" cannot diverge.
sys.path.insert(0, str(PERRY_HOME / "viewer"))
sys.path.insert(0, str(PERRY_HOME / "bin"))
import lib  # noqa: E402
import parsers as P
from tables import header_index, split_row, squash  # noqa: E402

PLACEHOLDER = re.compile(r"\{\{.*?\}\}")


class Finding:
    def __init__(self, severity: str, file: str, rule: str, message: str, line: int | None = None):
        self.severity = severity
        self.file = file
        self.rule = rule
        self.message = message
        self.line = line

    def as_dict(self) -> dict:
        return {
            "severity": self.severity, "file": self.file, "rule": self.rule,
            "message": self.message, "line": self.line,
        }

    def __str__(self) -> str:
        mark = {"error": "✗", "warn": "⚠"}.get(self.severity, "·")
        where = f"{self.file}:{self.line}" if self.line else self.file
        return f"  {mark} {where} [{self.rule}] {self.message}"


# ── markdown helpers ──────────────────────────────────────────────────────

#: A phase-KR id. **Segment-labelled and project-unique** — DESIGN-007
#: decision #4, locked 2026-08-19: `P002-O3-KR1` is phase 002, objective 3,
#: key result 1, and every segment carries its own label rather than relying
#: on position. Migrated by TASK-180.
KR_ID_RE = r"\bP\d{3}-O\d+-KR\d+\b"

#: The form this project used before TASK-180: `P-O3.1` [[old-form]], whose
#: phase lived nowhere in the id. It is kept here to be **rejected**, not to
#: be read.
#:
#: The user's instruction was one-time migration with *no compatibility with
#: the old form*, and a regex that simply stopped matching would have honoured
#: the letter and broken the spirit: `check_cross_file` reads a phase file's
#: KR set with `KR_ID_RE` and then guards every comparison with
#: `if own_krs and …`. Handed a file still written in the old form, that set
#: comes back EMPTY and every linkage check downstream silently passes. A
#: check that can be handed the old id and do nothing is the compatibility
#: branch wearing a different hat. So `check_legacy_kr_ids` below turns the
#: old form into an `error`, and the silence becomes a sentence.
LEGACY_KR_ID_RE = r"\bP-O\d+\.\d+\b"
RE_COMMENT = re.compile(r"<!--.*?-->", re.S)


def strip_comments(text: str) -> str:
    return RE_COMMENT.sub("", text)


def headings(text: str) -> list[tuple[int, str, int]]:
    """(level, text, line_no) for every ATX heading."""
    out = []
    in_fence = False
    for i, line in enumerate(text.split("\n"), start=1):
        if line.lstrip().startswith("```"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = re.match(r"^(#{1,6})\s+(.*)$", line)
        if m:
            out.append((len(m.group(1)), m.group(2).strip(), i))
    return out


def section_body(text: str, level: int, matcher: re.Pattern) -> list[tuple[str, int]]:
    """Bodies of every section whose heading matches, as (body, start_line)."""
    lines = text.split("\n")
    heads = headings(text)
    out = []
    for idx, (lvl, htext, lineno) in enumerate(heads):
        if lvl != level or not matcher.search(htext):
            continue
        end = len(lines)
        for lvl2, _, line2 in heads[idx + 1:]:
            if lvl2 <= level:
                end = line2 - 1
                break
        out.append(("\n".join(lines[lineno:end]), lineno))
    return out


def tables(section: str) -> list[tuple[list[str], list[list[str]]]]:
    """Every markdown table in the section as (header_cells, data_rows).

    Rows are split by `viewer/tables.py § split_row` — the same function the
    writer's `render_row` is the inverse of, and the same one every reader in
    `viewer/parsers.py` uses. This file used to carry its own
    naive split on every `|`, which did not honour the escape, so the linter read
    eight cells where the contract reader read seven on a row `perry-task`
    itself had written, and reported `bad-enum Verification = '—'` against a
    correctly-formed row. A checker that reads a file differently from the
    tool that wrote it does not check that file.
    """
    return [(h, [c for c, _ in r]) for h, r in tables_with_lines(section)]


def tables_with_lines(
        section: str) -> list[tuple[list[str], list[tuple[list[str], int]]]]:
    """`tables()`, with each row's 0-based offset inside `section`.

    **`ragged-row` reported the section heading's line, not the row's** — a
    row at `BOARD.md:21` was reported at `:15`, so the one finding whose whole
    job is "go look at this line" sent the reader to a heading. On a board with
    forty rows under one heading that is not a small imprecision; it is the
    difference between a pointer and a gesture.

    This is the real implementation and `tables()` is a view of it, rather than
    a second scanner beside it — the defect this file has been fixing all week.
    """
    out: list[tuple[list[str], list[tuple[list[str], int]]]] = []
    prev: list[str] = []
    header: list[str] | None = None
    rows: list[tuple[list[str], int]] = []
    for n, line in enumerate(section.split("\n")):
        s = line.strip()
        if re.match(r"^\|\s*:?-{2,}", s):
            header = [c.strip() for c in prev]
            rows = []
            continue
        if s.startswith("|"):
            cells = split_row(s)
            if header is None:
                prev = cells
            else:
                rows.append((cells, n))
            continue
        if header is not None:
            out.append((header, rows))
            header = None
        prev = []
    if header is not None:
        out.append((header, rows))
    return out


#: `perry-task` defined this character-for-character under the name `squash`.
#: One rule, one implementation — extracted for TASK-037.
norm = squash


# ── localized column headers ──────────────────────────────────────────────
#
# A project writes its state files in the language declared by
# `.perry/config.jsonl`'s `document_language`. Section headings are handled by the
# `match` regexes in the schema (each carries its localized alternatives);
# table column headers are exact strings, so they resolve through the
# `i18n.columns` glossary instead. Populated once from the schema in main();
# empty means "English only", which is the correct behaviour for a schema
# that declares no glossary.
COLUMN_ALIASES: dict[str, list[str]] = {}
FIELD_ALIASES: dict[str, list[str]] = {}
HEADING_ALIASES: dict[str, list[str]] = {}

#: mode -> the columns that mode has no honest default for, read from
#: `schema/state-schema.json § work_modes.modes.<mode>.no_default`. Read, never
#: copied: the moment this file carried its own list of which modes need an
#: `SLA`, the schema's list and the linter's list would be two answers to one
#: question, which is the defect ADR-004 is about.
MODE_NO_DEFAULT: dict[str, list[str]] = {}

#: Separators a `## Tracks` § Stages cell may use, and the ones that look like
#: separators and are not — read from `schema/state-schema.json §
#: work_modes.stage_separators`, never copied. `bin/perry-state § split_stages`
#: reads the SAME list, so the splitter and the check below cannot disagree
#: about what an accepted separator is. Two answers to that question is what
#: put the `->` / `→` bug in circulation to begin with.
STAGE_SEPARATORS: dict[str, list[str]] = {}

#: `schema § enums`, whole. `check_file`'s header-field check reaches the same
#: table through its `enums` local; `check_config_store` has no file spec to
#: carry one, so it reads this.
DECLARED_ENUMS: dict[str, list[str]] = {}

#: `{track field: enum name}` — `mode` and `default_rung`. It was
#: `files[id=config].tables[Tracks].enum_columns` until ADR-019 and is
#: `stores.declared[".perry/config.jsonl"].records.track.enum_fields` now.
#: Read, never restated: a mode the schema stops declaring must stop being
#: accepted here in the same edit.
TRACK_ENUM_FIELDS: dict[str, str] = {}

# What a user writes in a cell to mean "nothing here" is `lib.is_blank_cell`,
# which reads `schema § i18n.blank_cell`. There is deliberately NO set here any
# more.
#
# **TASK-431.** This file carried `UNDECLARED_CELL = {"", "—", "–", "-",
# "n/a", "N/A", "tbd", "TBD", "?", "—/—"}` and nine checks tested against it
# with `in`. The schema's own note records that this list is why
# `i18n.blank_cell` was declared in the first place — and the declaration
# landed while this copy stayed, so for a year the linter answered "does this
# cell mean nothing" in English only. `无`, `待定`, `不适用`, `暂无`, `na`,
# `none`, `N.A.`, `TBA` and `？` were all cells this file believed said
# something. A set-membership test also cannot see decoration, so `**—**` and
# `` `n/a` `` were values too, on a board Perry's own templates decorate.
#
# It is a FUNCTION call at each site rather than a wider set for exactly that
# reason: a set the callers test with `in` can only ever match spellings
# literally, and `is_blank_cell` normalises before it matches.
#
# **One spelling was dropped and it is not an oversight: `—/—`.** It is not in
# `schema § i18n.blank_cell`, nothing in this repository writes it, and a
# whole-tree search finds it on no template, fixture, test or document — only
# on the line above. Teaching the schema a tenth English spelling to preserve
# it is precisely the edit this row forbids ("it must not add a spelling to a
# list"); if a board somewhere really spells an empty WIP cell `—/—`, that is
# a schema change with its own row, not a literal smuggled back into `bin/`.


def load_glossary(schema: dict) -> None:
    """Arm the localization glossary and the declared thresholds.

    Every check below reads these module-level tables, so calling `check_file`
    without this first silently reports a localized project's own column
    headers as wrong columns. It used to live inline in `main()`, which meant
    the only way to reach `check_file` correctly was to be `main()`.

    **The tool that made it worth extracting is gone.** It was pulled out for
    `bin/perry-conform`, which needed the same validation on a single file;
    that tool was deleted with USER-910 and this docstring went on citing it
    as the reason. The extraction is still right, and the reason is now the
    four callers inside this file — three `check_file` entry points and
    `main()` — a second copy of this loop for any of them being the
    two-implementations-of-one-rule defect ADR-004 is about. There is a fifth
    site that deliberately does NOT call it, and says why at its own line."""
    SCHEMA_THRESHOLDS.update(schema.get("thresholds") or {})
    TASK_STATUSES.update((schema.get("enums") or {}).get("task_status") or ())
    for mode, cfg in ((schema.get("work_modes") or {}).get("modes") or {}).items():
        MODE_NO_DEFAULT[mode] = list((cfg or {}).get("no_default") or [])
    STAGE_SEPARATORS.update(
        (schema.get("work_modes") or {}).get("stage_separators") or {})
    DECLARED_ENUMS.update(schema.get("enums") or {})
    TRACK_ENUM_FIELDS.update(
        ((((schema.get("stores") or {}).get("declared") or {})
          .get(".perry/config.jsonl") or {}).get("records") or {})
        .get("track", {}).get("enum_fields") or {})
    card = next((f for f in (schema.get("files") or [])
                 if f.get("id") == "knowledge-card"), None) or {}
    CARD_KINDS[:] = ((card.get("discriminator") or {}).get("values") or [])
    CARD_REQUIRED[:] = [h["name"] for h in (card.get("header_fields") or [])
                        if h.get("name") != "Kind"]
    i18n = schema.get("i18n") or {}
    for col, per_lang in (i18n.get("columns") or {}).items():
        COLUMN_ALIASES[col] = [a for aliases in per_lang.values() for a in aliases]
    for fld, per_lang in (i18n.get("fields") or {}).items():
        FIELD_ALIASES[fld] = [a for aliases in per_lang.values() for a in aliases]
    for head, per_lang in (i18n.get("headings") or {}).items():
        HEADING_ALIASES[head] = [a for aliases in per_lang.values() for a in aliases]


def accepted(column: str) -> list[str]:
    """Every normalized header spelling that satisfies this schema column."""
    names = [column, *COLUMN_ALIASES.get(column, [])]
    out: list[str] = []
    for n in names:
        v = norm(n)
        if v not in out:
            out.append(v)
    return out


def column_index(got: list[str], column: str) -> int:
    """Position of `column` in a table's normalized header row, or -1."""
    for alias in accepted(column):
        if alias in got:
            return got.index(alias)
    return -1


def canonical_column(key: str) -> str:
    """A FOLDED localized header key mapped back to its schema column name.

    Takes a key straight out of `header_index` and does not fold it again.
    TASK-050 round 9: this said `value = norm(header)`, and its one caller
    (`_track_context`) already hands it `header_index`'s own output — so the
    fold was redundant, and it was a second application of the one rule to a
    header cell, one edit away from `.strip("*` ").lower()` and the divergence
    this row exists to close. `viewer/tables.py § header_index` folds a header
    cell; nothing else does.
    """
    value = key
    for column in COLUMN_ALIASES:
        if value in accepted(column):
            return norm(column)
    return value


def field_re(name: str) -> str:
    """Alternation matching a header field name in any accepted language."""
    names = [name, *FIELD_ALIASES.get(name, [])]
    return "(?:" + "|".join(re.escape(n) for n in names) + ")"


def heading_re(name: str) -> re.Pattern:
    """Matcher for a section heading in any accepted language.

    For the cross-file checks, which look up a section by name rather than
    walking `files[].headings`. Both paths must agree — a safety gate the
    linter reports as unarmed while `bin/perry-state` reads it as armed is
    worse than either answer alone."""
    names = [name, *HEADING_ALIASES.get(name, [])]
    return re.compile("|".join("^" + re.escape(n) for n in names))


# ── checks ────────────────────────────────────────────────────────────────


# Filled from schema["thresholds"] in main(). Module-level rather than threaded
# through two signatures, so every check reads the one declared number.
SCHEMA_THRESHOLDS: dict = {}
#: Declared task statuses, filled from the schema by the same loader that
#: fills the thresholds — never listed here, so it cannot drift from what
#: `perry-task` writes.
TASK_STATUSES: set = set()

#: The `Kind:` values that make a `knowledge/*/*.md` file a CARD rather than a
#: digest, and the fields a card must carry — both read from
#: `schema/state-schema.json § files[id=knowledge-card]`, never written here.
#: `Owner role` is in the required list and handled separately in the check,
#: because an em dash legitimately answers it until roles exist.
CARD_KINDS: list[str] = []
CARD_REQUIRED: list[str] = []


def _days_since(stamp: str) -> int | None:
    """Whole days since an ISO date or datetime. None when unparseable —
    a missing timestamp must not silently read as "0 days old"."""
    m = re.match(r"(\d{4})-(\d{2})-(\d{2})", stamp.strip().strip("\"'"))
    if not m:
        return None
    try:
        then = date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
    except ValueError:
        return None
    return (date.today() - then).days


def check_frontmatter(path: Path, rel: str, spec: dict, enums: dict,
                      is_template: bool) -> list[Finding]:
    """Validate a YAML-frontmatter file (currently: the linkage graph).

    Uses the same reader Perry itself uses, so "the linter passed" and "Perry
    can read it" mean the same thing."""
    findings: list[Finding] = []
    fm = spec["frontmatter"]
    raw = path.read_text(errors="replace")
    front, _ = P.split_frontmatter(raw)
    if not front.strip():
        return [Finding("error", rel, "missing-frontmatter",
                        "expected a `---` fenced YAML block at the top of the file")]
    if is_template and "{{" in front:
        return []          # unfilled template placeholders are expected
    try:
        data = P.parse_yaml_subset(front)
    except ValueError as exc:
        return [Finding("error", rel, "bad-frontmatter", str(exc))]
    if not isinstance(data, dict):
        return [Finding("error", rel, "bad-frontmatter", "frontmatter is not a mapping")]

    key, want = fm["spec_key"], fm["spec_version"]
    if data.get(key) != want:
        findings.append(Finding("error", rel, "bad-spec-version",
                                f"`{key}: {data.get(key)!r}` — expected {want}"))

    def walk(node, fields: dict, where: str):
        for name, rule in fields.items():
            value = node.get(name) if isinstance(node, dict) else None
            if value is None:
                if rule.get("required"):
                    findings.append(Finding("error", rel, "missing-field",
                                            f"{where}{name} is required"))
                continue
            if rule.get("type") == "array":
                if not isinstance(value, list):
                    findings.append(Finding("error", rel, "bad-type",
                                            f"{where}{name} must be a list"))
                    continue
                item_rule = rule.get("items") or {}
                if item_rule and not item_rule.get("type"):
                    for i, item in enumerate(value):
                        if isinstance(item, dict):
                            walk(item, item_rule, f"{where}{name}[{i}].")
                continue
            if rule.get("type") == "number" and not isinstance(value, (int, float)):
                findings.append(Finding(
                    "error", rel, "bad-type",
                    f"{where}{name} must be a number or omitted — "
                    f"got {value!r}. A prose target must be omitted, not coerced."))
            if rule.get("pattern") and isinstance(value, str) \
                    and not re.match(rule["pattern"], value):
                findings.append(Finding("error", rel, "bad-id",
                                        f"{where}{name} = {value!r} does not match "
                                        f"/{rule['pattern']}/"))
            if rule.get("enum") and str(value) not in enums[rule["enum"]]:
                findings.append(Finding("error", rel, "bad-enum",
                                        f"{where}{name} = {value!r} is not one of "
                                        f"{enums[rule['enum']]}"))
            # A field whose legal values depend on a sibling — `step` is only
            # meaningful against the `stage` it sits inside. A dossier reading
            # `stage: confirm, step: rx-3` resumes into nothing, and the whole
            # point of `step` is that resume lands somewhere real.
            by_stage = rule.get("enum_by_stage") or {}
            pat_by_stage = rule.get("pattern_by_stage") or {}
            if by_stage or pat_by_stage:
                stage = str(node.get("stage") or "") if isinstance(node, dict) else ""
                if stage in by_stage:
                    allowed = enums[by_stage[stage]]
                    if str(value) not in allowed:
                        findings.append(Finding(
                            "error", rel, "bad-step",
                            f"{where}{name} = {value!r} is not a valid step of "
                            f"stage {stage!r} — expected one of {allowed}"))
                elif stage in pat_by_stage:
                    if not re.match(pat_by_stage[stage], str(value)):
                        findings.append(Finding(
                            "error", rel, "bad-step",
                            f"{where}{name} = {value!r} does not match "
                            f"/{pat_by_stage[stage]}/ for stage {stage!r}"))
                elif stage:
                    findings.append(Finding(
                        "warn", rel, "step-without-substeps",
                        f"{where}{name} = {value!r} but stage {stage!r} has no "
                        f"sub-steps — resume reads `stage` alone here, so this "
                        f"field is noise"))

    walk(data, fm["fields"], "")

    # A pipeline someone walked away from and never came back to. Reported so
    # the interrupted-run card can also offer to retire it, rather than showing
    # the same abandoned dossier at every entry forever.
    stale = SCHEMA_THRESHOLDS.get("stale_run_days") or {}
    if spec.get("id") in (stale.get("applies_to") or []):
        stage = str(data.get("stage") or "")
        if stage and stage not in ("done", "abandoned"):
            days = _days_since(str(data.get("updated") or data.get("started") or ""))
            limit = stale.get("value")
            if days is not None and limit and days >= limit:
                findings.append(Finding(
                    "warn", rel, "stale-run",
                    f"stage {stage!r} has not advanced in {days}d "
                    f"(threshold {limit}d) — resume it, or retire it with "
                    f"`stage: abandoned` so it stops being offered. The "
                    f"threshold is a calibrated default, not a law."))

    # **The three graph-integrity rules used to be here and are now in
    # `_linkage_graph_findings`.** They read `objectives[].krs[].tasks[]` and
    # `projects[]` out of a document's frontmatter, and this function grades
    # frontmatter against a `files[]` spec. ADR-019 deleted
    # `files[id=linkage]`, so this branch became unreachable rather than
    # wrong; the rules moved to where the facts now live and none of the three
    # changed its id or its severity.
    return findings


def spec_claims(spec: dict, text: str, schema: dict) -> bool:
    """Does this spec own this file, when two specs share one glob?

    `knowledge/*/*.md` is matched by both the digest spec and the knowledge-card
    spec. A card is a claim the project made; a digest is a source it read.
    Without this, the generic checker judged every card against the digest's
    required fields and reported three `missing-header-field` errors on a
    perfectly well-formed card — the same collision `--knowledge` and
    `--provenance` already resolve for themselves, one layer lower and missed.

    The rule is declared, not inferred: a spec carrying a `discriminator` owns a
    file whose named field holds one of its values, and a spec **sharing that
    glob without one** owns the files the discriminated spec rejected. Any spec
    whose glob nothing else matches is unaffected and answers `True`.
    """
    disc = spec.get("discriminator")
    if disc:
        return field_value(text, disc["field"]) in (disc.get("values") or [])
    rivals = [f for f in (schema.get("files") or [])
              if f is not spec and f.get("path") == spec.get("path")
              and f.get("discriminator")]
    for r in rivals:
        d = r["discriminator"]
        if field_value(text, d["field"]) in (d.get("values") or []):
            return False
    return True


#: schema `typed_columns` value → the predicate that answers it. Both halves
#: come from `lib`, which is where `bin/perry-goals` reads them too.
#:
#: **The predicate takes the track's MODE**, because the writer's does.
#: `perry-goals § check_due` refuses an SLA token on a `pipeline` track — that
#: track's triage compares the cell against today and a token has no day in it
#: — while the file check was mode-blind. A V4 generated 17,889 values across
#: four modes and found **398 disagreements**, every one of them an SLA token
#: in a pipeline register: refused by the writer, clean in the file. A reader
#: that is laxer than its writer is the same defect as one that is stricter,
#: and this pair was split to end exactly that.
TYPED_CELL = {
    "iso-date-or-sla": lib.due_is_valid,
}
#: What each kind ACCEPTS, in words, read from `schema § typed_cell_kinds`.
#: Not written here: the guard in `tests/test_work_modes.py` forbids this file
#: from naming a column's vocabulary in code, and it is right to — the words
#: are the declaration's and only the predicate above is Python's.


_TYPED_CELL_KINDS: dict = {}


def _accepts(kind: str) -> str:
    """The declared prose for a typed cell kind, or a plain fallback.

    Read from `schema § typed_cell_kinds` and cached, not written here. The
    fallback is deliberately shapeless: a kind the schema declares without
    words should read as under-documented, not as something this file invented
    a vocabulary for.
    """
    if not _TYPED_CELL_KINDS:
        try:
            _TYPED_CELL_KINDS.update(
                json.loads(SCHEMA_PATH.read_text(encoding="utf-8"))
                .get("typed_cell_kinds") or {})
        except (OSError, ValueError):
            pass
    return (_TYPED_CELL_KINDS.get(kind) or {}).get("accepts") or f"the {kind} shape"


#: `_track_context`'s answer per PROJECT ROOT, not per projection path.
#:
#: It was keyed on `str(root / ".perry" / "config.md")` — the file this
#: function used to parse, which on a store-only project is a path that does
#: not exist. The register is a property of the ROOT, so the root is what
#: identifies the answer; keying on one of the then-two sources named a source
#: in a cache whose whole point is that the caller does not choose one. ADR-019
#: left one source, and the key stays the root because that is what it is
#: about.
_TRACK_CONTEXTS: dict = {}

_STATE = None


def _state_module():
    """`bin/perry-state`, loaded on first use — for `declared_tracks_detail`.

    Same loader `_tasks_module` uses, and for the same reason: the filename
    carries a dash, so `import` cannot reach it. LAZY, unlike `_store_module`
    and `_md_store_module` above, because a run that types no `Track` cell
    never needs the register at all — `--templates`, `--claims` and
    `--glossary` all finish without asking it a question, and an import at
    module scope would make every one of them pay for `bin/perry-state`.

    No cycle, and it is not the import `perry-state § stored_settings`
    documents as impossible: that note is about `parsers.py` callers which run
    BEFORE any tool has started. `bin/perry-state` names this file in prose
    only and imports nothing from it.
    """
    global _STATE
    if _STATE is None:
        import importlib.machinery
        import importlib.util
        path = HERE / "perry-state"
        spec = importlib.util.spec_from_loader(
            "perry_state_mod",
            importlib.machinery.SourceFileLoader("perry_state_mod", str(path)))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        _STATE = mod
    return _STATE


def _track_context(state_file: Path, cell: str) -> dict:
    """A track cell → its declared row from the project's track REGISTER.

    Through `bin/perry-state § declared_tracks_detail`, which is the register.
    Not from `.perry/config.md § Tracks`, which was a projection of it and
    which this function used to parse itself — see the comment on the read
    below. ADR-019 deleted that file; the read below is unchanged, because it
    already asked the register rather than the projection.

    The root is walked up from the file being linted rather than passed in, so
    `check_file`'s signature does not move and there is no second answer to
    "where does this project start". The caller that made that matter was
    `bin/perry-conform`, deleted with USER-910; the property is worth keeping
    for the three in-file callers that remain.

    An undeclared track reports `{}`, which every predicate treats as the
    permissive case. A typo in the register must not silently make a column
    stricter: `perry-lint` already reports an unknown mode as `bad-enum`, and
    two findings for one typo is how a check gets switched off. **A store that
    is present and unusable reports `{}` for the same reason** — it is the
    permissive answer, and it is not the projection's answer dressed up as
    the register's.
    """
    name = squash(cell or "")
    if not name:
        return {}
    root = state_file.resolve().parent
    # **The walk stops where the project is CONFIGURED, not where the
    # projection happens to be on disk** (TASK-247, P003-O2-KR1). It broke on
    # `.perry/config.md` alone, so on a project configured by
    # `.perry/config.jsonl` with no rendered markdown the walk ran out its five
    # steps, and `root` came back as an ancestor of the project — the parent
    # directory that holds every checkout on this machine. Either that ancestor
    # has no `.perry/` and the register reads empty, or it has ANOTHER
    # project's, and a track cell is then typed against a register that belongs
    # to a different repository. `P.configured` is the predicate
    # `viewer/parsers.py` already carries for this question.
    for _ in range(5):
        if P.configured(root):
            break
        root = root.parent
    # **The register is `.perry/config.jsonl`; `.perry/config.md` was a
    # PROJECTION of it** (USER-903, TASK-233; deleted by ADR-019). This read the projection, with
    # a parser of its own written out below — a FIFTH register reader that
    # `P003-O2-KR1`'s baseline never enumerated, because it does not call
    # `parse_tracks` and so did not answer to the name the count was taken
    # over. TASK-247 fixed the walk above and named this line as still
    # outstanding rather than folding it in (TASK-283).
    #
    # The visible cost was not "no register": it was the WRONG contract,
    # silently. On a project configured by the store alone the parse read an
    # absent file, every track resolved to `{}`, and every typed `Due` cell
    # was then checked under the permissive default instead of its own
    # track's rule — a `pipeline` track accepted the duration tokens it
    # exists to reject, and a `queue` track with no declared clock accepted
    # a populated `Due` that `lib.classify_due` reserves for a track that
    # has one. A check that reports nothing is indistinguishable from a
    # check that passes.
    #
    # `declared_tracks_detail` is the one reader this project settled on
    # (TASK-095 V4 round 1) and the only one that reports WHICH register
    # answered — the half a caller that must not take the projection as
    # truth needs. `bin/perry-goals § tracks_of` and `bin/perry-state § build`
    # are the two callers whose shape this now matches.
    key = str(root)
    if key not in _TRACK_CONTEXTS:
        ps = _state_module()
        tracks, source = ps.declared_tracks_detail(root)
        if source in ps.TRACKS_STORE_UNUSABLE:
            # A store is on disk and could not be used, so `tracks` holds the
            # PROJECTION's rows and `declared_tracks_detail`'s own docstring
            # forbids treating them as truth. Take the PERMISSIVE branch, not
            # a second-best one: `{}` is already this function's answer for an
            # undeclared track, and the docstring above says why a register
            # this tool cannot trust must never be the thing that makes a
            # column STRICTER. The unusable store is not swallowed — the
            # config store census reports it on its own terms, in the same
            # run, and `TRACKS_STORE_WHY` is where its wording lives.
            _TRACK_CONTEXTS[key] = {}
        else:
            # `if row.get("track")` is DEFENCE, not a live branch, and a
            # mutation of it comes back green on purpose. Both halves of
            # `declared_tracks_detail` already guarantee a named row —
            # `stored_tracks` filters on `(r.get("track") or "").strip()` and
            # `parse_tracks` ends `[r for r in rows if r["track"]]` — and the
            # `if not name: return {}` above means a blank key could never be
            # looked up even if one arrived. The invariant is pinned upstream
            # by `test_the_register_never_hands_back_a_blank_track_name`
            # rather than by a fixture here faking a state neither reader can
            # produce.
            _TRACK_CONTEXTS[key] = {
                row["track"]: row for row in tracks if row.get("track")}
    return _TRACK_CONTEXTS[key].get(name, {})


def check_file(path: Path, rel: str, spec: dict, enums: dict,
               is_template: bool, root_flag: str = "") -> list[Finding]:
    """`root_flag` is `lib.root_flag(project_root)` — see TASK-253. This
    function is handed a file and no project, and one of its findings hands the
    reader `perry-goals commit --migrate`, which WRITES. The template pass at
    the bottom of `main` passes nothing, because a lint of Perry's own shipped
    templates is not about a project and has no root to name."""
    if spec.get("format") == "yaml-frontmatter":
        return check_frontmatter(path, rel, spec, enums, is_template)

    findings: list[Finding] = []
    raw = path.read_text(errors="replace")
    text = strip_comments(raw)
    lines = raw.split("\n")

    cap = spec.get("cap")
    if cap and len(lines) > cap:
        sev = "error" if spec.get("cap_kind") == "hard" else "warn"
        # **The prescription is mode-aware, because for one section it was
        # exactly backwards.** `## Intake` lives inside `BOARD.md` on purpose
        # (`DESIGN-003` decision 3 chose zero new claimed paths), and
        # `modes/queue.md` says the resulting pressure on the cap **is the
        # feature**: "an intake that overflows the board is a project that is
        # not triaging". Telling that project to split the overflow into a
        # sibling file is telling it to move the signal somewhere it can grow
        # unnoticed — the one response the mode rules out.
        n_intake = intake_rows(raw)
        if n_intake and n_intake * 2 >= len(lines) - cap:
            findings.append(Finding(
                sev, rel, "size-cap",
                f"{len(lines)} lines, over the tier-{spec.get('tier')} cap of "
                f"{cap} — and {n_intake} of them are undischarged `## Intake` "
                f"rows. **Do not split this into a sibling file.** Intake lives "
                f"in the board so arrival is visible, and an intake that "
                f"overflows the cap is the signal that the queue is not being "
                f"drained (`modes/queue.md`). Run triage and route or discharge "
                f"the rows; the cap comes back on its own."))
        else:
            findings.append(Finding(
                sev, rel, "size-cap",
                f"{len(lines)} lines, over the tier-{spec.get('tier')} cap of "
                f"{cap}. Split the overflow into a sibling file rather than "
                f"writing past it."))

    # Some sections are only mandatory once the doc reaches a given status —
    # a design doc in `draft` is allowed to be incomplete; `locked` is not.
    gate = spec.get("required_at_status")
    doc_status = ""
    if gate:
        sm = re.search(rf"{field_re(gate['field'])}\s*\**\s*[:：]\s*\**\s*(\w+)", text)
        doc_status = sm.group(1).lower() if sm else ""
    sections_are_hard = not gate or doc_status in gate["values"]

    heads = headings(text)
    for req in spec.get("headings", []):
        matcher = re.compile(req["match"])

        def present(req=req, matcher=matcher) -> bool:
            # **The fifth implementation of "where is this section".** Four
            # were unified on `squash`; this one applied the raw schema regex
            # to the raw heading, so `## **Top risks**` reported
            # `missing-section` while every other reader found it.
            #
            # It is the dangerous one because **`perry-migrate` acts on lint
            # findings**: told the section was missing, it appended a second,
            # empty `## Top risks` above the project's real one. Measured on a
            # fixture — 1 risk visible before, **0 after**, the recorded risk
            # orphaned, and `perry-lint` then reporting **0 errors** with the
            # file **declared conformant**. Migration made a stranger's risks
            # invisible and certified the result.
            #
            # Decoration is stripped and the retry is case-insensitive; the
            # exact match is tried first so nothing that passed before changes.
            for lvl, t, _ in heads:
                if lvl != req["level"]:
                    continue
                if matcher.search(t):
                    return True
                if matcher.search(undecorate(t)) or re.search(
                        req["match"], undecorate(t), re.IGNORECASE):
                    return True
            return False

        if not present():
            severity = "error" if sections_are_hard else "warn"
            suffix = "" if sections_are_hard else (
                f" (not yet blocking at {gate['field']}: {doc_status or '—'}; "
                f"required at {'/'.join(gate['values'])})"
            )
            findings.append(Finding(
                severity, rel, "missing-section",
                f"required section not found: {req['label']}{suffix}",
            ))

    for field in spec.get("header_fields", []):
        name = field["name"]
        m = re.search(rf"{field_re(name)}\s*\**\s*[:：]\s*\**\s*([^\n]+)", text)
        if not m:
            # A field declared `required: false` is a pointer with a default —
            # absent means "use the default", not "malformed".
            if field.get("required") is False:
                continue
            findings.append(Finding("error", rel, "missing-header-field",
                                    f"header field `{name}:` not found"))
            continue
        value = m.group(1).strip().strip("*`> ")
        if is_template and PLACEHOLDER.search(value):
            continue
        if field.get("enum"):
            allowed = enums[field["enum"]]
            first = re.split(r"[|/,]", value)[0].strip()
            if first and first not in allowed and not PLACEHOLDER.search(value):
                findings.append(Finding(
                    "error", rel, "bad-enum",
                    f"`{name}: {first}` is not one of {allowed}",
                ))
        elif field.get("pattern") and not re.search(field["pattern"], value):
            findings.append(Finding(
                "warn", rel, "bad-format",
                f"`{name}: {value}` does not match /{field['pattern']}/",
            ))

    for tspec in spec.get("tables", []):
        matcher = re.compile(tspec["under"])
        level = tspec.get("under_level", 2)
        bodies = section_body(text, level, matcher)
        if not bodies:
            continue
        prefix_match = tspec.get("column_match") == "prefix"
        found_any = False

        def satisfied(col: str, got: list[str]) -> bool:
            """A column is present under its English name or any localized alias."""
            return any(
                any(g.startswith(a) for g in got) if prefix_match else a in got
                for a in accepted(col)
            )

        for body, start in bodies:
            for header, rows_at in tables_with_lines(body):
                rows = [r for r, _ in rows_at]
                got = header_index(header)
                if not got:
                    continue
                found_any = True
                # A row that is not as wide as its header. Both directions are
                # wrong and neither was reported until now: a SHORT row reads
                # as one whose trailing columns are empty — and empty is legal
                # for `Evidence`, so nothing downstream objects — while a LONG
                # row shifts every column after the extra `|`.
                #
                # This is the check that was missing when `perry-task add`
                # wrote raw newlines into three rows of Perry's own board.
                # Each ended mid-cell with no closing `|`; `perry-lint`
                # reported `✓ clean`; the next `add` then parsed the truncated
                # line as the table's last row and inserted into the middle of
                # the spilled text. Every column read below is index-guarded
                # (`if ci >= len(row): continue`), which is exactly why a
                # malformed row passed every one of them in silence.
                #
                # Deliberately ABOVE the missing-columns branch, which bails
                # out with `continue`. Comparing a row's width to its header's
                # needs no interpretation of what the columns mean, so a table
                # whose headers Perry does not recognize can still be told its
                # rows do not line up — and that is precisely the table a
                # project arriving from outside Perry has.
                # Iterated WITH the offsets, not matched back to them.
                # The first version built `{id(row): line}` from a second call
                # to `tables_with_lines(body)` — different list objects, so no
                # `id()` ever matched and every finding kept reporting the
                # heading. It looked like a fix and changed nothing; caught by
                # running a ragged row through it rather than by reading it.
                for row, offset in rows_at:
                    if len(row) == len(header):
                        continue
                    if not any(c.strip() for c in row):
                        continue          # a blank spacer row inside a table
                    shown = (row[column_index(got, tspec["id_column"])]
                             if tspec.get("id_column")
                             and 0 <= column_index(got, tspec["id_column"]) < len(row)
                             else " | ".join(row)[:60])
                    findings.append(Finding(
                        # `start` is `section_body`'s 0-based index of the
                        # body's first line and `offset` is 0-based within the
                        # body, so the 1-based line a person opens is
                        # `start + offset + 1`. Verified with two ragged rows
                        # at known, different lines rather than one — a single
                        # sample cannot tell a constant offset from a
                        # coincidence.
                        "error", rel, "ragged-row",
                        line=start + offset + 1,
                        message=f"row {shown!r} has {len(row)} cell(s) but its "
                                f"header has {len(header)} — "
                                + ("the trailing column(s) read as empty"
                                   if len(row) < len(header)
                                   else "every column after the extra `|` is shifted"),
                    ))
                missing = [c for c in tspec["columns"] if not satisfied(c, got)]
                if missing:
                    findings.append(Finding(
                        "error", rel, "table-columns", line=start,
                        message=f"table under section at line {start} is missing column(s) "
                                f"{missing}; parsers key on these headers. Found: {header}",
                    ))
                    continue
                for col, enum_name in (tspec.get("enum_columns") or {}).items():
                    ci = column_index(got, col)
                    if ci < 0:
                        continue
                    for row in rows:
                        if ci >= len(row):
                            continue
                        val = row[ci].replace("*", "").strip()
                        if not val or PLACEHOLDER.search(val):
                            continue
                        base = re.split(r"[\s(（]", val)[0]
                        if base not in enums[enum_name]:
                            findings.append(Finding(
                                "error", rel, "bad-enum",
                                f"{col} = {val!r} is not one of {enums[enum_name]}",
                            ))
                # **The reader half of a typed column.** `enum_columns`
                # above says "this cell is one of these words"; this says
                # "this cell is a value of this shape". The schema declares
                # both, so a column whose value space is written down in
                # `state-schema.json` is checked here rather than only in
                # whichever tool happens to write it.
                #
                # It exists because the Commitments table's own note reads
                # "`Due` is TYPED … and nothing else is accepted", and that
                # was true of `perry-goals commit` and of nothing else — a
                # hand-written `| … | 下周期 | active |` under a `Due` header
                # linted clean. This is an error like an off-enum value.
                # Migration remains possible because its write path is
                # explicitly exempt from the conformance gate.
                for col, kind in (tspec.get("typed_columns") or {}).items():
                    ci = column_index(got, col)
                    tci = column_index(got, "Track")
                    if ci < 0:
                        continue
                    ok = TYPED_CELL.get(kind)
                    if ok is None:
                        findings.append(Finding(
                            "warn", rel, "schema-unknown-type",
                            f"the schema types column `{col}` as {kind!r} and "
                            f"this lint has no predicate for that, so the "
                            f"column is unchecked rather than clean"))
                        continue
                    for row in rows:
                        if ci >= len(row):
                            # A ragged row — fewer cells than the header. It is
                            # already `ragged-row`'s finding, and indexing it
                            # here exited the whole lint at rc 2 with an
                            # `IndexError`. Deleting this line leaves the suite
                            # green, which is why it has its own test.
                            continue
                        val = row[ci]
                        # `lib.is_blank_cell` strips the decoration; doing it
                        # here as well produced a THIRD spelling of "strip" —
                        # `.replace("*", "")` vs `lib`'s end-strip disagreed on
                        # `2026-**09**-30`, which lint accepted and the writer
                        # refused.
                        if lib.is_blank_cell(val):
                            continue
                        if is_template and PLACEHOLDER.search(val):
                            continue
                        track = {}
                        if 0 <= tci < len(row):
                            track = _track_context(path, row[tci])
                        if not ok(track, val):
                            classification = (lib.classify_due(track, val)
                                              if kind == "iso-date-or-sla"
                                              else lib.DUE_INVALID)
                            context = ""
                            mode = str(track.get("mode") or "").lower()
                            if lib.due_track_missing_clock(track):
                                context = (" The row's queue track has no "
                                           "declared clock, so no populated "
                                           "`Due` is valid.")
                            elif mode == "pipeline":
                                context = (" The row's pipeline track requires "
                                           "a calendar date, not a duration token.")
                            findings.append(Finding(
                                "error", rel, "bad-typed-cell",
                                f"{col} = {val!r} — this column is typed "
                                f"({_accepts(kind)}) and nothing else "
                                f"is accepted, so a reader cannot compare or "
                                f"sort it. Prose about a deadline belongs in "
                                f"`By when note`, which is never validated: "
                                f"`perry-goals commit --migrate{root_flag}` "
                                f"moves it."
                                f"{context}"))

                # A column the row's own mode has no honest default for, left
                # undeclared.
                #
                # `work_modes.defaults_note` already draws the distinction this
                # reads: an empty `WIP` under `queue` means THIS MODE HAS NO
                # SUCH CONTROL, while an empty `SLA` under `queue` means NOBODY
                # HAS SAID YET — and only the second is a finding. The note
                # stated the rule and left it to be obeyed by hand, so a queue
                # track with no SLA lints clean, and then `modes/queue.md`'s
                # breach step, age sort and triage question all measure against
                # a clock that does not exist.
                #
                # Deliberately WARN. The full argument is in the schema; the
                # short version is that an error would retroactively invalidate
                # every register written before this rule, and — because a file
                # carrying errors cannot be declared conformant — would
                # escalate one blank cell into a write refusal on the whole of
                # `.perry/config.md`. The question is FORCED at creation
                # instead, where there is no legacy and no default to fall back
                # on, and the hard stop already exists at the point of use.
                nd = tspec.get("no_default_by_mode") or {}
                mi = column_index(got, nd["mode_column"]) if nd else -1
                if mi >= 0:
                    ti = column_index(got, nd.get("id_column") or "")
                    for row in rows:
                        if mi >= len(row):
                            continue
                        mode = re.split(
                            r"[\s(（]", row[mi].replace("*", "").strip())[0]
                        who = (row[ti].replace("*", "").strip()
                               if 0 <= ti < len(row) else "?")
                        for col in MODE_NO_DEFAULT.get(mode, []):
                            k = column_index(got, col)
                            val = ("" if k < 0 or k >= len(row)
                                   else row[k].replace("*", "").strip())
                            if not lib.is_blank_cell(val) \
                                    and not PLACEHOLDER.search(val):
                                continue
                            findings.append(Finding(
                                "warn", rel, "no-default", line=start,
                                message=(
                                    f"track {who!r} is mode {mode!r} and its "
                                    f"`{col}` is undeclared. {mode} has no "
                                    f"default `{col}` (schema "
                                    f"work_modes.modes.{mode}.no_default) "
                                    f"because it is a commitment the project "
                                    f"makes to someone, and a number Perry "
                                    f"invented is one the project never made — "
                                    f"every triage run afterwards would measure "
                                    f"real work against it. Declare it in the "
                                    f"`{col}` cell of `.perry/config.md § "
                                    f"Tracks`; until then triage reports the gap "
                                    f"instead of a verdict."),
                            ))

                # **A Stages cell that did not split is reported by name.**
                #
                # `split_stages` accepts the separators in
                # `schema/state-schema.json § work_modes.stage_separators.
                # accepted`; a cell using any other one becomes ONE stage whose
                # name is the whole list, and every stage-based measure in
                # queue, pipeline and inquiry mode then runs on it. That is
                # silent today: reproduced on a project reporting 8 errors, and
                # not one of them named this cell.
                #
                # Both halves read the SAME schema list, so the splitter and
                # this check cannot disagree about what an accepted separator
                # is — which is the shape that put the `->` / `→` bug in
                # circulation to begin with.
                seps = STAGE_SEPARATORS
                si = column_index(got, "Stages")
                if si >= 0 and seps.get("suspect"):
                    # The table's own id column is declared under
                    # `no_default_by_mode`, not at the table's top level —
                    # `tspec["id_column"]` is None here, and reading it named
                    # every track `'?'`.
                    ti2 = column_index(got, (nd or {}).get("id_column") or "")
                    for row in rows:
                        if si >= len(row):
                            continue
                        cell = row[si].replace("*", "").strip()
                        if not cell or lib.is_blank_cell(cell):
                            continue
                        if any(a in cell for a in (seps.get("accepted") or [])):
                            continue
                        hit = next((c for c in seps["suspect"] if c in cell), None)
                        if not hit:
                            continue
                        who = (row[ti2].replace("*", "").strip()
                               if 0 <= ti2 < len(row) else "?")
                        findings.append(Finding(
                            "warn", rel, "stage-separator", line=start,
                            message=(
                                f"track {who!r} lists its stages with {hit!r}, "
                                f"which Perry does not split on — the whole "
                                f"cell becomes ONE stage named "
                                f"{cell!r}, and WIP, stage age and this mode's "
                                f"triage question all measure against it. Use "
                                f"one of "
                                f"{', '.join(repr(a) for a in seps['accepted'])}."),
                        ))

                ci = column_index(got, tspec["id_column"]) if tspec.get("id_column") else -1
                if ci >= 0:
                    pat = re.compile(tspec["id_pattern"])
                    for row in rows:
                        if ci >= len(row):
                            continue
                        val = row[ci].replace("*", "").strip()
                        if not val or PLACEHOLDER.search(val):
                            continue
                        if not pat.match(val):
                            findings.append(Finding(
                                "error", rel, "bad-id",
                                f"id {val!r} does not match /{tspec['id_pattern']}/ — "
                                "attribution resolves on these ids",
                            ))
        # `optional` = this section is allowed to hold something other than a
        # table. `## Top risks` is the case: it is a bullet list on every
        # project that has not migrated to the tool-written table, and a bullet
        # list is a valid `## Top risks` — readers fall back to it. Without
        # this the table spec added for TASK-040 would have turned every
        # unmigrated board red for a shape it was never asked to adopt.
        #
        # Note this is NOT the same optionality Intake has. Intake is skipped
        # because `section_body` returns nothing when the SECTION is absent;
        # here the section is present and merely has no table.
        if not found_any and not is_template and not tspec.get("optional"):
            findings.append(Finding(
                "warn", rel, "missing-table",
                f"no table found under /{tspec['under']}/",
            ))
    return findings


#: **`_linkage_records_for_phase` lived here and is gone — ADR-019.**
#:
#: It was this linter's own copy of `parsers.linkage_records_for_phase`, and
#: it existed for one reason: the linter's sweep was per REGISTER DOCUMENT and
#: had to decide, file by file, whether the store or the document beside it
#: was the authority for that phase. There is no document, so there is no
#: choice to make and no second implementation of the slice to keep in step.
#: `check_cross_file` reads `P.load_linkage` directly, which is the same
#: reader `perry-state` and `perry-goals` use.


def check_cross_file(root: Path, enums: dict, project_root: Path | None = None) -> list[Finding]:
    findings: list[Finding] = []
    # `.perry/` is anchored at the project root even when state lives in a
    # subdirectory — it is the pointer, so it cannot sit behind the pointer.
    perry_dir = (project_root or root) / ".perry"

    # The old phase-KR form is REJECTED, not merely unmatched. See the note on
    # `LEGACY_KR_ID_RE`: every guard below is written `if own_krs and …`, so
    # a phase file left in `P-O3.1` [[old-form]] yields an empty KR set and
    # buys silence
    # from every check downstream. This is the one place that can tell the
    # difference between "this phase declares no KRs" and "this phase declares
    # its KRs in an id form that was migrated away on 2026-08-28", and it says
    # so out loud.
    #
    # Scanned over `phase/*.md` rather than just the CURRENT phase because a
    # scored phase's register is read too — `check_cross_file` re-derives
    # `own_krs` per linkage file from the file's own phase — so an unmigrated
    # 001 is exactly as silent as an unmigrated 002.
    _legacy = re.compile(LEGACY_KR_ID_RE)
    for pf in sorted((root / "phase").glob("*.md")) if (root / "phase").is_dir() else []:
        for i, line in enumerate(strip_comments(pf.read_text()).split("\n"), 1):
            hits = _legacy.findall(line)
            if not hits:
                continue
            findings.append(Finding(
                "error", pf.relative_to(root).as_posix(), "kr-id-legacy-form",
                f"{', '.join(sorted(set(hits)))} — the pre-TASK-180 phase-KR "
                f"form, whose phase is not in the id. DESIGN-007 decision #4 "
                f"(locked 2026-08-19) replaced it with `P{pf.name.split('-', 1)[0]}"
                f"-O<n>-KR<n>`, and nothing reads the old form any more: left "
                f"here it is not a KR to any tool, it is prose that looks like "
                f"one",
                line=i,
            ))

    # phase/CURRENT resolves
    cur = root / "phase" / "CURRENT"
    phase_file = None
    if cur.exists():
        slug = cur.read_text().strip()
        if slug and slug not in {"(none)", "none", "—", ""}:
            phase_file = root / "phase" / f"{slug}.md"
            if not phase_file.exists():
                findings.append(Finding(
                    "error", "phase/CURRENT", "current-phase-resolves",
                    f"points at {slug!r} but phase/{slug}.md does not exist",
                ))
                phase_file = None

    # **The phase's KR set is no longer read here at all** — TASK-157.
    #
    # It used to be `re.findall(KR_ID_RE, <the CURRENT phase document>)`, and
    # the two guards below compared every register against it. The document
    # carried a KR table declaring those ids; it does not any more
    # (DESIGN-013 § 5.1: a fact with a schema lives in exactly one store), and
    # a set scraped from the surviving prose would grade a declaration against
    # a mention. Each register now answers with its OWN `krs[]` — see the loop
    # below, which also keeps the document scan for a project that has not
    # migrated.

    # linkage: every TASK the graph names must exist in the tasks store.
    #
    # **`None` is "this project has not been adopted", not "no tasks"** —
    # `viewer/parsers.py § load_task_store` states that contract and this is
    # the reader that has to honour it. A guard that read a missing
    # `tasks.jsonl` as an empty id set would report every edge in every
    # register as dangling on every project that has not adopted the store,
    # which is TASK-117's inversion exactly: `check_store_drift` called 175 of
    # 175 rows drifted when the only thing missing was the event log. So the
    # whole sweep below is skipped, silently, and nothing is claimed about
    # edges that were never checkable.
    #
    # `load_task_store` also answers `None` for a store it cannot parse, and
    # that is the right answer here too rather than a coincidence worth
    # working around: `check_store_drift` already reports `store-unreadable`,
    # and a second check inventing "and every one of your edges dangles" out
    # of the same one fact is the noise that finding exists to avoid.
    #
    # An EMPTY store is not that case. `[]` is an adopted, empty board, and a
    # register naming a task on an empty board really is pointing at nothing;
    # the report is true and the fix is real.
    #
    # The store is read once for the whole sweep — every linkage file is
    # judged against the same set, deliberately; see the note in the loop.
    store_records = P.load_task_store(root)
    store_ids: set[str] | None = (
        None if store_records is None
        else {str(r.get("id")) for r in store_records
              if isinstance(r, dict) and r.get("id")})
    # **DESIGN-015 § 5.6 site 4, and after ADR-019 there is one file to
    # grade.** Every finding below still fires, on the same rule and at the
    # same severity; what changed is where the graph it grades comes from and
    # which file a finding names.
    #
    # **Per phase, because a KR id is per phase.** One `linkage.jsonl` holds
    # every phase's records, and a register is only ever judged against its
    # OWN phase's KR set: `P002-…` pasted under phase 003 is the finding, and
    # grading every phase against one merged set would hide it. The phases
    # swept are the phases the store declares an `objective` or `kr` record
    # for, which is what "this project has planned this phase" means now that
    # there is no per-phase file to enumerate.
    #
    # This used to iterate `phase/*-linkage.md` and choose, per phase, between
    # the store and that phase's document. All three of this project's
    # registers were imported by ADR-019, so there is no second authority to
    # choose between — but the FALLBACK for a project that has never had a
    # store survives, one loop down: a phase whose KRs are declared only in a
    # `phase/<NNN>-<slug>.md` table is still swept from that table.
    linkage_records = P.load_linkage_store(root) or []
    store_phases = sorted({
        str(r.get("phase") or "") for r in linkage_records
        if isinstance(r, dict) and r.get("kind") in ("objective", "kr")
        and r.get("phase")})
    for slug in store_phases:
        own = P.linkage_phase_number(slug)
        if not own:
            continue
        link = P.load_linkage(root, own)
        rel = P.LINKAGE_STORE
        if not link.ok:
            continue
        own_krs = {k.id for o in link.objectives for k in o.krs}
        # **`projects[]` is graded against the same file it lives in now.**
        # The Project↔KR registry was a `projects:` block of the deleted
        # document and had no store record; ADR-019 declared `kind: project`
        # for it, so a finding names `linkage.jsonl` like every other.
        for pr in link.projects:
            if pr.serves_kr and own_krs and pr.serves_kr not in own_krs:
                findings.append(Finding(
                    "warn", rel, "linkage-kr-exists",
                    f"{pr.project_id}: serves {pr.serves_kr}, which is not a "
                    f"KR phase {own} declares"))
        for obj in link.objectives:
            for kr in obj.krs:
                # **The id must name the phase whose records it sits in.**
                # The old form of this guard asked whether the id appeared in
                # the phase document, which was one file's way of asking this
                # same question and stopped being answerable when the KR table
                # left the document. Asked directly it is stronger: a
                # `P002-…` KR filed under phase 003 used to be caught only
                # because `003-storage-code.md` did not mention it, and is
                # caught here by the id itself.
                if not kr.id.startswith(f"P{own}-"):
                    findings.append(Finding(
                        "warn", rel, "linkage-kr-exists",
                        f"{kr.id} is declared for phase "
                        f"{own}, and its id names a different phase. A phase "
                        f"KR id carries its phase (DESIGN-007 decision #4), "
                        f"so one of the two is wrong"))
                # **And the objective half of the id, against the objective it
                # is declared under.** `P001-O9-KR9` filed under `O1` used to
                # be caught only sideways — the phase document did not mention
                # it, so the old document-scan reported it — and that is the
                # case `tests/test_cadence.py §
                # test_a_genuinely_wrong_kr_is_still_reported` was written
                # around. Asked directly it needs no second file, and it is the
                # same question `linkage-objective-agrees` already asks of a
                # `project` record: an id that names its own place must agree
                # with the place it was put.
                declared_under = P.kr_objective_id(kr.id)
                if declared_under and obj.id and declared_under != obj.id:
                    findings.append(Finding(
                        "warn", rel, "linkage-kr-exists",
                        f"{kr.id} names objective {declared_under} and is "
                        f"declared under {obj.id}. The id carries the "
                        f"objective, so one of the two is wrong and nothing "
                        f"here guesses which"))
                # **The comment above does NOT transfer to task ids, and the
                # difference is what makes this check simpler than that one.**
                # A KR id USED TO BE scoped to a phase file rather than
                # naming one: `P-O1.1`/`001` and `P-O1.1`/`002` [[old-form]]
                # were different key results, so the only
                # correct comparand for phase 001 was phase 001's own
                # KR set — which is why that guard had to stop reading the
                # CURRENT phase. Those two ids are `P001-O1-KR1` and
                # `P002-O1-KR1` now (TASK-180), and the old pair is quoted
                # rather than migrated because migrating it would delete the
                # reason this guard exists: re-derived, the sentence becomes
                # "two ids that differ are different", which explains
                # nothing. **The guard stays**, and not out of caution — a
                # phase may carry an id for a phase that is not its own,
                # and comparing against the phase's own number is what catches
                # that. **A task id is global.** There is one
                # `tasks.jsonl` for the project, ids are minted across phases
                # and never re-used, and no per-phase task store exists to
                # read instead. So every phase, current or scored, is
                # judged against today's store — that is not "the current
                # phase leaking into an old one", it is the only store there
                # has ever been.
                #
                # The consequence is intended: when TASK-167's removal path
                # takes a row out, a scored phase's edge to it starts
                # dangling, and it IS dangling — the register credits that KR
                # with work no record carries. That is the finding, not a
                # false positive of one.
                #
                # **The comparand is the store and not `BOARD.md`.** A closed
                # row leaves the board and stays in `tasks.jsonl` (ADR-007;
                # `viewer/parsers.py § _records_by_group` skips a terminal
                # status), so resolving against the rendered rows would report
                # every finished task any register names, on every project.
                # `perry-diagnose`'s `user_load.dangling` asks the
                # markdown-mention question instead and does exactly that —
                # measured on a fixture 2026-08-28, it called a `done` row
                # dangling while its record sat in the store — which is why
                # "another tool already notices dangling ids" does not cover
                # this one.
                for tid in kr.tasks:
                    if store_ids is None or not tid or tid in store_ids:
                        continue
                    findings.append(Finding(
                        "warn", rel, "linkage-task-exists",
                        f"{kr.id} lists task {tid}, which is not a record in "
                        f"`tasks.jsonl` — the edge points at nothing. It is "
                        f"still counted: `bin/lib § kr_progress_provenance` "
                        f"puts {tid} in this KR's `linked_task_completion."
                        f"total` and files it under `unknown`, so the KR "
                        f"carries a denominator no row can ever close. Either "
                        f"the id is a typo or the row is gone. `perry-goals "
                        f"link` appends an edge and never retracts one, so "
                        f"this one comes out the way `link_edge`'s own "
                        f"refusal says a mis-aimed edge comes out: on the "
                        f"user's confirmation."))

        # **The declarations get the same sweep as `krs[].tasks[]`**
        # (TASK-227). They never had one: `linkage-task-exists` above proves
        # the task half of an EDGE, and the declaration list beside it was
        # unchecked at the linter exactly as it was unchecked at the writer.
        # Both holes were proven on 2026-08-28 by the same command —
        # `perry-goals link --unlinked` accepted 48 ids space-joined into one
        # argument, and separately the literal string `NOT-A-TASK-ID at all`,
        # and `perry-lint` reported 0 errors over the result.
        #
        # `warn`, matching `linkage-task-exists`: it is the same statement one
        # key over, and a declaration naming a row that has been purged is a
        # stale record rather than a broken file.
        #
        # A declared id costs less than a dangling edge — it lands in no
        # denominator — but it is not free. `perry-state § attribution` reports
        # `declared_unlinked` straight from this list (TASK-228), so an id no
        # row carries is a row the standup says was answered, and no such row
        # exists to have answered for.
        #
        # **Each declaration is swept ONCE, under its own phase.** It used to
        # be swept under the current phase only, because the record carried no
        # phase field and every phase would otherwise have reported the same
        # stale id. ADR-019 added `unlinked.phase`, so the slice this loop
        # already has is the right one and a phase-001 declaration is reported
        # against phase 001.
        for tid in (link.unlinked or []):
            if store_ids is None or not tid or tid in store_ids:
                continue
            findings.append(Finding(
                "warn", rel, "linkage-unlinked-exists",
                f"`unlinked` declares {tid!r}, which is not a record in "
                f"`tasks.jsonl`. A declaration says a KNOWN row serves no KR; "
                f"an id no row carries declares nothing, and "
                f"`perry-state --section attribution` still reports it under "
                f"`declared_unlinked`. Either the id is a typo, the row was "
                f"purged, or several ids were passed to `perry-goals link "
                f"--unlinked` as one argument — the shape that put 48 of them "
                f"on one line here on 2026-08-28."))

    # **A project that has never had a linkage store still gets swept.** Its
    # phase KRs are declared in a `phase/<NNN>-<slug>.md` table — that is what
    # adoption reads, and what every Perry project older than TASK-157 has —
    # and the ids in that table are the phase's KR set. The check that can be
    # made from a table alone is the id-shape one: a KR id must name the phase
    # of the document it is written in.
    if not store_phases and (root / "phase").is_dir():
        for pf in sorted((root / "phase").glob("[0-9][0-9][0-9]-*.md")):
            own = pf.name.split("-", 1)[0]
            for kid in sorted(set(re.findall(
                    KR_ID_RE, strip_comments(pf.read_text())))):
                if not kid.startswith(f"P{own}-"):
                    findings.append(Finding(
                        "warn", pf.relative_to(root).as_posix(),
                        "linkage-kr-exists",
                        f"{kid} is declared in the phase document for phase "
                        f"{own}, and its id names a different phase. A phase "
                        f"KR id carries its phase (DESIGN-007 decision #4), "
                        f"so one of the two is wrong"))

    # design: locked docs need an implementation plan
    for df in sorted((root / "design").glob("*.md")) if (root / "design").is_dir() else []:
        if df.name == "README.md":
            continue
        text = strip_comments(df.read_text())
        rel = df.relative_to(root).as_posix()
        sm = re.search(r"Status\s*\**\s*[:：]\s*\**\s*(\w+)", text)
        if not sm or sm.group(1).lower() != "locked":
            continue
        # design docs number their sections (## 6. Implementation plan)
        plan = section_body(text, 2, re.compile(r"^(?:\d+\.\s*)?Implementation plan"))
        if not plan or not plan[0][0].strip():
            findings.append(Finding(
                "error", rel, "locked-design-has-plan",
                "Status: locked but the Implementation plan section is empty — "
                "the work lane has nothing to open tasks from",
            ))

    # done records need evidence — **re-pointed, not dropped** (TASK-262
    # Amendment (4), round 4b, F14). This judged the `done` rows a person kept
    # by hand in a held `BOARD.md`. The file is retired and no reader opens it,
    # and a closure `perry-task done` made is judged from its event elsewhere.
    # What had no judge was a `done` record that no `done` event closed — the
    # rows `perry-tasks write --from-board` imported — so those records are
    # what this reads now.
    rel_store, closed = closed_without_a_done_event(
        root, project_root or root)
    for n, rec in closed:
        ev = str(rec.get("evidence") or "").strip()
        # TASK-431: was `ev in {"—", "-", ""}`. A `done` row whose Evidence
        # cell read `无` or `待定` was carrying evidence as far as this check
        # could tell, so the one warning that exists to catch a closure with
        # nothing behind it stayed silent on exactly the boards least likely to
        # be read in English.
        if not ev or lib.is_blank_cell(ev):
            findings.append(Finding(
                "warn", rel_store, "done-needs-evidence",
                f"record {rec['id']!r} is done with no evidence path, and "
                f"no `done` event records its closure", n,
            ))

    # hook safety list
    #
    # Read through `P.hook_escalation_lines`, which is what `bin/perry-state`
    # and the pre-flight union already read. The copy that stood here matched
    # the heading with `heading_re`, which has no prefix tolerance, while the
    # shared reader accepts `## High-stakes` — so a hook spelled that way was
    # armed for the gate and unarmed for the linter. `heading_re`'s own
    # docstring calls that out as the thing not to do: *"a safety gate the
    # linter reports as unarmed while `bin/perry-state` reads it as armed is
    # worse than either answer alone"*. It became load-bearing here, because
    # the dead-bullet finding below reads the shared list: two readers would
    # let one run say "nothing is armed" and then quote three armed bullets.
    hook_lines = P.hook_escalation_lines(perry_dir.parent)
    if not hook_lines:
        findings.append(Finding(
            "warn", ".perry/hook.md", "hook-high-stakes-armed",
            "no high-stakes operations list — /perry work dispatch's safety re-validation and "
            "/perry work autopilot's safety scan have nothing to match against",
        ))

    # A HOOK bullet that yields no fragment — the same defect as a role card's,
    # on the half every project has (TASK-202).
    #
    # **Why it lands here and not beside the card's check.** A role card's goes
    # through `check_role_cards`, which runs only under `--knowledge`, and that
    # is defensible for cards: they are optional (DESIGN-006 goal 7), a project
    # with none is never asked for one, and the flag is where a reader goes to
    # ask about them. The hook has no card, no loop, and no flag — it is read
    # on every dispatch of every project. So the finding goes in the DEFAULT
    # pass, three lines under `hook-high-stakes-armed`, because those two
    # sentences are one thought: that check says the gate is loaded, and this
    # one says how much of it is blanks. A reader told "armed" and not told
    # "three of your five rules are inert" has been told the more misleading
    # half. On `~/proj/gimegime-pmo` that reader was told `armed: true` over a
    # hook that turned 5 bullets into 3 fragments.
    #
    # **Severity: `warn`, the same as the role card's — deliberately not
    # louder.** The hook's version is worse in consequence: there is no card
    # to compensate, and TASK-200 caught `max_position` on a role card that was
    # standing in for exactly this hook. But raising it to `error` would say a
    # rule's enforceability depends on which file it was written in, which is
    # the asymmetry this task exists to remove, and it would turn every
    # existing project's honest prose into a red exit on a run that has not
    # changed. Reach, not volume, is where the difference belongs: the card's
    # is behind a flag and this one is not.
    for bullet in P.unextractable_lines(hook_lines):
        findings.append(Finding(
            "warn", ".perry/hook.md", "hook-escalation-not-extractable",
            P.unextractable_says(bullet, P.HOOK_SECTION)))
    return findings


# ── verification ladder (DESIGN-003 § 5.3) ────────────────────────────────


DATE_RE = re.compile(r"\b\d{4}-\d{2}-\d{2}\b")
RUNNABLE_RE = re.compile(r"`[^`]+`|\.(?:py|sh|json|md|ya?ml)\b|/")


def high_stakes_fragments(perry_dir: Path) -> list[str]:
    """The scan list: `.perry/hook.md`'s fragments **unioned** with every role's.

    Reused rather than re-declared. The consequence rule — anything
    outward-facing or irreversible needs V5 regardless of its mode's default —
    has no field of its own to read, and inventing one would mean asking the
    user to classify every task twice. The hook already carries the project's
    own statement of what is dangerous, so that list *is* the consequence
    signal. A project with an unarmed hook simply gets no consequence checks,
    which is honest: nothing has told Perry what matters there.

    **A role adds to that list and never replaces it** (DESIGN-006 § 5.2, goal
    6). `P.escalation_union` is the one implementation — this function does not
    carry a second copy, because two extractions of one rule is how a scan
    quietly stops scanning what it used to. With no roles declared the union is
    the hook's list unchanged, which is Goal 7 at this surface.
    """
    project_root = perry_dir.parent if perry_dir.name == ".perry" else perry_dir
    return P.escalation_union(project_root)["union"]


def rung_satisfied(rung: str, evidence: str) -> str | None:
    """Why this rung is NOT satisfiable from this evidence, or None if it is.

    Deliberately shallow. The linter can tell that a V5 claim carries no date,
    or that a V4 claim cites no rubric file; it cannot tell whether the reviewer
    was genuinely fresh-context or whether the human actually read the thing.
    Checking the checkable and staying quiet about the rest is what keeps this
    advisory pass from becoming theatre in the other direction.
    """
    ev = (evidence or "").strip()
    if rung == "V0":
        return ("V0 is 'asserted' — it is the name for what is being refused, "
                "never a rung a row may carry")
    # TASK-431: was `ev in ("—", "-")`. Same cell as `done-needs-evidence`
    # above, a second and narrower rule for it, one screen apart — so a V3 row
    # whose evidence read `n/a` was "claimed with no evidence at all" to one
    # check and adequately evidenced to the other.
    if not ev or lib.is_blank_cell(ev):
        return f"{rung} claimed with no evidence at all"
    if rung in ("V2", "V3") and not RUNNABLE_RE.search(ev):
        return (f"{rung} means a check something can re-run; the evidence names "
                f"no command, script or path")
    if rung == "V4" and not re.search(r"rubric|criteria|\.md\b", ev, re.I):
        return ("V4 requires a written acceptance rubric the reviewer scored "
                "against; the evidence cites none (see DESIGN-003 § 5.3)")
    if rung == "V5" and not DATE_RE.search(ev):
        return ("V5 is a human sign-off recording name, date and what was "
                "checked; the evidence carries no date")
    return None


def closed_without_a_done_event(state_root: Path, project_root: Path
                                ) -> tuple[str, list[tuple[int, dict]]]:
    """`tasks.jsonl`'s `done` records that no `done` event closed.

    **F14's store equivalent** (TASK-262 Amendment (4), round 4b, the user's
    decision "re-point, do not drop"). Three checks judged the `done` rows a
    person kept by hand in `BOARD.md`: `done-needs-evidence`,
    `check_verification`'s board pass and `check_reviews`' V4 board pass. The
    event passes beside them judge only closures `perry-task done` made. With
    the board retired, the closures no event records are the records
    `perry-tasks write --from-board` imported — a hand-kept `done` row becomes
    exactly such a record — so these are what the three checks judge instead.

    Returns the store's path as a finding names it and `(line, record)` pairs,
    in file order. A line that will not parse, a record with no string `id`,
    and a missing store contribute nothing: `store-unreadable` and
    `store-badly-typed` are the findings for those. A `done` event names its
    task as `task` or `id`, the two spellings the log has carried.
    """
    store = Path(state_root) / "tasks.jsonl"
    rel = _rel(store, Path(project_root))
    if not store.is_file():
        return rel, []
    closed_by_event: set[str] = set()
    log = Path(project_root) / ".perry" / "events.jsonl"
    if log.is_file():
        for raw in log.read_text(errors="replace").split("\n"):
            raw = raw.strip()
            if not raw:
                continue
            try:
                ev = json.loads(raw)
            except (ValueError, TypeError):
                continue
            if isinstance(ev, dict) and ev.get("event") == "done":
                tid = str(ev.get("task") or ev.get("id") or "")
                if tid:
                    closed_by_event.add(tid)
    out: list[tuple[int, dict]] = []
    try:
        lines = store.read_text(encoding="utf-8", errors="replace").split("\n")
    except OSError:
        return rel, []
    for n, raw in enumerate(lines, 1):
        if not raw.strip():
            continue
        try:
            rec = json.loads(raw)
        except (ValueError, TypeError):
            continue
        if not isinstance(rec, dict) or not isinstance(rec.get("id"), str) \
                or not rec["id"]:
            continue
        if rec.get("status") == "done" and rec["id"] not in closed_by_event:
            out.append((n, rec))
    return rel, out


def check_verification(state_root: Path, perry_dir: Path) -> list["Finding"]:
    """Advisory pass over every `done` row's verification rung.

    Advisory for one release by DESIGN-003 § 4 decision 4: a hard gate on day
    one would retroactively invalidate every `done` row in every existing
    project, since none of them carry a rung. This mode never sets a non-zero
    exit — branch on the `--json` counts if you want CI to care.
    """
    findings: list[Finding] = []
    # TASK-237 3b: this returned `[]` when the file was absent, which silenced
    # the event-log pass below as well as the board pass — so on a board-less
    # project no closure the tool had made was ever judged. Since TASK-262
    # round 4b no board file is read at all: the first pass reads the store's
    # `done` records that no event closed, and the event pass runs either way.

    def judge(where: str, tid: str, title: str, ev: str, rung: str,
              stakes: list[str]) -> int:
        """One closure, judged. Called for board rows AND for close events.

        Reading only board rows measured an empty set: `perry-task done`
        REMOVES the row it closes, so on this repo 29 closures carrying rungs
        produced "no done rows to rate". The consequence rule below — anything
        outward-facing or carrying money needs V5 regardless of mode — could
        therefore never fire on a task the tool had closed, which by then was
        every task.
        """
        if not rung:
            findings.append(Finding(
                "warn", where, "no-verification-rung",
                f"{tid} is done with no verification rung — "
                f"'evidence exists' does not say what was checked"))
            return 0
        why = rung_satisfied(rung, ev)
        if why:
            findings.append(Finding("warn", where, "rung-not-satisfied",
                                    f"{tid}: {why}"))
        # The id and the title — what the work IS. NOT the evidence path:
        # that is where the proof lives, not what was done, and matching
        # fragments inside it made every task high-stakes. Perry's own hook
        # lists `evidence/` under "destructive filesystem operations —
        # overwriting a project's own design/, evidence/, …", so once this
        # check started seeing tool-closed tasks it flagged all 29 of them.
        # A latent bug that could not fire while the check rated nothing.
        hay = f"{tid} {title}"
        # `P.matching_escalations` is the one matcher, for the same reason
        # `P.escalation_union` is the one extractor: a second copy is how a
        # scan quietly stops scanning what it used to. The copy that stood
        # here was `f in hay` — a bare substring — and it read `adopt` out of
        # "keep what adoption needs". TASK-107.
        hit = next(iter(P.matching_escalations(hay, stakes)), None)
        if hit and rung < "V5":
            findings.append(Finding(
                "warn", where, "consequence-needs-signoff",
                f"{tid} matches the project's own high-stakes list "
                f"({hit!r}) but closed at {rung}; outward-facing or "
                f"irreversible work needs V5 regardless of mode"))
        return 1
    # `seen` is returned alongside the findings so the caller can tell "every
    # done row is fine" from "there were no done rows" — printing a checkmark
    # for an empty scan is how a gate quietly stops being one.
    check_verification.rows_seen = 0
    stakes = high_stakes_fragments(perry_dir)

    rows_seen = rows_ranked = 0
    seen_ids: set[str] = set()
    # **The closures no event records** (TASK-262 round 4b, F14 re-pointed).
    # This pass read the `done` rows of a held `BOARD.md`'s P sections; the
    # file is retired. The store's `done` records that no `done` event closed
    # are the same population a hand-kept row became on import, and they are
    # judged by the same `judge`.
    rel_store, closed = closed_without_a_done_event(state_root,
                                                    perry_dir.parent)
    for _n, rec in closed:
        rows_seen += 1
        seen_ids.add(rec["id"])
        rows_ranked += judge(
            rel_store, rec["id"], str(rec.get("title") or ""),
            str(rec.get("evidence") or ""),
            str(rec.get("verification") or "").strip().upper(), stakes)

    # The closures that have already left the board. `done` removes the row,
    # so without this pass the check rated only work closed by hand — and on a
    # project using the tool, that is none of it.
    log = perry_dir / "events.jsonl"
    if log.exists():
        for line in log.read_text(errors="replace").split("\n"):
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            if e.get("event") != "done" or not e.get("id"):
                continue
            if e["id"] in seen_ids:
                continue          # still on the board; the row is canonical
            seen_ids.add(e["id"])
            rows_seen += 1
            rows_ranked += judge(".perry/events.jsonl", e["id"],
                                 e.get("title", ""), e.get("evidence", ""),
                                 (e.get("rung") or "").strip().upper(), stakes)

    if rows_seen and not rows_ranked:
        findings.append(Finding(
            "warn", "BOARD.md", "board-declares-no-rungs",
            f"{rows_seen} done row(s), none carrying a Verification column — "
            f"add one to start rating closures (advisory this release)",
        ))
    check_verification.rows_seen = rows_seen
    return findings


# ── task summaries (TASK-325) ─────────────────────────────────────────────


#: The structural predicate, and the ONE place it is defined. `bin/perry-task`
#: refuses on it at write time and this reports on it afterwards; a second
#: copy is how those two start disagreeing about what they are for.
summary_shape = lib.summary_shape


#: A board `Next action` over this many Unicode characters is reported. See the argument at
#: its use site in `check_summaries`. Belongs in `schema § thresholds`; it is
#: here because that file is the claim surface.
NEXT_ACTION_CELL_CHARACTERS = 400


#: Per-document line caps for the two trees that have none. Both belong in
#: `schema/state-schema.json § files[]` beside `BOARD.md`'s; they are here
#: because that file is the claim surface, and because adding `files[]` entries
#: would subject 482 existing evidence documents to the structural rules that
#: mechanism also carries.
#:
#: **The journal is an ERROR, not a warning, and the asymmetry is deliberate.**
#: A `Next action` has one writer, so `perry-task` can refuse it at the point of
#: writing. The journal has no single writer -- a session appends prose to it
#: directly -- so a write-time refusal would miss the largest contributor. On
#: 2026-09-08 one day's entry reached 1,957 lines against a 345-line average
#: evidence document, written by the session that then wrote this check. An
#: error is the strongest gate available where no writer can be intercepted.
#:
#: Evidence is a WARNING because a long one is often correct: a V4 review is
#: legitimately 300-550 lines, and that is where the account is SUPPOSED to
#: live. 600 gives that headroom; past it, a document is usually restating
#: rather than recording.
JOURNAL_DAY_LINES = 300
EVIDENCE_DOC_LINES = 600

#: **The journal cap applies from the day it landed forward, and history is
#: grandfathered.** A journal entry is a record of what happened on a date; it
#: cannot be retroactively shortened without falsifying it, and twelve entries
#: predate this rule. Grandfathering is therefore not leniency, it is the only
#: honest treatment of an append-only record.
#:
#: The date is set to the day the rule landed rather than the day after, so the
#: FIRST entry it refuses is the one written by the session that introduced it
#: -- 1,970 lines against a 300-line cap. A rule whose author is the first to
#: be grandfathered out of it is a rule nobody else will respect.
JOURNAL_CAP_FROM = "2026-09-07"


def check_document_sizes(state_root: Path) -> list["Finding"]:
    """Line caps on `journal/` and `evidence/`, the two uncapped trees.

    LENGTH ONLY, like every other check in this pass. It never judges what a
    document says, and the remedy is never deletion: for the journal, the day's
    account belongs in the evidence file of the row it is about, with the entry
    keeping what changed and why a decision went the way it did.
    """
    findings: list[Finding] = []
    for tree, cap, sev, what in (
            ("journal", JOURNAL_DAY_LINES, "error", "day's entry"),
            ("evidence", EVIDENCE_DOC_LINES, "warn", "document")):
        base = state_root / tree
        if not base.is_dir():
            continue
        for path in sorted(base.rglob("*.md")):
            try:
                raw = path.read_text(errors="replace")
            except OSError:
                continue
            lines = raw.split("\n")
            # **The journal's tool-written status lines do not count against the
            # cap, and this is a correction to the cap made two hours after it
            # landed -- by the session it had just caught, which is worth saying
            # plainly.** `perry-task` appends one `- [TASK-NNN] …` line per state
            # change, and on 2026-09-08 that was 141 of 309 lines. Those lines
            # ARE the journal doing its job: they are the append-only audit trail
            # of what moved, one line per write. Counting them penalises a busy
            # day rather than a verbose one, and the thing this cap exists to
            # stop is the ACCOUNT being duplicated into the entry -- which is
            # prose. So the cap measures prose.
            #
            # The correction bought its author nothing on the day it was made:
            # the entry was trimmed to 206 lines BEFORE this changed, by moving
            # the account to evidence, which is the remedy the rule names.
            if tree == "journal":
                lines = [l for l in lines if not l.startswith("- [")]
            n = len(lines)
            if n <= cap:
                continue
            # See `JOURNAL_CAP_FROM`. The stem is the entry's date, so a name
            # that is not a date is not grandfathered -- an undated file in
            # this tree is a different finding and not silently excused here.
            if tree == "journal" and path.stem < JOURNAL_CAP_FROM:
                continue
            rel = str(path.relative_to(state_root))
            findings.append(Finding(
                sev, rel, "document-oversized",
                f"{n} lines, over the {cap}-line {what} cap. Length only -- "
                f"this says nothing about the content, and the remedy is to "
                f"MOVE what belongs elsewhere, never to delete what was "
                f"recorded. `work/SKILL.md` § Style rules: each fact lives in "
                f"one place; boards reference, evidence stores."))
    return findings


def check_summaries(state_root: Path) -> list["Finding"]:
    """Advisory pass over every OPEN task row's `summary`.

    **Open rows only.** 205 of this board's 319 rows are closed and are
    history; backfilling them was ruled out of scope by TASK-325's spec, and a
    check that reported them would make its own remedy impossible to finish.

    Advisory rather than an error, on the `check_specs` precedent one register
    over: 89 of 114 open rows are blank at the moment this ships, and promoting
    that to an error turns every project's CI red for a field that was
    optional until today. `--strict` does not promote it; branch on the
    `--json` count. The HARD half of TASK-325 is at the other end —
    `perry-task add` refuses to mint a new row without `--summary`, so the
    population this reports is bounded and shrinking rather than replenished.
    """
    findings: list[Finding] = []
    check_summaries.stats = {"store_present": False, "open_rows": 0,
                            "oversized_cells": 0,
                             "carrying": 0, "blank": 0, "shape_findings": 0}
    store = state_root / "tasks.jsonl"
    if not store.exists():
        # Not a pass. Same rule as `check_store_drift`'s "no store" line: a
        # census that did not happen must not print like a clean one.
        return findings
    check_summaries.stats["store_present"] = True

    try:
        raw = store.read_text(errors="replace")
    except OSError:
        # `tasks.jsonl` is a DIRECTORY, or is unreadable. `exists()` is true
        # for both, and `read_text` then raises — one check taking the whole
        # lint run down with it. `check_store_drift` owns reporting the
        # condition; `TestOneCheckMayNotKillTheLint` is what says this one may
        # not crash on it.
        return findings

    rows = []
    for line in raw.split("\n"):
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            # `check_store_drift` owns reporting an unreadable store; saying it
            # twice from two checks is two findings for one defect.
            return findings

    closed = {"done", "dropped"}
    shape_hits = 0
    for r in rows:
        if not isinstance(r, dict):
            continue
        # **Every field here is coerced before it is used.** A store record is
        # not trusted to be well-typed: `check_store_drift` owns reporting a
        # badly-typed one, and `ABadlyTypedStoreIsReportedNotFatal` pins that
        # no shape of no field may kill the lint. The first draft of this loop
        # wrote `r.get("status") in closed`, which raises `TypeError:
        # unhashable type` on a `status` holding a list or a dict — one check
        # taking the whole run down with it, on a file whose entire purpose is
        # to report that the store is malformed.
        status = r.get("status")
        if isinstance(status, str) and status in closed:
            continue
        check_summaries.stats["open_rows"] += 1
        # Same coercion rule as `status` above, and for the same reason: a
        # non-string `title` reaches `.lower()` inside the fold and a
        # non-string `summary` reaches `.strip()`. Both are `TypeError`s that
        # would take the whole lint down on a store this run exists to report.
        def _s(key: str) -> str:
            v = r.get(key)
            return v if isinstance(v, str) else ""
        tid = _s("id") or "(unnamed row)"
        # TASK-447: a Next action is a pointer; preserve its account in evidence.
        # The 400-character guide counts Unicode code points (Python len), not
        # UTF-8 bytes. It warns about length only, never quality, and imposes
        # no write-time refusal. The schema claim surface remains unchanged.
        na = _s("next_action")
        if len(na) > NEXT_ACTION_CELL_CHARACTERS:
            check_summaries.stats["oversized_cells"] += 1
            findings.append(Finding(
                "warn", "tasks.jsonl", "next-action-oversized",
                f"{tid}: `Next action` is {len(na)} Unicode characters, over the "
                f"{NEXT_ACTION_CELL_CHARACTERS}-character cell guide. A board cell is a "
                f"pointer — move the account into "
                f"`evidence/<YYYY-MM>/{tid}-*.md` and leave the sentence a "
                f"reader of the board needs. `work/SKILL.md` § Style rules: "
                f"each fact lives in one place; boards reference, evidence "
                f"stores."))
        hits = summary_shape(_s("title"), _s("summary"))
        if not hits:
            check_summaries.stats["carrying"] += 1
            continue
        if hits[0][0] == "summary-missing":
            check_summaries.stats["blank"] += 1
        else:
            check_summaries.stats["carrying"] += 1
            shape_hits += len(hits)
        for rule, why in hits:
            # The remedy is appended HERE rather than carried in `lib`: the
            # same predicate is read by `perry-task add`, where "write one
            # with `perry-task summary`" is the wrong instruction, because at
            # that point the row does not exist yet.
            findings.append(Finding(
                "warn", "tasks.jsonl", rule,
                f"{tid}: {why} — `perry-task summary {tid} "
                f"--summary \"…\"` writes it"))
    check_summaries.stats["shape_findings"] = shape_hits
    return findings


# ── provenance (DESIGN-003 § 5.4) ──────────────────────────────────────────


SRC_RE = re.compile(r"\bSRC-(\d+)\b")


def field_value(text: str, name: str) -> str | None:
    """A header field's value, in any accepted language, or None.

    Uses the **existing** `field_re` — which carries the `i18n.fields` aliases —
    rather than a second matcher. This function shipped with one for about ten
    minutes: a same-named `field_re` defined 750 lines below the original,
    silently shadowing it, so every caller of the original got a compiled
    pattern where it expected an alternation fragment and the default lint died
    with `multiple repeat at position 30`. One rule, two implementations, in the
    file whose whole job is finding that — caught by the suite, not by review.
    """
    m = re.search(rf"^\s*[->*]*\s*\**\s*{field_re(name)}\s*\**\s*[:：]\s*([^\n]*)$",
                  text, re.M)
    return m.group(1).strip().strip("*` ") if m else None


def card_kind(text: str) -> str | None:
    """The `Kind:` of a knowledge card, or None when this is not a card.

    The discriminator between a card and a digest, declared in
    `schema/state-schema.json § files[id=knowledge-card].discriminator` and
    read — never copied — by both `--knowledge` and `--provenance`. A digest
    carries no `Kind`, so `None` means "not mine" to the card check and "mine"
    to the provenance check, and neither reports the other's files.
    """
    v = field_value(text, "Kind")
    return v if v in CARD_KINDS else None


def resolves_somewhere(src: str, state_root: Path, project_root: Path) -> bool:
    """Can a reader re-open what this `Source:` names?

    Three forms are in circulation and all three are legitimate, so the check
    is "any token in the cell resolves" rather than a grammar:

    - a **path** — `evidence/2026-08/TASK-001-x.md`, resolved against the state
      root and then the project root, the same order `evidence_paths` uses;
    - a **`SRC-n`** — a digest in this tree carrying that id;
    - a **task id** — any id-shaped token the board or the event log knows.

    Deliberately permissive: this is advisory, and reporting a source that a
    human can plainly follow would train people to ignore the check. What it
    catches is the case that matters — a cell naming nothing that exists.

    **`project_root` is passed, never derived from `state_root`.** The first
    version computed `state_root.parent`, which is right only when the state
    root is nested. `resolve_state_root` returns the PROJECT root by default —
    so on every project that has not moved its state, that expression named the
    directory ABOVE the project, `.perry/events.jsonl` was looked for there,
    and a card citing the task id of a closed row was reported as dangling. The
    same wrong idiom was in `check_knowledge`, one screen down.
    """
    for tok in re.split(r"[\s,;·|]+", src.strip()):
        tok = tok.strip("*`()[]<>")
        if not tok:
            continue
        if "/" in tok or tok.endswith(".md"):
            if (state_root / tok).exists() or (project_root / tok).exists():
                return True
            continue
        if SRC_RE.fullmatch(tok):
            kdir = state_root / "knowledge"
            for md in (kdir.rglob("*.md") if kdir.exists() else []):
                if re.search(r"^>\s*Id\s*[:：]\s*" + re.escape(tok) + r"\b",
                             strip_comments(md.read_text(errors="replace")), re.M):
                    return True
            continue
        if re.fullmatch(r"[A-Z][A-Z0-9]{1,7}-\d+", tok):
            # TASK-237 3b: with no file, the ids the board WOULD carry, read
            # from the stores it is rendered from. Returning quietly here made
            # every card citing an open task or an ask read as dangling. Since
            # TASK-262 round 4b that is the only answer: a held `BOARD.md` is
            # retired, and an id only it carries resolves nowhere.
            if tok in ids_the_board_would_carry(state_root):
                return True
            events = project_root / ".perry" / "events.jsonl"
            if events.exists() and tok in events.read_text(errors="replace"):
                return True
    return False


def ids_the_board_would_carry(state_root: Path) -> set[str]:
    """Every id a rendered `BOARD.md` holds, from the stores alone.

    What `perry-tasks board` prints rows for (`perry_store §
    DECLARED_BOARD_CHOICES` "which rows"): open task records, and every ask,
    risk and cadence record. Intake has no id. A store that cannot be read
    contributes nothing — `*-store-unreadable` is the finding for that.
    """
    stores, _findings = _STORE.load_board_stores(state_root)
    ids = {r["id"] for r in stores.get("tasks", [])
           if r.get("status") not in _STORE.TERMINAL_STATUSES}
    for name in ("asks", "risks", "cadence"):
        ids |= {r["id"] for r in stores.get(name, []) if r.get("id")}
    return ids


def undecorate(text: str) -> str:
    """Markdown emphasis and backticks removed, case and spacing kept.

    `squash` lowercases, which would break a schema pattern anchored on a
    capital. This strips only the decoration a human adds to a heading, so
    `**Top risks**` and `` `Top risks` `` match the same pattern the plain form
    does.
    """
    return re.sub(r"[`*_]+", "", text).strip()


def intake_rows(text: str) -> int:
    """Undischarged rows under `## Intake`, or 0 when the section is absent.

    Counted here rather than assumed from the line delta: a board can be over
    its cap for ordinary reasons, and prescribing "run triage" to a project
    whose intake is empty would be as wrong as prescribing a split to one whose
    intake is full.
    """
    lines = text.split("\n")
    start = next((i for i, l in enumerate(lines)
                  if l.startswith("## ") and heading_is_intake(l[3:])), None)
    if start is None:
        return 0
    end = next((i for i in range(start + 1, len(lines))
                if lines[i].startswith("## ")), len(lines))
    n = 0
    for line in lines[start + 1:end]:
        s = line.strip()
        if not s.startswith("|") or re.match(r"^\|\s*:?-{2,}", s):
            continue
        cells = split_row(s)
        if not cells or header_index(cells[:1]).column(
                "arrived", "到达", "") == 0:
            continue
        # `Outcome` is the last column and holds a drop reason or a routing.
        if len(cells) < 3 or lib.is_blank_cell(cells[-1]):
            n += 1
    return n


def heading_is_intake(head: str) -> bool:
    return any(squash(head).startswith(squash(a))
               for a in ["Intake", *HEADING_ALIASES.get("Intake", [])])


def check_role_cards(project_root: Path, schema: dict) -> list["Finding"]:
    """A role card is a hiring contract, never a workflow.

    `DESIGN-006 § 5.2`, decision #1. Each of the four blocks has a mechanical
    consumer — `Context` and `May touch` are rendered into the delegation
    prompt, `Loads` drives knowledge injection, `Must escalate` is **unioned**
    with the project high-stakes list in the dispatch pre-flight — and a fifth
    section is prose nothing reads.

    **The check is the closed set, not a blacklist of `## Workflow`.** That
    heading is only the first spelling; `## Steps`, `## Procedure`, `## How to`
    are the same violation wearing other names, and a guard written against the
    literal string is the instance-shaped guard this project has found in every
    review round. A card carrying a workflow-like heading gets a sharper
    message, because it made decision #1's exact mistake and deserves to be told
    which rule it broke.

    Advisory. The refusal belongs at `delegate` (phase D), where a card that
    cannot be rendered is a run that should not start.
    """
    spec = next((f for f in (schema.get("files") or [])
                 if f.get("id") == "role-card"), None)
    if not spec:
        return []
    sec = spec.get("sections") or {}
    allowed = set(sec.get("allowed") or [])
    workflowish = {w.lower() for w in (sec.get("workflow_like") or [])}
    findings: list[Finding] = []
    rdir = project_root / ".perry" / "roles"
    for md in sorted(rdir.glob("*.md")) if rdir.exists() else []:
        text = strip_comments(md.read_text(errors="replace"))
        rel = md.relative_to(project_root).as_posix()
        seen = set()
        for level, title, line in headings(text):
            if level != 2:
                continue
            seen.add(title)
            if title in allowed:
                continue
            if title.lower() in workflowish:
                findings.append(Finding(
                    "warn", rel, "role-card-is-a-workflow", line=line,
                    message=(
                        f"`## {title}` — a role card is a **hiring contract the "
                        f"harness instantiates, never a workflow** (DESIGN-006 "
                        f"decision #1). What the role *does* belongs in the "
                        f"task and the lane docs; this file says who it is, "
                        f"what it may touch, and what it must escalate.")))
            else:
                findings.append(Finding(
                    "warn", rel, "role-card-unknown-section", line=line,
                    message=(
                        f"`## {title}` is not one of "
                        f"{', '.join(sorted(allowed))}. Each of those four has "
                        f"a mechanical consumer — prompt, injection, "
                        f"pre-flight union, close gate — and a fifth section is "
                        f"prose nothing reads.")))
        for want in sorted(allowed - seen):
            findings.append(Finding(
                "warn", rel, "role-card-incomplete", line=1,
                message=(f"`## {want}` is missing. A card without it cannot be "
                         f"rendered into a delegation prompt.")))

        # An escalation line that yields NO FRAGMENT enforces nothing.
        #
        # The pre-flight scan extracts backticked fragments and matches those.
        # A line written as plain prose reads like a rule, sits under the
        # heading that carries the only hard field on the card, and contributes
        # zero fragments to the union — so the role looks constrained and is
        # not. This is the `hook_TEMPLATE.md` backtick bug, in the file that
        # inherited its extraction rule; DESIGN-006 § 7 names it as the same
        # failure class and this is the same fix.
        #
        # **Backticks are not the test; the extractor is.** A backticked span
        # below `P.extracts`' floor also yields nothing, and asking about
        # punctuation instead of about fragments is how that line stayed
        # silent — the same failure class re-entering through its own fix.
        # TASK-201.
        #
        # **The sentence comes from `P.unextractable_says`, not from here.**
        # It is the same sentence `hook-escalation-not-extractable` says four
        # hundred lines up and the same one `bin/perry-state` says in the
        # standup, and it is one function for the reason the extractor is one
        # function: three copies is how the third went stale, which is exactly
        # what happened — `perry-state` still told users their line "has no
        # backticked span" after TASK-201 changed the answer here and left the
        # other copy alone. TASK-202.
        card = P.parse_role_card(md.stem, md.read_text(errors="replace"))
        for bullet in card.escalate_unextractable:
            findings.append(Finding(
                "warn", rel, "role-escalation-not-extractable",
                message=P.unextractable_says(bullet, P.CARD_SECTION)))
    return findings


#: The keys a V4 verdict block must carry. `work/reference/review.md § 3`.
#: `proof` is required only on a FAIL — a PASS's proof is the `checked:` line.
VERDICT_KEYS = ("task", "rung", "result", "criteria", "checked", "not-checked")

#: The two grades a criterion may carry, `review.md § 3` / `DESIGN-016-spec.md
#: § What a criterion may do to a row`. **FAIL** — the defect answers yes to
#: one of `review.md § 0`'s three questions and fails the row. **ROW** — it is
#: real, it is still reported, and the round files it and moves on.
FAIL_GRADES = ("FAIL", "ROW")

#: The grade token at the head of a `grade:` value. A bare word, and the word
#: must END there — `row-grade` and `ROWS` are typos, not grades, and a typo
#: that silently read as `ROW` would quiet the guard by accident, which is the
#: one direction this row may not move.
_GRADE_TOKEN = re.compile(r"([A-Za-z]+)(?![-\w])")


def fail_grade(fields: dict) -> "str | None":
    """The grade of the criterion a FAIL was charged against, or `None`.

    `review.md § 6` counts FAILs to decide that a row is failing on a principle
    nobody has picked. It counted verdict BLOCKS, and two FAILs were two FAILs
    whatever they were about — but `DESIGN-016-spec.md § What a criterion may
    do to a row` grades each criterion by consequence, and a FAIL charged
    against a ROW-grade criterion is a filed row, not a failed one. TASK-360's
    two FAILs were one of each; by the bar that now governs it, it failed once.

    **`None` is undeterminable and the caller must count it.** That is the
    conservative default and it is deliberate: 62 of the 62 FAIL blocks in this
    repository's corpus carry no `grade:`, because `review.md § 1` only later
    began refusing a round without written criteria. Reading silence as `ROW`
    would retroactively un-exhaust rows nobody regraded, which is `review.md
    § 6` being loosened by an accident of history.

    Only the FIRST token is the grade. The rest of the line is the criterion
    reference — `grade: ROW — criterion 2b, --help from a non-first position` —
    which is for the reader, because a grade with no criterion beside it is a
    claim with nothing to check it against. The parser does not read it; a
    round that writes a grade it cannot justify is refuted by the round that
    shows the consequence is worse, and that refutation is a finding.

    Read only on a `result: FAIL` block. On a PASS it is meaningless and
    ignored — a PASS ends the row's history and the question with it.
    """
    raw = (fields.get("grade") or "").strip()
    if not raw:
        return None
    m = _GRADE_TOKEN.match(raw)
    if not m:
        return None
    tok = m.group(1).upper()
    return tok if tok in FAIL_GRADES else None


_VERDICT_BLOCK = re.compile(
    r"^===\s*VERDICT\s*===\s*$(.*?)^===\s*END VERDICT\s*===\s*$",
    re.M | re.S)


def parse_verdicts(text: str) -> list[tuple[dict, int]]:
    """Every `=== VERDICT ===` block in a document, with its line number.

    Returns `(fields, line)` pairs. A key repeated inside one block keeps the
    LAST value, matching how every other `Key: value` block in Perry parses —
    silently keeping the first would make a corrected verdict read as the
    uncorrected one.

    Continuation lines (indented under a key) are joined into that key, because
    `checked:` routinely runs to several lines and a reviewer should not have
    to fight the parser to write a full sentence.
    """
    out: list[tuple[dict, int]] = []
    for m in _VERDICT_BLOCK.finditer(text):
        line0 = text[:m.start()].count("\n") + 1
        fields: dict[str, str] = {}
        key = None
        for raw in m.group(1).split("\n"):
            if not raw.strip():
                continue
            kv = re.match(r"^([a-z][a-z-]*)\s*:\s*(.*)$", raw.strip())
            if kv:
                key = kv.group(1)
                fields[key] = kv.group(2).strip()
            elif key and raw[:1].isspace():
                fields[key] = (fields[key] + " " + raw.strip()).strip()
        out.append((fields, line0))
    return out


#: A trailing `:1204` or `:1204-1210` on a cited path. Stripped before the
#: existence test, and the token is rejected if a `:` survives — a `proof:`
#: reading `bin/perry-goals:927/:908/` is prose about two lines, not a path.
_CITE_LINE = re.compile(r":\d+(?:-\d+)?$")

#: Anything that cannot appear in a path Perry would cite. `bin/+viewer/` and
#: `ADR-007](decisions/ADR-007-probe.md` are both real tokens from this board's
#: own reviews, and both are prose.
_CITE_BAD = re.compile(r"[+\[\]()<>*`\s]")

#: Reviewers verify destructively on a COPY (`review-constraints.md § You are
#: a reader`), so a citation into the scratch tree is the convention working,
#: not a broken reference. Never reported.
_CITE_SCRATCH = ("scratchpad", "scratch", "tmp", "/tmp")


def verdict_citations(src: str, state_root: Path, project_root: Path
                      ) -> list[tuple[str, bool]]:
    """Path claims inside one verdict field, each with whether it resolves.

    `work/reference/review.md § 2 · What V4 does not judge`. Rounds on this
    board spent a full fresh-context review discovering that a citation named
    a file the branch does not carry — "three citations point at a file the
    branch does not carry", "a claimed filing, on the branch, that is not
    there". A regex knew, and it cost a round each time.

    **What counts as a path claim is bounded on purpose**, because a check that
    reports correct prose is one people switch off (§ 1's own table). Read only
    from `criteria:` and `proof:`, which the convention REQUIRES to be a path;
    `checked:` is a sentence by design and scanning it is guessing. A token is
    a claim only when ALL of these hold:

    - its first segment is non-empty. `/pmo` is a command, and the first
      version split on `/`, got an empty head, and `root / ""` is a directory
      that always exists — so every command name was a broken path.
    - no `+`, bracket, paren, backtick or angle in it.
    - no `:` survives the line-suffix strip.
    - its last segment is not all digits — `tests/3` is a count.
    - the first segment is a directory that exists.
    - it is not under a scratch tree.

    Every one of those exclusions is a token this board's own 79 reviews
    actually produced. The rule is deliberately narrower than "looks like a
    path": a missed citation costs nothing (the round still runs), and a false
    one costs the check its credibility.
    """
    out: list[tuple[str, bool]] = []
    for tok in re.split(r"[\s,;·|]+", src.strip()):
        tok = tok.strip("*`()[]<>\"")
        for suf in ("'s", "\u2019s"):
            if tok.endswith(suf):
                tok = tok[:-len(suf)]
        tok = tok.rstrip(",.;:)]}\'\"")
        if not tok:
            continue
        bare = _CITE_LINE.sub("", tok)
        if not bare or ":" in bare or _CITE_BAD.search(bare):
            continue
        segs = [s for s in bare.split("/")]
        head = segs[0]
        if not head or not segs[-1] or segs[-1].isdigit():
            continue
        if head in _CITE_SCRATCH or bare.startswith("/tmp"):
            continue
        if not ((state_root / head).is_dir() or (project_root / head).is_dir()):
            continue
        out.append((bare, (state_root / bare).exists() or
                          (project_root / bare).exists()))
    return out


_BOUND_RE = re.compile(r"^#{2,}\s*Bound\b", re.M)


#: `reference/glossary.md` — one entry per concept, and the `Implemented:` line
#: is the brake. See that file's own header for why this is a constraint rather
#: than documentation.
GLOSSARY_PATH = SCHEMA_PATH.parent.parent / "reference" / "glossary.md"

_GLOSS_ENTRY = re.compile(
    r"^### (?P<term>.+?)\n(?P<body>.*?)(?=^### |\Z)", re.M | re.S)


def parse_glossary(text: str) -> list[dict]:
    """`### term` + prose + `Implemented:` → one dict per entry, with line no."""
    out = []
    for m in _GLOSS_ENTRY.finditer(text):
        body = m.group("body")
        impl = re.search(r"^Implemented:\s*(.+?)\s*$", body, re.M)
        meaning = "\n".join(l for l in body.split("\n")
                             if l.strip() and not l.startswith("Implemented:"))
        out.append({
            "term": m.group("term").strip(),
            "meaning": meaning.strip(),
            "implemented": (impl.group(1).strip() if impl else ""),
            "line": text[:m.start()].count("\n") + 1,
        })
    return out


def check_glossary(project_root: Path) -> list["Finding"]:
    """Every concept names where it lives, or declares that it does not.

    **The count of `prose-only` entries is the point.** A vocabulary grows
    faster than the code it describes — one working session can coin a dozen
    terms and cite them in the same breath, each obvious to the session that
    coined it and opaque to the next one and to the human reading the board.
    Requiring each entry to name a tool, a schema field or a test makes a new
    concept cost something, and `prose-only` keeps the ones that genuinely are
    prose visible instead of free.

    Three findings:

    - `glossary-path-missing` — an `Implemented:` naming a file that is not
      there. The commonest way an entry rots is the code moving out from under
      it, and an entry pointing at nothing is worse than no entry: it reads as
      verified.
    - `glossary-no-implementation` — an entry with neither a path nor
      `prose-only`. Not an error about the concept; an error about not saying.
    - `glossary-term-unused` — a term defined here and used nowhere else in the
      repository. A concept nobody reached for is complexity that was added and
      never paid off, and removing it is free.

    Advisory and opt-in, like every other `--flag` pass here.
    """
    findings: list[Finding] = []
    if not GLOSSARY_PATH.exists():
        return findings
    text = GLOSSARY_PATH.read_text(errors="replace")
    entries = parse_glossary(text)
    rel = "reference/glossary.md"

    corpus = []
    for d in ("bin", "viewer", "reference", "work", "goals", "decide", "modes",
              "schema", "tests", "packs"):
        for f in (GLOSSARY_PATH.parent.parent / d).rglob("*"):
            if f.is_file() and f.suffix in (".md", ".json", ".py", "") \
                    and "__pycache__" not in f.parts and f != GLOSSARY_PATH:
                corpus.append(f)
    blob = "\n".join(f.read_text(errors="replace") for f in corpus)

    prose_only = 0
    for e in entries:
        impl = e["implemented"]
        if not impl:
            findings.append(Finding(
                "warn", rel, "glossary-no-implementation",
                f"`{e['term']}` names neither a path nor `prose-only` — say "
                f"which", e["line"]))
        elif impl == "prose-only":
            prose_only += 1
        else:
            path = impl.split(" § ")[0].strip().strip("`")
            if not (GLOSSARY_PATH.parent.parent / path).exists():
                findings.append(Finding(
                    "warn", rel, "glossary-path-missing",
                    f"`{e['term']}` says it is implemented in {path}, which "
                    f"does not exist — an entry pointing at nothing reads as "
                    f"verified", e["line"]))
        if e["term"] not in blob:
            findings.append(Finding(
                "warn", rel, "glossary-term-unused",
                f"`{e['term']}` is defined here and used nowhere else — a "
                f"concept nobody reached for is complexity that never paid "
                f"off", e["line"]))

    check_glossary.entries = len(entries)
    check_glossary.prose_only = prose_only
    return findings


#: The store key `- Review rounds before escalation: N` mints, per the same
#: label→key rule every other setting follows (`Document language` →
#: `document_language`).
ROUNDS_SETTING_KEY = "review_rounds_before_escalation"


def rounds_before_escalation(project_root: Path) -> tuple[int, str]:
    """How many V4 FAILs a row may take, and WHERE that number came from.

    Most specific wins, the same order `perry-conform § gate_mode` established
    for `Conformance gate`: env `PERRY_REVIEW_ROUNDS` beats the project's
    declared `Review rounds before escalation` beats the shipped default in
    `schema § thresholds`.

    **The source is returned beside the number** because a threshold that
    fires without saying which register set it is the shape this repository
    keeps re-finding — a rule stated in one place and implemented from
    another. A reader who disagrees with the gate needs to know which file to
    edit.

    **`.perry/config.jsonl` is the only register the project can declare it
    in** (ADR-019). A store answering without the key is an ANSWER — the key is
    not declared — and there is no second file to fall through to; the
    `.perry/config.md` branch that used to sit here lost its subject when the
    projection was deleted.
    """
    # **A limit below 1 is not a limit, it is an inversion.** `len(fails) <
    # 0` is never true, so a declared 0 would fire this finding on every live
    # row carrying any verdict block at all — including rows with zero FAILs.
    # Values under 1 are refused here rather than clamped, so the report names
    # the register that actually set the number in force.
    #
    # **Every return below is >= 1, and the caller relies on exactly that.**
    # A second guard at the comparison was written first and then deleted: it
    # was unreachable while this holds, and two implementations of one rule is
    # the defect this repository finds most often. The invariant is pinned by
    # `test_the_resolver_never_returns_a_limit_below_one` instead.
    env = (os.environ.get("PERRY_REVIEW_ROUNDS") or "").strip()
    if env.isdigit() and int(env) >= 1:
        return int(env), "PERRY_REVIEW_ROUNDS"

    declared, register = None, ""
    stored, _why = P.config_store_settings(Path(project_root))
    if stored is not None:
        declared = (stored.get(ROUNDS_SETTING_KEY) or "").strip()
        register = ".perry/config.jsonl"
    if declared and declared.isdigit() and int(declared) >= 1:
        return int(declared), register

    value = (SCHEMA_THRESHOLDS.get("review_fail_rounds_before_escalation")
             or {}).get("value")
    if isinstance(value, int) and value >= 1:
        return value, "schema § thresholds"
    return 2, "built-in default"


def check_reviews(state_root: Path, project_root: Path) -> list["Finding"]:
    """A V4 verdict that a tool can read, and a row that moved when it arrived.

    `work/reference/review.md` exists because Perry ran ten V4 rounds in one
    night and they wrote the verdict five different ways — `FAIL`,
    `**Verdict**`, `> **VERDICT —**`, `> **Verdict:**`, and a decorated section
    heading. Three carried no line a parser could find at all.

    **A verdict nothing can read is a verdict that gets misfiled, and it was.**
    Rows sat at `review` after their review had already failed, reported by the
    user rather than by any check. This is that check.

    Advisory, and opt-in behind `--reviews`, for the same reason
    `--verification` is: a project that predates the convention has evidence
    documents written in prose, and promoting those to errors would retroactive
    -ly condemn every review it ever ran. What it reports is a worklist.

    Eight findings. The last three are about the cost of the round rather
    than its shape — two of them are the pre-check `review.md § 2` moves OUT
    of the round, because a full fresh-context review is the most expensive
    way this board has found to discover a broken citation:

    - `verdict-malformed` — a block missing a required key, or a `result` that
      is neither `PASS` nor `FAIL`.
    - `fail-without-proof` — a FAIL naming no file. A FAIL that cannot point at
      a line is a suspicion, and it goes back to the reviewer rather than onto
      the board.
    - `v4-close-without-verdict` — a row closed at V4 whose evidence contains
      no verdict block naming it. This is the rung being claimed rather than
      run.
    - `fail-verdict-left-at-review` — a FAIL exists and the row is still at
      `review`. `review` means *out for verification*; a row whose verdict has
      arrived is no longer there in either direction.
    - `review-with-no-verdict` — the symmetric half: a row at `review` at V4
      for which no round was ever dispatched.
    - `review-rounds-exhausted` — two FAILs and no PASS, with no open ask
      blocking the row. The third round is where this board stopped
      converging and started re-deriving; see the comment on the check.
      **Counted by criterion, not by block** (TASK-419): a FAIL whose
      `grade:` says `ROW` was charged against a criterion whose worst
      outcome fails no row, so it is filed and not counted. A FAIL with no
      readable `grade:` is UNDETERMINABLE and counts — the default is the
      conservative one, and the finding says how many it counted that way.
    - `citation-not-on-branch` — a `criteria:`, `proof:` or `checked:` path
      the branch does not carry. Found four times by a reviewer, at a round
      each, when a regex knew.
    - `criteria-unbounded` — the criteria file carries no `## Bound`, so the
      round has no finite set to check. TASK-050 ran ELEVEN rounds against a
      universal negative and passed on the round the criterion became
      decidable, not on the round the last hole closed (`review.md § 1`).

      **The question this one answers**: *this round scored against an
      unbounded criterion.* It is the VERDICT-side half of `review.md § 1`.
      The SPEC-side half is `spec-unbounded` in `check_specs`, which answers
      *this spec offers a round no finite set to check* and needs no verdict
      to say so. **Do not unify them** (TASK-308). This one reads `criteria:`
      out of a `parse_verdicts` block, and such a block exists only once a
      round has already scored — so on 2026-09-03 it was reporting 0 across
      127 unbounded specs, and TASK-285 and TASK-323 both reached V4 without
      a bound. Deleting either check trades one blind spot for the other: this
      one alone cannot speak before a round, and `spec-unbounded` alone cannot
      see a criteria file that is not a `*-spec.md` — `review.md § 1` allows a
      `## What must be true when this is done` section in a task's own
      evidence file, and `spec-unbounded` does not read those.
    """
    findings: list[Finding] = []
    seen: dict[str, list[tuple[str, dict, int]]] = {}

    # The two pre-check findings below are scoped to rows that are still OPEN.
    # A closed row's criteria cannot be re-bounded and its exhibit cannot be
    # re-filed, so reporting them condemns every review this project ran before
    # the convention existed — the exact retroactive verdict this mode's
    # docstring refuses. It also keeps `--reviews --strict` able to gate a
    # dispatch: a backlog nobody can clear is a gate that is red forever, which
    # is a gate people delete.
    closed_rows = closed_task_ids(project_root)

    edir = state_root / "evidence"
    for md in sorted(edir.rglob("*.md")) if edir.exists() else []:
        rel = md.relative_to(state_root).as_posix()
        text = strip_comments(md.read_text(errors="replace"))
        for fields, line in parse_verdicts(text):
            tid = fields.get("task", "")
            seen.setdefault(tid, []).append((rel, fields, line))

            missing = [k for k in VERDICT_KEYS if not fields.get(k)]
            if missing:
                findings.append(Finding(
                    "warn", rel, "verdict-malformed",
                    f"verdict block is missing {', '.join(missing)} — "
                    f"see work/reference/review.md § 3", line))
            result = fields.get("result", "")
            if result and result not in ("PASS", "FAIL"):
                findings.append(Finding(
                    "warn", rel, "verdict-malformed",
                    f"result is {result!r}; the only two values are PASS and "
                    f"FAIL", line))
            # A `grade:` the resolver cannot read counts as undeterminable,
            # so it is SAFE — but it is silently safe, and a reviewer who
            # wrote `grade: row-grade` believes they filed a row. Say so.
            grade_raw = (fields.get("grade") or "").strip()
            if grade_raw and fail_grade(fields) is None:
                findings.append(Finding(
                    "warn", rel, "verdict-malformed",
                    f"grade is {grade_raw!r}; the only two values are ROW and "
                    f"FAIL — see work/reference/review.md § 3. Counted as "
                    f"undeterminable, which still counts toward "
                    f"`review-rounds-exhausted`", line))
            if result == "FAIL" and not fields.get("proof"):
                findings.append(Finding(
                    "warn", rel, "fail-without-proof",
                    f"{tid or 'this block'} FAILs with no `proof:` naming a "
                    f"file — a FAIL that cannot point at a line is a "
                    f"suspicion, not a verdict", line))

            # ── the two pre-check findings ────────────────────────────────
            # The ones a round must NEVER spend itself on: `review.md § 2 ·
            # What V4 does not judge`. Both are cheap and both are decidable,
            # and this board discovered them four and eleven rounds late.
            #
            # `criteria:` and `proof:` only. `checked:` is a sentence by
            # design — "guarantees 1,2,4,5 on gimegime-pmo (365→380 ids)" is
            # the shape the convention asks for — and mining a sentence for
            # paths is how this check first reported `tables.py`, `/pmo` and
            # `bin/perry-lint:812's` as broken references.
            if tid and tid not in closed_rows:
                for key in ("criteria", "proof"):
                    for tok, ok in verdict_citations(
                            fields.get(key, ""), state_root, project_root):
                        if ok:
                            continue
                        findings.append(Finding(
                            "warn", rel, "citation-not-on-branch",
                            f"`{key}:` cites {tok} — the branch does not "
                            f"carry it. Fix the exhibit before dispatching, "
                            f"not in a round", line))

                for tok, ok in verdict_citations(
                        fields.get("criteria", ""), state_root, project_root):
                    if not ok or not tok.endswith(".md"):
                        continue
                    cpath = (state_root / tok if (state_root / tok).exists()
                             else project_root / tok)
                    if not _BOUND_RE.search(
                            strip_comments(cpath.read_text(errors="replace"))):
                        findings.append(Finding(
                            "warn", rel, "criteria-unbounded",
                            f"{tok} carries no `## Bound` — the round has no "
                            f"finite set to check and no last element. "
                            f"work/reference/review.md § 1", line))

    # TASK-237 3b: this returned here when the file was absent, and everything
    # below went quiet with it — the event-log pass that finds a V4 close with
    # no verdict, and every check on a live row. **Since TASK-262 round 4b no
    # board file is read**, held or not: the live rows are the store's open
    # records, the rows `perry-tasks board` prints.

    def verdicts_for(tid: str) -> list[dict]:
        return [f for _, f, _ in seen.get(tid, [])]

    live: dict[str, str] = {}
    #: The rung each live row declares, so the symmetric check below can ask
    #: "is this row even at a rung that needs a round" rather than reporting
    #: every `review` row on the board.
    rungs: dict[str, str] = {}
    stores, _findings = _STORE.load_board_stores(state_root)
    for rec in stores.get("tasks", []):
        if rec.get("status") in _STORE.TERMINAL_STATUSES:
            continue
        live[rec["id"]] = str(rec.get("status") or "")
        rungs[rec["id"]] = str(rec.get("verification") or "")
    # **A V4 close no event records** (TASK-262 round 4b, F14 re-pointed). This
    # pass judged the `done` rows at V4 a person kept by hand in a held
    # `BOARD.md`; the event pass below judges only closures `perry-task done`
    # made. The store's `done` records that no `done` event closed are what a
    # hand-kept row became on import, so they are judged here instead.
    rel_store, closed = closed_without_a_done_event(state_root, project_root)
    for n, rec in closed:
        if str(rec.get("verification") or "").strip().upper() != "V4":
            continue
        if not any(f.get("result") for f in verdicts_for(rec["id"])):
            findings.append(Finding(
                "warn", rel_store, "v4-close-without-verdict",
                f"{rec['id']} is closed at V4, no `done` event records the "
                f"closure, and no evidence document carries a verdict block "
                f"naming it — the rung is claimed, not run", n))

    # `done` REMOVES the row, so a board scan alone measures an empty set on any
    # project using the tool — the same trap `check_verification` documents.
    log = project_root / ".perry" / "events.jsonl"
    #: When each ask was answered, and when each evidence document first
    #: appeared in a row's `Evidence` cell. Both feed the escalation ordering
    #: below: an answered ask clears the FAILs it was answering and no others,
    #: and "which FAILs" is a comparison of these two timestamps.
    #:
    #: `filed_at` takes the EARLIEST event naming a path, because the cell is
    #: rewritten every time evidence is added and later rewrites would date the
    #: document to whenever it was last mentioned.
    _answer_ts: dict[str, str] = {}
    _filed_at: dict[str, str] = {}
    if log.exists():
        for raw in log.read_text(errors="replace").split("\n"):
            raw = raw.strip()
            if not raw:
                continue
            try:
                ev = json.loads(raw)
            except (ValueError, TypeError):
                continue
            ts = str(ev.get("ts") or "")
            if ev.get("event") == "answer" and ts:
                aid = str(ev.get("id") or "")
                if aid and ts > _answer_ts.get(aid, ""):
                    _answer_ts[aid] = ts
            if ev.get("event") == "evidence" and ts:
                for path in re.findall(r"[\w./-]+\.md",
                                       str(ev.get("to") or "")):
                    if ts < _filed_at.get(path, "\uffff"):
                        _filed_at[path] = ts
            if ev.get("event") != "done":
                continue
            tid = str(ev.get("task") or ev.get("id") or "")
            if not tid or str(ev.get("rung") or "").upper() != "V4":
                continue
            if not any(f.get("result") for f in verdicts_for(tid)):
                findings.append(Finding(
                    "warn", ".perry/events.jsonl", "v4-close-without-verdict",
                    f"{tid} was closed at V4 and no evidence document carries "
                    f"a verdict block naming it — the rung is claimed, not "
                    f"run"))

    # **A row can be at `review` for two opposite reasons**, and the first
    # version of this check could not tell them apart: the verdict arrived and
    # nobody moved the row, or the FAIL was acted on and the row was re-sent.
    # It reported the second as the first the moment its own author fixed a
    # round and returned the task — which is the correct workflow.
    #
    # The event log already distinguishes them and needs no new field. A FAIL
    # is what moves a row OFF `review`; so if the row has since come BACK, the
    # verdict has been acted on. Read as: most recent status event sets
    # `review`, and an earlier one moved it away.
    resent: set[str] = set()
    if log.exists():
        history: dict[str, list[str]] = {}
        for raw in log.read_text(errors="replace").split("\n"):
            raw = raw.strip()
            if not raw:
                continue
            try:
                ev = json.loads(raw)
            except (ValueError, TypeError):
                continue
            to = str(ev.get("to") or "")
            # **`field` missing does NOT mean "this is a status event".**
            # Events written before that key existed carry no `field` at all,
            # and a `next` event's `to` is the next-action TEXT — so treating
            # `None` as status made a 900-character prose blob the row's
            # "current status", and no row ever looked re-sent. Four rows sat
            # reported as verdict-ignored while they had been acted on.
            #
            # The honest test is the VALUE: a status transition ends at one of
            # the declared statuses, read from the schema rather than listed.
            if to not in TASK_STATUSES:
                continue
            tid = str(ev.get("task") or ev.get("id") or "")
            if tid:
                history.setdefault(tid, []).append(to)
        for tid, seq in history.items():
            if seq[-1] == "review" and "review" in seq[:-1]:
                resent.add(tid)

    for tid, status in live.items():
        if status != "review" or tid in resent:
            continue
        if any(f.get("result") == "FAIL" for f in verdicts_for(tid)):
            where = next(r for r, f, _ in seen[tid] if f.get("result") == "FAIL")
            findings.append(Finding(
                "warn", "BOARD.md", "fail-verdict-left-at-review",
                f"{tid} is at `review` and {where} already FAILed it — "
                f"`review` means out for verification, so a row whose verdict "
                f"has arrived does not belong there"))

    # **The symmetric half, and it was missing.** The check above reports a
    # verdict that arrived and was ignored. Nothing reported the opposite: a row
    # at `review` for which no round was ever dispatched.
    #
    # Found on this board. TASK-093 sat at `review` because I moved it there
    # and never sent the round — and `--reviews` said the board was clean,
    # because the only shape it knew was a verdict nobody acted on. Two
    # symmetric failure modes, one covered.
    #
    # It reports the AGE rather than judging it: a row sent an hour ago and one
    # forgotten a week ago are the same state, and only the reader knows which
    # is which. A threshold here would be the checker guessing.
    #: When each row last moved TO `review`, so the finding can say how long it
    #: has sat there. Reported, never judged — a row sent an hour ago and one
    #: forgotten a week ago are the same STATE, and a threshold here would be
    #: the checker guessing which.
    _days_at_review: dict[str, int] = {}
    if log.exists():
        from datetime import date as _date, datetime as _dt
        for raw in log.read_text(errors="replace").split("\n"):
            raw = raw.strip()
            if not raw:
                continue
            try:
                ev = json.loads(raw)
            except (ValueError, TypeError):
                continue
            if str(ev.get("to") or "") != "review":
                continue
            tid = str(ev.get("task") or ev.get("id") or "")
            ts = str(ev.get("ts") or "")[:10]
            if not tid or not ts:
                continue
            try:
                _days_at_review[tid] = (_date.today() - _dt.strptime(
                    ts, "%Y-%m-%d").date()).days
            except ValueError:
                continue

    for tid, status in live.items():
        if status != "review" or verdicts_for(tid):
            continue
        if (rungs.get(tid) or "").upper() != "V4":
            continue
        age = _days_at_review.get(tid)
        how_long = (f"{age} day(s) ago" if age is not None
                    else "at an unknown time — no event records the move")
        findings.append(Finding(
            "warn", "BOARD.md", "review-with-no-verdict",
            f"{tid} is at `review` at V4 and no evidence document carries a "
            f"verdict block naming it. It moved there {how_long}. Either a "
            f"round is in flight, or one was never sent — `review` is not a "
            f"resting place, and only you can tell those apart"))

    # **The waiting room below V4** (TASK-379). The check above guards V4 and
    # returns early on every other rung, so a row at `review` carrying V3, V2
    # or NO RUNG AT ALL was invisible — and `review` is where this board's
    # rows go to be forgotten.
    #
    # **The rung chooses the artifact.** This is the correction the row's own
    # brief needed: it asked for "a row at review with no verdict document",
    # and a verdict block is a V4 artifact (`review.md § 3`). Measured
    # 2026-09-12, three of the eight rows at `review` carried no verdict block
    # and two of those three were V3 rows whose rung never asked for one —
    # `TASK-183` and `TASK-415`, both with a complete result document on disk.
    # Reporting those would have made this check noise on the day it shipped.
    #
    # The evidence directory is read INDEPENDENTLY of the row's own `evidence`
    # cell, on purpose. `TASK-253` sat here with `evidence: —` AND no file of
    # any kind; a check that trusted the cell would have had one honest side
    # and one side copied from the thing it was checking.
    _edir = state_root / "evidence"
    def _has_doc(tid: str) -> bool:
        """Any evidence file filed under this row's id, by the naming rule."""
        if not _edir.exists():
            return False
        return any(md.name.startswith(tid + "-")
                   for md in _edir.rglob("*.md"))

    for tid, status in live.items():
        if status != "review":
            continue
        rung = (rungs.get(tid) or "").upper()
        if rung == "V4":
            continue                       # the check above owns V4
        age = _days_at_review.get(tid)
        how_long = (f"{age} day(s) ago" if age is not None
                    else "at an unknown time — no event records the move")
        if not rung:
            # **A row at `review` with no rung cannot be reviewed at all.**
            # `review.md § 1` refuses a dispatch without written criteria, and
            # § 0 makes the rung the thing that chooses what the round owes —
            # so an empty rung is not a small omission, it is the round having
            # no shape. Found live: `TASK-285` reached `review` this way.
            findings.append(Finding(
                "warn", "BOARD.md", "review-with-no-rung",
                f"{tid} is at `review` carrying NO verification rung. It "
                f"moved there {how_long}. The rung is what decides whether "
                f"this row owes a verdict block, a reproducible run or a "
                f"linter pass (`review.md § 0`), so until one is set nothing "
                f"can say what would finish it and no round can be "
                f"dispatched (`review.md § 1`)"))
        elif rung == "V3" and not _has_doc(tid):
            findings.append(Finding(
                "warn", "BOARD.md", "review-with-no-run",
                f"{tid} is at `review` at V3 and no evidence document is "
                f"filed under its id. It moved there {how_long}. V3 is *a "
                f"reproducible run — command, inputs, output, re-runnable*, "
                f"and a run nobody wrote down is a claim about confidence"))
        elif rung == "V2":
            # **V2's artifact is not a document, so a V2 row does not wait.**
            # `ADR-020` (2026-09-11) made V2 the floor and `review.md § 0`
            # calls it "a structural check — a linter over required sections,
            # schema and format, attested by a script". A linter pass is
            # runnable now, by whoever is reading this line. There is nothing
            # to wait FOR, which makes `review` the wrong column rather than a
            # missing artifact — reported as its own shape rather than folded
            # into the two above.
            findings.append(Finding(
                "warn", "BOARD.md", "review-at-v2-has-nothing-to-wait-for",
                f"{tid} is at `review` at V2. It moved there {how_long}. V2 "
                f"is a linter pass attested by a script (`ADR-020`, "
                f"`review.md § 0`), not a document someone else produces — "
                f"there is no round in flight to wait for. Run the pass and "
                f"close it, or raise the rung if that is not enough"))

    # **Two FAILs is a decision, not a third round.** Measured on this board:
    # 20 rows entered V4, 74 rounds were burned, and 10 rows needed three or
    # more. TASK-050 and TASK-249 each reached round 11; TASK-095 FAILed five
    # times and the escalation that ended it (USER-905) was filed by hand at
    # round 5. Every one of the five reads the same in the journal — "two
    # situations answered as one, one step to the left of the last" — so the
    # rounds after the second were not finding new defects, they were
    # re-deriving one principle differently. The agent could already name that
    # shape at round 2; nothing ASKED it to stop there.
    #
    # The trigger moves to two, and this is the check that moves it. A round
    # costs a full dispatch, a fresh-context review and a fix cycle, and the
    # session pays its whole context on every turn of all three — so the
    # rounds after the second are the most expensive thing Perry does and the
    # least likely to converge.
    #
    # **No `round` field.** `round` was measured and refused a bearer
    # (`bin/perry-task.evidence_relations`) because it lived only in some
    # filenames. It does not need one: a round that returned is a verdict
    # block, so the count is the FAILs already on disk. A PASS anywhere ends
    # the row's history and the question with it.
    #
    # **One field was added, 2026-09-11, TASK-419: `grade:`.** The count above
    # is over blocks, and a block is not a unit of failure — the criterion is.
    # The alternative was resolving the criterion out of the criteria file the
    # block cites, and it was measured and it cannot work: `DESIGN-016-spec.md
    # § Which row each criterion decides` maps ROWS to criteria, not ROUNDS to
    # criteria, so TASK-360's `2, 3` (one ROW-grade, one FAIL-grade) says
    # nothing about which of its two rounds charged which. `grade:` is optional
    # and read only on a FAIL; absent, it counts. See `fail_grade`.
    #
    # **An escalation clears it.** The out is the one TASK-095 took — file the
    # ask, name the options, let the user pick a principle. An open ask in
    # `asks.jsonl` whose `blocks` names the row IS that escalation, so the
    # finding reports rows that have neither converged nor escalated, and goes
    # quiet the moment either happens.
    #
    # **AN ANSWERED ASK USED TO STOP CLEARING IT, WHICH PUNISHED THE EXACT
    # WORKFLOW THIS CHECK ASKS FOR.** `if ask.get("answered"): continue` meant
    # the escalation counted only while the question was still out. The moment
    # the user answered — the whole point of filing it — the row went back to
    # being reported as one that had *"neither converged nor escalated"*, and
    # the remedy the finding prints is "file the ask", which is a second ask
    # about a question already answered.
    #
    # Found live on 2026-09-13: `TASK-236` FAILed twice, `USER-927` was filed
    # naming both readings, the user chose (B), round 3 was implemented on that
    # authority — and this check reported the row as un-escalated while the
    # answer sat in `asks.jsonl` with `answered: true`.
    #
    # **An answered ask is a STRONGER escalation than an open one**, not a
    # weaker one: an open ask says the question is out, an answered one says
    # the principle has been picked. So it clears — but only for the rounds it
    # was answering, which is the part that keeps the teeth. A row that FAILs
    # `limit` more times AFTER the answer is failing on a principle the answer
    # did not settle, and must fire again.
    #
    # The ordering needs no new field. The answer's `ts` is on its `answer`
    # event, and a review document's arrival is the first `evidence` event
    # whose value names it — both written by Perry's own writers, so this reads
    # timestamps rather than parsing prose (`ADR-007` decision 3).
    limit, limit_from = rounds_before_escalation(project_root)
    asks = state_root / "asks.jsonl"
    escalated: set[str] = set()
    answered_for: dict[str, str] = {}
    if asks.exists():
        for raw in asks.read_text(errors="replace").split("\n"):
            raw = raw.strip()
            if not raw:
                continue
            try:
                ask = json.loads(raw)
            except (ValueError, TypeError):
                continue
            blocked = re.findall(r"\b[A-Z]+-\d+\b",
                                 str(ask.get("blocks") or ""))
            if not ask.get("answered"):
                escalated.update(blocked)
                continue
            when = _answer_ts.get(str(ask.get("id") or ""))
            if not when:
                # **An answered ask with no `answer` event keeps the OLD
                # behaviour: it clears nothing.** There is no timestamp to
                # order it against the FAILs, so nothing here can tell the
                # rounds it settled from the rounds that came after, and the
                # narrowing below has no evidence to act on.
                #
                # That is also the direction `TestTwoFailsIsADecisionNotAThird
                # Round § test_an_answered_ask_with_nothing_to_order_it_does_
                # not_clear_it` already fixed, for the reason written there: an
                # answered ask cannot license the next UNEXAMINED round. The
                # rule below does not contradict that — it says which rounds
                # were examined — and where it cannot say, the stricter reading
                # stands.
                #
                # In practice `cmd_answer` always writes the event, so this
                # branch is a hand-edited or pre-event-log store.
                continue
            for tid in blocked:
                if when > answered_for.get(tid, ""):
                    answered_for[tid] = when

    # **Only a row that can still RECEIVE a round.** The first cut of this
    # check asked the evidence directory alone and reported five rows, four of
    # them long closed — TASK-037 and TASK-203 `done`, TASK-042 `dropped`,
    # TASK-050 `done` after eleven rounds. Their round counts are history, and
    # history is not a worklist. `done` removes the row, so `live` is exactly
    # the set a next round could be dispatched against.
    #
    # (That those four closed carrying FAILs and no PASS block is a real and
    # separate finding — it is `v4-close-without-verdict`'s territory, not
    # this one's, and widening here would answer two questions with one rule,
    # which is the defect five TASK-095 rounds were spent on.)
    for tid, blocks in sorted(seen.items()):
        if not tid or tid in escalated or tid not in live:
            continue
        results = [f.get("result") for _, f, _ in blocks]
        if "PASS" in results:
            continue
        fails = [b for b in blocks if b[1].get("result") == "FAIL"]
        # **The numerator is the criterion, not the block.** Two FAILs used to
        # be two FAILs whatever they were about, and on TASK-360 they were
        # round 4 on criterion 2 — `--help` from a non-first argument position,
        # whose worst outcome is exit 2 and a line naming `--help` — and round
        # 6 on criterion 3, a positional accepted, dropped and reported as
        # success. `DESIGN-016-spec.md § What a criterion may do to a row`
        # grades those ROW and FAIL. By the bar that governs the row it failed
        # ONCE, and the guard was charging it for a round it never spent.
        #
        # **This does not loosen § 6 and must not.** The guard fired correctly
        # on TASK-362, whose FAILs were criteria 5 and 13 — both FAIL-grade —
        # and the ask it forced (USER-924) closed a whole category in one
        # round. Only a FAIL that SAYS it was charged against a ROW-grade
        # criterion stops counting; silence counts, a typo counts, and a
        # missing criteria file counts. See `fail_grade`.
        charged = [b for b in fails if fail_grade(b[1]) != "ROW"]
        filed = [b for b in fails if fail_grade(b[1]) == "ROW"]
        # **The rounds an answered ask already settled stop counting.** Only
        # FAILs whose document arrived AFTER the answer are still evidence that
        # nobody has picked a principle; the ones that PROMPTED the ask are the
        # reason it was filed. A FAIL whose document predates the answer, or
        # whose arrival no event records, is dropped from the count.
        settled = answered_for.get(tid)
        if settled:
            before = len(charged)
            # **A FAIL with no `evidence` event COUNTS.** `.get(b[0], "")`
            # would drop it, and a missing event would then silence the limit —
            # the same unorderable-means-strict rule the answered-ask branch
            # takes above, pointed the other way.
            charged = [b for b in charged
                       if _filed_at.get(b[0], settled + "\uffff") > settled]
            answered_aside = (
                f" {before - len(charged)} earlier FAIL(s) are not counted: "
                f"they arrived before the ask on this row was answered "
                f"({settled[:10]}), which is what the ask was for.")
        else:
            answered_aside = ""
        undeterminable = [b for b in charged if fail_grade(b[1]) is None]
        if len(charged) < limit:
            continue
        where = ", ".join(r for r, _, _ in charged)
        # The two qualifications are appended rather than folded in, because
        # the sentence a reader acts on ("file the ask") must not change shape
        # depending on how the corpus happens to be annotated.
        aside = ""
        if filed:
            aside += (
                f" {len(filed)} further FAIL(s) on this row named a ROW-grade "
                f"criterion and are NOT counted "
                f"({', '.join(r for r, _, _ in filed)}).")
        aside += answered_aside
        if undeterminable:
            aside += (
                f" {len(undeterminable)} of the {len(charged)} counted carry "
                f"no readable `grade:`, so the criterion they were charged "
                f"against is undeterminable and they count by default "
                f"(work/reference/review.md § 3).")
        findings.append(Finding(
            "warn", "BOARD.md", "review-rounds-exhausted",
            f"{tid} has FAILed {len(charged)} V4 rounds on row-failing "
            f"criteria and never PASSed "
            f"({where}); the limit is {limit} (from {limit_from}). Another "
            f"round is not the next step — a row that has failed {limit} "
            f"times is failing on a PRINCIPLE nobody has picked, and each "
            f"further round re-derives it differently. File "
            f"the ask: name the two readings, say which one you recommend and "
            f"why, and let the user choose. An open ask blocking this row "
            f"clears this finding.{aside}"))

    check_reviews.blocks_seen = sum(len(v) for v in seen.values())
    return findings


def check_knowledge(state_root: Path, project_root: Path) -> list["Finding"]:
    """Every knowledge card can say where its claim came from and when.

    `DESIGN-006 § 5.3`: all four provenance fields are mandatory, because
    without them the store becomes a farm of confident errors that agents then
    execute against — strictly worse than no store. That is the axiom *no
    `done` without evidence*, extended to the knowledge layer.

    Advisory, like `--verification` and `--provenance`: it reports, it does not
    refuse. The refusal belongs at the write path (`DESIGN-006` phase B), where
    the person who knows the answer is still in the room.

    **`cards` is reported even when `violations` is 0.** `KR-O5.1` reads
    "lint live · 0 violations", and zero violations over zero cards is
    trivially true — a number that cannot distinguish "provenance is enforced"
    from "nobody has written a card". The count is what makes the KR mean
    something.
    """
    findings: list[Finding] = []
    kdir = state_root / "knowledge"
    stale_days = int((SCHEMA_THRESHOLDS.get("knowledge_stale_days")
                      or {}).get("value") or 90)
    today = date.today()
    # `.perry/` is anchored to the PROJECT root and never moves, so this takes
    # the project root rather than deriving it — see `resolves_somewhere`.
    rdir = project_root / ".perry" / "roles"
    roles_declared = rdir.exists() and any(rdir.glob("*.md"))

    for md in sorted(kdir.rglob("*.md")) if kdir.exists() else []:
        if md.name == "INDEX.md":
            continue
        text = strip_comments(md.read_text(errors="replace"))
        kind = card_kind(text)
        if kind is None:
            continue                      # a digest; `--provenance` owns it
        rel = md.relative_to(state_root).as_posix()

        for name in CARD_REQUIRED:
            val = field_value(text, name)
            if val and not lib.is_blank_cell(val):
                continue
            # `Owner role` is the one field an em dash legitimately answers,
            # and only until roles exist. Saying so in the finding keeps a
            # pre-phase-C project from reading this as an error it must fix.
            if name == "Owner role":
                # **Silent until the project has roles.** `DESIGN-006 § 5.3`
                # writes the field as "`finance` — or `—` before roles exist",
                # so warning today would put a finding on every card in every
                # project until phase C lands, which is how a check teaches
                # people to ignore it. Once `.perry/roles/` holds a card there
                # IS an answer, and leaving it blank means nobody is
                # accountable for re-verifying the claim.
                if roles_declared:
                    findings.append(Finding(
                        "warn", rel, "card-unowned",
                        f"`Owner role` is undeclared on a project that has "
                        f"declared roles — nobody is accountable for "
                        f"re-verifying this claim."))
                continue
            findings.append(Finding(
                "warn", rel, "card-no-provenance",
                f"`{name}` is missing or blank. All four provenance fields are "
                f"mandatory: a card that cannot say where its claim came from, "
                f"when it was last true, or what would break it is a confident "
                f"error waiting to be executed against."))

        src = field_value(text, "Source")
        if src and not lib.is_blank_cell(src):
            if not resolves_somewhere(src, state_root, project_root):
                findings.append(Finding(
                    "warn", rel, "card-source-dangling",
                    f"`Source: {src}` resolves to no file, task id or `SRC-n` "
                    f"in this project — a claim citing a source nobody can "
                    f"re-open is a claim about the agent's memory."))

        seen = field_value(text, "Last verified")
        if seen and lib.is_iso_date(seen):
            age = (today - date.fromisoformat(seen)).days
            if age > stale_days:
                trip = field_value(text, "Invalidated by")
                findings.append(Finding(
                    "warn", rel, "card-stale",
                    f"last verified {seen} ({age}d ago, threshold "
                    f"{stale_days}d)." + (
                        f" Its tripwire is {trip!r} — check whether that has "
                        f"happened rather than just re-dating it."
                        if trip and not lib.is_blank_cell(trip) else
                        " It names no tripwire, so age is the only signal "
                        "there is.")))
    return findings


def check_provenance(state_root: Path) -> list["Finding"]:
    """Every cited source resolves; every source has an origin and a date.

    Outside code, provenance IS the test suite. `modes/inquiry.md` lets a
    finding carry `[SRC-n]`, and the citation is worth nothing unless the id
    resolves to a digest that says where the material came from and when it was
    fetched — a claim citing a source nobody can re-open is a claim about the
    agent's memory.

    Advisory, like `--verification`: it reports, it does not refuse.
    """
    findings: list[Finding] = []
    kdir = state_root / "knowledge"

    # 1. Build the id → file map, reporting malformed and duplicate ids.
    defined: dict[str, Path] = {}
    for md in sorted(kdir.rglob("*.md")) if kdir.exists() else []:
        if md.name == "INDEX.md":
            continue
        text = strip_comments(md.read_text(errors="replace"))
        rel = md.relative_to(state_root).as_posix()
        # A knowledge CARD and a digest share this glob. A card is a claim the
        # project made; a digest is a source it read. Neither is malformed for
        # not being the other, so each check skips the other's files — the
        # discriminator is declared once, in the schema, and read by both.
        if card_kind(text):
            continue
        m = re.search(r"^>\s*Id\s*[:：]\s*(\S+)", text, re.M)
        if not m:
            findings.append(Finding(
                "warn", rel, "source-has-no-id",
                "digest carries no `Id: SRC-<n>` — nothing can cite it",
            ))
            continue
        sid = m.group(1).strip("*` ")
        if not SRC_RE.fullmatch(sid):
            findings.append(Finding(
                "warn", rel, "source-id-malformed",
                f"`Id: {sid}` is not of the form SRC-<n>",
            ))
            continue
        if sid in defined:
            findings.append(Finding(
                "warn", rel, "source-id-reused",
                f"{sid} is already defined by {defined[sid]} — ids are minted "
                f"once and never reused, or an old citation silently re-points",
            ))
            continue
        defined[sid] = rel
        for field, rule in (("Source", "origin"), ("Received", "fetch date")):
            if not re.search(rf"^>\s*{field}\s*[:：]\s*\S", text, re.M):
                findings.append(Finding(
                    "warn", rel, "source-missing-field",
                    f"{sid} has no `{field}:` — a source with no {rule} cannot "
                    f"be re-verified, which is what citing it was for",
                ))

    # 2. Every citation anywhere in the state tree must resolve.
    cited: dict[str, list[str]] = {}
    for md in sorted(state_root.rglob("*.md")):
        if kdir.exists() and kdir in md.parents:
            continue
        try:
            text = strip_comments(md.read_text(errors="replace"))
        except (UnicodeDecodeError, OSError):
            continue
        rel = md.relative_to(state_root).as_posix()
        for sid in {f"SRC-{n}" for n in SRC_RE.findall(text)}:
            cited.setdefault(sid, []).append(rel)
    for sid, where in sorted(cited.items()):
        if sid not in defined:
            findings.append(Finding(
                "warn", where[0], "citation-dangling",
                f"{sid} is cited in {len(where)} file(s) and defined by no "
                f"digest under knowledge/",
            ))

    check_provenance.stats = {"defined": len(defined), "cited": len(cited)}
    return findings


#: `evidence/<YYYY-MM>/<TASK-ID>-spec.md` — the file `add-task` step 3 writes
#: and `dispatch.md` pre-flight step 4 reads. Named by the pattern rather than
#: by "every `.md` under `evidence/`", because that directory also holds
#: dispatch records, result reports and working artifacts, and none of those
#: is ever read as a round's declared scope.
SPEC_FILE_RE = re.compile(r"-spec\.md$")


def closed_task_ids(project_root: Path | None) -> set[str]:
    """Every task id the event log records as `done` or `dropped`.

    **One derivation, two consumers** (TASK-370). `check_reviews` computed this
    inline and `check_specs` did not compute it at all, so one pre-dispatch
    check was scoped to rows that can still be dispatched and its twin was not.
    Measured 2026-09-12: `spec-unbounded` named **123** specs, of which **3**
    belonged to an open row and **120** to a closed one. A signal-to-noise of
    3:120 is what `TASK-370` was opened for — its author dispatched `TASK-276`
    past a true positive because the finding was one of 123 and the output
    names ten.

    `check_reviews`'s own note already argued the rule and is quoted rather
    than restated: *"A closed row's criteria cannot be re-bounded and its
    exhibit cannot be re-filed … a backlog nobody can clear is a gate that is
    red forever, which is a gate people delete."* That was true of the
    verdict-side check and equally true of the spec-side one; only one of them
    acted on it.

    The log is the authority rather than `tasks.jsonl` because `purge` removes
    a record and the log keeps the event — a purged row is closed, and a check
    that read the store would start reporting its spec again.
    """
    out: set[str] = set()
    if project_root is None:
        return out
    log = project_root / ".perry" / "events.jsonl"
    if not log.exists():
        return out
    for raw in log.read_text(errors="replace").split("\n"):
        raw = raw.strip()
        if not raw:
            continue
        try:
            ev = json.loads(raw)
        except (ValueError, TypeError):
            continue
        if ev.get("event") in ("done", "drop"):
            tid = str(ev.get("task") or ev.get("id") or "")
            if tid:
                out.add(tid)
    return out


def check_specs(state_root: Path, project_root: Path | None = None,
                cap: int | None = None) -> list["Finding"]:
    """Every spec a dispatching agent must read actually offers it something.

    `work/reference/dispatch.md` pre-flight step 4.2 reads a spec's
    `Files in scope` and `Deliverable` to learn what the round will write. A
    spec carrying neither — under any spelling `P.alias("headings", …)` knows —
    offers that reading nothing at all, and the resulting "I found no
    high-stakes work here" is byte-identical to the same sentence about a spec
    that was read in full and found genuinely clean. **That asymmetry is the
    whole defect: the screening's failure mode looks exactly like its success.**

    Measured on this repository 2026-09-04: **45** spec files under `evidence/`
    with no section step 4.2 can read — 45 of 149. The same 45 as on
    2026-09-02, because every spec written since is sectioned.

    **What shape those 45 are actually in**, because the fix depends on it and
    the first answer was wrong: 19 write `### Deliverable`, 26 carry no such
    section at all, and **0 use the `- **Deliverable**:` bullet shape**
    `perry-task add` renders. So the cause is not that the tool's shape leaks
    into specs; it is that `add-task` step 3 said the spec carries "the same
    schema" as the journal block and never said which *shape*, while `_section`
    matches `^## `. Widening the reader to bullets — the reader-side fix
    TASK-284's spec proposed — would have closed none of the 45. Step 3 now
    names the `## ` shape and says why.

    So this is the REPORTING half of TASK-284: the check does not prevent an
    empty reading and is not meant to. It makes one impossible to mistake for a
    clean pass. **It is also all that is left of the mechanical half of that
    gate**: `bin/perry-state --escalation-scan` — Python matching the hook's
    fragments against a spec's prose and returning a verdict — was removed on
    2026-09-04 (`USER-916`, `ADR-007` decision 3, TASK-339), because five
    rounds ended with the measurement that formatting alone moved its verdict in
    both directions. What survives here is the one question that is not about
    meaning: **does this document offer either scope heading.** `P.spec_scope_sections`
    locates headings and matches nothing; the judgement it feeds belongs to the
    agent working step 4.

    **Advisory, and here is the condition under which it stops being.**
    DESIGN-003 decision 4 chose "advisory first release, hard gate next" for
    the verification ladder, and its §4 note states the plan: advisory for one
    release with `perry-lint` reporting the gap, then hard. Citing that
    precedent without writing down the matching plan is how an advisory
    becomes permanent by default, so:

      **Promotion trigger** — `spec-scope-unscannable` becomes an `error` when
      **the count of unscannable specs on `main` reaches 0 and holds there for
      one release**. (It once also read "and `--escalation-scan` grows a
      distinct exit code"; that command no longer exists, and the exit-code half
      of the trigger went with it — TASK-339.) Not before: the promotion's whole cost is that
      it refuses dispatch on rows already in the tree, so it is free exactly
      when the tree is clean and ruinous while it is not. Driving the count to
      0 means REWRITING 45 historical specs, which `.perry/hook.md` forbids
      doing to make a gate pass — so the route is that the 45 age out of
      dispatch as their rows close, not that anyone edits them. Until then the
      advisory plus `dispatch.md` step 4.2's mandatory go-ahead is the whole
      control. A `decide` round may lift this paragraph into an ADR; it is
      recorded here because the check is what implements it.

    `--strict` promotes it per-run today, which is what lets a dispatcher
    choose to be stopped without that decision being made for everyone.

    `project_root` is what the finding paths are named relative to. Under
    `--specs` it is the same directory the reader typed; in the default pass
    every other finding is relative to the project root, and a path on the
    same screen that silently means something else is worse than a long one.
    `cap` names at most that many specs one by one and summarises the rest,
    the way `check_store_drift` does and for its reason — `stats` still counts
    every one, and `--specs --json` still names every one.

    ── The second rule this pass reports: `spec-unbounded` (TASK-308) ──────

    **The question it answers**: *this spec offers a round no finite set to
    check, and no round has run yet.* The verdict-side `criteria-unbounded` in
    `check_reviews` answers *this round scored against an unbounded criterion*.
    Two checks, one rule from `review.md § 1`, and they are not redundant: the
    verdict-side one reads `criteria:` out of a `parse_verdicts` block, which
    exists only AFTER a round has scored, so on the 127 specs that have never
    been reviewed it has never spoken. Measured on `548f206`: 146 specs, 19
    bound, 127 not, `criteria-unbounded` = 0.

    **Severity, decided and argued** — the spec required a choice among three
    and forbade "127 warnings, done":

      Chosen: **`warn`, capped at `cap` named individually plus one summary
      finding carrying the remainder, with the exact count in `stats` and every
      path in `--specs --json`.** In the default pass that is 11 lines, not
      127.

      Why this one. It is the precedent already set in this very function for
      the identical shape of problem — 45 unscannable specs reported as 10 + 1
      — and in `check_summaries` (89) and the six store-drift checks
      (`DRIFT_ROWS_SHOWN`). `reference/diagnose.md` names a wall of red as
      strictly worse than no check, and the cap is this codebase's settled
      answer to that; inventing a second answer here would mean two rules for
      "how does a check report a large true set".

      Why NOT "only specs newer than a date": the check's answer would then
      depend on when it is asked, and would drift silently as the tree ages. It
      is also not enumerable — you cannot state the last element of "specs
      newer than X" the way this row's own `## Bound` states one, so the check
      would violate the rule it enforces.

      Why NOT "only rows at `review` or being dispatched": that reintroduces
      the exact defect being fixed. Scoping to board state would make the
      spec-side check consult a row's status the way the verdict-side one
      consults a verdict — and the whole property is that this speaks knowing
      nothing about verdicts or the board, from the spec alone, BEFORE anyone
      decides to dispatch.

      Why `warn` and not `error`: the row's `Out of scope` is explicit —
      report, do not refuse, on the `DESIGN-003 § 4` decision 4 and TASK-284
      `scope_scanned` precedent. An `error` here would retroactively block 127
      existing rows, and `.perry/hook.md` forbids rewriting history to make a
      gate pass. `--strict` still promotes it per-run, which is what lets one
      dispatcher choose to be stopped without that choice being made for
      everyone.
    """
    findings: list[Finding] = []
    project_root = project_root or state_root
    edir = state_root / "evidence"
    specs = [md for md in (sorted(edir.rglob("*.md")) if edir.exists() else [])
             if SPEC_FILE_RE.search(md.name)]
    # The section names read from `P`, not restated here. A second copy of
    # "which sections carry a round's scope" is exactly the
    # two-answers-to-one-question defect `SPEC_SCOPE_SECTIONS`' own comment
    # records — this check would keep reporting on a heading `dispatch.md` had
    # stopped asking for.
    labels = " or ".join(f"`## {lbl}`" for lbl in P.SPEC_SCOPE_SECTIONS)
    # **Both findings in this function are scoped to rows that can still be
    # dispatched** (TASK-370), which is the rule `check_reviews` had and this
    # function did not. Measured 2026-09-12, before the scoping:
    #
    #     spec-scope-unscannable   named 46    open  0   closed 45
    #     spec-unbounded           named 123   open  3   closed 120
    #
    # The scope half was reporting **nothing anyone could act on** — not one
    # of its 46 belonged to a row a round could still be dispatched against.
    # The row was filed about the bound half; the scope half is the same
    # defect in the same loop and is fixed with it rather than left for a
    # second row, which is the judgement stated here because it is a widening.
    _closed_specs = closed_task_ids(project_root)

    def _is_closed(md) -> bool:
        tid = re.search(r"TASK-\d+", md.name)
        return bool(tid and tid.group(0) in _closed_specs)

    unscannable: list[str] = []
    for md in specs:
        if _is_closed(md):
            continue
        if P.spec_scope_sections(md.read_text(errors="replace")):
            continue
        unscannable.append(_rel(md, project_root))
    for rel in (unscannable[:cap] if cap is not None else unscannable):
        findings.append(Finding(
            "warn", rel, "spec-scope-unscannable",
            f"no {labels} — `dispatch.md` step 4.2 has nothing here to read, "
            f"so nobody can say this row's scope was screened",
        ))
    if cap is not None and len(unscannable) > cap:
        findings.append(Finding(
            "warn", "evidence/", "spec-scope-unscannable",
            f"and {len(unscannable) - cap} further spec(s) declare no scope "
            f"for `dispatch.md` step 4.2 to read — `perry-lint --specs --json` "
            f"names every one",
        ))

    # ── `spec-unbounded` — the SPEC-side half of the bound rule ───────────
    # **Which question this one answers**: *this spec has no finite set to
    # check, and no round has been dispatched against it yet.* The verdict-side
    # `criteria-unbounded` at `check_reviews` answers a DIFFERENT question —
    # *this round scored against an unbounded criterion* — and the two are
    # deliberately not unified. See that check's own note; deleting either
    # trades one blind spot for another.
    #
    # The gap this closes, measured on `548f206`: 146 specs, 19 carrying a
    # `## Bound`, 127 without, and `criteria-unbounded` reporting **0** on
    # every one of the 127. The verdict-side check reads `criteria:` out of a
    # `parse_verdicts` block, and a verdict block exists only once a round has
    # already scored against the spec. So the check that would have BOUNDED
    # the round can only speak after it. `review.md § 1`: an unbounded
    # criterion "does not fail a round. It fails to **end** one" — TASK-050
    # spent eleven rounds on that and TASK-067 two, and TASK-285 and TASK-323
    # both reached V4 unbounded on 2026-09-03 because nothing said so before
    # dispatch.
    #
    # **Presence and shape only.** Whether a bound is WELL DRAWN is the
    # judgement `review.md § 1` gives a reviewer, and a checker that scored it
    # would be the fifth guard-over-English attempt on this board this week.
    # `_BOUND_RE` is the same matcher the verdict-side check uses — one answer
    # to "what counts as a bound", for the reason `labels` above reads
    # `P.SPEC_SCOPE_SECTIONS` rather than restating it.
    #
    # **SCOPED TO ROWS THAT CAN STILL BE DISPATCHED** (TASK-370), which is the
    # rule `check_reviews` already applied to its own two pre-check findings
    # and this one did not. Measured 2026-09-12 before the scoping: 123 specs
    # named, **3** of them an open row's and **120** a closed row's. The row
    # was opened because its author dispatched `TASK-276` past a true positive
    # — the finding was one of 123 and the output names ten, so the one that
    # mattered was invisible. `reference/diagnose.md` calls that a wall of red,
    # and a check whose true positive is invisible has the effect of no check.
    #
    # A closed row's spec cannot be re-bounded and no round will ever be
    # dispatched against it, so naming it is a backlog nobody can clear.
    unbounded: list[str] = []
    for md in specs:
        if _is_closed(md):
            continue
        if not _BOUND_RE.search(strip_comments(md.read_text(errors="replace"))):
            unbounded.append(_rel(md, project_root))
    for rel in (unbounded[:cap] if cap is not None else unbounded):
        findings.append(Finding(
            "warn", rel, "spec-unbounded",
            "no `## Bound` — a round against this spec has no finite set to "
            "check and no last element, so it cannot know when it is done "
            "(work/reference/review.md § 1). Write the bound BEFORE the "
            "round, not during it",
        ))
    if cap is not None and len(unbounded) > cap:
        findings.append(Finding(
            "warn", "evidence/", "spec-unbounded",
            f"and {len(unbounded) - cap} further spec(s) carry no `## Bound` "
            f"— `perry-lint --specs --json` names every one",
        ))

    # `checked` exists because "this ran and found no specs" and "this never
    # ran" are different answers, and the second is what a folder that is not
    # a Perry project yet produces. Printing them the same way is the defect
    # the store-drift lines above were corrected for.
    check_specs.stats = {"specs": len(specs),
                         "unscannable": len(unscannable),
                         "unbounded": len(unbounded),
                         "checked": True}
    return findings


#: How many drifted rows are named one by one before the tail is summarised.
#: `perry-tasks verify` caps its own mismatch list at ten for the same reason:
#: a stale store drifts on EVERY row, and a hundred warnings saying one thing
#: is a check people learn to scroll past.
DRIFT_ROWS_SHOWN = 10


def _rel(path: Path, project_root: Path) -> str:
    try:
        return path.relative_to(project_root).as_posix()
    except ValueError:
        return path.as_posix()


def _cell(value) -> str:
    """One field, as the text a cell would carry.

    `depends_on` is a list in the store and a comma-separated cell in the
    document, and `None` and `""` are the same absent field written two ways.
    Comparing them raw would report drift on a store nobody has touched.
    """
    if value is None:
        return ""
    if isinstance(value, (list, tuple)):
        return ",".join(str(v) for v in value)
    return str(value)


def _tasks_module():
    """`bin/perry-tasks`, imported rather than shelled out to.

    Same loader `perry-tasks` itself uses on `perry-task`, and for the same
    reason: the filename carries a dash, so `import` cannot reach it.
    """
    import importlib.machinery
    import importlib.util
    path = HERE / "perry-tasks"
    spec = importlib.util.spec_from_loader(
        "perry_tasks_mod",
        importlib.machinery.SourceFileLoader("perry_tasks_mod", str(path)))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _well_typed(on_disk: list[dict], rel_store: str) -> tuple[list[dict], list]:
    """Split the store into records the checks can compare, and findings.

    **A store is a file a person can open, and every check below indexes,
    sorts or compares its fields.** Three of them died on a wrong-typed value
    rather than reporting it: `id` as a list is unhashable and killed the dict
    build; a store mixing `id: 3` with `id: "TASK-001"` killed `sorted(set(…))`;
    `order` as `"3"` killed `_order_drift`'s sort. Each exited the WHOLE lint at
    rc 2 with no findings at all — so a store with one bad line reported the
    same as a project with no problems, only louder.

    Two V4 rounds found this independently and one of them by a typed sweep
    (19 fields x 9 JSON shapes), which is the reason this is one function and
    not three `try:` blocks. TASK-093 enumerated four instances of the category
    "a guard that crashes instead of reporting"; these were the fifth, sixth and
    seventh, and they were added *by the fix for the first four*. A patch per
    crash site would have produced the eighth.

    A bad record is **excluded and named**, not coerced. Coercing `"3"` to `3`
    would make the lint report clean on a file that no other reader can load —
    and `bin/perry-task` reads this same file.
    """
    good, issues = _tasks_module().perry_store.validate_records(on_disk)
    findings = []
    for issue in issues:
        tid = issue.get("id")
        who = repr(tid) if tid else f"line {issue['line']}"
        message = issue["message"]
        if any(f.get("field") == "id" and f.get("expected") == "non-empty string"
               for f in issue.get("fields", [])):
            message = ("has no `id`, so nothing can be said about it and every "
                       "reader silently skips it")
        findings.append(Finding(
            "warn", rel_store, "store-badly-typed",
            f"{who} — {message}. The record is excluded from the drift "
            f"comparison, so this row's drift is unknown here rather than "
            f"absent."))
    return good, findings


def _store_module():
    """`bin/perry_store.py`, loaded once at import.

    Every field list this file compares against comes from here rather than
    being spelled out again: writing the names in would be the "N
    implementations of one rule" defect with N=2, and the copy goes stale the
    first time a field is added.
    """
    import importlib.util
    spec = importlib.util.spec_from_file_location(
        "perry_store", Path(__file__).resolve().parent / "perry_store.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _md_store_module():
    """`bin/perry_md_store.py`, loaded once at import — same reason as above.

    It carries `STORED`, the field list for the record kinds `okr.jsonl` and
    `.perry/config.jsonl` hold: `kr`, `commitment`, `version`, `setting`,
    `track`. Without it `looks_like_perry_record` knows two of the four stores
    Perry claims and reports the other two as files it did not write, against
    its own claim — which is exactly what TASK-040 fixed for the risks store
    and what adding the `okr.jsonl` claim reproduced one store over.
    """
    import importlib.util
    spec = importlib.util.spec_from_file_location(
        "perry_md_store", Path(__file__).resolve().parent / "perry_md_store.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


_STORE = _store_module()
_MD_STORE = _md_store_module()
_STORED_FIELDS = _STORE.STORED
#: The risks register's field list (TASK-040). A risk record and a task record
#: are different shapes, so `looks_like_perry_record` has to know both or it
#: reports the risks store as a file Perry did not write, against Perry's own
#: claim, on every project that has one.
_RISK_STORED_FIELDS = _STORE.RISK_STORED
#: The intake register's field list (TASK-196). A third shape, and the first
#: one with NO `id`: an intake row is addressed by position, so the record
#: keys on `order`. `looks_like_perry_record` has to know that or it reports
#: the intake store as a file Perry did not write.
_INTAKE_STORED_FIELDS = _STORE.INTAKE_STORED
#: The ask register's field list (TASK-197). A fourth shape, id-keyed like the
#: risks store — `looks_like_perry_record` has to know it or it reports
#: `asks.jsonl` as a file Perry did not write, against Perry's own claim, on
#: every project that runs the import.
_ASK_STORED_FIELDS = _STORE.ASK_STORED

#: The cadence register's field list (TASK-237 deliverable 3b), id-keyed like
#: the two above. Without it `cadence.jsonl` drew an `NS-01` against Perry's
#: own claim on every project holding the store.
_CADENCE_STORED_FIELDS = _STORE.CADENCE_STORED


def _empty_store_drift_stats() -> dict:
    """The typed machine-readable state before a store comparison runs.

    **`drifted` is `None` until a comparison produces a number (TASK-117).**
    It read `0` in all three states this dict describes before one runs — no
    store, unreadable store, derivation refused — so the payload said
    `comparison_performed: false` and `drifted: 0` in the same breath, which is
    the trap this file's own human summary already refuses to print. A count is
    an assertion that somebody counted; `null` is the only honest value for a
    census that did not happen. `records` stays an `int` because it is a fact
    about the store FILE rather than a drift verdict.

    `log_present` says whether `.perry/events.jsonl` — one of the two inputs
    `check_store_drift`'s derivation needs — was there, so a reader of the
    payload can tell *why* a present store went uncompared.
    """
    return {"store_present": False, "log_present": False,
            "comparison_performed": False, "records": 0, "drifted": None}


def check_store_drift(project_root: Path, state_root: Path) -> list["Finding"]:
    """The rendered file and the store disagree — ADR-007 decision 2.

    Under ADR-007 `BOARD.md` is **rendered output**: the store is what a field
    means and the document is a projection of it. Decision 2 accepted the cost
    of that in the user's own words — *a hand edit becomes drift* — and named
    `perry-state § reconcile_drift` as the precedent for what happens next.
    That precedent reports; it does not refuse. So does this.

    **Silent finding list when there is no store, but explicit machine state.**
    "No store" and "clean" are different answers. The former emits no finding
    because there is no comparison to fail, while `store_drift` in the JSON
    payload and the human summary say that the comparison was not performed.

    **`warn`, not `error`, deliberately.** ADR-007 makes the store authoritative,
    so drift never changes Task truth and rendering can restore the projection.
    `reconcile_drift` establishes the same report-don't-honour posture. More
    importantly, the conformance gate's own boundary is precise: warnings are
    quality signals, while errors are shape violations. A drifted Board still
    has a valid Board shape.

    A prior rationale claimed an `error` here would reach ADR-004's per-file
    conformance gate and make `BOARD.md` read-only. A V4 round disproved that:
    `shape_errors` calls `check_file`, while this cross-file check is called from
    `main()`. The tests preserve the true severity contract without repeating
    that false mechanism or leaning on NS-01, whose claims boundary is TASK-100.

    **Field-level, and it stays field-level even though the renderer landed.**
    This said "there is no renderer" and TASK-088 shipped one two commits later
    — `perry-tasks diff` reports `identical: true` on this project today. A V4
    round caught the stale note. The comparison is still field-level on purpose:
    `BOARD.md` carries columns (`By when`, `Notes`) that the stored fields do
    not cover — so a whole-line byte diff would report every
    untouched row as drift. What is compared instead is what the store WOULD
    hold if derived from the file as it stands (`perry-tasks.build()`, the one
    derivation there is) against what it holds on disk. The renderer's byte diff
    remains a separate projection check; `build`/`verify` keep the field
    semantics they have rather than redefining them here.

    **THE DERIVATION NEEDS THE EVENT LOG, AND WITHOUT IT THERE IS NO
    COMPARISON (TASK-117).** `perry-tasks.build()` reads `BOARD.md` *and*
    `.perry/events.jsonl` — its own docstring says so, "because `done` removes
    a row". The log is DERIVED AND DISPOSABLE (DESIGN-004 § 5.3). So when it is
    gone the LEFT side of this comparison is degraded, and every difference
    that follows is the log's absence wearing the board's name.

    Measured, not reasoned: on Perry's own board and store with the log moved
    aside, 175 of 175 records "drifted" — 137 store-only rows the open board
    cannot re-derive, and 38 differing on `created` **and on nothing else**.
    `created` is in `perry_store.STORED` and is not in `FIELD_BY_COLUMN`: NO
    BOARD COLUMN RENDERS IT, so `file=''` there is not a hand edit, it is a
    field the projection never carried being read as if it had been erased.
    Putting the log back turned the same board and the same store into 0 of
    175. Nothing about the two files being compared changed.

    The remedy the finding prints made it worse than noise: `perry-tasks write
    --from-board` would DISCARD those 137 canonical records and 38 real
    timestamps, on a board the user never touched. And `perry-task`'s own
    writer already knows better — `store_records(..., preserve_terminal=True)`
    carries terminal rows and `created` over FROM THE STORE precisely because
    "the event log is derived and disposable". The linter was comparing against
    a derivation the writer itself would refuse to write.

    So a missing log is the state this function already has a name for —
    `store_drift-uncheckable`, "drift is unknown here rather than absent" — one
    it could not previously detect, because `build()` degrades silently instead
    of raising. Reported like the no-store case and for the same reason:
    **silent finding list, explicit machine state.** 175 warnings that all
    restate one flag is the "check people learn to ignore" failure
    `perry-state § reconcile_drift` names in its own docstring, and the
    `perry-task/list` 1.9 semantics entry records this exact mistake being made
    once already, one register over, at 17 of 17 rows.

    What is NOT gated on the log: `store-badly-typed`. That is a fact about the
    store file, it needs no derivation, and losing it here would trade one
    silent failure for another.
    """
    findings: list[Finding] = []
    check_store_drift.stats = _empty_store_drift_stats()
    log_present = (project_root / ".perry" / "events.jsonl").exists()
    check_store_drift.stats["log_present"] = log_present

    store_path = state_root / "tasks.jsonl"
    if not store_path.exists():
        return []

    check_store_drift.stats["store_present"] = True
    rel_store = _rel(store_path, project_root)
    # **Four reachable store states used to kill the whole lint**, rc 2 and no
    # `--json` payload: a store written as one JSON array — which is the
    # ordinary way to get `.jsonl` wrong, `json.dump(records, f)` — a bare
    # `null` or scalar line, a directory where the file should be, and an
    # unreadable file. Only `JSONDecodeError` was caught; the first two die
    # later on `r.get`, and the last two die on the read itself.
    #
    # The sibling guard eight lines down states the rule this broke: **one
    # check may not kill the lint.** Found by a V4 round that went looking for
    # the case the author had not listed.
    try:
        on_disk = [json.loads(line) for line in
                   store_path.read_text(errors="replace").split("\n")
                   if line.strip()]
    except (OSError, ValueError) as exc:
        return [Finding("warn", rel_store, "store-unreadable",
                        f"`tasks.jsonl` is not readable as JSONL "
                        f"({type(exc).__name__}: {exc}) — there is nothing to "
                        f"compare the file against. `perry-tasks write "
                        f"--from-board{lib.root_flag(project_root)}` "
                        f"re-derives it — which is safe here "
                        f"only because nothing readable is being discarded")]
    if not all(isinstance(r, dict) for r in on_disk):
        return [Finding("warn", rel_store, "store-unreadable",
                        f"`tasks.jsonl` holds something other than one JSON "
                        f"OBJECT per line — a whole-file array and a bare "
                        f"scalar both parse and neither is a record; "
                        f"`perry-tasks write "
                        f"--from-board{lib.root_flag(project_root)}` "
                        f"re-derives it")]
    check_store_drift.stats["records"] = len(on_disk)

    # **Validated, and that is all that is left** (TASK-262 Amendment (4),
    # round 4b). A store record's TYPE is a property of the file; it needs no
    # derivation, no log and no board.
    on_disk, type_findings = _well_typed(on_disk, rel_store)
    findings.extend(type_findings)
    stored = {r.get("id"): r for r in on_disk if r.get("id")}
    check_store_drift.stats["records"] = len(stored)

    # **No board file is read, so there is no drift to compare** (TASK-262
    # round 4b). Drift was a held `BOARD.md` that disagreed with its store,
    # derived through `perry-tasks build` and compared field by field. The
    # file is retired and no reader opens it: a hand edit to it reaches no
    # reading, so there is nothing for the store to disagree with. A
    # board-less project already returned here (TASK-237 3c); a held file no
    # longer changes that. `comparison_performed` stays `false` and `drifted`
    # `null`, and `main()` prints the census line that says why.
    return findings


def _empty_risk_store_drift_stats() -> dict:
    """The typed machine-readable state before a risks comparison runs."""
    return {"store_present": False, "comparison_performed": False,
            "records": 0, "drifted": 0}


def check_risk_store_drift(project_root: Path, state_root: Path) -> list["Finding"]:
    """`## Top risks` and `risks.jsonl` disagree — ADR-007, TASK-040.

    **The same posture as `check_store_drift` one register over, at the same
    severity, for the same reason.** ADR-007 decision 2 accepted the cost of a
    canonical store in the user's own words — *a hand edit becomes drift* — and
    named `perry-state § reconcile_drift` as the precedent for what happens
    next. That precedent reports; it does not refuse. So does this, at `warn`:
    the store is authoritative, so drift never changes what a risk IS, and
    rendering restores the projection.

    **Silent when there is no store, explicit in the payload.** "No store" and
    "clean" are different answers. Perry's own project has no `risks.jsonl`
    today — the file needs a `claims[]` entry before anything may write one —
    so this check emits nothing here and says `comparison_performed: false`
    rather than reporting a clean register it never compared.

    **Field-level, like its sibling, and for the opposite reason.** The task
    check is field-level because `BOARD.md` carries columns the store has no
    field for. Here every column IS a stored field, so a whole-line comparison
    would also work — but `cleared` is a stored field with NO column, and a
    line comparison cannot see it drift at all. Comparing fields is what makes
    the one value the projection cannot show still checkable.
    """
    findings: list[Finding] = []
    check_risk_store_drift.stats = _empty_risk_store_drift_stats()

    store_path = _STORE.risk_store_path(state_root)
    if not store_path.exists():
        return []

    check_risk_store_drift.stats["store_present"] = True
    rel_store = _rel(store_path, project_root)
    try:
        on_disk = [json.loads(line) for line in
                   store_path.read_text(errors="replace").split("\n")
                   if line.strip()]
    except (OSError, ValueError) as exc:
        return [Finding("warn", rel_store, "risk-store-unreadable",
                        f"`risks.jsonl` is not readable as JSONL "
                        f"({type(exc).__name__}: {exc}) — there is nothing to "
                        f"compare `## Top risks` against")]
    if not all(isinstance(r, dict) for r in on_disk):
        return [Finding("warn", rel_store, "risk-store-unreadable",
                        "`risks.jsonl` holds something other than one JSON "
                        "OBJECT per line — a whole-file array and a bare "
                        "scalar both parse and neither is a record")]

    # The store's own count stays true with no file to compare it to: the
    # summary line read "0 valid record(s)" of a store holding four.
    # **A badly-typed record is a fact about the store** and is reported
    # on every project. Until TASK-262 round 4b this was reached only
    # after a held board had been derived, so a board-less project never
    # heard it; with the comparison gone it must not go too.
    good, issues = _STORE.validate_risk_records(on_disk)
    findings = []
    for issue in issues:
        rid = issue.get("id")
        who = repr(rid) if rid else f"line {issue['line']}"
        findings.append(Finding(
            "warn", rel_store, "risk-store-badly-typed",
            f"{who} — {issue['message']}. The record is excluded "
            f"from the board the stores print, and `perry-tasks board` "
            f"refuses while it is there."))
    check_risk_store_drift.stats["records"] = len(good)
    # No board file is read, so no drift (TASK-262 round 4b) —
    # `check_store_drift` says why.
    return findings


def _empty_intake_store_drift_stats() -> dict:
    """The typed machine-readable state before an intake comparison runs."""
    return {"store_present": False, "comparison_performed": False,
            "records": 0, "drifted": 0}


def check_intake_store_drift(project_root: Path, state_root: Path) -> list["Finding"]:
    """`## Intake` and `intake.jsonl` disagree — ADR-007, TASK-196.

    The same posture, the same `warn`, and silent-with-a-payload when there is
    no store, as the two checks above. What differs is the KEY, and it is the
    whole of what makes this register harder: an intake row has no id, so a row
    is addressed by its POSITION, and the comparison is positional.

    **A row inserted or removed by hand therefore reports every row below it,
    and that is the truth rather than the amplification `_order_drift`
    refuses.** For a task, an inserted line moves `order` and moves nothing
    else — the rows keep their names, so reporting them all would be one edit
    wearing five findings. Here the position IS the name: a line typed into the
    middle of `## Intake` really does mean that `perry-task resolve-intake 36`
    now addresses a different request than it did yesterday. Reporting one row
    would be reporting one row's worth of a change that moved all of them.
    `DRIFT_ROWS_SHOWN` caps the output; it does not cap the count.
    """
    findings: list[Finding] = []
    check_intake_store_drift.stats = _empty_intake_store_drift_stats()

    store_path = _STORE.intake_store_path(state_root)
    if not store_path.exists():
        return []

    check_intake_store_drift.stats["store_present"] = True
    rel_store = _rel(store_path, project_root)
    try:
        on_disk = [json.loads(line) for line in
                   store_path.read_text(errors="replace").split("\n")
                   if line.strip()]
    except (OSError, ValueError) as exc:
        return [Finding("warn", rel_store, "intake-store-unreadable",
                        f"`intake.jsonl` is not readable as JSONL "
                        f"({type(exc).__name__}: {exc}) — there is nothing to "
                        f"compare `## Intake` against")]
    if not all(isinstance(r, dict) for r in on_disk):
        return [Finding("warn", rel_store, "intake-store-unreadable",
                        "`intake.jsonl` holds something other than one JSON "
                        "OBJECT per line — a whole-file array and a bare "
                        "scalar both parse and neither is a record")]

    # **A badly-typed record is a fact about the store** and is reported
    # on every project. Until TASK-262 round 4b this was reached only
    # after a held board had been derived, so a board-less project never
    # heard it; with the comparison gone it must not go too.
    good, issues = _STORE.validate_intake_records(on_disk)
    findings = []
    for issue in issues:
        n = issue.get("order")
        who = f"row {n + 1}" if isinstance(n, int) else f"line {issue['line']}"
        findings.append(Finding(
            "warn", rel_store, "intake-store-badly-typed",
            f"{who} — {issue['message']}. The record is excluded "
            f"from the board the stores print, and `perry-tasks board` "
            f"refuses while it is there."))
    check_intake_store_drift.stats["records"] = len(good)
    # No board file is read, so no drift (TASK-262 round 4b) —
    # `check_store_drift` says why.
    return findings


