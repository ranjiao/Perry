  "claims": [
    {
      "path": ".perry/",
      "kind": "dir",
      "owner": "perry",
      "anchor": "project",
      "note": "the anchor. Holds the State root pointer, so it can never sit behind it."
    },
    {
      "path": "OKR.md",
      "kind": "file",
      "owner": "okr",
      "anchor": "state"
    },
    {
      "path": "phase/",
      "kind": "dir",
      "owner": "okr",
      "anchor": "state"
