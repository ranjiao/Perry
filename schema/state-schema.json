    "candidate_kind": [
      "objective",
      "kr",
      "phase",
      "task",
      "design",
      "decision",
      "knowledge",
      "arch",
      "risk"
    ],
    "candidate_confidence": [
      "high",
      "medium",
      "low"
    ],
    "candidate_status": [
      "pending",
      "accepted",
      "edited",
      "rejected",
      "deferred"
    ],
    "diagnosis_stage": [
      "scan",
      "read",
      "interview",
      "prescribe",
      "execute",
      "done",
      "abandoned"
    ],
    "diagnosis_step_interview": [
      "q1",
      "q2",
      "q3",
      "q4",
      "q5",
      "q6",
      "audience",
      "attachment"
    ],
    "diagnosis_depth": [
      "quick",
      "standard",
      "deep"
    ],
    "finding_severity": [
      "error",
      "warn",
      "info"
    ],
    "finding_source": [
      "scan",
      "interview"
    ],
    "finding_status": [
      "open",
      "closed",
      "accepted-risk",
      "disputed"
    ],
    "prescription_status": [
      "proposed",
      "accepted",
      "done",
      "declined",
      "deferred"
    ]
  },
  "i18n": {
    "description": "Which text in a state file may be written in the project's document language (.perry/config.md \u00a7 Document language) and which may not. Section headings and table column headers are localizable: every reader MUST accept the canonical English form and every alias listed here. Everything in `invariant` stays ASCII/English in every language, because it is matched, joined, or dereferenced by machines. Adding a language means adding its aliases here and widening the `match` regexes in `files[].headings` \u2014 nothing else in the schema changes. A language with no glossary block is still fully supported for prose; its documents keep the English headings.",
    "languages": [
      "en",
      "zh"
    ],
    "invariant": [
      "file and directory names (BOARD.md, phase/, evidence/<YYYY-MM>/)",
      "ID prefixes and ID bodies (REL-002, ADR-001, DESIGN-001, KR-O1.2, P-O1.2, USER-014)",
      "enum values (not_started, in_progress, blocked, review, done, dropped, single, split, ...)",
      "header field names in .perry/config.md and .perry/hook.md",
      "YAML frontmatter keys and values in phase/<NNN>-linkage.md",
      "priority section names (P0, P1, P2) and architecture section markers (\u00a71\u2026\u00a78)",
      "dates (YYYY-MM-DD), ISO weeks (YYYY-WW), commit SHAs, file paths",
      "command and subcommand names (/perry okr plan-phase)",
      "header field names in .perry/config.md (the file that declares the language cannot be written in it)"
    ],
