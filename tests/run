#!/usr/bin/env bash
# tests/run — Perry's test suite. Python 3 stdlib only; no venv, no pip.
#
#   bash tests/run            # everything
#   bash tests/run --lint     # just the schema drift guard (fast)
#   bash tests/run --serial   # step 2 one module at a time (ordering hunts)
#
# What it covers:
#   1. bin/perry-lint --templates — the shipped templates still match
#      schema/state-schema.json (the drift guard).
#   2. tests/test_parsers.py — viewer/parsers.py, bin/perry-state, and
#      bin/perry-lint against a realistic fixture project.
#      tests/test_diagnose.py — bin/perry-diagnose (findings fire AND don't
#      false-positive), the two template linters actually gate, and the
#      diagnosis schema entry matches its template.
#      tests/test_i18n.py — the same fixture project written in Chinese lints
#      clean and yields the same payload shape, and the schema's i18n glossary
#      stays consistent with the heading matchers.
#   3. Every shipped script compiles and answers --help.
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$ROOT"

fail=0
step() { printf '\n\033[1m%s\033[0m\n' "$1"; }

step "1. schema drift guard (templates vs schema/state-schema.json)"
python3 bin/perry-lint --templates || fail=1

if [ "${1:-}" = "--lint" ]; then
  exit "$fail"
fi

step "2. parser / extractor / linter contract tests"
# Module-parallel: 99 independent modules. Measured 2026-08-30, same machine,
# same hour: 589.6s serial → 133-150s across 8 workers (TASK-230). The floor is
# one module — test_task_writer.py runs alone for most of that.
# `--serial` falls back to plain discover; use it when a failure looks like it
# might be ordering-dependent, since parallel changes the order modules finish.
if [ "${PERRY_TEST_SERIAL:-}" = "1" ] || [ "${1:-}" = "--serial" ]; then
  python3 -m unittest discover -s tests || fail=1
else
  python3 tests/parallel || fail=1
fi

step "3. bin/ scripts are syntactically valid and self-documenting"
for f in bin/perry-state bin/perry-lint bin/perry-diagnose bin/perry-explain \
         templates/knowledge-base/bin/kb-lint templates/ops/bin/deliverable-lint; do
  python3 -c "import ast,sys; ast.parse(open('$f').read())" || { echo "  ✗ $f does not parse"; fail=1; }
  python3 "$f" --help >/dev/null 2>&1 || { echo "  ✗ $f --help failed"; fail=1; }
done
for f in bin/perry-detect-host bin/perry-update-check bin/perry-dispatch-limit \
         bin/perry-codex-preflight; do
  bash -n "$f" || { echo "  ✗ $f does not parse"; fail=1; }
done
[ "$fail" = 0 ] && echo "  ✓ all bin/ scripts OK"

step "4. sample projects lint clean (English and Chinese)"
python3 bin/perry-lint --root tests/fixtures/sample-project || fail=1
python3 bin/perry-lint --root tests/fixtures/sample-project-zh || fail=1

if [ "$fail" = 0 ]; then
  printf '\n\033[32m✓ all green\033[0m\n'
else
  printf '\n\033[31m✗ failures above\033[0m\n'
fi
exit "$fail"
